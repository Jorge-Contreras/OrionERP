@page "/capital-humano/configuracion-tiempo"
@attribute [Authorize(Policy = "CapitalHumanoAdmin")]
@using OrionERP.Application.Features.CapitalHumano.Workforce
@inject IWorkforceConfigurationService ConfigurationService
@inject ICurrentCompanyContext RfcState

<PageTitle>Configuración de tiempo</PageTitle>

<div class="workforce-page py-3">
  <header class="workforce-hero"><div><div class="workforce-eyebrow">Capital Humano · Configuración</div><h1>Tiempo y asistencia</h1><p>Normaliza sitios, horarios, reglas y responsables sin reemplazar los campos heredados del expediente.</p></div><button class="btn btn-outline-primary" @onclick="LoadAsync" disabled="@busy"><span class="oi oi-reload me-1"></span>Actualizar</button></header>
  @if(!string.IsNullOrWhiteSpace(message)){<div class="alert @(messageIsError?"alert-danger":"alert-success") workforce-alert">@message</div>}
  <nav class="workforce-tabs" role="tablist" aria-label="Secciones de configuración de tiempo">
    @foreach (var item in tabs)
    {
      <button type="button"
              class="workforce-tab"
              role="tab"
              aria-selected="@(tab == item.Value ? "true" : "false")"
              @onclick="() => SelectTab(item.Value)">@item.Label</button>
    }
  </nav>
  @if(setup is null){<div class="workforce-card"><div class="workforce-card__body">Cargando configuración…</div></div>}
  else if(tab=="readiness")
  {
    <section class="workforce-card"><div class="workforce-card__header"><h2>Lista de preparación</h2><span class="workforce-status @(setup.Readiness.Any(x=>!x.IsReady)?"workforce-status--warn":"")">@setup.Readiness.Count(x=>x.IsReady) / @setup.Readiness.Count listos</span></div><div class="table-responsive"><table class="table workforce-table"><thead><tr><th>Empleado</th><th>Acceso</th><th>Asignación</th><th>Supervisor</th><th>Estado</th></tr></thead><tbody>@if(setup.Readiness.Count==0){<tr><td colspan="5" class="workforce-empty">No hay empleados activos en la empresa de tu sesión.</td></tr>}@foreach(var item in setup.Readiness){<tr><td class="fw-semibold">@item.EmployeeName <span class="workforce-label">#@item.EmployeeId</span></td><td>@Check(item.HasLogin)</td><td>@Check(item.HasWorkAssignment)</td><td>@Check(item.HasSupervisor)</td><td><span class="workforce-status @(item.IsReady?"":"workforce-status--warn")">@(item.IsReady?"Listo":"Requiere configuración")</span></td></tr>}</tbody></table></div></section>
  }
  else if(tab=="sites")
  {
    <div class="workforce-grid"><section class="workforce-card workforce-span-5"><div class="workforce-card__header"><h2>Nuevo sitio y geocerca</h2></div><div class="workforce-card__body"><div class="workforce-form"><Field Label="Código"><input class="form-control" maxlength="30" @bind="site.Code" /></Field><Field Label="Nombre"><input class="form-control" maxlength="150" @bind="site.Name" /></Field><Field Label="Latitud"><input type="number" step=".000001" class="form-control" @bind="site.Latitude" /></Field><Field Label="Longitud"><input type="number" step=".000001" class="form-control" @bind="site.Longitude" /></Field><Field Label="Radio (m)"><input type="number" class="form-control" @bind="site.RadiusMeters" /></Field><Field Label="Precisión máxima (m)"><input type="number" class="form-control" @bind="site.MaxAccuracyMeters" /></Field><div class="span-2"><label class="form-label">Zona horaria</label><input class="form-control" @bind="site.TimeZoneId" /></div><div class="span-2"><button class="btn btn-primary" disabled="@busy" @onclick="SaveSiteAsync">@(busy?"Guardando…":"Guardar sitio")</button></div></div></div></section>
    <section class="workforce-card workforce-span-7"><div class="workforce-card__header"><h2>Sitios configurados</h2><span class="workforce-status">@setup.Sites.Count</span></div><div class="table-responsive"><table class="table workforce-table"><thead><tr><th>Código</th><th>Sitio</th><th>Geocerca</th><th>Zona</th></tr></thead><tbody>@if(setup.Sites.Count==0){<tr><td colspan="4" class="workforce-empty">Aún no hay sitios. Crea el primero con coordenadas validadas.</td></tr>}@foreach(var item in setup.Sites){<tr><td>@item.Code</td><td class="fw-semibold">@item.Name</td><td>@item.RadiusMeters m · ±@item.MaxAccuracyMeters m</td><td>@item.TimeZoneId</td></tr>}</tbody></table></div></section></div>
  }
  else if(tab=="schedules")
  {
    <div class="workforce-grid"><section class="workforce-card workforce-span-5"><div class="workforce-card__header"><h2>Plantilla semanal</h2></div><div class="workforce-card__body"><div class="workforce-form"><Field Label="Código"><input class="form-control" @bind="schedule.Code" /></Field><Field Label="Nombre"><input class="form-control" @bind="schedule.Name" /></Field><Field Label="Entrada"><input type="time" class="form-control" @bind="scheduleStart" /></Field><Field Label="Salida"><input type="time" class="form-control" @bind="scheduleEnd" /></Field><Field Label="Inicio descanso"><input type="time" class="form-control" @bind="scheduleBreakStart" /></Field><Field Label="Duración descanso (min)"><input type="number" min="0" max="480" class="form-control" @bind="scheduleBreak" /></Field><div class="span-2 form-check"><input id="schedule-break-paid" type="checkbox" class="form-check-input" @bind="scheduleBreakPaid"/><label for="schedule-break-paid" class="form-check-label">El descanso es pagado</label></div><div class="span-2"><div class="workforce-label mb-2">Se crea de lunes a viernes; puede cruzar medianoche y conserva el descanso pagado/no pagado de forma explícita. Los días no se infieren de campos heredados.</div><button class="btn btn-primary" disabled="@busy" @onclick="SaveScheduleAsync">@(busy?"Guardando…":"Guardar plantilla")</button></div></div></div></section>
    <section class="workforce-card workforce-span-7"><div class="workforce-card__header"><h2>Horarios</h2><span class="workforce-status">@setup.Schedules.Count</span></div><div class="table-responsive"><table class="table workforce-table"><thead><tr><th>Código</th><th>Nombre</th><th>Días activos</th><th>Horario</th><th>Descanso</th></tr></thead><tbody>@if(setup.Schedules.Count==0){<tr><td colspan="5" class="workforce-empty">Aún no hay plantillas de horario.</td></tr>}@foreach(var item in setup.Schedules){var first=item.Days.FirstOrDefault(x=>x.IsWorkingDay);var firstBreak=item.Breaks.FirstOrDefault();<tr><td>@item.Code</td><td class="fw-semibold">@item.Name</td><td>@item.Days.Count(x=>x.IsWorkingDay)</td><td>@(first is null?"Sin jornada":$"{FormatTime(first.StartTime)}–{FormatTime(first.EndTime)}")</td><td>@(firstBreak is null?"Sin descanso":$"{firstBreak.DurationMinutes} min · {(firstBreak.IsPaid?"pagado":"no pagado")}")</td></tr>}</tbody></table></div></section></div>
  }
  else if(tab=="assignments")
  {
    <div class="workforce-grid"><section class="workforce-card workforce-span-5"><div class="workforce-card__header"><h2>Asignación normalizada</h2></div><div class="workforce-card__body"><div class="workforce-form"><div class="span-2"><label class="form-label">Empleado</label><select class="form-select" @bind="assignment.EmployeeId"><option value="0">Selecciona</option>@foreach(var e in setup.Employees){<option value="@e.EmployeeId">@e.Name</option>}</select></div><Field Label="Sitio"><select class="form-select" @bind="assignment.SiteId"><option value="0">Selecciona</option>@foreach(var x in setup.Sites.Where(x=>x.IsActive)){<option value="@x.Id">@x.Name</option>}</select></Field><Field Label="Horario"><select class="form-select" @bind="assignment.ScheduleTemplateId"><option value="0">Selecciona</option>@foreach(var x in setup.Schedules.Where(x=>x.IsActive)){<option value="@x.Id">@x.Name</option>}</select></Field><Field Label="Política"><select class="form-select" @bind="assignment.AttendancePolicyId"><option value="0">Selecciona</option>@foreach(var x in setup.Policies.Where(x=>x.IsActive)){<option value="@x.Id">@x.Name</option>}</select></Field><Field Label="Grupo de pago"><select class="form-select" @bind="assignment.PayGroupId"><option value="0">Selecciona</option>@foreach(var x in setup.PayGroups.Where(x=>x.IsActive)){<option value="@x.Id">@x.Name</option>}</select></Field><Field Label="Vigente desde"><input type="date" class="form-control" @bind="assignment.EffectiveFrom" /></Field><div class="span-2"><button class="btn btn-primary" disabled="@busy" @onclick="SaveAssignmentAsync">@(busy?"Guardando…":"Guardar asignación")</button></div></div></div></section>
    <section class="workforce-card workforce-span-7"><div class="workforce-card__header"><h2>Asignaciones vigentes</h2><span class="workforce-status">@setup.WorkAssignments.Count</span></div><div class="table-responsive"><table class="table workforce-table"><thead><tr><th>Empleado</th><th>Sitio</th><th>Horario</th><th>Política</th><th>Pago</th></tr></thead><tbody>@if(setup.WorkAssignments.Count==0){<tr><td colspan="5" class="workforce-empty">No hay asignaciones vigentes para este RFC.</td></tr>}@foreach(var item in setup.WorkAssignments){<tr><td class="fw-semibold">@item.EmployeeName</td><td>@item.SiteName</td><td>@item.ScheduleName</td><td>@item.PolicyName</td><td>@item.PayGroupName</td></tr>}</tbody></table></div></section></div>
  }
  else if(tab=="supervisors")
  {
    <div class="workforce-grid"><section class="workforce-card workforce-span-5"><div class="workforce-card__header"><h2>Responsable efectivo</h2></div><div class="workforce-card__body"><div class="workforce-form"><div class="span-2"><label class="form-label">Empleado</label><select class="form-select" @bind="supervisor.EmployeeId"><option value="0">Selecciona</option>@foreach(var e in setup.Employees){<option value="@e.EmployeeId">@e.Name</option>}</select></div><div class="span-2"><label class="form-label">Supervisor</label><select class="form-select" @bind="supervisor.SupervisorEmployeeId"><option value="0">Selecciona</option>@foreach(var e in setup.Employees){<option value="@e.EmployeeId">@e.Name</option>}</select></div><Field Label="Vigente desde"><input type="date" class="form-control" @bind="supervisor.EffectiveFrom" /></Field><div class="span-2"><button class="btn btn-primary" disabled="@busy" @onclick="SaveSupervisorAsync">@(busy?"Guardando…":"Guardar responsable")</button></div></div></div></section><section class="workforce-card workforce-span-7"><div class="workforce-card__header"><h2>Equipos</h2><span class="workforce-status">@setup.SupervisorAssignments.Count</span></div><div class="table-responsive"><table class="table workforce-table"><thead><tr><th>Empleado</th><th>Supervisor</th><th>Vigencia</th></tr></thead><tbody>@if(setup.SupervisorAssignments.Count==0){<tr><td colspan="3" class="workforce-empty">Aún no hay relaciones de supervisión vigentes.</td></tr>}@foreach(var item in setup.SupervisorAssignments){<tr><td>@item.EmployeeName</td><td class="fw-semibold">@item.SupervisorName</td><td>@item.EffectiveFrom.ToString("dd MMM yyyy")</td></tr>}</tbody></table></div></section></div>
  }
  else if(tab=="policies")
  {
    <div class="workforce-grid"><section class="workforce-card workforce-span-8"><div class="workforce-card__header"><h2>Políticas efectivas México 2026–2030</h2><span class="workforce-status workforce-status--warn">Revisión RH requerida</span></div><div class="table-responsive"><table class="table workforce-table"><thead><tr><th>Vigencia</th><th>Nombre</th><th>Ordinaria</th><th>Doble</th><th>Triple</th><th></th></tr></thead><tbody>@if(setup.Policies.Count==0){<tr><td colspan="6" class="workforce-empty">No hay versiones de política configuradas.</td></tr>}@foreach(var item in setup.Policies){<tr><td>@item.EffectiveFrom.ToString("yyyy")</td><td class="fw-semibold">@item.Name</td><td>@(item.WeeklyOrdinaryMinutes/60) h</td><td>@(item.WeeklyDoubleOvertimeMinutes/60) h</td><td>@(item.WeeklyTripleOvertimeMinutes/60) h</td><td><button class="btn btn-sm btn-outline-primary" disabled="@busy" @onclick="()=>ConfirmPolicyAsync(item)">Validar versión</button></td></tr>}</tbody></table></div></section><section class="workforce-card workforce-span-4"><div class="workforce-card__header"><h2>Grupos de pago</h2><span class="workforce-status">@setup.PayGroups.Count</span></div><div class="workforce-card__body">@if(setup.PayGroups.Count==0){<div class="workforce-empty-block">Aún no hay grupos de pago.</div>}@foreach(var item in setup.PayGroups){<div class="d-flex justify-content-between border-bottom py-2"><span>@item.Name</span><span class="workforce-status">@item.Frequency</span></div>}<hr/><label class="form-label">Nuevo código</label><input class="form-control mb-2" @bind="payGroup.Code"/><label class="form-label">Nombre</label><input class="form-control mb-2" @bind="payGroup.Name"/><label class="form-label">Frecuencia</label><select class="form-select mb-2" @bind="payGroup.Frequency"><option value="WEEKLY">Semanal</option><option value="BIWEEKLY">Quincenal</option><option value="MONTHLY">Mensual</option></select><button class="btn btn-primary" disabled="@busy" @onclick="SavePayGroupAsync">@(busy?"Guardando…":"Guardar grupo")</button></div></section></div>
  }
  else if(tab=="holidays")
  {
    <div class="workforce-grid"><section class="workforce-card workforce-span-5"><div class="workforce-card__header"><h2>Día festivo</h2></div><div class="workforce-card__body"><div class="workforce-form"><div class="span-2"><label class="form-label">Nombre</label><input class="form-control" @bind="holiday.Name"/></div><Field Label="Fecha"><input type="date" class="form-control" @bind="holiday.HolidayDate"/></Field><Field Label="Sitio opcional"><select class="form-select" @bind="holiday.SiteId"><option value="">Todos</option>@foreach(var x in setup.Sites){<option value="@x.Id">@x.Name</option>}</select></Field><div class="span-2"><button class="btn btn-primary" disabled="@busy" @onclick="SaveHolidayAsync">@(busy?"Guardando…":"Guardar festivo")</button></div></div></div></section><section class="workforce-card workforce-span-7"><div class="workforce-card__header"><h2>Calendario</h2><span class="workforce-status">@setup.Holidays.Count</span></div><div class="table-responsive"><table class="table workforce-table"><thead><tr><th>Fecha</th><th>Nombre</th><th>Alcance</th><th>Pagado</th></tr></thead><tbody>@if(setup.Holidays.Count==0){<tr><td colspan="4" class="workforce-empty">No hay días festivos configurados.</td></tr>}@foreach(var item in setup.Holidays){<tr><td>@item.HolidayDate.ToString("dd MMM yyyy")</td><td class="fw-semibold">@item.Name</td><td>@(item.SiteId.HasValue?setup.Sites.FirstOrDefault(x=>x.Id==item.SiteId)?.Name:"Todos los sitios")</td><td>@Check(item.IsPaid)</td></tr>}</tbody></table></div></section></div>
  }
  else if(tab=="kiosks")
  {
    <div class="workforce-grid"><section class="workforce-card workforce-span-4"><div class="workforce-card__header"><h2>Vincular kiosco</h2></div><div class="workforce-card__body"><label class="form-label">Nombre del dispositivo</label><input class="form-control mb-2" @bind="pairing.DeviceName"/><label class="form-label">Sitio</label><select class="form-select mb-3" @bind="pairing.SiteId"><option value="0">Selecciona</option>@foreach(var x in setup.Sites){<option value="@x.Id">@x.Name</option>}</select><button class="btn btn-primary" disabled="@busy" @onclick="CreatePairingAsync">@(busy?"Generando…":"Generar código")</button>@if(pairingResult is not null){<div class="alert alert-warning mt-3 text-center"><div class="workforce-label">Código de un solo uso</div><div class="workforce-stat">@pairingResult.Code</div><small>Expira @pairingResult.ExpiresAtUtc.ToLocalTime().ToString("HH:mm")</small></div>}</div></section><section class="workforce-card workforce-span-4"><div class="workforce-card__header"><h2>Credencial de empleado</h2></div><div class="workforce-card__body"><label class="form-label">Empleado</label><select class="form-select mb-2" @bind="credential.EmployeeId"><option value="0">Selecciona</option>@foreach(var e in setup.Employees){<option value="@e.EmployeeId">@e.Name</option>}</select><label class="form-label">PIN numérico</label><input type="password" inputmode="numeric" maxlength="12" autocomplete="new-password" class="form-control mb-3" @bind="credential.Pin"/><button class="btn btn-primary" disabled="@busy" @onclick="CreateCredentialAsync">@(busy?"Procesando…":"Crear / rotar")</button>@if(credentialResult?.BadgeToken is not null){<div class="alert alert-warning mt-3"><strong>Código de gafete (única vez)</strong><div class="text-break font-monospace mt-2">@credentialResult.BadgeToken</div></div>}</div></section><section class="workforce-card workforce-span-4"><div class="workforce-card__header"><h2>Dispositivos</h2><span class="workforce-status">@setup.Kiosks.Count</span></div><div class="workforce-card__body">@if(setup.Kiosks.Count==0){<div class="workforce-empty-block">No hay kioscos registrados.</div>}@foreach(var item in setup.Kiosks){<div class="border-bottom py-2"><div class="fw-semibold">@item.Name</div><div class="workforce-label">@item.SiteName · @(item.IsActive?"Activo":"Pendiente de vincular")</div></div>}</div></section></div>
  }
  else if(tab=="privacy")
  {
    <div class="workforce-grid">
      <section class="workforce-card workforce-span-5"><div class="workforce-card__header"><h2>Aviso de privacidad</h2></div><div class="workforce-card__body"><div class="workforce-form"><Field Label="Versión"><input class="form-control" maxlength="30" @bind="privacy.Version" /></Field><Field Label="Vigente desde"><input type="date" class="form-control" @bind="privacy.EffectiveFrom" /></Field><div class="span-2"><label class="form-label">Título</label><input class="form-control" maxlength="200" @bind="privacy.Title" /></div><div class="span-2"><label class="form-label">Texto aprobado</label><textarea class="form-control" rows="9" maxlength="8000" @bind="privacy.NoticeText"></textarea></div><div class="span-2 form-check"><input id="privacy-active" type="checkbox" class="form-check-input" @bind="privacy.IsActive" /><label for="privacy-active" class="form-check-label">Activar esta versión al guardar</label></div><div class="span-2"><p class="workforce-label">La activación deshabilita cualquier versión anterior. Publica únicamente el texto aprobado por Capital Humano y privacidad.</p><button class="btn btn-primary" disabled="@busy" @onclick="SavePrivacyAsync">@(busy?"Guardando…":"Guardar aviso")</button></div></div></div></section>
      <section class="workforce-card workforce-span-7"><div class="workforce-card__header"><h2>Versiones</h2><span class="workforce-status @(setup.PrivacyNotices.Any(x=>x.IsActive)?"":"workforce-status--warn")">@(setup.PrivacyNotices.Any(x=>x.IsActive)?"Aviso activo":"Sin aviso activo")</span></div><div class="table-responsive"><table class="table workforce-table"><thead><tr><th>Versión</th><th>Título</th><th>Vigencia</th><th>Estado</th></tr></thead><tbody>@if(setup.PrivacyNotices.Count==0){<tr><td colspan="4" class="workforce-empty">Aún no hay versiones. El registro de asistencia sigue disponible en desarrollo, pero producción debe permanecer desactivada hasta publicar el aviso aprobado.</td></tr>}@foreach(var item in setup.PrivacyNotices){<tr><td class="fw-semibold">@item.Version</td><td>@item.Title</td><td>@item.EffectiveFrom.ToString("dd MMM yyyy")</td><td><span class="workforce-status @(item.IsActive?"":"workforce-status--muted")">@(item.IsActive?"Activo":"Borrador")</span></td></tr>}</tbody></table></div></section>
    </div>
  }
</div>

@code {
  private readonly (string Value,string Label)[] tabs=[("readiness","Preparación"),("sites","Sitios"),("schedules","Horarios"),("assignments","Asignaciones"),("supervisors","Supervisores"),("policies","Políticas y pago"),("holidays","Festivos"),("kiosks","Kioscos"),("privacy","Privacidad")];
  private WorkforceSetupSnapshotDto? setup; private string tab="readiness"; private bool busy; private string? message; private bool messageIsError;
  private WorkSiteSaveRequest site=new(){TimeZoneId="America/Mexico_City",RadiusMeters=150,MaxAccuracyMeters=100};
  private ScheduleTemplateSaveRequest schedule=new(); private TimeOnly scheduleStart=new(9,0); private TimeOnly scheduleEnd=new(18,0); private TimeOnly scheduleBreakStart=new(14,0); private int scheduleBreak=60; private bool scheduleBreakPaid;
  private EmployeeWorkAssignmentSaveRequest assignment=new(); private SupervisorAssignmentSaveRequest supervisor=new(); private PayGroupSaveRequest payGroup=new(); private HolidaySaveRequest holiday=new(); private KioskPairingCreateRequest pairing=new(); private KioskCredentialCreateRequest credential=new(); private PrivacyNoticeSaveRequest privacy=new(); private KioskPairingCodeDto? pairingResult; private KioskCredentialResult? credentialResult;
  private string Rfc => RfcState.RequireRfc();
  protected override async Task OnInitializedAsync()=>await LoadAsync();
  private void SelectTab(string value){tab=value;message=null;}
  private async Task LoadAsync(){busy=true;try{setup=await ConfigurationService.GetSetupAsync(Rfc);SeedRfc();}catch(Exception ex){Show(ex.Message,true);}finally{busy=false;}}
  private void SeedRfc(){site.Rfc=Rfc;schedule.Rfc=Rfc;assignment.Rfc=Rfc;supervisor.Rfc=Rfc;payGroup.Rfc=Rfc;holiday.Rfc=Rfc;pairing.Rfc=Rfc;credential.Rfc=Rfc;privacy.Rfc=Rfc;}
  private async Task SaveSiteAsync()=>await RunAsync(()=>ConfigurationService.SaveSiteAsync(site),()=>site=new(){Rfc=Rfc,TimeZoneId="America/Mexico_City",RadiusMeters=150,MaxAccuracyMeters=100});
  private async Task SaveScheduleAsync(){schedule.Days=Enumerable.Range(0,7).Select(day=>new ScheduleDayDto{DayOfWeek=day,IsWorkingDay=day is>=1 and<=5,StartTime=day is>=1 and<=5?scheduleStart.ToTimeSpan():null,EndTime=day is>=1 and<=5?scheduleEnd.ToTimeSpan():null,UnpaidBreakMinutes=day is>=1 and<=5&&!scheduleBreakPaid?scheduleBreak:0}).ToList();schedule.Breaks=scheduleBreak>0?[new ScheduleBreakDto{Name="Descanso",StartTime=scheduleBreakStart.ToTimeSpan(),DurationMinutes=scheduleBreak,IsPaid=scheduleBreakPaid,IsRequired=true}]:[];await RunAsync(()=>ConfigurationService.SaveScheduleAsync(schedule),()=>schedule=new(){Rfc=Rfc});}
  private async Task SaveAssignmentAsync()=>await RunAsync(()=>ConfigurationService.SaveWorkAssignmentAsync(assignment),()=>assignment=new(){Rfc=Rfc});
  private async Task SaveSupervisorAsync()=>await RunAsync(()=>ConfigurationService.SaveSupervisorAssignmentAsync(supervisor),()=>supervisor=new(){Rfc=Rfc});
  private async Task SavePayGroupAsync()=>await RunAsync(()=>ConfigurationService.SavePayGroupAsync(payGroup),()=>payGroup=new(){Rfc=Rfc});
  private async Task SaveHolidayAsync()=>await RunAsync(()=>ConfigurationService.SaveHolidayAsync(holiday),()=>holiday=new(){Rfc=Rfc});
  private async Task SavePrivacyAsync()=>await RunAsync(()=>ConfigurationService.SavePrivacyNoticeAsync(privacy),()=>privacy=new(){Rfc=Rfc});
  private async Task ConfirmPolicyAsync(AttendancePolicyDto p){var request=new AttendancePolicySaveRequest{Id=p.Id,Rfc=p.Rfc,Code=p.Code,Name=p.Name,EffectiveFrom=p.EffectiveFrom,EffectiveTo=p.EffectiveTo,WeeklyOrdinaryMinutes=p.WeeklyOrdinaryMinutes,WeeklyDoubleOvertimeMinutes=p.WeeklyDoubleOvertimeMinutes,WeeklyTripleOvertimeMinutes=p.WeeklyTripleOvertimeMinutes,GraceMinutes=p.GraceMinutes,RoundingMinutes=p.RoundingMinutes,LocationRequired=p.LocationRequired,IsActive=p.IsActive};await RunAsync(()=>ConfigurationService.SavePolicyAsync(request));}
  private async Task CreatePairingAsync(){busy=true;try{pairing.Rfc=Rfc;pairingResult=await ConfigurationService.CreateKioskPairingCodeAsync(pairing);Show("Código creado. Captúralo en el kiosco antes de que expire.",false);await LoadAsync();}catch(Exception ex){Show(ex.Message,true);}finally{busy=false;}}
  private async Task CreateCredentialAsync(){busy=true;try{credential.Rfc=Rfc;credentialResult=await ConfigurationService.CreateKioskCredentialAsync(credential);Show(credentialResult.Message,!credentialResult.Success);}catch(Exception ex){Show(ex.Message,true);}finally{busy=false;}}
  private async Task RunAsync(Func<Task<WorkforceCommandResult>> action,Action? reset=null){busy=true;try{var result=await action();Show(result.Message,!result.Success);if(result.Success){reset?.Invoke();await LoadAsync();}}catch(Exception ex){Show(ex.Message,true);}finally{busy=false;}}
  private void Show(string text,bool error){message=text;messageIsError=error;}
  private static RenderFragment Check(bool value)=>builder=>{builder.OpenElement(0,"span");builder.AddAttribute(1,"class",$"workforce-status {(value?"":"workforce-status--warn")}");builder.AddContent(2,value?"Sí":"No");builder.CloseElement();};
  private static string FormatTime(TimeSpan? value)=>value?.ToString(@"hh\:mm")??"--:--";
}
