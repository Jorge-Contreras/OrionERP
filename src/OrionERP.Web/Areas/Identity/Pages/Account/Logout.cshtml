@page
@model OrionERP.Web.Areas.Identity.Pages.Account.LogoutModel
@{
    ViewData["Title"] = "Cerrar sesión";
}

<div class="auth-shell">
    <div class="auth-card">
        <h1>Cerrar sesión</h1>
        <p>La sesión ya terminó. Puedes volver a ingresar y elegir una empresa.</p>
        <a class="btn btn-primary" asp-page="./Login">Iniciar sesión</a>
    </div>
</div>
