@page "/cuentas-por-pagar/recurrentes"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using OrionERP.Application.Features.CuentasPorPagar.Recurrentes
@attribute [Authorize(Roles = "Administrador,APAdmin,APOperator,APReadOnly")]

<PageTitle>CxCR</PageTitle>

<div class="container-fluid py-3 recurrent-ap-page">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
      <h1 class="h3 mb-1">CxCR</h1>
      <p class="text-muted small mb-0">Cuentas Por Cobrar Recurrentes</p>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-2">
      <button type="button" class="btn btn-outline-secondary" @onclick="RefreshAsync" disabled="@IsLoading">
        @(IsLoading ? "Actualizando..." : "Actualizar")
      </button>
      <button type="button" class="btn btn-primary" @onclick="NewPayable" disabled="@IsReadOnly">
        Nuevo recurrente
      </button>
    </div>
  </div>

    <div class="recurrent-ap-metrics mb-3">
      <div class="recurrent-ap-metric">
        <div class="text-muted small">Abiertos</div>
        <div class="h4 mb-0">@Workspace.Dashboard.TotalOpen</div>
      </div>
      <div class="recurrent-ap-metric">
        <div class="text-muted small">Por vencer</div>
        <div class="h4 mb-0">@Workspace.Dashboard.DueSoon</div>
      </div>
      <div class="recurrent-ap-metric">
        <div class="text-muted small">Vencidos</div>
        <div class="h4 mb-0">@Workspace.Dashboard.Overdue</div>
      </div>
      <div class="recurrent-ap-metric">
        <div class="text-muted small">Pendiente estimado</div>
        <div class="h4 mb-0">@FormatCurrency(Workspace.Dashboard.ExpectedOpenAmount)</div>
      </div>
      <div class="recurrent-ap-metric">
        <div class="text-muted small">Pagado este mes</div>
        <div class="h4 mb-0">@FormatCurrency(Workspace.Dashboard.PaidThisMonthAmount)</div>
      </div>
    </div>

    <div class="row g-3">
      <div class="col-12 col-xl-4">
        <section class="card shadow-sm mb-3">
          <div class="card-body">
            <h2 class="h5 mb-3">Filtros</h2>
            <div class="row g-3">
              <div class="col-12">
                <label class="form-label">Buscar</label>
                <input class="form-control" type="search" @bind="Filter.SearchText" @bind:event="oninput" placeholder="Nombre, proveedor, categoría o nota" />
              </div>
              <div class="col-6">
                <label class="form-label">Desde</label>
                <InputDate class="form-control" @bind-Value="Filter.FromDate" />
              </div>
              <div class="col-6">
                <label class="form-label">Hasta</label>
                <InputDate class="form-control" @bind-Value="Filter.ToDate" />
              </div>
              <div class="col-12">
                <label class="form-label">Estatus</label>
                <select class="form-select" @bind="Filter.Status">
                  <option value="">Todos</option>
                  @foreach (var status in Workspace.Statuses)
                  {
                    <option value="@status">@GetStatusLabel(status)</option>
                  }
                </select>
              </div>
            </div>
            <div class="d-flex gap-2 mt-3">
              <button type="button" class="btn btn-primary" @onclick="RefreshAsync" disabled="@IsLoading">Buscar</button>
              <button type="button" class="btn btn-outline-secondary" @onclick="ClearFiltersAsync" disabled="@IsLoading">Limpiar</button>
            </div>
          </div>
        </section>

        @if (IsEditorVisible)
        {
          <section class="card shadow-sm">
            <div class="card-body">
              <h2 class="h5 mb-3">@EditorTitle</h2>
              <EditForm Model="Editor" OnValidSubmit="SavePayableAsync">
              <DataAnnotationsValidator />
              <ValidationSummary />

              <div class="mb-2">
                <label class="form-label">Nombre</label>
                <input class="form-control" @bind="Editor.Name" @bind:event="oninput" disabled="@IsReadOnly" />
              </div>
              <div class="mb-2">
                <label class="form-label">Proveedor</label>
                <InputSelect class="form-select" @bind-Value="Editor.BusinessPartnerId" disabled="@IsReadOnly">
                  <option value="">Sin proveedor ligado</option>
                  @foreach (var vendor in Workspace.Vendors)
                  {
                    <option value="@vendor.Id">@vendor.Name</option>
                  }
                </InputSelect>
              </div>
              <div class="row g-2">
                <div class="col-6">
                  <label class="form-label">Categoría</label>
                  <input class="form-control" @bind="Editor.Category" @bind:event="oninput" disabled="@IsReadOnly" />
                </div>
                <div class="col-6">
                  <label class="form-label">Monto esperado</label>
                  <input type="number" step="0.01" class="form-control" @bind="Editor.ExpectedAmount" @bind:event="oninput" disabled="@IsReadOnly" />
                </div>
                <div class="col-6">
                  <label class="form-label">Frecuencia</label>
                  <InputSelect class="form-select" @bind-Value="Editor.FrequencyUnit" disabled="@IsReadOnly">
                    @foreach (var unit in Workspace.FrequencyUnits)
                    {
                      <option value="@unit">@GetFrequencyLabel(unit)</option>
                    }
                  </InputSelect>
                </div>
                <div class="col-6">
                  <label class="form-label">Cada</label>
                  <input type="number" min="1" class="form-control" @bind="Editor.IntervalCount" @bind:event="oninput" disabled="@IsReadOnly" />
                </div>
                <div class="col-6">
                  <label class="form-label">Inicio</label>
                  <InputDate class="form-control" @bind-Value="Editor.StartDate" disabled="@IsReadOnly" />
                </div>
                <div class="col-6">
                  <label class="form-label">Fin</label>
                  <InputDate class="form-control" @bind-Value="Editor.EndDate" disabled="@IsReadOnly" />
                </div>
                <div class="col-6">
                  <label class="form-label">Día venc.</label>
                  <input type="number" min="1" max="31" class="form-control" @bind="Editor.DueDayOfMonth" @bind:event="oninput" disabled="@IsReadOnly" />
                </div>
                <div class="col-6">
                  <label class="form-label">Mes venc.</label>
                  <input type="number" min="1" max="12" class="form-control" @bind="Editor.DueMonth" @bind:event="oninput" disabled="@IsReadOnly" />
                </div>
              </div>
              <div class="mb-2 mt-2">
                <label class="form-label">Descripción</label>
                <textarea class="form-control" rows="3" @bind="Editor.Description" @bind:event="oninput" disabled="@IsReadOnly"></textarea>
              </div>
              <div class="row g-2">
                <div class="col-12">
                  <label class="form-label">Website</label>
                  <input class="form-control" type="url" @bind="Editor.Website" @bind:event="oninput" disabled="@IsReadOnly" />
                </div>
                <div class="col-12 col-md-6">
                  <label class="form-label">UserName</label>
                  <input class="form-control" @bind="Editor.UserName" @bind:event="oninput" disabled="@IsReadOnly" />
                </div>
                <div class="col-12 col-md-6">
                  <label class="form-label">Password</label>
                  <input class="form-control" type="password" autocomplete="new-password" @bind="Editor.Password" @bind:event="oninput" disabled="@IsReadOnly" />
                </div>
              </div>
              <label class="form-check mb-3">
                <InputCheckbox class="form-check-input" @bind-Value="Editor.IsActive" disabled="@IsReadOnly" />
                <span class="form-check-label">Activo</span>
              </label>
              <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary" disabled="@IsReadOnlyOrSaving">
                  @(IsSavingPayable ? "Guardando..." : "Guardar")
                </button>
                @if (Editor.Id.HasValue)
                {
                  <button type="button" class="btn btn-outline-warning" @onclick="ReseedPayableAsync" disabled="@IsReadOnlyOrMutating">
                    @(IsReseedingPayable ? "Resembrando..." : "Resembrar vencimientos")
                  </button>
                }
                <button type="button" class="btn btn-outline-secondary" @onclick="NewPayable">Nuevo</button>
              </div>
              </EditForm>
            </div>
          </section>
        }
        else
        {
          <section class="card shadow-sm">
            <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-2">
              <div>
                <h2 class="h6 mb-1">@EditorTitle</h2>
                <div class="text-muted small">La sección se ocultó después de guardar.</div>
              </div>
              <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ShowEditor">
                Mostrar editor
              </button>
            </div>
          </section>
        }
      </div>

      <div class="col-12 col-xl-8">
        @if (AreOccurrencesVisible)
        {
          <section class="card shadow-sm mb-3">
            <div class="card-body">
              <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <h2 class="h5 mb-0">Vencimientos</h2>
                <span class="text-muted small">@Workspace.Occurrences.Count registros</span>
              </div>
              <div class="table-responsive recurrent-ap-table-wrap">
                <table class="table table-sm table-hover align-middle">
                <thead class="table-light">
                  <tr>
                    <th>Pago</th>
                    <th>Vence</th>
                    <th class="text-end">Esperado</th>
                    <th class="text-end">Pagado</th>
                    <th>Estatus</th>
                    <th class="text-end">Acciones</th>
                  </tr>
                </thead>
                <tbody>
                  @if (Workspace.Occurrences.Count == 0)
                  {
                    <tr>
                      <td colspan="6" class="text-center text-muted py-4">No hay vencimientos para el filtro actual.</td>
                    </tr>
                  }
                  else
                  {
                    @foreach (var occurrence in Workspace.Occurrences)
                    {
                      <tr class="@($"{GetOccurrenceRowClass(occurrence)} recurrent-ap-occurrence-row {(SelectedOccurrence?.Id == occurrence.Id ? "table-active" : string.Empty)}")"
                          role="button"
                          tabindex="0"
                          title="Seleccionar vencimiento"
                          @onclick="() => SelectOccurrenceAsync(occurrence)">
                        <td>
                          <div class="fw-semibold">@occurrence.PayableName</div>
                          <div class="small text-muted">@occurrence.PayeeName</div>
                          @if (!string.IsNullOrWhiteSpace(occurrence.Category))
                          {
                            <span class="badge text-bg-light border">@occurrence.Category</span>
                          }
                        </td>
                        <td>
                          <div>@occurrence.DueDate.ToString("dd/MM/yyyy")</div>
                          <div class="small text-muted">Periodo @occurrence.PeriodStartDate.ToString("dd/MM/yyyy")</div>
                        </td>
                        <td class="text-end">@FormatOptionalCurrency(occurrence.ExpectedAmount)</td>
                        <td class="text-end">@FormatCurrency(occurrence.ActualPaidAmount)</td>
                        <td>
                          <span class="@GetStatusBadgeClass(occurrence.Status)">@GetStatusLabel(occurrence.Status)</span>
                          @if (occurrence.PaymentLinkCount > 0)
                          {
                            <span class="badge text-bg-info ms-1">@occurrence.PaymentLinkCount póliza</span>
                          }
                          @if (occurrence.AttachmentCount > 0)
                          {
                            <span class="badge text-bg-secondary ms-1">@occurrence.AttachmentCount archivo</span>
                          }
                        </td>
                        <td class="text-end">
                          <button type="button"
                                  class="btn btn-sm btn-outline-secondary"
                                  @onclick="() => EditPayable(occurrence.RecurringPayableId)"
                                  @onclick:stopPropagation="true">
                            Editar
                          </button>
                        </td>
                      </tr>
                    }
                  }
                </tbody>
                </table>
              </div>
            </div>
          </section>
        }
        else
        {
          <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ShowOccurrences">
              Mostrar vencimientos
            </button>
            <span class="text-muted small">@Workspace.Occurrences.Count registros</span>
          </div>
        }

        @if (SelectedOccurrence is not null)
        {
          <section class="card shadow-sm">
            <div class="card-body">
              <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                <div>
                  <h2 class="h5 mb-1">@SelectedOccurrence.PayableName</h2>
                  <div class="text-muted">Vence @SelectedOccurrence.DueDate.ToString("dd/MM/yyyy")</div>
                </div>
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClearSelectedOccurrence">Cerrar</button>
              </div>

              @if (OccurrenceDetail is not null)
              {
                <section class="recurrent-ap-detail mb-3">
                  <div class="d-flex flex-wrap justify-content-between gap-3">
                    <div>
                      <h3 class="h6 mb-2">Información recurrente</h3>
                      <dl class="recurrent-ap-detail-list mb-0">
                        <div>
                          <dt>Proveedor</dt>
                          <dd>@(OccurrenceDetail.PayeeName ?? "-")</dd>
                        </div>
                        <div>
                          <dt>Categoría</dt>
                          <dd>@(OccurrenceDetail.Category ?? "-")</dd>
                        </div>
                        <div>
                          <dt>Frecuencia</dt>
                          <dd>@GetFrequencyLabel(OccurrenceDetail.FrequencyUnit) · cada @OccurrenceDetail.IntervalCount</dd>
                        </div>
                        <div>
                          <dt>Periodo</dt>
                          <dd>@OccurrenceDetail.PeriodStartDate.ToString("dd/MM/yyyy") - @OccurrenceDetail.DueDate.ToString("dd/MM/yyyy")</dd>
                        </div>
                        <div>
                          <dt>Monto esperado</dt>
                          <dd>@FormatOptionalCurrency(OccurrenceDetail.ExpectedAmount)</dd>
                        </div>
                      </dl>
                    </div>
                    <div class="recurrent-ap-provider">
                      <h3 class="h6 mb-2">Acceso proveedor</h3>
                      <div class="recurrent-ap-copy-row">
                        <span>Website</span>
                        <code>@(OccurrenceDetail.Website ?? "-")</code>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick='() => CopyProviderValueAsync("Website", OccurrenceDetail.Website)' disabled="@(!CanUseProviderCredentials)">Copiar</button>
                      </div>
                      <div class="recurrent-ap-copy-row">
                        <span>UserName</span>
                        <code>@(OccurrenceDetail.UserName ?? "-")</code>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick='() => CopyProviderValueAsync("UserName", OccurrenceDetail.UserName)' disabled="@(!CanUseProviderCredentials)">Copiar</button>
                      </div>
                      <div class="recurrent-ap-copy-row">
                        <span>Password</span>
                        <code>@(string.IsNullOrWhiteSpace(OccurrenceDetail.Password) ? "-" : "••••••••")</code>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick='() => CopyProviderValueAsync("Password", OccurrenceDetail.Password)' disabled="@(!CanUseProviderCredentials)">Copiar</button>
                      </div>
                    </div>
                  </div>
                  @if (!string.IsNullOrWhiteSpace(OccurrenceDetail.Description))
                  {
                    <div class="mt-3">
                      <h3 class="h6 mb-1">Notas recurrentes</h3>
                      <p class="mb-0 recurrent-ap-notes">@OccurrenceDetail.Description</p>
                    </div>
                  }
                </section>
              }

              <div class="row g-3">
                <div class="col-12 col-lg-5">
                  <h3 class="h6">Pago manual</h3>
                  <div class="row g-2">
                    <div class="col-6">
                      <label class="form-label">Estatus</label>
                      <select class="form-select" @bind="StatusEditor.Status" disabled="@IsReadOnly">
                        @foreach (var status in Workspace.Statuses)
                        {
                          <option value="@status">@GetStatusLabel(status)</option>
                        }
                      </select>
                    </div>
                    <div class="col-6">
                      <label class="form-label">Esperado</label>
                      <input type="number" step="0.01" class="form-control" @bind="StatusEditor.ExpectedAmount" @bind:event="oninput" disabled="@IsReadOnly" />
                    </div>
                    <div class="col-6">
                      <label class="form-label">Monto</label>
                      <input type="number" step="0.01" class="form-control" @bind="StatusEditor.ActualAmount" @bind:event="oninput" disabled="@IsReadOnly" />
                    </div>
                    <div class="col-12">
                      <label class="form-label">Fecha pago</label>
                      <InputDate class="form-control" @bind-Value="StatusEditor.PaymentDate" disabled="@IsReadOnly" />
                    </div>
                    <div class="col-12">
                      <label class="form-label">Notas</label>
                      <textarea class="form-control" rows="2" @bind="StatusEditor.Notes" @bind:event="oninput" disabled="@IsReadOnly"></textarea>
                    </div>
                  </div>
                  <div class="d-flex flex-wrap gap-2 mt-2">
                    <button type="button" class="btn btn-primary" @onclick="SaveOccurrenceStatusAsync" disabled="@IsReadOnlyOrMutating">
                      @(IsSavingOccurrence ? "Guardando..." : "Guardar estatus")
                    </button>
                    <button type="button" class="btn btn-outline-danger" @onclick="CancelSelectedOccurrenceAsync" disabled="@IsReadOnlyOrMutating">
                      @(IsCancellingOccurrence ? "Cancelando..." : "Cancelar vencimiento")
                    </button>
                  </div>
                </div>

                <div class="col-12 col-lg-7">
                  <h3 class="h6">Pólizas ligadas</h3>
                  @if (LinkedTransactions.Count == 0)
                  {
                    <div class="text-muted small mb-3">Este vencimiento no tiene pólizas ligadas.</div>
                  }
                  else
                  {
                    <div class="table-responsive recurrent-ap-candidates mb-3">
                      <table class="table table-sm align-middle">
                        <thead class="table-light">
                          <tr>
                            <th>ID</th>
                            <th>Fecha</th>
                            <th class="text-end">Monto</th>
                            <th class="text-end">Acciones</th>
                          </tr>
                        </thead>
                        <tbody>
                          @foreach (var link in LinkedTransactions)
                          {
                            <tr>
                              <td>
                                @if (link.TransaccionId > 0)
                                {
                                  <a href="@($"/contabilidad/transacciones/{link.TransaccionId}")" class="fw-semibold">#@link.TransaccionId</a>
                                }
                                else
                                {
                                  <span class="text-muted">Manual</span>
                                }
                              </td>
                              <td>@link.PaymentDate.ToString("dd/MM/yyyy")</td>
                              <td class="text-end">@FormatCurrency(link.Amount)</td>
                              <td class="text-end">
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger"
                                        @onclick="() => UnlinkTransactionAsync(link)"
                                        disabled="@(IsReadOnlyOrMutating || link.TransaccionId <= 0)">
                                  @(UnlinkingPaymentId == link.PaymentId ? "Desligando..." : "Desligar")
                                </button>
                              </td>
                            </tr>
                          }
                        </tbody>
                      </table>
                    </div>
                  }

                  <h3 class="h6">Ligar póliza</h3>
                  <div class="input-group mb-2">
                    <input class="form-control" @bind="TransactionSearchText" @bind:event="oninput" placeholder="ID, concepto, referencia o memo" />
                    <button type="button" class="btn btn-outline-secondary" @onclick="SearchTransactionsAsync">Buscar</button>
                  </div>
                  <div class="table-responsive recurrent-ap-candidates">
                    <table class="table table-sm align-middle">
                      <tbody>
                        @foreach (var transaction in TransactionCandidates)
                        {
                          <tr>
                            <td>
                              <div class="fw-semibold">#@transaction.Id · @transaction.Fecha.ToString("dd/MM/yyyy")</div>
                              <div class="small text-muted">@transaction.Concepto</div>
                            </td>
                            <td class="text-end">@FormatCurrency(transaction.Monto)</td>
                            <td class="text-end">
                              <button type="button" class="btn btn-sm btn-outline-success" @onclick="() => LinkTransactionAsync(transaction)" disabled="@IsReadOnlyOrMutating">Ligar</button>
                            </td>
                          </tr>
                        }
                      </tbody>
                    </table>
                  </div>
                </div>

                <div class="col-12">
                  <h3 class="h6">Archivos</h3>
                  <InputFile OnChange="UploadAttachmentAsync" disabled="@IsReadOnlyOrMutating" />
                  <div class="table-responsive mt-2">
                    <table class="table table-sm align-middle">
                      <tbody>
                        @foreach (var attachment in Attachments)
                        {
                          <tr>
                            <td>@attachment.FileName</td>
                            <td class="text-muted small">@attachment.UploadedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-end">
                              <button type="button" class="btn btn-sm btn-outline-info" @onclick="() => DownloadAttachmentAsync(attachment)">Abrir</button>
                              <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAttachmentAsync(attachment)" disabled="@IsReadOnlyOrMutating">Eliminar</button>
                            </td>
                          </tr>
                        }
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>
          </section>
        }
      </div>
    </div>
</div>
