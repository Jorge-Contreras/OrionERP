@page "/cuenta/acceso"
@model OrionERP.Bruno.Web.Pages.Account.LoginModel
@using Microsoft.Extensions.Options
@using OrionERP.Bruno.Web.Configuration
@inject IOptions<BrunoTurnstileOptions> Turnstile
@inject IWebHostEnvironment Environment
@{
  ViewData["Title"] = "Acceso · Club Bruno";
  var canValidateRequest = Environment.IsDevelopment() || Turnstile.Value.IsConfigured;
}
<div class="account-shell"><div class="account-art" aria-hidden="true"></div><section class="account-panel"><span>Club Bruno</span><h1>Qué gusto verte</h1><p>Entra para consultar tus puntos y generar un QR temporal.</p>
@if (!canValidateRequest) { <p class="account-error account-error--notice" role="alert">El acceso está temporalmente en mantenimiento. Intenta nuevamente más tarde.</p> }
<form method="post" class="account-form" asp-route-returnUrl="@Model.ReturnUrl"><div asp-validation-summary="ModelOnly"></div>
<label>Correo <input asp-for="Input.Email" autocomplete="email" /><span asp-validation-for="Input.Email"></span></label>
<label>Contraseña <input asp-for="Input.Password" autocomplete="current-password" /><span asp-validation-for="Input.Password"></span></label>
<label class="check"><input asp-for="Input.RememberMe" /> Mantener mi sesión en este dispositivo</label>
@if (Turnstile.Value.IsConfigured) { <div class="cf-turnstile" data-theme="dark" data-sitekey="@Turnstile.Value.SiteKey" data-action="member-login"></div> }
<button class="button button--accent" type="submit" disabled="@(!canValidateRequest)">Entrar</button></form>
<div class="account-links"><a href="/cuenta/recuperar">Olvidé mi contraseña</a><a href="/cuenta/reenviar-confirmacion">Reenviar confirmación</a><a href="/cuenta/registro">Crear cuenta</a><a href="/">Volver al sitio</a></div></section></div><partial name="_ValidationScriptsPartial" />
