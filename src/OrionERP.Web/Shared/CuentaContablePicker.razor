@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using OrionERP.Application.Features.Contabilidad.ContabilidadRegistros
@using OrionERP.Web.State

<div class="d-flex flex-column gap-3">
  <div class="input-group">
    <input class="form-control"
           placeholder="Busca por id, código Nivel1 o descripción"
           @bind-value="searchTerm"
           @bind-value:event="oninput"
           @onkeydown="OnSearchKeyDown"
           disabled="@string.IsNullOrWhiteSpace(currentRfc)" />
    <button class="btn btn-outline-primary"
            type="button"
            @onclick="() => SearchAccountsAsync()"
            disabled="@(!CanSearchMain)">
      Buscar
    </button>
    @if (AllowAccountManagement)
    {
      <button class="btn btn-outline-secondary"
              type="button"
              @onclick="ShowCreateNivel3Modal"
              disabled="@(!CanOpenCreateModal)">
        Crear Nivel 3
      </button>
    }
  </div>

  @if (string.IsNullOrWhiteSpace(currentRfc))
  {
    <div class="text-muted small">La sesión no tiene una empresa activa. Vuelve a iniciar sesión.</div>
  }
  else
  {
    <div class="text-muted small">Presiona Enter para buscar. Los encabezados solo muestran contexto; la selecci&oacute;n final siempre es un Nivel 3.</div>
  }

  @if (showSearchResults)
  {
    if (searchDisplayRows.Any())
    {
      <div class="table-responsive border rounded" style="max-height: 420px; overflow-y: auto;">
        <table class="table table-sm table-hover align-middle mb-0">
          <thead class="table-light" style="position: sticky; top: 0;">
            <tr>
              <th>Id</th>
              <th>Nivel 1</th>
              <th>Nivel 2</th>
              <th>Nivel 3</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            @foreach (var row in searchDisplayRows)
            {
              <tr class="@GetSearchRowClass(row)"
                  style="@GetSearchRowStyle(row)"
                  @onclick="() => OnDisplayRowClickedAsync(row)">
                <td>@(row.DisplayId?.ToString() ?? string.Empty)</td>
                <td>
                  @if (row.IsNivel1Header)
                  {
                    <span class="badge text-bg-secondary me-2">Nivel 1</span>
                  }
                  @row.Nivel1Descripcion
                </td>
                <td>
                  @if (row.IsNivel2Header)
                  {
                    <span class="badge text-bg-secondary me-2">Nivel 2</span>
                  }
                  @row.Nivel2Descripcion
                </td>
                <td>@row.Nivel3Descripcion</td>
                <td class="text-end">
                  @if (AllowAccountManagement && row.IsSelectable && row.Account is not null)
                  {
                    <button class="btn btn-sm btn-outline-secondary"
                            type="button"
                            title="Editar Nivel 3"
                            @onclick="() => ShowEditNivel3Modal(row.Account)"
                            @onclick:stopPropagation="true">
                      <i class="oi oi-pencil"></i>
                    </button>
                  }
                </td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    }
    else if (hasExecutedSearch)
    {
      <div class="alert alert-warning mb-0" role="alert">
        No se encontraron cuentas con ese criterio.
      </div>
    }
  }
</div>

@if (showNivel3Modal)
{
  <div class="modal fade show" tabindex="-1" style="display: block;" role="dialog" aria-modal="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">@(isEditingNivel3 ? "Editar Nivel 3" : "Crear Nivel 3")</h5>
          <button type="button" class="btn-close" @onclick="CloseNivel3Modal"></button>
        </div>
        <div class="modal-body d-flex flex-column gap-3">
          @if (!isEditingNivel3)
          {
            <div class="row g-3">
              <div class="col-lg-6">
                <label class="form-label">Buscar Nivel 1</label>
                <div class="input-group">
                  <input class="form-control"
                         placeholder="Ej. 102 o BANCOS"
                         @bind-value="createNivel1Term"
                         @bind-value:event="oninput"
                         @onkeydown="OnCreateNivel1KeyDown" />
                  <button class="btn btn-outline-primary"
                          type="button"
                          @onclick="() => SearchCreateNivel1Async()"
                          disabled="@string.IsNullOrWhiteSpace(createNivel1Term)">
                    Buscar
                  </button>
                </div>

                @if (createNivel1Results.Any())
                {
                  <div class="table-responsive mt-2 border rounded" style="max-height: 220px; overflow-y: auto;">
                    <table class="table table-sm table-hover mb-0">
                      <thead class="table-light">
                        <tr>
                          <th>Id</th>
                          <th>Nivel 1</th>
                          <th>Descripci&oacute;n</th>
                        </tr>
                      </thead>
                      <tbody>
                        @foreach (var item in createNivel1Results)
                        {
                          <tr role="button" style="cursor: pointer;" @onclick="() => SelectCreateNivel1Async(item)">
                            <td>@item.Id</td>
                            <td>@item.Nivel1</td>
                            <td>@item.Descripcion</td>
                          </tr>
                        }
                      </tbody>
                    </table>
                  </div>
                }
              </div>

              <div class="col-lg-6">
                <label class="form-label">Buscar Nivel 2</label>
                <div class="input-group">
                  <input class="form-control"
                         placeholder="Ej. 01 o descripci&oacute;n"
                         @bind-value="createNivel2Term"
                         @bind-value:event="oninput"
                         @onkeydown="OnCreateNivel2KeyDown"
                         disabled="@(!CanSearchCreateNivel2)" />
                  <button class="btn btn-outline-primary"
                          type="button"
                          @onclick="() => SearchCreateNivel2Async()"
                          disabled="@(!CanSearchCreateNivel2 || string.IsNullOrWhiteSpace(createNivel2Term))">
                    Buscar
                  </button>
                </div>

                @if (createNivel2Results.Any())
                {
                  <div class="table-responsive mt-2 border rounded" style="max-height: 220px; overflow-y: auto;">
                    <table class="table table-sm table-hover mb-0">
                      <thead class="table-light">
                        <tr>
                          <th>Id</th>
                          <th>Nivel 2</th>
                          <th>Descripci&oacute;n</th>
                        </tr>
                      </thead>
                      <tbody>
                        @foreach (var item in createNivel2Results)
                        {
                          <tr role="button" style="cursor: pointer;" @onclick="() => SelectCreateNivel2Async(item)">
                            <td>@item.Id</td>
                            <td>@item.Nivel2</td>
                            <td>@item.Descripcion</td>
                          </tr>
                        }
                      </tbody>
                    </table>
                  </div>
                }
              </div>
            </div>

            <div class="d-flex flex-wrap gap-2">
              <span class="badge text-bg-secondary">Nivel 1: @FormatSelectionValue(createSelection.Nivel1)</span>
              <span class="badge text-bg-secondary">Nivel 2: @FormatSelectionValue(createSelection.Nivel2)</span>
            </div>

            @if (createSelection.HasNivel2)
            {
              <div class="d-flex flex-column gap-2">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                  <label class="form-label mb-0">Niveles 3 existentes</label>
                  <span class="text-muted small">Siguiente sugerido: @FormatSelectionValue(NormalizeTwoDigits(nivel3Model.Nivel3))</span>
                </div>

                @if (createNivel3Results.Any())
                {
                  <div class="table-responsive border rounded" style="max-height: 220px; overflow-y: auto;">
                    <table class="table table-sm table-hover mb-0">
                      <thead class="table-light">
                        <tr>
                          <th>Id</th>
                          <th>Nivel 3</th>
                          <th>Descripci&oacute;n</th>
                        </tr>
                      </thead>
                      <tbody>
                        @foreach (var item in createNivel3Results)
                        {
                          <tr>
                            <td>@item.Id</td>
                            <td>@NormalizeTwoDigits(item.Nivel3)</td>
                            <td>@item.Descripcion</td>
                          </tr>
                        }
                      </tbody>
                    </table>
                  </div>
                }
                else
                {
                  <div class="text-muted small">No hay Niveles 3 registrados para esta combinaci&oacute;n. Se sugiri&oacute; 01.</div>
                }
              </div>
            }
          }

          <div class="row g-3">
            <div class="col-md-4">
              <label class="form-label">Nivel 1</label>
              <input class="form-control" value="@(isEditingNivel3 ? nivel3Model.Nivel1 : createSelection.Nivel1)" readonly />
            </div>
            <div class="col-md-4">
              <label class="form-label">Nivel 2</label>
              <input class="form-control" value="@(isEditingNivel3 ? NormalizeTwoDigits(nivel3Model.Nivel2) : createSelection.Nivel2)" readonly />
            </div>
            <div class="col-md-4">
              <label class="form-label">Nivel 3</label>
              <input class="form-control"
                     @bind="nivel3Model.Nivel3"
                     disabled="@isEditingNivel3" />
            </div>
            <div class="col-12">
              <label class="form-label">Descripci&oacute;n</label>
              <input class="form-control" @bind="nivel3Model.Descripcion" />
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" @onclick="CloseNivel3Modal">Cancelar</button>
          <button type="button" class="btn btn-primary" @onclick="SaveNivel3Async">Guardar</button>
        </div>
      </div>
    </div>
  </div>
  <div class="modal-backdrop fade show"></div>
}

@code {
  [Inject] public ICuentasContablesRepository CuentasRepository { get; set; } = default!;
  [Parameter, EditorRequired] public string Rfc { get; set; } = string.Empty;
  [Parameter] public CuentaContableSelection? Selection { get; set; }
  [Parameter] public EventCallback<CuentaContableSelection?> SelectionChanged { get; set; }
  [Parameter] public EventCallback SearchRequested { get; set; }
  [Parameter] public EventCallback<string?> ErrorChanged { get; set; }
  [Parameter] public bool AllowAccountManagement { get; set; } = true;

  private string? currentRfc;
  private string? lastLoadedRfc;
  private CuentaContableSelection currentSelection = new();
  private string searchTerm = string.Empty;
  private readonly List<CuentasContablesDto> searchResults = new();
  private readonly List<CuentaContableDisplayRow> searchDisplayRows = new();
  private bool showSearchResults;
  private bool hasExecutedSearch;

  private bool showNivel3Modal;
  private bool isEditingNivel3;
  private CuentasContablesDto nivel3Model = new();
  private CuentaContableSelection createSelection = new();
  private string createNivel1Term = string.Empty;
  private string createNivel2Term = string.Empty;
  private readonly List<CuentasContablesDto> createNivel1Results = new();
  private readonly List<CuentasContablesDto> createNivel2Results = new();
  private readonly List<CuentasContablesDto> createNivel3Results = new();

  private bool CanSearchMain => !string.IsNullOrWhiteSpace(currentRfc) && !string.IsNullOrWhiteSpace(searchTerm);
  private bool CanOpenCreateModal => AllowAccountManagement && !string.IsNullOrWhiteSpace(currentRfc);
  private bool CanSearchCreateNivel2 => !string.IsNullOrWhiteSpace(currentRfc) && createSelection.HasNivel1;

  public bool RequiresDirectAccountResolution => false;

  protected override Task OnParametersSetAsync()
  {
    if (!EqualsReference(currentSelection, Selection))
    {
      currentSelection = Selection ?? new CuentaContableSelection();
    }

    var normalizedRfc = string.IsNullOrWhiteSpace(Rfc) ? null : Rfc.Trim().ToUpperInvariant();
    if (!string.Equals(currentRfc, normalizedRfc, StringComparison.OrdinalIgnoreCase))
    {
      currentRfc = normalizedRfc;
    }

    if (!string.Equals(lastLoadedRfc, currentRfc, StringComparison.OrdinalIgnoreCase))
    {
      lastLoadedRfc = currentRfc;
      ResetSearchResults();
      ResetCreateWorkflow();
      if (showNivel3Modal && !isEditingNivel3)
      {
        nivel3Model = new CuentasContablesDto();
      }
    }

    return Task.CompletedTask;
  }

  public async Task<bool> TryResolveDirectAccountAsync()
  {
    if (currentSelection.HasNivel3)
    {
      return true;
    }

    if (string.IsNullOrWhiteSpace(searchTerm) || !int.TryParse(searchTerm.Trim(), out var id) || id <= 0)
    {
      return false;
    }

    try
    {
      var account = await CuentasRepository.GetByIdAsync(id);
      if (account is null || !IsSelectableNivel3Account(account))
      {
        return false;
      }

      return await ApplyAccountAsync(account);
    }
    catch (Exception ex)
    {
      await NotifyErrorAsync("No se pudo resolver la cuenta contable.", ex);
      return false;
    }
  }

  private async Task OnSearchKeyDown(KeyboardEventArgs args)
  {
    if (!IsEnterKey(args))
    {
      return;
    }

    await SearchAccountsAsync();
  }

  private async Task SearchAccountsAsync(bool autoSelectSingle = true)
  {
    ResetSearchResults();

    if (string.IsNullOrWhiteSpace(currentRfc))
    {
      await NotifyErrorAsync("La sesión no tiene una empresa activa. Vuelve a iniciar sesión.");
      return;
    }

    var term = searchTerm?.Trim() ?? string.Empty;
    if (string.IsNullOrWhiteSpace(term))
    {
      return;
    }

    try
    {
      var results = (await CuentasRepository.SearchUnifiedAsync(currentRfc, term, 250)).ToList();

      searchResults.AddRange(results);
      RebuildDisplayRows();
      hasExecutedSearch = true;
      showSearchResults = true;
      await ClearErrorAsync();

      if (!autoSelectSingle)
      {
        return;
      }

      var selectableRows = searchDisplayRows.Where(row => row.IsSelectable).ToList();
      if (selectableRows.Count == 1 && selectableRows[0].Account is not null)
      {
        await SelectSearchResultAsync(selectableRows[0].Account!);
      }
    }
    catch (Exception ex)
    {
      await NotifyErrorAsync("No se pudo buscar cuentas contables.", ex);
    }
  }

  private void RebuildDisplayRows()
  {
    searchDisplayRows.Clear();

    foreach (var nivel1Group in searchResults
                 .OrderBy(item => item.Nivel1, StringComparer.OrdinalIgnoreCase)
                 .ThenBy(item => NormalizeTwoDigits(item.Nivel2), StringComparer.OrdinalIgnoreCase)
                 .ThenBy(item => NormalizeTwoDigits(item.Nivel3), StringComparer.OrdinalIgnoreCase)
                 .GroupBy(item => item.Nivel1, StringComparer.OrdinalIgnoreCase))
    {
      var nivel1Header = nivel1Group.FirstOrDefault(IsNivel1HeaderAccount) ?? nivel1Group.First();
      searchDisplayRows.Add(CuentaContableDisplayRow.CreateNivel1Header(nivel1Header));

      foreach (var nivel2Group in nivel1Group
                   .GroupBy(item => NormalizeTwoDigits(item.Nivel2), StringComparer.OrdinalIgnoreCase))
      {
        if (!string.Equals(nivel2Group.Key, "00", StringComparison.OrdinalIgnoreCase))
        {
          searchDisplayRows.Add(CuentaContableDisplayRow.CreateNivel2Header(nivel2Group.First()));
        }

        foreach (var account in nivel2Group
                     .Where(IsSelectableNivel3Account)
                     .OrderBy(item => GetNivelSequenceNumber(item.Nivel3))
                     .ThenBy(item => NormalizeTwoDigits(item.Nivel3), StringComparer.OrdinalIgnoreCase))
        {
          searchDisplayRows.Add(CuentaContableDisplayRow.CreateSelectableAccount(account));
        }
      }
    }
  }

  private async Task OnDisplayRowClickedAsync(CuentaContableDisplayRow row)
  {
    if (!row.IsSelectable || row.Account is null)
    {
      return;
    }

    await SelectSearchResultAsync(row.Account);
  }

  private async Task SelectSearchResultAsync(CuentasContablesDto account)
  {
    await ApplyAccountAsync(account);
    ResetSearchResults();
  }

  private async Task<bool> ApplyAccountAsync(CuentasContablesDto account)
  {
    if (!string.Equals(currentRfc, account.Rfc?.Trim(), StringComparison.OrdinalIgnoreCase))
    {
      await NotifyErrorAsync("La cuenta contable no pertenece a la empresa de la sesión.");
      return false;
    }

    currentSelection = new CuentaContableSelection
    {
      Id = account.Id,
      Rfc = account.Rfc,
      Nivel1 = account.Nivel1,
      Nivel2 = NormalizeTwoDigits(account.Nivel2),
      Nivel3 = NormalizeTwoDigits(account.Nivel3),
      Nivel1Descripcion = account.Nivel1Descripcion,
      Nivel2Descripcion = account.Nivel2Descripcion,
      Nivel3Descripcion = account.Nivel3Descripcion,
      Descripcion = account.Descripcion
    };

    await SelectionChanged.InvokeAsync(currentSelection);
    await ClearErrorAsync();
    return true;
  }

  private async Task OnCreateNivel1KeyDown(KeyboardEventArgs args)
  {
    if (!IsEnterKey(args))
    {
      return;
    }

    await SearchCreateNivel1Async();
  }

  private async Task OnCreateNivel2KeyDown(KeyboardEventArgs args)
  {
    if (!IsEnterKey(args))
    {
      return;
    }

    await SearchCreateNivel2Async();
  }

  private async Task SearchCreateNivel1Async(bool loadDefaults = false)
  {
    createNivel1Results.Clear();
    createNivel2Results.Clear();
    createNivel3Results.Clear();
    createSelection = new CuentaContableSelection { Rfc = currentRfc };
    nivel3Model = new CuentasContablesDto();

    if (string.IsNullOrWhiteSpace(currentRfc))
    {
      return;
    }

    var term = loadDefaults ? string.Empty : (createNivel1Term?.Trim() ?? string.Empty);
    if (!loadDefaults && string.IsNullOrWhiteSpace(term))
    {
      return;
    }

    try
    {
      var results = await CuentasRepository.SearchNivel1Async(currentRfc, term, loadDefaults ? 25 : 200);
      createNivel1Results.AddRange(results);
      await ClearErrorAsync();
    }
    catch (Exception ex)
    {
      await NotifyErrorAsync("No se pudo buscar cuentas de nivel 1.", ex);
    }
  }

  private async Task SearchCreateNivel2Async(bool loadDefaults = false)
  {
    createNivel2Results.Clear();
    createNivel3Results.Clear();

    if (!CanSearchCreateNivel2 || string.IsNullOrWhiteSpace(currentRfc) || string.IsNullOrWhiteSpace(createSelection.Nivel1))
    {
      return;
    }

    var term = loadDefaults ? string.Empty : (createNivel2Term?.Trim() ?? string.Empty);
    if (!loadDefaults && string.IsNullOrWhiteSpace(term))
    {
      return;
    }

    try
    {
      var results = await CuentasRepository.SearchNivel2Async(currentRfc, createSelection.Nivel1!, term);
      createNivel2Results.AddRange(results);
      await ClearErrorAsync();
    }
    catch (Exception ex)
    {
      await NotifyErrorAsync("No se pudo buscar cuentas de nivel 2.", ex);
    }
  }

  private async Task SelectCreateNivel1Async(CuentasContablesDto dto)
  {
    createSelection = new CuentaContableSelection
    {
      Rfc = dto.Rfc,
      Nivel1 = dto.Nivel1
    };

    createNivel1Term = dto.Nivel1;
    createNivel2Term = string.Empty;
    createNivel1Results.Clear();
    createNivel2Results.Clear();
    createNivel3Results.Clear();
    nivel3Model = new CuentasContablesDto();
    await SearchCreateNivel2Async(loadDefaults: true);
  }

  private async Task SelectCreateNivel2Async(CuentasContablesDto dto)
  {
    createSelection = new CuentaContableSelection
    {
      Rfc = dto.Rfc,
      Nivel1 = dto.Nivel1,
      Nivel2 = NormalizeTwoDigits(dto.Nivel2)
    };

    createNivel2Term = createSelection.Nivel2 ?? string.Empty;
    createNivel2Results.Clear();
    nivel3Model = new CuentasContablesDto();
    await LoadCreateNivel3Async();
  }

  private void ShowCreateNivel3Modal()
  {
    if (!AllowAccountManagement)
    {
      return;
    }

    isEditingNivel3 = false;
    nivel3Model = new CuentasContablesDto();
    ResetCreateWorkflow();
    showNivel3Modal = true;
  }

  private void ShowEditNivel3Modal(CuentasContablesDto item)
  {
    if (!AllowAccountManagement)
    {
      return;
    }

    isEditingNivel3 = true;
    nivel3Model = item with { };
    showNivel3Modal = true;
  }

  private void CloseNivel3Modal()
  {
    showNivel3Modal = false;
    isEditingNivel3 = false;
    nivel3Model = new CuentasContablesDto();
    ResetCreateWorkflow();
  }

  private async Task SaveNivel3Async()
  {
    try
    {
      if (isEditingNivel3)
      {
        if (nivel3Model.Id <= 0)
        {
          await NotifyErrorAsync("No se pudo identificar el Nivel 3 que se intenta editar.");
          return;
        }

        await CuentasRepository.UpdateNivel3DescripcionAsync(nivel3Model.Id, nivel3Model.Descripcion);
        await ClearErrorAsync();

        if (currentSelection.Id == nivel3Model.Id)
        {
          currentSelection = new CuentaContableSelection
          {
            Id = currentSelection.Id,
            Rfc = currentSelection.Rfc,
            Nivel1 = currentSelection.Nivel1,
            Nivel2 = currentSelection.Nivel2,
            Nivel3 = currentSelection.Nivel3,
            Descripcion = nivel3Model.Descripcion
          };

          await SelectionChanged.InvokeAsync(currentSelection);
        }

        if (showSearchResults)
        {
          await SearchAccountsAsync(autoSelectSingle: false);
        }
      }
      else
      {
        if (string.IsNullOrWhiteSpace(currentRfc) || !createSelection.HasNivel2)
        {
          await NotifyErrorAsync("Selecciona un Nivel 1 y un Nivel 2 antes de crear un Nivel 3.");
          return;
        }

        nivel3Model.Nivel3 = NormalizeTwoDigits(nivel3Model.Nivel3);
        if (string.IsNullOrWhiteSpace(nivel3Model.Nivel3))
        {
          await NotifyErrorAsync("Captura el codigo del Nivel 3.");
          return;
        }

        var newId = await CuentasRepository.CreateNivel3Async(
            currentRfc,
            createSelection.Nivel1!,
            createSelection.Nivel2!,
            nivel3Model.Nivel3,
            nivel3Model.Descripcion);

        if (newId == -1)
        {
          await NotifyErrorAsync("El Nivel 3 ya existe.");
          return;
        }

        var createdAccount = await CuentasRepository.GetByIdAsync(newId);
        if (createdAccount is not null)
        {
          await ApplyAccountAsync(createdAccount);
        }
      }

      CloseNivel3Modal();
    }
    catch (Exception ex)
    {
      await NotifyErrorAsync("No se pudo guardar el Nivel 3.", ex);
    }
  }

  private async Task NotifyErrorAsync(string message, Exception? exception = null)
  {
    if (exception is not null)
    {
      Console.Error.WriteLine($"[CuentaContablePicker] {message} {exception}");
    }
    else
    {
      Console.Error.WriteLine($"[CuentaContablePicker] {message}");
    }

    if (ErrorChanged.HasDelegate)
    {
      await ErrorChanged.InvokeAsync(message);
    }
  }

  private async Task ClearErrorAsync()
  {
    if (ErrorChanged.HasDelegate)
    {
      await ErrorChanged.InvokeAsync(null);
    }
  }

  private void ResetSearchResults()
  {
    searchResults.Clear();
    searchDisplayRows.Clear();
    showSearchResults = false;
    hasExecutedSearch = false;
  }

  private void ResetCreateWorkflow()
  {
    createSelection = new CuentaContableSelection { Rfc = currentRfc };
    createNivel1Term = string.Empty;
    createNivel2Term = string.Empty;
    createNivel1Results.Clear();
    createNivel2Results.Clear();
    createNivel3Results.Clear();
  }

  private static bool EqualsReference(CuentaContableSelection? left, CuentaContableSelection? right)
    => ReferenceEquals(left, right) || (left is null && right is null);

  private static bool IsEnterKey(KeyboardEventArgs args)
    => args.Key == "Enter" || args.Code == "NumpadEnter";

  private static string NormalizeTwoDigits(string? value)
  {
    var trimmed = value?.Trim() ?? string.Empty;
    if (trimmed.Length == 1 && char.IsDigit(trimmed[0]))
    {
      return trimmed.PadLeft(2, '0');
    }

    return trimmed;
  }

  private static bool IsNivel1HeaderAccount(CuentasContablesDto account)
    => NormalizeTwoDigits(account.Nivel2) == "00" && NormalizeTwoDigits(account.Nivel3) == "00";

  private static bool IsNivel3HeaderAccount(CuentasContablesDto account)
    => NormalizeTwoDigits(account.Nivel2) != "00" && NormalizeTwoDigits(account.Nivel3) == "00";

  private static bool IsSelectableNivel3Account(CuentasContablesDto account)
    => NormalizeTwoDigits(account.Nivel3) != "00";

  private static int GetNivelSequenceNumber(string? value)
    => int.TryParse(NormalizeTwoDigits(value), out var parsed) && parsed > 0 ? parsed : int.MaxValue;

  private async Task LoadCreateNivel3Async()
  {
    createNivel3Results.Clear();

    if (string.IsNullOrWhiteSpace(currentRfc) || !createSelection.HasNivel2)
    {
      nivel3Model = new CuentasContablesDto();
      return;
    }

    try
    {
      var results = (await CuentasRepository.SearchNivel3Async(
              currentRfc,
              createSelection.Nivel1!,
              createSelection.Nivel2!,
              string.Empty,
              500))
          .Where(IsSelectableNivel3Account)
          .OrderBy(item => GetNivelSequenceNumber(item.Nivel3))
          .ThenBy(item => NormalizeTwoDigits(item.Nivel3), StringComparer.OrdinalIgnoreCase)
          .ToList();

      createNivel3Results.AddRange(results);
      nivel3Model = new CuentasContablesDto
      {
        Nivel3 = GetNextAvailableNivel3(results)
      };

      await ClearErrorAsync();
    }
    catch (Exception ex)
    {
      nivel3Model = new CuentasContablesDto();
      await NotifyErrorAsync("No se pudieron cargar los Niveles 3 existentes.", ex);
    }
  }

  private static string GetNextAvailableNivel3(IEnumerable<CuentasContablesDto> accounts)
  {
    var used = accounts
        .Select(item => GetNivelSequenceNumber(item.Nivel3))
        .Where(value => value != int.MaxValue)
        .Distinct()
        .ToHashSet();

    var next = 1;
    while (used.Contains(next))
    {
      next++;
    }

    return next.ToString("00");
  }

  private static string GetSearchRowClass(CuentaContableDisplayRow row)
  {
    if (row.IsNivel1Header)
    {
      return "table-secondary fw-semibold";
    }

    if (row.IsNivel2Header)
    {
      return "table-light";
    }

    return string.Empty;
  }

  private static string? GetSearchRowStyle(CuentaContableDisplayRow row)
    => row.IsSelectable ? "cursor: pointer;" : null;

  private static string FormatSelectionValue(string? value)
    => string.IsNullOrWhiteSpace(value) ? "Sin seleccionar" : value;

  private sealed class CuentaContableDisplayRow
  {
    public int? DisplayId { get; init; }
    public string Nivel1Descripcion { get; init; } = string.Empty;
    public string Nivel2Descripcion { get; init; } = string.Empty;
    public string Nivel3Descripcion { get; init; } = string.Empty;
    public bool IsNivel1Header { get; init; }
    public bool IsNivel2Header { get; init; }
    public bool IsSelectable { get; init; }
    public CuentasContablesDto? Account { get; init; }

    public static CuentaContableDisplayRow CreateNivel1Header(CuentasContablesDto account)
      => new()
      {
        DisplayId = account.Nivel1Id,
        Nivel1Descripcion = GetNivel1Descripcion(account),
        IsNivel1Header = true
      };

    public static CuentaContableDisplayRow CreateNivel2Header(CuentasContablesDto account)
      => new()
      {
        DisplayId = account.Nivel2Id,
        Nivel1Descripcion = GetNivel1Descripcion(account),
        Nivel2Descripcion = GetNivel2Descripcion(account),
        IsNivel2Header = true
      };

    public static CuentaContableDisplayRow CreateSelectableAccount(CuentasContablesDto account)
      => new()
      {
        DisplayId = account.Id,
        Nivel1Descripcion = GetNivel1Descripcion(account),
        Nivel2Descripcion = GetNivel2Descripcion(account),
        Nivel3Descripcion = GetNivel3Descripcion(account),
        IsSelectable = true,
        Account = account
      };

    private static string GetNivel1Descripcion(CuentasContablesDto account)
      => string.IsNullOrWhiteSpace(account.Nivel1Descripcion) ? account.Nivel1 : account.Nivel1Descripcion!;

    private static string GetNivel2Descripcion(CuentasContablesDto account)
    {
      if (NormalizeTwoDigits(account.Nivel2) == "00")
      {
        return string.Empty;
      }

      return string.IsNullOrWhiteSpace(account.Nivel2Descripcion) ? NormalizeTwoDigits(account.Nivel2) : account.Nivel2Descripcion!;
    }

    private static string GetNivel3Descripcion(CuentasContablesDto account)
      => string.IsNullOrWhiteSpace(account.Nivel3Descripcion) ? account.Descripcion : account.Nivel3Descripcion!;
  }
}
