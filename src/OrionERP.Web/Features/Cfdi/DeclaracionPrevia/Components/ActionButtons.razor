
@using OrionERP.Web.Features.Cfdi.DeclaracionPrevia.Pages
@inject IConfiguration Configuration

<td>
    <button class="btn btn-sm btn-outline-info"
            @onclick:stopPropagation="true"
            @onclick="() => OpenDetails()">
        PDF
    </button>
</td>
<td>
    <button class="btn btn-sm @(IsPlaceholderPoliza ? "btn-outline-danger" : "btn-outline-success")"
            title="@(IsPlaceholderPoliza ? "Crear Póliza" : "Ir a Transacción")"
            @onclick:stopPropagation="true"
            @onclick="() => HandlePolizaClick()">
        @(IsPlaceholderPoliza ? "Crear" : ItemPoliza)
    </button>
</td>

@code {
    [Parameter]
    public object Item { get; set; }

    [Parameter]
    public EventCallback<object> OnOpenDetails { get; set; }

    [Parameter]
    public EventCallback<object> OnHandlePolizaClick { get; set; }

    private string _placeholderTransaccionId => Configuration["PlaceholderTransaccionId"];

    private string? ItemPoliza => Item switch
    {
        DeclaracionPrevia.DeclaracionEmitida emitida => emitida.Poliza,
        DeclaracionPrevia.DeclaracionRecibida recibida => recibida.Poliza,
        _ => null
    };

    private bool IsPlaceholderPoliza => ItemPoliza == _placeholderTransaccionId?.ToString();

    private async Task OpenDetails()
    {
        await OnOpenDetails.InvokeAsync(Item);
    }

    private async Task HandlePolizaClick()
    {
        await OnHandlePolizaClick.InvokeAsync(Item);
    }
}
