
@using Microsoft.JSInterop
@using OrionERP.Application.Features.Cfdi.DeclaracionPrevia
@using OrionERP.Web.Services
@using OrionERP.Web.State
@inject IConfiguration Configuration
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IDeclaracionPreviaService DeclaracionService
@inject IUserRfcState RfcState
@inject IUiMessageService UiMessages

<td>
    <button class="btn btn-sm btn-outline-info"
            @onclick:stopPropagation="true"
            @onclick="OpenDetails">
        CFDI
    </button>
</td>
<td>
    <button class="btn btn-sm @(IsPlaceholderPoliza ? "btn-outline-danger" : "btn-outline-success")"
            title="@(IsPlaceholderPoliza ? "Crear Póliza" : "Ir a Transacción")"
            @onclick:stopPropagation="true"
            @onclick="HandlePolizaClick">
        @(IsPlaceholderPoliza ? "Crear" : ItemPoliza)
    </button>
</td>

@code {
    [Parameter]
    public object? Item { get; set; }

    private int? PlaceholderTransaccionId => _placeholderTransaccionId ??= ParsePlaceholder(Configuration["SatXml:PlaceholderTransaccionId"]);
    private int? _placeholderTransaccionId;

    private string? ItemPoliza => Item switch
    {
        DeclaracionCfdiBase baseCfdi => baseCfdi.Poliza,
        _ => null
    };

    private bool IsPlaceholderPoliza => PlaceholderTransaccionId.HasValue && ItemPoliza == PlaceholderTransaccionId.Value.ToString();

    private async Task OpenDetails()
    {
        if (Item is not DeclaracionEmitida emitida || emitida.XML_Attachment_ID is null)
        {
            return;
        }

        var url = $"/cfdi/html-cfdi/{emitida.XML_Attachment_ID}";

        try
        {
            await JS.InvokeVoidAsync("open", url, "_blank", "noopener,noreferrer");
        }
        catch
        {
            Nav.NavigateTo(url);
        }
    }

    private async Task HandlePolizaClick()
    {
        if (Item is not DeclaracionCfdiBase declaracion)
        {
            return;
        }

        if (IsPlaceholderPoliza)
        {
            try
            {
                var newTransaccionId = await GenerarPolizaDesdeComprobante(declaracion.Comprobante_Id);
                declaracion.Poliza = newTransaccionId.ToString();
                await InvokeAsync(StateHasChanged);
                await OpenLinkedTransaction(declaracion);
            }
            catch (Exception ex)
            {
                UiMessages.ShowError($"Error al crear la póliza: {ex.Message}");
            }
        }
        else
        {
            await OpenLinkedTransaction(declaracion);
        }
    }

    private async Task OpenLinkedTransaction(DeclaracionCfdiBase declaracion)
    {
        long? transId = declaracion switch
        {
            DeclaracionEmitida emitida => await TryGetLinkedTransactionId(() => DeclaracionService.GetLinkedTransactionIdAsync(emitida.Comprobante_Id)),
            DeclaracionRecibida recibida => await GetRecibidaTransactionId(recibida),
            _ => null
        };

        if (!transId.HasValue)
        {
            UiMessages.ShowWarning("No se encontró una Transacción vinculada a este CFDI.");
            return;
        }

        var url = $"/Contabilidad/transacciones/{transId.Value}";

        try
        {
            await JS.InvokeVoidAsync("open", url, "_blank", "noopener,noreferrer");
        }
        catch
        {
            Nav.NavigateTo(url);
        }
    }

    private async Task<long?> GetRecibidaTransactionId(DeclaracionRecibida recibida)
    {
        if (!string.IsNullOrWhiteSpace(recibida.Poliza) && long.TryParse(recibida.Poliza, out var polizaId))
        {
            return polizaId;
        }

        return await TryGetLinkedTransactionId(() => DeclaracionService.GetLinkedTransactionIdAsync(recibida.Comprobante_Id));
    }

    private async Task<long?> TryGetLinkedTransactionId(Func<Task<long?>> resolver)
    {
        try
        {
            return await resolver();
        }
        catch
        {
            return null;
        }
    }

    private async Task<int> GenerarPolizaDesdeComprobante(int comprobanteId)
    {
        return await DeclaracionService.GenerarPolizaDesdeComprobanteAsync(comprobanteId, RfcState.CurrentRfc ?? string.Empty);
    }

    private static int? ParsePlaceholder(string? placeholderSetting)
    {
        return int.TryParse(placeholderSetting, out var parsedPlaceholder) ? parsedPlaceholder : null;
    }
}
