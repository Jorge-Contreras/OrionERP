@page "/reservaciones/lista"
@attribute [Authorize(Roles = "Administrador,SatOperator")]

<PageTitle>Lista de Reservaciones</PageTitle>

<h3>Lista de Reservaciones</h3>

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="alert alert-danger">@ErrorMessage</div>
}

<div class="row g-2 mb-3">
    <div class="col-md-1">
        <label class="form-label">ID</label>
        <input class="form-control" type="number" @bind="Filter.Id" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Cliente</label>
        <input class="form-control" @bind="Filter.Cliente" />
    </div>
    <div class="col-md-2">
        <label class="form-label">Status</label>
        <input class="form-control" @bind="Filter.Status" />
    </div>
    <div class="col-md-2">
        <label class="form-label">Check-in desde</label>
        <input class="form-control" type="date" value="@CheckInFromText" @onchange="SetCheckInFrom" />
    </div>
    <div class="col-md-2">
        <label class="form-label">Check-in hasta</label>
        <input class="form-control" type="date" value="@CheckInToText" @onchange="SetCheckInTo" />
    </div>
    <div class="col-md-2 d-flex align-items-end">
        <div class="form-check">
            <input id="canceladas" class="form-check-input" type="checkbox" @bind="Filter.IncluirCanceladas" />
            <label class="form-check-label" for="canceladas">Incluir canceladas</label>
        </div>
    </div>
</div>

<div class="d-flex flex-wrap gap-2 mb-3">
    <button class="btn btn-primary" @onclick="BuscarAsync" disabled="@IsLoading">Buscar</button>
    <button class="btn btn-secondary" @onclick="LimpiarAsync" disabled="@IsLoading">Limpiar</button>
    <button class="btn btn-success" @onclick="NuevaReservacionAsync" disabled="@IsLoading">Nueva Reservación</button>
    <button class="btn btn-outline-danger" @onclick="BorrarVaciasAsync" disabled="@IsBusyDanger">BORRAR RESERVACIONES VACÍAS</button>
</div>

@if (IsLoading)
{
    <p><em>Cargando...</em></p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-striped table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Cliente</th>
                    <th>Check-in</th>
                    <th>Check-out</th>
                    <th>Status</th>
                    <th>Total</th>
                    <th>Pagado</th>
                    <th>Adeudo</th>
                    <th>Notas</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Reservaciones.Count == 0)
                {
                    <tr>
                        <td colspan="10" class="text-center text-muted">Sin reservaciones para mostrar.</td>
                    </tr>
                }
                else
                {
                    @foreach (var row in Reservaciones)
                    {
                        <tr>
                            <td>@row.Id</td>
                            <td>@row.Cliente</td>
                            <td>@FormatDate(row.CheckIn)</td>
                            <td>@FormatDate(row.CheckOut)</td>
                            <td>@row.Status</td>
                            <td>@row.TotalPrice.ToString("C")</td>
                            <td>@row.Pagado.ToString("C")</td>
                            <td class="@(row.PorPagar > 0 ? "text-danger fw-bold" : "text-success")">@row.PorPagar.ToString("C")</td>
                            <td title="@row.Notes">@Short(row.Notes, 50)</td>
                            <td>
                                <div class="btn-group btn-group-sm" role="group">
                                    <a class="btn btn-outline-primary" href="@($"/reservaciones/{row.Id}")">Detalles...</a>
                                    <button class="btn btn-outline-secondary" @onclick="() => AbrirReciboAsync(row.Id)">PDF..</button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}
