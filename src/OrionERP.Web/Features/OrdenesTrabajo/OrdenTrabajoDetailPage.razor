@page "/ordenes-trabajo/{Id:int}"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Administrador,OrdenTrabajoAdmin,OrdenTrabajoSupervisor,OrdenTrabajoOperador")]

<PageTitle>Orden de trabajo</PageTitle>

<div class="container-fluid py-3 orden-detail-page">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <a class="small" href="/ordenes-trabajo">Volver a ordenes</a>
            <h1 class="h3 mb-1">@(Order?.Folio ?? "Orden de trabajo")</h1>
            @if (Order is not null)
            {
                <p class="text-muted mb-0">@Order.Titulo</p>
            }
        </div>
        @if (Order is not null)
        {
            <div class="d-flex flex-wrap gap-2">
                <span class="@OrdenesTrabajoPage.GetStatusBadgeClass(Order.Estado) align-self-center">@OrdenesTrabajoPage.GetStatusLabel(Order.Estado)</span>
                <button class="btn btn-outline-secondary" type="button" @onclick="LoadAsync" disabled="@IsLoading">Actualizar</button>
            </div>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-danger">@ErrorMessage</div>
    }

    @if (Order is null)
    {
        <section class="card shadow-sm">
            <div class="card-body text-center text-muted py-5">@(IsLoading ? "Cargando orden..." : "No se encontro la orden.")</div>
        </section>
    }
    else
    {
        <div class="row g-3">
            <div class="col-12 col-xl-4">
                <section class="card shadow-sm mb-3">
                    <div class="card-body">
                        <h2 class="h5 mb-3">Datos generales</h2>
                        <div class="orden-detail-meta">
                            <div>
                                <span>Responsable</span>
                                <strong>@Order.OwnerName</strong>
                            </div>
                            <div>
                                <span>Programada</span>
                                <strong>@Order.FechaProgramada.ToString("yyyy-MM-dd")</strong>
                            </div>
                            <div>
                                <span>Ventana</span>
                                <strong>@OrdenesTrabajoPage.FormatWindow(Order.HoraInicioProgramada, Order.HoraFinProgramada)</strong>
                            </div>
                            <div>
                                <span>Ubicacion</span>
                                <strong>@OrdenesTrabajoPage.FormatTarget(Order)</strong>
                            </div>
                        </div>

                        @if (Order.Helpers.Count > 0)
                        {
                            <div class="mt-3">
                                <div class="small text-muted fw-semibold mb-1">Ayudantes</div>
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var participant in Order.Helpers)
                                    {
                                        <span class="badge text-bg-light">@participant.EmployeeName</span>
                                    }
                                </div>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(Order.Descripcion))
                        {
                            <div class="mt-3">
                                <div class="small text-muted fw-semibold mb-1">Descripcion</div>
                                <p class="mb-0">@Order.Descripcion</p>
                            </div>
                        }

                        <div class="d-grid gap-2 mt-3">
                            <span class="orden-action-wrap" title="@ExecutionBlockedReason">
                                <button class="btn btn-outline-primary" type="button" @onclick="StartAsync" disabled="@(!CanExecute || IsMutating)">Iniciar</button>
                            </span>
                            <span class="orden-action-wrap" title="@ExecutionBlockedReason">
                                <button class="btn btn-warning" type="button" @onclick="SubmitAsync" disabled="@(!CanExecute || IsMutating)">Enviar a revision</button>
                            </span>
                            @if (CanReview)
                            {
                                <span class="orden-action-wrap" title="@ReviewBlockedReason">
                                    <button class="btn btn-success" type="button" @onclick="ApproveAsync" disabled="@(!IsInReview || IsMutating)">Aprobar y cerrar</button>
                                </span>
                            }
                        </div>

                        @if (ExecutionBlockedReason is not null)
                        {
                            <p class="orden-action-hint mt-2 mb-0">@ExecutionBlockedReason</p>
                        }
                    </div>
                </section>

                @if (CanEdit)
                {
                    <section class="card shadow-sm mb-3">
                        <div class="card-body">
                            <h2 class="h5 mb-3">Editar antes de revision</h2>
                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="form-label">Titulo</label>
                                    <InputText class="form-control" @bind-Value="EditRequest.Titulo" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Responsable</label>
                                    <select class="form-select" @bind="EditRequest.OwnerEmployeeId">
                                        @foreach (var employee in Employees)
                                        {
                                            <option value="@employee.Id">@employee.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Ayudantes</label>
                                    <div class="orden-helper-list">
                                        @foreach (var employee in Employees)
                                        {
                                            <label class="form-check">
                                                <input class="form-check-input" type="checkbox" checked="@EditHelperIds.Contains(employee.Id)" @onchange="args => ToggleEditHelper(employee.Id, args)" />
                                                <span class="form-check-label">@employee.Name</span>
                                            </label>
                                        }
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Fecha</label>
                                    <InputDate class="form-control" @bind-Value="EditRequest.FechaProgramada" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Vence</label>
                                    <InputDate class="form-control" @bind-Value="EditRequest.FechaVencimiento" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Ubicacion</label>
                                    <InputText class="form-control" @bind-Value="EditRequest.Ubicacion" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Descripcion</label>
                                    <InputTextArea class="form-control" rows="3" @bind-Value="EditRequest.Descripcion" />
                                </div>
                            </div>
                            <button class="btn btn-primary mt-3 w-100" type="button" @onclick="SaveAsync" disabled="@IsMutating">Guardar cambios</button>
                        </div>
                    </section>
                }

                @if (CanReview && IsInReview)
                {
                    <section class="card shadow-sm mb-3">
                        <div class="card-body">
                            <h2 class="h5 mb-3">Rechazo</h2>
                            <InputTextArea class="form-control" rows="3" @bind-Value="ReviewReason" placeholder="Motivo de rechazo" />
                            <button class="btn btn-outline-danger mt-3 w-100" type="button" @onclick="RejectAsync" disabled="@IsMutating">Rechazar</button>
                        </div>
                    </section>
                }

                @if (CanEdit)
                {
                    <section class="card shadow-sm">
                        <div class="card-body">
                            <h2 class="h5 mb-3">Cancelar</h2>
                            <InputTextArea class="form-control" rows="3" @bind-Value="CancelReason" placeholder="Motivo de cancelacion" />
                            <button class="btn btn-outline-danger mt-3 w-100" type="button" @onclick="CancelAsync" disabled="@IsMutating">Cancelar orden</button>
                        </div>
                    </section>
                }
            </div>

            <div class="col-12 col-xl-8">
                <section class="card shadow-sm mb-3">
                    <div class="card-body">
                        <div class="d-flex flex-wrap justify-content-between gap-2 mb-3">
                            <div>
                                <h2 class="h5 mb-1">Ruta critica</h2>
                                <div class="text-muted small">@Order.CompletedStepCount / @Order.StepCount pasos completados</div>
                            </div>
                            @if (CanEditSteps)
                            {
                                <div class="d-flex flex-wrap gap-2">
                                    @if (IsEditingSteps)
                                    {
                                        <button class="btn btn-sm btn-outline-primary" type="button" @onclick="AddStep" disabled="@IsMutating">Agregar paso</button>
                                        <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="CancelStepEdit" disabled="@IsMutating">Cancelar edicion</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="StartStepEdit" disabled="@IsMutating">Editar ruta critica</button>
                                    }
                                </div>
                            }
                        </div>

                        @if (CanEditSteps && IsEditingSteps)
                        {
                            <div class="orden-step-editor mb-3">
                                @foreach (var step in StepEditor)
                                {
                                    <div class="orden-step-editor-row" @key="step">
                                        <div class="orden-step-editor-sequence">@step.Secuencia.ToString("0.##")</div>
                                        <div>
                                            <label class="form-label">Titulo</label>
                                            <InputText class="form-control" @bind-Value="step.Titulo" />
                                        </div>
                                        <div>
                                            <label class="form-label">Descripcion</label>
                                            <InputTextArea class="form-control" rows="2" @bind-Value="step.Descripcion" />
                                        </div>
                                        <div>
                                            <label class="form-label">Foto</label>
                                            <select class="form-select" @bind="step.PoliticaFoto">
                                                <option value="NO_PERMITIDA">No permitida</option>
                                                <option value="OPCIONAL">Opcional</option>
                                                <option value="REQUERIDA">Requerida</option>
                                            </select>
                                        </div>
                                        <div class="orden-step-editor-actions">
                                            <button class="btn btn-sm btn-outline-danger" type="button" @onclick="() => RemoveStep(step)" disabled="@(IsMutating || StepEditor.Count <= 1)">Quitar</button>
                                        </div>
                                    </div>
                                }
                                <button class="btn btn-primary" type="button" @onclick="SaveStepsAsync" disabled="@IsMutating">Guardar ruta critica</button>
                            </div>
                        }

                        <div class="orden-steps">
                            @foreach (var step in Order.Steps)
                            {
                                <article class="@GetStepCardClass(step)">
                                    <div class="orden-step-header">
                                        <div>
                                            <div class="orden-step-number">@step.Secuencia.ToString("0.##")</div>
                                            <h3>@step.Titulo</h3>
                                        </div>
                                        <span class="@GetStepBadgeClass(step.Estado)">@GetStepLabel(step.Estado)</span>
                                    </div>
                                    <p>@step.Descripcion</p>
                                    <div class="small text-muted mb-2">
                                        Foto: @GetPhotoPolicyLabel(step.PoliticaFoto)
                                        @if (step.ProcedimientoId.HasValue)
                                        {
                                            <span> · Procedimiento ref: @step.ProcedimientoId</span>
                                        }
                                    </div>
                                    <textarea class="form-control mb-2"
                                              rows="2"
                                              value="@GetStepNotes(step)"
                                              @onchange="args => SetStepNotes(step.Id, args.Value?.ToString())"
                                              disabled="@(!CanExecute)"></textarea>
                                    <div class="d-flex flex-wrap gap-2 mb-2">
                                        <button class="btn btn-sm btn-outline-success" type="button" @onclick="() => UpdateStepAsync(step, OrdenTrabajoCodes.PasoHecho)" disabled="@(!CanExecute || IsMutating)">Hecho</button>
                                        <button class="btn btn-sm btn-outline-warning" type="button" @onclick="() => UpdateStepAsync(step, OrdenTrabajoCodes.PasoIncidencia)" disabled="@(!CanExecute || IsMutating)">Incidencia</button>
                                        <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="() => UpdateStepAsync(step, OrdenTrabajoCodes.PasoNoAplica)" disabled="@(!CanExecute || IsMutating)">N/A</button>
                                    </div>

                                    @if (CanExecute && step.PoliticaFoto != OrdenTrabajoCodes.FotoNoPermitida)
                                    {
                                        <div class="orden-evidence-actions">
                                            <button class="btn btn-sm btn-primary" type="button" @onclick="() => OpenCameraAsync(step)" disabled="@(IsMutating || IsCameraStarting || IsCameraCapturing)">
                                                <span class="oi oi-camera-slr" aria-hidden="true"></span>
                                                Tomar foto
                                            </button>
                                            <label class="btn btn-sm btn-outline-secondary orden-file-upload">
                                                <span class="oi oi-cloud-upload" aria-hidden="true"></span>
                                                Subir archivo
                                                <InputFile OnChange="args => OnEvidenceSelectedAsync(step, args)"
                                                           disabled="@(IsMutating || IsCameraCapturing)" />
                                            </label>
                                        </div>

                                        @if (ActiveCameraStepId == step.Id)
                                        {
                                            <div class="orden-camera-panel mt-3">
                                                <video class="orden-camera-preview" @ref="CameraVideoElement" autoplay muted playsinline></video>
                                                @if (!string.IsNullOrWhiteSpace(CameraError))
                                                {
                                                    <div class="alert alert-warning py-2 mb-2">@CameraError</div>
                                                }
                                                @if (CameraDevices.Count > 1)
                                                {
                                                    <select class="form-select form-select-sm mb-2" value="@SelectedCameraDeviceId" @onchange="ChangeCameraAsync" disabled="@(IsCameraStarting || IsCameraCapturing)">
                                                        @foreach (var camera in CameraDevices)
                                                        {
                                                            <option value="@camera.DeviceId">@camera.Label</option>
                                                        }
                                                    </select>
                                                }
                                                <div class="d-flex flex-wrap gap-2">
                                                    <button class="btn btn-sm btn-success" type="button" @onclick="() => CaptureCameraAsync(step)" disabled="@(IsCameraStarting || IsCameraCapturing || !CameraSupported)">
                                                        @(IsCameraCapturing ? "Guardando..." : "Capturar")
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="CloseCameraAsync" disabled="@IsCameraCapturing">Cancelar</button>
                                                </div>
                                            </div>
                                        }
                                    }

                                    @if (step.Evidence.Count > 0)
                                    {
                                        <div class="orden-evidence-grid mt-3">
                                            @foreach (var evidence in step.Evidence.Where(item => !item.Eliminada))
                                            {
                                                <div class="orden-evidence">
                                                    <button class="orden-evidence-preview-button"
                                                            type="button"
                                                            title="@GetEvidenceActionTitle(evidence)"
                                                            @onclick="() => OpenEvidenceAsync(evidence)">
                                                        @if (IsImageEvidence(evidence) && evidence.ThumbnailBytes is { Length: > 0 })
                                                        {
                                                            <img src="@BuildThumbnailDataUrl(evidence)" alt="Evidencia @evidence.Id" />
                                                        }
                                                        else
                                                        {
                                                            <span class="@GetEvidencePlaceholderClass(evidence)">
                                                                <span class="@GetEvidenceIconClass(evidence)" aria-hidden="true"></span>
                                                                <span>@GetEvidenceTypeLabel(evidence)</span>
                                                            </span>
                                                        }
                                                    </button>
                                                    <div class="orden-evidence-file-name" title="@evidence.FileName">@GetEvidenceDisplayName(evidence)</div>
                                                    <div class="small text-muted">@FormatFileSize(evidence.SizeBytes)</div>
                                                    <div class="small">@evidence.CapturadaPor</div>
                                                    <div class="small text-muted">@evidence.CapturadaEn.ToString("yyyy-MM-dd HH:mm")</div>
                                                    <span class="@GetCaptureSourceBadgeClass(evidence.CaptureSource)">@GetCaptureSourceLabel(evidence.CaptureSource)</span>
                                                    @if (CanRemoveEvidence)
                                                    {
                                                        <button class="btn btn-sm btn-link text-danger p-0" type="button" @onclick="() => RemoveEvidenceAsync(step, evidence.Id)">Quitar</button>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                </article>
                            }
                        </div>
                    </div>
                </section>

                @if (CanReview)
                {
                    <section class="card shadow-sm mb-3">
                        <div class="card-body">
                            <h2 class="h5 mb-3">Transacciones ligadas</h2>
                            <div class="row g-2 align-items-end mb-3">
                                <div class="col-md-8">
                                    <label class="form-label">Buscar transaccion</label>
                                    <InputText class="form-control" @bind-Value="TransactionSearchText" />
                                </div>
                                <div class="col-md-4 d-grid">
                                    <button class="btn btn-outline-primary" type="button" @onclick="SearchTransactionsAsync">Buscar</button>
                                </div>
                            </div>
                            @if (TransactionMatches.Count > 0)
                            {
                                <div class="list-group mb-3">
                                    @foreach (var item in TransactionMatches)
                                    {
                                        <button class="list-group-item list-group-item-action d-flex justify-content-between gap-2" type="button" @onclick="() => LinkTransactionAsync(item.Id)">
                                            <span>@item.Fecha.ToString("yyyy-MM-dd") · @item.Concepto</span>
                                            <strong>@item.Monto.ToString("C2", CurrencyCulture)</strong>
                                        </button>
                                    }
                                </div>
                            }

                            <div class="table-responsive">
                                <table class="table table-sm mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>ID</th>
                                            <th>Fecha</th>
                                            <th>Concepto</th>
                                            <th class="text-end">Monto</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Order.Transactions.Count == 0)
                                        {
                                            <tr><td colspan="5" class="text-center text-muted py-3">Sin transacciones ligadas.</td></tr>
                                        }
                                        else
                                        {
                                            @foreach (var tx in Order.Transactions)
                                            {
                                                <tr>
                                                    <td>@tx.TransaccionId</td>
                                                    <td>@tx.Fecha.ToString("yyyy-MM-dd")</td>
                                                    <td>@tx.Concepto</td>
                                                    <td class="text-end">@tx.Monto.ToString("C2", CurrencyCulture)</td>
                                                    <td class="text-end"><button class="btn btn-sm btn-outline-danger" type="button" @onclick="() => UnlinkTransactionAsync(tx.TransaccionId)">Quitar</button></td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </section>
                }

                <section class="card shadow-sm">
                    <div class="card-body">
                        <h2 class="h5 mb-3">Auditoria</h2>
                        <div class="list-group list-group-flush">
                            @foreach (var audit in Order.Audit)
                            {
                                <div class="list-group-item px-0">
                                    <div class="d-flex justify-content-between gap-2">
                                        <strong>@audit.Evento</strong>
                                        <span class="small text-muted">@audit.CreadoEn.ToString("yyyy-MM-dd HH:mm")</span>
                                    </div>
                                    <div class="small text-muted">@audit.CreadoPor</div>
                                    @if (!string.IsNullOrWhiteSpace(audit.Detalle))
                                    {
                                        <div>@audit.Detalle</div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </section>
            </div>
        </div>
    }

    @if (IsEvidencePreviewOpen)
    {
        <div class="orden-image-viewer"
             role="dialog"
             aria-modal="true"
             aria-label="@EvidencePreviewTitle"
             tabindex="-1"
             @onclick="CloseEvidencePreview"
             @onkeydown="HandleEvidencePreviewKeyDown">
            <div class="orden-image-viewer-dialog" @onclick:stopPropagation="true">
                <div class="orden-image-viewer-toolbar">
                    <div>
                        <div class="orden-image-viewer-title">@EvidencePreviewTitle</div>
                        @if (!string.IsNullOrWhiteSpace(EvidencePreviewSubtitle))
                        {
                            <div class="orden-image-viewer-subtitle">@EvidencePreviewSubtitle</div>
                        }
                    </div>
                    <button class="btn btn-sm btn-light orden-image-viewer-close"
                            type="button"
                            aria-label="Cerrar evidencia"
                            @onclick="CloseEvidencePreview">
                        <span class="oi oi-x" aria-hidden="true"></span>
                    </button>
                </div>
                <div class="orden-image-viewer-body">
                    @if (IsEvidencePreviewLoading)
                    {
                        <div class="orden-image-viewer-status">Cargando evidencia...</div>
                    }
                    else if (!string.IsNullOrWhiteSpace(EvidencePreviewError))
                    {
                        <div class="alert alert-warning mb-0">@EvidencePreviewError</div>
                    }
                    else if (!string.IsNullOrWhiteSpace(EvidencePreviewImageDataUrl))
                    {
                        <img src="@EvidencePreviewImageDataUrl" alt="@EvidencePreviewTitle" />
                    }
                </div>
            </div>
        </div>
    }
</div>
