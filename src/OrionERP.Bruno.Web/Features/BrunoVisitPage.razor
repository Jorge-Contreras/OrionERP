@page "/visitanos"
@inject IRestaurantPublicCatalogService CatalogService
@inject IPublicWebsiteInstanceContext Website
@inject PublicWebsitePresentationDefinition Presentation

<PageTitle>Visítanos · @Presentation.PublicName</PageTitle>
<section class="page-hero page-hero--visit"><span>@Presentation.LocationName</span><h1>Visítanos</h1><p>Hoy: @TodayHours</p></section>

<section class="visit-grid">
  <article><span>Ubicación</span><h2>@Presentation.LocationName</h2><p>@Presentation.OperatingAddress</p>@if (!string.IsNullOrWhiteSpace(settings?.MapsUrl)) { <a class="button" href="@settings.MapsUrl" target="_blank" rel="noopener">Abrir navegación</a> }<small>Confirma la ubicación y el horario antes de trasladarte.</small></article>
  <article><span>Contacto</span><h2>¿Tienes una pregunta?</h2><p>Escríbenos por WhatsApp durante el horario del restaurante.</p><a class="button button--accent" href="@Presentation.WhatsAppUrl($"Hola, {Presentation.ShortName}.")" target="_blank" rel="noopener">@Presentation.WhatsAppDisplay</a>
    <div class="social-links">@if (!string.IsNullOrWhiteSpace(settings?.FacebookUrl)) { <a href="@settings.FacebookUrl" target="_blank" rel="noopener">Facebook</a> }@if (!string.IsNullOrWhiteSpace(settings?.InstagramUrl)) { <a href="@settings.InstagramUrl" target="_blank" rel="noopener">Instagram</a> }@if (!string.IsNullOrWhiteSpace(settings?.TikTokUrl)) { <a href="@settings.TikTokUrl" target="_blank" rel="noopener">TikTok</a> }</div>
  </article>
  <article class="hours-card"><span>Horario</span><h2>Horario semanal</h2>@foreach (var day in WeekHours) { <p><strong>@day.DayName:</strong> @day.Hours</p> }<small>Los horarios extraordinarios se publicarán en el inicio y nuestras redes oficiales.</small></article>
</section>

@code {
  private RestaurantPublicSiteSettingsDto? settings;
  private string timeZoneId = "UTC";
  private string TodayHours => RestaurantOpeningHours.Today(settings?.OpeningHoursJson, timeZoneId, DateTimeOffset.UtcNow);
  private IReadOnlyList<RestaurantOpeningHoursDay> WeekHours => RestaurantOpeningHours.Week(settings?.OpeningHoursJson);

  protected override async Task OnInitializedAsync()
  {
    var binding = await Website.ResolveRequiredAsync();
    timeZoneId = binding.TimeZoneId;
    settings = await CatalogService.GetSettingsAsync(binding);
  }
}
