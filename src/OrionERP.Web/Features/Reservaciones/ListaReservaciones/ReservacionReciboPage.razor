@page "/reservaciones/recibo/{ReservationId:int}"
@attribute [Authorize(Roles = "Administrador,SatOperator")]

<PageTitle>Recibo de Reservación</PageTitle>

@if (IsLoading)
{
    <p><em>Cargando recibo...</em></p>
}
else if (Detail is null)
{
    <div class="alert alert-warning">No se encontró la reservación.</div>
}
else
{
    <article class="container py-3">
        <header class="d-flex justify-content-between align-items-start mb-3 border-bottom pb-2">
            <div>
                <h2 class="mb-0">Recibo de Reservación</h2>
                <div class="text-muted">Folio #@Detail.Id</div>
            </div>
            <button class="btn btn-sm btn-outline-secondary d-print-none" @onclick="PrintAsync">Imprimir / Guardar PDF</button>
        </header>

        <section class="row mb-3">
            <div class="col-6"><strong>Cliente:</strong> @Detail.Cliente</div>
            <div class="col-3"><strong>Check-in:</strong> @FormatDate(Detail.CheckIn)</div>
            <div class="col-3"><strong>Check-out:</strong> @FormatDate(Detail.CheckOut)</div>
            <div class="col-3"><strong>Status:</strong> @Detail.Status</div>
            <div class="col-3"><strong>Total:</strong> @Detail.TotalPrice.ToString("C")</div>
            <div class="col-3"><strong>Pagado:</strong> @Detail.Pagado.ToString("C")</div>
            <div class="col-3"><strong>Por pagar:</strong> @Detail.PorPagar.ToString("C")</div>
        </section>

        <section>
            <h5>Pagos relacionados</h5>
            @if (Detail.Pagos.Count == 0)
            {
                <p class="text-muted">Sin pagos registrados.</p>
            }
            else
            {
                <table class="table table-sm table-bordered">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Fecha</th>
                            <th>Concepto</th>
                            <th>Monto</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pago in Detail.Pagos)
                        {
                            <tr>
                                <td>@pago.TransaccionId</td>
                                <td>@pago.Fecha.ToShortDateString()</td>
                                <td>@pago.Concepto</td>
                                <td>@pago.Monto.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>

        @if (!string.IsNullOrWhiteSpace(Detail.Notes))
        {
            <section>
                <h5>Notas</h5>
                <p>@Detail.Notes</p>
            </section>
        }
    </article>
}
