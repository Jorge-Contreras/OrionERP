@using OrionERP.Application.Features.Cfdi.HtmlCFDI

@if (Document is null)
{
    <div class="alert alert-warning">CFDI no disponible.</div>
    return;
}

<div class="cfdi-card card mb-3">
    <div class="card-header">Encabezado Pago 2.0</div>
    <div class="card-body">
        <div class="row mb-2">
            <div class="col-md-4"><strong>Fecha:</strong> @Document.Fecha</div>
            <div class="col-md-4"><strong>Lugar Expedición:</strong> @Document.LugarExpedicion</div>
            <div class="col-md-4"><strong>Moneda:</strong> @Document.Moneda</div>
        </div>
        <div class="row mb-2">
            <div class="col-md-4"><strong>Tipo:</strong> @Document.TipoDeComprobante</div>
            <div class="col-md-4"><strong>SubTotal:</strong> @Document.SubTotal</div>
            <div class="col-md-4"><strong>Total:</strong> @Document.Total</div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="cfdi-card card">
            <div class="card-header">Emisor</div>
            <div class="card-body">
                <div><strong>RFC:</strong> @Document.Emisor?.Rfc</div>
                <div><strong>Nombre:</strong> @Document.Emisor?.Nombre</div>
                <div><strong>Régimen:</strong> @Document.Emisor?.RegimenFiscal</div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="cfdi-card card">
            <div class="card-header">Receptor</div>
            <div class="card-body">
                <div><strong>RFC:</strong> @Document.Receptor?.Rfc</div>
                <div><strong>Nombre:</strong> @Document.Receptor?.Nombre</div>
                <div><strong>Uso CFDI:</strong> @Document.Receptor?.UsoCfdi</div>
                <div><strong>Domicilio:</strong> @Document.Receptor?.DomicilioFiscalReceptor</div>
                <div><strong>Régimen:</strong> @(Document.Receptor?.RegimenFiscal ?? Document.Receptor?.RegimenFiscalReceptor)</div>
            </div>
        </div>
    </div>
</div>

@if (Document.Pago20?.Totales is not null)
{
    <div class="card mt-3 cfdi-card">
        <div class="card-header">Totales de Pagos</div>
        <div class="card-body">
            <div class="row mb-2">
                <div class="col-md-4"><strong>Monto Total Pagos:</strong> @Document.Pago20.Totales.MontoTotalPagos</div>
                <div class="col-md-4"><strong>Base IVA16:</strong> @Document.Pago20.Totales.TotalTrasladosBaseIva16</div>
                <div class="col-md-4"><strong>Impuesto IVA16:</strong> @Document.Pago20.Totales.TotalTrasladosImpuestoIva16</div>
            </div>
        </div>
    </div>
}

@if (Document.Pago20?.Pagos.Count > 0)
{
    int pagoIndex = 1;
    foreach (var pago in Document.Pago20.Pagos)
    {
        <div class="card mt-3 cfdi-card">
            <div class="card-header">Pago @pagoIndex</div>
            <div class="card-body">
                <div class="row mb-2">
                    <div class="col-md-4"><strong>Fecha Pago:</strong> @pago.FechaPago</div>
                    <div class="col-md-4"><strong>Forma Pago:</strong> @pago.FormaDePagoP</div>
                    <div class="col-md-4"><strong>Moneda:</strong> @pago.MonedaP</div>
                </div>
                <div class="row mb-2">
                    <div class="col-md-4"><strong>Tipo Cambio:</strong> @pago.TipoCambioP</div>
                    <div class="col-md-4"><strong>Monto:</strong> @pago.Monto</div>
                </div>

                @if (pago.Documentos.Count > 0)
                {
                    <div class="mt-3">
                        <div class="cfdi-section-title">Documentos Relacionados</div>
                        <table class="table table-striped table-sm cfdi-table">
                            <thead>
                                <tr>
                                    <th>UUID</th>
                                    <th>Serie/Folio</th>
                                    <th>Moneda</th>
                                    <th>Parcialidad</th>
                                    <th>Saldo Ant.</th>
                                    <th>Pagado</th>
                                    <th>Saldo Insoluto</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in pago.Documentos)
                                {
                                    <tr>
                                        <td>@d.IdDocumento</td>
                                        <td>@($"{d.Serie} {d.Folio}".Trim())</td>
                                        <td>@d.MonedaDr</td>
                                        <td>@d.NumParcialidad</td>
                                        <td>@d.ImpSaldoAnt</td>
                                        <td>@d.ImpPagado</td>
                                        <td>@d.ImpSaldoInsoluto</td>
                                    </tr>
                                    @if (d.Traslados.Count > 0)
                                    {
                                        <tr>
                                            <td colspan="7" class="bg-light">
                                                <div class="cfdi-section-title">Traslados DR</div>
                                                @foreach (var t in d.Traslados)
                                                {
                                                    <div>@t.Impuesto (@t.TipoFactor) Base: @t.Base Tasa: @t.TasaOCuota Importe: @t.Importe</div>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (pago.Traslados.Count > 0)
                {
                    <div class="mt-3">
                        <div class="cfdi-section-title">Traslados del Pago</div>
                        @foreach (var t in pago.Traslados)
                        {
                            <div>@t.Impuesto (@t.TipoFactor) Base: @t.Base Tasa: @t.TasaOCuota Importe: @t.Importe</div>
                        }
                    </div>
                }
            </div>
        </div>
        pagoIndex++;
    }
}

@if (Document.Timbre is not null)
{
    <div class="card mt-3 cfdi-card">
        <div class="card-header">Timbre Fiscal Digital</div>
        <div class="card-body">
            <div><strong>UUID:</strong> @Document.Timbre.Uuid</div>
            <div><strong>Fecha Timbrado:</strong> @Document.Timbre.FechaTimbrado</div>
            <div><strong>NoCertificadoSAT:</strong> @Document.Timbre.NoCertificadoSat</div>
            <div><strong>RfcProvCertif:</strong> @Document.Timbre.RfcProvCertif</div>
        </div>
    </div>
}

@code {
    [Parameter]
    public CfdiReadableDocument? Document { get; set; }
}
