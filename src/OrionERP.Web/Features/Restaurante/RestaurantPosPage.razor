  private int? externalProviderId;
  private Guid? selectedShiftId;
  private string? customerName;
  private string? customerPhone;
  private string? memberIdentifier;
  private LoyaltyMemberDto? selectedMember;
  private string? promotionCode;
  private RestaurantPromotionQuoteDto? promotionQuote;
  private string? deliveryAddress;
  private string? deliveryReferences;
  private string? externalReference;
  private string? orderNotes;
  private decimal deliveryCost;
  private decimal commissionAmount;
  private string discountMode = "Amount";
  private decimal discountValue;
  private string? discountReason;
  private bool allowInventoryDeficit;
  private string? supervisorIdentity;
  private string? supervisorPin;
  private decimal cashReceived;
  private decimal cardAmount;
  private decimal transferAmount;
  private decimal tipAmount;
  private string? error;
  private string? drawerWarning;
  private bool isBusy;
  private bool isSubmitting;
  private bool isLookingUpMember;
  private bool isQuotingPromotions;
  private bool isPrinting;
  private bool isOpeningDrawer;
  private bool isDownloadingReadiness;
  private bool lastOrderReceivedCash;
  private string idempotencyKey = Guid.NewGuid().ToString("N");
  private RestaurantOrderResult? lastOrder;
  private RestaurantReceiptPdfDocumentModel? lastReceipt;
  private string CurrentRfc => RfcState.RequireRfc();
  private IEnumerable<RestaurantProductDto> ActiveProducts => catalog?.Sections.FirstOrDefault(section => section.Id == activeSectionId)?.Products ?? [];
  private string ActiveSectionName => catalog?.Sections.FirstOrDefault(section => section.Id == activeSectionId)?.Name ?? "Menú";
  private int CartItemCount => cart.Sum(item => item.Quantity);
  private decimal CartSubtotal => cart.Sum(item => item.UnitPrice * item.Quantity);
  private decimal LineDiscountTotal => cart.Sum(item => Math.Min(Math.Max(0, item.DiscountAmount), item.UnitPrice * item.Quantity));
  private decimal PromotionDiscountTotal => promotionQuote?.PromotionDiscountTotal ?? 0;
  private decimal OrderDiscountAmount => decimal.Round(
    Math.Min(
      Math.Max(
        0,
        discountMode == "Percent"
          ? Math.Max(0, CartSubtotal - PromotionDiscountTotal - LineDiscountTotal) * discountValue / 100m
          : discountValue),
      Math.Max(0, CartSubtotal - PromotionDiscountTotal - LineDiscountTotal)),
    2);
  private decimal DiscountTotal => PromotionDiscountTotal + LineDiscountTotal + OrderDiscountAmount;
  private RestaurantPosTotalsBreakdown PosTotals => RestaurantPosTotalsCalculator.Calculate(
    CartSubtotal,
    DiscountTotal,
    deliveryCost,
    catalog?.Site.TaxRate ?? 0,
    catalog?.Site.PricesIncludeTax ?? true);
  private decimal GrandTotal => PosTotals.Total;
  private RestaurantCashTenderBreakdown PosCash => RestaurantCashTenderCalculator.Calculate(
    GrandTotal,
    cardAmount,
    transferAmount,
    cashReceived,
    tipAmount);
  private decimal ElectronicPaymentExcess => decimal.Round(Math.Max(0, cardAmount + transferAmount - GrandTotal), 2, MidpointRounding.AwayFromZero);
  private bool IsCustomerNameMissing => string.IsNullOrWhiteSpace(customerName);
  private bool RequiresFullPayment => orderType is "Pickup" or "Table";
  private RestaurantCashShiftDto? SelectedShift => openShifts.FirstOrDefault(shift => shift.Id == selectedShiftId);
  private bool CanSubmit => cart.Count > 0
    && !isSubmitting
    && SelectedShift is not null
    && !IsCustomerNameMissing
    && (string.IsNullOrWhiteSpace(promotionCode) || promotionQuote?.CodeAccepted == true)
    && ElectronicPaymentExcess <= 0.01m
    && (!RequiresFullPayment || PosCash.Shortfall <= 0.01m);
  private decimal SelectedProductPrice => selectedProduct is null ? 0 : selectedProduct.Price + selectedProduct.ModifierGroups.SelectMany(group => group.Options).Where(option => selectedModifierIds.Contains(option.Id)).Sum(option => option.PriceDelta);
  private decimal CustomItemTotal => decimal.Round(customItemPrice * customItemQuantity, 2, MidpointRounding.AwayFromZero);
  private bool CanAddCustomItem => !string.IsNullOrWhiteSpace(customItemName)
    && customItemName.Trim().Length <= RestaurantCustomItemRules.MaximumNameLength
    && customItemQuantity > 0
    && customItemPrice > 0;
  private string StorageKey => $"orion.restaurant.cart:{CurrentRfc}:{selectedSiteId}";
  private static string ProductDisplayName(RestaurantProductDto product)
    => string.IsNullOrWhiteSpace(product.VariantName) ? product.Name : $"{product.Name} · {product.VariantName}";
  private static decimal LineNetTotal(CartLine line)
  {
    var gross = line.UnitPrice * line.Quantity;
    return decimal.Round(gross - Math.Min(Math.Max(0, line.DiscountAmount), gross), 2, MidpointRounding.AwayFromZero);
  }

  protected override async Task OnInitializedAsync() { Realtime.EventReceived += OnRealtimeEventAsync; await LoadAsync(); }

  private async Task LoadAsync()
  {
    isBusy = true; error = null;
    try
    {
      sites = (await CatalogService.GetSitesAsync(CurrentRfc)).Where(site => site.IsEnabled).ToList();
      if (sites.Count == 0) { catalog = null; return; }
      if (!sites.Any(site => site.Id == selectedSiteId)) selectedSiteId = sites[0].Id;
      await Realtime.SubscribeAsync(CurrentRfc, selectedSiteId);
      catalog = await CatalogService.GetPosCatalogAsync(CurrentRfc, selectedSiteId, DateTimeOffset.UtcNow);
      if (!catalog.Sections.Any(section => section.Id == activeSectionId)) activeSectionId = catalog.Sections.FirstOrDefault()?.Id ?? 0;
      openShifts = (await CashService.GetShiftsAsync(CurrentRfc, selectedSiteId)).Where(shift => shift.Status == "Open").ToList();
      if (!openShifts.Any(shift => shift.Id == selectedShiftId)) selectedShiftId = openShifts.Count == 1 ? openShifts[0].Id : null;
      await RestoreCartAsync();
      if (!hasInitializedWorkspace)
      {
        isMenuOpen = cart.Count == 0;
        hasInitializedWorkspace = true;
      }
      await RefreshPromotionQuoteAsync();
      images = [];
      foreach (var product in catalog.Sections.SelectMany(section => section.Products).DistinctBy(item => item.Id).Where(item => item.HasImage))
      {
        var image = await CatalogService.GetProductImageAsync(CurrentRfc, product.Id, true);
        if (image.HasValue) images[product.Id] = $"data:{image.Value.ContentType};base64,{Convert.ToBase64String(image.Value.Bytes)}";
      }
    }
    catch (Exception ex) { error = ex.Message; }
    finally { isBusy = false; }
  }

  private async Task ChangeSiteAsync(ChangeEventArgs args)
  {
    if (!int.TryParse(args.Value?.ToString(), out var id)) return;
    selectedSiteId = id;
    cart = [];
    selectedMember = null;
    memberIdentifier = null;
    promotionQuote = null;
    promotionCode = null;
    isMenuOpen = true;
    hasInitializedWorkspace = true;
    await Realtime.SubscribeAsync(CurrentRfc, selectedSiteId);
    await LoadAsync();
  }

  private void ShowOrder() => isMenuOpen = false;
  private void ShowMenu()
  {
    if (catalog is not null && !catalog.Sections.Any(section => section.Id == activeSectionId))
    {
      activeSectionId = catalog.Sections.FirstOrDefault()?.Id ?? 0;
    }
    isMenuOpen = true;
  }
  private void ShowMenuSection(long sectionId)
  {
    activeSectionId = sectionId;
    isMenuOpen = true;
  }

  private async Task DownloadSaleReadinessAsync()
  {
    if (catalog is null || selectedSiteId <= 0 || isDownloadingReadiness) return;
    isDownloadingReadiness = true;
    error = null;
    try
    {
      var report = await SaleReadinessService.AnalyzeAsync(CurrentRfc, selectedSiteId, DateTimeOffset.UtcNow);
      var workbook = SaleReadinessWorkbookService.Create(report);
      var dataUrl = $"data:{workbook.ContentType};base64,{Convert.ToBase64String(workbook.Bytes)}";
      await Js.InvokeVoidAsync("triggerFileDownload", workbook.FileName, dataUrl);
    }
    catch (Exception ex)
    {
      error = $"No se pudo generar el diagnóstico de venta: {ex.Message}";
    }
    finally
    {
      isDownloadingReadiness = false;
    }
  }

  private async Task SelectProduct(RestaurantProductDto product, long menuSectionId)
  {
    selectedProduct = product;
    selectedMenuSection = catalog?.Sections.FirstOrDefault(section => section.Id == menuSectionId);
    selectedModifierIds = [];
    if (product.ModifierGroups.Count == 0) await AddSelectedProductAsync();
  }
  private void CloseProductModal() { selectedProduct = null; selectedMenuSection = null; selectedModifierIds = []; }
  private void OpenCustomItem()
  {
    selectedProduct = null;
    selectedMenuSection = null;
    selectedModifierIds = [];
    customItemName = customItemNotes = null;
    customItemQuantity = 1;
    customItemPrice = 0;
    isCustomItemOpen = true;
    error = null;
  }
  private void CloseCustomItem() => isCustomItemOpen = false;

  private async Task AddCustomItemAsync()
  {
    try
    {
      var request = new RestaurantOrderLineCreateRequest
      {
        IsCustom = true,
        CustomName = customItemName,
        CustomUnitPrice = customItemPrice,
        Quantity = customItemQuantity,
        Notes = customItemNotes
      };
      var custom = RestaurantCustomItemRules.CreateSnapshot(request);
      cart.Add(new CartLine
      {
        Key = $"custom:{Guid.NewGuid():N}",
        IsCustom = true,
        Name = custom.Name,
        Quantity = customItemQuantity,
        UnitPrice = custom.UnitPrice,
        Notes = string.IsNullOrWhiteSpace(customItemNotes) ? null : customItemNotes.Trim()
      });
      isCustomItemOpen = false;
      isMenuOpen = false;
      error = null;
      await PersistCartAsync();
      await RefreshPromotionQuoteAsync();
    }
    catch (Exception ex)
    {
      error = ex.Message;
    }
  }

  private void ToggleModifier(RestaurantModifierGroupDto group, RestaurantModifierOptionDto option, bool selected)
  {
    if (selected)
    {
      var groupOptionIds = group.Options.Select(item => item.Id).ToHashSet();
      if (selectedModifierIds.Count(groupOptionIds.Contains) >= group.MaxSelections) return;
      selectedModifierIds.Add(option.Id);
    }
    else selectedModifierIds.Remove(option.Id);
  }

  private async Task AddSelectedProductAsync()
  {
    if (selectedProduct is null) return;
    foreach (var group in selectedProduct.ModifierGroups)
    {
      var count = group.Options.Count(option => selectedModifierIds.Contains(option.Id));
      if (count < group.MinSelections || count > group.MaxSelections) { error = $"{group.Name}: selecciona entre {group.MinSelections} y {group.MaxSelections}."; return; }
    }
    var options = selectedProduct.ModifierGroups.SelectMany(group => group.Options).Where(option => selectedModifierIds.Contains(option.Id)).ToList();
    var sectionId = selectedMenuSection?.Id;
    var key = $"{selectedProduct.Id}:{sectionId?.ToString() ?? "unassigned"}:{string.Join('-', options.Select(option => option.Id).Order())}";
    var existing = cart.FirstOrDefault(item => item.Key == key);
    if (existing is null) cart.Add(new CartLine { Key = key, ProductId = selectedProduct.Id, MenuSectionId = sectionId, MenuSectionName = selectedMenuSection?.Name, MenuSectionSortOrder = selectedMenuSection?.SortOrder, Name = string.IsNullOrWhiteSpace(selectedProduct.VariantName) ? selectedProduct.Name : $"{selectedProduct.Name} · {selectedProduct.VariantName}", Quantity = 1, UnitPrice = selectedProduct.Price + options.Sum(option => option.PriceDelta), ModifierIds = options.Select(option => option.Id).ToList(), ModifierNames = options.Select(option => option.Name).ToList() });
    else existing.Quantity++;
    CloseProductModal(); isMenuOpen = false; error = null; await PersistCartAsync(); await RefreshPromotionQuoteAsync();
  }

  private async Task ChangeQuantityAsync(CartLine line, int delta)
  {
    line.Quantity += delta;
    if (line.Quantity <= 0) cart.Remove(line);
    if (cart.Count == 0) ShowMenu();
    await PersistCartAsync();
    await RefreshPromotionQuoteAsync();
  }
  private async Task RemoveLineAsync(CartLine line)
  {
    cart.Remove(line);
    if (cart.Count == 0) ShowMenu();
    await PersistCartAsync();
    await RefreshPromotionQuoteAsync();
  }
  private async Task ClearCartAsync() { cart = []; promotionQuote = null; ShowMenu(); await PersistCartAsync(); }
  private async Task OnCartDiscountChangedAsync() { await PersistCartAsync(); await RefreshPromotionQuoteAsync(); }
  private async Task SetOrderTypeAsync(string value) { orderType = value; await RefreshPromotionQuoteAsync(); }
  private void FillCash() { cardAmount = 0; transferAmount = 0; cashReceived = GrandTotal + Math.Max(0, tipAmount); }

  private async Task FindMemberAsync()
  {
    if (string.IsNullOrWhiteSpace(memberIdentifier))
    {
      return;
    }
    isLookingUpMember = true;
    error = null;
    try
    {
      selectedMember = await LoyaltyService.FindMemberAsync(CurrentRfc, memberIdentifier);
      if (selectedMember is null)
      {
        error = "No se encontró una membresía activa y verificada con ese identificador.";
        return;
      }
      if (string.IsNullOrWhiteSpace(customerName))
      {
        customerName = selectedMember.DisplayName;
      }
      await RefreshPromotionQuoteAsync();
    }
    catch (Exception ex)
    {
      selectedMember = null;
      error = ex.Message;
    }
    finally
    {
      isLookingUpMember = false;
    }
  }

  private void ClearMember()
  {
    selectedMember = null;
    memberIdentifier = null;
    _ = RefreshPromotionQuoteAsync();
  }

  private async Task RefreshPromotionQuoteAsync()
  {
    if (catalog is null || cart.Count == 0)
    {
      promotionQuote = null;
      return;
    }
    isQuotingPromotions = true;
    try
    {
      var products = catalog.Sections
        .SelectMany(section => section.Products)
        .DistinctBy(product => product.Id)
        .ToDictionary(product => product.Id);
      promotionQuote = await PromotionService.QuoteAsync(new RestaurantPromotionQuoteRequest
      {
        Rfc = CurrentRfc,
        SiteId = selectedSiteId,
        At = DateTimeOffset.UtcNow,
        Channel = RestaurantSalesChannels.Pos,
        OrderType = orderType,
        MemberId = selectedMember?.Id,
        Code = promotionCode,
        Lines = cart.Select(item => new RestaurantPromotionQuoteLineRequest
        {
          LineKey = item.Key,
          ProductId = item.ProductId,
          MaterialCategoryId = item.ProductId.HasValue && products.TryGetValue(item.ProductId.Value, out var product)
            ? product.MaterialCategoryId
            : null,
          Quantity = item.Quantity,
          UnitPrice = item.UnitPrice,
          ManualDiscountAmount = item.DiscountAmount,
          IsCustom = item.IsCustom
        }).ToList()
      });
    }
    catch (Exception ex)
    {
      promotionQuote = null;
      error = $"No se pudieron calcular las promociones. {ex.Message}";
    }
    finally
    {
      isQuotingPromotions = false;
    }
  }

  private async Task SubmitAsync()
  {
    if (catalog is null || cart.Count == 0) return;
    await RefreshPromotionQuoteAsync();
    if (!string.IsNullOrWhiteSpace(promotionCode) && promotionQuote?.CodeAccepted != true)
    {
      error = promotionQuote?.Message ?? "El código promocional no es válido para esta orden.";
      return;
    }
    if (IsCustomerNameMissing) { error = "El nombre del cliente es obligatorio."; return; }
    var shift = SelectedShift;
    if (shift is null) { error = "Selecciona un turno de caja abierto para registrar la venta."; return; }
    if (ElectronicPaymentExcess > 0.01m) { error = "Los pagos electrónicos no pueden exceder el total de la orden."; return; }
    if (RequiresFullPayment && PosCash.Shortfall > 0.01m) { error = $"Falta cubrir {PosCash.Shortfall:C} para cobrar esta orden."; return; }
    isSubmitting = true; error = null; drawerWarning = null;
    try
    {
      var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      var userName = auth.User.Identity?.Name ?? "restaurante";
      string? supervisorAuthorizedBy = null;
      if (LineDiscountTotal + OrderDiscountAmount > 0 || allowInventoryDeficit)
      {
        if (string.IsNullOrWhiteSpace(supervisorIdentity) || string.IsNullOrWhiteSpace(supervisorPin))
          throw new InvalidOperationException("El descuento o déficit requiere turno, supervisor y PIN.");
        var verification = await QuickPinService.VerifySupervisorPinAsync(new()
        {
          Rfc = CurrentRfc, CashRegisterId = shift.CashRegisterId,
          UserNameOrEmail = supervisorIdentity, Pin = supervisorPin
        });
        if (!verification.Success) throw new InvalidOperationException(verification.Message);
        supervisorAuthorizedBy = verification.UserName;
      }
      var payments = new List<RestaurantPaymentCreateRequest>();
      var shouldOpenCashDrawer = cashReceived > 0.01m;
      if (PosCash.CashAppliedToOrder > 0.01m) payments.Add(new() { PaymentMethod = "Cash", Amount = PosCash.CashAppliedToOrder, TipAmount = tipAmount, IdempotencyKey = $"{idempotencyKey}:cash" });
      if (cardAmount > 0) payments.Add(new() { PaymentMethod = "ExternalCard", Amount = cardAmount, IdempotencyKey = $"{idempotencyKey}:card" });
      if (transferAmount > 0) payments.Add(new() { PaymentMethod = "Transfer", Amount = transferAmount, IdempotencyKey = $"{idempotencyKey}:transfer" });
      var request = new RestaurantOrderCreateRequest
      {
        Rfc = CurrentRfc, SiteId = selectedSiteId, CashRegisterId = shift.CashRegisterId, CashShiftId = shift.Id,
        IdempotencyKey = idempotencyKey, OrderType = orderType, DiningTableId = diningTableId,
        CustomerName = customerName!.Trim(), CustomerPhone = customerPhone, DeliveryAddress = deliveryAddress, DeliveryReferences = deliveryReferences,
        ExternalProviderId = externalProviderId, ExternalReference = externalReference, DeliveryCost = deliveryCost, CommissionAmount = commissionAmount,
        Notes = orderNotes, OrderDiscountAmount = OrderDiscountAmount, DiscountReason = discountReason,
        SupervisorAuthorizedBy = supervisorAuthorizedBy,MemberId=selectedMember?.Id,
        PromotionCode=promotionCode,SalesChannel=RestaurantSalesChannels.Pos,
        AllowInventoryDeficit = allowInventoryDeficit,
        Lines = cart.Select(item => new RestaurantOrderLineCreateRequest
        {
          ProductId = item.ProductId,
          MenuSectionId = item.MenuSectionId is > 0 ? item.MenuSectionId : null,
          IsCustom = item.IsCustom,
          CustomName = item.IsCustom ? item.Name : null,
          CustomUnitPrice = item.IsCustom ? item.UnitPrice : null,
          Quantity = item.Quantity,
          DiscountAmount = item.DiscountAmount,
          Notes = item.Notes,
          ModifierOptionIds = item.ModifierIds.ToList()
        }).ToList(),
        Payments = payments
      };
      lastOrder = await OrderService.CreateOrderAsync(request, userName);
      lastReceipt = BuildReceiptModel(lastOrder);
      lastOrderReceivedCash = shouldOpenCashDrawer;
      if (shouldOpenCashDrawer)
      {
        await OpenCashDrawerAsync();
      }
      cart = []; await PersistCartAsync();
      idempotencyKey = Guid.NewGuid().ToString("N"); cashReceived = cardAmount = transferAmount = tipAmount = 0; customerName = customerPhone = deliveryAddress = deliveryReferences = externalReference = orderNotes = discountReason = supervisorIdentity = supervisorPin = memberIdentifier = promotionCode = null; selectedMember = null; promotionQuote = null; deliveryCost = commissionAmount = discountValue = 0; allowInventoryDeficit = false;
    }
    catch (Exception ex) { error = ex.Message; }
    finally { isSubmitting = false; }
  }

  private async Task PersistCartAsync() { try { await Js.InvokeVoidAsync("localStorage.setItem", StorageKey, JsonSerializer.Serialize(cart)); } catch { } }
  private async Task RestoreCartAsync()
  {
    try
    {
      var json = await Js.InvokeAsync<string?>("localStorage.getItem", StorageKey);
      if (!string.IsNullOrWhiteSpace(json)) cart = JsonSerializer.Deserialize<List<CartLine>>(json) ?? [];
      if (catalog is null) return;
      foreach (var line in cart.Where(line => !line.IsCustom && !line.MenuSectionId.HasValue && line.ProductId.HasValue))
      {
        var productId = line.ProductId.GetValueOrDefault();
        var section = catalog.Sections.FirstOrDefault(section => section.Products.Any(product => product.Id == productId));
        if (section is null) continue;
        line.MenuSectionId = section.Id;
        line.MenuSectionName = section.Name;
        line.MenuSectionSortOrder = section.SortOrder;
        line.Key = $"{line.ProductId}:{section.Id}:{string.Join('-', line.ModifierIds.Order())}";
      }
    }
    catch { cart = []; }
  }

  private RestaurantReceiptPdfDocumentModel BuildReceiptModel(RestaurantOrderResult order)
  {
    if (catalog is null)
    {
      throw new InvalidOperationException("No se pudo recuperar el catálogo usado para el ticket.");
    }

    var sectionByProduct = catalog.Sections
      .SelectMany(section => section.Products.Select(product => new { product.Id, Section = section }))
      .GroupBy(item => item.Id)
      .ToDictionary(group => group.Key, group => group.First().Section);

    var receiptLines = cart.Select(item =>
    {
      RestaurantMenuSectionDto? section = null;
      if (!item.IsCustom && item.ProductId.HasValue)
      {
        sectionByProduct.TryGetValue(item.ProductId.Value, out section);
      }

      return new RestaurantReceiptPdfLineModel
      {
        ProductName = item.Name,
        Quantity = item.Quantity,
        UnitPrice = item.UnitPrice,
        DiscountAmount = item.DiscountAmount,
        Notes = item.Notes,
        Modifiers = item.ModifierNames.ToList(),
        IsCustom = item.IsCustom,
        SectionName = item.MenuSectionName ?? section?.Name,
        SectionSortOrder = item.MenuSectionSortOrder ?? section?.SortOrder ?? int.MaxValue
      };
    }).ToList();

    return new RestaurantReceiptPdfDocumentModel
    {
      SiteName = catalog.Site.Name,
      Folio = order.Folio,
      CustomerName = order.CustomerName ?? customerName?.Trim() ?? string.Empty,
      OrderType = orderType,
      TableName = catalog.Tables.FirstOrDefault(table => table.Id == diningTableId)?.Name,
      CreatedAt = GetReceiptLocalTime(catalog.Site.TimeZoneId),
      OrderNotes = orderNotes,
      Subtotal = CartSubtotal,
      DiscountTotal = DiscountTotal,
      SubtotalBeforeTax = PosTotals.SubtotalBeforeTax,
      Tax = PosTotals.Tax,
      TaxRate = catalog.Site.TaxRate,
      PricesIncludeTax = catalog.Site.PricesIncludeTax,
      Delivery = PosTotals.Delivery,
      Total = order.Total,
      Tip = tipAmount,
      CashReceived = cashReceived,
      CardAmount = cardAmount,
      TransferAmount = transferAmount,
      Change = PosCash.Change,
      BalanceDue = order.BalanceDue,
      Promotions = order.AppliedPromotions,
      MembershipNumber = order.MembershipNumber,
      PointsEarned = order.PointsEarned,
      PointsBalance = order.PointsBalance,
      Lines = receiptLines
    };
  }

  private async Task PrintTicketAsync()
  {
    if (lastOrder is null || lastReceipt is null)
    {
      return;
    }

    isPrinting = true;
    error = null;
    try
    {
      var pdfBytes = ReceiptPdfService.Generate(lastReceipt);
      await Js.InvokeVoidAsync(
        "restaurantUi.printPdf",
        Convert.ToBase64String(pdfBytes),
        $"orden-{lastOrder.Folio:000}.pdf");
    }
    catch (Exception ex)
    {
      error = $"No se pudieron preparar los tickets. {ex.Message}";
    }
    finally
    {
      isPrinting = false;
    }
  }

  private async Task OpenCashDrawerAsync()
  {
    isOpeningDrawer = true;
    drawerWarning = null;
    try
    {
      _ = await Js.InvokeAsync<string>("restaurantUi.openCashDrawer", "TM-T20");
    }
    catch (Exception ex)
    {
      drawerWarning = $"La orden quedó cobrada, pero el cajón no se abrió. {ex.Message}";
    }
    finally
    {
      isOpeningDrawer = false;
    }
  }

  private void StartNewOrder()
  {
    lastOrder = null;
    lastReceipt = null;
    drawerWarning = null;
    lastOrderReceivedCash = false;
    ShowMenu();
  }

  private static DateTimeOffset GetReceiptLocalTime(string timeZoneId)
  {
    try
    {
      return TimeZoneInfo.ConvertTime(DateTimeOffset.UtcNow, TimeZoneInfo.FindSystemTimeZoneById(timeZoneId));
    }
    catch (TimeZoneNotFoundException)
    {
      return DateTimeOffset.Now;
    }
    catch (InvalidTimeZoneException)
    {
      return DateTimeOffset.Now;
    }
  }

  private Task OnRealtimeEventAsync(RestaurantRealtimeEvent eventInfo) => eventInfo.EventType is "InventoryDeficit" or "ProductionCompleted" or "ProductAvailabilityChanged" ? InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); }) : Task.CompletedTask;
  public void Dispose() { Realtime.EventReceived -= OnRealtimeEventAsync; }

  public sealed class CartLine
  {
    public string Key { get; set; } = string.Empty;
    public long? ProductId { get; set; }
    public long? MenuSectionId { get; set; }
    public string? MenuSectionName { get; set; }
    public int? MenuSectionSortOrder { get; set; }
    public bool IsCustom { get; set; }
    public string Name { get; set; } = string.Empty;
    public int Quantity { get; set; }
    public decimal UnitPrice { get; set; }
    public decimal DiscountAmount { get; set; }
    public string? Notes { get; set; }
    public List<long> ModifierIds { get; set; } = [];
    public List<string> ModifierNames { get; set; } = [];
  }
}
