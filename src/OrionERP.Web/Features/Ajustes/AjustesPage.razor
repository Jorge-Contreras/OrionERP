  private sealed class CfdiPolizaCuentaDefaultsEditorModel
  {
    public List<CfdiPolizaCuentaDefaultEditorModel> Cuentas { get; set; } = [];

    public static CfdiPolizaCuentaDefaultsEditorModel CreateEmpty(string? rfc = null)
      => new()
      {
        Cuentas = CfdiPolizaCuentaDefaultRoles.Required
            .Select(role => CfdiPolizaCuentaDefaultEditorModel.CreateEmpty(role, rfc))
            .ToList()
      };

    public static CfdiPolizaCuentaDefaultsEditorModel FromDto(CfdiPolizaCuentaDefaultsDto dto)
    {
      var accountsByKey = dto.Cuentas.ToDictionary(account => account.CuentaClave, StringComparer.OrdinalIgnoreCase);
      return new CfdiPolizaCuentaDefaultsEditorModel
      {
        Cuentas = CfdiPolizaCuentaDefaultRoles.Required
            .Select(role => accountsByKey.TryGetValue(role.CuentaClave, out var account)
                ? CfdiPolizaCuentaDefaultEditorModel.FromDto(role, account, dto.Rfc)
                : CfdiPolizaCuentaDefaultEditorModel.CreateEmpty(role, dto.Rfc))
            .ToList()
      };
    }

    public void ApplySelection(string cuentaClave, CuentaContableSelection? selection)
    {
      var account = FindAccount(cuentaClave);
      if (account is null)
      {
        return;
      }

      account.Selection = selection;
      account.ErrorMessage = null;
    }

    public void ApplyError(string cuentaClave, string? message)
    {
      var account = FindAccount(cuentaClave);
      if (account is not null)
      {
        account.ErrorMessage = message;
      }
    }

    public string? Validate()
    {
      var missing = Cuentas
          .Where(account => account.Selection?.Id is null)
          .Select(account => account.Nombre)
          .ToList();

      return missing.Count == 0
          ? null
          : $"Selecciona todas las cuentas CFDI: {string.Join(", ", missing)}.";
    }

    public CfdiPolizaCuentaDefaultsSaveRequest ToRequest(string? rfc)
      => new()
      {
        Rfc = rfc ?? string.Empty,
        Cuentas = Cuentas
            .Select(account => new CfdiPolizaCuentaDefaultSaveItem
            {
              CuentaClave = account.CuentaClave,
              CuentaContableId = account.Selection?.Id ?? 0
            })
            .ToList()
      };

    private CfdiPolizaCuentaDefaultEditorModel? FindAccount(string cuentaClave)
      => Cuentas.FirstOrDefault(account => string.Equals(account.CuentaClave, cuentaClave, StringComparison.OrdinalIgnoreCase));
  }

