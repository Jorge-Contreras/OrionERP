  private async Task FindMemberAsync()
  {
    if (string.IsNullOrWhiteSpace(memberIdentifier))
    {
      return;
    }
    isLookingUpMember = true;
    error = null;
    try
    {
      selectedMember = await LoyaltyService.FindMemberAsync(CurrentRfc, memberIdentifier);
      if (selectedMember is null)
      {
        error = "No se encontró una membresía activa y verificada con ese identificador.";
        return;
      }
      if (string.IsNullOrWhiteSpace(customerName))
      {
        customerName = selectedMember.DisplayName;
      }
      redemptionPreview = await LoyaltyService.GetRedeemablePreviewAsync(CurrentRfc, selectedMember.Id);
      redemptionPoints = redemptionPreview?.CanRedeem == true
        ? redemptionPreview.MinimumRedeemPoints
        : 0;
      appliedRedemptionPoints = 0;
      await RefreshPromotionQuoteAsync();
    }
    catch (Exception ex)
    {
      selectedMember = null;
      redemptionPreview = null;
      redemptionPoints = appliedRedemptionPoints = 0;
      error = ex.Message;
    }
    finally
    {
      isLookingUpMember = false;
    }
  }

  private void ClearMember()
  {
    selectedMember = null;
    memberIdentifier = null;
    redemptionPreview = null;
    redemptionPoints = appliedRedemptionPoints = 0;
    _ = RefreshPromotionQuoteAsync();
  }

  private async Task RefreshPromotionQuoteAsync(bool preserveRedemption = false)
  {
    if (!preserveRedemption)
    {
      InvalidateRedemption();
    }
    if (catalog is null || cart.Count == 0)
    {
      promotionQuote = null;
      return;
    }
    isQuotingPromotions = true;
    try
    {
      var products = catalog.Sections
        .SelectMany(section => section.Products)
        .DistinctBy(product => product.Id)
        .ToDictionary(product => product.Id);
      promotionQuote = await PromotionService.QuoteAsync(new RestaurantPromotionQuoteRequest
      {
        Rfc = CurrentRfc,
        SiteId = selectedSiteId,
        At = DateTimeOffset.UtcNow,
        Channel = RestaurantSalesChannels.Pos,
        OrderType = orderType,
        MemberId = selectedMember?.Id,
        Code = promotionCode,
        Lines = cart.Select(item => new RestaurantPromotionQuoteLineRequest
        {
          LineKey = item.Key,
          ProductId = item.ProductId,
          MaterialCategoryId = item.ProductId.HasValue && products.TryGetValue(item.ProductId.Value, out var product)
            ? product.MaterialCategoryId
            : null,
          Quantity = item.Quantity,
          UnitPrice = item.UnitPrice,
          ManualDiscountAmount = item.DiscountAmount,
          IsCustom = item.IsCustom
        }).ToList()
      });
    }
    catch (Exception ex)
    {
      promotionQuote = null;
      error = $"No se pudieron calcular las promociones. {ex.Message}";
    }
    finally
    {
      isQuotingPromotions = false;
    }
  }

  private Task SubmitAsync()
    => ExecuteSubmissionAsync(null, allowInventoryDeficit: false, promptForManualDiscount: true);

  private async Task ExecuteSubmissionAsync(
    string? supervisorAuthorizedBy,
    bool allowInventoryDeficit,
    bool promptForManualDiscount)
  {
    if (catalog is null || cart.Count == 0 || isSubmitting) return;
    var orderCompleted = false;
    isSubmitting = true; error = null; drawerWarning = null;
    try
    {
      await RefreshPromotionQuoteAsync(preserveRedemption: true);
      if (!string.IsNullOrWhiteSpace(promotionCode) && promotionQuote?.CodeAccepted != true)
      {
        error = promotionQuote?.Message ?? "El código promocional no es válido para esta orden.";
        return;
      }
      if (!AppliedRedemptionIsValid)
      {
        error = "El canje ya no cabe en la mercancía restante. Revísalo y vuelve a aplicarlo.";
        return;
      }
      if (IsCustomerNameMissing) { error = "El nombre del cliente es obligatorio."; return; }
      var shift = SelectedShift;
      if (shift is null) { error = "Selecciona un turno de caja abierto para registrar la venta."; return; }
      if (ElectronicPaymentExcess > 0.01m) { error = "Los pagos electrónicos no pueden exceder el total de la orden."; return; }
      if (RequiresFullPayment && PosCash.Shortfall > 0.01m) { error = $"Falta cubrir {PosCash.Shortfall:C} para cobrar esta orden."; return; }
      if (HasManualDiscount && (promptForManualDiscount || string.IsNullOrWhiteSpace(supervisorAuthorizedBy)))
      {
        OpenSupervisorOverride(
          SupervisorOverrideKind.Discount,
          $"Se capturaron {(LineDiscountTotal + OrderDiscountAmount):C} en descuentos manuales. Revisa el motivo antes de aprobar el cobro.");
        return;
      }
      if (HasManualDiscount && string.IsNullOrWhiteSpace(discountReason))
      {
        OpenSupervisorOverride(
          SupervisorOverrideKind.Discount,
          "El descuento necesita un motivo claro antes de que el supervisor pueda autorizarlo.");
        return;
      }

      var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      var userName = auth.User.Identity?.Name ?? "restaurante";
      var payments = new List<RestaurantPaymentCreateRequest>();
      var shouldOpenCashDrawer = cashReceived > 0.01m;
      if (PosCash.CashAppliedToOrder > 0.01m || tipAmount > 0.01m) payments.Add(new() { PaymentMethod = "Cash", Amount = PosCash.CashAppliedToOrder, TipAmount = tipAmount, IdempotencyKey = $"{idempotencyKey}:cash" });
      if (cardAmount > 0) payments.Add(new() { PaymentMethod = "ExternalCard", Amount = cardAmount, IdempotencyKey = $"{idempotencyKey}:card" });
      if (transferAmount > 0) payments.Add(new() { PaymentMethod = "Transfer", Amount = transferAmount, IdempotencyKey = $"{idempotencyKey}:transfer" });
      var request = new RestaurantOrderCreateRequest
      {
        Rfc = CurrentRfc, SiteId = selectedSiteId, CashRegisterId = shift.CashRegisterId, CashShiftId = shift.Id,
        IdempotencyKey = idempotencyKey, OrderType = orderType, DiningTableId = diningTableId,
        CustomerName = customerName!.Trim(), CustomerPhone = customerPhone, DeliveryAddress = deliveryAddress, DeliveryReferences = deliveryReferences,
        ExternalProviderId = externalProviderId, ExternalReference = externalReference, DeliveryCost = deliveryCost, CommissionAmount = commissionAmount,
        Notes = orderNotes, OrderDiscountAmount = OrderDiscountAmount, DiscountReason = discountReason,
        SupervisorAuthorizedBy = supervisorAuthorizedBy,MemberId=selectedMember?.Id,PointsToRedeem=appliedRedemptionPoints,
        PromotionCode=promotionCode,SalesChannel=RestaurantSalesChannels.Pos,
        AllowInventoryDeficit = allowInventoryDeficit,
        Lines = cart.Select(item => new RestaurantOrderLineCreateRequest
        {
          ProductId = item.ProductId,
          MenuSectionId = item.MenuSectionId is > 0 ? item.MenuSectionId : null,
          IsCustom = item.IsCustom,
          CustomName = item.IsCustom ? item.Name : null,
          CustomUnitPrice = item.IsCustom ? item.UnitPrice : null,
          Quantity = item.Quantity,
          DiscountAmount = item.DiscountAmount,
          Notes = item.Notes,
          ModifierOptionIds = item.ModifierIds.ToList(),
          ComboSelections = item.ComboComponents.Select(component => new RestaurantComboSelectionCreateRequest
          {
            ComboSlotId = component.SlotId,
            ComboSlotOptionId = component.OptionId,
            ModifierOptionIds = component.ModifierIds.ToList(),
            Notes = component.Notes
          }).ToList()
        }).ToList(),
        Payments = payments
      };
      lastOrder = await OrderService.CreateOrderAsync(request, userName);
      if (lastOrder.WasDuplicate)
      {
        var recoveredReceipt = await OrderService.GetReceiptAsync(CurrentRfc, lastOrder.OrderId);
        lastReceipt = recoveredReceipt is null
          ? null
          : RestaurantReceiptReprintMapper.Create(recoveredReceipt, catalog);
      }
      else
      {
        lastReceipt = BuildReceiptModel(lastOrder);
      }
      lastOrderReceivedCash = shouldOpenCashDrawer && !lastOrder.WasDuplicate;
      if (lastOrderReceivedCash)
      {
        await OpenCashDrawerAsync();
      }
      cart = [];
      idempotencyKey = Guid.NewGuid().ToString("N");
      await PersistCartAsync();
      cashReceived = cardAmount = transferAmount = tipAmount = 0; customerName = customerPhone = deliveryAddress = deliveryReferences = externalReference = orderNotes = discountReason = memberIdentifier = promotionCode = null; selectedMember = null; redemptionPreview = null; redemptionPoints = appliedRedemptionPoints = 0; promotionQuote = null; deliveryCost = commissionAmount = discountValue = 0;
      ResetSupervisorOverride();
      orderCompleted = true;
    }
    catch (RestaurantInventoryOverrideRequiredException ex)
    {
      OpenSupervisorOverride(SupervisorOverrideKind.Inventory, ex.Message);
    }
    catch (Exception ex) { error = ex.Message; }
    finally { isSubmitting = false; }

    // El inventario acaba de moverse. Se recalcula ya cerrado el cobro, no dentro, para no sumarle
    // latencia a la venta.
    if (orderCompleted) await RefreshSaleAlertsAsync();
  }

  private void OpenSupervisorOverride(SupervisorOverrideKind kind, string message)
  {
    supervisorOverrideKind = kind;
    supervisorOverrideMessage = message;
    supervisorOverrideError = null;
    supervisorIdentity = null;
    supervisorPin = null;
    isSupervisorOverrideOpen = true;
  }

  private void CloseSupervisorOverride()
  {
    if (isSupervisorOverrideBusy) return;
    ResetSupervisorOverride();
  }

  private void ResetSupervisorOverride()
  {
    isSupervisorOverrideOpen = false;
    supervisorOverrideKind = SupervisorOverrideKind.None;
    supervisorOverrideMessage = string.Empty;
    supervisorOverrideError = null;
    supervisorIdentity = null;
    supervisorPin = null;
  }

  private async Task AuthorizeSupervisorOverrideAsync()
  {
    if (!CanAuthorizeSupervisorOverride) return;
    var shift = SelectedShift;
    if (shift is null)
    {
      supervisorOverrideError = "Ya no hay un turno de caja abierto. Selecciona o abre un turno antes de autorizar.";
      return;
    }

    isSupervisorOverrideBusy = true;
    supervisorOverrideError = null;
    try
    {
      var verification = await QuickPinService.VerifySupervisorPinAsync(new()
      {
        Rfc = CurrentRfc,
        CashRegisterId = shift.CashRegisterId,
        UserNameOrEmail = supervisorIdentity!,
        Pin = supervisorPin!
      });
      if (!verification.Success || string.IsNullOrWhiteSpace(verification.UserName))
      {
        supervisorOverrideError = verification.Message;
        supervisorPin = null;
        return;
      }

      var allowInventoryDeficit = SupervisorOverrideIsInventory;
      var supervisorAuthorizedBy = verification.UserName;
      ResetSupervisorOverride();
      await ExecuteSubmissionAsync(
        supervisorAuthorizedBy,
        allowInventoryDeficit,
        promptForManualDiscount: false);
    }
    catch (Exception ex)
    {
      supervisorOverrideError = ex.Message;
      supervisorPin = null;
    }
    finally
    {
      isSupervisorOverrideBusy = false;
    }
  }

  private enum SupervisorOverrideKind
  {
    None,
    Discount,
    Inventory
  }

  private async Task PersistCartAsync()
  {
    try
    {
      var draft = new StoredPosDraft { IdempotencyKey = idempotencyKey, Cart = cart };
      await Js.InvokeVoidAsync("localStorage.setItem", StorageKey, JsonSerializer.Serialize(draft));
    }
    catch { }
  }

  private async Task RestoreCartAsync()
  {
    try
    {
      var json = await Js.InvokeAsync<string?>("localStorage.getItem", StorageKey);
      var restoredVersion = 1;
      if (!string.IsNullOrWhiteSpace(json))
      {
        if (json.TrimStart().StartsWith("[", StringComparison.Ordinal))
        {
          cart = JsonSerializer.Deserialize<List<CartLine>>(json) ?? [];
          idempotencyKey = Guid.NewGuid().ToString("N");
          await PersistCartAsync();
        }
        else
        {
          var draft = JsonSerializer.Deserialize<StoredPosDraft>(json);
          restoredVersion = draft?.Version ?? 1;
          cart = draft?.Cart ?? [];
          if (IsValidIdempotencyKey(draft?.IdempotencyKey))
          {
            idempotencyKey = draft!.IdempotencyKey;
          }
          else
          {
            idempotencyKey = Guid.NewGuid().ToString("N");
            await PersistCartAsync();
          }
        }
      }
      if (catalog is null) return;
      foreach (var line in cart.Where(line => !line.IsCustom && line.ProductId.HasValue))
      {
        var productId = line.ProductId.GetValueOrDefault();
        var section = catalog.Sections.FirstOrDefault(item => item.Id == line.MenuSectionId)
          ?? catalog.Sections.FirstOrDefault(item => item.Products.Any(product => product.Id == productId));
        var product = section?.Products.FirstOrDefault(item => item.Id == productId)
          ?? catalog.Sections.SelectMany(item => item.Products).FirstOrDefault(item => item.Id == productId);
        if (section is not null)
        {
          line.MenuSectionId = section.Id;
          line.MenuSectionName = section.Name;
          line.MenuSectionSortOrder = section.SortOrder;
        }
        if(product is null) continue;
        line.ProductKind=product.ProductKind;
        if(line.BaseUnitPrice<=0) line.BaseUnitPrice=product.Price;
        if(line.Modifiers.Count==0&&line.ModifierIds.Count>0) line.Modifiers=CreateModifierDetails(product.ModifierGroups,line.ModifierIds);
        line.Key=BuildCartKey(line);
      }
      if(restoredVersion<2) await PersistCartAsync();
    }
    catch { cart = []; }
  }

  private static bool IsValidIdempotencyKey(string? value)
    => value is not null && Guid.TryParseExact(value, "N", out _);

  private static IReadOnlyList<RestaurantOrderLineModifierDto> ToReceiptModifiers(IEnumerable<CartModifierDetail> modifiers)
    => modifiers.SelectMany(item=>RestaurantComboOrderRules.ExpandModifierSnapshot(new RestaurantModifierSnapshotInput(
      item.OptionId,
      item.GroupName,
      item.OptionName,
      item.PriceDelta,
      item.Effects.Select(effect=>new RestaurantModifierEffectSnapshotInput(effect.MaterialName,effect.EffectKind)).ToList(),
      item.Quantity)))
      .ToList();

  private RestaurantReceiptPdfDocumentModel BuildReceiptModel(RestaurantOrderResult order)
  {
    if (catalog is null)
    {
      throw new InvalidOperationException("No se pudo recuperar el catálogo usado para el ticket.");
    }

    var sectionByProduct = catalog.Sections
      .SelectMany(section => section.Products.Select(product => new { product.Id, Section = section }))
      .GroupBy(item => item.Id)
      .ToDictionary(group => group.Key, group => group.First().Section);

    var receiptLines = cart.SelectMany(item =>
    {
      RestaurantMenuSectionDto? section = null;
      if (!item.IsCustom && item.ProductId.HasValue)
      {
        sectionByProduct.TryGetValue(item.ProductId.Value, out section);
      }

      var parent = new RestaurantReceiptPdfLineModel
      {
        ProductName = item.Name,
        Quantity = item.Quantity,
        UnitPrice = item.UnitPrice,
        BaseUnitPrice = item.BaseUnitPrice > 0 ? item.BaseUnitPrice : item.UnitPrice,
        ChoicePriceDelta = Math.Max(0, item.UnitPrice - (item.BaseUnitPrice > 0 ? item.BaseUnitPrice : item.UnitPrice)),
        DiscountAmount = item.DiscountAmount,
        Notes = item.Notes,
        Modifiers = item.ModifierNames.ToList(),
        StructuredModifiers = ToReceiptModifiers(item.Modifiers),
        IsCustom = item.IsCustom,
        LineKind = item.ProductKind == RestaurantProductKinds.Combo ? RestaurantOrderLineKinds.Combo : RestaurantOrderLineKinds.Standard,
        SectionName = item.MenuSectionName ?? section?.Name,
        SectionSortOrder = item.MenuSectionSortOrder ?? section?.SortOrder ?? int.MaxValue
      };
      if(item.ComboComponents.Count==0) return new[]{parent};
      var children=item.ComboComponents.Select(component=>new RestaurantReceiptPdfLineModel
      {
        ProductName=component.ProductName,
        Quantity=component.Quantity*item.Quantity,
        UnitPrice=0,
        BaseUnitPrice=0,
        ChoicePriceDelta=RestaurantComboPricingRules.CalculateUnitSupplement(
          [new RestaurantComboPriceSelection(
            component.PriceDelta,
            component.Quantity,
            component.Modifiers.Select(modifier=>modifier.PriceDelta).ToArray())]),
        DiscountAmount=0,
        Notes=component.Notes,
        Modifiers=component.ModifierNames.ToList(),
        StructuredModifiers=ToReceiptModifiers(component.Modifiers),
        LineKind=RestaurantOrderLineKinds.ComboComponent,
        ParentProductName=item.Name,
        ComboSlotName=component.SlotName,
        SectionName=component.MenuSectionName,
        SectionSortOrder=component.MenuSectionSortOrder??int.MaxValue
      });
      return new[]{parent}.Concat(children);
    }).ToList();

    return new RestaurantReceiptPdfDocumentModel
    {
      SiteName = catalog.Site.Name,
      Folio = order.Folio,
      CustomerName = order.CustomerName ?? customerName?.Trim() ?? string.Empty,
      OrderType = orderType,
      TableName = catalog.Tables.FirstOrDefault(table => table.Id == diningTableId)?.Name,
      CreatedAt = GetReceiptLocalTime(catalog.Site.TimeZoneId),
      OrderNotes = orderNotes,
      Subtotal = CartSubtotal,
      DiscountTotal = DiscountTotal,
      SubtotalBeforeTax = PosTotals.SubtotalBeforeTax,
      Tax = PosTotals.Tax,
      TaxRate = catalog.Site.TaxRate,
      PricesIncludeTax = catalog.Site.PricesIncludeTax,
      Delivery = PosTotals.Delivery,
      Total = order.Total,
      Tip = tipAmount,
      CashReceived = cashReceived,
      CardAmount = cardAmount,
      TransferAmount = transferAmount,
      Change = PosCash.Change,
      BalanceDue = order.BalanceDue,
      Promotions = order.AppliedPromotions,
      MembershipNumber = order.MembershipNumber,
      PointsEarned = order.PointsEarned,
      PointsRedeemed = order.PointsRedeemed,
      RedemptionValue = order.RedemptionValue,
      PointsBalance = order.PointsBalance,
      Lines = receiptLines
    };
  }

  private async Task PrintTicketAsync()
  {
    if (lastOrder is null || lastReceipt is null)
    {
      return;
    }

    isPrinting = true;
    error = null;
    try
    {
      var pdfBytes = ReceiptPdfService.Generate(lastReceipt);
      await Js.InvokeVoidAsync(
        "restaurantUi.printPdf",
        Convert.ToBase64String(pdfBytes),
        $"orden-{lastOrder.Folio:000}.pdf");
    }
    catch (Exception ex)
    {
      error = $"No se pudieron preparar los tickets. {ex.Message}";
    }
    finally
    {
      isPrinting = false;
    }
  }

  private async Task PrintTransferDetailsAsync()
  {
    if (catalog is null || !catalog.Site.HasTransferPaymentDetails)
    {
      return;
    }

    isPrintingTransferSlip = true;
    transferSlipWarning = null;
    try
    {
      var slip = RestaurantTransferSlipDocumentModel.FromSite(
        catalog.Site,
        TransferSlipAmount,
        customerName,
        GetReceiptLocalTime(catalog.Site.TimeZoneId),
        lastOrder?.Folio);
      await Js.InvokeVoidAsync(
        "restaurantUi.printPdf",
        Convert.ToBase64String(ReceiptPdfService.GenerateTransferSlip(slip)),
        "datos-transferencia.pdf");
    }
    catch (Exception ex)
    {
      transferSlipWarning = $"No se pudieron imprimir los datos de transferencia. {ex.Message}";
    }
    finally
    {
      isPrintingTransferSlip = false;
    }
  }

  private async Task OpenCashDrawerAsync()
  {
    isOpeningDrawer = true;
    drawerWarning = null;
    try
    {
      _ = await Js.InvokeAsync<string>("restaurantUi.openCashDrawer", "TM-T20")
        .AsTask()
        .WaitAsync(TimeSpan.FromSeconds(5));
    }
    catch (Exception ex)
    {
      drawerWarning = $"La orden quedó cobrada, pero el cajón no se abrió. {ex.Message}";
    }
    finally
    {
      isOpeningDrawer = false;
    }
  }

  private void StartNewOrder()
  {
    lastOrder = null;
    lastReceipt = null;
    drawerWarning = null;
    transferSlipWarning = null;
    lastOrderReceivedCash = false;
    ShowMenu();
  }

  private static DateTimeOffset GetReceiptLocalTime(string timeZoneId)
  {
    try
    {
      return TimeZoneInfo.ConvertTime(DateTimeOffset.UtcNow, TimeZoneInfo.FindSystemTimeZoneById(timeZoneId));
    }
    catch (TimeZoneNotFoundException)
    {
      return DateTimeOffset.Now;
    }
    catch (InvalidTimeZoneException)
    {
      return DateTimeOffset.Now;
    }
  }

  private Task OnRealtimeEventAsync(RestaurantRealtimeEvent eventInfo) => eventInfo.EventType is "InventoryDeficit" or "ProductionCompleted" or "ProductAvailabilityChanged" ? InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); }) : Task.CompletedTask;
  public void Dispose() { Realtime.EventReceived -= OnRealtimeEventAsync; }

