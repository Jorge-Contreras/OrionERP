@page "/contabilidad/transacciones/list"
@attribute [Authorize(Roles = "Administrador,SatOperator")]

<PageTitle>Lista de Transacciones</PageTitle>

<style>
  .transacciones-table-wrapper {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    touch-action: pan-x pan-y;
  }

  .transacciones-table {
    min-width: 920px;
  }

  .transacciones-sort-button {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    font-weight: 600;
    text-align: left;
  }

  .transacciones-sort-button:hover {
    text-decoration: underline;
  }
</style>

<h3>Lista de Transacciones</h3>

<div class="row">
    <div class="col-md-3">
        <div class="form-group">
            <label for="year">Año</label>
            <select id="year" class="form-control" @bind="Filter.Year" @bind:after="OnFilterSelectionChanged">
                <option value="">Todos</option>
                @for (var year = 2035; year >= 2000; year--)
                {
                    <option value="@year">@year</option>
                }
            </select>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group">
            <label for="month">Mes</label>
            <select id="month" class="form-control" @bind="Filter.Month" @bind:after="OnFilterSelectionChanged">
                <option value="">Todos</option>
                <option value="1">Enero</option>
                <option value="2">Febrero</option>
                <option value="3">Marzo</option>
                <option value="4">Abril</option>
                <option value="5">Mayo</option>
                <option value="6">Junio</option>
                <option value="7">Julio</option>
                <option value="8">Agosto</option>
                <option value="9">Septiembre</option>
                <option value="10">Octubre</option>
                <option value="11">Noviembre</option>
                <option value="12">Diciembre</option>
            </select>
        </div>
    </div>
</div>

<div class="row mt-3">
    <div class="col-12 d-flex flex-wrap gap-2 justify-content-md-end">
        <button class="btn btn-primary" @onclick="Search" disabled="@IsLoading">Buscar</button>
        <button class="btn btn-secondary" @onclick="ClearFilters" disabled="@IsLoading">Limpiar</button>
        <a href="/contabilidad/transacciones/new" class="btn btn-success">Nueva Transacción</a>
    </div>
</div>

@if (IsLoading)
{
    <p><em>Cargando...</em></p>
}
else
{
    <div class="transacciones-table-wrapper mt-4">
        <table class="table table-striped transacciones-table mb-0">
            <thead>
                <tr>
                    <th>
                        <button type="button" class="transacciones-sort-button" @onclick='() => Sort("Id")'>
                            ID
                        </button>
                        @if (Filter.SortBy == "Id")
                        {
                            <span>@(Filter.SortAsc ? "▲" : "▼")</span>
                        }
                        <input type="number" class="form-control" @bind-value="Filter.Id" @bind-value:event="oninput" @onkeyup="OnFilterKeyDown" />
                    </th>
                    <th>
                        <button type="button" class="transacciones-sort-button" @onclick='() => Sort("Fecha")'>
                            Fecha
                        </button>
                        @if (Filter.SortBy == "Fecha")
                        {
                            <span>@(Filter.SortAsc ? "▲" : "▼")</span>
                        }
                    </th>
                    <th>
                        <button type="button" class="transacciones-sort-button" @onclick='() => Sort("Concepto")'>
                            Concepto
                        </button>
                        @if (Filter.SortBy == "Concepto")
                        {
                            <span>@(Filter.SortAsc ? "▲" : "▼")</span>
                        }
                        <input type="text" class="form-control" @bind-value="Filter.Concepto" @bind-value:event="oninput" @onkeyup="OnFilterKeyDown" />
                    </th>
                    <th>
                        <button type="button" class="transacciones-sort-button" @onclick='() => Sort("Monto")'>
                            Monto
                        </button>
                        @if (Filter.SortBy == "Monto")
                        {
                            <span>@(Filter.SortAsc ? "▲" : "▼")</span>
                        }
                        <input type="number" class="form-control" @bind-value="Filter.Monto" @bind-value:event="oninput" @onkeyup="OnFilterKeyDown" />
                    </th>
                    <th>
                        <button type="button" class="transacciones-sort-button" @onclick='() => Sort("TipoPoliza")'>
                            Tipo de Póliza
                        </button>
                        @if (Filter.SortBy == "TipoPoliza")
                        {
                            <span>@(Filter.SortAsc ? "▲" : "▼")</span>
                        }
                        <input type="text" class="form-control" @bind-value="Filter.TipoPoliza" @bind-value:event="oninput" @onkeyup="OnFilterKeyDown" />
                    </th>
                    <th>
                        <button type="button" class="transacciones-sort-button" @onclick='() => Sort("FormaPago")'>
                            Forma de Pago
                        </button>
                        @if (Filter.SortBy == "FormaPago")
                        {
                            <span>@(Filter.SortAsc ? "▲" : "▼")</span>
                        }
                        <input type="text" class="form-control" @bind-value="Filter.FormaPago" @bind-value:event="oninput" @onkeyup="OnFilterKeyDown" />
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var transaccion in Transacciones)
                {
                    <tr>
                        <td>@transaccion.Id</td>
                        <td>@transaccion.Fecha.ToShortDateString()</td>
                        <td>@transaccion.Concepto</td>
                        <td>@transaccion.Monto</td>
                        <td>@transaccion.TipoPoliza</td>
                        <td>@transaccion.FormaPago</td>
                        <td>
                            <a href="/contabilidad/transacciones/@transaccion.Id" class="btn btn-sm btn-primary">Ver/Editar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
