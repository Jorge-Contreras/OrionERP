@page "/servicios"
@using System.Globalization
@inject PublicWebsitePresentationDefinition Presentation
@inject HospitalityWebsiteDefinition Hospitality
@inject IBonhomiaScopedPublicDataReader HospitalityData

<PageTitle>Servicios | @Presentation.PublicName</PageTitle>
<HeadContent>
    <meta name="description" content="@($"Servicios, amenidades y extras de {Presentation.PublicName} para trabajo, familia, conferencias y estancias en {Presentation.LocationName}.")" />
</HeadContent>

<main class="bonhomia-page">
    <section class="bonhomia-page__title">
        <p class="bonhomia-eyebrow">Servicios y amenidades</p>
        <h1>Todo lo necesario para instalarte sin friccion</h1>
        <p>@Presentation.ShortName combina espacios amueblados con extras claros para que el viaje de trabajo, familia o agenda profesional sea mas sencillo de organizar.</p>
    </section>

    <section class="bonhomia-section">
        <div class="bonhomia-grid">
            @foreach (var service in Hospitality.Services)
            {
                <article class="bonhomia-card">
                    <i class="@service.Icon" aria-hidden="true"></i>
                    <h3>@service.Title</h3>
                    <p>@service.Text</p>
                </article>
            }
        </div>
    </section>

    <section class="bonhomia-section" aria-labelledby="bonhomia-extras-title">
        <div class="bonhomia-section__header">
            <p class="bonhomia-eyebrow">Extras</p>
            <h2 id="bonhomia-extras-title">Opciones que se ajustan a tu estancia</h2>
            <p>Los extras estan sujetos a disponibilidad y se confirman durante el proceso de reserva o por contacto directo.</p>
        </div>
        <div class="bonhomia-grid bonhomia-grid--three">
            @if (IsLoadingExtras)
            {
                <p role="status">Consultando extras disponibles...</p>
            }
            else if (!string.IsNullOrWhiteSpace(ExtrasError))
            {
                <p role="alert">@ExtrasError</p>
            }
            else
            {
                @foreach (var extra in Extras)
                {
                    <article class="bonhomia-card">
                        <span class="bonhomia-card__meta">@FormatPrice(extra.UnitPrice)</span>
                        <h3>@extra.Name</h3>
                        <p>@extra.Detail</p>
                    </article>
                }
            }
        </div>
    </section>

    <section class="bonhomia-section bonhomia-section--last">
        <div class="bonhomia-band bonhomia-split">
            <div>
                <p class="bonhomia-eyebrow">Listo para elegir fechas</p>
                <h2>Reserva cuando ya tengas claro lo que necesitas</h2>
                <p>La pagina de reserva te lleva por fechas, suite, extras, cotizacion y pago.</p>
            </div>
            <div class="bonhomia-actions">
                <a class="bonhomia-button bonhomia-button--primary" href="/reservar">Ir a reservar</a>
                <a class="bonhomia-button bonhomia-button--secondary" href="/suites">Comparar suites</a>
            </div>
        </div>
    </section>
</main>

@code {
    private IReadOnlyList<BonhomiaExtraOptionDto> Extras { get; set; } = [];
    private bool IsLoadingExtras { get; set; } = true;
    private string? ExtrasError { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Extras = await HospitalityData.GetExtraOptionsAsync();
        }
        catch
        {
            ExtrasError = "Los extras no estan disponibles temporalmente. Puedes confirmar opciones y precios por contacto directo.";
        }
        finally
        {
            IsLoadingExtras = false;
        }
    }

    private string FormatPrice(decimal value)
      => $"{value.ToString("C0", CultureInfo.GetCultureInfo(Presentation.Locale))} MXN";
}
