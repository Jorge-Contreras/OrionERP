@page "/restaurante/promociones"
@attribute [Authorize(Policy = "RestaurantAdmin")]
@using System.Text
@using OrionERP.Application.Features.Logistica.Shared
@using OrionERP.Application.Features.Restaurante
@inject IRestaurantPromotionService PromotionService
@inject IRestaurantCatalogService CatalogService
@inject IRestaurantLoyaltyService LoyaltyService
@inject ICurrentCompanyContext RfcState
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Restaurante · Promociones y membresías</PageTitle>

<main class="promo-admin">
  <header class="promo-admin__hero">
    <div>
      <span>Venta y fidelidad</span>
      <h1>Promociones y membresías</h1>
      <p>Reglas autoritativas, códigos, condiciones públicas, métricas y ajustes auditados.</p>
    </div>
    <button type="button" class="btn btn-light" @onclick="LoadAsync" disabled="@isBusy">Actualizar</button>
  </header>

  @if (!string.IsNullOrWhiteSpace(message))
  {
    <div class="alert @(isError ? "alert-danger" : "alert-success")" role="status">@message</div>
  }

  <nav class="promo-admin__tabs" aria-label="Secciones">
    <button type="button" class="@(tab == "rules" ? "is-active" : null)" @onclick='() => tab = "rules"'>Promociones</button>
    <button type="button" class="@(tab == "reports" ? "is-active" : null)" @onclick='() => tab = "reports"'>Reportes</button>
    <button type="button" class="@(tab == "members" ? "is-active" : null)" @onclick='() => tab = "members"'>Membresías</button>
  </nav>

  @if (tab == "rules")
  {
    <section class="promo-admin__workspace">
      <aside class="promo-admin__list panel">
        <header>
          <div><span>@promotions.Count reglas</span><h2>Promociones</h2></div>
          <button type="button" @onclick="NewPromotion">Nueva</button>
        </header>
        @foreach (var promotion in promotions)
        {
          <button type="button" class="promo-row @(editor.Id == promotion.Id ? "is-selected" : null)" @onclick="() => EditPromotion(promotion)">
            <span>
              <strong>@promotion.Name</strong>
              <small>@RuleLabel(promotion.RuleType) · prioridad @promotion.Priority</small>
            </span>
            <b class="status status--@promotion.Status.ToLowerInvariant()">@StatusLabel(promotion.Status)</b>
          </button>
        }
        @if (promotions.Count == 0)
        {
          <p class="empty">Aplica la migración para cargar las dos promociones iniciales como borradores.</p>
        }
      </aside>

      <EditForm Model="editor" OnValidSubmit="SavePromotionAsync" class="panel promo-editor">
        <DataAnnotationsValidator />
        <header>
          <div><span>Regla comercial</span><h2>@(editor.Id.HasValue ? "Editar promoción" : "Nueva promoción")</h2></div>
          <button type="submit" class="btn btn-primary" disabled="@isBusy">Guardar</button>
        </header>
        <ValidationSummary />

        <div class="field-grid field-grid--3">
          <label>
            <span class="field-caption">Nombre <FieldHelp Title="Nombre" Text="Cómo se llama la promoción. Se ve en el POS al aplicarla, en el ticket del cliente y en el sitio público si publicas condiciones." Example="Ej. Bienvenida al club" /></span>
            <InputText @bind-Value="editor.Name" />
          </label>
          <label>
            <span class="field-caption">Estado <FieldHelp Title="Estado" Text="Borrador no aplica en caja. Programada y Activa sí se evalúan. Pausada la detiene sin borrar su historial y Vencida la archiva." /></span>
            <InputSelect @bind-Value="editor.Status">
              @foreach (var status in Statuses) { <option value="@status">@StatusLabel(status)</option> }
            </InputSelect>
          </label>
          <label>
            <span class="field-caption">Prioridad <FieldHelp Title="Prioridad" Text="Número que desempata cuando dos promociones pueden aplicar a los mismos productos y ahorran lo mismo: gana la del número más alto. El motor siempre prefiere primero la que más le ahorra al cliente." Example="Ej. 90 para la promoción insignia y 10 para las de relleno." Align="end" /></span>
            <InputNumber @bind-Value="editor.Priority" />
          </label>
        </div>
        <div class="field-grid">
          <label>
            <span class="field-caption">Descripción pública <FieldHelp Title="Descripción pública" Text="Una o dos frases para el cliente. Se publica en el sitio del restaurante junto a la promoción." Example="Ej. Dos platillos a elegir por $159." /></span>
            <InputTextArea @bind-Value="editor.PublicDescription" />
          </label>
          <label>
            <span class="field-caption">Condiciones públicas obligatorias <FieldHelp Title="Condiciones públicas" Text="La letra chica: vigencia, días, productos participantes, límites y exclusiones. Debe decir exactamente lo que el POS aplica, porque es lo que el cliente puede reclamar." Align="end" /></span>
            <InputTextArea @bind-Value="editor.PublicTerms" />
          </label>
        </div>
        <div class="field-grid field-grid--3">
          <label>
            <span class="field-caption">Tipo de regla <FieldHelp Title="Tipo de regla" Text="Cómo se calcula el descuento. Compra X paga Y regala las piezas más baratas del grupo; Porcentaje descuenta un % del importe; Descuento fijo resta pesos; Precio de paquete cobra un precio cerrado por N piezas." /></span>
            <InputSelect @bind-Value="editor.RuleType">
              @foreach (var type in RuleTypes) { <option value="@type">@RuleLabel(type)</option> }
            </InputSelect>
          </label>
          <label>
            <span class="field-caption">Sede <FieldHelp Title="Sede" Text="Todas la deja disponible en cualquier sucursal. Si eliges una sede, la promoción solo existe ahí." /></span>
            <InputSelect @bind-Value="editor.SiteId">
              <option value="">Todas</option>
              @foreach (var site in sites) { <option value="@site.Id">@site.Name</option> }
            </InputSelect>
          </label>
          <label>
            <span class="field-caption">Límite global <FieldHelp Title="Límite global de la promoción" Text="Cuántas veces puede canjearse esta promoción en total, sumando todos los clientes y todas las órdenes. Déjalo vacío para que no tenga tope." Example="Ej. 300: al llegar a 300 canjes deja de aplicar aunque siga vigente." Align="end" /></span>
            <InputNumber @bind-Value="editor.GlobalLimit" />
          </label>
        </div>

        @if (editor.RuleType == RestaurantPromotionRuleTypes.BuyXPayY)
        {
          <div class="field-grid">
            <label>
              <span class="field-caption">Compra X <FieldHelp Title="Compra X" Text="Piezas participantes que debe llevar el cliente para armar un grupo. Se cuentan piezas, no pesos." Example="En un 2x1, X = 2. En un 3x2, X = 3." /></span>
              <InputNumber @bind-Value="editor.BuyQuantity" />
            </label>
            <label>
              <span class="field-caption">Paga Y <FieldHelp Title="Paga Y" Text="Piezas de ese grupo que sí se cobran. Las demás se regalan y el motor siempre regala las más baratas del grupo." Example="En un 2x1, Y = 1. En un 3x2, Y = 2." Align="end" /></span>
              <InputNumber @bind-Value="editor.PayQuantity" />
            </label>
          </div>
        }
        else if (editor.RuleType == RestaurantPromotionRuleTypes.PercentOff)
        {
          <label>
            <span class="field-caption">Porcentaje de descuento <FieldHelp Title="Porcentaje de descuento" Text="Porcentaje, no pesos. Se aplica sobre el importe de los productos participantes de la orden." Example="Escribe 15 para 15%." /></span>
            <InputNumber @bind-Value="editor.PercentOff" />
          </label>
        }
        else if (editor.RuleType == RestaurantPromotionRuleTypes.FixedAmountOff)
        {
          <label>
            <span class="field-caption">Importe fijo de descuento <FieldHelp Title="Importe fijo de descuento" Text="Pesos, no porcentaje. Es lo que se resta de la cuenta y nunca descuenta más de lo que suman los productos participantes." Example="Escribe 50 para $50.00 de descuento." /></span>
            <InputNumber @bind-Value="editor.FixedAmount" />
          </label>
        }
        else
        {
          <div class="field-grid">
            <label>
              <span class="field-caption">Unidades del paquete <FieldHelp Title="Unidades del paquete" Text="Cuántas piezas participantes se agrupan para cobrarse al precio de paquete. Si sobran piezas sueltas, esas se cobran a precio de lista." Example="Ej. 2 hamburguesas por paquete." /></span>
              <InputNumber @bind-Value="editor.BuyQuantity" />
            </label>
            <label>
              <span class="field-caption">Precio fijo del paquete <FieldHelp Title="Precio fijo del paquete" Text="Pesos que paga el cliente por el grupo completo, no por pieza. Si el precio de lista ya es menor, la promoción no genera descuento." Example="Ej. 159 = $159.00 por las 2 piezas juntas." Align="end" /></span>
              <InputNumber @bind-Value="editor.BundlePrice" />
            </label>
          </div>
        }

        <div class="field-grid field-grid--3">
          <label>
            <span class="field-caption">Cantidad mínima <FieldHelp Title="Cantidad mínima" Text="Piezas participantes que debe tener la orden para que la promoción aplique. Déjalo en 0 si no pides mínimo." /></span>
            <InputNumber @bind-Value="editor.MinimumQuantity" />
          </label>
          <label>
            <span class="field-caption">Subtotal mínimo <FieldHelp Title="Subtotal mínimo" Text="Pesos de mercancía participante que debe alcanzar la orden antes de descuentos. Déjalo en 0 si no pides consumo mínimo." Example="Ej. 200 = la cuenta debe llegar a $200.00." /></span>
            <InputNumber @bind-Value="editor.MinimumSubtotal" />
          </label>
          <span></span>
          <label>
            <span class="field-caption">Válida desde <FieldHelp Title="Válida desde" Text="Primer día en que la promoción puede aplicar, en hora local de la sede. Vacío = sin fecha de inicio." /></span>
            <InputDate @bind-Value="editor.ValidFromLocal" />
          </label>
          <label>
            <span class="field-caption">Válida hasta <FieldHelp Title="Válida hasta" Text="La promoción deja de aplicar al llegar esta fecha. Vacío = sin fecha de fin." /></span>
            <InputDate @bind-Value="editor.ValidToLocal" />
          </label>
        </div>

        <div class="checks">
          <label><InputCheckbox @bind-Value="editor.PosEnabled" /> POS <FieldHelp Title="POS" Text="La promoción se evalúa al cobrar en caja." /></label>
          <label><InputCheckbox @bind-Value="editor.WebEnabled" /> Web <FieldHelp Title="Web" Text="La promoción se evalúa en los pedidos que entran por el sitio del restaurante." /></label>
          <label><InputCheckbox @bind-Value="editor.MemberOnly" /> Solo miembros <FieldHelp Title="Solo miembros" Text="Exige identificar al socio del programa de membresía antes de cobrar. Sin membresía vinculada, la promoción no aplica." /></label>
          <label><InputCheckbox @bind-Value="editor.CodeRequired" /> Requiere código <FieldHelp Title="Requiere código" Text="La promoción solo aplica si el cajero captura uno de los códigos de abajo. Sin esta casilla se aplica sola en cuanto la orden cumple las condiciones." /></label>
          <label><InputCheckbox @bind-Value="editor.IsCombinable" /> Combinable sobre remanente <FieldHelp Title="Combinable sobre remanente" Text="Permite que se sume a otra promoción y descuente solo sobre el importe que quedó sin descontar. Sin esta casilla no se acumula con otras." Align="end" /></label>
          <label><InputCheckbox @bind-Value="editor.IsPublic" /> Publicar condiciones <FieldHelp Title="Publicar condiciones" Text="Muestra la promoción y su letra chica en el sitio público. Requiere descripción y condiciones completas." Align="end" /></label>
        </div>

        <section class="subpanel">
          <header><div><span>Alcance</span><h3>Productos y categorías elegibles <FieldHelp Title="Productos y categorías elegibles" Text="Si no marcas nada, la promoción aplica a todo el menú. Las partidas capturadas como concepto libre en caja nunca participan." /></h3></div></header>
          <div class="product-picks">
            @foreach (var product in products)
            {
              <label>
                <input type="checkbox" checked="@editor.ProductIds.Contains(product.Id)" @onchange="_ => ToggleProduct(product.Id)" />
                <span><strong>@product.Name</strong><small>@product.Sku · @product.Price.ToString("C")</small></span>
              </label>
            }
          </div>
          <div class="category-picks">
            @foreach (var categoryId in products.Where(product => product.MaterialCategoryId.HasValue).Select(product => product.MaterialCategoryId!.Value).Distinct().Order())
            {
              <label><input type="checkbox" checked="@editor.MaterialCategoryIds.Contains(categoryId)" @onchange="_ => ToggleCategory(categoryId)" /> Categoría logística #@categoryId</label>
            }
          </div>
        </section>

        <section class="subpanel">
          <header><div><span>Horario local de la sede</span><h3>Días y franjas <FieldHelp Title="Días y franjas" Text="Ventanas de día y hora en las que la promoción puede aplicar, en hora local de la sede. Si no agregas ninguna franja, aplica siempre dentro de la vigencia: no queda limitada al horario del negocio." /></h3></div><button type="button" @onclick="AddSchedule">Agregar</button></header>
          @foreach (var schedule in editor.Schedules.Select((value, index) => (value, index)))
          {
            <div class="repeat-row">
              <label>
                <span class="field-caption">Día</span>
                <select value="@schedule.value.DayOfWeek" @onchange="eventArgs => SetScheduleDay(schedule.index, eventArgs)">
                  @foreach (var day in Days) { <option value="@day.Value">@day.Label</option> }
                </select>
              </label>
              <label>
                <span class="field-caption">Desde</span>
                <input type="time" value="@FormatTime(schedule.value.StartsAt)" @onchange="eventArgs => SetScheduleTime(schedule.index, true, eventArgs)" />
              </label>
              <span class="repeat-row__sep">a</span>
              <label>
                <span class="field-caption">Hasta</span>
                <input type="time" value="@FormatTime(schedule.value.EndsAt)" @onchange="eventArgs => SetScheduleTime(schedule.index, false, eventArgs)" />
              </label>
              <button type="button" class="danger-link" @onclick="() => RemoveSchedule(schedule.index)">Quitar</button>
            </div>
          }
          @if (editor.Schedules.Count == 0) { <p class="empty">Sin franjas: aplica cualquier día y hora dentro de la vigencia.</p> }
        </section>

        <section class="subpanel">
          <header><div><span>Canje compartido</span><h3>Códigos promocionales <FieldHelp Title="Códigos promocionales" Text="Códigos que el cajero teclea en el POS para aplicar esta promoción. Sirven para medir campañas y para limitar cuántas veces se canjea. Si no marcas Requiere código, la promoción también aplica sin teclear nada." /></h3></div><button type="button" @onclick="AddCode">Agregar</button></header>
          @foreach (var code in editor.Codes.Select((value, index) => (value, index)))
          {
            <div class="repeat-row repeat-row--code">
              <label>
                <span class="field-caption">Código <FieldHelp Title="Código" Text="Lo que teclea el cajero en la caja. De 3 a 32 caracteres, solo letras, números y guiones. No distingue mayúsculas ni espacios sobrantes." Example="Ej. BIENVENIDA o MARTES-2X1" /></span>
                <InputText @bind-Value="code.value.Code" placeholder="Ej. BIENVENIDA" />
              </label>
              <label>
                <span class="field-caption">Límite global <FieldHelp Title="Límite global del código" Text="Cuántas veces puede canjearse este código entre todos los clientes. Vacío = sin tope. Es independiente del límite global de la promoción." Example="Ej. 300 canjes en total." /></span>
                <InputNumber @bind-Value="code.value.GlobalLimit" placeholder="Sin tope" />
              </label>
              <label>
                <span class="field-caption">Por miembro <FieldHelp Title="Canjes por miembro" Text="Cuántas veces puede usarlo el mismo socio. Requiere identificar la membresía al cobrar, así que la orden sin socio vinculado no lo acepta. Vacío = sin tope." Example="Ej. 1 = beneficio de una sola vez por socio." /></span>
                <InputNumber @bind-Value="code.value.PerMemberLimit" placeholder="Sin tope" />
              </label>
              <label class="check-cell"><InputCheckbox @bind-Value="code.value.IsActive" /> Activo <FieldHelp Title="Activo" Text="Desactívalo para retirar el código de la caja sin borrar su historial de canjes." Align="end" /></label>
              <button type="button" class="danger-link" @onclick="() => RemoveCode(code.index)">Quitar</button>
            </div>
          }
          @if (editor.Codes.Count == 0)
          {
            <p class="empty">Sin códigos: la promoción se aplica sola cuando la orden cumple las condiciones.</p>
          }
          @if (editor.CodeRequired && !editor.Codes.Any(item => item.IsActive))
          {
            <p class="empty empty--warn">Marcaste Requiere código: agrega al menos un código activo o no podrás guardar.</p>
          }
        </section>

        <section class="subpanel preview">
          <header><div><span>Sin afectar ventas</span><h3>Vista previa de ahorro <FieldHelp Title="Vista previa de ahorro" Text="Simula una orden con este producto para ver cuánto ahorraría el cliente con la regla que estás editando. No registra ventas ni consume canjes, y usa la fecha y hora de ahora." /></h3></div><button type="button" @onclick="PreviewPromotion">Calcular</button></header>
          <div class="field-grid field-grid--3">
            <label>
              <span class="field-caption">Producto <FieldHelp Title="Producto de prueba" Text="Producto con el que se arma la orden simulada. Elige uno que participe en la promoción para ver el ahorro." /></span>
              <select @bind="previewProductId">@foreach (var product in products) { <option value="@product.Id">@product.Name</option> }</select>
            </label>
            <label>
              <span class="field-caption">Cantidad <FieldHelp Title="Cantidad de prueba" Text="Piezas de ese producto en la orden simulada. Súbela para comprobar cuándo se completa un 2x1 o un paquete." /></span>
              <input type="number" min="0.01" step="0.01" @bind="previewQuantity" />
            </label>
            <label>
              <span class="field-caption">Código <FieldHelp Title="Código de prueba" Text="Código que teclearía el cajero. Déjalo vacío para simular una orden sin código." Align="end" /></span>
              <input @bind="previewCode" />
            </label>
          </div>
          @if (previewQuote is not null)
          {
            <div class="preview-result">
              <span>Subtotal <strong>@previewQuote.MerchandiseSubtotal.ToString("C")</strong></span>
              <span>Ahorro <strong>@previewQuote.PromotionDiscountTotal.ToString("C")</strong></span>
              <span>Total mercancía <strong>@previewQuote.DiscountedMerchandise.ToString("C")</strong></span>
              <small>@(previewQuote.Message ?? (previewQuote.Adjustments.Count > 0 ? "La regla aplica." : "La regla no aplica con estos datos."))</small>
            </div>
          }
        </section>
      </EditForm>
    </section>
  }
  else if (tab == "reports")
  {
    <section class="panel reports">
      <header>
        <div><span>Auditoría comercial</span><h2>Desempeño de promociones</h2></div>
        <div class="report-actions"><input type="date" @bind="from" /><input type="date" @bind="to" /><button type="button" @onclick="LoadReportsAsync">Aplicar</button><a href="@CsvHref" download="promociones.csv">Exportar CSV</a></div>
      </header>
      <div class="kpis">
        <article><span>Venta bruta</span><strong>@promotionReport.GrossSales.ToString("C")</strong></article>
        <article><span>Descuento</span><strong>@promotionReport.PromotionDiscount.ToString("C")</strong></article>
        <article><span>Venta neta</span><strong>@promotionReport.NetSales.ToString("C")</strong></article>
        <article><span>Órdenes</span><strong>@promotionReport.OrderCount</strong></article>
        <article><span>Miembros activos</span><strong>@loyaltyReport.ActiveMembers</strong></article>
        <article><span>Puntos en circulación</span><strong>@loyaltyReport.OutstandingPoints</strong></article>
        <article><span>Puntos canjeados</span><strong>@loyaltyReport.PointsRedeemed</strong><small>@loyaltyReport.RedeemedValue.ToString("C")</small></article>
        <article><span>Puntos restituidos</span><strong>@loyaltyReport.PointsRestored</strong><small>@loyaltyReport.RestoredValue.ToString("C")</small></article>
      </div>
      <div class="data-table">
        <div class="data-table__head"><span>Promoción / código</span><span>Usos</span><span>Órdenes</span><span>Bruta</span><span>Descuento</span><span>Neta</span></div>
        @foreach (var row in promotionReport.Promotions)
        {
          <div><span><strong>@row.PromotionName</strong><small>@row.Code</small></span><span>@row.RedemptionCount</span><span>@row.OrderCount</span><span>@row.GrossSales.ToString("C")</span><span>@row.DiscountAmount.ToString("C")</span><span>@row.NetSales.ToString("C")</span></div>
        }
      </div>
    </section>
  }
  else
  {
    <section class="member-workspace">
      <article class="panel member-policy">
        <header><div><span>Política del programa</span><h2>Puntos, canje y vigencia</h2></div></header>
        @if (programSettings is null)
        {
          <p class="empty">No hay configuración de fidelidad para este RFC.</p>
        }
        else
        {
          <dl>
            <dt>Acumulación</dt><dd>1 punto por cada @programSettings.PesosPerPoint.ToString("C") de mercancía elegible@(programSettings.IsAccrualEnabled ? "" : " (desactivada)")</dd>
            <dt>Valor del punto</dt><dd>@programSettings.PointValueMxn.ToString("C")</dd>
            <dt>Canje mínimo</dt><dd>@programSettings.MinimumRedeemPoints puntos</dd>
            <dt>Vigencia</dt><dd>@(programSettings.PointsExpire ? $"{programSettings.PointsValidityMonths} meses" : "Sin caducidad")</dd>
            <dt>Pasivo vigente</dt><dd>@loyaltyReport.OutstandingPoints puntos · @loyaltyReport.OutstandingLiability.ToString("C")</dd>
          </dl>
          @if (programSettings.PointsExpire)
          {
            <div class="policy-actions">
              <button type="button" class="btn btn-light" @onclick="() => RunExpirationAsync(false)" disabled="@isExpiring">Simular caducidad</button>
              <button type="button" class="btn btn-primary" @onclick="() => RunExpirationAsync(true)" disabled="@(isExpiring || expirationRun is null || expirationRun.PointsExpired == 0)">Aplicar caducidad</button>
            </div>
            @if (expirationRun is not null)
            {
              <p class="policy-result">
                @if (expirationRun.PointsExpired == 0)
                {
                  <text>No hay puntos con más de @programSettings.PointsValidityMonths meses de antigüedad. Nada por caducar.</text>
                }
                else
                {
                  <text>
                    @(expirationRun.WasApplied ? "Se caducaron" : "Se caducarían")
                    <strong>@expirationRun.PointsExpired puntos</strong> de @expirationRun.MembersAffected socios
                    (corte al @expirationRun.CutoffUtc.ToLocalTime().ToString("d MMM yyyy")).
                  </text>
                }
              </p>
            }
          }
        }
      </article>
      <article class="panel member-search">
        <header><div><span>Búsqueda exacta y protegida</span><h2>Localizar membresía</h2></div></header>
        <label>Correo, teléfono, número o QR <input type="search" @bind="memberIdentifier" @onkeydown="MemberSearchKeyDown" autocomplete="off" /></label>
        <button type="button" @onclick="FindMemberAsync">Buscar</button>
        <p class="empty">No se muestran listados completos de clientes. El POS y este panel solo aceptan búsquedas exactas.</p>
      </article>
      @if (member is not null)
      {
        <article class="panel member-card">
          <header><div><span>@member.MembershipNumber</span><h2>@member.DisplayName</h2></div><strong>@member.PointsBalance puntos</strong></header>
          <dl><dt>Correo</dt><dd>@member.MaskedEmail</dd><dt>Teléfono</dt><dd>@member.MaskedPhone</dd><dt>Estado</dt><dd>@member.Status</dd></dl>
          <div class="field-grid">
            <label>Ajuste de puntos <input type="number" @bind="pointsDelta" /></label>
            <label>Motivo obligatorio <input @bind="adjustmentReason" maxlength="500" /></label>
          </div>
          <button type="button" class="btn btn-primary" @onclick="AdjustPointsAsync" disabled="@(pointsDelta == 0 || string.IsNullOrWhiteSpace(adjustmentReason))">Registrar ajuste auditado</button>
        </article>

      }
    </section>
  }
</main>

@code {
  private static readonly string[] Statuses = [RestaurantPromotionStatuses.Draft, RestaurantPromotionStatuses.Scheduled, RestaurantPromotionStatuses.Active, RestaurantPromotionStatuses.Paused, RestaurantPromotionStatuses.Expired];
  private static readonly string[] RuleTypes = [RestaurantPromotionRuleTypes.BuyXPayY, RestaurantPromotionRuleTypes.PercentOff, RestaurantPromotionRuleTypes.FixedAmountOff, RestaurantPromotionRuleTypes.FixedBundlePrice];
  private static readonly (byte Value, string Label)[] Days = [(0, "Domingo"), (1, "Lunes"), (2, "Martes"), (3, "Miércoles"), (4, "Jueves"), (5, "Viernes"), (6, "Sábado")];
  private List<RestaurantSiteDto> sites = [];
  private List<RestaurantProductDto> products = [];
  private List<RestaurantPromotionDto> promotions = [];
  private RestaurantPromotionSaveRequest editor = new();
  private RestaurantPromotionQuoteDto? previewQuote;
  private RestaurantPromotionReportDto promotionReport = new();
  private LoyaltyProgramReportDto loyaltyReport = new();
  private LoyaltyMemberDto? member;
  private string tab = "rules";
  private bool isBusy;
  private string? message;
  private bool isError;
  private long previewProductId;
  private decimal previewQuantity = 2;
  private string? previewCode;
  private string memberIdentifier = string.Empty;
  private LoyaltyProgramSettingsDto? programSettings;
  private LoyaltyExpirationRunDto? expirationRun;
  private bool isExpiring;
  private int pointsDelta;
  private string adjustmentReason = string.Empty;
  private DateTime from = DateTime.Today.AddDays(-30);
  private DateTime to = DateTime.Today;
  private string CurrentRfc => RfcState.RequireRfc();

  protected override async Task OnInitializedAsync()
  {
    try
    {
      _ = CurrentRfc;
      editor = NewEditor();
    }
    catch (UnauthorizedAccessException)
    {
      Show("Esta página requiere una sesión con una empresa activa. Vuelve a iniciar sesión y selecciona la empresa que deseas administrar.", true);
      return;
    }
    await LoadAsync();
  }

  private async Task LoadAsync()
  {
    isBusy = true;
    try
    {
      sites = (await CatalogService.GetSitesAsync(CurrentRfc)).ToList();
      products = (await CatalogService.GetProductsAsync(CurrentRfc)).Where(item => item.IsActive).ToList();
      promotions = (await PromotionService.GetPromotionsAsync(CurrentRfc)).ToList();
      previewProductId = products.FirstOrDefault()?.Id ?? 0;
      if (editor.SiteId is null) editor.SiteId = sites.FirstOrDefault()?.Id;
      await LoadReportsAsync();
      message = null;
    }
    catch (Exception ex) { Show(ex.Message, true); }
    finally { isBusy = false; }
  }

  private void NewPromotion()
  {
    editor = NewEditor();
    editor.Rfc = CurrentRfc;
    editor.SiteId = sites.FirstOrDefault()?.Id;
    previewQuote = null;
  }

  private void EditPromotion(RestaurantPromotionDto value)
  {
    editor = new RestaurantPromotionSaveRequest
    {
      Rfc = CurrentRfc, Id = value.Id, SiteId = value.SiteId, Name = value.Name,
      PublicDescription = value.PublicDescription, PublicTerms = value.PublicTerms,
      Status = value.Status, RuleType = value.RuleType, Priority = value.Priority,
      ValidFromLocal = value.ValidFromLocal, ValidToLocal = value.ValidToLocal,
      PosEnabled = value.PosEnabled, WebEnabled = value.WebEnabled, MemberOnly = value.MemberOnly,
      CodeRequired = value.CodeRequired, IsCombinable = value.IsCombinable, IsPublic = value.IsPublic,
      BuyQuantity = value.BuyQuantity, PayQuantity = value.PayQuantity, PercentOff = value.PercentOff,
      FixedAmount = value.FixedAmount, BundlePrice = value.BundlePrice, MinimumQuantity = value.MinimumQuantity,
      MinimumSubtotal = value.MinimumSubtotal, GlobalLimit = value.GlobalLimit,
      ProductIds = value.ProductIds.ToList(), MaterialCategoryIds = value.MaterialCategoryIds.ToList(),
      Schedules = value.Schedules.Select(item => new RestaurantPromotionScheduleSaveRequest { DayOfWeek = item.DayOfWeek, StartsAt = item.StartsAt, EndsAt = item.EndsAt }).ToList(),
      Codes = value.Codes.Select(item => new RestaurantPromotionCodeSaveRequest { Code = item.Code, GlobalLimit = item.GlobalLimit, PerMemberLimit = item.PerMemberLimit, IsActive = item.IsActive }).ToList()
    };
    previewQuote = null;
  }

  private async Task SavePromotionAsync()
  {
    isBusy = true;
    try
    {
      editor.Rfc = CurrentRfc;
      var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      var result = await PromotionService.SavePromotionAsync(editor, auth.User.Identity?.Name ?? "promociones");
      Show(result.Message, !result.Success);
      if (result.Success)
      {
        promotions = (await PromotionService.GetPromotionsAsync(CurrentRfc)).ToList();
        var saved = editor.Id.HasValue ? promotions.FirstOrDefault(item => item.Id == editor.Id) : promotions.FirstOrDefault(item => item.Name == editor.Name);
        if (saved is not null) EditPromotion(saved);
      }
    }
    catch (Exception ex) { Show(ex.Message, true); }
    finally { isBusy = false; }
  }

  private void PreviewPromotion()
  {
    var product = products.FirstOrDefault(item => item.Id == previewProductId);
    if (product is null) return;
    var definition = new RestaurantPromotionDefinition
    {
      Id = editor.Id ?? -1, Name = editor.Name, Status = RestaurantPromotionStatuses.Active,
      RuleType = editor.RuleType, Priority = editor.Priority, ValidFromLocal = null, ValidToLocal = null,
      PosEnabled = true, WebEnabled = true, MemberOnly = editor.MemberOnly, CodeRequired = editor.CodeRequired,
      IsCombinable = editor.IsCombinable, BuyQuantity = editor.BuyQuantity, PayQuantity = editor.PayQuantity,
      PercentOff = editor.PercentOff, FixedAmount = editor.FixedAmount, BundlePrice = editor.BundlePrice,
      MinimumQuantity = editor.MinimumQuantity, MinimumSubtotal = editor.MinimumSubtotal,
      ProductIds = editor.ProductIds.ToHashSet(), MaterialCategoryIds = editor.MaterialCategoryIds.ToHashSet(),
      Schedules = [], Codes = editor.Codes.Select(item => new RestaurantPromotionCodeDto { Code = RestaurantPromotionEngine.NormalizeCode(item.Code) ?? string.Empty, GlobalLimit = item.GlobalLimit, PerMemberLimit = item.PerMemberLimit, IsActive = item.IsActive }).ToList()
    };
    previewQuote = RestaurantPromotionEngine.Quote(new RestaurantPromotionQuoteRequest
    {
      Rfc = CurrentRfc, SiteId = editor.SiteId ?? 0, At = DateTimeOffset.Now, Channel = RestaurantSalesChannels.Pos,
      OrderType = "Pickup", MemberId = editor.MemberOnly ? Guid.NewGuid() : null, Code = previewCode,
      Lines = [new() { LineKey = "preview", ProductId = product.Id, MaterialCategoryId = product.MaterialCategoryId, Quantity = previewQuantity, UnitPrice = product.Price }]
    }, [definition], DateTimeOffset.Now);
  }

  private async Task LoadReportsAsync()
  {
    var siteId = editor.SiteId ?? sites.FirstOrDefault()?.Id ?? 0;
    if (siteId == 0) return;
    promotionReport = await PromotionService.GetReportAsync(CurrentRfc, siteId, from, to);
    loyaltyReport = await LoyaltyService.GetReportAsync(CurrentRfc, from, to);
    programSettings = await LoyaltyService.GetProgramSettingsAsync(CurrentRfc);
  }

  private async Task FindMemberAsync()
  {
    try
    {
      member = await LoyaltyService.FindMemberAsync(CurrentRfc, memberIdentifier);
      Show(member is null ? "No se encontró una membresía activa y verificada." : "Membresía localizada.", member is null);
    }
    catch (Exception ex) { Show(ex.Message, true); }
  }

  private async Task AdjustPointsAsync()
  {
    if (member is null) return;
    var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
    var result = await LoyaltyService.AdjustPointsAsync(new LoyaltyAdjustmentRequest { Rfc = CurrentRfc, MemberId = member.Id, PointsDelta = pointsDelta, Reason = adjustmentReason }, auth.User.Identity?.Name ?? "fidelidad");
    Show(result.Message, !result.Success);
    if (result.Success)
    {
      member = await LoyaltyService.FindMemberAsync(CurrentRfc, member.MembershipNumber);
      pointsDelta = 0;
      adjustmentReason = string.Empty;
    }
  }


  private async Task RunExpirationAsync(bool applyChanges)
  {
    isExpiring = true;
    try
    {
      var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      expirationRun = await LoyaltyService.ExpirePointsAsync(
        CurrentRfc, applyChanges, auth.User.Identity?.Name ?? "fidelidad");
      if (applyChanges)
      {
        Show($"Caducidad aplicada: {expirationRun.PointsExpired} puntos de {expirationRun.MembersAffected} socios.", false);
        await LoadReportsAsync();
      }
      else
      {
        Show(expirationRun.PointsExpired == 0
          ? "Simulación: no hay puntos por caducar."
          : $"Simulación: caducarían {expirationRun.PointsExpired} puntos de {expirationRun.MembersAffected} socios.", false);
      }
    }
    catch (Exception ex) { Show(ex.Message, true); }
    finally { isExpiring = false; }
  }

  private async Task MemberSearchKeyDown(KeyboardEventArgs args) { if (args.Key == "Enter") await FindMemberAsync(); }
  private void ToggleProduct(long id) { if (!editor.ProductIds.Remove(id)) editor.ProductIds.Add(id); }
  private void ToggleCategory(int id) { if (!editor.MaterialCategoryIds.Remove(id)) editor.MaterialCategoryIds.Add(id); }
  private void AddSchedule() => editor.Schedules.Add(new() { DayOfWeek = 2, StartsAt = new(10, 0, 0), EndsAt = new(12, 0, 0) });
  private void RemoveSchedule(int index) => editor.Schedules.RemoveAt(index);
  private void AddCode() => editor.Codes.Add(new() { IsActive = true });
  private void RemoveCode(int index) => editor.Codes.RemoveAt(index);
  private void SetScheduleDay(int index, ChangeEventArgs args) { if (byte.TryParse(args.Value?.ToString(), out var value)) editor.Schedules[index].DayOfWeek = value; }
  private void SetScheduleTime(int index, bool starts, ChangeEventArgs args) { if (TimeSpan.TryParse(args.Value?.ToString(), out var value)) { if (starts) editor.Schedules[index].StartsAt = value; else editor.Schedules[index].EndsAt = value; } }
  private static string FormatTime(TimeSpan value) => value.ToString(@"hh\:mm");
  private RestaurantPromotionSaveRequest NewEditor() => new() { Rfc = CurrentRfc, Status = RestaurantPromotionStatuses.Draft, RuleType = RestaurantPromotionRuleTypes.BuyXPayY, BuyQuantity = 2, PayQuantity = 1, PosEnabled = true, IsPublic = true, PublicDescription = "Descripción para clientes.", PublicTerms = "Sujeta a disponibilidad. Consulta vigencia, productos participantes, límites y acumulación antes de publicar." };
  private static string RuleLabel(string value) => value switch { RestaurantPromotionRuleTypes.BuyXPayY => "Compra X, paga Y", RestaurantPromotionRuleTypes.PercentOff => "Porcentaje", RestaurantPromotionRuleTypes.FixedAmountOff => "Descuento fijo", RestaurantPromotionRuleTypes.FixedBundlePrice => "Precio de paquete", _ => value };
  private static string StatusLabel(string value) => value switch { RestaurantPromotionStatuses.Draft => "Borrador", RestaurantPromotionStatuses.Scheduled => "Programada", RestaurantPromotionStatuses.Active => "Activa", RestaurantPromotionStatuses.Paused => "Pausada", RestaurantPromotionStatuses.Expired => "Vencida", _ => value };
  private string CsvHref => $"data:text/csv;charset=utf-8,{Uri.EscapeDataString(BuildCsv())}";
  private string BuildCsv()
  {
    var csv = new StringBuilder("Promocion,Codigo,Usos,Ordenes,Venta bruta,Descuento,Venta neta\r\n");
    foreach (var row in promotionReport.Promotions) csv.AppendLine($"{Csv(row.PromotionName)},{Csv(row.Code)},{row.RedemptionCount},{row.OrderCount},{row.GrossSales:0.00},{row.DiscountAmount:0.00},{row.NetSales:0.00}");
    return csv.ToString();
  }
  private static string Csv(string? value) => $"\"{(value ?? string.Empty).Replace("\"", "\"\"")}\"";
  private void Show(string value, bool error) { message = value; isError = error; }
}
