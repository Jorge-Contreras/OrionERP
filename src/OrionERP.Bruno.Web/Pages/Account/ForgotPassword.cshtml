@page "/cuenta/recuperar"
@model OrionERP.Bruno.Web.Pages.Account.ForgotPasswordModel
@{ ViewData["Title"] = "Recuperar contraseña · Club Bruno"; }
<div class="account-shell"><div class="account-art"></div><section class="account-panel"><span>Club Bruno</span><h1>Recupera tu acceso</h1>
@if (Model.Sent) { <p class="account-success">Si existe una cuenta confirmada con ese correo, enviamos un enlace de recuperación.</p> }
else { <p>Escribe el correo de tu membresía.</p><form method="post" class="account-form"><div asp-validation-summary="ModelOnly"></div><label>Correo <input asp-for="Email" autocomplete="email" /><span asp-validation-for="Email"></span></label><button class="button button--accent" type="submit">Enviar enlace</button></form> }
<div class="account-links"><a href="/cuenta/acceso">Volver a acceso</a></div></section></div><partial name="_ValidationScriptsPartial" />
