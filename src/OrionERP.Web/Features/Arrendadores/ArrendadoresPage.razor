@page "/arrendadores"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Administrador")]

<PageTitle>Arrendadores</PageTitle>

<div class="container-fluid py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h1 class="h3 mb-1">Arrendadores</h1>
            <p class="text-muted mb-0">Estado de cuenta por propiedad, mes calendario y pagos contabilizados.</p>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-primary" @onclick="GenerarAsync" disabled="@(!CanGenerate || IsLoadingReport)">
                @(IsLoadingReport ? "Generando..." : "Generar estado")
            </button>
            <button type="button" class="btn btn-outline-primary" @onclick="AbrirPdfAsync" disabled="@(Report?.Context is null || IsGeneratingPdf)">
                @(IsGeneratingPdf ? "PDF..." : "PDF")
            </button>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-12 col-xl-4">
            <section class="card shadow-sm mb-3">
                <div class="card-body">
                    <div class="d-flex gap-2 align-items-end mb-3">
                        <div class="flex-grow-1">
                            <label class="form-label">Buscar arrendador</label>
                            <input class="form-control" type="search" placeholder="Nombre o razon social" @bind="SearchText" @bind:event="oninput" />
                        </div>
                        <button type="button" class="btn btn-outline-primary" @onclick="BuscarArrendadoresAsync" disabled="@IsLoadingArrendadores">Buscar</button>
                    </div>

                    <div class="table-responsive" style="max-height: 42vh;">
                        <table class="table table-sm table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Arrendador</th>
                                    <th class="text-end">Rooms</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Arrendadores.Count == 0)
                                {
                                    <tr>
                                        <td colspan="2" class="text-center text-muted py-4">No hay arrendadores con propiedades.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var arrendador in Arrendadores)
                                    {
                                        <tr class="@(SelectedArrendadorId == arrendador.Id ? "table-primary" : null)" style="cursor: pointer;" @onclick="() => SeleccionarArrendadorAsync(arrendador.Id)">
                                            <td>
                                                <div class="fw-semibold">@arrendador.RazonSocial</div>
                                                <small class="text-muted">ID @arrendador.Id</small>
                                            </td>
                                            <td class="text-end">@arrendador.RoomCount</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <section class="card shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h2 class="h5 mb-0">Propiedades</h2>
                        @if (IsLoadingRooms)
                        {
                            <span class="text-muted small">Cargando...</span>
                        }
                    </div>

                    @if (!SelectedArrendadorId.HasValue)
                    {
                        <div class="text-muted">Selecciona un arrendador para ver sus propiedades.</div>
                    }
                    else if (Rooms.Count == 0)
                    {
                        <div class="text-muted">Este arrendador no tiene propiedades ligadas.</div>
                    }
                    else
                    {
                        <div class="list-group">
                            @foreach (var room in Rooms)
                            {
                                <button type="button"
                                        class="list-group-item list-group-item-action @(SelectedRoomId == room.RoomId ? "active" : null)"
                                        @onclick="() => SeleccionarRoom(room.RoomId)">
                                    <div class="d-flex justify-content-between gap-2">
                                        <span class="fw-semibold">@room.RoomName</span>
                                        <span>@Money(room.BasePrice ?? 0m)</span>
                                    </div>
                                    <small>@room.RoomType - ID @room.RoomId</small>
                                </button>
                            }
                        </div>
                    }
                </div>
            </section>
        </div>

        <div class="col-12 col-xl-8">
            <section class="card shadow-sm mb-3">
                <div class="card-body">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label">Anio</label>
                            <input class="form-control" type="number" min="2000" max="2100" @bind="SelectedYear" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Mes</label>
                            <select class="form-select" @bind="SelectedMonth">
                                @foreach (var month in MonthOptions)
                                {
                                    <option value="@month.Value">@month.Label</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-5">
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-primary flex-grow-1" @onclick="GenerarAsync" disabled="@(!CanGenerate || IsLoadingReport)">
                                    @(IsLoadingReport ? "Generando..." : "Consultar estado de cuenta")
                                </button>
                                <button type="button" class="btn btn-outline-primary" @onclick="AbrirPdfAsync" disabled="@(Report?.Context is null || IsGeneratingPdf)">
                                    @(IsGeneratingPdf ? "PDF..." : "PDF")
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            @if (Report?.Context is null)
            {
                <section class="card shadow-sm">
                    <div class="card-body text-muted">
                        Selecciona arrendador, propiedad, anio y mes para generar el estado de cuenta.
                    </div>
                </section>
            }
            else
            {
                <section class="card shadow-sm mb-3">
                    <div class="card-body">
                        <div class="d-flex flex-wrap justify-content-between gap-2 mb-3">
                            <div>
                                <h2 class="h5 mb-1">@Report.Context.RoomName - @Report.Context.RazonSocial</h2>
                                <div class="text-muted">@Report.Context.Year-@(Report.Context.Month.ToString("00")) - @Report.Context.RoomType</div>
                            </div>
                            <span class="badge text-bg-success align-self-start">Pagos contabilizados</span>
                        </div>

                        @{
                            var summary = Report.Summary ?? EmptySummary;
                        }

                        <div class="row g-3">
                            <div class="col-6 col-lg">
                                <div class="border rounded p-3 h-100">
                                    <div class="text-muted small">Noches pagadas</div>
                                    <div class="fs-4 fw-semibold">@summary.NochesOcupadas</div>
                                </div>
                            </div>
                            <div class="col-6 col-lg">
                                <div class="border rounded p-3 h-100">
                                    <div class="text-muted small">Cobrado</div>
                                    <div class="fs-5 fw-semibold">@Money(summary.Cobrado)</div>
                                </div>
                            </div>
                            <div class="col-6 col-lg">
                                <div class="border rounded p-3 h-100">
                                    <div class="text-muted small">Arrendador 30%</div>
                                    <div class="fs-5 fw-semibold">@Money(summary.Arrendador30)</div>
                                </div>
                            </div>
                            <div class="col-6 col-lg">
                                <div class="border rounded p-3 h-100">
                                    <div class="text-muted small">ISR 10%</div>
                                    <div class="fs-5 fw-semibold">@Money(summary.Isr10)</div>
                                </div>
                            </div>
                            <div class="col-12 col-lg">
                                <div class="border rounded p-3 h-100 bg-light">
                                    <div class="text-muted small">Pago final</div>
                                    <div class="fs-4 fw-semibold">@Money(summary.PagoFinalArrendador)</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="card shadow-sm mb-3">
                    <div class="card-body">
                        <h2 class="h5 mb-3">Detalle de noches pagadas</h2>
                        <div class="table-responsive">
                            <table class="table table-sm table-striped align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Noche</th>
                                        <th>Huesped / bloqueo</th>
                                        <th class="text-end">Reservacion</th>
                                        <th>Check-in</th>
                                        <th>Check-out</th>
                                        <th class="text-end">Cobrado</th>
                                        <th class="text-end">Pago final</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Report.Details.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="7" class="text-center text-muted py-4">No hay noches pagadas para este periodo.</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var item in Report.Details)
                                        {
                                            <tr>
                                                <td>@Date(item.Noche)</td>
                                                <td>@item.HuespedOBloqueo</td>
                                                <td class="text-end">@item.ReservationId</td>
                                                <td>@Date(item.CheckIn)</td>
                                                <td>@Date(item.CheckOut)</td>
                                                <td class="text-end">@Money(item.CobradoNoche)</td>
                                                <td class="text-end">@Money(item.PagoFinalArrendador)</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>

                <section class="card shadow-sm">
                    <div class="card-body">
                        <h2 class="h5 mb-3">Noches excluidas</h2>
                        <div class="table-responsive">
                            <table class="table table-sm table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Noche</th>
                                        <th>Huesped / bloqueo</th>
                                        <th class="text-end">Reservacion</th>
                                        <th class="text-end">Cobrado</th>
                                        <th>Motivo</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Report.Exclusions.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="5" class="text-center text-muted py-4">No hay exclusiones para este periodo.</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var item in Report.Exclusions)
                                        {
                                            <tr>
                                                <td>@Date(item.Noche)</td>
                                                <td>@item.HuespedOBloqueo</td>
                                                <td class="text-end">@(item.ReservationId?.ToString() ?? "N/A")</td>
                                                <td class="text-end">@Money(item.CobradoNoche)</td>
                                                <td><span class="badge text-bg-warning">@item.MotivoExclusion</span></td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>
            }
        </div>
    </div>
</div>
