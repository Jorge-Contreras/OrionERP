@page "/reservaciones/{ReservationId:int}"
@attribute [Authorize(Roles = "Administrador,SatOperator")]

<PageTitle>Reservación #@ReservationId</PageTitle>

@if (IsLoading)
{
    <div class="reservacion-page-state">
        <div class="spinner-border text-primary" role="status" aria-hidden="true"></div>
        <span>Cargando reservación...</span>
    </div>
}
else if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="alert alert-danger">@ErrorMessage</div>
}
else if (Detail is null)
{
    <div class="alert alert-warning">No se encontró la reservación.</div>
}
else
{
    <CascadingValue Value="this">
        <div class="reservacion-page-shell">
            <ReservacionHeaderActions />

            <div class="reservacion-top-grid">
                <ReservacionDatosPanel />
                <ReservacionTotalsPanel />
            </div>

            <ReservacionCfdiPanel />

            <section class="card reservacion-section reservacion-workbench">
                <div class="reservacion-tabs" role="tablist" aria-label="Secciones de reservación">
                    <button type="button"
                            class="reservacion-tab-button @(ActiveTab == ReservationEditorTab.Suites ? "active" : null)"
                            aria-selected="@(ActiveTab == ReservationEditorTab.Suites)"
                            @onclick="() => SetActiveTab(ReservationEditorTab.Suites)">
                        Suites
                        <span>@Suites.Count</span>
                    </button>
                    <button type="button"
                            class="reservacion-tab-button @(ActiveTab == ReservationEditorTab.Experiences ? "active" : null)"
                            aria-selected="@(ActiveTab == ReservationEditorTab.Experiences)"
                            @onclick="() => SetActiveTab(ReservationEditorTab.Experiences)">
                        Experiencias
                        <span>@Experiences.Count</span>
                    </button>
                    <button type="button"
                            class="reservacion-tab-button @(ActiveTab == ReservationEditorTab.Extras ? "active" : null)"
                            aria-selected="@(ActiveTab == ReservationEditorTab.Extras)"
                            @onclick="() => SetActiveTab(ReservationEditorTab.Extras)">
                        Extras
                        <span>@Extras.Count</span>
                    </button>
                    <button type="button"
                            class="reservacion-tab-button @(ActiveTab == ReservationEditorTab.Pagos ? "active" : null)"
                            aria-selected="@(ActiveTab == ReservationEditorTab.Pagos)"
                            @onclick="() => SetActiveTab(ReservationEditorTab.Pagos)">
                        Pagos
                        <span>@Pagos.Count</span>
                    </button>
                    <button type="button"
                            class="reservacion-tab-button @(ActiveTab == ReservationEditorTab.Archivos ? "active" : null)"
                            aria-selected="@(ActiveTab == ReservationEditorTab.Archivos)"
                            @onclick="() => SetActiveTab(ReservationEditorTab.Archivos)">
                        Archivos
                        <span>@Attachments.Count</span>
                    </button>
                </div>

                <div class="reservacion-tab-content">
                    @switch (ActiveTab)
                    {
                        case ReservationEditorTab.Experiences:
                            <ReservacionExperiencesPanel />
                            break;
                        case ReservationEditorTab.Extras:
                            <ReservacionExtrasPanel />
                            break;
                        case ReservationEditorTab.Pagos:
                            <ReservacionPagosPanel />
                            break;
                        case ReservationEditorTab.Archivos:
                            <ReservacionArchivosPanel />
                            break;
                        default:
                            <ReservacionSuitesPanel />
                            break;
                    }
                </div>
            </section>
        </div>
    </CascadingValue>
}
