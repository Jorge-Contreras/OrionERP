@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.JSInterop
@using OrionERP.Infrastructure.Auth
@inject IRfcContext Rfc
@inject IJSRuntime Js
@inject NavigationManager Navigation
@inject SignInManager<ApplicationUser> SignInManager

<style>
    /* --- Security header layout (scoped) --- */
    .secbar {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        grid-template-areas: "left center right";
        align-items: center;
        gap: .75rem;
        padding: .5rem .75rem;
        /* optional separators—comment out if not needed */
        /* border-bottom: 1px solid rgba(0,0,0,.08); */
    }

    .sec-left {
        grid-area: left;
        justify-self: start;
    }

    .sec-center {
        grid-area: center;
        justify-self: center;
    }

    .sec-right {
        grid-area: right;
        justify-self: end;
    }

    /* keep the picker nicely sized and centered */
    .sec-center > * {
        max-width: 420px;
        width: 100%;
    }

    /* identity name styling */
    .sec-identity {
        font-weight: 600;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 28ch;
    }

    /* button tweaks so it aligns neatly */
    .sec-logout.btn {
        white-space: nowrap;
    }

    /* Responsive: stack picker on its own row on small screens */
   

    .sec-center {
        justify-self: stretch;
    }

    /* Make the security header span the full width of its row */
    .top-row > header.secbar {
        width: 100%;
    }

    /* Neutralize the Bootstrap px-4 padding on this specific top-row */
    .top-row.px-4 {
        padding-left: .75rem !important; /* or 0 if you want it flush */
        padding-right: .75rem !important;
    }

    
</style>

<AuthorizeView>
    <Authorized Context="context">
        <header class="secbar" role="banner">
            <div class="sec-left">
                <span class="sec-identity">@context.User.Identity?.Name</span>
            </div>

            <div class="sec-center">
                <RfcPicker />
            </div>

            <div class="sec-right">
                <button class="btn btn-link btn-sm sec-logout" @onclick="LogoutJs">Cerrar sesión</button>
            </div>
        </header>
    </Authorized>

    <NotAuthorized>
        <a class="btn btn-primary btn-sm" href="/Identity/Account/Login">Iniciar sesión</a>
    </NotAuthorized>
</AuthorizeView>

  @code {
      private const string RfcStorageKey = "orionerp.selectedRfc";

      private async Task LogoutJs()
      {
          await Js.InvokeVoidAsync("eval", "location.href = '/Auth/logout'");
    }

    private async Task Logout()
    {
        await SignInManager.SignOutAsync();
        Rfc.CurrentRfc = null;
        await Js.InvokeVoidAsync("localStorage.removeItem", RfcStorageKey);
        Navigation.NavigateTo("/", forceLoad: true);
    }
}
