@page "/pedido/{TrackingToken}"
@implements IAsyncDisposable
@inject PublicWebsitePresentationDefinition Presentation
@inject IJSRuntime Js

<PageTitle>Estado de tu pedido · @Presentation.PublicName</PageTitle>
<HeadContent><meta name="robots" content="noindex,nofollow" /></HeadContent>

<section class="tracking-page">
  @if (isLoading)
  {
    <div class="tracking-card tracking-card--state" aria-live="polite"><div class="tracking-spinner" aria-hidden="true"></div><h1>Buscando tu pedido…</h1><p>Estamos recuperando la confirmación segura.</p></div>
  }
  else if (status is null)
  {
    <div class="tracking-card tracking-card--state"><span>!</span><h1>No encontramos el pedido</h1><p>@(errorMessage ?? "Revisa que hayas abierto el enlace completo que recibiste al pagar.")</p><a class="button button--accent" href="/menu">Volver al menú</a></div>
  }
  else
  {
    <article class="tracking-card">
      <header class="tracking-hero @HeroClass">
        <img src="@Presentation.LogoPath" alt="" aria-hidden="true" />
        <span>@Eyebrow</span>
        <h1>@Headline</h1>
        <p>@StatusMessage</p>
        @if (status.OrderFolio.HasValue) { <strong>Pedido #@status.OrderFolio</strong> }
      </header>

      <div class="tracking-body">
        <ol class="tracking-steps" aria-label="Avance del pedido">
          <li class="@(PaymentStepComplete ? "is-complete" : "is-current")"><i aria-hidden="true">@(PaymentStepComplete ? "✓" : "1")</i><div><strong>Pago</strong><span>@PaymentStepText</span></div></li>
          <li class="@(OrderStepComplete ? "is-complete" : PaymentStepComplete ? "is-current" : null)"><i aria-hidden="true">@(OrderStepComplete ? "✓" : "2")</i><div><strong>Confirmación</strong><span>@OrderStepText</span></div></li>
          <li class="@(PreparationStepComplete ? "is-complete" : OrderStepComplete ? "is-current" : null)"><i aria-hidden="true">@(PreparationStepComplete ? "✓" : "3")</i><div><strong>Preparación</strong><span>@PreparationStepText</span></div></li>
          <li class="@(ReadyStepComplete ? "is-complete is-current" : null)"><i aria-hidden="true">@(ReadyStepComplete ? "✓" : "4")</i><div><strong>Listo para recoger</strong><span>@ReadyStepText</span></div></li>
        </ol>

        <dl class="tracking-summary">
          <div><dt>Total</dt><dd>@status.Total.ToString("C") @status.Currency</dd></div>
          <div><dt>Pago</dt><dd>@FriendlyPaymentStatus</dd></div>
          @if (!string.IsNullOrWhiteSpace(status.OrderStatus)) { <div><dt>Pedido</dt><dd>@FriendlyOrderStatus</dd></div> }
          <div><dt>Última actualización</dt><dd>@LocalUpdatedAt</dd></div>
        </dl>

        @if (ShouldKeepPolling)
        {
          <p class="tracking-live" role="status"><i></i>Esta página se actualiza automáticamente.</p>
        }
        <div class="tracking-actions">
          @if (NeedsRequote)
          {
            <button class="button button--accent" type="button" @onclick="ReturnToCheckoutAsync">Revisar cambios</button>
          }
          <button class="button" type="button" disabled="@isRefreshing" @onclick="RefreshAsync">@(isRefreshing ? "Actualizando…" : "Actualizar estado")</button>
          <a class="button button--ghost" href="/menu">Volver al menú</a>
        </div>
        <aside class="tracking-help"><strong>¿Necesitas ayuda?</strong><p>No intentes pagar otra vez si esta página indica que recibimos el pago. Escríbenos a <a href="mailto:@Presentation.PublicEmail">@Presentation.PublicEmail</a>. Los pedidos no se cancelan desde el sitio.</p></aside>
      </div>
    </article>
  }
</section>

@code {
  [Parameter] public string TrackingToken { get; set; } = string.Empty;

  private readonly CancellationTokenSource disposeCts = new();
  private RestaurantOnlineCheckoutStatusDto? status;
  private bool isLoading = true;
  private bool isRefreshing;
  private bool started;
  private string? errorMessage;

  private string NormalizedCheckout => status?.CheckoutStatus?.Trim() ?? string.Empty;
  private string NormalizedOrder => status?.OrderStatus?.Trim() ?? string.Empty;
  private bool IsRefundState => NormalizedCheckout is RestaurantOnlineCheckoutStatuses.RefundRequested or RestaurantOnlineCheckoutStatuses.RefundPending or RestaurantOnlineCheckoutStatuses.Refunded;
  private bool IsFailureState => NormalizedCheckout is RestaurantOnlineCheckoutStatuses.PaymentDenied or RestaurantOnlineCheckoutStatuses.Failed or RestaurantOnlineCheckoutStatuses.Expired;
  private bool NeedsRequote => NormalizedCheckout == RestaurantOnlineCheckoutStatuses.RequoteRequired;
  private bool PaymentStepComplete => status is not null && (status.PaymentStatus.Equals(RestaurantPaymentStatuses.Paid, StringComparison.OrdinalIgnoreCase) || NormalizedCheckout is RestaurantOnlineCheckoutStatuses.Captured or RestaurantOnlineCheckoutStatuses.CapturedNeedsOrder or RestaurantOnlineCheckoutStatuses.PosCreated || IsRefundState);
  private bool OrderStepComplete => !string.IsNullOrWhiteSpace(status?.OrderStatus) || NormalizedCheckout == RestaurantOnlineCheckoutStatuses.PosCreated;
  private bool PreparationStepComplete => NormalizedOrder is RestaurantOrderStatuses.Preparing or RestaurantOrderStatuses.Ready or RestaurantOrderStatuses.Dispatched or RestaurantOrderStatuses.Delivered or RestaurantOrderStatuses.Completed;
  private bool ReadyStepComplete => NormalizedOrder is RestaurantOrderStatuses.Ready or RestaurantOrderStatuses.Dispatched or RestaurantOrderStatuses.Delivered or RestaurantOrderStatuses.Completed;
  private bool ShouldKeepPolling => status is not null && !IsFailureState && !NeedsRequote && NormalizedCheckout != RestaurantOnlineCheckoutStatuses.Refunded
    && (NormalizedOrder is not (RestaurantOrderStatuses.Ready or RestaurantOrderStatuses.Dispatched or RestaurantOrderStatuses.Delivered or RestaurantOrderStatuses.Completed or RestaurantOrderStatuses.Cancelled)
      || (NormalizedOrder == RestaurantOrderStatuses.Ready && IsReadyEmailInFlight));
  // The ready email leaves through a durable queue after the kitchen marks the order, and it can
  // fail and retry. Only say it was sent once the queue confirms it; refresh while it is in flight.
  private bool IsReadyEmailSent => string.Equals(status?.ReadyNotificationStatus, "Sent", StringComparison.OrdinalIgnoreCase);
  private bool IsReadyEmailInFlight => status?.ReadyNotificationStatus is { } readyEmail
    && (readyEmail.Equals("Pending", StringComparison.OrdinalIgnoreCase) || readyEmail.Equals("Processing", StringComparison.OrdinalIgnoreCase));

  private string Eyebrow => IsRefundState ? "Reembolso" : NeedsRequote ? "El menú cambió" : ReadyStepComplete ? "Ya puedes venir" : IsFailureState ? "Necesitamos tu atención" : PaymentStepComplete ? "Pedido recibido" : "Confirmando pago";
  private string Headline => IsRefundState
    ? NormalizedCheckout == RestaurantOnlineCheckoutStatuses.Refunded ? "Reembolso enviado" : "Reembolso en proceso"
    : NeedsRequote ? "Revisa de nuevo tu pedido"
    : ReadyStepComplete ? "Tu pedido está listo"
    : IsFailureState ? "No se confirmó el pedido"
    : OrderStepComplete ? "Estamos preparando tu pedido"
    : PaymentStepComplete ? "Pago recibido"
    : "Confirmando tu pago";
  private string StatusMessage => !string.IsNullOrWhiteSpace(status?.Message) ? status.Message
    : IsRefundState ? "El importe se enviará al medio de pago original. El tiempo de acreditación depende de Clip y tu institución financiera."
    : NeedsRequote ? "No hicimos el cobro. Algún precio, promoción o disponibilidad cambió; revisa la nueva cotización para continuar."
    : ReadyStepComplete ? (IsReadyEmailSent ? "Te enviamos un correo. Presenta tu número de pedido al recogerlo en el restaurante." : "Presenta tu número de pedido al recogerlo en el restaurante.")
    : OrderStepComplete ? "Te enviaremos un correo cuando esté listo. No necesitas mantener esta página abierta."
    : PaymentStepComplete ? "Recibimos tu pago y estamos terminando de confirmar el pedido. No vuelvas a pagar."
    : "Todavía estamos confirmando la operación con el banco.";
  private string HeroClass => IsRefundState ? "is-refund" : IsFailureState || NeedsRequote ? "is-error" : ReadyStepComplete ? "is-ready" : "is-progress";
  private string PaymentStepText => PaymentStepComplete ? "Recibido" : IsFailureState ? "No confirmado" : "Confirmando el cobro";
  private string OrderStepText => OrderStepComplete ? "Pedido creado" : PaymentStepComplete ? "En proceso, no vuelvas a pagar" : "Pendiente";
  private string PreparationStepText => PreparationStepComplete ? "En cocina" : OrderStepComplete ? "Se enviará a cocina" : "Pendiente";
  private string ReadyStepText => !ReadyStepComplete ? "Te avisaremos por correo"
    : IsReadyEmailSent ? "Te enviamos un correo"
    : IsReadyEmailInFlight ? "Enviando el aviso por correo"
    : "Presenta tu número de pedido";
  private string FriendlyPaymentStatus => status?.PaymentStatus?.Trim().ToLowerInvariant() switch
  {
    "paid" => "Pagado",
    "pending" => "Pendiente de confirmación",
    "refunded" => "Reembolsado",
    "partiallyrefunded" => "Reembolso parcial",
    _ => status?.PaymentStatus ?? "En validación"
  };
  private string FriendlyOrderStatus => NormalizedOrder switch
  {
    RestaurantOrderStatuses.Sent => "Enviado a cocina",
    RestaurantOrderStatuses.Preparing => "En preparación",
    RestaurantOrderStatuses.Ready => "Listo para recoger",
    RestaurantOrderStatuses.Dispatched => "Entregado",
    RestaurantOrderStatuses.Delivered => "Entregado",
    RestaurantOrderStatuses.Completed => "Completado",
    RestaurantOrderStatuses.Cancelled => "Cancelado",
    _ => status?.OrderStatus ?? "Confirmando"
  };
  private string LocalUpdatedAt => status is null ? string.Empty : status.UpdatedAtUtc.ToLocalTime().ToString("d MMM, HH:mm");

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (!firstRender || started) return;
    started = true;
    await LoadStatusAsync(initial: true);
    _ = PollAsync(disposeCts.Token);
  }

  private async Task RefreshAsync() => await LoadStatusAsync(initial: false);

  private async Task LoadStatusAsync(bool initial)
  {
    if (string.IsNullOrWhiteSpace(TrackingToken) || TrackingToken.Length > 2048)
    {
      errorMessage = "El enlace de seguimiento no es válido.";
      isLoading = false;
      StateHasChanged();
      return;
    }

    isRefreshing = !initial;
    errorMessage = null;
    try
    {
      status = await Js.InvokeAsync<RestaurantOnlineCheckoutStatusDto>("brunoOrdering.getStatus", disposeCts.Token, TrackingToken);
      if (status is not null && (OrderStepComplete || IsFailureState || IsRefundState || NeedsRequote))
        await Js.InvokeVoidAsync("brunoOrdering.clearPendingCheckout");
    }
    catch (OperationCanceledException) when (disposeCts.IsCancellationRequested) { }
    catch (Exception ex)
    {
      if (initial || status is null) errorMessage = FriendlyError(ex);
    }
    finally
    {
      isLoading = false;
      isRefreshing = false;
      if (!disposeCts.IsCancellationRequested) StateHasChanged();
    }
  }

  private async Task PollAsync(CancellationToken ct)
  {
    try
    {
      while (!ct.IsCancellationRequested && ShouldKeepPolling)
      {
        await Task.Delay(TimeSpan.FromSeconds(7), ct);
        await InvokeAsync(() => LoadStatusAsync(initial: false));
      }
    }
    catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
  }

  private async Task ReturnToCheckoutAsync()
  {
    try { await Js.InvokeVoidAsync("brunoOrdering.clearPendingCheckout"); }
    catch { }
    Navigation.NavigateTo("/checkout");
  }

  [Inject] private NavigationManager Navigation { get; set; } = default!;

  private static string FriendlyError(Exception exception)
  {
    var message = exception.Message;
    var marker = "Error: ";
    var index = message.LastIndexOf(marker, StringComparison.OrdinalIgnoreCase);
    if (index >= 0) message = message[(index + marker.Length)..];
    return string.IsNullOrWhiteSpace(message) || message.Length > 400
      ? "No pudimos consultar el pedido en este momento. Inténtalo de nuevo."
      : message;
  }

  public ValueTask DisposeAsync()
  {
    disposeCts.Cancel();
    disposeCts.Dispose();
    return ValueTask.CompletedTask;
  }
}
