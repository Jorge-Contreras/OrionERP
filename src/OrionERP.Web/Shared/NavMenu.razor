@using System.Linq
@using Microsoft.AspNetCore.Components.Authorization
@implements IDisposable
@inject NavigationManager Navigation
@inject IConfiguration Configuration

@{
    var visibleSections = VisibleSections;
    var visibleAdminItems = VisibleAdminItems;
    var quickAccessItems = HasSearch ? Array.Empty<NavEntryDefinition>() : GetQuickAccessItems(visibleSections);
    var visibleItemCount = visibleSections.Sum(section => section.Items.Count) + visibleAdminItems.Count;
}

<div class="navmenu-topbar navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand brand-logo" href="/" @onclick="CloseNavMenuAfterSelection">
            <img src="/Images/OrionERP_Logo.svg" alt="OrionERP logo">
            <span class="brand-logo__tag">Centro de operacion</span>
        </a>

        <button title="Navigation menu"
                class="navbar-toggler"
                type="button"
                aria-label="Toggle navigation"
                aria-controls="primary-nav"
                aria-expanded="@(!collapseNavMenu)"
                @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

@if (!collapseNavMenu)
{
    <button type="button" class="navmenu-backdrop" aria-label="Cerrar navegacion" @onclick="CloseNavMenu"></button>
}

<div id="primary-nav" class="@NavMenuCssClass navmenu-body">
    <nav class="nav-shell" aria-label="Primary">
        <section class="nav-search" aria-label="Buscar navegacion">
            <div class="nav-panel__heading">
                <div>
                    <div class="nav-panel__eyebrow">Buscar</div>
                    <h3>Encuentra una pagina rapido</h3>
                </div>

                <span class="nav-panel__meta">@visibleItemCount</span>
            </div>

            <label class="nav-search__label" for="nav-search-input">Buscar</label>

            <div class="nav-search__control">
                <span class="oi oi-magnifying-glass" aria-hidden="true"></span>
                <input id="nav-search-input"
                       type="search"
                       @bind="searchDraft"
                       @bind:event="oninput"
                       @onkeyup="SubmitSearchOnEnter"
                       placeholder="Módulo, página o tarea · Enter"
                       autocomplete="off" />

                @if (HasSearch)
                {
                    <button type="button" class="nav-search__clear" @onclick="ClearSearch">Limpiar</button>
                }
            </div>

            @if (HasSearch)
            {
                <p class="nav-search__summary">@visibleItemCount resultado@(visibleItemCount == 1 ? string.Empty : "s")</p>
            }
        </section>

        @if (quickAccessItems.Length > 0)
        {
            <section class="nav-panel nav-quick" aria-label="Accesos rapidos">
                <div class="nav-panel__heading">
                    <div>
                        <div class="nav-panel__eyebrow">Accesos rapidos</div>
                        <h3>Lo mas usado</h3>
                    </div>

                    <span class="nav-panel__meta">ERP flow</span>
                </div>

                <div class="nav-quick__grid">
                    @foreach (var item in quickAccessItems)
                    {
                        <NavLink class="nav-quick__item"
                                 href="@item.Href"
                                 Match="@item.Match"
                                 title="@item.Title"
                                 @onclick="CloseNavMenuAfterSelection">
                            <span class="nav-quick__icon">
                                <span class="oi @item.Icon" aria-hidden="true"></span>
                            </span>

                            <span class="nav-quick__body">
                                <span class="nav-quick__label">@item.Label</span>
                                <span class="nav-quick__description">@item.Description</span>
                            </span>
                        </NavLink>
                    }
                </div>
            </section>
        }

        @if (visibleSections.Count == 0 && visibleAdminItems.Count == 0)
        {
            <section class="nav-empty" aria-live="polite">
                <span class="oi oi-magnifying-glass nav-empty__icon" aria-hidden="true"></span>
                <h3>Sin coincidencias</h3>
                <p>Prueba con SAT, polizas, bancos, reservaciones o seguridad.</p>
                <button type="button" class="btn btn-link btn-sm nav-empty__action" @onclick="ClearSearch">Limpiar busqueda</button>
            </section>
        }
        else
        {
            @for (var index = 0; index < visibleSections.Count; index++)
            {
                var module = visibleSections[index];

                <section class="@GetSectionCssClass(module)" style="--cluster-index:@index;">
                    <header class="nav-cluster__header">
                        <div class="nav-cluster__icon">
                            <span class="oi @module.Definition.Icon" aria-hidden="true"></span>
                        </div>

                        <div class="nav-cluster__copy">
                            <div class="nav-cluster__eyebrow">@module.Definition.Kicker</div>
                            <h3>@module.Definition.Title</h3>
                            <p>@module.Definition.Description</p>
                        </div>

                        <span class="nav-cluster__count">@module.Items.Count</span>
                    </header>

                    <ul class="nav-cluster__list">
                        @foreach (var item in module.Items)
                        {
                            <li class="nav-item">
                                <NavLink class="nav-link nav-link--rich"
                                         href="@item.Href"
                                         Match="@item.Match"
                                         title="@item.Title"
                                         @onclick="CloseNavMenuAfterSelection">
                                    <span class="nav-link__icon">
                                        <span class="oi @item.Icon" aria-hidden="true"></span>
                                    </span>

                                    <span class="nav-link__content">
                                        <span class="label">@item.Label</span>
                                        <span class="description">@item.Description</span>
                                    </span>

                                    @if (!string.IsNullOrWhiteSpace(item.Badge))
                                    {
                                        <span class="nav-link__badge">@item.Badge</span>
                                    }
                                </NavLink>
                            </li>
                        }
                    </ul>
                </section>
            }
        }

        @if (visibleAdminItems.Count > 0)
        {
            <AuthorizeView Roles="Administrador">
                <section class="nav-cluster nav-cluster--admin">
                    <header class="nav-cluster__header">
                        <div class="nav-cluster__icon">
                            <span class="oi @AdminSection.Icon" aria-hidden="true"></span>
                        </div>

                        <div class="nav-cluster__copy">
                            <div class="nav-cluster__eyebrow">@AdminSection.Kicker</div>
                            <h3>@AdminSection.Title</h3>
                            <p>@AdminSection.Description</p>
                        </div>

                        <span class="nav-cluster__count">@visibleAdminItems.Count</span>
                    </header>

                    <ul class="nav-cluster__list">
                        @foreach (var item in visibleAdminItems)
                        {
                            <li class="nav-item">
                                <NavLink class="nav-link nav-link--rich"
                                         href="@item.Href"
                                         Match="@item.Match"
                                         title="@item.Title"
                                         @onclick="CloseNavMenuAfterSelection">
                                    <span class="nav-link__icon">
                                        <span class="oi @item.Icon" aria-hidden="true"></span>
                                    </span>

                                    <span class="nav-link__content">
                                        <span class="label">@item.Label</span>
                                        <span class="description">@item.Description</span>
                                    </span>

                                    @if (!string.IsNullOrWhiteSpace(item.Badge))
                                    {
                                        <span class="nav-link__badge">@item.Badge</span>
                                    }
                                </NavLink>
                            </li>
                        }
                    </ul>
                </section>
            </AuthorizeView>
        }
    </nav>
</div>

@code {
    private static IReadOnlyList<NavSectionDefinition> Sections => NavigationCatalog.Sections;
    private static NavSectionDefinition AdminSection => NavigationCatalog.AdminSection;

    private bool collapseNavMenu = true;
    private string searchText = string.Empty;
    private string searchDraft = string.Empty;
    private bool isArrendadoresOnly;
    private bool isAdmin;
    private bool hasEmployee;
    private bool isWorkforceSupervisor;
    private bool isWorkforceAdmin;
    private bool isWorkforcePayroll;
    private bool isFinanceReader;
    private bool attendanceEnabled;

    [Parameter] public EventCallback OnMenuItemSelected { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;
    private bool HasSearch => !string.IsNullOrWhiteSpace(searchText);

    private IReadOnlyList<VisibleNavSection> VisibleSections => BuildVisibleSections(Sections, searchText, isArrendadoresOnly, attendanceEnabled, hasEmployee, isWorkforceSupervisor, isWorkforceAdmin, isWorkforcePayroll, isFinanceReader, isAdmin);
    private IReadOnlyList<NavEntryDefinition> VisibleAdminItems => BuildVisibleAdminItems(searchText, isAdmin);

    private NavEntryDefinition? CurrentEntry
    {
        get
        {
            var currentPath = NormalizePath(Navigation.ToBaseRelativePath(Navigation.Uri));
            var allItems = Sections.SelectMany(section => section.Items);
            if (isAdmin)
            {
                allItems = allItems.Concat(AdminSection.Items);
            }

            return allItems
                .OrderByDescending(item => NormalizePath(item.Href).Length)
                .FirstOrDefault(item => IsCurrentRoute(currentPath, item));
        }
    }

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += HandleLocationChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (AuthenticationStateTask is null)
        {
            isArrendadoresOnly = false;
            isAdmin = false;
            hasEmployee = false;
            attendanceEnabled = false;
            isFinanceReader = false;
            return;
        }

        var authState = await AuthenticationStateTask;
        var user = authState.User;
        isAdmin = user.Identity?.IsAuthenticated == true && user.IsInRole("Administrador");
        hasEmployee = user.HasClaim(claim => claim.Type == "employee_id");
        isWorkforceAdmin = isAdmin || user.IsInRole("CapitalHumanoAdmin");
        isWorkforceSupervisor = isWorkforceAdmin || user.IsInRole("CapitalHumanoSupervisor");
        isWorkforcePayroll = isAdmin || user.IsInRole("CapitalHumanoNomina");
        isFinanceReader = isAdmin || user.IsInRole("FinanzasLectura") || user.IsInRole("FinanzasManager");
        attendanceEnabled = Configuration.GetValue<bool>("CapitalHumano:AttendanceEnabled");
        isArrendadoresOnly = NavigationCatalog.IsArrendadoresOnly(user);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
    }

    private static IReadOnlyList<VisibleNavSection> BuildVisibleSections(IReadOnlyList<NavSectionDefinition> source, string filter, bool arrendadoresOnly, bool featureEnabled, bool employee, bool supervisor, bool admin, bool payroll, bool financeReader, bool globalAdmin)
    {
        var query = filter.Trim();
        var sections = new List<VisibleNavSection>();

        foreach (var section in source)
        {
            var availableItems = arrendadoresOnly
                ? section.Items.Where(IsArrendadoresNavItem).ToList()
                : section.Items
                    .Where(item => CanSeeWorkforceItem(item, featureEnabled, employee, supervisor, admin, payroll))
                    .Where(item => CanSeeFinanceItem(item, financeReader, globalAdmin))
                    .ToList();

            IReadOnlyList<NavEntryDefinition> items = string.IsNullOrWhiteSpace(query)
                ? availableItems
                : availableItems.Where(item => MatchesFilter(item, query)).ToList();

            if (items.Count > 0)
            {
                sections.Add(new VisibleNavSection(section, items));
            }
        }

        return sections;
    }

    private static bool CanSeeWorkforceItem(NavEntryDefinition item, bool enabled, bool employee, bool supervisor, bool admin, bool payroll)
    {
        var path = NormalizePath(item.Href);
        // El expediente de empleados no depende del flag de asistencia: existia antes
        // del modulo y sigue siendo util con la asistencia apagada.
        if (path == "capital-humano") return admin;
        if (path == "mi-trabajo") return enabled && employee;
        if (path == "mi-equipo") return enabled && supervisor;
        if (path == "capital-humano/asistencia") return enabled && (supervisor || admin || payroll);
        if (path == "capital-humano/pre-nomina") return enabled && (admin || payroll);
        if (path == "capital-humano/configuracion-tiempo" || path == "capital-humano/ausencias") return enabled && admin;
        return true;
    }

    private static bool CanSeeFinanceItem(NavEntryDefinition item, bool financeReader, bool globalAdmin)
    {
        var path = NormalizePath(item.Href);
        if (!path.StartsWith("reportesfinancieros/", StringComparison.OrdinalIgnoreCase)) return true;
        if (path == "reportesfinancieros/saludempresa") return financeReader;
        return globalAdmin;
    }

    private static IReadOnlyList<NavEntryDefinition> BuildVisibleAdminItems(string filter, bool isAdminUser)
    {
        if (!isAdminUser)
        {
            return Array.Empty<NavEntryDefinition>();
        }

        var query = filter.Trim();
        return string.IsNullOrWhiteSpace(query)
            ? AdminSection.Items
            : AdminSection.Items.Where(item => MatchesFilter(item, query)).ToArray();
    }

    private static bool IsArrendadoresNavItem(NavEntryDefinition item)
    {
        var path = NormalizePath(item.Href);
        return string.Equals(path, "reservaciones/calendario", StringComparison.OrdinalIgnoreCase)
            || string.Equals(path, "arrendadores", StringComparison.OrdinalIgnoreCase);
    }

    private static bool MatchesFilter(NavEntryDefinition item, string filter)
    {
        return item.Label.Contains(filter, StringComparison.OrdinalIgnoreCase)
            || item.Description.Contains(filter, StringComparison.OrdinalIgnoreCase)
            || item.Title.Contains(filter, StringComparison.OrdinalIgnoreCase)
            || item.Badge?.Contains(filter, StringComparison.OrdinalIgnoreCase) == true
            || item.Keywords.Any(keyword => keyword.Contains(filter, StringComparison.OrdinalIgnoreCase));
    }

    private static NavEntryDefinition[] GetQuickAccessItems(IReadOnlyList<VisibleNavSection> sections)
    {
        return sections
            .SelectMany(section => section.Items)
            .Where(item => item.IsQuickAccess)
            .Take(8)
            .ToArray();
    }

    private static string NormalizePath(string path)
    {
        return NavigationCatalog.NormalizePath(path);
    }

    private static bool IsCurrentRoute(string currentPath, NavEntryDefinition item)
    {
        return NavigationCatalog.IsRouteMatch(currentPath, item);
    }

    private string GetSectionCssClass(VisibleNavSection section)
    {
        var isActive = CurrentEntry is not null && section.Definition.Items.Contains(CurrentEntry);
        return isActive ? "nav-cluster nav-cluster--active" : "nav-cluster";
    }

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private void CloseNavMenu()
    {
        collapseNavMenu = true;
    }

    private async Task CloseNavMenuAfterSelection()
    {
        CloseNavMenu();
        await OnMenuItemSelected.InvokeAsync();
    }

    private void ClearSearch()
    {
        searchText = string.Empty;
        searchDraft = string.Empty;
    }

    private void SubmitSearchOnEnter(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            searchText = searchDraft.Trim();
        }
    }

    private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        collapseNavMenu = true;
        _ = InvokeAsync(StateHasChanged);
    }

    private sealed class VisibleNavSection
    {
        public VisibleNavSection(NavSectionDefinition definition, IReadOnlyList<NavEntryDefinition> items)
        {
            Definition = definition;
            Items = items;
        }

        public NavSectionDefinition Definition { get; }
        public IReadOnlyList<NavEntryDefinition> Items { get; }
    }

}
