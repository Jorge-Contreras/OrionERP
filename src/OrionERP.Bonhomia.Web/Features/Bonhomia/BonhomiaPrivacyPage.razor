@page "/aviso-de-privacidad"
@inject PublicWebsitePresentationDefinition Presentation

<PageTitle>Aviso de privacidad | @Presentation.PublicName</PageTitle>
<HeadContent>
    <meta name="description" content="@($"Aviso de privacidad de {Presentation.PublicName} para datos personales tratados en solicitudes, reservas, pagos y seguimiento de hospedaje.")" />
</HeadContent>

<main class="bonhomia-page">
    <article class="bonhomia-document">
        <p class="bonhomia-eyebrow">Documento consolidado</p>
        <h1>Aviso de privacidad</h1>
        <p>El aviso de privacidad integral ahora forma parte del centro legal de @Presentation.PublicName.</p>

        <div class="bonhomia-document-card">
            <h2>Ir al aviso vigente</h2>
            <p>Consulta responsable, datos tratados, finalidades, transferencias, derechos ARCO y mecanismos de contacto en la version vigente.</p>
            <div class="bonhomia-actions">
                <a class="bonhomia-button bonhomia-button--primary" href="/legal#aviso-privacidad">Ver aviso de privacidad</a>
                <a class="bonhomia-button bonhomia-button--outline" href="/legal">Centro legal completo</a>
            </div>
        </div>
    </article>
</main>
