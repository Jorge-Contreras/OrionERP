@page "/restaurante/reportes"
@attribute [Authorize(Policy = "RestaurantAdmin")]
@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization
@using OrionERP.Application.Features.Logistica.Shared
@using OrionERP.Application.Features.Restaurante
@using OrionERP.Web.State
@inject IRestaurantCatalogService CatalogService
@inject IRestaurantBackofficeService BackofficeService
@inject IRestaurantAccountingService AccountingService
@inject IUserRfcState RfcState
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Restaurante · Reportes y liquidaciones</PageTitle>
<main class="restaurant-reports">
  <header class="reports-hero"><div><span>Control operativo</span><h1>Reportes y liquidaciones</h1><p>Ventas liquidadas, margen teórico, formas de pago y contra entrega pendiente.</p></div><button type="button" class="btn btn-light" @onclick="LoadAsync">Actualizar</button></header>
  @if(!string.IsNullOrWhiteSpace(message)){<div class="alert @(isError?"alert-danger":"alert-success")">@message</div>}
  @if(sites.Count>0)
  {
    <section class="reports-toolbar"><label>Sede<select @onchange="ChangeSiteAsync">@foreach(var site in sites){<option value="@site.Id" selected="@(site.Id==selectedSiteId)">@site.Name</option>}</select></label><label>Desde<input type="date" @bind="from" /></label><label>Hasta<input type="date" @bind="to" /></label><button type="button" @onclick="LoadReportAsync">Aplicar</button></section>
    <section class="report-kpis"><article><span>Ventas liquidadas</span><strong>@report.NetSales.ToString("C")</strong><small>@report.OrderCount orden(es)</small></article><article><span>Ticket promedio</span><strong>@report.AverageTicket.ToString("C")</strong><small>IVA @report.TaxTotal.ToString("C")</small></article><article><span>Margen teórico</span><strong>@((report.NetSales-report.TheoreticalCost).ToString("C"))</strong><small>Costo @report.TheoreticalCost.ToString("C")</small></article><article class="is-warning"><span>Por liquidar</span><strong>@report.PendingSettlement.ToString("C")</strong><small>Contra entrega</small></article></section>
    <section class="report-grid"><article class="report-panel"><header><h2>Ventas diarias</h2><span>Descuentos @report.DiscountTotal.ToString("C")</span></header><div class="report-table"><div class="report-table__head"><span>Fecha</span><span>Órdenes</span><span>Venta</span><span>Costo</span><span>Margen</span></div>@foreach(var day in report.DailySales){<div><span>@day.OperationalDate.ToString("dd MMM")</span><span>@day.OrderCount</span><span>@day.Sales.ToString("C")</span><span>@day.Cost.ToString("C")</span><strong>@((day.Sales-day.Cost).ToString("C"))</strong></div>}</div></article><article class="report-panel"><header><h2>Formas de pago</h2><span>Propina @report.TipTotal.ToString("C")</span></header>@foreach(var method in report.PaymentMethods){<div class="report-bar"><span>@PaymentLabel(method.Label)</span><i style="--size:@BarSize(method.Amount)"></i><strong>@method.Amount.ToString("C")</strong></div>}</article><article class="report-panel report-panel--wide"><header><h2>Productos principales</h2></header><div class="top-products">@foreach(var product in report.TopProducts){<div><strong>@product.ProductName</strong><span>@product.Quantity.ToString("0.##") u.</span><b>@product.Sales.ToString("C")</b></div>}</div></article></section>
    <section class="settlement-panel"><header><div><span>Plataformas y reparto</span><h2>Liquidar contra entrega</h2></div><div><input @bind="settlementCode" placeholder="Código de liquidación" /><button type="button" disabled="@(selectedOrders.Count==0||isBusy)" @onclick="SettleAsync">Liquidar seleccionadas</button></div></header><div class="settlement-candidates">@foreach(var candidate in candidates){<label class="@(selectedOrders.Contains(candidate.OrderId)?"is-selected":null)"><input type="checkbox" checked="@selectedOrders.Contains(candidate.OrderId)" @onchange="()=>ToggleCandidate(candidate)" /><span><strong>@candidate.ProviderName · #@candidate.Folio.ToString("000")</strong><small>@candidate.OperationalDate.ToString("d") · @candidate.ExternalReference</small></span><b>@candidate.GrossAmount.ToString("C")<small>-@candidate.CommissionAmount.ToString("C") comisión</small></b></label>}@if(candidates.Count==0){<p>No hay órdenes entregadas pendientes de liquidación.</p>}</div><footer>@foreach(var settlement in settlements.Take(12)){<div><span><strong>@settlement.SettlementCode</strong> · @settlement.ProviderName</span><span>@settlement.OrderCount orden(es)</span><b>@settlement.NetAmount.ToString("C")</b></div>}</footer></section>
    <section class="settlement-panel accounting-panel"><header><div><span>Contabilidad</span><h2>Póliza diaria · @to.ToString("dd MMM yyyy")</h2></div><button type="button" disabled="@(isBusy||accountingPreview.EligibleOrderCount==0||accountingPreview.ExistingTransactionId.HasValue)" @onclick="GeneratePolicyAsync">Generar póliza balanceada</button></header><div class="accounting-preview"><div><span>Ventas elegibles</span><strong>@accountingPreview.EligibleOrderCount</strong></div><div><span>Venta neta</span><strong>@accountingPreview.Sales.ToString("C")</strong></div><div><span>IVA</span><strong>@accountingPreview.Tax.ToString("C")</strong></div><div><span>Costo</span><strong>@accountingPreview.Cost.ToString("C")</strong></div></div>@if(accountingPreview.ExistingTransactionId.HasValue){<p class="accounting-status is-ready">Póliza @accountingPreview.ExistingTransactionId ya generada.</p>}else if(!accountingPreview.ConfigurationComplete){<p class="accounting-status">Faltan cuentas o la generación diaria no está habilitada en Configuración operativa.</p>}else{<p class="accounting-status is-ready">Configuración completa. Se excluirán CFDI individuales, propinas, cancelaciones, reembolsos y saldos pendientes.</p>}</section>
  }
</main>

@code{
  private List<RestaurantSiteDto> sites=[];private RestaurantReportDto report=new();private RestaurantAccountingPreviewDto accountingPreview=new();private List<RestaurantSettlementCandidateDto> candidates=[];private List<RestaurantProviderSettlementDto> settlements=[];private readonly HashSet<Guid> selectedOrders=[];private int selectedSiteId;private DateTime from=DateTime.Today.AddDays(-6);private DateTime to=DateTime.Today;private string settlementCode=$"LIQ-{DateTime.Now:yyyyMMdd}";private bool isBusy;private string? message;private bool isError;private string CurrentRfc=>LogisticsRfc.Require(RfcState.CurrentRfc);
  protected override async Task OnInitializedAsync(){RfcState.Changed+=OnRfcChanged;await LoadAsync();}private async Task LoadAsync(){isBusy=true;try{sites=(await CatalogService.GetSitesAsync(CurrentRfc)).ToList();if(!sites.Any(x=>x.Id==selectedSiteId))selectedSiteId=sites.FirstOrDefault()?.Id??0;await LoadReportAsync();}catch(Exception ex){Show(ex.Message,true);}finally{isBusy=false;}}private async Task LoadReportAsync(){if(selectedSiteId==0){report=new();accountingPreview=new();candidates=[];settlements=[];return;}report=await BackofficeService.GetReportAsync(CurrentRfc,selectedSiteId,from,to);accountingPreview=await AccountingService.GetDailyPreviewAsync(CurrentRfc,selectedSiteId,to);candidates=(await BackofficeService.GetSettlementCandidatesAsync(CurrentRfc,selectedSiteId)).ToList();settlements=(await BackofficeService.GetSettlementsAsync(CurrentRfc,selectedSiteId)).ToList();selectedOrders.RemoveWhere(id=>!candidates.Any(x=>x.OrderId==id));}
  private void ToggleCandidate(RestaurantSettlementCandidateDto candidate){if(selectedOrders.Remove(candidate.OrderId))return;var provider=candidates.FirstOrDefault(x=>selectedOrders.Contains(x.OrderId))?.ExternalProviderId;if(provider.HasValue&&provider!=candidate.ExternalProviderId)selectedOrders.Clear();selectedOrders.Add(candidate.OrderId);}private async Task SettleAsync(){isBusy=true;try{var auth=await AuthenticationStateProvider.GetAuthenticationStateAsync();var result=await BackofficeService.CreateSettlementAsync(new(){Rfc=CurrentRfc,SiteId=selectedSiteId,SettlementCode=settlementCode,OrderIds=selectedOrders.ToList()},auth.User.Identity?.Name??"liquidacion");Show(result.Message,!result.Success);if(result.Success){selectedOrders.Clear();settlementCode=$"LIQ-{DateTime.Now:yyyyMMdd-HHmm}";await LoadReportAsync();}}catch(Exception ex){Show(ex.Message,true);}finally{isBusy=false;}}private async Task GeneratePolicyAsync(){isBusy=true;try{var auth=await AuthenticationStateProvider.GetAuthenticationStateAsync();var result=await AccountingService.GenerateDailyPolicyAsync(CurrentRfc,selectedSiteId,to,auth.User.Identity?.Name??"contabilidad");Show(result.Message,!result.Success);await LoadReportAsync();}catch(Exception ex){Show(ex.Message,true);}finally{isBusy=false;}}private async Task ChangeSiteAsync(ChangeEventArgs e){if(int.TryParse(e.Value?.ToString(),out var id)){selectedSiteId=id;selectedOrders.Clear();await LoadReportAsync();}}private string BarSize(decimal value){var max=report.PaymentMethods.Select(x=>x.Amount).DefaultIfEmpty(1).Max();return $"{Math.Max(4,value/Math.Max(1,max)*100):0}%";}private static string PaymentLabel(string value)=>value switch{"Cash"=>"Efectivo","ExternalCard"=>"Tarjeta externa","Transfer"=>"Transferencia","Platform"=>"Plataforma",_=>value};private void Show(string value,bool error){message=value;isError=error;}private void OnRfcChanged()=>_=InvokeAsync(async()=>{selectedSiteId=0;selectedOrders.Clear();await LoadAsync();StateHasChanged();});public void Dispose()=>RfcState.Changed-=OnRfcChanged;
}
