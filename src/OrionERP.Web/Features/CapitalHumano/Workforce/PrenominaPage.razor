@page "/capital-humano/pre-nomina"
@attribute [Authorize(Policy = "CapitalHumanoNomina")]
@using OrionERP.Application.Features.CapitalHumano.Workforce
@inject IPrenominaService Prenomina
@inject IPrenominaExportService ExportService
@inject IWorkforceConfigurationService ConfigurationService
@inject IUserRfcState RfcState

<PageTitle>Pre-nómina</PageTitle>

<div class="workforce-page py-3">
  <header class="workforce-hero"><div><div class="workforce-eyebrow">Capital Humano · Nómina</div><h1>Pre‑nómina</h1><p>Valida incidencias, completa aprobaciones y congela unidades de tiempo antes de exportar. No calcula impuestos ni pago neto.</p></div><button class="btn btn-outline-primary" @onclick="LoadAsync">Actualizar</button></header>
  @if(!string.IsNullOrWhiteSpace(message)){<div class="alert @(error?"alert-danger":"alert-success") workforce-alert">@message</div>}
  <div class="workforce-grid">
    <section class="workforce-card workforce-span-4"><div class="workforce-card__header"><h2>Nuevo periodo</h2></div><div class="workforce-card__body"><label class="form-label">Grupo de pago</label><select class="form-select mb-2" @bind="create.PayGroupId"><option value="0">Selecciona</option>@foreach(var group in payGroups){<option value="@group.Id">@group.Name</option>}</select><div class="row g-2"><div class="col-6"><label class="form-label">Desde</label><input type="date" class="form-control" @bind="create.FromDate"/></div><div class="col-6"><label class="form-label">Hasta</label><input type="date" class="form-control" @bind="create.ToDate"/></div></div><button class="btn btn-primary w-100 mt-3" @onclick="CreateAsync">Crear periodo</button></div></section>
    <section class="workforce-card workforce-span-8"><div class="workforce-card__header"><h2>Periodos</h2><span class="workforce-status">@periods.Count</span></div><div class="table-responsive"><table class="table table-hover workforce-table"><thead><tr><th>Periodo</th><th>Grupo</th><th>Versión</th><th>Estado</th><th>Pendientes</th><th></th></tr></thead><tbody>@if(periods.Count==0){<tr><td colspan="6" class="workforce-empty">No hay periodos creados.</td></tr>}@foreach(var p in periods){<tr class="@(selected?.Id==p.Id?"table-info":"")"><td class="fw-semibold">@p.FromDate.ToString("dd MMM") – @p.ToDate.ToString("dd MMM yyyy")</td><td>@p.PayGroupName</td><td>v@p.Version</td><td><span class="workforce-status @(p.Status is "LOCKED" or "EXPORTED"?"":"workforce-status--warn")">@p.Status</span></td><td>@p.PendingExceptions excepciones · @p.PendingApprovals aprobaciones</td><td><button type="button" class="btn btn-sm @(selected?.Id==p.Id?"btn-primary":"btn-outline-primary")" @onclick="()=>SelectAsync(p)">@(selected?.Id==p.Id?"Abierto":"Revisar")</button></td></tr>}</tbody></table></div></section>
    @if(selected is not null)
    {
      <section class="workforce-card workforce-span-12"><div class="workforce-card__header"><div><h2>@selected.PayGroupName · @selected.FromDate.ToString("dd MMM") – @selected.ToDate.ToString("dd MMM yyyy")</h2><div class="workforce-label">Snapshot/periodo #@selected.Id · versión @selected.Version</div></div><div class="workforce-actions"><button class="btn btn-outline-primary" @onclick="ValidateAsync">Validar</button>@if(selected.Status is "OPEN" or "READY"){<button class="btn btn-primary" @onclick="LockAsync">Bloquear</button>}@if(selected.Status is "LOCKED" or "EXPORTED"){<button class="btn btn-outline-warning" @onclick="ReopenAsync">Reabrir versión</button><button class="btn btn-success" @onclick="ExportAsync">Generar exportación</button>}</div></div>
      @if(validation is not null){<div class="workforce-card__body border-bottom"><div class="alert @(validation.CanLock?"alert-success":"alert-warning") workforce-alert mb-0"><strong>@(validation.CanLock?"Periodo listo para bloqueo":"El periodo todavía no está listo")</strong>@foreach(var issue in validation.Errors){<div>• @issue</div>}@foreach(var warning in validation.Warnings){<div>• @warning</div>}</div></div>}
      @if(export is not null){<div class="workforce-card__body border-bottom"><div class="d-flex flex-wrap justify-content-between align-items-center gap-2"><div><strong>Exportación almacenada #@export.ExportId</strong><div class="workforce-label">XLSX SHA‑256: @export.XlsxSha256 · ZIP SHA‑256: @export.ZipSha256</div></div><div class="workforce-actions"><a class="btn btn-outline-success" href="@ExportUrl(export.ExportId,"xlsx")">Descargar XLSX</a><a class="btn btn-outline-success" href="@ExportUrl(export.ExportId,"zip")">Descargar CSV ZIP</a></div></div></div>}
      <div class="table-responsive"><table class="table workforce-table"><thead><tr><th>Empleado</th><th>Programado</th><th>Trabajado</th><th>Extra aprobada</th><th>Ausencia pagada</th><th>No pagada</th><th>Incidencias</th><th></th></tr></thead><tbody>@foreach(var line in lines){<tr><td class="fw-semibold">@line.EmployeeName</td><td>@line.ScheduledMinutes min</td><td>@line.WorkedMinutes min</td><td>@line.OvertimeApprovedMinutes min</td><td>@line.PaidLeaveDays.ToString("0.##") d</td><td>@line.UnpaidLeaveDays.ToString("0.##") d</td><td>@line.ExceptionCount</td><td>@if(selected.Status is "OPEN" or "READY"){<button class="btn btn-sm btn-outline-primary" @onclick="()=>ApproveEmployeeAsync(line.EmployeeId)">Aprobar empleado</button>}</td></tr>}</tbody></table></div></section>
    }
  </div>
</div>

@code {
  private IReadOnlyList<PrenominaPeriodDto> periods=[];private IReadOnlyList<PayGroupDto> payGroups=[];private IReadOnlyList<PrenominaLineDto> lines=[];private PrenominaPeriodDto? selected;private PrenominaValidationDto? validation;private PrenominaExportBundle? export;private PrenominaPeriodCreateRequest create=new(){FromDate=DateOnly.FromDateTime(DateTime.Today.AddDays(-6)),ToDate=DateOnly.FromDateTime(DateTime.Today)};private string? message;private bool error;
  private string Rfc=>RfcState.CurrentRfc??RfcState.AllowedRfcs.FirstOrDefault()??string.Empty;
  protected override async Task OnInitializedAsync()=>await LoadAsync();
  private async Task LoadAsync(){try{periods=await Prenomina.GetPeriodsAsync(Rfc);payGroups=(await ConfigurationService.GetSetupAsync(Rfc)).PayGroups;create.Rfc=Rfc;if(selected is not null){selected=periods.FirstOrDefault(x=>x.Id==selected.Id);if(selected is not null)lines=await Prenomina.GetLinesAsync(selected.Id,Rfc);}}catch(Exception ex){Show(ex.Message,true);}}
  private async Task SelectAsync(PrenominaPeriodDto period){selected=period;validation=null;export=null;try{lines=await Prenomina.GetLinesAsync(period.Id,Rfc);}catch(Exception ex){Show(ex.Message,true);}}
  private async Task CreateAsync(){create.Rfc=Rfc;await RunAsync(()=>Prenomina.CreatePeriodAsync(create));}
  private async Task ValidateAsync(){if(selected is null)return;try{validation=await Prenomina.ValidateAsync(selected.Id,Rfc);Show(validation.CanLock?"Validación completa sin bloqueos.":"La validación encontró pendientes.",!validation.CanLock);}catch(Exception ex){Show(ex.Message,true);}}
  private async Task ApproveEmployeeAsync(int employeeId){if(selected is null)return;await RunAsync(()=>Prenomina.ApproveEmployeeAsync(selected.Id,employeeId,Rfc));}
  private async Task LockAsync(){if(selected is null)return;await RunAsync(()=>Prenomina.LockAsync(selected.Id,Rfc));}
  private async Task ReopenAsync(){if(selected is null)return;await RunAsync(()=>Prenomina.ReopenAsync(selected.Id,Rfc,"Reapertura solicitada desde panel de pre-nómina"));}
  private async Task ExportAsync(){if(selected is null)return;try{export=await ExportService.GenerateAsync(selected.Id,Rfc);Show("Exportación generada y almacenada. Las descargas reproducen exactamente este snapshot.",false);await LoadAsync();}catch(Exception ex){Show(ex.Message,true);}}
  private async Task RunAsync(Func<Task<WorkforceCommandResult>> action){try{var result=await action();Show(result.Message,!result.Success);if(result.Success)await LoadAsync();}catch(Exception ex){Show(ex.Message,true);}}
  private string ExportUrl(long id,string format)=>$"/api/workforce/prenomina/exports/{id}/{format}?rfc={Uri.EscapeDataString(Rfc)}";
  private void Show(string text,bool isError){message=text;error=isError;}
}
