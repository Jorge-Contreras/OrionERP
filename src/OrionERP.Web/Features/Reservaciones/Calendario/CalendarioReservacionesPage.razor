@page "/reservaciones/calendario"
@attribute [Authorize(Roles = "Administrador,SatOperator,OrdenTrabajoOperador,Arrendadores")]

<PageTitle>Calendario de Reservaciones</PageTitle>

<div class="calendar-page-shell">
    <div class="calendar-page-header">
        <div>
            <h3 class="mb-1">Calendario de Reservaciones</h3>
            <p class="text-muted mb-0">Vista operativa para ocupacion, seleccion multiple y ordenes de limpieza.</p>
        </div>
        <div class="calendar-header-actions">
            @if (!CanUseCalendarActions)
            {
                <span class="badge text-bg-secondary align-self-center">Solo lectura</span>
            }
            @if (CanUseCalendarActions && SelectedRoomCalendarIds.Count > 0)
            {
                <button class="btn btn-success" @onclick="CreateReservationFromSelectionAsync" disabled="@(IsLoading || IsCreatingReservation || IsCreatingCleaningOrders)">
                    @(IsCreatingReservation ? "Creando reservación..." : $"Crear Reservación ({SelectedRoomCalendarIds.Count})")
                </button>
                <button class="btn btn-primary" @onclick="OpenCleaningModal" disabled="@(IsLoading || IsCreatingReservation || IsCreatingCleaningOrders)">
                    Asignar Orden de Limpieza (@SelectedRoomCalendarIds.Count)
                </button>
            }
            <button class="btn btn-outline-primary" @onclick="LoadCalendarAsync" disabled="@IsLoading">
                @(IsLoading ? "Cargando..." : "Actualizar")
            </button>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label">Inicio</label>
                    <input class="form-control" type="date" value="@StartDateText" @onchange="OnStartDateChanged" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Fin exclusivo</label>
                    <input class="form-control" type="date" value="@EndDateText" @onchange="OnEndDateChanged" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Tipo de espacio</label>
                    <select class="form-select" value="@Filter.RoomType" @onchange="OnRoomTypeChanged">
                        @foreach (var option in RoomTypeOptions)
                        {
                            <option value="@option.Value">@option.Label</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <div class="d-grid">
                        <button class="btn btn-primary" @onclick="LoadCalendarAsync" disabled="@IsLoading">Aplicar filtro</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-danger">@ErrorMessage</div>
    }
    else if (Timeline is not null)
    {
        <div class="calendar-stats mb-3">
            <span class="@GetSummaryChipCssClass("resources")">Recursos: @Timeline.Resources.Count</span>
            <span class="@GetSummaryChipCssClass("reserved")">Reservadas: @ReservedCellCount</span>
            <span class="@GetSummaryChipCssClass("soft_hold")">Soft holds: @SoftHoldCellCount</span>
            <span class="@GetSummaryChipCssClass("blocked")">Bloqueadas: @BlockedCellCount</span>
            <span class="@GetSummaryChipCssClass("orphan")">Huérfanas: @OrphanCellCount</span>
            <span class="@GetSummaryChipCssClass("events")">Eventos: @Timeline.Events.Count</span>
            @if (SelectedRoomCalendarIds.Count > 0)
            {
                <span class="calendar-stat-chip calendar-stat-chip-selected">Seleccionadas: @SelectedRoomCalendarIds.Count</span>
            }
        </div>

        @if (Timeline.Resources.Count == 0 || VisibleDates.Count == 0)
        {
            <div class="alert alert-warning">No hay recursos o fechas para mostrar con el filtro actual.</div>
        }
        else
        {
            <div class="card">
                <div class="card-body p-0">
                    <div class="calendar-grid-wrap">
                        <table class="table table-bordered table-sm mb-0 calendar-grid-table">
                            <thead>
                                <tr>
                                    <th class="calendar-sticky-col calendar-room-col">Espacio</th>
                                    @foreach (var day in VisibleDates)
                                    {
                                        <th class="@GetDayHeaderCssClass(day)">
                                            <div class="calendar-day-header">@day.ToString("ddd", HeaderCulture)</div>
                                            <div class="calendar-day-number">@day.ToString("dd MMM", HeaderCulture)</div>
                                        </th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var resource in Timeline.Resources)
                                {
                                    <tr>
                                        <th class="calendar-sticky-col calendar-room-col">
                                            <div class="fw-semibold">@resource.RoomName</div>
                                            <div class="text-muted small">@resource.RoomType</div>
                                        </th>
                                        @foreach (var day in VisibleDates)
                                        {
                                            var cell = GetCell(resource.RoomId, day);
                                            var orderBadges = GetCellWorkOrderBadges(cell);
                                            <td class="@GetCellCompositeCssClass(cell, day)"
                                                title="@GetCellTooltip(cell)"
                                                @onclick="args => OnCellClick(args, cell)"
                                                @ondblclick="() => OpenReservationFromCell(cell)">
                                                @if (cell is null)
                                                {
                                                    <div class="calendar-cell-empty">Sin fila</div>
                                                }
                                                else if (cell.ReservationId.HasValue)
                                                {
                                                    <div class="calendar-cell-link">
                                                        <div class="calendar-cell-top">
                                                            <span class="calendar-state-label">@GetStateLabel(cell.StateCode)</span>
                                                            <span class="calendar-reservation-id">#@cell.ReservationId</span>
                                                        </div>
                                                        @if (!string.IsNullOrWhiteSpace(cell.LockedBy))
                                                        {
                                                            <div class="calendar-cell-line">@cell.LockedBy</div>
                                                        }
                                                        <div class="calendar-cell-flags">
                                                            @if (cell.IsArrival)
                                                            {
                                                                <span class="badge text-bg-light">IN</span>
                                                            }
                                                            @if (cell.IsDeparture)
                                                            {
                                                                <span class="badge text-bg-light">OUT</span>
                                                            }
                                                            @if (cell.HasDeepCleaning)
                                                            {
                                                                <span class="badge text-bg-info">Limpieza</span>
                                                            }
                                                            @if (cell.HasExtras)
                                                            {
                                                                <span class="badge text-bg-dark">Extras</span>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="calendar-cell-top">
                                                        <span class="calendar-state-label">@GetStateLabel(cell.StateCode)</span>
                                                        @if (cell.ReservationId.HasValue)
                                                        {
                                                            <span class="calendar-reservation-id">#@cell.ReservationId</span>
                                                        }
                                                    </div>
                                                    @if (!string.IsNullOrWhiteSpace(cell.LockedBy))
                                                    {
                                                        <div class="calendar-cell-line">@cell.LockedBy</div>
                                                    }
                                                    <div class="calendar-cell-flags">
                                                        @if (cell.IsArrival)
                                                        {
                                                            <span class="badge text-bg-light">IN</span>
                                                        }
                                                        @if (cell.IsDeparture)
                                                        {
                                                            <span class="badge text-bg-light">OUT</span>
                                                        }
                                                        @if (cell.HasDeepCleaning)
                                                        {
                                                            <span class="badge text-bg-info">Limpieza</span>
                                                        }
                                                        @if (cell.HasExtras)
                                                        {
                                                            <span class="badge text-bg-dark">Extras</span>
                                                        }
                                                    </div>
                                                }

                                                @if (orderBadges.Count > 0)
                                                {
                                                    <div class="calendar-wo-badges">
                                                        @foreach (var badge in orderBadges)
                                                        {
                                                            var badgeLabel = GetCalendarOrderBadgeLabel(badge);
                                                            @if (CanUseCalendarActions)
                                                            {
                                                                <a class="@GetCalendarOrderBadgeClass(badge.Estado)"
                                                                   href="@($"/ordenes-trabajo/{badge.WorkOrderId}")"
                                                                   title="@($"{badgeLabel} | {badge.Folio} - {OrionERP.Web.Features.OrdenesTrabajo.OrdenesTrabajoPage.GetStatusLabel(badge.Estado)}")"
                                                                   @onclick:stopPropagation="true"
                                                                   @ondblclick:stopPropagation="true">
                                                                    @badgeLabel
                                                                </a>
                                                            }
                                                            else
                                                            {
                                                                <span class="@GetCalendarOrderBadgeClass(badge.Estado)"
                                                                      title="@($"{badgeLabel} | {badge.Folio} - {OrionERP.Web.Features.OrdenesTrabajo.OrdenesTrabajoPage.GetStatusLabel(badge.Estado)}")">
                                                                    @badgeLabel
                                                                </span>
                                                            }
                                                        }
                                                    </div>
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-header">Bloques detectados</div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm table-striped mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Espacio</th>
                                    <th>Tipo</th>
                                    <th>Inicio</th>
                                    <th>Fin exclusivo</th>
                                    <th>Reservación</th>
                                    <th>Detalle</th>
                                    <th>Calidad</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Timeline.Events)
                                {
                                    <tr>
                                        <td>@item.RoomName</td>
                                        <td>@GetStateLabel(item.EventType)</td>
                                        <td>@item.StartDate.ToString("yyyy-MM-dd")</td>
                                        <td>@item.EndDateExclusive.ToString("yyyy-MM-dd")</td>
                                        <td>@(item.ReservationId.HasValue ? $"#{item.ReservationId}" : "-")</td>
                                        <td>@(item.Subtitle ?? item.LockDescription ?? "-")</td>
                                        <td>@(item.DataQualityFlag ?? "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
</div>

@if (CanUseCalendarActions && ShowCleaningModal)
{
    <div class="calendar-modal-backdrop" @onclick="CloseCleaningModal">
        <div class="calendar-modal" role="dialog" aria-modal="true" aria-labelledby="cleaning-modal-title" @onclick:stopPropagation="true">
            <div class="calendar-modal__header">
                <div>
                    <h5 id="cleaning-modal-title" class="mb-1">Asignar Orden de Limpieza</h5>
                    <p class="text-muted mb-0">@SelectedRoomCalendarIds.Count celda@(SelectedRoomCalendarIds.Count == 1 ? string.Empty : "s") seleccionada@(SelectedRoomCalendarIds.Count == 1 ? string.Empty : "s").</p>
                </div>
                <button type="button" class="btn-close" aria-label="Cerrar" @onclick="CloseCleaningModal" disabled="@IsCreatingCleaningOrders"></button>
            </div>

            <div class="calendar-modal__body">
                <div class="mb-3">
                    <label class="form-label">Responsable</label>
                    <select class="form-select" @bind="CleaningOwnerEmployeeId" disabled="@IsCreatingCleaningOrders">
                        @foreach (var employee in WorkOrderEmployees)
                        {
                            <option value="@employee.Id">@employee.Name</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="form-label">Ayudantes</label>
                    <div class="calendar-helper-list">
                        @foreach (var employee in WorkOrderEmployees.Where(item => item.Id != CleaningOwnerEmployeeId))
                        {
                            <label class="calendar-helper-item">
                                <input type="checkbox"
                                       checked="@CleaningHelperIds.Contains(employee.Id)"
                                       disabled="@IsCreatingCleaningOrders"
                                       @onchange="args => ToggleCleaningHelper(employee.Id, args)" />
                                <span>@employee.Name</span>
                            </label>
                        }
                    </div>
                </div>
            </div>

            <div class="calendar-modal__footer">
                <button type="button" class="btn btn-outline-secondary" @onclick="CloseCleaningModal" disabled="@IsCreatingCleaningOrders">Cancelar</button>
                <button type="button" class="btn btn-primary" @onclick="CreateCleaningOrdersAsync" disabled="@IsCreatingCleaningOrders">
                    @(IsCreatingCleaningOrders ? "Creando..." : "Crear ordenes")
                </button>
            </div>
        </div>
    </div>
}
