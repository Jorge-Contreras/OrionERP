@implements IDisposable
@inject IUiMessageService MessageService

@if (_currentMessage is not null)
{
    <div class="notification-surface" role="presentation">
        <div class="alert @_currentMessage.CssClass alert-dismissible fade show notification-card"
             data-level="@_currentMessage.Level.ToString().ToLowerInvariant()"
             aria-live="@(IsUrgent(_currentMessage) ? "assertive" : "polite")"
             role="alert">
            @if (!string.IsNullOrWhiteSpace(_currentMessage.Title))
            {
                <div class="notification-title">@_currentMessage.Title</div>
                <div class="notification-body">@_currentMessage.Message</div>
            }
            else
            {
                <div class="notification-body">@_currentMessage.Message</div>
            }
            <button type="button" class="btn-close" aria-label="Cerrar" @onclick="Dismiss"></button>
        </div>
    </div>
}

@code {
    private UiMessage? _currentMessage;

    protected override void OnInitialized()
    {
        _currentMessage = MessageService.Current;
        MessageService.OnChange += HandleChange;
    }

    private void HandleChange()
    {
        _currentMessage = MessageService.Current;
        _ = InvokeAsync(StateHasChanged);
    }

    private void Dismiss() => MessageService.Clear();

    private static bool IsUrgent(UiMessage message) =>
        message.Level is UiMessageLevel.Error or UiMessageLevel.Warning;

    public void Dispose()
    {
        MessageService.OnChange -= HandleChange;
    }
}
