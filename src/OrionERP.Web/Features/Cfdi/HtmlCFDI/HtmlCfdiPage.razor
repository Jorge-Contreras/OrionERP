@page "/cfdi/html-cfdi/{id:int}"
@using OrionERP.Application.Features.Cfdi.HtmlCFDI
@attribute [Authorize(Roles = "Administrador,SatOperator")]

<h3>CFDI en HTML</h3>

<div class="mb-2">
    <button class="btn btn-link p-0" type="button" @onclick="TogglePolizas" aria-expanded="@(!IsPolizasCollapsed)" aria-controls="polizasSection">
        <strong>POLIZAS</strong>
        <span class="ml-2">@(!IsPolizasCollapsed ? "▲" : "▼")</span>
    </button>
</div>

@if (!IsPolizasCollapsed)
{
    <div id="polizasSection" class="mb-3">
        @if (IsPolizasLoading)
        {
            <div class="alert alert-info">Cargando pólizas...</div>
        }
        else if (Polizas.Count == 0)
        {
            <div class="alert alert-secondary">No hay pólizas vinculadas a este CFDI.</div>
        }
        else
        {
            <table class="table table-striped mt-2">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Fecha</th>
                        <th>Concepto</th>
                        <th>Monto</th>
                        <th>Monto Asignado</th>
                        <th>Tipo de Póliza</th>
                        <th>Forma de Pago</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var poliza in Polizas)
                    {
                        <tr>
                            <td>@poliza.Id</td>
                            <td>@poliza.Fecha.ToShortDateString()</td>
                            <td>@poliza.Concepto</td>
                            <td>@poliza.Monto</td>
                            <td>@poliza.MontoAsignado</td>
                            <td>@poliza.TipoPoliza</td>
                            <td>@poliza.FormaPago</td>
                            <td>
                                <a href="/contabilidad/transacciones/@poliza.Id" class="btn btn-sm btn-primary">Ver/Editar</a>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="3"></td>
                        <td><strong>Total:</strong></td>
                        <td>@TotalMontoAsignado</td>
                        <td colspan="2"></td>
                    </tr>
                </tfoot>
            </table>
        }
    </div>
}

<div class="mb-3 text-muted">Adjunto #@Id</div>

@if (IsLoading)
{
    <div class="alert alert-info">Cargando CFDI...</div>
}
else if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="alert alert-danger">@ErrorMessage</div>
}
else if (Document is null)
{
    <div class="alert alert-warning">No se pudo cargar el CFDI.</div>
}
else if (Document.TipoDeComprobante == "P")
{
    <CfdiPago20View Document="Document" />
}
else
{
    <CfdiComprobanteView Document="Document" />
}
