@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.JSInterop
@using OrionERP.Infrastructure.Auth
@inject IRfcContext Rfc
@inject IJSRuntime Js
@inject NavigationManager Navigation
@inject SignInManager<ApplicationUser> SignInManager

<AuthorizeView>
    <Authorized Context="context">
        <header class="security-header" role="banner">
            <div class="security-header__identity-wrap">
                <span class="security-header__identity">@context.User.Identity?.Name</span>
            </div>

            <div class="security-header__picker">
                <RfcPicker />
            </div>

            <div class="security-header__actions">
                <button class="btn btn-link btn-sm security-header__logout" @onclick="LogoutJs">Cerrar sesión</button>
            </div>
        </header>
    </Authorized>

    <NotAuthorized>
        <div class="security-header security-header--anonymous">
            <a class="btn btn-primary btn-sm" href="/Identity/Account/Login">Iniciar sesión</a>
        </div>
    </NotAuthorized>
</AuthorizeView>

  @code {
      private const string RfcStorageKey = "orionerp.selectedRfc";

      private async Task LogoutJs()
      {
          await Js.InvokeVoidAsync("eval", "location.href = '/Auth/logout'");
    }

    private async Task Logout()
    {
        await SignInManager.SignOutAsync();
        Rfc.CurrentRfc = null;
        await Js.InvokeVoidAsync("localStorage.removeItem", RfcStorageKey);
        Navigation.NavigateTo("/", forceLoad: true);
    }
}
