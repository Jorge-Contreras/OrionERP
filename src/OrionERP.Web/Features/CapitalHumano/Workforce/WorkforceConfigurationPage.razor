  private async Task RunAsync(Func<Task<WorkforceCommandResult>> action,Action? reset=null){busy=true;try{var result=await action();Show(result.Message,!result.Success);if(result.Success){reset?.Invoke();await LoadAsync();}}catch(Exception ex){Show(ex.Message,true);}finally{busy=false;}}
  private void Show(string text,bool error){message=text;messageIsError=error;}
  private static RenderFragment Check(bool value)=>builder=>{builder.OpenElement(0,"span");builder.AddAttribute(1,"class",$"workforce-status {(value?"":"workforce-status--warn")}");builder.AddContent(2,value?"Sí":"No");builder.CloseElement();};
  private static string FormatTime(TimeSpan? value)=>value?.ToString(@"hh\:mm")??"--:--";
  private sealed class DayEditor
  {
    public int DayOfWeek { get; set; }
    public bool IsWorkingDay { get; set; }
    public TimeOnly StartTime { get; set; }=new(9,0);
    public TimeOnly EndTime { get; set; }=new(18,0);
    public static List<DayEditor> CreateDefault()
      =>[..new[]{1,2,3,4,5,6,0}.Select(day=>new DayEditor{DayOfWeek=day,IsWorkingDay=day is>=1 and<=5})];
    public static List<DayEditor> From(IEnumerable<ScheduleDayDto> days)
    {
      var source=days.ToDictionary(day=>day.DayOfWeek);
      return [..new[]{1,2,3,4,5,6,0}.Select(day=>
      {
        var found=source.GetValueOrDefault(day);
        return new DayEditor
        {
          DayOfWeek=day,
          IsWorkingDay=found?.IsWorkingDay??false,
          StartTime=found?.StartTime is null?new(9,0):TimeOnly.FromTimeSpan(found.StartTime.Value),
          EndTime=found?.EndTime is null?new(18,0):TimeOnly.FromTimeSpan(found.EndTime.Value)
        };
      })];
    }
  }
}
