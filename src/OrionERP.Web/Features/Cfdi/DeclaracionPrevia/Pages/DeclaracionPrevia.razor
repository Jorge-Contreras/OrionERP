    <table class="table table-sm table-bordered table-striped align-middle">
        <thead class="table-dark">
            <tr>
                <th>✔</th>
                <th>Fecha</th>
                <th>Mes</th>
                <th>Año</th>
                <th>Emisor</th>
                <th>SubTotal</th>
                <th>Descuento</th>
                <th>SubTotal_Desc</th>
                <th>Actos16%</th>
                <th>Actos0%</th>
                <th>IVA</th>
                <th>IEPS</th>
                <th>IVA Retenido</th>
                <th>ISR Retenido</th>
                <th>IEPS Retenido</th>
                <th>Total</th>
                <th>UUID</th>
                <th>Forma Pago</th>
                <th>Tipo CFDI</th>
                <th>Método Pago</th>
                <th>Uso CFDI</th>
                <th>Fecha Pago</th>
                <th>Estatus</th>
                <th>Transacción</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (recibidas != null)
