        CuentaContableId = CuentaContableId,
        CuentaRfc = CuentaRfc,
        Nivel1 = Nivel1,
        Nivel2 = Nivel2,
        Nivel3 = Nivel3,
        CuentaDescripcion = CuentaDescripcion,
        Naturaleza = Naturaleza,
        MontoTipo = MontoTipo,
        Factor = Factor,
        ConceptoTipo = ConceptoTipo,
        ConceptoFijo = ConceptoFijo
      };

    public void ApplySelection(CuentaContableSelection selection)
    {
      CuentaContableId = selection.Id;
      CuentaRfc = selection.Rfc;
      Nivel1 = selection.Nivel1;
      Nivel2 = selection.Nivel2;
      Nivel3 = selection.Nivel3;
      CuentaDescripcion = selection.Descripcion;
    }

    public CuentaContableSelection ToSelection()
      => new()
      {
        Id = CuentaContableId,
        Rfc = CuentaRfc,
        Nivel1 = Nivel1,
        Nivel2 = Nivel2,
        Nivel3 = Nivel3,
        Descripcion = CuentaDescripcion
      };

    public PlantillaContableLineaSaveRequest ToRequest()
      => new()
      {
        PlantillaContableLineaId = PlantillaContableLineaId,
        Orden = Orden,
        CuentaContableId = CuentaContableId.GetValueOrDefault(),
        Naturaleza = Naturaleza,
        MontoTipo = MontoTipo,
        Factor = Factor,
        ConceptoTipo = ConceptoTipo,
        ConceptoFijo = ConceptoTipo == "FIJO" ? ConceptoFijo : null
      };
  }
