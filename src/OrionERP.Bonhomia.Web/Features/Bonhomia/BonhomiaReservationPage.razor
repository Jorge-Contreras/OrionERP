    private async Task TryRestoreCheckoutAsync()
    {
        try
        {
            var result = await SessionStorage.GetAsync<StoredCheckout>(SessionKey);
            if (!result.Success || result.Value is null)
            {
                return;
            }

            var stored = result.Value;
            SelectedRoomName = stored.Request.RoomName;
            CheckIn = stored.Request.CheckIn;
            CheckOut = stored.Request.CheckOut;
            Guests = stored.Request.Guests;
            ExtraQuantities = stored.Request.Extras.ToDictionary(item => item.Code, item => item.Quantity, StringComparer.OrdinalIgnoreCase);
            RestoreExperienceSelection(stored.Request.Experiences);
            Customer = stored.Customer ?? new BonhomiaCustomerInfo();
            AcceptedPolicies = stored.AcceptedPolicies;
            PendingPayPalOrderId = stored.PendingPayPalOrderId;
            PendingPaymentAttemptId = stored.PendingPaymentAttemptId;
            PaymentConfirmationFailed = !string.IsNullOrWhiteSpace(PendingPayPalOrderId);
            EnsureSelectedRoomAvailableForStay();
            EnsureExperienceDefaults();
            if (string.IsNullOrWhiteSpace(SelectedRoomName))
            {
                PendingPayPalOrderId = null;
                PendingPaymentAttemptId = null;
                PaymentConfirmationFailed = false;
            }

            if (!string.IsNullOrWhiteSpace(SelectedRoomName)
                && QuoteTokenService.TryValidate(stored.QuoteToken, out var restoredQuote, out _))
            {
                Quote = restoredQuote;
                QuoteToken = stored.QuoteToken;
                StatusMessage = PaymentConfirmationFailed
                  ? "Recuperamos tu pago pendiente de esta sesion."
                  : "Recuperamos tu cotizacion de esta sesion.";
                ActiveCheckoutStep = CheckoutStep.Payment;
            }

            StateHasChanged();
        }
        catch
        {
            // Protected browser storage is best-effort during prerender/reconnect.
        }
    }

    private async Task PersistCheckoutAsync()
    {
        try
        {
            await SessionStorage.SetAsync(SessionKey, new StoredCheckout
            {
                Request = BuildQuoteRequest(),
                Customer = Customer,
                AcceptedPolicies = AcceptedPolicies,
                QuoteToken = QuoteToken ?? string.Empty,
                PendingPayPalOrderId = PendingPayPalOrderId ?? string.Empty,
                PendingPaymentAttemptId = PendingPaymentAttemptId ?? string.Empty
            });
        }
        catch
        {
            // Session storage should not block checkout.
        }
    }

    private void RestoreExperienceSelection(IReadOnlyList<BonhomiaSelectedExperienceRequest>? experiences)
    {
        var experience = experiences?.FirstOrDefault(item => item.AdultParticipants + item.ChildParticipants > 0);
        if (experience is null)
        {
            IncludeExperience = false;
            SelectedExperienceCode = string.Empty;
            SelectedExperiencePackageCode = string.Empty;
            SelectedExperienceDate = null;
            ExperienceAdultParticipants = 0;
            ExperienceChildParticipants = 0;
            SelectedExperienceAddOnCodes.Clear();
            return;
        }

        IncludeExperience = true;
        SelectedExperienceCode = experience.Code;
        SelectedExperiencePackageCode = experience.PackageCode;
        SelectedExperienceDate = experience.ExperienceDate;
        ExperienceAdultParticipants = experience.AdultParticipants;
        ExperienceChildParticipants = experience.ChildParticipants;
        SelectedExperienceAddOnCodes = experience.AddOns
          .Where(item => item.Quantity > 0)
          .Select(item => item.Code)
          .ToHashSet(StringComparer.OrdinalIgnoreCase);
    }

    private async Task ClearStoredCheckoutAsync()
    {
        try
        {
            await SessionStorage.DeleteAsync(SessionKey);
        }
        catch
        {
            // Session storage should not block checkout.
        }
    }

    private void ClearQuoteState()
    {
        Quote = null;
        QuoteToken = null;
        CompletedReservation = null;
        StatusMessage = null;
        CheckoutError = null;
        PaymentConfirmationFailed = false;
        PendingPayPalOrderId = null;
        PendingPaymentAttemptId = null;
        AcceptedPolicies = false;
        _lastPayPalRenderKey = null;
        _payPalRenderInFlightKey = null;
        _ = ClearPayPalButtonsAsync();
        _ = ClearStoredCheckoutAsync();
    }

    private async Task RenderPayPalIfReadyAsync()
    {
        if (_dotNetRef is null)
        {
            return;
        }

        if (IsPaymentProcessing)
        {
            return;
        }

        if (!CanRenderPayPal || Quote is null || string.IsNullOrWhiteSpace(QuoteToken))
        {
            var shouldClear = _lastPayPalRenderKey is not null;
            _lastPayPalRenderKey = null;
            _payPalRenderInFlightKey = null;
            if (shouldClear)
            {
                await ClearPayPalButtonsAsync();
            }

            return;
        }

        var renderKey = string.Join("|", Quote.Fingerprint, QuoteToken, AcceptedPolicies, Customer.Phone.Trim(), CheckoutOptions.Value.PayPalLocale);
        if (string.Equals(renderKey, _lastPayPalRenderKey, StringComparison.Ordinal))
        {
            return;
        }

        if (string.Equals(renderKey, _payPalRenderInFlightKey, StringComparison.Ordinal))
        {
            return;
        }

        _payPalRenderInFlightKey = renderKey;
        try
        {
            var rendered = await Js.InvokeAsync<bool>(
                "bonhomiaCheckout.renderPayPalButtons",
                PayPalContainerId,
                new
                {
                    clientId = CheckoutOptions.Value.PayPalClientId,
                    currency = Quote.Currency,
                    locale = CheckoutOptions.Value.PayPalLocale,
                    quoteToken = QuoteToken,
                    quoteFingerprint = Quote.Fingerprint,
                    renderKey,
                    paymentAttemptId = PendingPaymentAttemptId,
                    customer = Customer
                },
                _dotNetRef);

            _lastPayPalRenderKey = rendered ? renderKey : null;
        }
        catch (TaskCanceledException)
        {
            _lastPayPalRenderKey = null;
        }
        catch (JSDisconnectedException)
        {
            _lastPayPalRenderKey = null;
        }
        catch (JSException ex) when (ex.Message.Contains("Detected container element removed from DOM", StringComparison.OrdinalIgnoreCase))
        {
            _lastPayPalRenderKey = null;
        }
        finally
        {
            if (string.Equals(_payPalRenderInFlightKey, renderKey, StringComparison.Ordinal))
            {
                _payPalRenderInFlightKey = null;
            }
        }
    }

    private async Task ClearPayPalButtonsAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("bonhomiaCheckout.clearPayPalButtons", PayPalContainerId);
        }
        catch (TaskCanceledException)
        {
            // PayPal can momentarily disconnect the Blazor circuit while its dialog is open.
        }
        catch (JSDisconnectedException)
        {
            // Clearing is cosmetic; reconnect or refresh will rebuild the checkout UI.
        }
    }

    [JSInvokable]
    public Task OnBonhomiaPaymentProcessing()
    {
        IsPaymentProcessing = true;
        CheckoutError = null;
        StatusMessage = "Confirmando pago y creando reservacion...";
        StateHasChanged();
        return Task.CompletedTask;
    }

    [JSInvokable]
    public async Task OnBonhomiaPaymentCompleted(BonhomiaConfirmPayPalOrderResponse result)
    {
        CompletedReservation = result;
        IsPaymentProcessing = false;
        PaymentConfirmationFailed = false;
        PendingPayPalOrderId = null;
        PendingPaymentAttemptId = null;
        StatusMessage = null;
        CheckoutError = null;
        Quote = null;
        QuoteToken = null;
        _lastPayPalRenderKey = null;
        _payPalRenderInFlightKey = null;
        ActiveCheckoutStep = CheckoutStep.Payment;
        _focusPaymentConfirmationAfterRender = true;
        await ClearStoredCheckoutAsync();
        StateHasChanged();
    }

    [JSInvokable]
    public Task OnBonhomiaPaymentCancelled()
    {
        IsPaymentProcessing = false;
        PaymentConfirmationFailed = false;
        PendingPayPalOrderId = null;
        PendingPaymentAttemptId = null;
        StatusMessage = "El pago fue cancelado. Tu cotizacion sigue disponible durante esta sesion.";
        StateHasChanged();
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task OnBonhomiaPaymentFailed(string message)
    {
        IsPaymentProcessing = false;
        PaymentConfirmationFailed = false;
        PendingPayPalOrderId = null;
        PendingPaymentAttemptId = null;
        CheckoutError = string.IsNullOrWhiteSpace(message) ? "No se pudo completar el pago." : message;
        StatusMessage = null;
        _lastPayPalRenderKey = null;
        _payPalRenderInFlightKey = null;
        StateHasChanged();
        return Task.CompletedTask;
    }

    [JSInvokable]
    public async Task OnBonhomiaPaymentConfirmationFailed(string message, string? orderId = null, string? paymentAttemptId = null)
    {
        IsPaymentProcessing = false;
        PaymentConfirmationFailed = true;
        PendingPayPalOrderId = string.IsNullOrWhiteSpace(orderId) ? PendingPayPalOrderId : orderId.Trim();
        PendingPaymentAttemptId = string.IsNullOrWhiteSpace(paymentAttemptId) ? PendingPaymentAttemptId : paymentAttemptId.Trim();
        CheckoutError = string.IsNullOrWhiteSpace(message)
          ? "PayPal no pudo confirmar el pago. Para evitar un doble cargo, no intentes pagar nuevamente con esta misma cotizacion."
          : $"{message} Para evitar un doble cargo, no intentes pagar nuevamente con esta misma cotizacion.";
        StatusMessage = null;
        _lastPayPalRenderKey = null;
        _payPalRenderInFlightKey = null;
        await ClearPayPalButtonsAsync();
        await PersistCheckoutAsync();
        StateHasChanged();
    }

    private async Task RetryPendingPayPalConfirmationAsync()
    {
        if (_dotNetRef is null
            || Quote is null
            || string.IsNullOrWhiteSpace(QuoteToken)
            || string.IsNullOrWhiteSpace(PendingPayPalOrderId))
        {
            CheckoutError = "No encontramos una orden PayPal pendiente en esta sesion.";
            return;
        }

        await Js.InvokeVoidAsync(
            "bonhomiaCheckout.confirmPayPalOrder",
            PendingPayPalOrderId,
            new
            {
                quoteToken = QuoteToken,
                quoteFingerprint = Quote.Fingerprint,
                paymentAttemptId = PendingPaymentAttemptId,
                customer = Customer
            },
            _dotNetRef);
    }

