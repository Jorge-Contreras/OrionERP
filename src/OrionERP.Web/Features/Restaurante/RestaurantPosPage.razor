@page "/restaurante/pos"
@attribute [Authorize(Policy = "RestaurantPos")]
@implements IDisposable
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Authorization
@using OrionERP.Application.Features.Logistica.Shared
@using OrionERP.Application.Features.Restaurante
@using OrionERP.Web.State
@inject IRestaurantCatalogService CatalogService
@inject IRestaurantOrderService OrderService
@inject IRestaurantSaleReadinessService SaleReadinessService
@inject IRestaurantSaleReadinessWorkbookService SaleReadinessWorkbookService
@inject IRestaurantPromotionService PromotionService
@inject ILoyaltyService LoyaltyService
@inject IRestaurantCashService CashService
@inject IRestaurantQuickPinService QuickPinService
@inject IRestaurantReceiptPdfService ReceiptPdfService
@inject ICurrentCompanyContext RfcState
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime Js
@inject RestaurantRealtimeClient Realtime

<PageTitle>Restaurante · Punto de venta</PageTitle>

<main class="pos-shell">
  <header class="pos-header">
    <div>
      <span>Punto de venta</span>
      <h1>@(catalog?.Site.Name ?? "Restaurante")</h1>
    </div>
    <div class="pos-header__actions">
      @if (sites.Count > 1)
      {
        <select aria-label="Sede" @onchange="ChangeSiteAsync">
          @foreach (var site in sites) { <option value="@site.Id" selected="@(site.Id == selectedSiteId)">@site.Name</option> }
        </select>
      }
      <button type="button"
              class="pos-sale-alerts @SaleAlertsToneClass"
              title="Materiales que detendrán una venta"
              aria-label="@SaleAlertsAriaLabel"
              @onclick="OpenSaleAlertsAsync"
              disabled="@(catalog is null)">
        <span class="@(isAnalyzingAlerts ? "spinner-border spinner-border-sm" : "oi oi-warning")" aria-hidden="true"></span>
        <span>Faltantes</span>
        @if (saleAlerts is not null && saleAlerts.BadgeCount > 0)
        {
          <b class="pos-sale-alerts__count">@saleAlerts.BadgeCount</b>
        }
      </button>
      <AuthorizeView Policy="RestaurantAdmin">
        <Authorized>
          <button type="button"
                  class="pos-readiness-download"
                  title="Descargar diagnóstico preventivo de venta"
                  aria-label="Descargar diagnóstico preventivo de venta"
                  @onclick="DownloadSaleReadinessAsync"
                  disabled="@(isBusy || isDownloadingReadiness || catalog is null)">
            <span class="@(isDownloadingReadiness ? "spinner-border spinner-border-sm" : "oi oi-data-transfer-download")" aria-hidden="true"></span>
            @(isDownloadingReadiness ? "Generando…" : "Diagnóstico")
          </button>
        </Authorized>
      </AuthorizeView>
      <button type="button" @onclick="LoadAsync" disabled="@isBusy"><span class="oi oi-reload"></span> Actualizar</button>
    </div>
  </header>

  @if (!string.IsNullOrWhiteSpace(error))
  {
    <div class="pos-alert" role="alert">@error</div>
  }

  @if (isBusy || (sites.Count > 0 && catalog is null))
  {
    <section class="pos-empty"><span class="spinner-border"></span><h2>Cargando menú…</h2></section>
  }
  else if (sites.Count == 0)
  {
    <section class="pos-empty"><span class="oi oi-cog"></span><h2>No hay una sede configurada</h2><p>Un administrador debe crearla y habilitar Restaurante.</p></section>
  }
  else if (catalog is not null)
  {
    <div class="pos-workspace">
      <nav class="pos-workspace-tabs" role="tablist" aria-label="Orden y secciones del menú">
        <button type="button"
                id="pos-order-tab"
                class="pos-workspace-tab pos-workspace-tab--order @(!isMenuOpen ? "is-active" : null)"
                role="tab"
                aria-selected="@(!isMenuOpen)"
                aria-controls="pos-order-panel"
                @onclick="ShowOrder">
          <span class="oi oi-cart" aria-hidden="true"></span>
          <span>
            <strong>Orden actual</strong>
            <small aria-live="polite">@CartItemCount producto(s) · @CartSubtotal.ToString("C")</small>
          </span>
        </button>
        @foreach (var section in catalog.Sections)
        {
          <button type="button"
                  id="@($"pos-menu-tab-{section.Id}")"
                  class="pos-workspace-tab @(isMenuOpen && activeSectionId == section.Id ? "is-active" : null)"
                  role="tab"
                  aria-selected="@(isMenuOpen && activeSectionId == section.Id)"
                  aria-controls="pos-menu-panel"
                  @onclick="() => ShowMenuSection(section.Id)">
            @section.Name
          </button>
        }
      </nav>

      @if (isMenuOpen)
      {
        <section id="pos-menu-panel"
                 class="pos-catalog"
                 role="tabpanel"
                 aria-label="Menú de productos">
          <header class="pos-catalog__heading">
            <div>
              <span>Agregar productos</span>
              <h2>@ActiveSectionName</h2>
            </div>
            @if (cart.Count > 0)
            {
              <button type="button" class="pos-return-order" @onclick="ShowOrder">
                Ver orden <strong>@CartItemCount</strong>
              </button>
            }
          </header>

          <div class="pos-products">
            @foreach (var product in ActiveProducts)
            {
              <button type="button"
                      class="pos-product @(product.IsSoldOut ? "is-sold-out" : null)"
                      aria-label="@($"{ProductDisplayName(product)}, {product.Price:C}")"
                      disabled="@product.IsSoldOut"
                      @onclick="() => SelectProduct(product, activeSectionId)">
                <span class="pos-product__image">
                  @if (product.HasImage) { <img src="@ProductImageUrl(product.Id)" alt="@product.Name" loading="lazy" decoding="async" /> }
                  else { <span class="oi oi-image" aria-hidden="true"></span> }
                  @if (product.IsSoldOut) { <b>Agotado</b> }
                </span>
                <span class="pos-product__copy">
                  <strong title="@ProductDisplayName(product)">@ProductDisplayName(product) @if (product.ProductKind == RestaurantProductKinds.Combo) { <em class="pos-combo-badge">Combo</em> }</strong>
                  <b>@product.Price.ToString("C")</b>
                </span>
                @if (product.Allergens.Count > 0) { <span class="pos-product__allergen" title="@string.Join(", ", product.Allergens)">!</span> }
              </button>
            }
            @if (!ActiveProducts.Any()) { <p class="pos-products__empty">Esta sección no tiene productos disponibles.</p> }
          </div>
        </section>
      }
      else
      {
        <div id="pos-order-panel"
             class="pos-order-layout"
             role="tabpanel"
             aria-labelledby="pos-order-tab">
          <section class="pos-order-review" aria-label="Partidas de la orden actual">
            <header class="pos-order-review__heading">
              <div>
                <span>Orden actual</span>
                <h2>@CartItemCount producto(s)</h2>
                <p>Revisa cantidades, detalles y descuentos antes de cobrar.</p>
              </div>
              <div class="pos-order-review__actions">
                <button type="button" class="pos-add-products" @onclick="ShowMenu">
                  <span class="oi oi-plus" aria-hidden="true"></span> Agregar productos
                </button>
                <button type="button" class="pos-custom-open" @onclick="OpenCustomItem">
                  <span aria-hidden="true">＋</span> Cargo personalizado
                </button>
                <button type="button" class="pos-clear-order" @onclick="ClearCartAsync" disabled="@(cart.Count == 0)">Limpiar</button>
              </div>
            </header>

            <div class="pos-cart__items">
              @foreach (var line in cart)
              {
                <article class="pos-cart-line @(line.IsCustom ? "is-custom" : null)">
                  <div class="pos-cart-line__thumbnail">
                    @if (!line.IsCustom && line.ProductId is long productId && ProductHasImage(productId))
                    {
                      <img src="@ProductImageUrl(productId)" alt="" loading="lazy" decoding="async" />
                    }
                    else if (line.IsCustom)
                    {
                      <span class="oi oi-plus" aria-hidden="true"></span>
                    }
                    else
                    {
                      <span class="oi oi-image" aria-hidden="true"></span>
                    }
                  </div>
                  <div class="pos-cart-line__details">
                    <div class="pos-cart-line__title">
                      <strong>@line.Name</strong>
                      @if (line.IsCustom) { <span class="pos-custom-badge">Personalizado</span> }
                      else if (line.ProductKind == RestaurantProductKinds.Combo) { <span class="pos-combo-badge">Combo</span> }
                      else if (!string.IsNullOrWhiteSpace(line.MenuSectionName)) { <span class="pos-section-badge">@line.MenuSectionName</span> }
                    </div>
                    @if (line.Modifiers.Count > 0)
                    {
                      <div class="pos-cart-customizations">
                        @foreach (var modifier in line.Modifiers) { <small><b>@modifier.GroupName:</b> @ModifierDisplayName(modifier) @if(modifier.PriceDelta>0){<span> +@((modifier.PriceDelta*modifier.Quantity).ToString("C"))</span>}</small> }
                        @foreach (var effect in line.Modifiers.SelectMany(item=>item.Effects)) { <small class="@EffectClass(effect.EffectKind)"><span aria-hidden="true">@(effect.EffectKind==RestaurantModifierEffectKinds.RemoveIngredient?"−":"+")</span> @EffectLabel(effect)</small> }
                      </div>
                    }
                    @if (line.ComboComponents.Count > 0)
                    {
                      <div class="pos-cart-components" aria-label="Componentes del combo">
                        @foreach (var component in line.ComboComponents)
                        {
                          <div class="pos-cart-component">
                            <span class="pos-cart-component__branch" aria-hidden="true">↳</span>
                            <div>
                              <strong>@FormatComponentQuantity(component.Quantity) @component.ProductName</strong>
                              <small>@component.SlotName @if(component.PriceDelta>0){<b> · +@component.PriceDelta.ToString("C")</b>}</small>
                              @foreach (var modifier in component.Modifiers) { <small><b>@modifier.GroupName:</b> @ModifierDisplayName(modifier) @if(modifier.PriceDelta>0){<span> +@((modifier.PriceDelta*modifier.Quantity).ToString("C"))</span>}</small> }
                              @foreach (var effect in component.Modifiers.SelectMany(item=>item.Effects)) { <small class="@EffectClass(effect.EffectKind)"><span aria-hidden="true">@(effect.EffectKind==RestaurantModifierEffectKinds.RemoveIngredient?"−":"+")</span> @EffectLabel(effect)</small> }
                              @if (!string.IsNullOrWhiteSpace(component.Notes)) { <small class="pos-cart-line__notes"><b>Nota:</b> @component.Notes</small> }
                            </div>
                          </div>
                        }
                      </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(line.Notes)) { <small class="pos-cart-line__notes"><b>Nota:</b> @line.Notes</small> }
                    <span class="pos-cart-line__unit">@line.UnitPrice.ToString("C") por unidad</span>
                    <label class="pos-line-discount">
                      <span>Descuento de línea</span>
                      <input type="number"
                             min="0"
                             step="0.01"
                             max="@(line.UnitPrice * line.Quantity)"
                             aria-label="@($"Descuento de línea para {line.Name}")"
                             @bind="line.DiscountAmount"
                             @bind:after="OnCartDiscountChangedAsync" />
                    </label>
                  </div>
                  <div class="pos-cart-line__summary">
                    <div class="pos-cart-line__amount">
                      <small>Total de línea</small>
                      <strong>@LineNetTotal(line).ToString("C")</strong>
                      @if (line.DiscountAmount > 0)
                      {
                        <span>Antes @((line.UnitPrice * line.Quantity).ToString("C"))</span>
                      }
                    </div>
                    <div class="pos-cart-line__controls" aria-label="Cantidad de @line.Name">
                      <button type="button" aria-label="Restar una unidad de @line.Name" @onclick="() => ChangeQuantityAsync(line, -1)">−</button>
                      <b aria-label="Cantidad">@line.Quantity</b>
                      <button type="button" aria-label="Sumar una unidad de @line.Name" @onclick="() => ChangeQuantityAsync(line, 1)">+</button>
                    </div>
                    @if (!line.IsCustom)
                    {
                      <button type="button" class="pos-cart-line__customize" @onclick="()=>OpenPersonalize(line)">
                        <span class="oi oi-pencil" aria-hidden="true"></span> Personalizar
                      </button>
                    }
                    <button type="button" class="pos-cart-line__remove" aria-label="Eliminar @line.Name de la orden" @onclick="() => RemoveLineAsync(line)">
                      <span class="oi oi-trash" aria-hidden="true"></span> Eliminar
                    </button>
                  </div>
                </article>
              }
              @if (cart.Count == 0)
              {
                <div class="pos-cart__empty">
                  <span class="oi oi-cart" aria-hidden="true"></span>
                  <h3>La orden está vacía</h3>
                  <p>Selecciona una sección del menú para agregar el primer producto.</p>
                  <button type="button" class="pos-add-products" @onclick="ShowMenu">Abrir menú</button>
                </div>
              }
            </div>
          </section>

          <aside class="pos-checkout" aria-label="Datos y cobro de la orden">
            <header class="pos-checkout__heading">
              <span>Finalizar orden</span>
              <strong>Datos, pago y total</strong>
            </header>
            <section class="pos-order-options">
          <section class="pos-membership" aria-label="Membresía y promociones">
            <header><div><span>Club Bruno’s</span><strong>Pregunta primero si el cliente es miembro</strong></div></header>
            <div class="pos-membership__lookup">
              <label>QR, número, correo o teléfono
                <input @bind="memberIdentifier" @bind:event="oninput" autocomplete="off" placeholder="Ej. teléfono de 10 dígitos" />
              </label>
              <button type="button" @onclick="FindMemberAsync" disabled="@(isLookingUpMember || string.IsNullOrWhiteSpace(memberIdentifier))">@(isLookingUpMember ? "Buscando…" : "Vincular")</button>
            </div>
            @if (selectedMember is not null)
            {
              <div class="pos-membership__member">
                <span class="oi oi-person" aria-hidden="true"></span>
                <div><strong>@selectedMember.DisplayName</strong><small>@selectedMember.MembershipNumber · @selectedMember.MaskedPhone · @selectedMember.PointsBalance puntos</small></div>
                <button type="button" @onclick="ClearMember">Quitar</button>
              </div>
              @if (redemptionPreview is not null)
              {
                <div class="pos-redemption @(appliedRedemptionPoints > 0 ? "is-applied" : null)">
                  <div class="pos-redemption__summary">
                    <span>Canje de puntos</span>
                    <strong>@redemptionPreview.PointsBalance puntos · 1 punto = @redemptionPreview.PointValueMxn.ToString("C")</strong>
                    <small>Mínimo @redemptionPreview.MinimumRedeemPoints · máximo para esta orden @MaximumOrderRedemptionPoints</small>
                  </div>
                  @if (!redemptionPreview.CanRedeem)
                  {
                    <p>El socio todavía no alcanza el mínimo de @redemptionPreview.MinimumRedeemPoints puntos.</p>
                  }
                  else if (MaximumOrderRedemptionPoints == 0)
                  {
                    <p>La mercancía restante de esta orden no alcanza el mínimo de canje.</p>
                  }
                  else
                  {
                    <div class="pos-redemption__controls">
                      <label>Puntos a canjear
                        <input type="number" min="@redemptionPreview.MinimumRedeemPoints" max="@MaximumOrderRedemptionPoints" step="1" @bind="redemptionPoints" />
                      </label>
                      <button type="button" @onclick="ApplyRedemption" disabled="@(!CanApplyRedemption)">Aplicar</button>
                      <button type="button" @onclick="UseMaximumRedemption">Usar máximo</button>
                    </div>
                    @if (appliedRedemptionPoints > 0)
                    {
                      <div class="pos-redemption__applied">
                        <span>@appliedRedemptionPoints puntos aplicados</span>
                        <strong>-@AppliedRedemptionValue.ToString("C")</strong>
                        <button type="button" @onclick="ClearRedemption">Quitar</button>
                      </div>
                    }
                  }
                </div>
              }
            }
            <div class="pos-membership__lookup">
              <label>Código promocional
                <input @bind="promotionCode" @bind:event="oninput" maxlength="32" autocomplete="off" placeholder="Ej. MARTES2X1" />
              </label>
              <button type="button" @onclick="() => RefreshPromotionQuoteAsync()" disabled="@(isQuotingPromotions || cart.Count == 0)">@(isQuotingPromotions ? "Calculando…" : "Aplicar")</button>
            </div>
            @if (promotionQuote is not null)
            {
              <div class="pos-membership__quote @(promotionQuote.CodeAccepted ? "is-valid" : "is-invalid")">
                @foreach (var adjustment in promotionQuote.Adjustments)
                {
                  <span><strong>@adjustment.PromotionName</strong><b>-@adjustment.DiscountAmount.ToString("C")</b></span>
                }
                @if (!string.IsNullOrWhiteSpace(promotionQuote.Message)) { <small>@promotionQuote.Message</small> }
              </div>
            }
          </section>
          <div class="pos-segmented" role="group" aria-label="Modalidad">
            @foreach (var type in new[] { ("Pickup", "Recoger"), ("Table", "Mesa"), ("Delivery", "Domicilio") })
            {
              <button type="button" class="@(orderType == type.Item1 ? "is-active" : null)" @onclick="() => SetOrderTypeAsync(type.Item1)">@type.Item2</button>
            }
          </div>
          @if (orderType == "Table")
          {
            <label>Mesa<select @bind="diningTableId"><option value="">Seleccionar…</option>@foreach (var table in catalog.Tables) { <option value="@table.Id">@table.Name</option> }</select></label>
          }
          <div class="pos-form-row">
            <label class="pos-required-label">
              <span>Cliente <b aria-hidden="true">*</b></span>
              <input @bind="customerName"
                     @bind:event="oninput"
                     required
                     maxlength="150"
                     autocomplete="name"
                     aria-required="true"
                     placeholder="Nombre obligatorio" />
              <small>Obligatorio para enviar la orden.</small>
            </label>
            <label>Teléfono <input @bind="customerPhone" placeholder="Opcional" /></label>
          </div>
          @if (orderType == "Delivery")
          {
            <label>Dirección <textarea @bind="deliveryAddress" rows="2"></textarea></label>
            <label>Referencias <textarea @bind="deliveryReferences" rows="2"></textarea></label>
            <div class="pos-form-row">
              <label>Proveedor<select @bind="externalProviderId"><option value="">Propio / ninguno</option>@foreach (var provider in catalog.ExternalProviders) { <option value="@provider.Id">@provider.Name</option> }</select></label>
              <label>Costo de entrega <input type="number" min="0" step="0.01" @bind="deliveryCost" /></label>
              <label>Referencia externa <input @bind="externalReference" /></label>
              <label>Comisión <input type="number" min="0" step="0.01" @bind="commissionAmount" /></label>
            </div>
          }
          <label>Notas de la orden<textarea @bind="orderNotes" rows="2"></textarea></label>
          <details class="pos-discounts">
            <summary>Descuento manual</summary>
            <div class="pos-form-row"><label>Tipo<select @bind="discountMode" @bind:after="InvalidateRedemption"><option value="Amount">Importe</option><option value="Percent">Porcentaje</option></select></label><label>Valor <input type="number" min="0" step="0.01" @bind="discountValue" @bind:after="InvalidateRedemption" /></label></div>
            <label>Motivo <input @bind="discountReason" /></label>
            <small>Si aplicas un descuento, el supervisor lo revisará y autorizará al cobrar.</small>
          </details>
            </section>

            <section class="pos-payments">
          <div class="pos-payments__title"><strong>Pago combinado</strong><button type="button" @onclick="FillCash">Todo efectivo</button></div>
          <div class="pos-payment-grid">
            <label>Recibido en efectivo <input type="number" min="0" step="0.01" inputmode="decimal" @bind="cashReceived" @bind:event="oninput" /></label>
            <label>Tarjeta externa <input type="number" min="0" step="0.01" inputmode="decimal" @bind="cardAmount" @bind:event="oninput" /></label>
            <label>Transferencia <input type="number" min="0" step="0.01" inputmode="decimal" @bind="transferAmount" @bind:event="oninput" /></label>
            <label>Propina <input type="number" min="0" step="0.01" inputmode="decimal" @bind="tipAmount" @bind:event="oninput" /></label>
            @* Celda propia bajo Transferencia: dentro del campo estiraba la fila y descuadraba Propina. *@
            <button type="button"
                    class="pos-transfer__print"
                    @onclick="PrintTransferDetailsAsync"
                    disabled="@(!CanPrintTransferDetails)"
                    title="@TransferPrintHint"
                    aria-label="Imprimir datos de transferencia SPEI">
              <span class="@(isPrintingTransferSlip ? "spinner-border spinner-border-sm" : "oi oi-print")" aria-hidden="true"></span>
              @(isPrintingTransferSlip ? "Imprimiendo…" : "Datos SPEI")
            </button>
          </div>
          @if (!string.IsNullOrWhiteSpace(transferSlipWarning))
          {
            <p class="pos-transfer__warning" role="alert">@transferSlipWarning</p>
          }
          <div class="pos-cash-summary @(PosCash.Shortfall > 0 ? "is-short" : "is-ready")" aria-live="polite">
            <div><span>A cobrar en efectivo</span><b>@PosCash.CashRequired.ToString("C")</b></div>
            @if (PosCash.Shortfall > 0)
            {
              <div><span>Falta por recibir</span><strong>@PosCash.Shortfall.ToString("C")</strong></div>
            }
            else
            {
              <div class="pos-cash-summary__change"><span>Cambio a entregar</span><strong>@PosCash.Change.ToString("C")</strong></div>
            }
          </div>
          @if (openShifts.Count == 0)
          {
            <div class="pos-shift-required" role="alert"><span class="oi oi-warning-sign" aria-hidden="true"></span><span><strong>Se requiere un turno abierto</strong><small>Abre un turno de caja antes de registrar ventas.</small></span></div>
          }
          else
          {
            <label>Turno de caja<select @bind="selectedShiftId">@if(openShifts.Count > 1){<option value="">Seleccionar turno…</option>}@foreach (var shift in openShifts) { <option value="@shift.Id">@shift.RegisterName · @shift.OpenedAt.ToLocalTime().ToString("t")</option> }</select></label>
          }
            </section>

            <footer class="pos-cart__total">
          @if (DiscountTotal > 0)
          {
            <div><span>Productos</span><b>@CartSubtotal.ToString("C")</b></div>
            @if (NonLoyaltyDiscountTotal > 0)
            {
              <div><span>@(catalog.Site.PricesIncludeTax ? "Descuentos (IVA incluido)" : "Descuentos")</span><b>-@NonLoyaltyDiscountTotal.ToString("C")</b></div>
            }
            @if (AppliedRedemptionValue > 0)
            {
              <div class="is-redemption"><span>Club Bruno · @appliedRedemptionPoints puntos</span><b>-@AppliedRedemptionValue.ToString("C")</b></div>
            }
          }
          <div><span>Subtotal antes de IVA</span><b>@PosTotals.SubtotalBeforeTax.ToString("C")</b></div>
          <div><span>IVA (@catalog.Site.TaxRate.ToString("P0"))</span><b>@PosTotals.Tax.ToString("C")</b></div>
          @if (PosTotals.Delivery > 0) { <div><span>Entrega</span><b>@PosTotals.Delivery.ToString("C")</b></div> }
          <div class="is-total"><span>Total</span><b>@GrandTotal.ToString("C")</b></div>
          @if (SelectedShift is null)
          {
            <p class="pos-submit-hint">Selecciona un turno de caja abierto para cobrar esta venta.</p>
          }
          else if (IsCustomerNameMissing)
          {
            <p class="pos-submit-hint">Captura el nombre del cliente para continuar.</p>
          }
          else if (ElectronicPaymentExcess > 0.01m)
          {
            <p class="pos-submit-hint">Los pagos exceden el total por @ElectronicPaymentExcess.ToString("C").</p>
          }
          else if (RequiresFullPayment && PosCash.Shortfall > 0.01m)
          {
            <p class="pos-submit-hint">Falta cubrir @PosCash.Shortfall.ToString("C") para cobrar esta orden.</p>
          }
          <button type="button" class="pos-submit" disabled="@(!CanSubmit)" @onclick="SubmitAsync">@(isSubmitting ? "Generando orden…" : "Cobrar y enviar a cocina")</button>
            </footer>
          </aside>
        </div>
      }
    </div>
  }
</main>

@if (isCustomItemOpen)
{
  <div class="pos-modal-backdrop" @onclick="CloseCustomItem">
    <section class="pos-modal pos-custom-modal"
             role="dialog"
             aria-modal="true"
             aria-labelledby="custom-item-title"
             @onclick:stopPropagation>
      <header>
        <div><span>Uso excepcional</span><h2 id="custom-item-title">Cargo personalizado</h2></div>
        <button type="button" @onclick="CloseCustomItem" aria-label="Cerrar">×</button>
      </header>
      <p class="pos-custom-explanation">
        Se guardará como una partida auditable de la orden. No descuenta inventario y se enviará a Cocina en la sección Cargo Personalizado.
      </p>
      <div class="pos-custom-fields">
        <label class="pos-custom-fields__name">
          Descripción
          <input @bind="customItemName"
                 @bind:event="oninput"
                 maxlength="180"
                 autocomplete="off"
                 placeholder="Ej. Cargo por artículo especial" />
        </label>
        <label>
          Cantidad
          <input type="number" min="1" max="999" step="1" inputmode="numeric" @bind="customItemQuantity" @bind:event="oninput" />
        </label>
        <label>
          @(catalog?.Site.PricesIncludeTax == false ? "Precio unitario antes de IVA" : "Precio unitario con IVA")
          <input type="number" min="0.01" max="999999999" step="0.01" inputmode="decimal" @bind="customItemPrice" @bind:event="oninput" />
        </label>
        <label class="pos-custom-fields__notes">
          Nota opcional
          <textarea @bind="customItemNotes" @bind:event="oninput" rows="2" maxlength="500" placeholder="Detalle para la orden o el ticket"></textarea>
        </label>
      </div>
      <div class="pos-custom-total"><span>Total de la partida</span><strong>@CustomItemTotal.ToString("C")</strong></div>
      <button type="button" class="pos-submit" disabled="@(!CanAddCustomItem)" @onclick="AddCustomItemAsync">
        Agregar cargo a la orden
      </button>
    </section>
  </div>
}

@if (isSaleAlertsOpen)
{
  <RestaurantPosSaleAlertsPanel Board="saleAlerts"
                                IsLoading="isAnalyzingAlerts"
                                LoadError="@saleAlertsError"
                                SiteName="@(catalog?.Site.Name ?? string.Empty)"
                                CreatedBy="@currentUserName"
                                OnRefresh="RefreshSaleAlertsAsync"
                                OnClose="CloseSaleAlerts" />
}

@if (isSupervisorOverrideOpen)
{
  <div class="pos-modal-backdrop pos-supervisor-backdrop" @onclick="CloseSupervisorOverride">
    <section class="pos-modal pos-supervisor-modal @(SupervisorOverrideIsInventory ? "is-inventory" : "is-discount")"
             role="dialog"
             aria-modal="true"
             aria-labelledby="supervisor-override-title"
             aria-describedby="supervisor-override-description"
             @onclick:stopPropagation>
      <header>
        <div><span>Revisión obligatoria</span><h2 id="supervisor-override-title">@SupervisorOverrideTitle</h2></div>
        <button type="button" @onclick="CloseSupervisorOverride" disabled="@isSupervisorOverrideBusy" aria-label="Cerrar autorización">×</button>
      </header>

      <div class="pos-supervisor-summary" role="alert">
        <span class="oi oi-warning-sign" aria-hidden="true"></span>
        <div>
          <strong>@(SupervisorOverrideIsInventory ? "La orden no puede continuar con el inventario actual" : "La orden contiene un descuento manual")</strong>
          <p id="supervisor-override-description">@supervisorOverrideMessage</p>
        </div>
      </div>

      <div class="pos-supervisor-scope">
        <strong>Al autorizar</strong>
        @if (SupervisorOverrideIsInventory)
        {
          <p>Se reintentará esta misma orden permitiendo el faltante descrito arriba. La excepción y el supervisor quedarán registrados para auditoría.</p>
        }
        else
        {
          <p>Se conservará el descuento capturado y quedarán registrados el motivo y el supervisor que lo aprobó.</p>
        }
      </div>

      <form @onsubmit="AuthorizeSupervisorOverrideAsync" @onsubmit:preventDefault>
        @if (!SupervisorOverrideIsInventory)
        {
          <label class="pos-supervisor-reason">Motivo del descuento
            <input @bind="discountReason" @bind:event="oninput" maxlength="500" autocomplete="off" placeholder="Describe por qué se autoriza" />
          </label>
        }
        <div class="pos-supervisor-fields">
          <label>Supervisor
            <input @bind="supervisorIdentity" @bind:event="oninput" maxlength="256" autocomplete="username" placeholder="Usuario o correo" />
          </label>
          <label>PIN de caja
            <input type="password" inputmode="numeric" pattern="[0-9]{4,8}" minlength="4" maxlength="8" @bind="supervisorPin" @bind:event="oninput" autocomplete="current-password" placeholder="4 a 8 dígitos" />
          </label>
        </div>
        @if (!string.IsNullOrWhiteSpace(supervisorOverrideError))
        {
          <p class="pos-supervisor-error" role="alert">@supervisorOverrideError</p>
        }
        <footer class="pos-supervisor-actions">
          <button type="button" class="pos-supervisor-cancel" @onclick="CloseSupervisorOverride" disabled="@isSupervisorOverrideBusy">Cancelar</button>
          <button type="submit" class="pos-supervisor-authorize" disabled="@(!CanAuthorizeSupervisorOverride)">
            <span class="oi oi-lock-locked" aria-hidden="true"></span>
            @(isSupervisorOverrideBusy ? "Verificando…" : SupervisorOverrideActionLabel)
          </button>
        </footer>
      </form>
    </section>
  </div>
}

@if (selectedProduct is not null)
{
  <div class="pos-modal-backdrop" @onclick="CloseProductModal">
    <section class="pos-modal pos-personalization-modal" role="dialog" aria-modal="true" aria-labelledby="personalization-title" @onclick:stopPropagation>
      <header class="pos-personalization-header">
        <div><span>@(editingLine is null ? "Personalizar" : "Editar una unidad")</span><h2 id="personalization-title">@selectedProduct.Name</h2><p>@(selectedProduct.ProductKind==RestaurantProductKinds.Combo?"Elige los componentes y personaliza cada uno.":"Indica cambios de preparación o una nota para cocina.")</p></div>
        <button type="button" @onclick="CloseProductModal" aria-label="Cerrar personalización">×</button>
      </header>

      <div class="pos-personalization-layout">
        <div class="pos-personalization-content">
          @if (editingLine?.Quantity > 1)
          {
            <div class="pos-split-notice" role="status"><span class="oi oi-info" aria-hidden="true"></span><div><strong>Se editará una sola unidad.</strong><small>Las otras @(editingLine.Quantity - 1) conservarán su configuración actual.</small></div></div>
          }

          @if (selectedProduct.ProductKind == RestaurantProductKinds.Combo)
          {
            @foreach (var slot in selectedProduct.ComboSlots.Where(item=>item.IsActive).OrderBy(item=>item.SortOrder))
            {
              <fieldset class="pos-combo-slot @(ComboSlotIsValid(slot)?"is-valid":"is-incomplete")">
                <legend><span>@slot.Name</span><small>@SelectionInstruction(slot)</small><b>@SelectedOptionCount(slot)/@slot.MaxSelections</b></legend>
                <div class="pos-combo-options">
                  @foreach (var option in slot.Options.Where(item=>item.IsActive).OrderBy(item=>item.SortOrder))
                  {
                    var isSelected = IsComboOptionSelected(slot.Id, option.Id);
                    <article class="pos-combo-option @(isSelected?"is-selected":null) @(option.IsSoldOut?"is-sold-out":null)">
                      <label>
                        <input type="checkbox" checked="@isSelected" disabled="@option.IsSoldOut" @onchange="args=>ToggleComboOption(slot,option,args.Value as bool? == true)" />
                        <span><strong>@option.ComponentProductName</strong><small>@FormatComponentQuantity(option.Quantity) · @option.ComponentSku @if(option.IsDefault){<em>Predeterminado</em>}</small></span>
                        <b>@(option.PriceDelta==0?"Incluido":$"+{option.PriceDelta:C}")</b>
                      </label>
                      @if (isSelected)
                      {
                        var componentDraft = GetComponentDraft(slot.Id,option.Id);
                        <div class="pos-component-personalization">
                          @foreach (var group in option.ComponentModifierGroups)
                          {
                            <fieldset><legend>@group.Name <small>@ModifierInstruction(group)</small></legend>
                              @foreach (var modifier in group.Options)
                              {
                                @if (group.MaxSelections > 1)
                                {
                                  <div class="pos-modifier pos-modifier--stepper"><span>@modifier.Name</span><b>@(modifier.PriceDelta==0?"Incluido":$"+{modifier.PriceDelta:C}")</b>
                                    <div class="pos-modifier__stepper">
                                      <button type="button" aria-label="Quitar una unidad de @modifier.Name" disabled="@(ModifierCount(componentDraft.ModifierIds,modifier.Id)==0)" @onclick="()=>StepModifier(componentDraft.ModifierIds,group,modifier,-1)">&#8722;</button>
                                      <b aria-label="Cantidad de @modifier.Name">@ModifierCount(componentDraft.ModifierIds,modifier.Id)</b>
                                      <button type="button" aria-label="Agregar una unidad de @modifier.Name" disabled="@(GroupSelectionCount(componentDraft.ModifierIds,group)>=group.MaxSelections)" @onclick="()=>StepModifier(componentDraft.ModifierIds,group,modifier,1)">+</button>
                                    </div>
                                  </div>
                                }
                                else
                                {
                                  <label class="pos-modifier"><input type="checkbox" checked="@componentDraft.ModifierIds.Contains(modifier.Id)" @onchange="args=>ToggleComponentModifier(componentDraft,group,modifier,args.Value as bool? == true)" /><span>@modifier.Name</span><b>@(modifier.PriceDelta==0?"Incluido":$"+{modifier.PriceDelta:C}")</b></label>
                                }
                              }
                            </fieldset>
                          }
                          <label class="pos-personalization-note">Nota para este componente <textarea @bind="componentDraft.Notes" @bind:event="oninput" maxlength="500" rows="2" placeholder="Ej. salsa aparte"></textarea><small>@NoteCounter(componentDraft.Notes)</small></label>
                        </div>
                      }
                    </article>
                  }
                </div>
              </fieldset>
            }
          }
          else
          {
            @foreach (var group in selectedProduct.ModifierGroups)
            {
              <fieldset><legend>@group.Name <small>@ModifierInstruction(group)</small></legend>
                @foreach (var option in group.Options)
                {
                  @if (group.MaxSelections > 1)
                  {
                    <div class="pos-modifier pos-modifier--stepper"><span>@option.Name</span><b>@(option.PriceDelta == 0 ? "Incluido" : $"+{option.PriceDelta:C}")</b>
                      <div class="pos-modifier__stepper">
                        <button type="button" aria-label="Quitar una unidad de @option.Name" disabled="@(ModifierCount(selectedModifierIds, option.Id) == 0)" @onclick="() => StepModifier(selectedModifierIds, group, option, -1)">&#8722;</button>
                        <b aria-label="Cantidad de @option.Name">@ModifierCount(selectedModifierIds, option.Id)</b>
                        <button type="button" aria-label="Agregar una unidad de @option.Name" disabled="@(GroupSelectionCount(selectedModifierIds, group) >= group.MaxSelections)" @onclick="() => StepModifier(selectedModifierIds, group, option, 1)">+</button>
                      </div>
                    </div>
                  }
                  else
                  {
                    <label class="pos-modifier"><input type="checkbox" checked="@selectedModifierIds.Contains(option.Id)" @onchange="args => ToggleModifier(group, option, args.Value as bool? == true)" /><span>@option.Name</span><b>@(option.PriceDelta == 0 ? "Incluido" : $"+{option.PriceDelta:C}")</b></label>
                  }
                }
              </fieldset>
            }
            <label class="pos-personalization-note">Nota para cocina <textarea @bind="selectedProductNotes" @bind:event="oninput" maxlength="500" rows="3" placeholder="Ej. servir salsa aparte"></textarea><small>@NoteCounter(selectedProductNotes)</small></label>
          }

          @if (PersonalizationAllergens.Count > 0) { <div class="pos-allergen-warning"><strong>Alérgenos declarados:</strong> @string.Join(", ", PersonalizationAllergens). @catalog?.Site.CrossContaminationWarning</div> }
        </div>

        <aside class="pos-personalization-summary" aria-label="Resumen de precio">
          <div><span>Precio base</span><b>@selectedProduct.Price.ToString("C")</b></div>
          @foreach (var supplement in SelectedSupplements) { <div><span>@supplement.Name</span><b>+@supplement.Amount.ToString("C")</b></div> }
          <div class="is-total"><span>Total por unidad</span><strong>@SelectedProductPrice.ToString("C")</strong></div>
          @if (!CanSavePersonalization) { <p>Completa las elecciones obligatorias antes de continuar.</p> }
          <button type="button" class="pos-submit" disabled="@(!CanSavePersonalization)" @onclick="AddSelectedProductAsync">@(editingLine is null ? "Agregar a la orden" : "Guardar cambios") · @SelectedProductPrice.ToString("C")</button>
        </aside>
      </div>
    </section>
  </div>
}

@if (lastOrder is not null)
{
  <div class="pos-modal-backdrop">
    <section class="pos-ticket" role="dialog" aria-modal="true">
      <span>ORDEN</span><strong>@lastOrder.Folio.ToString("000")</strong>
      @if (!string.IsNullOrWhiteSpace(lastOrder.CustomerName)) { <b class="pos-ticket__customer">@lastOrder.CustomerName</b> }
      <p>Total @lastOrder.Total.ToString("C")</p><small>@lastOrder.Status · @lastOrder.PaymentStatus</small>
      @if (lastOrder.PointsRedeemed > 0)
      {
        <small class="pos-ticket__loyalty">Canje: @lastOrder.PointsRedeemed puntos (-@lastOrder.RedemptionValue.ToString("C")) · Saldo @lastOrder.PointsBalance</small>
      }
      @if (lastOrder.WasDuplicate)
      {
        <small class="pos-ticket__recovered" role="status">Esta orden ya se había registrado. Recuperamos el resultado sin volver a cobrarla ni enviarla.</small>
      }
      @if (lastReceipt is not null)
      {
        <small class="pos-ticket__copies">
          Se imprimirán 1 ticket de número de orden + 1 ticket de cliente
          @if (lastReceipt.SectionTicketCount > 0)
          {
            <span> + @lastReceipt.SectionTicketCount por sección</span>
          }
        </small>
      }
      @if (!string.IsNullOrWhiteSpace(error))
      {
        <small class="pos-ticket__error" role="alert">@error</small>
      }
      @if (!string.IsNullOrWhiteSpace(drawerWarning))
      {
        <small class="pos-ticket__drawer-warning" role="status">
          <span>@drawerWarning</span>
          <a href="https://qz.io/download/?os=windows" target="_blank" rel="noopener noreferrer">Instalar QZ Tray</a>
        </small>
      }
      <div>
        @if (lastOrderReceivedCash)
        {
          <button type="button" class="btn btn-outline-warning" @onclick="OpenCashDrawerAsync" disabled="@isOpeningDrawer">
            @(isOpeningDrawer ? "Abriendo…" : "Abrir cajón")
          </button>
        }
        <button type="button" class="btn btn-outline-secondary" @onclick="PrintTicketAsync" disabled="@(isPrinting || lastReceipt is null)">
          @(isPrinting ? "Preparando…" : "Imprimir tickets")
        </button>
        <button type="button" class="btn btn-primary" @onclick="StartNewOrder" disabled="@isPrinting">Nueva orden</button>
      </div>
    </section>
  </div>
}

@code {
  private List<RestaurantSiteDto> sites = [];
  private RestaurantPosCatalogDto? catalog;
  private List<RestaurantCashShiftDto> openShifts = [];
  private List<CartLine> cart = [];
  private long activeSectionId;
  private bool isMenuOpen = true;
  private bool hasInitializedWorkspace;
  private int selectedSiteId;
  private RestaurantProductDto? selectedProduct;
  private RestaurantMenuSectionDto? selectedMenuSection;
  private List<long> selectedModifierIds = [];
  private Dictionary<long, HashSet<long>> selectedComboOptionIds = [];
  private Dictionary<string, ComponentSelectionDraft> selectedComponentDrafts = [];
  private string? selectedProductNotes;
  private CartLine? editingLine;
  private bool isCustomItemOpen;
  private string? customItemName;
  private int customItemQuantity = 1;
  private decimal customItemPrice;
  private string? customItemNotes;
  private string orderType = "Pickup";
  private int? diningTableId;
  private int? externalProviderId;
  private Guid? selectedShiftId;
  private string? customerName;
  private string? customerPhone;
  private string? memberIdentifier;
  private LoyaltyMemberDto? selectedMember;
  private LoyaltyRedeemablePreviewDto? redemptionPreview;
  private int redemptionPoints;
  private int appliedRedemptionPoints;
  private string? promotionCode;
  private RestaurantPromotionQuoteDto? promotionQuote;
  private string? deliveryAddress;
  private string? deliveryReferences;
  private string? externalReference;
  private string? orderNotes;
  private decimal deliveryCost;
  private decimal commissionAmount;
  private string discountMode = "Amount";
  private decimal discountValue;
  private string? discountReason;
  private string? supervisorIdentity;
  private string? supervisorPin;
  private bool isSupervisorOverrideOpen;
  private bool isSupervisorOverrideBusy;
  private string? supervisorOverrideError;
  private string supervisorOverrideMessage = string.Empty;
  private SupervisorOverrideKind supervisorOverrideKind;
  private decimal cashReceived;
  private decimal cardAmount;
  private decimal transferAmount;
  private decimal tipAmount;
  private string? error;
  private string? drawerWarning;
  private bool isBusy = true;
  private bool isSubmitting;
  private bool isLookingUpMember;
  private bool isQuotingPromotions;
  private bool isPrinting;
  private bool isPrintingTransferSlip;
  private string? transferSlipWarning;
  private bool isOpeningDrawer;
  private bool isDownloadingReadiness;
  private RestaurantSaleAlertBoard? saleAlerts;
  private bool isAnalyzingAlerts;
  private bool isSaleAlertsOpen;
  private string? saleAlertsError;
  private string currentUserName = "restaurante";
  private bool lastOrderReceivedCash;
  private string idempotencyKey = Guid.NewGuid().ToString("N");
  private RestaurantOrderResult? lastOrder;
  private RestaurantReceiptPdfDocumentModel? lastReceipt;
  private string CurrentRfc => RfcState.RequireRfc();
  private string SaleAlertsToneClass => saleAlerts is null
    ? "is-unknown"
    : saleAlerts.HasBlockers
      ? "is-critical"
      : saleAlerts.BadgeCount > 0
        ? "is-attention"
        : saleAlerts.WarningCount > 0 ? "is-warning" : "is-clear";
  private string SaleAlertsAriaLabel => saleAlerts is null
    ? "Faltantes: todavía sin analizar"
    : saleAlerts.BadgeCount == 0
      ? "Faltantes: ningún material detendrá una venta"
      : $"Faltantes: {saleAlerts.BadgeCount} detendrán una venta";
  private IEnumerable<RestaurantProductDto> ActiveProducts => catalog?.Sections.FirstOrDefault(section => section.Id == activeSectionId)?.Products ?? [];
  private string ActiveSectionName => catalog?.Sections.FirstOrDefault(section => section.Id == activeSectionId)?.Name ?? "Menú";
  private int CartItemCount => cart.Sum(item => item.Quantity);
  private decimal CartSubtotal => cart.Sum(item => item.UnitPrice * item.Quantity);
  private decimal LineDiscountTotal => cart.Sum(item => Math.Min(Math.Max(0, item.DiscountAmount), item.UnitPrice * item.Quantity));
  private decimal PromotionDiscountTotal => promotionQuote?.PromotionDiscountTotal ?? 0;
  private decimal OrderDiscountAmount => decimal.Round(
    Math.Min(
      Math.Max(
        0,
        discountMode == "Percent"
          ? Math.Max(0, CartSubtotal - PromotionDiscountTotal - LineDiscountTotal) * discountValue / 100m
          : discountValue),
      Math.Max(0, CartSubtotal - PromotionDiscountTotal - LineDiscountTotal)),
    2);
  private decimal NonLoyaltyDiscountTotal => decimal.Round(PromotionDiscountTotal + LineDiscountTotal + OrderDiscountAmount, 2);
  private bool HasManualDiscount => LineDiscountTotal + OrderDiscountAmount > 0;
  private decimal MerchandiseBeforeRedemption => decimal.Round(Math.Max(0, CartSubtotal - NonLoyaltyDiscountTotal), 2);
  private int MaximumOrderRedemptionPoints => redemptionPreview is null
    ? 0
    : LoyaltyPointsCalculator.CalculateMaximumOrderRedemptionPoints(
      redemptionPreview.PointsBalance,
      redemptionPreview.MinimumRedeemPoints,
      redemptionPreview.PointValueMxn,
      MerchandiseBeforeRedemption);
  private decimal AppliedRedemptionValue => redemptionPreview is null || appliedRedemptionPoints <= 0
    ? 0
    : LoyaltyPointsCalculator.CalculateRedemptionValue(appliedRedemptionPoints, redemptionPreview.PointValueMxn);
  private bool CanApplyRedemption => redemptionPreview is not null
    && redemptionPoints >= redemptionPreview.MinimumRedeemPoints
    && redemptionPoints <= MaximumOrderRedemptionPoints
    && LoyaltyPointsCalculator.ValidateRedemption(
      redemptionPoints,
      redemptionPreview.PointsBalance,
      redemptionPreview.MinimumRedeemPoints) is null;
  private bool AppliedRedemptionIsValid => appliedRedemptionPoints == 0 ||
    (redemptionPreview is not null && selectedMember is not null &&
     appliedRedemptionPoints <= MaximumOrderRedemptionPoints &&
     LoyaltyPointsCalculator.ValidateRedemption(
       appliedRedemptionPoints,
       redemptionPreview.PointsBalance,
       redemptionPreview.MinimumRedeemPoints) is null);
  private decimal DiscountTotal => decimal.Round(NonLoyaltyDiscountTotal + AppliedRedemptionValue, 2);
  private RestaurantPosTotalsBreakdown PosTotals => RestaurantPosTotalsCalculator.Calculate(
    CartSubtotal,
    DiscountTotal,
    deliveryCost,
    catalog?.Site.TaxRate ?? 0,
    catalog?.Site.PricesIncludeTax ?? true);
  private decimal GrandTotal => PosTotals.Total;
  private RestaurantCashTenderBreakdown PosCash => RestaurantCashTenderCalculator.Calculate(
    GrandTotal,
    cardAmount,
    transferAmount,
    cashReceived,
    tipAmount);
  private decimal ElectronicPaymentExcess => decimal.Round(Math.Max(0, cardAmount + transferAmount - GrandTotal), 2, MidpointRounding.AwayFromZero);
  // El comprobante se imprime antes de cobrar: si el cajero aún no captura el
  // importe por transferencia, se ofrece el saldo que falta por cubrir.
  private decimal TransferSlipAmount => decimal.Round(
    transferAmount > 0 ? transferAmount : Math.Max(0, GrandTotal - cardAmount - cashReceived),
    2,
    MidpointRounding.AwayFromZero);
  private bool HasTransferPaymentDetails => catalog?.Site.HasTransferPaymentDetails == true;
  private bool CanPrintTransferDetails => HasTransferPaymentDetails && !isPrintingTransferSlip;
  private string TransferPrintHint => HasTransferPaymentDetails
    ? "Imprime los datos bancarios (SPEI) para que el cliente haga la transferencia."
    : "Captura los datos de transferencia en Restaurante › Administración › Sedes.";
  private bool IsCustomerNameMissing => string.IsNullOrWhiteSpace(customerName);
  private bool RequiresFullPayment => orderType is "Pickup" or "Table";
  private RestaurantCashShiftDto? SelectedShift => openShifts.FirstOrDefault(shift => shift.Id == selectedShiftId);
  private bool CanSubmit => cart.Count > 0
    && !isSubmitting
    && SelectedShift is not null
    && !IsCustomerNameMissing
    && AppliedRedemptionIsValid
    && (string.IsNullOrWhiteSpace(promotionCode) || promotionQuote?.CodeAccepted == true)
    && ElectronicPaymentExcess <= 0.01m
    && (!RequiresFullPayment || PosCash.Shortfall <= 0.01m);
  private bool SupervisorOverrideIsInventory => supervisorOverrideKind == SupervisorOverrideKind.Inventory;
  private string SupervisorOverrideTitle => SupervisorOverrideIsInventory
    ? "Autorizar excepción de inventario"
    : "Autorizar descuento";
  private string SupervisorOverrideActionLabel => SupervisorOverrideIsInventory
    ? "Autorizar y reintentar"
    : "Autorizar y cobrar";
  private bool SupervisorPinLooksValid => supervisorPin is { Length: >= 4 and <= 8 }
    && supervisorPin.All(char.IsDigit);
  private bool CanAuthorizeSupervisorOverride => !isSupervisorOverrideBusy
    && !string.IsNullOrWhiteSpace(supervisorIdentity)
    && SupervisorPinLooksValid
    && (SupervisorOverrideIsInventory || !string.IsNullOrWhiteSpace(discountReason));
  private decimal SelectedProductPrice => selectedProduct is null
    ? 0
    : selectedProduct.ProductKind == RestaurantProductKinds.Combo
      ? RestaurantComboPricingRules.CalculateUnitPrice(selectedProduct.Price, SelectedComboPriceSelections)
      : decimal.Round(selectedProduct.Price + SelectedSupplements.Sum(item => item.Amount), 2, MidpointRounding.AwayFromZero);
  private IReadOnlyList<RestaurantComboPriceSelection> SelectedComboPriceSelections
  {
    get
    {
      if (selectedProduct?.ProductKind != RestaurantProductKinds.Combo) return [];
      return selectedProduct.ComboSlots
        .SelectMany(slot => slot.Options.Where(option => IsComboOptionSelected(slot.Id, option.Id)))
        .Select(option =>
        {
          var draft = GetComponentDraftForOption(option) ?? new ComponentSelectionDraft();
          var modifierDeltas = option.ComponentModifierGroups
            .SelectMany(group => group.Options)
            .SelectMany(modifier => Enumerable.Repeat(modifier.PriceDelta, ModifierCount(draft.ModifierIds, modifier.Id)))
            .ToArray();
          return new RestaurantComboPriceSelection(option.PriceDelta, option.Quantity, modifierDeltas);
        })
        .ToList();
    }
  }
  private IReadOnlyList<PriceSupplement> SelectedSupplements
  {
    get
    {
      if (selectedProduct is null) return [];
      if (selectedProduct.ProductKind != RestaurantProductKinds.Combo)
      {
        return selectedProduct.ModifierGroups
          .SelectMany(group => group.Options)
          .Where(option => selectedModifierIds.Contains(option.Id) && option.PriceDelta > 0)
          .Select(option => new PriceSupplement(
            SupplementName(option.Name, ModifierCount(selectedModifierIds, option.Id)),
            option.PriceDelta * ModifierCount(selectedModifierIds, option.Id)))
          .ToList();
      }
      var supplements = new List<PriceSupplement>();
      foreach (var slot in selectedProduct.ComboSlots)
      {
        foreach (var option in slot.Options.Where(option => IsComboOptionSelected(slot.Id, option.Id)))
        {
          if (option.PriceDelta > 0)
          {
            supplements.Add(new(
              $"{slot.Name} · {option.ComponentProductName}",
              RestaurantComboPricingRules.CalculateUnitSupplement(
                [new RestaurantComboPriceSelection(option.PriceDelta, option.Quantity, [])])));
          }
          var draft = GetComponentDraft(slot.Id, option.Id);
          supplements.AddRange(option.ComponentModifierGroups.SelectMany(group => group.Options)
            .Where(modifier => draft.ModifierIds.Contains(modifier.Id) && modifier.PriceDelta > 0)
            .Select(modifier => new PriceSupplement(
              $"{option.ComponentProductName} · {SupplementName(modifier.Name, ModifierCount(draft.ModifierIds, modifier.Id))}",
              RestaurantComboPricingRules.CalculateUnitSupplement(
                [new RestaurantComboPriceSelection(0, option.Quantity, Enumerable.Repeat(modifier.PriceDelta, ModifierCount(draft.ModifierIds, modifier.Id)).ToArray())]))));
        }
      }
      return supplements;
    }
  }
  private bool CanSavePersonalization
  {
    get
    {
      if (selectedProduct is null || selectedProductNotes?.Length > 500) return false;
      if (selectedProduct.ProductKind != RestaurantProductKinds.Combo)
      {
        return selectedProduct.ModifierGroups.All(group => ModifierSelectionIsValid(group, selectedModifierIds));
      }
      return selectedProduct.ComboSlots.Where(slot => slot.IsActive).All(ComboSlotIsValid)
        && selectedProduct.ComboSlots.SelectMany(slot => slot.Options.Where(option => IsComboOptionSelected(slot.Id, option.Id)))
          .All(option => GetComponentDraftForOption(option) is { } draft
            && (draft.Notes is null || draft.Notes.Length <= 500)
            && option.ComponentModifierGroups.All(group => ModifierSelectionIsValid(group, draft.ModifierIds)));
    }
  }
  private IReadOnlyList<string> PersonalizationAllergens
  {
    get
    {
      if (selectedProduct is null) return [];
      if (selectedProduct.ProductKind != RestaurantProductKinds.Combo) return selectedProduct.Allergens;
      return selectedProduct.ComboSlots.SelectMany(slot => slot.Options)
        .Where(option => selectedProduct.ComboSlots.Any(slot => slot.Options.Contains(option) && IsComboOptionSelected(slot.Id, option.Id)))
        .SelectMany(option => option.Allergens)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(item => item)
        .ToList();
    }
  }
