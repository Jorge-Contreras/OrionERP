@page "/restaurante/recetas"
@attribute [Authorize(Policy = "RestaurantAdmin")]
@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization
@using OrionERP.Application.Features.Logistica.Materials
@using OrionERP.Application.Features.Logistica.Shared
@using OrionERP.Application.Features.Restaurante
@using OrionERP.Web.State
@inject IBomRecipeService BomService
@inject IMaterialService MaterialService
@inject IUserRfcState RfcState
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Restaurante · Recetas y BOM</PageTitle>

<style>
  .recipe-safety{display:grid;gap:.35rem;margin:0 0 1rem;font-weight:800}.recipe-safety textarea{border:1px solid #cfd9d6;border-radius:.7rem;padding:.65rem}
  .recipe-master-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;min-width:0;margin-top:1rem}.recipe-master-fields{display:grid;gap:.65rem;min-width:0}.recipe-master-fields>label{display:grid;gap:.25rem;min-width:0;font-size:.8rem;font-weight:800}.recipe-master-fields input,.recipe-master-fields select{min-height:2.7rem;min-width:0;width:100%;border:1px solid #ccd7d3;border-radius:.65rem;padding:.5rem;background:#fff}.recipe-allergens{display:grid;grid-template-columns:repeat(auto-fit,minmax(145px,1fr));gap:.4rem}.recipe-allergens label{display:flex;align-items:center;gap:.4rem;padding:.5rem;border-radius:.55rem;background:#f2f6f4}.recipe-master-list{display:grid;gap:.35rem;max-height:260px;overflow:auto;margin-top:.7rem}.recipe-master-list button{display:flex;justify-content:space-between;align-items:center;gap:.6rem;border:1px solid #dbe3e0;border-radius:.65rem;background:#fff;padding:.6rem;text-align:left}.recipe-master-list small{color:#687771}.recipe-card details{margin-top:.8rem}.recipe-card summary{cursor:pointer;font-weight:850;color:#246c58}@@media(max-width:900px){.recipe-master-grid{grid-template-columns:minmax(0,1fr)}}
</style>

<main class="recipe-shell">
  <header class="recipe-hero"><div><span>Ingeniería de menú</span><h1>Recetas y BOM</h1><p>Versiones inmutables, rendimiento, unidades, desperdicio y pasos de preparación.</p></div><button type="button" class="btn btn-light" @onclick="NewDraft">Nueva receta</button></header>
  @if (!string.IsNullOrWhiteSpace(message)) { <div class="alert @(isError ? "alert-danger" : "alert-success")">@message</div> }
  <section class="recipe-layout">
    <aside class="recipe-list">
      <header><strong>Versiones</strong><button type="button" @onclick="LoadAsync"><span class="oi oi-reload"></span></button></header>
      @foreach (var version in versions)
      {
        <button type="button" class="@(editor.BomVersionId == version.Id ? "is-active" : null)" @onclick="() => EditAsync(version.Id)"><span><strong>@version.ProductName</strong><small>v@version.VersionNumber · @version.YieldQuantity.ToString("0.####")</small></span><b class="recipe-status recipe-status--@version.Status.ToLowerInvariant()">@version.Status</b></button>
      }
      @if (versions.Count == 0) { <p>Sin recetas. Crea la primera a partir de un producto terminado.</p> }
    </aside>

    <section class="recipe-editor">
      <div class="recipe-editor__top">
        <RestaurantMaterialPicker Label="Producto terminado"
                                  Options="@materialOptions"
                                  @bind-Value="editor.ProductMaterialId"
                                  Disabled="@editor.BomVersionId.HasValue"
                                  Placeholder="Buscar producto terminado…" />
        <label>Rendimiento<input type="number" min="0.0001" step="0.0001" @bind="editor.YieldQuantity" /></label>
        <label>Unidad<select @bind="editor.YieldUnitId"><option value="0">Seleccionar…</option>@foreach (var unit in catalog.Units) { <option value="@unit.Id">@unit.Name</option> }</select></label>
        <label>Merma esperada %<input type="number" min="0" max="100" step="0.1" @bind="editor.ExpectedWastePercent" /></label>
      </div>
      <label class="recipe-safety">Notas de seguridad<textarea rows="2" maxlength="2000" @bind="editor.SafetyNotes"></textarea></label>

      <article class="recipe-card">
        <header><div><span>Lista de materiales</span><h2>Ingredientes y subrecetas</h2></div><button type="button" class="btn btn-outline-primary btn-sm" @onclick="AddComponent">Agregar ingrediente</button></header>
        <div class="recipe-table">
          <div class="recipe-table__head"><span>Material</span><span>Cantidad</span><span>Unidad</span><span>Merma %</span><span></span></div>
          @foreach (var component in editor.Components)
          {
            <div class="recipe-table__row"><RestaurantMaterialPicker Options="@materialOptions" @bind-Value="component.MaterialId" Compact="true" Placeholder="Buscar ingrediente…" /><input type="number" min="0.000001" step="0.0001" @bind="component.Quantity" /><select @bind="component.UnitId"><option value="0">Unidad…</option>@foreach (var unit in catalog.Units) { <option value="@unit.Id">@unit.Code</option> }</select><input type="number" min="0" max="100" step="0.1" @bind="component.ExpectedWastePercent" /><button type="button" aria-label="Eliminar" @onclick="() => editor.Components.Remove(component)">×</button></div>
          }
        </div>
      </article>

      <article class="recipe-card">
        <header><div><span>Método</span><h2>Pasos de preparación</h2></div><button type="button" class="btn btn-outline-primary btn-sm" @onclick="AddStep">Agregar paso</button></header>
        <div class="recipe-steps">
          @foreach (var step in editor.Steps.OrderBy(item => item.StepNumber))
          {
            <div class="recipe-step"><b>@step.StepNumber</b><label>Instrucción<textarea rows="2" @bind="step.Instruction"></textarea></label><label>Minutos<input type="number" min="0" @bind="step.DurationMinutes" /></label><label>°C<input type="number" step="0.1" @bind="step.TemperatureC" /></label><label>Equipo<input @bind="step.Equipment" /></label><label>Imagen<InputFile OnChange="args => CaptureStepImageAsync(step, args)" accept="image/*" /><small>@step.ImageFileName</small></label><button type="button" @onclick="() => editor.Steps.Remove(step)">×</button></div>
          }
        </div>
      </article>

      <footer class="recipe-actions"><button type="button" class="btn btn-primary" disabled="@isBusy" @onclick="SaveAsync">Guardar borrador</button>@if (selectedStatus == "Draft" && editor.BomVersionId.HasValue) { <button type="button" class="btn btn-success" disabled="@isBusy" @onclick="ActivateAsync">Activar versión</button> }<span>Las versiones activas no se editan; una corrección crea una nueva versión.</span></footer>
    </section>
  </section>

  <section class="recipe-master-grid">
    <article class="recipe-card">
      <header><div><span>Seguridad alimentaria</span><h2>Alérgenos por material</h2></div></header>
      <div class="recipe-master-fields">
        <RestaurantMaterialPicker Label="Material"
                                  Options="@materialOptions"
                                  @bind-Value="allergenMaterialId"
                                  Changed="@(_ => LoadMaterialAllergens())" />
        <div class="recipe-allergens">@foreach (var allergen in allergens.Where(item => item.IsActive)) { <label><input type="checkbox" checked="@selectedAllergenIds.Contains(allergen.Id)" @onchange="() => ToggleAllergen(allergen.Id)" /> @allergen.Name</label> }</div>
        <button type="button" class="btn btn-primary" disabled="@(isBusy || allergenMaterialId == 0)" @onclick="SaveMaterialAllergensAsync">Guardar asignación</button>
      </div>
      <details>
        <summary>Administrar catálogo global de alérgenos</summary>
        <div class="recipe-master-fields"><label>Código<input @bind="allergenEditor.Code" /></label><label>Nombre<input @bind="allergenEditor.Name" /></label><label><input type="checkbox" @bind="allergenEditor.IsActive" /> Activo</label><div><button type="button" class="btn btn-outline-secondary" @onclick="NewAllergen">Nuevo</button><button type="button" class="btn btn-primary" @onclick="SaveAllergenAsync">Guardar</button></div></div>
        <div class="recipe-master-list">@foreach (var allergen in allergens) { <button type="button" @onclick="() => EditAllergen(allergen)"><strong>@allergen.Name</strong><small>@allergen.Code · @(allergen.IsActive ? "Activo" : "Inactivo")</small></button> }</div>
      </details>
    </article>

    <article class="recipe-card">
      <header><div><span>Paquetes y porciones</span><h2>Conversiones especiales</h2></div><button type="button" class="btn btn-outline-primary btn-sm" @onclick="NewConversion">Nueva</button></header>
      <div class="recipe-master-fields">
        <RestaurantMaterialPicker Label="Material"
                                  Options="@materialOptions"
                                  @bind-Value="conversionEditor.MaterialId" />
        <label>Desde<select @bind="conversionEditor.FromUnitId"><option value="0">Unidad…</option>@foreach (var unit in catalog.Units) { <option value="@unit.Id">@unit.Code</option> }</select></label>
        <label>Hacia unidad base<select @bind="conversionEditor.ToUnitId"><option value="0">Unidad…</option>@foreach (var unit in catalog.Units) { <option value="@unit.Id">@unit.Code</option> }</select></label>
        <label>Factor<input type="number" min="0.0000000001" step="0.0001" @bind="conversionEditor.Factor" /></label>
        <label>Notas<input @bind="conversionEditor.Notes" placeholder="Ej. una bolsa contiene 12 piezas" /></label>
        <label><input type="checkbox" @bind="conversionEditor.IsActive" /> Activa</label>
        <button type="button" class="btn btn-primary" disabled="@isBusy" @onclick="SaveConversionAsync">Guardar conversión</button>
      </div>
      <div class="recipe-master-list">@foreach (var conversion in conversions) { <button type="button" @onclick="() => EditConversion(conversion)"><strong>@conversion.MaterialName</strong><small>1 @conversion.FromUnitCode = @conversion.Factor.ToString("0.########") @conversion.ToUnitCode · @(conversion.IsActive ? "Activa" : "Inactiva")</small></button> }</div>
    </article>
  </section>
</main>

@code {
  private List<BomVersionDto> versions = [];
  private List<MaterialListItemDto> materials = [];
  private IReadOnlyList<RestaurantMaterialOption> materialOptions = [];
  private MaterialCatalogDto catalog = new();
  private List<RestaurantAllergenDto> allergens = [];
  private List<MaterialUnitConversionDto> conversions = [];
  private BomDraftSaveRequest editor = NewEditor();
  private RestaurantAllergenSaveRequest allergenEditor = new() { IsActive = true };
  private MaterialUnitConversionSaveRequest conversionEditor = new() { IsActive = true, Factor = 1 };
  private readonly HashSet<int> selectedAllergenIds = [];
  private int allergenMaterialId;
  private string? selectedStatus;
  private string? message;
  private bool isError;
  private bool isBusy;
  private string CurrentRfc => LogisticsRfc.Require(RfcState.CurrentRfc);
  protected override async Task OnInitializedAsync() { RfcState.Changed += OnRfcChanged; await LoadAsync(); }
  private async Task LoadAsync()
  {
    isBusy = true;
    try { versions = (await BomService.GetBomVersionsAsync(CurrentRfc)).ToList(); materials = (await MaterialService.GetMaterialsAsync(new() { Rfc = CurrentRfc, Status = "ACTIVO", Take = 0 })).ToList(); materialOptions = RestaurantMaterialOption.FromMaterials(materials); catalog = await MaterialService.GetCatalogAsync(CurrentRfc); allergens = (await BomService.GetAllergensAsync(CurrentRfc)).ToList(); conversions = (await BomService.GetMaterialUnitConversionsAsync(CurrentRfc)).ToList(); if (allergenMaterialId > 0) LoadMaterialAllergens(); }
    catch (Exception ex) { Show(ex.Message, true); }
    finally { isBusy = false; }
  }
  private void NewDraft() { editor = NewEditor(); editor.Rfc = CurrentRfc; editor.YieldUnitId = catalog.Units.FirstOrDefault()?.Id ?? 0; selectedStatus = "Draft"; }
  private async Task EditAsync(long id)
  {
    var detail = await BomService.GetBomVersionAsync(CurrentRfc, id); if (detail is null) return;
    if (detail.Status != "Draft") { Show("La versión seleccionada es de sólo lectura. Use Nueva receta para generar la siguiente versión.", false); }
    editor = new() { Rfc = CurrentRfc, BomVersionId = detail.Status == "Draft" ? detail.Id : null, ProductMaterialId = detail.ProductMaterialId, YieldQuantity = detail.YieldQuantity, YieldUnitId = detail.YieldUnitId, ExpectedWastePercent = detail.ExpectedWastePercent, SafetyNotes = detail.SafetyNotes, Components = detail.Components.Select(item => new BomComponentSaveRequest { MaterialId = item.MaterialId, Quantity = item.Quantity, UnitId = item.UnitId, ExpectedWastePercent = item.ExpectedWastePercent }).ToList(), Steps = detail.Steps.Select(item => new RecipeStepSaveRequest { StepNumber = item.StepNumber, Instruction = item.Instruction, DurationMinutes = item.DurationMinutes, TemperatureC = item.TemperatureC, Equipment = item.Equipment, Image = item.Image, ImageFileName = item.ImageFileName, ImageContentType = item.ImageContentType }).ToList() };
    selectedStatus = detail.Status;
  }
  private void AddComponent() => editor.Components.Add(new() { UnitId = catalog.Units.FirstOrDefault()?.Id ?? 0, Quantity = 1 });
  private void AddStep() => editor.Steps.Add(new() { StepNumber = editor.Steps.Count == 0 ? 1 : editor.Steps.Max(item => item.StepNumber) + 1 });
  private async Task CaptureStepImageAsync(RecipeStepSaveRequest step, InputFileChangeEventArgs args) { var image = await args.File.RequestImageFileAsync("image/jpeg", 1200, 1200); await using var stream = image.OpenReadStream(5 * 1024 * 1024); using var memory = new MemoryStream(); await stream.CopyToAsync(memory); step.Image = memory.ToArray(); step.ImageFileName = Path.ChangeExtension(args.File.Name, ".jpg"); step.ImageContentType = "image/jpeg"; }
  private async Task SaveAsync() { await RunAsync(async () => await BomService.SaveDraftAsync(editor)); }
  private async Task ActivateAsync() { if (!editor.BomVersionId.HasValue) return; var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync(); await RunAsync(async () => await BomService.ActivateAsync(CurrentRfc, editor.BomVersionId.Value, auth.User.Identity?.Name ?? "restaurante")); }
  private async Task RunAsync(Func<Task<RestaurantCommandResult>> action) { isBusy = true; try { editor.Rfc = CurrentRfc; var result = await action(); Show(result.Message, !result.Success); if (result.Success) { await LoadAsync(); if (result.EntityId.HasValue) await EditAsync(result.EntityId.Value); } } catch (Exception ex) { Show(ex.Message, true); } finally { isBusy = false; } }
  private void LoadMaterialAllergens() { selectedAllergenIds.Clear(); foreach (var allergen in allergens.Where(item => item.MaterialIds.Contains(allergenMaterialId))) selectedAllergenIds.Add(allergen.Id); }
  private void ToggleAllergen(int id) { if (!selectedAllergenIds.Remove(id)) selectedAllergenIds.Add(id); }
  private async Task SaveMaterialAllergensAsync() => await RunMasterAsync(() => BomService.SaveMaterialAllergensAsync(CurrentRfc, allergenMaterialId, selectedAllergenIds));
  private void NewAllergen() => allergenEditor = new() { IsActive = true };
  private void EditAllergen(RestaurantAllergenDto item) => allergenEditor = new() { Id = item.Id, Code = item.Code, Name = item.Name, IsActive = item.IsActive };
  private async Task SaveAllergenAsync() => await RunMasterAsync(() => BomService.SaveAllergenAsync(allergenEditor));
  private void NewConversion() => conversionEditor = new() { Rfc = CurrentRfc, IsActive = true, Factor = 1 };
  private void EditConversion(MaterialUnitConversionDto item) => conversionEditor = new() { Rfc = CurrentRfc, Id = item.Id, MaterialId = item.MaterialId, FromUnitId = item.FromUnitId, ToUnitId = item.ToUnitId, Factor = item.Factor, Notes = item.Notes, IsActive = item.IsActive };
  private async Task SaveConversionAsync() { conversionEditor.Rfc = CurrentRfc; await RunMasterAsync(() => BomService.SaveMaterialUnitConversionAsync(conversionEditor)); }
  private async Task RunMasterAsync(Func<Task<RestaurantCommandResult>> action) { isBusy = true; try { var result = await action(); Show(result.Message, !result.Success); if (result.Success) await LoadAsync(); } catch (Exception ex) { Show(ex.Message, true); } finally { isBusy = false; } }
  private void Show(string value, bool error) { message = value; isError = error; }
  private void OnRfcChanged() => _ = InvokeAsync(async () => { NewDraft(); await LoadAsync(); StateHasChanged(); });
  public void Dispose() => RfcState.Changed -= OnRfcChanged;
  private static BomDraftSaveRequest NewEditor() => new() { YieldQuantity = 1, Components = [new() { Quantity = 1 }], Steps = [new() { StepNumber = 1 }] };
}
