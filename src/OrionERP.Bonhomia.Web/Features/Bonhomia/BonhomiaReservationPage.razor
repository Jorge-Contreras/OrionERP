@page "/reservar"
@using System.Globalization
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Microsoft.JSInterop
@using Microsoft.Extensions.Options
@using OrionERP.Application.Features.Bonhomia.PublicBooking
@using OrionERP.Application.Features.Reservaciones.Experiencias
@using OrionERP.Bonhomia.Web.Features.Bonhomia.Checkout
@implements IAsyncDisposable
@inject IBonhomiaPublicBookingService BookingService
@inject IBonhomiaQuoteTokenService QuoteTokenService
@inject IOptions<BonhomiaCheckoutOptions> CheckoutOptions
@inject ProtectedSessionStorage SessionStorage
@inject IJSRuntime Js

<PageTitle>Bonhomia Suites | Reservas en Calpulalpan</PageTitle>
<HeadContent>
    <meta name="description" content="Bonhomia Suites: reserva directa en Calpulalpan, Tlaxcala. Consulta disponibilidad, genera cotizacion y paga en linea con PayPal." />
</HeadContent>

<main class="bonhomia-site bonhomia-reservation-page">
        <section id="reserva" class="bonhomia-booking bonhomia-checkout" aria-labelledby="booking-title">
            <div class="bonhomia-booking__intro">
                <p class="bonhomia-eyebrow">Reserva directa</p>
                <h1 id="booking-title">Elige fechas, genera tu cotizacion y paga con PayPal</h1>
                <p>La cotizacion vive solo durante tu sesion. La reservacion se crea hasta que PayPal confirma el pago completo.</p>
            </div>

            @if (IsLoadingAvailability)
            {
                <div class="bonhomia-loading">
                    <i class="bi bi-arrow-repeat" aria-hidden="true"></i>
                    <span>Cargando disponibilidad...</span>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(AvailabilityError))
            {
                <div class="bonhomia-alert bonhomia-alert--error">
                    <strong>No pudimos cargar el calendario.</strong>
                    <span>@AvailabilityError</span>
                    <a href="@WhatsAppUrl" target="_blank" rel="noopener noreferrer">Contactar por WhatsApp</a>
                </div>
            }
            else if (Availability is not null)
            {
                <div class="bonhomia-wizard">
                    <ol class="bonhomia-wizard__steps" aria-label="Progreso de reserva">
                        @foreach (var step in WizardSteps)
                        {
                            <li class="@GetWizardStepClass(step.Step)">
                                <button type="button"
                                        disabled="@(!CanNavigateToStep(step.Step))"
                                        @onclick="() => GoToStepAsync(step.Step)">
                                    <span>@(((int)step.Step) + 1)</span>
                                    <strong>@step.Title</strong>
                                    <small>@step.Detail</small>
                                </button>
                            </li>
                        }
                    </ol>

                    <div class="bonhomia-wizard__panel" aria-live="polite">
                        @if (!string.IsNullOrWhiteSpace(CheckoutError))
                        {
                            <div class="bonhomia-alert bonhomia-alert--error">@CheckoutError</div>
                        }

                        @if (ActiveCheckoutStep == CheckoutStep.Dates)
                        {
                            <div class="bonhomia-step">
                                <div class="bonhomia-step__header">
                                    <span>1</span>
                                    <div>
                                        <h3>Fechas</h3>
                                        <p>Marca llegada/salida en el calendario y confirma cuantos huespedes viajan.</p>
                                    </div>
                                </div>

                                <div class="bonhomia-date-row">
                                    <label>
                                        <span>Check-in</span>
                                        <input type="date" value="@CheckInText" min="@TodayText" @onchange="OnCheckInChanged" />
                                    </label>
                                    <label>
                                        <span>Check-out</span>
                                        <input type="date" value="@CheckOutText" min="@MinCheckOutText" @onchange="OnCheckOutChanged" />
                                    </label>
                                    <label>
                                        <span>Huespedes</span>
                                        <input type="number" min="1" max="10" value="@Guests" @onchange="OnGuestsChanged" />
                                    </label>
                                </div>

                                @if (Availability.Rooms.Count > 0)
                                {
                                    <div class="bonhomia-calendar-shell">
                                        <div class="bonhomia-calendar-toolbar" aria-label="Navegacion de calendario">
                                            <button type="button"
                                                    class="bonhomia-calendar-nav"
                                                    disabled="@(!CanNavigateCalendarBack)"
                                                    title="Meses anteriores"
                                                    @onclick="ShowPreviousCalendarMonths">
                                                <i class="bi bi-chevron-left" aria-hidden="true"></i>
                                                <span>Anterior</span>
                                            </button>
                                            <strong>@CalendarWindowLabel</strong>
                                            <button type="button"
                                                    class="bonhomia-calendar-nav"
                                                    disabled="@(!CanNavigateCalendarForward)"
                                                    title="Meses siguientes"
                                                    @onclick="ShowNextCalendarMonths">
                                                <span>Siguiente</span>
                                                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                                            </button>
                                        </div>
                                        <div class="bonhomia-calendar" aria-label="Calendario publico de disponibilidad">
                                        @foreach (var month in MonthGroups)
                                        {
                                            <div class="bonhomia-month">
                                                <h4>@month.Month.ToString("MMMM yyyy", HeaderCulture)</h4>
                                                <div class="bonhomia-weekdays" aria-hidden="true">
                                                    <span>Dom</span><span>Lun</span><span>Mar</span><span>Mie</span><span>Jue</span><span>Vie</span><span>Sab</span>
                                                </div>
                                                <div class="bonhomia-days">
                                                    @for (var blank = 0; blank < month.Offset; blank++)
                                                    {
                                                        <span class="bonhomia-day bonhomia-day--blank"></span>
                                                    }
                                                    @foreach (var day in month.Days)
                                                    {
                                                        var state = GetCalendarDayState(day);
                                                        <button type="button"
                                                                class="@GetCalendarDayClass(day, state)"
                                                                disabled="@(state == DayState.Past || state == DayState.Unavailable)"
                                                                title="@GetCalendarDayTitle(day, state)"
                                                                @onclick="() => SelectCalendarDay(day)">
                                                            <span>@day.Day</span>
                                                        </button>
                                                    }
                                                </div>
                                            </div>
                                        }
                                        </div>
                                    </div>
                                }

                                <div class="bonhomia-wizard__actions bonhomia-wizard__actions--bottom">
                                    <span></span>
                                    <button type="button" class="bonhomia-button bonhomia-button--next" @onclick="GoNextAsync">
                                        <span>Continuar a suites</span>
                                        <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </div>
                        }
                        else if (ActiveCheckoutStep == CheckoutStep.Suite)
                        {
                            <div class="bonhomia-step">
                                <div class="bonhomia-step__header">
                                    <span>2</span>
                                    <div>
                                        <h3>Suite</h3>
                                        <p>Elige una suite disponible para las fechas seleccionadas.</p>
                                    </div>
                                </div>

                                <div class="bonhomia-room-picker" role="list" aria-label="Suites disponibles">
                                    @foreach (var room in Availability.Rooms)
                                    {
                                        var unavailableDates = GetUnavailableSuiteDates(room);
                                        var isAvailableForStay = unavailableDates.Count == 0;
                                        var selected = string.Equals(room.RoomName, SelectedRoomName, StringComparison.OrdinalIgnoreCase);
                                        <div class="@GetRoomOptionClass(selected, isAvailableForStay)" role="listitem">
                                            <button type="button"
                                                    class="bonhomia-room-option__select"
                                                    disabled="@(!isAvailableForStay)"
                                                    title="@GetRoomOptionTitle(room, unavailableDates)"
                                                    aria-pressed="@selected"
                                                    @onclick="() => SelectRoom(room.RoomName)">
                                                <div class="bonhomia-room-option__media">
                                                    <img src="@room.Image" alt="@room.RoomName" />
                                                    @if (selected)
                                                    {
                                                        <span class="bonhomia-room-option__selected-badge">
                                                            <i class="bi bi-check2-circle" aria-hidden="true"></i>
                                                            <span>Seleccionada</span>
                                                        </span>
                                                    }
                                                </div>
                                                <span>@room.Tag</span>
                                                <strong>@room.RoomName</strong>
                                                <small>@room.Capacity huesped@(room.Capacity == 1 ? string.Empty : "es") · @FormatBedroomCount(room.Bedrooms) · @FormatBathroomCount(room.Bathrooms) · desde @FormatMoney(room.BasePrice)</small>
                                                <small class="@(isAvailableForStay ? "bonhomia-room-option__status bonhomia-room-option__status--available" : "bonhomia-room-option__status bonhomia-room-option__status--blocked")">
                                                    @(isAvailableForStay ? "Disponible para tus fechas" : GetUnavailableSuiteNote(unavailableDates))
                                                </small>
                                            </button>
                                            <button type="button"
                                                    class="bonhomia-room-option__photos"
                                                    title="@($"Ver fotos de {room.RoomName}")"
                                                    @onclick="() => OpenSuiteGallery(room.RoomName)">
                                                <i class="bi bi-images" aria-hidden="true"></i>
                                                <span>Fotos</span>
                                            </button>
                                        </div>
                                    }
                                </div>

                                <div class="bonhomia-wizard__actions bonhomia-wizard__actions--bottom">
                                    <button type="button" class="bonhomia-button bonhomia-button--outline" @onclick="GoBackAsync">
                                        <i class="bi bi-arrow-left" aria-hidden="true"></i>
                                        <span>Atras</span>
                                    </button>
                                    <button type="button" class="bonhomia-button bonhomia-button--next" @onclick="GoNextAsync">
                                        <span>Continuar a experiencias</span>
                                        <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </div>
                        }
                        else if (ActiveCheckoutStep == CheckoutStep.Experiences)
                        {
                            <div class="bonhomia-step">
                                <div class="bonhomia-step__header">
                                    <span>3</span>
                                    <div>
                                        <h3>Experiencias</h3>
                                        <p>Agrega una experiencia de temporada a tu estancia o continua sin experiencias.</p>
                                    </div>
                                </div>

                                @if (PrimaryExperience is null)
                                {
                                    <div class="bonhomia-alert bonhomia-alert--warning">
                                        No hay experiencias publicas disponibles para las fechas seleccionadas.
                                    </div>
                                }
                                else
                                {
                                    var preview = GetSelectedExperiencePreview();
                                    var totalExperienceParticipants = ExperienceAdultParticipants + ExperienceChildParticipants;
                                    var selectedExperienceAddOnCount = PrimaryExperience.AddOns.Count(addOn => SelectedExperienceAddOnCodes.Contains(addOn.Code));
                                    <section class="@(IncludeExperience ? "bonhomia-experience-card bonhomia-experience-card--active" : "bonhomia-experience-card")">
                                        <label class="bonhomia-experience-toggle">
                                            <span class="bonhomia-experience-toggle__copy">
                                                <span>Experiencia de temporada</span>
                                                <strong>@PrimaryExperience.Name</strong>
                                                <small>@FormatExperienceSeason(PrimaryExperience)</small>
                                            </span>
                                            <span class="bonhomia-switch">
                                                <input type="checkbox"
                                                       checked="@IncludeExperience"
                                                       aria-label="@($"Agregar {PrimaryExperience.Name}")"
                                                       @onchange="OnIncludeExperienceChanged" />
                                                <span class="bonhomia-switch__track"></span>
                                            </span>
                                        </label>

                                        <div class="bonhomia-experience-card__body">
                                            <div class="bonhomia-experience-provider">
                                                <i class="bi bi-stars" aria-hidden="true"></i>
                                                <div>
                                                    <strong>@PrimaryExperience.ProviderName</strong>
                                                    <span>@PrimaryExperience.Description</span>
                                                </div>
                                            </div>

                                            @if (!IncludeExperience)
                                            {
                                                <div class="bonhomia-experience-state">
                                                    <strong>Sin experiencia agregada</strong>
                                                    <span>@PrimaryExperience.Description</span>
                                                </div>
                                            }

                                            <details class="bonhomia-experience-section" open="@IncludeExperience">
                                                <summary>
                                                    <span class="bonhomia-experience-section__index">1</span>
                                                    <span>
                                                        <strong>Paquete y personas</strong>
                                                        <small>@(IncludeExperience ? $"{SelectedExperiencePackage?.Name ?? "Selecciona paquete"} · {totalExperienceParticipants} persona{(totalExperienceParticipants == 1 ? string.Empty : "s")}" : "Pendiente")</small>
                                                    </span>
                                                    <i class="bi bi-chevron-down" aria-hidden="true"></i>
                                                </summary>
                                                <div class="bonhomia-experience-section__content">
                                                    <div class="bonhomia-date-row">
                                                        <label>
                                                            <span>Fecha</span>
                                                            <input type="date"
                                                                   value="@ExperienceDateText"
                                                                   min="@ExperienceMinDateText"
                                                                   max="@ExperienceMaxDateText"
                                                                   disabled="@(!IncludeExperience)"
                                                                   @onchange="OnExperienceDateChanged" />
                                                        </label>
                                                        <label>
                                                            <span>Paquete</span>
                                                            <select value="@SelectedExperiencePackageCode" disabled="@(!IncludeExperience)" @onchange="OnExperiencePackageChanged">
                                                                @foreach (var package in PrimaryExperience.Packages)
                                                                {
                                                                    <option value="@package.Code">@package.Name - @FormatMoney(package.UnitPrice) + IVA por persona</option>
                                                                }
                                                            </select>
                                                        </label>
                                                        <label>
                                                            <span>Adultos</span>
                                                            <input type="number" min="1" max="@ExperienceParticipantLimit" value="@ExperienceAdultParticipants" disabled="@(!IncludeExperience)" @onchange="OnExperienceAdultParticipantsChanged" />
                                                        </label>
                                                        <label>
                                                            <span>Menores</span>
                                                            <input type="number" min="0" max="@(Math.Max(ExperienceParticipantLimit - ExperienceAdultParticipants, 0))" value="@ExperienceChildParticipants" disabled="@(!IncludeExperience)" @onchange="OnExperienceChildParticipantsChanged" />
                                                        </label>
                                                    </div>
                                                </div>
                                            </details>

                                            @if (PrimaryExperience.AddOns.Count > 0)
                                            {
                                                <details class="bonhomia-experience-section" open="@IncludeExperience">
                                                    <summary>
                                                        <span class="bonhomia-experience-section__index">2</span>
                                                        <span>
                                                            <strong>Complementos</strong>
                                                            <small>@(IncludeExperience ? $"{selectedExperienceAddOnCount} seleccionado{(selectedExperienceAddOnCount == 1 ? string.Empty : "s")}" : "Opcional")</small>
                                                        </span>
                                                        <i class="bi bi-chevron-down" aria-hidden="true"></i>
                                                    </summary>
                                                    <div class="bonhomia-experience-section__content">
                                                        <div class="bonhomia-experience-addons">
                                                            @foreach (var addOn in PrimaryExperience.AddOns)
                                                            {
                                                                var isSelected = SelectedExperienceAddOnCodes.Contains(addOn.Code);
                                                                <label class="@(isSelected ? "bonhomia-experience-addon bonhomia-experience-addon--selected" : "bonhomia-experience-addon")">
                                                                    <i class="bi bi-signpost-split" aria-hidden="true"></i>
                                                                    <span class="bonhomia-experience-addon__copy">
                                                                        <strong>@addOn.Name</strong>
                                                                        <span>@addOn.Description</span>
                                                                        <small>@FormatMoney(addOn.UnitPrice) + IVA @(addOn.AppliesPerParticipant ? "por persona" : null)</small>
                                                                    </span>
                                                                    <span class="bonhomia-switch bonhomia-switch--small">
                                                                        <input type="checkbox"
                                                                               checked="@isSelected"
                                                                               disabled="@(!IncludeExperience)"
                                                                               aria-label="@($"Agregar {addOn.Name}")"
                                                                               @onchange="args => OnExperienceAddOnChanged(addOn.Code, args)" />
                                                                        <span class="bonhomia-switch__track"></span>
                                                                    </span>
                                                                </label>
                                                            }
                                                        </div>
                                                    </div>
                                                </details>
                                            }

                                            @if (IncludeExperience && preview is not null)
                                            {
                                                <div class="bonhomia-experience-total">
                                                    <div>
                                                        <span>Paquete antes de IVA</span>
                                                        <strong>@FormatMoney(preview.PackageSubtotal)</strong>
                                                    </div>
                                                    @if (preview.AddOnsTotal > 0m)
                                                    {
                                                        <div>
                                                            <span>Complementos antes de IVA</span>
                                                            <strong>@FormatMoney(preview.AddOnsTotal)</strong>
                                                        </div>
                                                    }
                                                    <div class="bonhomia-experience-total__grand">
                                                        <span>Subtotal experiencia</span>
                                                        <strong>@FormatMoney(preview.Total)</strong>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </section>
                                }

                                <div class="bonhomia-wizard__actions bonhomia-wizard__actions--bottom">
                                    <button type="button" class="bonhomia-button bonhomia-button--outline" @onclick="GoBackAsync">
                                        <i class="bi bi-arrow-left" aria-hidden="true"></i>
                                        <span>Atras</span>
                                    </button>
                                    <button type="button" class="bonhomia-button bonhomia-button--next" @onclick="GoNextAsync">
                                        <span>Continuar a extras</span>
                                        <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </div>
                        }
                        else if (ActiveCheckoutStep == CheckoutStep.Extras)
                        {
                            <div class="bonhomia-step">
                                <div class="bonhomia-step__header">
                                    <span>4</span>
                                    <div>
                                        <h3>Extras</h3>
                                        <p>Agrega servicios opcionales o continua sin extras.</p>
                                    </div>
                                </div>

                                <div class="bonhomia-extra-selector">
                                    @foreach (var extra in Availability.Extras)
                                    {
                                        <article>
                                            <i class="@extra.Icon" aria-hidden="true"></i>
                                            <div>
                                                <strong>@extra.Name</strong>
                                                <span>@extra.Detail</span>
                                                <small>@FormatMoney(extra.UnitPrice)</small>
                                            </div>
                                            <select value="@GetExtraQuantity(extra.Code)" @onchange="args => OnExtraQuantityChanged(extra.Code, args)">
                                                @for (var quantity = 0; quantity <= extra.MaxQuantity; quantity++)
                                                {
                                                    <option value="@quantity">@quantity</option>
                                                }
                                            </select>
                                        </article>
                                    }
                                </div>

                                <div class="bonhomia-wizard__actions bonhomia-wizard__actions--bottom">
                                    <button type="button" class="bonhomia-button bonhomia-button--outline" @onclick="GoBackAsync">
                                        <i class="bi bi-arrow-left" aria-hidden="true"></i>
                                        <span>Atras</span>
                                    </button>
                                    <button type="button"
                                            class="bonhomia-button bonhomia-button--next"
                                            disabled="@IsQuoteBusy"
                                            @onclick="GenerateQuoteAsync">
                                        <i class="bi bi-receipt" aria-hidden="true"></i>
                                        <span>@(IsQuoteBusy ? "Generando..." : "Continuar al pago")</span>
                                    </button>
                                </div>
                            </div>
                        }
                        else if (ActiveCheckoutStep == CheckoutStep.Payment)
                        {
                            <div class="bonhomia-step">
                                <div class="bonhomia-step__header">
                                    <span>5</span>
                                    <div>
                                        <h3>Pago y confirmacion</h3>
                                        <p>Acepta los terminos y paga con PayPal. La reservacion se crea cuando PayPal confirma el pago.</p>
                                    </div>
                                </div>

                                @if (CompletedReservation is not null)
                                {
                                    <section id="@PaymentConfirmationPanelId" class="bonhomia-confirmation" tabindex="-1" aria-live="assertive" aria-label="Reservacion confirmada">
                                        <div class="bonhomia-confirmation__hero">
                                            <div class="bonhomia-confirmation__icon">
                                                <i class="bi bi-check2-circle" aria-hidden="true"></i>
                                            </div>
                                            <div>
                                                <span>Pago confirmado por PayPal</span>
                                                <h3>Reservacion confirmada @FormatReservationNumber(CompletedReservation.ReservationId)</h3>
                                                <p>Gracias, @CompletedReservation.ClientName. Tu estancia quedo registrada y pagada por @FormatMoney(CompletedReservation.Total).</p>
                                            </div>
                                        </div>

                                        <div class="bonhomia-confirmation__numbers" aria-label="Numeros de confirmacion">
                                            <article>
                                                <span>Reservacion</span>
                                                <strong>@FormatReservationNumber(CompletedReservation.ReservationId)</strong>
                                            </article>
                                            <article>
                                                <span>Transaccion OrionERP</span>
                                                <strong>@FormatReservationNumber(CompletedReservation.TransaccionId)</strong>
                                            </article>
                                            <article>
                                                <span>Numero PayPal</span>
                                                <strong>@DisplayValue(CompletedReservation.PayPalOrderId)</strong>
                                            </article>
                                            <article>
                                                <span>Captura PayPal</span>
                                                <strong>@DisplayValue(CompletedReservation.PayPalCaptureId)</strong>
                                            </article>
                                        </div>

                                        <div class="bonhomia-confirmation__grid">
                                            <article class="bonhomia-confirmation__panel">
                                                <h4>Estancia</h4>
                                                <dl>
                                                    <div><dt>Suite</dt><dd>@DisplayValue(CompletedReservation.RoomName)</dd></div>
                                                    <div><dt>Check-in</dt><dd>@FormatFullDate(CompletedReservation.CheckIn)</dd></div>
                                                    <div><dt>Check-out</dt><dd>@FormatFullDate(CompletedReservation.CheckOut)</dd></div>
                                                    <div><dt>Noches</dt><dd>@CompletedReservation.Nights</dd></div>
                                                    <div><dt>Huespedes</dt><dd>@CompletedReservation.Guests</dd></div>
                                                </dl>
                                            </article>

                                            <article class="bonhomia-confirmation__panel">
                                                <h4>Pago PayPal</h4>
                                                <dl>
                                                    <div><dt>Estatus de captura</dt><dd>@DisplayValue(CompletedReservation.PayPalStatus)</dd></div>
                                                    <div><dt>Estatus de orden</dt><dd>@DisplayValue(CompletedReservation.PayPalOrderStatus)</dd></div>
                                                    <div><dt>Correo PayPal</dt><dd>@DisplayValue(CompletedReservation.PayPalPayerEmail)</dd></div>
                                                    <div><dt>Monto capturado</dt><dd>@FormatMoney(CompletedReservation.PayPalAmount)</dd></div>
                                                    <div><dt>Confirmado</dt><dd>@FormatConfirmationTime(CompletedReservation.ConfirmedAtUtc)</dd></div>
                                                    @if (!string.IsNullOrWhiteSpace(CompletedReservation.PayPalStatusReason))
                                                    {
                                                        <div><dt>Detalle PayPal</dt><dd>@CompletedReservation.PayPalStatusReason</dd></div>
                                                    }
                                                </dl>
                                            </article>

                                            <article class="bonhomia-confirmation__panel">
                                                <h4>Contacto</h4>
                                                <dl>
                                                    <div><dt>Nombre</dt><dd>@DisplayValue(CompletedReservation.ClientName)</dd></div>
                                                    <div><dt>Correo</dt><dd>@DisplayValue(CompletedReservation.CustomerEmail)</dd></div>
                                                    <div><dt>Telefono</dt><dd>@DisplayValue(CompletedReservation.CustomerPhone)</dd></div>
                                                </dl>
                                            </article>

                                            <article class="bonhomia-confirmation__panel">
                                                <h4>Siguientes pasos</h4>
                                                <ul>
                                                    <li>Presenta este numero de reservacion al llegar: <strong>@FormatReservationNumber(CompletedReservation.ReservationId)</strong>.</li>
                                                    <li>El check-in inicia a las 15:00 hrs y el check-out termina a las 12:00 hrs.</li>
                                                    <li>Conserva el numero PayPal para cualquier aclaracion: <strong>@DisplayValue(CompletedReservation.PayPalOrderId)</strong>.</li>
                                                </ul>
                                            </article>
                                        </div>

                                        <div class="bonhomia-confirmation__charges">
                                            <h4>Desglose de cargos</h4>
                                            @if (CompletedReservation.Lines.Count > 0)
                                            {
                                                <div class="bonhomia-confirmation__line-list">
                                                    @foreach (var line in CompletedReservation.Lines)
                                                    {
                                                        <div>
                                                            <span>@line.Description</span>
                                                            <small>@line.Quantity x @FormatMoney(line.UnitPrice)</small>
                                                            <strong>@FormatMoney(line.Total)</strong>
                                                        </div>
                                                    }
                                                </div>
                                            }

                                            <div class="bonhomia-confirmation__totals">
                                                <div><span>Suite</span><strong>@FormatMoney(CompletedReservation.SuiteSubtotal)</strong></div>
                                                <div><span>Extras</span><strong>@FormatMoney(CompletedReservation.ExtrasSubtotal)</strong></div>
                                                <div><span>Subtotal</span><strong>@FormatMoney(CompletedReservation.SubTotal)</strong></div>
                                                <div><span>IVA</span><strong>@FormatMoney(CompletedReservation.Tax)</strong></div>
                                                @if (CompletedReservation.Ish > 0m)
                                                {
                                                    <div><span>ISH</span><strong>@FormatMoney(CompletedReservation.Ish)</strong></div>
                                                }
                                                <div class="bonhomia-confirmation__grand"><span>Total pagado</span><strong>@FormatMoney(CompletedReservation.Total)</strong></div>
                                            </div>
                                        </div>

                                        <div class="bonhomia-confirmation__actions">
                                            @if (!string.IsNullOrWhiteSpace(CompletedReservation.PdfUrl))
                                            {
                                                <a class="bonhomia-button bonhomia-button--primary bonhomia-confirmation__pdf" href="@CompletedReservation.PdfUrl" target="_blank" rel="noopener noreferrer" download>
                                                    <i class="bi bi-file-earmark-pdf" aria-hidden="true"></i>
                                                    <span>Descargar PDF de reservacion</span>
                                                </a>
                                            }
                                            <a class="bonhomia-button bonhomia-button--outline" href="@BuildReservationWhatsAppUrl(CompletedReservation)" target="_blank" rel="noopener noreferrer">
                                                <i class="bi bi-whatsapp" aria-hidden="true"></i>
                                                <span>Contactar recepcion</span>
                                            </a>
                                        </div>
                                    </section>
                                }
                                else if (Quote is null)
                                {
                                    <div class="bonhomia-alert bonhomia-alert--warning">
                                        La cotizacion ya no esta activa. Regresa al paso anterior para generar una nueva.
                                    </div>
                                }
                                else
                                {
                                    <div class="bonhomia-payment-grid">
                                        <section class="@GetCheckoutRequirementClass()" aria-label="Requisito para pagar con PayPal">
                                            <div class="bonhomia-checkout-requirement__icon">
                                                <i class="@(AcceptedPolicies && HasCustomerPhone ? "bi bi-paypal" : "bi bi-shield-check")" aria-hidden="true"></i>
                                            </div>
                                            <div>
                                                @if (!AcceptedPolicies || !HasCustomerPhone)
                                                {
                                                    <h4>Confirma telefono y politicas</h4>
                                                    <p>Para pagos internacionales PayPal puede no compartir telefono. Ingresa un numero de contacto antes de aceptar las politicas y activar PayPal.</p>
                                                    <label class="bonhomia-phone-field">
                                                        <span>Telefono de contacto</span>
                                                        <input type="tel"
                                                               value="@Customer.Phone"
                                                               autocomplete="tel"
                                                               inputmode="tel"
                                                               placeholder="+52 749 000 0000"
                                                               @oninput="args => OnCustomerChanged(nameof(Customer.Phone), args.Value?.ToString())" />
                                                    </label>
                                                    <p class="bonhomia-checkout-requirement__legal">Al presionar Aceptar confirmas que leiste y aceptas el centro legal de Bonhomia, incluyendo aviso de privacidad, terminos, politicas de reserva, cancelacion, check-in, convivencia y reglamento de hospedaje.</p>
                                                    <div class="bonhomia-checkout-requirement__actions">
                                                        <a class="bonhomia-checkout-requirement__link" href="/legal" target="_blank" rel="noopener noreferrer">Leer centro legal</a>
                                                        <button type="button"
                                                                class="bonhomia-button bonhomia-button--primary"
                                                                disabled="@(!CanAcceptPolicies)"
                                                                @onclick="AcceptPoliciesAsync">
                                                            <i class="bi bi-check2" aria-hidden="true"></i>
                                                            <span>Aceptar</span>
                                                        </button>
                                                    </div>
                                                }
                                                else if (!CheckoutOptions.Value.IsPayPalConfigured)
                                                {
                                                    <h4>PayPal pendiente de configuracion</h4>
                                                    <p>La cotizacion esta lista para probar el flujo y se puede confirmar por WhatsApp.</p>
                                                    <div class="bonhomia-alert bonhomia-alert--warning">
                                                        PayPal aun no esta configurado.
                                                    </div>
                                                }
                                                else
                                                {
                                                    <h4>Paga con PayPal</h4>
                                                    <p>Telefono de contacto: <strong>@DisplayValue(Customer.Phone)</strong></p>
                                                    <div class="bonhomia-paypal-gate">
                                                        @if (!CanRenderPayPal)
                                                        {
                                                            <p class="@(PaymentConfirmationFailed ? null : "bonhomia-paypal-gate__requirement")">@(PaymentConfirmationFailed ? "El pago necesita revision. Para evitar un doble cargo, genera una nueva cotizacion solo despues de revisar PayPal." : "Preparando PayPal...")</p>
                                                        }
                                                        <div id="@PayPalContainerId" class="bonhomia-paypal-container" aria-live="polite"></div>
                                                        @if (PaymentConfirmationFailed && !string.IsNullOrWhiteSpace(PendingPayPalOrderId))
                                                        {
                                                            <button class="bonhomia-button bonhomia-button--primary" type="button" @onclick="RetryPendingPayPalConfirmationAsync" disabled="@IsPaymentProcessing">
                                                                <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
                                                                <span>@(IsPaymentProcessing ? "Revisando pago..." : "Revisar pago en PayPal")</span>
                                                            </button>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </section>

                                        <aside class="bonhomia-summary" aria-label="Resumen de cotizacion">
                                            <div class="bonhomia-summary__card">
                                                <h3>Resumen</h3>
                                                <img src="@Quote.RoomImage" alt="@Quote.RoomName" />
                                                <div class="bonhomia-summary__title">
                                                    <strong>@Quote.RoomName</strong>
                                                    <span>@Quote.CheckIn.ToString("dd MMM", HeaderCulture) - @Quote.CheckOut.ToString("dd MMM yyyy", HeaderCulture)</span>
                                                </div>

                                                <div class="bonhomia-summary__lines">
                                                    @foreach (var line in Quote.Lines)
                                                    {
                                                        <div>
                                                            <span>@line.Description</span>
                                                            <strong>@FormatMoney(line.Total)</strong>
                                                        </div>
                                                    }
                                                </div>

                                                <div class="bonhomia-summary__totals">
                                                    <div><span>Subtotal</span><strong>@FormatMoney(Quote.SubTotal)</strong></div>
                                                    <div><span>IVA</span><strong>@FormatMoney(Quote.Tax)</strong></div>
                                                    @if (Quote.Ish > 0m)
                                                    {
                                                        <div><span>ISH</span><strong>@FormatMoney(Quote.Ish)</strong></div>
                                                    }
                                                    <div class="bonhomia-summary__grand"><span>Total</span><strong>@FormatMoney(Quote.Total)</strong></div>
                                                </div>

                                                <p class="bonhomia-summary__expires">Cotizacion valida hasta @Quote.ExpiresAtUtc.LocalDateTime.ToString("HH:mm", HeaderCulture).</p>

                                                @if (!string.IsNullOrWhiteSpace(StatusMessage))
                                                {
                                                    <div class="bonhomia-alert bonhomia-alert--info">@StatusMessage</div>
                                                }

                                                <a class="bonhomia-button bonhomia-button--outline bonhomia-summary__whatsapp" href="@WhatsAppUrl" target="_blank" rel="noopener noreferrer">
                                                    <i class="bi bi-whatsapp" aria-hidden="true"></i>
                                                    <span>Resolver por WhatsApp</span>
                                                </a>
                                            </div>
                                        </aside>
                                    </div>
                                }

                                <div class="bonhomia-wizard__actions bonhomia-wizard__actions--bottom">
                                    <button type="button" class="bonhomia-button bonhomia-button--outline" @onclick="GoBackAsync">
                                        <i class="bi bi-arrow-left" aria-hidden="true"></i>
                                        <span>Atras</span>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </section>

    </main>

<BonhomiaSuiteGalleryModal Gallery="ActiveGallery" OnClose="CloseSuiteGallery" />

@code {
    private const string WhatsAppPhone = "527491103026";
    private const string SessionKey = "bonhomia.checkout.v2";
    private const string PayPalContainerId = "bonhomia-paypal-buttons";
    private const string PaymentConfirmationPanelId = "bonhomia-payment-confirmation";
    private const int CalendarVisibleMonthCount = 2;
    private const int CalendarMaxMonthOffset = 6;
    private static readonly CultureInfo MoneyCulture = CultureInfo.GetCultureInfo("es-MX");
    private static readonly CultureInfo HeaderCulture = CultureInfo.GetCultureInfo("es-MX");
    private static readonly CheckoutStepDefinition[] WizardSteps =
    [
        new(CheckoutStep.Dates, "Fechas", "Llegada y salida"),
        new(CheckoutStep.Suite, "Suite", "Disponible"),
        new(CheckoutStep.Experiences, "Experiencias", "Temporada"),
        new(CheckoutStep.Extras, "Extras", "Opcionales"),
        new(CheckoutStep.Payment, "Pago", "PayPal")
    ];

    private BonhomiaAvailabilityDto? Availability { get; set; }
    private BonhomiaQuoteDto? Quote { get; set; }
    private BonhomiaCustomerInfo Customer { get; set; } = new();
    private BonhomiaConfirmPayPalOrderResponse? CompletedReservation { get; set; }
    private BonhomiaSuiteGallery? ActiveGallery { get; set; }
    private string? QuoteToken { get; set; }
    private string SelectedRoomName { get; set; } = string.Empty;
    private DateOnly Today { get; } = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly CheckIn { get; set; } = DateOnly.FromDateTime(DateTime.Today).AddDays(7);
    private DateOnly CheckOut { get; set; } = DateOnly.FromDateTime(DateTime.Today).AddDays(9);
    private int Guests { get; set; } = 2;
    private bool IncludeExperience { get; set; }
    private string SelectedExperienceCode { get; set; } = string.Empty;
    private string SelectedExperiencePackageCode { get; set; } = string.Empty;
    private DateOnly? SelectedExperienceDate { get; set; }
    private int ExperienceAdultParticipants { get; set; }
    private int ExperienceChildParticipants { get; set; }
    private HashSet<string> SelectedExperienceAddOnCodes { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    private bool AcceptedPolicies { get; set; }
    private bool IsLoadingAvailability { get; set; } = true;
    private bool IsQuoteBusy { get; set; }
    private bool IsPaymentProcessing { get; set; }
    private bool PaymentConfirmationFailed { get; set; }
    private string? PendingPayPalOrderId { get; set; }
    private string? PendingPaymentAttemptId { get; set; }
    private string? AvailabilityError { get; set; }
    private string? CheckoutError { get; set; }
    private string? StatusMessage { get; set; }
    private CheckoutStep ActiveCheckoutStep { get; set; } = CheckoutStep.Dates;
    private DateOnly VisibleCalendarMonth { get; set; } = BonhomiaBookingCalendarRules.GetMonthStart(DateOnly.FromDateTime(DateTime.Today));
    private BonhomiaCalendarSelectionTarget NextCalendarSelection { get; set; } = BonhomiaCalendarSelectionTarget.CheckIn;
    private string? _lastPayPalRenderKey;
    private string? _payPalRenderInFlightKey;
    private bool _focusPaymentConfirmationAfterRender;
    private DotNetObjectReference<BonhomiaReservationPage>? _dotNetRef;

    private string TodayText => Today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    private string CheckInText => CheckIn.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    private string CheckOutText => CheckOut.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    private string MinCheckOutText => CheckIn.AddDays(1).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    private int StayNights => Math.Max(0, CheckOut.DayNumber - CheckIn.DayNumber);
    private int SelectedExtrasCount => ExtraQuantities.Values.Where(quantity => quantity > 0).Sum();
    private string SelectedExtrasLabel => SelectedExtrasCount == 0
      ? "Sin extras seleccionados"
      : $"{SelectedExtrasCount} extra{(SelectedExtrasCount == 1 ? string.Empty : "s")} seleccionado{(SelectedExtrasCount == 1 ? string.Empty : "s")}";
    private BonhomiaRoomAvailabilityDto? SelectedRoom => Availability?.Rooms.FirstOrDefault(room => string.Equals(room.RoomName, SelectedRoomName, StringComparison.OrdinalIgnoreCase));
    private IReadOnlyList<ExperienceCatalogItemDto> StayExperiences
      => Availability?.Experiences.Where(IsExperienceAvailableForSelection).ToArray()
        ?? Array.Empty<ExperienceCatalogItemDto>();
    private ExperienceCatalogItemDto? PrimaryExperience
      => StayExperiences.FirstOrDefault(item => string.Equals(item.Code, SelectedExperienceCode, StringComparison.OrdinalIgnoreCase))
        ?? StayExperiences.FirstOrDefault();
    private ExperiencePackageOptionDto? SelectedExperiencePackage
      => PrimaryExperience?.Packages.FirstOrDefault(item => string.Equals(item.Code, SelectedExperiencePackageCode, StringComparison.OrdinalIgnoreCase));
    private int ExperienceParticipantLimit => GetExperienceParticipantLimit(PrimaryExperience);
    private string ExperienceDateText => (SelectedExperienceDate ?? ResolveDefaultExperienceDate()).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    private string ExperienceMinDateText => PrimaryExperience is { } experience
      ? ExperienceCatalogRules.GetFirstSelectableDate(experience, CheckIn).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)
      : CheckInText;
    private string ExperienceMaxDateText => PrimaryExperience is { } experience
      ? ExperienceCatalogRules.GetLastSelectableDate(experience, CheckOut).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)
      : CheckOut.AddDays(-1).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    private bool HasCustomerPhone => !string.IsNullOrWhiteSpace(Customer.Phone);
    private bool CanAcceptPolicies => Quote is not null
      && !IsPaymentProcessing
      && HasCustomerPhone;
    private bool CanPay => Quote is not null
      && !string.IsNullOrWhiteSpace(QuoteToken)
      && CheckoutOptions.Value.IsPayPalConfigured
      && ActiveCheckoutStep == CheckoutStep.Payment
      && AcceptedPolicies
      && HasCustomerPhone
      && !IsPaymentProcessing
      && CompletedReservation is null;
    private bool CanRenderPayPal => Quote is not null
      && !string.IsNullOrWhiteSpace(QuoteToken)
      && CheckoutOptions.Value.IsPayPalConfigured
      && ActiveCheckoutStep == CheckoutStep.Payment
      && AcceptedPolicies
      && HasCustomerPhone
      && !PaymentConfirmationFailed
      && CompletedReservation is null;

    private DateOnly EarliestCalendarMonth
      => BonhomiaBookingCalendarRules.GetMonthStart(Today);

    private DateOnly LatestCalendarMonth
      => BonhomiaBookingCalendarRules.GetLatestCalendarStartMonth(
        Today,
        CalendarMaxMonthOffset,
        CalendarVisibleMonthCount);

    private bool CanNavigateCalendarBack => VisibleCalendarMonth > EarliestCalendarMonth;

    private bool CanNavigateCalendarForward => VisibleCalendarMonth < LatestCalendarMonth;

    private string CalendarWindowLabel
      => $"{VisibleCalendarMonth.ToString("MMM yyyy", HeaderCulture)} - {VisibleCalendarMonth.AddMonths(CalendarVisibleMonthCount - 1).ToString("MMM yyyy", HeaderCulture)}";

    private IReadOnlyList<DateOnly> VisibleDays
      => Availability is null
        ? Array.Empty<DateOnly>()
        : BonhomiaBookingCalendarRules.BuildVisibleCalendarDays(VisibleCalendarMonth, CalendarVisibleMonthCount);

    private IReadOnlyList<MonthGroup> MonthGroups
      => VisibleDays
        .GroupBy(day => new DateOnly(day.Year, day.Month, 1))
        .Select(group => new MonthGroup(
          group.Key,
          (int)group.Key.ToDateTime(TimeOnly.MinValue).DayOfWeek,
          group.ToArray()))
        .ToArray();

    protected override async Task OnInitializedAsync()
    {
        await LoadAvailabilityAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await TryRestoreCheckoutAsync();
        }

        await RenderPayPalIfReadyAsync();

        if (_focusPaymentConfirmationAfterRender)
        {
            _focusPaymentConfirmationAfterRender = false;
            await FocusPaymentConfirmationAsync();
        }
    }

    private async Task GoToStepAsync(CheckoutStep step)
    {
        if (!CanNavigateToStep(step))
        {
            return;
        }

        ActiveCheckoutStep = step;
        CheckoutError = null;

        await ScrollCheckoutIntoViewAsync();
    }

    private async Task GoNextAsync()
    {
        CheckoutError = null;

        if (ActiveCheckoutStep == CheckoutStep.Dates)
        {
            if (!CanContinueFromDates())
            {
                CheckoutError = "Selecciona fechas validas y al menos un huesped.";
                await ScrollCheckoutIntoViewAsync();
                return;
            }

            ActiveCheckoutStep = CheckoutStep.Suite;
        }
        else if (ActiveCheckoutStep == CheckoutStep.Suite)
        {
            if (!CanContinueFromSuite())
            {
                CheckoutError = "Selecciona una suite disponible para tus fechas.";
                await ScrollCheckoutIntoViewAsync();
                return;
            }

            EnsureExperienceDefaults();
            ActiveCheckoutStep = CheckoutStep.Experiences;
        }
        else if (ActiveCheckoutStep == CheckoutStep.Experiences)
        {
            if (!CanContinueFromExperiences())
            {
                CheckoutError = "Revisa la experiencia seleccionada o desactivala para continuar.";
                await ScrollCheckoutIntoViewAsync();
                return;
            }

            ActiveCheckoutStep = CheckoutStep.Extras;
        }
        else if (ActiveCheckoutStep == CheckoutStep.Extras)
        {
            await GenerateQuoteAsync();
            return;
        }

        await ScrollCheckoutIntoViewAsync();
    }

    private async Task GoBackAsync()
    {
        if (ActiveCheckoutStep == CheckoutStep.Dates)
        {
            return;
        }

        CheckoutError = null;
        ActiveCheckoutStep = (CheckoutStep)((int)ActiveCheckoutStep - 1);
        await ScrollCheckoutIntoViewAsync();
    }

    private bool CanNavigateToStep(CheckoutStep step)
      => step switch
      {
          CheckoutStep.Dates => true,
          CheckoutStep.Suite => CanContinueFromDates(),
          CheckoutStep.Experiences => CanContinueFromSuite(),
          CheckoutStep.Extras => CanContinueFromSuite() && CanContinueFromExperiences(),
          CheckoutStep.Payment => Quote is not null || CompletedReservation is not null,
          _ => false
      };

    private bool CanContinueFromDates()
      => CheckOut > CheckIn
        && Guests > 0;

    private bool CanContinueFromSuite()
      => CanContinueFromDates()
        && SelectedRoom is { } room
        && IsSuiteAvailableForStay(room);

    private bool CanContinueFromExperiences()
      => !IncludeExperience
        || GetSelectedExperiencePreview() is not null;

    private string GetWizardStepClass(CheckoutStep step)
    {
        var classes = new List<string> { "bonhomia-wizard__step" };
        if (step == ActiveCheckoutStep)
        {
            classes.Add("bonhomia-wizard__step--active");
        }
        else if ((int)step < (int)ActiveCheckoutStep || step == CheckoutStep.Payment && CompletedReservation is not null)
        {
            classes.Add("bonhomia-wizard__step--complete");
        }

        if (!CanNavigateToStep(step))
        {
            classes.Add("bonhomia-wizard__step--locked");
        }

        return string.Join(" ", classes);
    }

    private async Task LoadAvailabilityAsync()
    {
        IsLoadingAvailability = true;
        AvailabilityError = null;

        try
        {
            var calendarEndDateExclusive = EarliestCalendarMonth.AddMonths(CalendarMaxMonthOffset + 1);
            var configuredEndDate = Today.AddDays(Math.Max(CheckoutOptions.Value.AvailabilityDays, 60));
            var endDate = configuredEndDate > calendarEndDateExclusive ? configuredEndDate : calendarEndDateExclusive;
            Availability = await BookingService.GetAvailabilityAsync(Today, endDate);
            VisibleCalendarMonth = BonhomiaBookingCalendarRules.ClampCalendarStartMonth(
              VisibleCalendarMonth,
              Today,
              CalendarMaxMonthOffset,
              CalendarVisibleMonthCount);
            EnsureSelectedRoomAvailableForStay();
            EnsureExperienceDefaults();
        }
        catch (Exception ex)
        {
            AvailabilityError = ex.Message;
        }
        finally
        {
            IsLoadingAvailability = false;
        }
    }

    private async Task GenerateQuoteAsync()
    {
        if (SelectedRoom is not { } selectedRoom || !IsSuiteAvailableForStay(selectedRoom))
        {
            ActiveCheckoutStep = CheckoutStep.Suite;
            CheckoutError = "Selecciona una suite disponible para tus fechas.";
            await ScrollCheckoutIntoViewAsync();
            return;
        }

        ActiveCheckoutStep = CheckoutStep.Extras;
        IsQuoteBusy = true;
        CheckoutError = null;
        StatusMessage = null;
        CompletedReservation = null;
        PaymentConfirmationFailed = false;
        PendingPayPalOrderId = null;
        PendingPaymentAttemptId = null;
        AcceptedPolicies = false;
        _lastPayPalRenderKey = null;
        _payPalRenderInFlightKey = null;

        try
        {
            var request = BuildQuoteRequest();
            Quote = await BookingService.CreateQuoteAsync(request);
            QuoteToken = QuoteTokenService.CreateToken(Quote);
            StatusMessage = "Cotizacion lista. Ingresa tu telefono y acepta las politicas para pagar con PayPal.";
            await PersistCheckoutAsync();
            ActiveCheckoutStep = CheckoutStep.Payment;
        }
        catch (BonhomiaPublicBookingException ex)
        {
            ClearQuoteState();
            ActiveCheckoutStep = CheckoutStep.Extras;
            CheckoutError = ex.Message;
        }
        catch (Exception ex)
        {
            ClearQuoteState();
            ActiveCheckoutStep = CheckoutStep.Extras;
            CheckoutError = $"No se pudo generar la cotizacion. {ex.Message}";
        }
        finally
        {
            IsQuoteBusy = false;
            await ScrollCheckoutIntoViewAsync();
        }
    }

    private BonhomiaQuoteRequest BuildQuoteRequest()
      => new()
      {
          RoomName = SelectedRoomName,
          CheckIn = CheckIn,
          CheckOut = CheckOut,
          Guests = Guests,
          Extras = ExtraQuantities
            .Where(item => item.Value > 0)
            .Select(item => new BonhomiaSelectedExtraRequest { Code = item.Key, Quantity = item.Value })
            .ToArray(),
          Experiences = BuildSelectedExperienceRequests()
      };

    private Dictionary<string, int> ExtraQuantities { get; set; } = new(StringComparer.OrdinalIgnoreCase);

    private BonhomiaStaySelection CurrentStaySelection
      => new(CheckIn, CheckOut, NextCalendarSelection);

    private void ApplyStaySelection(BonhomiaStaySelection selection)
    {
        CheckIn = selection.CheckIn;
        CheckOut = selection.CheckOut;
        NextCalendarSelection = selection.NextSelection;
        EnsureSelectedRoomAvailableForStay();
        EnsureExperienceDefaults();
        ClearQuoteState();
    }

    private void SelectRoom(string roomName)
    {
        var room = Availability?.Rooms.FirstOrDefault(item => string.Equals(item.RoomName, roomName, StringComparison.OrdinalIgnoreCase));
        if (room is null || !IsSuiteAvailableForStay(room))
        {
            return;
        }

        SelectedRoomName = room.RoomName;
        ClearQuoteState();
    }

    private void OpenSuiteGallery(string roomName)
    {
        ActiveGallery = BonhomiaSuiteGalleryCatalog.FindSuite(roomName);
    }

    private void CloseSuiteGallery()
    {
        ActiveGallery = null;
    }

    private void SelectCalendarDay(DateOnly day)
    {
        var nextSelection = BonhomiaBookingCalendarRules.SelectCalendarDay(day, Today, CurrentStaySelection);
        if (nextSelection == CurrentStaySelection)
        {
            return;
        }

        ApplyStaySelection(nextSelection);
    }

    private void ShowPreviousCalendarMonths()
    {
        VisibleCalendarMonth = BonhomiaBookingCalendarRules.ClampCalendarStartMonth(
          VisibleCalendarMonth.AddMonths(-1),
          Today,
          CalendarMaxMonthOffset,
          CalendarVisibleMonthCount);
    }

    private void ShowNextCalendarMonths()
    {
        VisibleCalendarMonth = BonhomiaBookingCalendarRules.ClampCalendarStartMonth(
          VisibleCalendarMonth.AddMonths(1),
          Today,
          CalendarMaxMonthOffset,
          CalendarVisibleMonthCount);
    }

    private void OnCheckInChanged(ChangeEventArgs args)
    {
        if (TryParseDate(args.Value?.ToString(), out var parsed))
        {
            ApplyStaySelection(BonhomiaBookingCalendarRules.SetCheckIn(parsed, Today, CurrentStaySelection));
        }
    }

    private void OnCheckOutChanged(ChangeEventArgs args)
    {
        if (TryParseDate(args.Value?.ToString(), out var parsed))
        {
            ApplyStaySelection(BonhomiaBookingCalendarRules.SetCheckOut(parsed, CurrentStaySelection));
        }
    }

    private void OnGuestsChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var parsed))
        {
            Guests = Math.Clamp(parsed, 1, 10);
            EnsureExperienceDefaults();
            ClearQuoteState();
        }
    }

    private void OnExtraQuantityChanged(string code, ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var parsed))
        {
            ExtraQuantities[code] = Math.Max(parsed, 0);
            ClearQuoteState();
        }
    }

    private void OnIncludeExperienceChanged(ChangeEventArgs args)
    {
        IncludeExperience = args.Value is bool value && value
          || bool.TryParse(args.Value?.ToString(), out var parsed) && parsed;
        EnsureExperienceDefaults();
        ClearQuoteState();
    }

    private void OnExperiencePackageChanged(ChangeEventArgs args)
    {
        SelectedExperiencePackageCode = args.Value?.ToString() ?? string.Empty;
        EnsureExperienceDefaults();
        ClearQuoteState();
    }

    private void OnExperienceDateChanged(ChangeEventArgs args)
    {
        if (TryParseDate(args.Value?.ToString(), out var parsed))
        {
            SelectedExperienceDate = parsed;
            EnsureExperienceDefaults();
            ClearQuoteState();
        }
    }

    private void OnExperienceAdultParticipantsChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var parsed))
        {
            ExperienceAdultParticipants = Math.Clamp(parsed, 1, ExperienceParticipantLimit);
            EnsureExperienceDefaults();
            ClearQuoteState();
        }
    }

    private void OnExperienceChildParticipantsChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var parsed))
        {
            ExperienceChildParticipants = Math.Clamp(parsed, 0, Math.Max(ExperienceParticipantLimit - 1, 0));
            EnsureExperienceDefaults();
            ClearQuoteState();
        }
    }

    private void OnExperienceAddOnChanged(string code, ChangeEventArgs args)
    {
        var isSelected = args.Value is bool value && value
          || bool.TryParse(args.Value?.ToString(), out var parsed) && parsed;

        if (isSelected)
        {
            SelectedExperienceAddOnCodes.Add(code);
        }
        else
        {
            SelectedExperienceAddOnCodes.Remove(code);
        }

        ClearQuoteState();
    }

    private void OnCustomerChanged(string fieldName, string? value)
    {
        if (fieldName == nameof(Customer.FullName))
        {
            Customer.FullName = value ?? string.Empty;
        }
        else if (fieldName == nameof(Customer.Email))
        {
            Customer.Email = value ?? string.Empty;
        }
        else if (fieldName == nameof(Customer.Phone))
        {
            Customer.Phone = value ?? string.Empty;
            if (!HasCustomerPhone)
            {
                AcceptedPolicies = false;
                _lastPayPalRenderKey = null;
                _payPalRenderInFlightKey = null;
                _ = ClearPayPalButtonsAsync();
            }
        }

        CheckoutError = null;
        _ = PersistCheckoutAsync();
    }

    private async Task AcceptPoliciesAsync()
    {
        var phone = Customer.Phone?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(phone))
        {
            CheckoutError = "Ingresa un telefono de contacto antes de aceptar las politicas.";
            AcceptedPolicies = false;
            await PersistCheckoutAsync();
            return;
        }

        Customer.Phone = phone;
        AcceptedPolicies = true;
        CheckoutError = null;
        StatusMessage = null;
        await PersistCheckoutAsync();
    }

    private int GetExtraQuantity(string code)
      => ExtraQuantities.TryGetValue(code, out var quantity) ? quantity : 0;

    private IReadOnlyList<BonhomiaSelectedExperienceRequest> BuildSelectedExperienceRequests()
    {
        if (!IncludeExperience || PrimaryExperience is null || SelectedExperiencePackage is null)
        {
            return Array.Empty<BonhomiaSelectedExperienceRequest>();
        }

        var selectedAddOns = PrimaryExperience.AddOns
          .Where(addOn => SelectedExperienceAddOnCodes.Contains(addOn.Code))
          .Select(addOn => new BonhomiaSelectedExperienceAddOnRequest
          {
              Code = addOn.Code,
              Quantity = 1
          })
          .ToArray();

        return
        [
          new BonhomiaSelectedExperienceRequest
          {
              Code = PrimaryExperience.Code,
              PackageCode = SelectedExperiencePackage.Code,
              ExperienceDate = SelectedExperienceDate ?? ResolveDefaultExperienceDate(),
              AdultParticipants = ExperienceAdultParticipants,
              ChildParticipants = ExperienceChildParticipants,
              AddOns = selectedAddOns
          }
        ];
    }

    private void EnsureExperienceDefaults()
    {
        var experience = PrimaryExperience;
        if (experience is null)
        {
            IncludeExperience = false;
            SelectedExperienceCode = string.Empty;
            SelectedExperiencePackageCode = string.Empty;
            SelectedExperienceDate = null;
            SelectedExperienceAddOnCodes.Clear();
            return;
        }

        SelectedExperienceCode = experience.Code;

        if ((string.IsNullOrWhiteSpace(SelectedExperiencePackageCode) || SelectedExperiencePackage is null)
            && experience.Packages.Count > 0)
        {
            SelectedExperiencePackageCode = experience.Packages
              .FirstOrDefault(package => string.Equals(package.Code, "clasico", StringComparison.OrdinalIgnoreCase))
              ?.Code
              ?? experience.Packages[0].Code;
        }

        var minDate = ExperienceCatalogRules.GetFirstSelectableDate(experience, CheckIn);
        var maxDate = ExperienceCatalogRules.GetLastSelectableDate(experience, CheckOut);
        var defaultDate = ResolveDefaultExperienceDate();
        if (!SelectedExperienceDate.HasValue
            || SelectedExperienceDate.Value < minDate
            || SelectedExperienceDate.Value > maxDate)
        {
            SelectedExperienceDate = defaultDate;
        }

        ExperienceAdultParticipants = ExperienceAdultParticipants <= 0
          ? ExperienceParticipantLimit
          : Math.Clamp(ExperienceAdultParticipants, 1, ExperienceParticipantLimit);

        ExperienceChildParticipants = Math.Clamp(
          ExperienceChildParticipants,
          0,
          Math.Max(ExperienceParticipantLimit - ExperienceAdultParticipants, 0));

        var activeAddOnCodes = experience.AddOns.Select(addOn => addOn.Code).ToHashSet(StringComparer.OrdinalIgnoreCase);
        SelectedExperienceAddOnCodes.RemoveWhere(code => !activeAddOnCodes.Contains(code));
    }

    private DateOnly ResolveDefaultExperienceDate()
    {
        var experience = PrimaryExperience;
        return experience is null
          ? CheckIn
          : ExperienceCatalogRules.ResolveDefaultDate(experience, CheckIn, CheckOut);
    }

    private bool IsExperienceAvailableForSelection(ExperienceCatalogItemDto experience)
      => ExperienceCatalogRules.IsAvailableForStay(experience, CheckIn, CheckOut)
        && Math.Max(experience.MinimumParticipants, 1) <= GetExperienceParticipantLimit(experience);

    private int GetExperienceParticipantLimit(ExperienceCatalogItemDto? experience)
      => ExperienceCatalogRules.GetParticipantLimit(experience, SelectedRoom?.Capacity ?? Guests);

    private ExperiencePricingResult? GetSelectedExperiencePreview()
    {
        if (!IncludeExperience || PrimaryExperience is null || SelectedExperiencePackage is null)
        {
            return null;
        }

        try
        {
            var selectedAddOns = PrimaryExperience.AddOns
              .Where(addOn => SelectedExperienceAddOnCodes.Contains(addOn.Code))
              .Select(addOn => new ExperiencePricingAddOnInput
              {
                  AddOn = addOn,
                  Quantity = 1
              })
              .ToArray();

            return ExperiencePricingCalculator.Calculate(new ExperiencePricingInput
            {
                ExperienceDate = SelectedExperienceDate ?? ResolveDefaultExperienceDate(),
                Experience = PrimaryExperience,
                Package = SelectedExperiencePackage,
                AdultParticipants = ExperienceAdultParticipants,
                ChildParticipants = ExperienceChildParticipants,
                AddOns = selectedAddOns
            });
        }
        catch
        {
            return null;
        }
    }

    private static string FormatExperienceSeason(ExperienceCatalogItemDto experience)
    {
        if (experience.SeasonStart.HasValue && experience.SeasonEnd.HasValue)
        {
            return $"{experience.SeasonStart.Value:dd MMM yyyy} - {experience.SeasonEnd.Value:dd MMM yyyy}";
        }

        return "Disponible por temporada";
    }

