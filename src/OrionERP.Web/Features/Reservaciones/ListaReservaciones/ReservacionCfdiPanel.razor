@using System.Linq

@if (Page.HasReservationFacturacionEvidence)
{
    <div class="alert alert-info mb-0">
        Esta reservación ya tiene pagos con CFDI o Pago20 ligado. Revisa la columna de facturación en pagos para evitar timbrados duplicados.
    </div>
}

@if (Page.HasExistingReservationCfdis)
{
    <section class="card reservacion-section reservacion-section-cfdi">
        <div class="card-header reservacion-section-title d-flex align-items-center gap-2">
            <span>CFDIs ligados</span>
            <span class="badge text-bg-secondary">@Page.CfdiContext!.ExistingDocuments.Count</span>
        </div>
        <div class="card-body">
            <div class="table-responsive reservacion-table-wrap">
                <table class="table table-sm table-bordered mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Póliza</th>
                            <th>Fecha</th>
                            <th>UUID</th>
                            <th>Receptor</th>
                            <th class="text-end">Total</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var document in Page.CfdiContext.ExistingDocuments)
                        {
                            <tr>
                                <td>@document.TransaccionId</td>
                                <td>@document.Fecha.ToShortDateString()</td>
                                <td class="text-wrap">@document.Uuid</td>
                                <td class="text-wrap">@document.ReceptorNombre (@document.ReceptorRfc)</td>
                                <td class="text-end">@ReservacionPage.FormatCurrency(document.Total)</td>
                                <td class="text-end">
                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger"
                                            @onclick="() => Page.CancelarCfdiReservacionAsync(document)"
                                            disabled="@Page.IsCancellingReservationCfdi(document)">
                                        @(Page.IsCancellingReservationCfdi(document) ? "Cancelando..." : "Cancelar CFDI")
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>
}

@if (Page.ShouldShowCfdiCreationPanel)
{
    <section class="card reservacion-section reservacion-section-cfdi">
        <div class="card-header reservacion-section-title d-flex flex-wrap align-items-center gap-2">
            <span>CFDI</span>
            @if (Page.CfdiContext is not null)
            {
                <span class="badge text-bg-secondary">Total @ReservacionPage.FormatCurrency(Page.CfdiContext.TotalReservacion)</span>
                @if (Page.CfdiContext.AutoSelectedTransaccionId.HasValue)
                {
                    <span class="badge text-bg-success">Póliza sugerida @Page.CfdiContext.AutoSelectedTransaccionId</span>
                }
            }
            <button type="button"
                    class="btn btn-sm btn-outline-secondary ms-auto"
                    @onclick="Page.ReloadCfdiContextAsync"
                    disabled="@(Page.IsLoadingCfdiContext || Page.IsCreatingCfdi)">
                Recargar
            </button>
        </div>
        <div class="card-body">
            @if (Page.IsLoadingCfdiContext)
            {
                <p class="mb-0 text-muted">Preparando contexto del CFDI...</p>
            }
            else if (Page.CfdiContext is null)
            {
                <div class="alert alert-warning mb-0">@Page.CfdiErrorMessage</div>
            }
            else
            {
                @if (!string.IsNullOrWhiteSpace(Page.CfdiErrorMessage))
                {
                    <div class="alert alert-danger">@Page.CfdiErrorMessage</div>
                }

                @if (Page.CfdiContext.HasUnsupportedIsh)
                {
                    <div class="alert alert-warning">
                        Esta reservación incluye ISH. El flujo actual de CFDI no timbra automáticamente reservaciones con ese impuesto.
                    </div>
                }

                <div class="reservacion-cfdi-grid">
                    <div class="reservacion-cfdi-stack">
                        <div class="reservacion-cfdi-panel">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <h6 class="mb-0">Receptor</h6>
                                @if (Page.CfdiReceiver.BusinessPartnerId.HasValue)
                                {
                                    <span class="badge text-bg-success">Cliente guardado</span>
                                }
                            </div>

                            <div class="reservacion-lookup mb-3">
                                <label class="form-label">Buscar RFC o razón social</label>
                                <input class="form-control"
                                       placeholder="RFC, razón social o email"
                                       value="@Page.CfdiCustomerSearchText"
                                       @oninput="Page.OnCfdiCustomerInputChangedAsync"
                                       @onkeydown="Page.OnCfdiCustomerInputKeyDownAsync" />
                                @if (Page.ShowCfdiCustomerResults)
                                {
                                    <div class="list-group position-absolute w-100 shadow-sm reservacion-lookup-results">
                                        @if (Page.IsSearchingCfdiCustomers)
                                        {
                                            <div class="list-group-item text-muted small">Buscando...</div>
                                        }
                                        else if (Page.CfdiCustomerSuggestions.Count == 0)
                                        {
                                            <div class="list-group-item text-muted small">Sin resultados.</div>
                                        }
                                        else
                                        {
                                            @foreach (var suggestion in Page.CfdiCustomerSuggestions)
                                            {
                                                <button type="button"
                                                        class="list-group-item list-group-item-action"
                                                        @onclick="() => Page.SelectCfdiCustomer(suggestion)">
                                                    <div class="fw-semibold">@suggestion.DisplayName</div>
                                                    <div class="small text-muted">
                                                        @suggestion.Rfc | @suggestion.FiscalRegime | @suggestion.CfdiUse
                                                    </div>
                                                </button>
                                            }
                                        }
                                    </div>
                                }
                            </div>

                            <div class="row g-2">
                                <div class="col-12">
                                    <label class="form-label">Nombre corto</label>
                                    <input class="form-control" @bind="Page.CfdiReceiver.DisplayName" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">RFC</label>
                                    <input class="form-control" @bind="Page.CfdiReceiver.Rfc" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">CP Fiscal</label>
                                    <input class="form-control" @bind="Page.CfdiReceiver.TaxZipCode" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Razón social</label>
                                    <input class="form-control" @bind="Page.CfdiReceiver.FiscalName" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Régimen fiscal</label>
                                    <select class="form-select" @bind="Page.CfdiReceiver.FiscalRegime">
                                        <option value="">Selecciona un régimen</option>
                                        @foreach (var regimen in Page.CfdiRegimenFiscalOptions)
                                        {
                                            <option value="@regimen.Id">@($"{regimen.Id} - {regimen.Display}")</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Uso CFDI</label>
                                    <select class="form-select" @bind="Page.CfdiReceiver.CfdiUse">
                                        <option value="">Selecciona un uso</option>
                                        @foreach (var uso in Page.CfdiUsoCfdiOptions)
                                        {
                                            <option value="@uso.Id">@($"{uso.Id} - {uso.Display}")</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Email</label>
                                    <input class="form-control" @bind="Page.CfdiReceiver.Email" />
                                </div>
                            </div>

                            <div class="d-flex flex-wrap gap-2 align-items-center mt-3">
                                <div class="form-check mb-0">
                                    <input class="form-check-input" type="checkbox" id="persistCfdiCustomerCheck" @bind="Page.PersistCfdiCustomer" />
                                    <label class="form-check-label" for="persistCfdiCustomerCheck">Guardar cliente fiscal localmente</label>
                                </div>
                                <button type="button"
                                        class="btn btn-sm btn-outline-secondary ms-auto"
                                        @onclick="Page.SaveCfdiCustomerAsync"
                                        disabled="@Page.IsSavingCfdiCustomer">
                                    @(Page.IsSavingCfdiCustomer ? "Guardando..." : (Page.CfdiReceiver.BusinessPartnerId.HasValue ? "Actualizar cliente fiscal" : "Guardar cliente fiscal"))
                                </button>
                            </div>
                        </div>

                        <div class="reservacion-cfdi-panel">
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                <h6 class="mb-0">Validación Facturama</h6>
                                <span class="badge @Page.GetCfdiReceiverValidationStatusBadgeClass()">
                                    @Page.GetCfdiReceiverValidationStatusLabel()
                                </span>
                                @if (Page.CfdiReceiverValidation is not null)
                                {
                                    <span class="badge text-bg-secondary">@Page.CfdiReceiverValidation.EnvironmentLabel</span>
                                }
                                <button type="button"
                                        class="btn btn-sm btn-outline-primary ms-auto"
                                        @onclick="Page.ValidateCfdiReceiverAsync"
                                        disabled="@(!Page.CanValidateCfdiReceiver || Page.IsValidatingCfdiReceiver || Page.IsCreatingCfdi)">
                                    @(Page.IsValidatingCfdiReceiver ? "Validando..." : "Validar receptor")
                                </button>
                            </div>

                            @if (Page.CfdiReceiverValidation is null)
                            {
                                <div class="small text-muted">
                                    Valida RFC, razón social, CP fiscal y régimen antes de timbrar.
                                </div>
                            }
                            else
                            {
                                <div class="alert @Page.GetCfdiReceiverValidationAlertClass() py-2 px-3 mb-2">
                                    <div>@Page.CfdiReceiverValidation.Message</div>
                                    @if (Page.IsCfdiReceiverValidationStale)
                                    {
                                        <div class="small mt-1">Hay cambios pendientes en el receptor. Vuelve a validar antes de timbrar.</div>
                                    }
                                    else if (Page.CfdiReceiverValidation.IsSandbox && !Page.CfdiReceiverValidation.IsValid)
                                    {
                                        <div class="small mt-1">En sandbox la validación es informativa y no bloquea el timbrado.</div>
                                    }
                                </div>

                                <div class="table-responsive">
                                    <table class="table table-sm table-borderless mb-0">
                                        <tbody>
                                            <tr>
                                                <td>RFC localizado</td>
                                                <td class="text-end">
                                                    <span class="badge @ReservacionPage.GetCfdiReceiverFlagBadgeClass(Page.CfdiReceiverValidation.ExistRfc)">
                                                        @(Page.CfdiReceiverValidation.ExistRfc ? "Sí" : "No")
                                                    </span>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>Razón social</td>
                                                <td class="text-end">
                                                    <span class="badge @ReservacionPage.GetCfdiReceiverFlagBadgeClass(Page.CfdiReceiverValidation.MatchName)">
                                                        @(Page.CfdiReceiverValidation.MatchName ? "Coincide" : "No coincide")
                                                    </span>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>CP fiscal</td>
                                                <td class="text-end">
                                                    <span class="badge @ReservacionPage.GetCfdiReceiverFlagBadgeClass(Page.CfdiReceiverValidation.MatchZipCode)">
                                                        @(Page.CfdiReceiverValidation.MatchZipCode ? "Coincide" : "No coincide")
                                                    </span>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>Régimen fiscal</td>
                                                <td class="text-end">
                                                    <span class="badge @ReservacionPage.GetCfdiReceiverFlagBadgeClass(Page.CfdiReceiverValidation.MatchFiscalRegime)">
                                                        @(Page.CfdiReceiverValidation.MatchFiscalRegime ? "Coincide" : "No coincide")
                                                    </span>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>

                        <div class="reservacion-cfdi-panel">
                            <h6>Datos de pago</h6>
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <label class="form-label">Forma de pago</label>
                                    <select class="form-select"
                                            value="@Page.SelectedCfdiFormaPago"
                                            @onchange="Page.OnCfdiFormaPagoChanged"
                                            disabled="@Page.IsCfdiPaymentFormLocked">
                                        <option value="">Selecciona una forma</option>
                                        @foreach (var forma in Page.CfdiFormaPagoOptions)
                                        {
                                            <option value="@forma.Clave">@forma.Display</option>
                                        }
                                    </select>
                                    @if (Page.IsCfdiPaymentFormLocked)
                                    {
                                        <div class="form-text">Con método PPD se usa 99 - Por definir.</div>
                                    }
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Método de pago</label>
                                    <select class="form-select"
                                            value="@Page.SelectedCfdiMetodoPago"
                                            @onchange="Page.OnCfdiMetodoPagoChanged">
                                        <option value="">Selecciona un método</option>
                                        @foreach (var metodo in Page.CfdiMetodoPagoOptions)
                                        {
                                            <option value="@metodo.Id">@($"{metodo.Id} - {metodo.Display}")</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="reservacion-cfdi-panel">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <h6 class="mb-0">Póliza destino</h6>
                                @if (Page.CfdiContext.PolizaOptions.Count == 0)
                                {
                                    <span class="badge text-bg-secondary">Se creará una nueva</span>
                                }
                            </div>

                            <label class="form-label">Selecciona destino</label>
                            <select class="form-select" @bind="Page.SelectedCfdiPolizaOption">
                                <option value="@ReservacionPage.NewCfdiPolizaOption">Crear nueva póliza</option>
                                @foreach (var option in Page.CfdiContext.PolizaOptions)
                                {
                                    <option value="@option.TransaccionId">@Page.FormatCfdiPolizaLabel(option)</option>
                                }
                            </select>

                            <div class="form-text mt-2">
                                Se reutiliza automáticamente solo cuando existe una póliza ligada que coincide con el total y todavía no tiene CFDI.
                            </div>

                            @if (Page.CfdiContext.PolizaOptions.Count > 0)
                            {
                                <div class="table-responsive reservacion-table-wrap mt-3">
                                    <table class="table table-sm table-bordered mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>ID</th>
                                                <th>Fecha</th>
                                                <th class="text-end">Monto</th>
                                                <th>Estatus</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var option in Page.CfdiContext.PolizaOptions)
                                            {
                                                <tr class="@(Page.ResolveSelectedCfdiTransaccionId() == option.TransaccionId ? "table-primary" : string.Empty)">
                                                    <td>@option.TransaccionId</td>
                                                    <td>@option.Fecha.ToShortDateString()</td>
                                                    <td class="text-end">@ReservacionPage.FormatCurrency(option.Monto)</td>
                                                    <td>
                                                        <span class="badge @Page.GetCfdiPolizaStatusClass(option)">
                                                            @(option.IsEligible ? "Elegible" : option.HasExistingCfdi ? "Con CFDI" : option.MatchesReservationTotal ? "RFC / tipo no coincide" : "Monto distinto")
                                                        </span>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="reservacion-cfdi-panel">
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                            <h6 class="mb-0">Conceptos del CFDI</h6>
                            <span class="badge text-bg-secondary">@Page.CfdiContext.Items.Count conceptos</span>
                        </div>

                        <div class="table-responsive reservacion-table-wrap">
                            <table class="table table-sm table-bordered mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Fecha</th>
                                        <th>Tipo</th>
                                        <th>Descripción</th>
                                        <th>Clave SAT</th>
                                        <th class="text-end">Subtotal</th>
                                        @if (Page.HasCfdiDiscounts)
                                        {
                                            <th class="text-end">Descuento</th>
                                        }
                                        <th class="text-end">IVA</th>
                                        <th class="text-end">Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Page.CfdiContext.Items)
                                    {
                                        <tr>
                                            <td>@(item.Fecha?.ToString("yyyy-MM-dd") ?? string.Empty)</td>
                                            <td>@item.SourceType</td>
                                            <td class="text-wrap">@item.Description</td>
                                            <td>@item.ProductCode / @item.UnitCode</td>
                                            <td class="text-end">@ReservacionPage.FormatCurrency(item.Subtotal)</td>
                                            @if (Page.HasCfdiDiscounts)
                                            {
                                                <td class="text-end">@ReservacionPage.FormatCurrency(item.Discount)</td>
                                            }
                                            <td class="text-end">@ReservacionPage.FormatCurrency(item.Tax)</td>
                                            <td class="text-end">@ReservacionPage.FormatCurrency(item.Total)</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-light">
                                    <tr>
                                        <th colspan="4" class="text-end">Subtotal reservación</th>
                                        <th class="text-end">@ReservacionPage.FormatCurrency(Page.CfdiContext.SubTotal)</th>
                                        @if (Page.HasCfdiDiscounts)
                                        {
                                            <th class="text-end">@ReservacionPage.FormatCurrency(Page.CfdiContext.Items.Sum(item => item.Discount))</th>
                                        }
                                        <th class="text-end">@ReservacionPage.FormatCurrency(Page.CfdiContext.Tax)</th>
                                        <th class="text-end">@ReservacionPage.FormatCurrency(Page.CfdiContext.TotalReservacion)</th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>

                        <div class="d-flex flex-wrap gap-2 justify-content-end mt-3">
                            <button type="button" class="btn btn-outline-secondary" @onclick="Page.ToggleCfdiPanelAsync" disabled="@Page.IsCreatingCfdi">
                                Cerrar
                            </button>
                            <button type="button"
                                    class="btn btn-primary"
                                    @onclick="Page.CrearCfdiReservacionAsync"
                                    disabled="@(!Page.CanCreateReservationCfdi || Page.IsCreatingCfdi || Page.IsValidatingCfdiReceiver)">
                                @(Page.IsCreatingCfdi ? "Timbrando CFDI..." : "Crear CFDI")
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
}

@code {
    [CascadingParameter] public ReservacionPage Page { get; set; } = default!;
}
