@page "/suites"
@inject PublicWebsitePresentationDefinition Presentation
@inject HospitalityWebsiteDefinition Hospitality

<PageTitle>Suites | @Presentation.PublicName</PageTitle>
<HeadContent>
    <meta name="description" content="@($"Conoce las suites y casas amuebladas de {Presentation.PublicName} en {Presentation.LocationName} por capacidad, privacidad y tipo de viaje.")" />
</HeadContent>

<main class="bonhomia-page">
    <section class="bonhomia-page__title">
        <p class="bonhomia-eyebrow">Nuestras suites</p>
        <h1>Elige por capacidad, privacidad y plan de viaje</h1>
        <p>Cada espacio tiene personalidad propia. Las tarifas son por noche, en MXN, y pueden variar por temporada o disponibilidad.</p>
    </section>

    <section class="bonhomia-section">
        <div class="bonhomia-grid bonhomia-grid--four">
            @foreach (var suite in Hospitality.Rooms)
            {
                <article class="bonhomia-card bonhomia-suite-card">
                    <button type="button"
                            class="bonhomia-suite-card__media"
                            title="@($"Ver fotos de {suite.RoomCode}")"
                            @onclick="() => OpenSuiteGallery(suite.RoomCode)">
                        <img src="@suite.PrimaryImage" alt="@($"Vista de referencia para {suite.RoomCode}")" />
                        <span class="bonhomia-suite-card__media-action">
                            <i class="bi bi-images" aria-hidden="true"></i>
                            <span>Ver fotos</span>
                        </span>
                    </button>
                    <div class="bonhomia-suite-card__body">
                        <div class="bonhomia-suite-card__topline">
                            <span class="bonhomia-card__meta">@suite.Tag</span>
                            <strong>Consulta tarifa</strong>
                        </div>
                        <h3>@suite.RoomCode</h3>
                        <p>@suite.Ideal</p>
                        <div class="bonhomia-suite-card__meta">
                            <span><i class="bi bi-people" aria-hidden="true"></i>@suite.Capacity personas</span>
                            <span><i class="bi bi-moon" aria-hidden="true"></i>@suite.Bedrooms recamaras</span>
                            <span><i class="bi bi-droplet" aria-hidden="true"></i>@suite.Bathrooms baños</span>
                        </div>
                        <button type="button"
                                class="bonhomia-button bonhomia-button--outline bonhomia-suite-card__gallery"
                                @onclick="() => OpenSuiteGallery(suite.RoomCode)">
                            <i class="bi bi-images" aria-hidden="true"></i>
                            <span>Ver fotos</span>
                        </button>
                    </div>
                </article>
            }
        </div>
    </section>

    <section class="bonhomia-section">
        <div class="bonhomia-gallery">
            @foreach (var image in BonhomiaSuiteGalleryCatalog.GetBuildingImages(Hospitality, Presentation.PublicName))
            {
                <img src="@image.Source" alt="@image.Alt" />
            }
        </div>
    </section>

    <section class="bonhomia-section bonhomia-section--last">
        <div class="bonhomia-contact-panel">
            <div>
                <p class="bonhomia-eyebrow">Despues de conocer las suites</p>
                <h2>Consulta disponibilidad y genera tu cotizacion</h2>
                <p>La reserva directa valida disponibilidad antes del pago y mantiene la cotizacion durante tu sesion.</p>
            </div>
            <div class="bonhomia-contact-panel__actions">
                <a class="bonhomia-button bonhomia-button--primary" href="/reservar">
                    <i class="bi bi-calendar-check" aria-hidden="true"></i>
                    <span>Reservar</span>
                </a>
                <a class="bonhomia-button bonhomia-button--outline" href="/preguntas-frecuentes">Ver preguntas frecuentes</a>
            </div>
        </div>
    </section>
</main>

<BonhomiaSuiteGalleryModal Gallery="ActiveGallery" OnClose="CloseSuiteGallery" />

@code {
    private BonhomiaSuiteGallery? ActiveGallery { get; set; }

    private void OpenSuiteGallery(string suiteName)
    {
        ActiveGallery = BonhomiaSuiteGalleryCatalog.FindSuite(Hospitality, suiteName);
    }

    private void CloseSuiteGallery()
    {
        ActiveGallery = null;
    }
}
