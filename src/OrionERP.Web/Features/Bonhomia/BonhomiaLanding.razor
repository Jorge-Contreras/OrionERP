@using System.Globalization
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Microsoft.JSInterop
@using Microsoft.Extensions.Options
@using OrionERP.Application.Features.Bonhomia.PublicBooking
@using OrionERP.Web.Features.Bonhomia.Checkout
@implements IAsyncDisposable
@inject IBonhomiaPublicBookingService BookingService
@inject IBonhomiaQuoteTokenService QuoteTokenService
@inject IOptions<BonhomiaCheckoutOptions> CheckoutOptions
@inject ProtectedSessionStorage SessionStorage
@inject IJSRuntime Js

<PageTitle>Bonhomia Suites | Reservas en Calpulalpan</PageTitle>
<HeadContent>
    <meta name="description" content="Bonhomia Suites: reserva directa en Calpulalpan, Tlaxcala. Consulta disponibilidad, genera cotizacion y paga en linea con PayPal." />
</HeadContent>

<div class="bonhomia-site">
    <header class="bonhomia-nav" aria-label="Bonhomia Suites">
        <a class="bonhomia-brand" href="@SectionUrl("inicio")" aria-label="Bonhomia Suites">
            <img src="/Images/Bonhomia/logo-vertical.png" alt="Bonhomia Suites" />
            <span>Bonhomia Suites</span>
        </a>

        <nav class="bonhomia-nav__links" aria-label="Secciones">
            <a href="@SectionUrl("reserva")">Reservar</a>
            <a href="@SectionUrl("suites")">Suites</a>
            <a href="@SectionUrl("tarifas")">Servicios</a>
            <a href="@SectionUrl("contacto")">Contacto</a>
        </nav>

        <a class="bonhomia-nav__cta" href="@SectionUrl("reserva")">
            <i class="bi bi-calendar-check" aria-hidden="true"></i>
            <span>Cotizar</span>
        </a>
    </header>

    <main>
        <section id="inicio" class="bonhomia-hero" style="background-image: url('/Images/Bonhomia/hero-penthouse.jpg');" aria-labelledby="bonhomia-title">
            <div class="bonhomia-hero__content">
                <p class="bonhomia-eyebrow">Business Bed & Breakfast en Calpulalpan</p>
                <h1 id="bonhomia-title">Bonhomia Suites</h1>
                <p class="bonhomia-hero__lead">Departamentos y casas amuebladas listas para llegar, descansar y seguir tu viaje con limpieza impecable, seguridad y atencion cercana.</p>

                <div class="bonhomia-hero__actions">
                    <a class="bonhomia-button bonhomia-button--primary" href="@SectionUrl("reserva")">
                        <i class="bi bi-calendar2-week" aria-hidden="true"></i>
                        <span>Ver disponibilidad</span>
                    </a>
                    <a class="bonhomia-button bonhomia-button--light" href="@WhatsAppUrl" target="_blank" rel="noopener noreferrer">
                        <i class="bi bi-whatsapp" aria-hidden="true"></i>
                        <span>WhatsApp</span>
                    </a>
                </div>
            </div>

            <div class="bonhomia-hero__proof" aria-label="Datos destacados">
                <div>
                    <span>Reserva</span>
                    <strong>Pago seguro</strong>
                </div>
                <div>
                    <span>Check-in</span>
                    <strong>15:00 hrs</strong>
                </div>
                <div>
                    <span>Moneda</span>
                    <strong>MXN</strong>
                </div>
            </div>
        </section>

        <section id="reserva" class="bonhomia-booking bonhomia-checkout" aria-labelledby="booking-title">
            <div class="bonhomia-booking__intro">
                <p class="bonhomia-eyebrow">Reserva directa</p>
                <h2 id="booking-title">Elige fechas, genera tu cotizacion y paga con PayPal</h2>
                <p>La cotizacion vive solo durante tu sesion. La reservacion se crea hasta que PayPal confirma el pago completo.</p>
            </div>

            @if (IsLoadingAvailability)
            {
                <div class="bonhomia-loading">
                    <i class="bi bi-arrow-repeat" aria-hidden="true"></i>
                    <span>Cargando disponibilidad...</span>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(AvailabilityError))
            {
                <div class="bonhomia-alert bonhomia-alert--error">
                    <strong>No pudimos cargar el calendario.</strong>
                    <span>@AvailabilityError</span>
                    <a href="@WhatsAppUrl" target="_blank" rel="noopener noreferrer">Contactar por WhatsApp</a>
                </div>
            }
            else if (Availability is not null)
            {
                <div class="bonhomia-wizard">
                    <ol class="bonhomia-wizard__steps" aria-label="Progreso de reserva">
                        @foreach (var step in WizardSteps)
                        {
                            <li class="@GetWizardStepClass(step.Step)">
                                <button type="button"
                                        disabled="@(!CanNavigateToStep(step.Step))"
                                        @onclick="() => GoToStepAsync(step.Step)">
                                    <span>@(((int)step.Step) + 1)</span>
                                    <strong>@step.Title</strong>
                                    <small>@step.Detail</small>
                                </button>
                            </li>
                        }
                    </ol>

                    <div class="bonhomia-wizard__panel" aria-live="polite">
                        @if (!string.IsNullOrWhiteSpace(CheckoutError))
                        {
                            <div class="bonhomia-alert bonhomia-alert--error">@CheckoutError</div>
                        }

                        @if (ActiveCheckoutStep == CheckoutStep.Stay)
                        {
                            <div class="bonhomia-step">
                                <div class="bonhomia-step__header">
                                    <span>1</span>
                                    <div>
                                        <h3>Tu estancia</h3>
                                        <p>Selecciona una suite y marca llegada/salida en el calendario.</p>
                                    </div>
                                </div>

                                <div class="bonhomia-date-row">
                                    <label>
                                        <span>Check-in</span>
                                        <input type="date" value="@CheckInText" min="@TodayText" @onchange="OnCheckInChanged" />
                                    </label>
                                    <label>
                                        <span>Check-out</span>
                                        <input type="date" value="@CheckOutText" min="@MinCheckOutText" @onchange="OnCheckOutChanged" />
                                    </label>
                                    <label>
                                        <span>Huespedes</span>
                                        <input type="number" min="1" max="10" value="@Guests" @onchange="OnGuestsChanged" />
                                    </label>
                                </div>

                                <div class="bonhomia-room-picker" role="list" aria-label="Suites disponibles">
                                    @foreach (var room in Availability.Rooms)
                                    {
                                        var selected = string.Equals(room.RoomName, SelectedRoomName, StringComparison.OrdinalIgnoreCase);
                                        <button type="button"
                                                class="@(selected ? "bonhomia-room-option bonhomia-room-option--selected" : "bonhomia-room-option")"
                                                @onclick="() => SelectRoom(room.RoomName)">
                                            <img src="@room.Image" alt="@room.RoomName" />
                                            <span>@room.Tag</span>
                                            <strong>@room.RoomName</strong>
                                            <small>@room.Capacity huesped@(room.Capacity == 1 ? string.Empty : "es") · desde @FormatMoney(room.BasePrice)</small>
                                        </button>
                                    }
                                </div>

                                @if (SelectedRoom is not null)
                                {
                                    <div class="bonhomia-calendar" aria-label="Calendario publico de disponibilidad">
                                        @foreach (var month in MonthGroups)
                                        {
                                            <div class="bonhomia-month">
                                                <h4>@month.Month.ToString("MMMM yyyy", HeaderCulture)</h4>
                                                <div class="bonhomia-weekdays" aria-hidden="true">
                                                    <span>Dom</span><span>Lun</span><span>Mar</span><span>Mie</span><span>Jue</span><span>Vie</span><span>Sab</span>
                                                </div>
                                                <div class="bonhomia-days">
                                                    @for (var blank = 0; blank < month.Offset; blank++)
                                                    {
                                                        <span class="bonhomia-day bonhomia-day--blank"></span>
                                                    }
                                                    @foreach (var day in month.Days)
                                                    {
                                                        var state = GetCalendarDayState(day);
                                                        <button type="button"
                                                                class="@GetCalendarDayClass(day, state)"
                                                                disabled="@(state == DayState.Past || state == DayState.Unavailable)"
                                                                title="@GetCalendarDayTitle(day, state)"
                                                                @onclick="() => SelectCalendarDay(day)">
                                                            <span>@day.Day</span>
                                                        </button>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }

                                <div class="bonhomia-wizard__actions">
                                    <span></span>
                                    <button type="button" class="bonhomia-button bonhomia-button--dark" @onclick="GoNextAsync">
                                        <span>Continuar a extras</span>
                                        <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </div>
                        }
                        else if (ActiveCheckoutStep == CheckoutStep.Extras)
                        {
                            <div class="bonhomia-step">
                                <div class="bonhomia-step__header">
                                    <span>2</span>
                                    <div>
                                        <h3>Extras</h3>
                                        <p>Agrega servicios opcionales o continua sin extras.</p>
                                    </div>
                                </div>

                                <div class="bonhomia-extra-selector">
                                    @foreach (var extra in Availability.Extras)
                                    {
                                        <article>
                                            <i class="@extra.Icon" aria-hidden="true"></i>
                                            <div>
                                                <strong>@extra.Name</strong>
                                                <span>@extra.Detail</span>
                                                <small>@FormatMoney(extra.UnitPrice)</small>
                                            </div>
                                            <select value="@GetExtraQuantity(extra.Code)" @onchange="args => OnExtraQuantityChanged(extra.Code, args)">
                                                @for (var quantity = 0; quantity <= extra.MaxQuantity; quantity++)
                                                {
                                                    <option value="@quantity">@quantity</option>
                                                }
                                            </select>
                                        </article>
                                    }
                                </div>

                                <div class="bonhomia-wizard__actions">
                                    <button type="button" class="bonhomia-button bonhomia-button--outline" @onclick="GoBackAsync">
                                        <i class="bi bi-arrow-left" aria-hidden="true"></i>
                                        <span>Atras</span>
                                    </button>
                                    <button type="button" class="bonhomia-button bonhomia-button--dark" @onclick="GoNextAsync">
                                        <span>Revisar cotizacion</span>
                                        <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </div>
                        }
                        else if (ActiveCheckoutStep == CheckoutStep.Review)
                        {
                            <div class="bonhomia-step">
                                <div class="bonhomia-step__header">
                                    <span>3</span>
                                    <div>
                                        <h3>Cotizacion</h3>
                                        <p>Revisa tu seleccion. Si algo cambio en el calendario, el mensaje aparecera aqui mismo.</p>
                                    </div>
                                </div>

                                <div class="bonhomia-review-grid">
                                    <article class="bonhomia-review-card">
                                        <span>Suite</span>
                                        <strong>@(SelectedRoom?.RoomName ?? "Sin seleccionar")</strong>
                                        <small>@Guests huesped@(Guests == 1 ? string.Empty : "es") · @CheckIn.ToString("dd MMM", HeaderCulture) - @CheckOut.ToString("dd MMM yyyy", HeaderCulture)</small>
                                    </article>
                                    <article class="bonhomia-review-card">
                                        <span>Noches</span>
                                        <strong>@StayNights</strong>
                                        <small>La disponibilidad se valida otra vez antes de PayPal.</small>
                                    </article>
                                    <article class="bonhomia-review-card">
                                        <span>Extras</span>
                                        <strong>@SelectedExtrasCount</strong>
                                        <small>@SelectedExtrasLabel</small>
                                    </article>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(StatusMessage))
                                {
                                    <div class="bonhomia-alert bonhomia-alert--info">@StatusMessage</div>
                                }

                                @if (Quote is not null)
                                {
                                    <div class="bonhomia-alert bonhomia-alert--success">
                                        <strong>Cotizacion lista: @FormatMoney(Quote.Total)</strong>
                                        <span>Continua al pago para capturar tus datos y abrir PayPal.</span>
                                    </div>
                                }

                                <div class="bonhomia-wizard__actions">
                                    <button type="button" class="bonhomia-button bonhomia-button--outline" @onclick="GoBackAsync">
                                        <i class="bi bi-arrow-left" aria-hidden="true"></i>
                                        <span>Atras</span>
                                    </button>
                                    @if (Quote is null)
                                    {
                                        <button type="button"
                                                class="bonhomia-button bonhomia-button--dark"
                                                disabled="@IsQuoteBusy"
                                                @onclick="GenerateQuoteAsync">
                                            <i class="bi bi-receipt" aria-hidden="true"></i>
                                            <span>@(IsQuoteBusy ? "Generando..." : "Generar cotizacion")</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="bonhomia-button bonhomia-button--dark" @onclick="GoNextAsync">
                                            <span>Continuar al pago</span>
                                            <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                        else if (ActiveCheckoutStep == CheckoutStep.Payment)
                        {
                            <div class="bonhomia-step">
                                <div class="bonhomia-step__header">
                                    <span>4</span>
                                    <div>
                                        <h3>Pago y confirmacion</h3>
                                        <p>Completa tus datos. La reservacion se crea hasta que PayPal confirma el pago.</p>
                                    </div>
                                </div>

                                @if (CompletedReservation is not null)
                                {
                                    <div class="bonhomia-alert bonhomia-alert--success">
                                        <strong>Reservacion confirmada #@CompletedReservation.ReservationId</strong>
                                        <span>Gracias, @CompletedReservation.ClientName. Recibimos @FormatMoney(CompletedReservation.Total).</span>
                                    </div>
                                }
                                else if (Quote is null)
                                {
                                    <div class="bonhomia-alert bonhomia-alert--warning">
                                        La cotizacion ya no esta activa. Regresa al paso anterior para generar una nueva.
                                    </div>
                                }
                                else
                                {
                                    <div class="bonhomia-payment-grid">
                                        <div class="bonhomia-customer-form">
                                            <label>
                                                <span>Nombre completo</span>
                                                <input value="@Customer.FullName" @oninput="args => OnCustomerChanged(nameof(Customer.FullName), args.Value?.ToString())" autocomplete="name" />
                                            </label>
                                            <label>
                                                <span>Correo</span>
                                                <input type="email" value="@Customer.Email" @oninput="args => OnCustomerChanged(nameof(Customer.Email), args.Value?.ToString())" autocomplete="email" />
                                            </label>
                                            <label>
                                                <span>Telefono</span>
                                                <input type="tel" value="@Customer.Phone" @oninput="args => OnCustomerChanged(nameof(Customer.Phone), args.Value?.ToString())" autocomplete="tel" />
                                            </label>
                                            <label class="bonhomia-policy-check">
                                                <input type="checkbox" checked="@AcceptedPolicies" @onchange="OnPoliciesChanged" />
                                                <span>Acepto politicas de check-in, cancelacion y convivencia.</span>
                                            </label>
                                        </div>

                                        <aside class="bonhomia-summary" aria-label="Resumen de cotizacion">
                                            <div class="bonhomia-summary__card">
                                                <h3>Resumen</h3>
                                                <img src="@Quote.RoomImage" alt="@Quote.RoomName" />
                                                <div class="bonhomia-summary__title">
                                                    <strong>@Quote.RoomName</strong>
                                                    <span>@Quote.CheckIn.ToString("dd MMM", HeaderCulture) - @Quote.CheckOut.ToString("dd MMM yyyy", HeaderCulture)</span>
                                                </div>

                                                <div class="bonhomia-summary__lines">
                                                    @foreach (var line in Quote.Lines)
                                                    {
                                                        <div>
                                                            <span>@line.Description</span>
                                                            <strong>@FormatMoney(line.Total)</strong>
                                                        </div>
                                                    }
                                                </div>

                                                <div class="bonhomia-summary__totals">
                                                    <div><span>Subtotal</span><strong>@FormatMoney(Quote.SubTotal)</strong></div>
                                                    <div><span>IVA</span><strong>@FormatMoney(Quote.Tax)</strong></div>
                                                    @if (Quote.Ish > 0m)
                                                    {
                                                        <div><span>ISH</span><strong>@FormatMoney(Quote.Ish)</strong></div>
                                                    }
                                                    <div class="bonhomia-summary__grand"><span>Total</span><strong>@FormatMoney(Quote.Total)</strong></div>
                                                </div>

                                                <p class="bonhomia-summary__expires">Cotizacion valida hasta @Quote.ExpiresAtUtc.LocalDateTime.ToString("HH:mm", HeaderCulture).</p>

                                                @if (!string.IsNullOrWhiteSpace(StatusMessage))
                                                {
                                                    <div class="bonhomia-alert bonhomia-alert--info">@StatusMessage</div>
                                                }

                                                @if (!CheckoutOptions.Value.IsPayPalConfigured)
                                                {
                                                    <div class="bonhomia-alert bonhomia-alert--warning">
                                                        PayPal aun no esta configurado. La cotizacion esta lista para probar el flujo y se puede confirmar por WhatsApp.
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="bonhomia-paypal-gate">
                                                        @if (!CanRenderPayPal)
                                                        {
                                                            <p>@(PaymentConfirmationFailed ? "El pago necesita revision. Para evitar un doble cargo, genera una nueva cotizacion solo despues de revisar PayPal." : "Completa tus datos y acepta politicas para activar PayPal.")</p>
                                                        }
                                                        <div id="@PayPalContainerId" class="bonhomia-paypal-container" aria-live="polite"></div>
                                                        @if (PaymentConfirmationFailed && !string.IsNullOrWhiteSpace(PendingPayPalOrderId))
                                                        {
                                                            <button class="bonhomia-button bonhomia-button--primary" type="button" @onclick="RetryPendingPayPalConfirmationAsync" disabled="@IsPaymentProcessing">
                                                                <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
                                                                <span>@(IsPaymentProcessing ? "Revisando pago..." : "Revisar pago en PayPal")</span>
                                                            </button>
                                                        }
                                                    </div>
                                                }

                                                <a class="bonhomia-button bonhomia-button--outline bonhomia-summary__whatsapp" href="@WhatsAppUrl" target="_blank" rel="noopener noreferrer">
                                                    <i class="bi bi-whatsapp" aria-hidden="true"></i>
                                                    <span>Resolver por WhatsApp</span>
                                                </a>
                                            </div>
                                        </aside>
                                    </div>
                                }

                                <div class="bonhomia-wizard__actions">
                                    <button type="button" class="bonhomia-button bonhomia-button--outline" @onclick="GoBackAsync">
                                        <i class="bi bi-arrow-left" aria-hidden="true"></i>
                                        <span>Atras</span>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </section>

        <section class="bonhomia-section bonhomia-intro" aria-labelledby="intro-title">
            <div class="bonhomia-section__header">
                <p class="bonhomia-eyebrow">Hospedaje con caracter</p>
                <h2 id="intro-title">Comodidad de casa, operacion profesional</h2>
                <p>Bonhomia Suites combina privacidad, blancos listos, amenidades de cortesia, Wi-Fi, agua caliente y limpieza profesional entre estancias.</p>
            </div>

            <div class="bonhomia-intro__media">
                <img src="/Images/Bonhomia/gallery-terrace-living.jpg" alt="Sala amueblada con terraza en Bonhomia Suites" />
                <img src="/Images/Bonhomia/gallery-kitchen.jpg" alt="Cocina equipada en Bonhomia Suites" />
                <img src="/Images/Bonhomia/exterior-main.jpg" alt="Exterior de edificio Bonhomia Suites en Calpulalpan" />
            </div>
        </section>

        <section id="suites" class="bonhomia-section bonhomia-suites" aria-labelledby="suites-title">
            <div class="bonhomia-section__header">
                <p class="bonhomia-eyebrow">Nuestras suites</p>
                <h2 id="suites-title">Elige por capacidad, privacidad y plan de viaje</h2>
                <p>Cada espacio tiene personalidad propia. Las tarifas son por noche, en MXN, y pueden variar por temporada o disponibilidad.</p>
            </div>

            <div class="bonhomia-suite-grid">
                @foreach (var suite in PublicRooms)
                {
                    <article class="bonhomia-suite-card">
                        <img src="@suite.Image" alt="@($"Vista de referencia para {suite.Name}")" />
                        <div class="bonhomia-suite-card__body">
                            <div class="bonhomia-suite-card__topline">
                                <span>@suite.Tag</span>
                                <strong>@FormatMoney(suite.Price)</strong>
                            </div>
                            <h3>@suite.Name</h3>
                            <p>@suite.Ideal</p>
                            <div class="bonhomia-suite-card__meta">
                                <span><i class="bi bi-people" aria-hidden="true"></i>@suite.Capacity personas</span>
                                <span><i class="bi bi-moon" aria-hidden="true"></i>@suite.Bedrooms recamara@(suite.Bedrooms == 1 ? string.Empty : "s")</span>
                            </div>
                        </div>
                    </article>
                }
            </div>
        </section>

        <section class="bonhomia-section bonhomia-gallery" aria-labelledby="gallery-title">
            <div class="bonhomia-section__header">
                <p class="bonhomia-eyebrow">Instalaciones</p>
                <h2 id="gallery-title">Espacios pensados para instalarte de inmediato</h2>
            </div>

            <div class="bonhomia-gallery__grid">
                <img src="/Images/Bonhomia/gallery-lounge.jpg" alt="Sala principal en suite amueblada" />
                <img src="/Images/Bonhomia/gallery-wine-detail.jpg" alt="Detalle de mesa y copa en Bonhomia Suites" />
                <img src="/Images/Bonhomia/exterior-vertical.jpg" alt="Fachada vertical de Bonhomia Suites" />
                <img src="/Images/Bonhomia/welcome-detail.png" alt="Detalle de bienvenida Bonhomia Suites" />
            </div>
        </section>

        <section id="tarifas" class="bonhomia-section bonhomia-rate-strip" aria-labelledby="rates-title">
            <div class="bonhomia-section__header">
                <p class="bonhomia-eyebrow">Tarifas y servicios</p>
                <h2 id="rates-title">Extras que se ajustan a tu estancia</h2>
            </div>

            <div id="servicios" class="bonhomia-extra-grid">
                @foreach (var extra in PublicExtras)
                {
                    <article class="bonhomia-extra-card">
                        <i class="@extra.Icon" aria-hidden="true"></i>
                        <h3>@extra.Name</h3>
                        <p>@extra.Detail</p>
                        <strong>@extra.Price</strong>
                    </article>
                }
            </div>
        </section>

        <section class="bonhomia-section bonhomia-policy" aria-labelledby="policy-title">
            <div class="bonhomia-policy__main">
                <p class="bonhomia-eyebrow">Politicas claras</p>
                <h2 id="policy-title">Reserva con informacion completa</h2>
                <p>Check-in estandar a partir de las 15:00 hrs y check-out hasta las 11:00 hrs. Las cancelaciones con mas de 30 dias de anticipacion pueden recibir reembolso neto del 85%; con 30 dias o menos son no reembolsables salvo condiciones especificas confirmadas al reservar.</p>
            </div>

            <div class="bonhomia-policy__items">
                <div>
                    <img src="/Images/Bonhomia/catalog-checkin.png" alt="" />
                    <span>Early y late options sujetas a disponibilidad</span>
                </div>
                <div>
                    <img src="/Images/Bonhomia/catalog-cancellation.png" alt="" />
                    <span>Cancelaciones por el mismo canal de reservacion</span>
                </div>
                <div>
                    <img src="/Images/Bonhomia/catalog-why.png" alt="" />
                    <span>Reglas de convivencia para descanso y seguridad</span>
                </div>
            </div>
        </section>

        <section id="contacto" class="bonhomia-section bonhomia-contact" aria-labelledby="contact-title">
            <div>
                <p class="bonhomia-eyebrow">Contacto</p>
                <h2 id="contact-title">Te esperamos en Calpulalpan</h2>
                <p>Carr. Mexico-Veracruz km 74, 90202 Heroica Ciudad de Calpulalpan, Tlaxcala, Mexico.</p>
            </div>

            <div class="bonhomia-contact__actions">
                <a class="bonhomia-button bonhomia-button--primary" href="@WhatsAppUrl" target="_blank" rel="noopener noreferrer">
                    <i class="bi bi-whatsapp" aria-hidden="true"></i>
                    <span>WhatsApp +52 749 110 3026</span>
                </a>
                <a class="bonhomia-button bonhomia-button--outline" href="mailto:recepcion@bonhomiasuites.com">
                    <i class="bi bi-envelope" aria-hidden="true"></i>
                    <span>recepcion@bonhomiasuites.com</span>
                </a>
            </div>
        </section>
    </main>

    <footer class="bonhomia-footer">
