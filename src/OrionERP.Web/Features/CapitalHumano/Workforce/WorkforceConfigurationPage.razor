  private AttendancePolicySaveRequest ToRequest(AttendancePolicyDto item)=>new(){Id=item.Id,Rfc=Rfc,Code=item.Code,Name=item.Name,EffectiveFrom=item.EffectiveFrom,EffectiveTo=item.EffectiveTo,WeeklyOrdinaryMinutes=item.WeeklyOrdinaryMinutes,WeeklyDoubleOvertimeMinutes=item.WeeklyDoubleOvertimeMinutes,WeeklyTripleOvertimeMinutes=item.WeeklyTripleOvertimeMinutes,GraceMinutes=item.GraceMinutes,RoundingMinutes=item.RoundingMinutes,LocationRequired=item.LocationRequired,IsActive=item.IsActive,RequiresReview=item.RequiresReview};
  private static AttendancePolicySaveRequest NewPolicy()=>new(){EffectiveFrom=DateOnly.FromDateTime(DateTime.Today),GraceMinutes=5,RoundingMinutes=1,LocationRequired=true,IsActive=true,RequiresReview=true};
  private static int ToMinutes(decimal hours)=>(int)Math.Round(hours*60m,MidpointRounding.AwayFromZero);
  private static decimal ToHours(int minutes)=>Math.Round(minutes/60m,2,MidpointRounding.AwayFromZero);
  private static string FormatHours(int minutes)=>ToHours(minutes).ToString("0.##",System.Globalization.CultureInfo.CurrentCulture);
