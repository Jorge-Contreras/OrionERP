@inherits LayoutComponentBase
@inject IJSRuntime Js

<div class="bonhomia-public-shell">
    <header class="bonhomia-public-nav" aria-label="Bonhomia Suites">
        <a class="bonhomia-public-brand" href="/" aria-label="Bonhomia Suites inicio">
            <img src="/Images/Bonhomia/logo-vertical.png" alt="Bonhomia Suites" />
            <span>Bonhomia Suites</span>
        </a>

        <nav class="bonhomia-public-nav__links" aria-label="Navegacion principal">
            <NavLink href="/" Match="NavLinkMatch.All">Inicio</NavLink>
            <NavLink href="/suites">Suites</NavLink>
            <NavLink href="/servicios">Servicios</NavLink>
            <NavLink href="/preguntas-frecuentes">FAQ</NavLink>
            <NavLink href="/contacto">Contacto</NavLink>
        </nav>

        <a class="bonhomia-public-nav__cta" href="/reservar">
            <i class="bi bi-calendar-check" aria-hidden="true"></i>
            <span>Reservar</span>
        </a>
    </header>

    @Body

    <footer class="bonhomia-public-footer">
        <div class="bonhomia-public-footer__brand">
            <img src="/Images/Bonhomia/logo-letterhead.svg" alt="Bonhomia Suites" />
            <p>Suites y casas amuebladas para viajes de trabajo, familia y agenda profesional en Calpulalpan.</p>
        </div>

        <nav aria-label="Documentos Bonhomia">
            <a href="/legal">Centro legal</a>
            <a href="/legal#politicas-reserva">Politicas de reserva</a>
            <a href="/legal#terminos-condiciones">Terminos y condiciones</a>
            <a href="/legal#aviso-privacidad">Aviso de privacidad</a>
            <a href="/preguntas-frecuentes">Preguntas frecuentes</a>
        </nav>

        <div class="bonhomia-public-footer__contact">
            <span>@BonhomiaSiteContent.Address</span>
            <a href='@BonhomiaSiteContent.WhatsAppUrl("Hola Bonhomia Suites, quiero informacion para una estancia.")' target="_blank" rel="noopener noreferrer">WhatsApp @BonhomiaSiteContent.WhatsAppDisplay</a>
            <a href="mailto:@BonhomiaSiteContent.Email">@BonhomiaSiteContent.Email</a>
            <a href="/erp">Portal OrionERP</a>
        </div>
    </footer>

    <aside class="bonhomia-legal-ack" data-bonhomia-legal-ack="@BonhomiaSiteContent.LegalVersion" aria-label="Reconocimiento de documentos legales">
        <p>
            <strong>Centro legal Bonhomia.</strong>
            Aviso de privacidad, terminos, politicas y reglas de hospedaje version @BonhomiaSiteContent.LegalVersion.
            <a href="/legal">Leer</a>
        </p>
        <button type="button" class="bonhomia-legal-ack__button" data-bonhomia-legal-accept>
            Aceptar
        </button>
    </aside>
</div>

@code {
  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (!firstRender)
    {
      return;
    }

    try
    {
      await Js.InvokeVoidAsync("bonhomiaLegal.initAcknowledgement", BonhomiaSiteContent.LegalVersion);
    }
    catch
    {
      // The site remains usable if browser storage is unavailable.
    }
  }
}
