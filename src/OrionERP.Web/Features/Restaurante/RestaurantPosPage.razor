  /// <summary>
  /// El mismo análisis que produce el Excel de diagnóstico, proyectado por material para operarlo
  /// en caja. No corre en un temporizador: recorre todas las existencias del RFC y repetirlo por
  /// cada caja abierta saldría caro. Se recalcula al abrir el POS, al cambiar de sede, después de
  /// cada venta y cuando el usuario lo pide.
  /// </summary>
  private async Task RefreshSaleAlertsAsync()
  {
    if (catalog is null || selectedSiteId <= 0 || isAnalyzingAlerts) return;
    isAnalyzingAlerts = true;
    saleAlertsError = null;
    try
    {
      var report = await SaleReadinessService.AnalyzeAsync(CurrentRfc, selectedSiteId, DateTimeOffset.UtcNow);
      saleAlerts = RestaurantSaleAlertBuilder.Build(report);
    }
    catch (Exception ex)
    {
      // No se escribe en `error`: ese renglón es para lo que impide cobrar, y un diagnóstico caído
      // no debe tapar el mensaje de una venta.
      saleAlertsError = $"No se pudo analizar el inventario: {ex.Message}";
    }
    finally
    {
      isAnalyzingAlerts = false;
    }
  }

  private async Task OpenSaleAlertsAsync()
  {
    isSaleAlertsOpen = true;
    if (saleAlerts is null) await RefreshSaleAlertsAsync();
  }

  private void CloseSaleAlerts() => isSaleAlertsOpen = false;

  private async Task DownloadSaleReadinessAsync()
  {
    if (catalog is null || selectedSiteId <= 0 || isDownloadingReadiness) return;
    isDownloadingReadiness = true;
    error = null;
    try
    {
      var report = await SaleReadinessService.AnalyzeAsync(CurrentRfc, selectedSiteId, DateTimeOffset.UtcNow);
      var workbook = SaleReadinessWorkbookService.Create(report);
      var dataUrl = $"data:{workbook.ContentType};base64,{Convert.ToBase64String(workbook.Bytes)}";
      await Js.InvokeVoidAsync("triggerFileDownload", workbook.FileName, dataUrl);
    }
    catch (Exception ex)
    {
      error = $"No se pudo generar el diagnóstico de venta: {ex.Message}";
    }
    finally
    {
      isDownloadingReadiness = false;
    }
  }

