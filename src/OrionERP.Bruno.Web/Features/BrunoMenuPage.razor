@page "/menu"
@inject IBrunoPublicCatalogService CatalogService

<PageTitle>Menú · Bruno's Garden & Snacks</PageTitle>
<HeadContent><meta name="description" content="Consulta el menú, precios y disponibilidad de Bruno's Garden & Snacks en Calpulalpan." /></HeadContent>

<section class="page-hero page-hero--menu"><span>Hecho para el antojo</span><h1>Nuestro menú</h1><p>Precios y disponibilidad se actualizan desde la operación del restaurante.</p></section>

@if (isLoading)
{
  <section class="state-card"><h2>Cargando el menú…</h2></section>
}
else if (catalog is null)
{
  <section class="state-card"><h2>Estamos preparando el menú</h2><p>Vuelve pronto o escríbenos por WhatsApp para consultar disponibilidad.</p></section>
}
else
{
  <nav class="section-jump" aria-label="Secciones del menú">
    @* Absolute path, not a bare fragment: <base href="/"> would resolve "#x" against the site root. *@
    @foreach (var section in catalog.Menu.Sections) { <a href="/menu#@Slug(section.Name)" target="_top">@section.Name</a> }
  </nav>
  <div class="menu-page">
    @foreach (var section in catalog.Menu.Sections)
    {
      <section id="@Slug(section.Name)" class="menu-section">
        <header><span>Bruno's</span><h2>@section.Name</h2></header>
        <div class="menu-grid">
          @foreach (var product in section.Products)
          {
            <article class="menu-card @(product.ProductKind == RestaurantProductKinds.Combo ? "is-combo" : null) @(product.IsSoldOut ? "is-sold-out" : null)">
              <div class="menu-card__image">
                @if (product.HasImage)
                {
                  <img class="menu-card__image-backdrop" src="/media/productos/@product.Id?thumbnail=false" alt="" aria-hidden="true" loading="lazy" decoding="async" />
                  <img class="menu-card__image-main" src="/media/productos/@product.Id?thumbnail=false" alt="@product.Name" loading="lazy" decoding="async" />
                }
                else { <span>Bruno's</span> }
                @if (product.IsSoldOut) { <b>Agotado por hoy</b> }
              </div>
              <div class="menu-card__copy">
                @if (product.ProductKind == RestaurantProductKinds.Combo) { <span class="menu-card__combo-badge">Combo</span> }
                <h3>@product.Name</h3><strong>@(product.ProductKind == RestaurantProductKinds.Combo ? $"Desde {product.Price:C0}" : product.Price.ToString("C0"))</strong><p>@product.Description</p>
                @if (product.ProductKind == RestaurantProductKinds.Combo && product.ComboSlots.Count > 0)
                {
                  <div class="menu-card__combo-summary" aria-label="Contenido del combo">
                    <b>Arma tu combo</b>
                    <ul>@foreach(var slot in product.ComboSlots.Where(item=>item.IsActive).OrderBy(item=>item.SortOrder)){<li><strong>@slot.Name</strong> @ComboSlotSummary(slot)</li>}</ul>
                    <small>Cada línea es a elegir, no se sirven todas las opciones. Personalízalo al ordenar en caja y los suplementos se indican antes de cobrar.</small>
                  </div>
                }
                @if (product.Allergens.Count > 0) { <small>Alérgenos declarados: @string.Join(", ", product.Allergens).</small> }
                @if (product.DietaryTags.Count > 0) { <small>Etiquetas: @string.Join(", ", product.DietaryTags). Consulta al personal para confirmar preparación y contacto cruzado.</small> }
              </div>
            </article>
          }
        </div>
      </section>
    }
    <aside class="allergen-note"><strong>Información de alérgenos</strong><p>@(string.IsNullOrWhiteSpace(catalog.Menu.Site.CrossContaminationWarning) ? "Consulta a nuestro personal antes de ordenar; los ingredientes y procesos pueden cambiar." : catalog.Menu.Site.CrossContaminationWarning)</p></aside>
  </div>
}

@code {
  private BrunoPublicCatalogDto? catalog;
  private bool isLoading = true;
  protected override async Task OnInitializedAsync()
  {
    try { catalog = await CatalogService.GetCatalogAsync(BrunoSiteConstants.Rfc, BrunoSiteConstants.SiteCode, DateTimeOffset.Now); }
    finally { isLoading = false; }
  }
  private static string ComboSlotSummary(RestaurantComboSlotDto slot)
  {
    var options=slot.Options.Where(item=>item.IsActive).OrderBy(item=>item.SortOrder).Select(item=>item.PriceDelta>0?$"{item.ComponentProductName} +{item.PriceDelta:C0}":item.ComponentProductName).ToList();
    if (options.Count==0) { return "(consulta disponibilidad)"; }
    return slot.MaxSelections>1
      ? $"({ComboSlotInstruction(slot)}: {string.Join(" · ",options)})"
      : slot.MinSelections==0 ? $"(opcional: {string.Join(" o ",options)})" : $"({string.Join(" o ",options)})";
  }
  private static string ComboSlotInstruction(RestaurantComboSlotDto slot)
    => slot.MinSelections==0 ? $"opcional, elige hasta {slot.MaxSelections}"
      : slot.MinSelections==slot.MaxSelections ? $"elige {slot.MinSelections}"
      : $"elige {slot.MinSelections}–{slot.MaxSelections}";
  private static string Slug(string value) => new(value.ToLowerInvariant().Select(character => char.IsLetterOrDigit(character) ? character : '-').ToArray());
}
