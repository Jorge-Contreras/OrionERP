@using OrionERP.Application.Features.Cfdi.DeclaracionPrevia

@using System
@using System.Linq

<div class="cfdi-table">
    <details class="cfdi-table__filters" closed>
        <summary>Filtros</summary>
        <div class="cfdi-table__filters-body">
            <div class="cfdi-table__toolbar">
                <button class="btn btn-outline-primary btn-sm me-2" @onclick="ApplyTotalDifferentFromPolizasFilter">
                    Total &lt;&gt; Polizas
                </button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="ClearFilters" disabled="@(!HasActiveFilters)">
                    Borrar filtros
                </button>
            </div>
            <div class="cfdi-table__filters-table">
                <table class="table table-sm table-bordered table-striped align-middle compact-table cfdi-table__table cfdi-table__filter-table">
                    @RenderColumnGroup()
                    <thead class="table-secondary filter-row">
                        <tr>
                            <th></th>
                            <th></th>
                            <th>
                                <select class="form-select form-select-sm" value="@_checkStatusFilter" @onchange="OnCheckStatusChanged">
                                    <option value="">Todos</option>
                                    <option value="checked">✔</option>
                                    <option value="unchecked">X</option>
                                </select>
                            </th>
                            <th>
                                @RenderSortSelect("Fecha")
                            </th>
                            <th></th>
                            <th></th>
                            <th>
                                @RenderMultiSelect(CounterpartyOptions, _selectedCounterparties, OnCounterpartyFilterChanged)
                            </th>
                            <th>@RenderSortSelect("SubTotal")</th>
                            <th>@RenderSortSelect("Descuento")</th>
                            <th>@RenderSortSelect("SubTotal_Desc")</th>
                            <th>@RenderSortSelect("Actos_16")</th>
                            <th>@RenderSortSelect("Actos_0")</th>
                            <th>@RenderSortSelect("IVA")</th>
                            <th>@RenderSortSelect("IEPS")</th>
                            <th>@RenderSortSelect("IVA_RETENIDO")</th>
                            <th>@RenderSortSelect("ISR_RETENIDO")</th>
                            <th>@RenderSortSelect("IEPS_RETENIDO")</th>
                            <th>@RenderSortSelect("Total")</th>
                            <th></th>
                            <th>
                                @RenderMultiSelect(FormaPagoOptions, _selectedFormaPago, OnFormaPagoFilterChanged)
                            </th>
                            <th>
                                @RenderMultiSelect(TipoCfdiOptions, _selectedTipoCfdi, OnTipoCfdiFilterChanged)
                            </th>
                            <th>
                                @RenderMultiSelect(MetodoPagoOptions, _selectedMetodoPago, OnMetodoPagoFilterChanged)
                            </th>
                            <th>
                                @RenderMultiSelect(UsoCfdiOptions, _selectedUsoCfdi, OnUsoCfdiFilterChanged)
                            </th>
                            <th>
                                @RenderSortSelect("FechaCancelacion")
                            </th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </details>
    <div class="cfdi-table__viewport">
        <table class="table table-sm table-bordered table-striped align-middle compact-table cfdi-table__table cfdi-table__main-table">
            @RenderColumnGroup()
            <thead class="table-dark">
                <tr>
                    <th>CFDI</th>
                    <th>Poliza</th>
                    <th>✔</th>
                    <th>Fecha</th>
                    <th>Mes</th>
                    <th>Año</th>
                    <th>@CounterpartyHeader</th>
                    <th class="num">SubTotal</th>
                    <th class="num">Descuento</th>
                    <th class="num">SubTotal_Desc</th>
                    <th class="num">Actos16%</th>
                    <th class="num">Actos0%</th>
                    <th class="num">IVA</th>
                    <th class="num">IEPS</th>
                    <th class="num">IVA Retenido</th>
                    <th class="num">ISR Retenido</th>
                    <th class="num">IEPS Retenido</th>
                    <th class="num">Total</th>
                    <th>UUID</th>
                    <th>Forma Pago</th>
                    <th>Tipo CFDI</th>
                    <th>Método Pago</th>
                    <th>Uso CFDI</th>
                    <th>Fecha Cancel.</th>
                    <th>Estatus</th>
                    <th>Transacción Fechas</th>
                    <th class="num">Suma Polizas</th>
                    <th class="num">XML Attachment ID</th>
                </tr>
            </thead>
            <tbody>
                @if (_filteredItems.Any())
                {
                    foreach (var item in _pagedItems)
                    {
                        <tr @onclick="() => HandleRowClick(item)"
                            class="@GetRowClass(item)"
                            style="cursor:pointer;">
                            @if (ActionButtonsTemplate is not null)
                            {
                                @ActionButtonsTemplate(item)
                            }
                            else
                            {
                                <ActionButtons Item="item"
                                               />
                            }
                            <td>@item.D</td>
                            <td>@item.Fecha.ToString("yyyy-MM-dd")</td>
                            <td>@item.MES_GLOBAL</td>
                            <td>@item.ANIO_GLOBAL</td>
                            <td>@CounterpartySelector(item)</td>
                            <td class="num">@FormatCurrency(item.SubTotal)</td>
                            <td class="num">@FormatCurrency(item.Descuento)</td>
                            <td class="num">@FormatCurrency(item.SubTotal_Desc)</td>
                            <td class="num">@FormatCurrency(item.Actos_16)</td>
                            <td class="num">@FormatCurrency(item.Actos_0)</td>
                            <td class="num">@FormatCurrency(item.IVA)</td>
                            <td class="num">@FormatCurrency(item.IEPS)</td>
                            <td class="num">@FormatCurrency(item.IVA_RETENIDO)</td>
                            <td class="num">@FormatCurrency(item.ISR_RETENIDO)</td>
                            <td class="num">@FormatCurrency(item.IEPS_RETENIDO)</td>
                            <td class="num">@FormatCurrency(item.Total)</td>
                            <td>@item.FOLIO_FISCAL</td>
                            <td>@item.FormaPago</td>
                            <td>@item.TipoDeComprobante</td>
                            <td>@item.MetodoPago</td>
                            <td>@item.UsoCFDI</td>
                            <td>@(item.FechaCancelacion.HasValue ? item.FechaCancelacion.Value.ToString("yyyy-MM-dd") : string.Empty)</td>
                            <td>@item.Estatus</td>
                            <td>@item.fechastransacciones</td>
                            <td class="num">@FormatInteger(item.SumaPolizas)</td>
                            <td class="num">@item.XML_Attachment_ID</td>
                        </tr>
                        if (DetailsTemplate is not null)
                        {
                            var detailsContent = DetailsTemplate(item);
                            if (detailsContent is not null)
                            {
                                <tr class="table-secondary">
                                    <td colspan="@EffectiveColumnCount">
                                        @detailsContent
                                    </td>
                                </tr>
                            }
                        }
                    }
                }
                else
                {
                    <tr>
                        <td colspan="@EffectiveColumnCount" class="text-center">@NoDataMessage</td>
                    </tr>
                }
            </tbody>
        </table>

    </div>
    <div class="d-flex justify-content-between align-items-center cfdi-table__pagination">
        <small>Mostrando página @_currentPage de @_pageCount</small>
        <div class="btn-group" role="group" aria-label="Paginación CFDIs">
            <button class="btn btn-sm btn-outline-secondary" @onclick="PreviousPage" disabled="@(_currentPage <= 1)">Anterior</button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="NextPage" disabled="@(_currentPage >= _pageCount)">Siguiente</button>
        </div>
    </div>

    @if (DisplayTotals is not null)
    {
        <div class="cfdi-table__totals">
            <table class="table table-sm table-bordered table-striped align-middle compact-table cfdi-table__table cfdi-table__totals-table">
                @RenderColumnGroup()
                <tbody>
                    <tr class="table-light totals">
                        <td colspan="4"><strong># CFDIs:</strong> @DisplayTotals.CountCFDIs</td>
                        <td><strong>Totales:</strong></td>
                        <td></td>
                        <td></td>
                        <td class="num">@DisplayTotals.SumSubTotal.ToString("N2")</td>
                        <td class="num">@DisplayTotals.SumDescuento.ToString("N2")</td>
                        <td class="num">@DisplayTotals.SumSubTotalDesc.ToString("N2")</td>
                        <td class="num">@DisplayTotals.SumActos16.ToString("N2")</td>
                        <td class="num">@DisplayTotals.SumActos0.ToString("N2")</td>
                        <td class="num">@DisplayTotals.SumIVA.ToString("N2")</td>
                        <td class="num">@DisplayTotals.SumIEPS.ToString("N2")</td>
                        <td class="num">@DisplayTotals.SumIVA_RETENIDO.ToString("N2")</td>
                        <td class="num">@DisplayTotals.SumISR_RETENIDO.ToString("N2")</td>
                        <td class="num">@DisplayTotals.SumIEPS_RETENIDO.ToString("N2")</td>
                        <td class="num">@DisplayTotals.SumTotal.ToString("N2")</td>
                        <td colspan="@RemainingColumns"></td>
                    </tr>
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private const int BaseColumnCount = 28;
    private const decimal TotalPolizasTolerance = 2m;
    private static readonly IReadOnlyList<string?> BaseColumnWidths = new List<string?>
    {
        "8rem", // Acciones
        "6rem", // Poliza
        "3rem", // ✔
        "10ch", // Fecha
        "5ch", // Mes
        "6ch", // Año
        "50ch", // Counterparty
        "14ch", // SubTotal
        "14ch", // Descuento
        "15ch", // SubTotal_Desc
        "14ch", // Actos16%
        "14ch", // Actos0%
        "14ch", // IVA
        "14ch", // IEPS
        "14ch", // IVA Retenido
        "14ch", // ISR Retenido
        "15ch", // IEPS Retenido
        "14ch", // Total
        "38ch", // UUID
        "12ch", // Forma Pago
        "12ch", // Tipo CFDI
        "12ch", // Método Pago
        "12ch", // Uso CFDI
        "15ch", // Fecha Cancel.
        "11ch", // Estatus
        "26ch", // Transacción Fechas
        "14ch", // Suma Polizas
        "19ch"  // XML Attachment ID
    };

    [Parameter]
    public IEnumerable<DeclaracionCfdiBase>? Items { get; set; }

    [Parameter]
    public int PageSize { get; set; } = 50;

    [Parameter]
    public DeclaracionTotales? Totals { get; set; }

    [Parameter]
    public EventCallback<DeclaracionCfdiBase> OnRowClick { get; set; }

    [Parameter]
    public Func<DeclaracionCfdiBase, string?>? RowClassResolver { get; set; }

    [Parameter]
    public string CounterpartyHeader { get; set; } = "Receptor";

    [Parameter]
    public Func<DeclaracionCfdiBase, string?> CounterpartySelector { get; set; } = item => item.RECEPTOR;

    [Parameter]
    public RenderFragment<DeclaracionCfdiBase>? DetailsTemplate { get; set; }

    [Parameter]
    public RenderFragment<DeclaracionCfdiBase>? ActionButtonsTemplate { get; set; }

    [Parameter]
    public string NoDataMessage { get; set; } = "No se encontraron CFDIs.";

    private int EffectiveColumnCount => BaseColumnCount;

    private int RemainingColumns => Math.Max(0, EffectiveColumnCount - 18);

    private readonly List<DeclaracionCfdiBase> _originalItems = new();
    private List<DeclaracionCfdiBase> _filteredItems = new();
    private IReadOnlyList<DeclaracionCfdiBase> _pagedItems = Array.Empty<DeclaracionCfdiBase>();
    private int _currentPage = 1;
    private int _pageCount = 1;
    private string _checkStatusFilter = string.Empty;
    private HashSet<string> _selectedCounterparties = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> _selectedFormaPago = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> _selectedTipoCfdi = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> _selectedMetodoPago = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> _selectedUsoCfdi = new(StringComparer.OrdinalIgnoreCase);
    private bool _filterTotalDifferentFromPolizas;

    private readonly Dictionary<string, string> _sortSelections = new(StringComparer.OrdinalIgnoreCase)
    {
        ["Fecha"] = string.Empty,
        ["SubTotal"] = string.Empty,
        ["Descuento"] = string.Empty,
        ["SubTotal_Desc"] = string.Empty,
        ["Actos_16"] = string.Empty,
        ["Actos_0"] = string.Empty,
        ["IVA"] = string.Empty,
        ["IEPS"] = string.Empty,
        ["IVA_RETENIDO"] = string.Empty,
        ["ISR_RETENIDO"] = string.Empty,
        ["IEPS_RETENIDO"] = string.Empty,
        ["Total"] = string.Empty,
        ["FechaCancelacion"] = string.Empty
    };

    private static readonly IReadOnlyList<string> SortColumnOrder = new List<string>
    {
        "Fecha",
        "SubTotal",
        "Descuento",
        "SubTotal_Desc",
        "Actos_16",
        "Actos_0",
        "IVA",
        "IEPS",
        "IVA_RETENIDO",
        "ISR_RETENIDO",
        "IEPS_RETENIDO",
        "Total",
        "FechaCancelacion"
    };

    private static readonly Dictionary<string, Func<DeclaracionCfdiBase, IComparable?>> SortSelectors = new()
    {
        ["Fecha"] = item => item.Fecha,
        ["SubTotal"] = item => item.SubTotal,
        ["Descuento"] = item => item.Descuento,
        ["SubTotal_Desc"] = item => item.SubTotal_Desc,
        ["Actos_16"] = item => item.Actos_16,
        ["Actos_0"] = item => item.Actos_0,
        ["IVA"] = item => item.IVA,
        ["IEPS"] = item => item.IEPS,
        ["IVA_RETENIDO"] = item => item.IVA_RETENIDO,
        ["ISR_RETENIDO"] = item => item.ISR_RETENIDO,
        ["IEPS_RETENIDO"] = item => item.IEPS_RETENIDO,
        ["Total"] = item => item.Total,
        ["FechaCancelacion"] = item => item.FechaCancelacion ?? DateTime.MinValue
    };

    private DeclaracionTotales? DisplayTotals
    {
        get
        {
            if (Items is null)
            {
                return Totals;
            }

            if (!HasActiveFilters && Totals is not null)
            {
                return Totals;
            }

            return CalculateTotals(_filteredItems);
        }
    }

    protected override void OnParametersSet()
    {
        _originalItems.Clear();
        if (Items is not null)
        {
            _originalItems.AddRange(Items);
        }
        _currentPage = 1;
        ApplyFiltersAndSorting();
    }

    private RenderFragment RenderColumnGroup() => builder =>
    {
        var sequence = 0;
        var widths = GetEffectiveColumnWidths().ToList();

        builder.OpenElement(sequence++, "colgroup");
        for (var i = 0; i < EffectiveColumnCount; i++)
        {
            builder.OpenElement(sequence++, "col");
            if (i < widths.Count && !string.IsNullOrEmpty(widths[i]))
            {
                builder.AddAttribute(sequence++, "style", $"width:{widths[i]}");
            }
            builder.CloseElement();
        }

        builder.CloseElement();
    };

    private IEnumerable<string?> GetEffectiveColumnWidths()
    {
        return BaseColumnWidths;
    }

    private string GetRowClass(DeclaracionCfdiBase item) => RowClassResolver?.Invoke(item) ?? string.Empty;

    private async Task HandleRowClick(DeclaracionCfdiBase item)
    {
        if (OnRowClick.HasDelegate)
        {
            await OnRowClick.InvokeAsync(item);
        }
    }

    private static string FormatCurrency(decimal value) => string.Format("{0:N2}", value);

    private static string FormatInteger(int? value) => value.HasValue ? value.Value.ToString("N0") : string.Empty;

    private void ApplyFiltersAndSorting(bool resetPage = true)
    {
        var query = _originalItems.AsEnumerable();

        if (_checkStatusFilter == "checked")
        {
            query = query.Where(item => IsChecked(item.D));
        }
        else if (_checkStatusFilter == "unchecked")
        {
            query = query.Where(item => !IsChecked(item.D));
        }

        if (_selectedCounterparties.Any())
        {
            query = query.Where(item => _selectedCounterparties.Contains(Normalize(CounterpartySelector(item))));
        }

        if (_selectedFormaPago.Any())
        {
            query = query.Where(item => _selectedFormaPago.Contains(Normalize(item.FormaPago)));
        }

        if (_selectedTipoCfdi.Any())
        {
            query = query.Where(item => _selectedTipoCfdi.Contains(Normalize(item.TipoDeComprobante)));
        }

        if (_selectedMetodoPago.Any())
        {
            query = query.Where(item => _selectedMetodoPago.Contains(Normalize(item.MetodoPago)));
        }

        if (_selectedUsoCfdi.Any())
        {
            query = query.Where(item => _selectedUsoCfdi.Contains(Normalize(item.UsoCFDI)));
        }

        if (_filterTotalDifferentFromPolizas)
        {
            query = query.Where(HasTotalPolizasDifference);
        }

        query = ApplySorting(query);

        _filteredItems = query.ToList();
        UpdatePagination(resetPage);
    }

    private void UpdatePagination(bool resetPage)
    {
        var effectivePageSize = Math.Max(1, PageSize);
        _pageCount = Math.Max(1, (int)Math.Ceiling(_filteredItems.Count / (double)effectivePageSize));

        if (resetPage)
        {
            _currentPage = 1;
        }
        else
        {
            _currentPage = Math.Min(Math.Max(1, _currentPage), _pageCount);
        }

        _pagedItems = _filteredItems
            .Skip((_currentPage - 1) * effectivePageSize)
            .Take(effectivePageSize)
            .ToList();
    }

    private static bool IsChecked(string? value) => string.Equals(value?.Trim(), "✔", StringComparison.OrdinalIgnoreCase);

    private static string Normalize(string? value) => value?.Trim() ?? string.Empty;

    private bool HasTotalPolizasDifference(DeclaracionCfdiBase item)
    {
        if (!item.SumaPolizas.HasValue)
        {
            return true;
        }

        var difference = Math.Abs(item.Total - item.SumaPolizas.Value);
        return difference > TotalPolizasTolerance;
    }

    private bool HasActiveFilters =>
        !string.IsNullOrEmpty(_checkStatusFilter) ||
        _selectedCounterparties.Any() ||
        _selectedFormaPago.Any() ||
        _selectedTipoCfdi.Any() ||
        _selectedMetodoPago.Any() ||
        _selectedUsoCfdi.Any() ||
        _filterTotalDifferentFromPolizas ||
        _sortSelections.Any(kv => !string.IsNullOrEmpty(kv.Value));

    private static HashSet<string> ExtractSelectedValues(ChangeEventArgs args)
    {
        return args.Value switch
        {
            string[] array => new HashSet<string>(array.Where(v => !string.IsNullOrWhiteSpace(v)), StringComparer.OrdinalIgnoreCase),
            string single when !string.IsNullOrWhiteSpace(single) => new HashSet<string>(new[] { single }, StringComparer.OrdinalIgnoreCase),
            _ => new HashSet<string>(StringComparer.OrdinalIgnoreCase)
        };
    }

    private void OnCheckStatusChanged(ChangeEventArgs args)
    {
        _checkStatusFilter = args.Value?.ToString() ?? string.Empty;
        ApplyFiltersAndSorting();
    }

    private void OnCounterpartyFilterChanged(ChangeEventArgs args)
    {
        _selectedCounterparties = ExtractSelectedValues(args);
        ApplyFiltersAndSorting();
    }

    private void OnFormaPagoFilterChanged(ChangeEventArgs args)
    {
        _selectedFormaPago = ExtractSelectedValues(args);
        ApplyFiltersAndSorting();
    }

    private void OnTipoCfdiFilterChanged(ChangeEventArgs args)
    {
        _selectedTipoCfdi = ExtractSelectedValues(args);
        ApplyFiltersAndSorting();
    }

    private void OnMetodoPagoFilterChanged(ChangeEventArgs args)
    {
        _selectedMetodoPago = ExtractSelectedValues(args);
        ApplyFiltersAndSorting();
    }

    private void OnUsoCfdiFilterChanged(ChangeEventArgs args)
    {
        _selectedUsoCfdi = ExtractSelectedValues(args);
        ApplyFiltersAndSorting();
    }

    private void ClearFilters()
    {
        ResetFiltersAndSorting();

        ApplyFiltersAndSorting();
    }

    private void ApplyTotalDifferentFromPolizasFilter()
    {
        ResetFiltersAndSorting();
        _filterTotalDifferentFromPolizas = true;
        ApplyFiltersAndSorting();
    }

    private void ResetFiltersAndSorting()
    {
        _checkStatusFilter = string.Empty;
        _selectedCounterparties.Clear();
        _selectedFormaPago.Clear();
        _selectedTipoCfdi.Clear();
        _selectedMetodoPago.Clear();
        _selectedUsoCfdi.Clear();
        _filterTotalDifferentFromPolizas = false;

        foreach (var key in _sortSelections.Keys.ToList())
        {
            _sortSelections[key] = string.Empty;
        }
    }

    private RenderFragment RenderSortSelect(string columnKey) => builder =>
    {
        var sequence = 0;
        builder.OpenElement(sequence++, "select");
        builder.AddAttribute(sequence++, "class", "form-select form-select-sm");
        builder.AddAttribute(sequence++, "value", GetSortSelection(columnKey));
        builder.AddAttribute(sequence++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, args => OnSortSelectionChanged(args, columnKey)));
        builder.OpenElement(sequence++, "option");
        builder.AddAttribute(sequence++, "value", string.Empty);
        builder.AddContent(sequence++, "Sin orden");
        builder.CloseElement();
        builder.OpenElement(sequence++, "option");
        builder.AddAttribute(sequence++, "value", "ASC");
        builder.AddAttribute(sequence++, "selected", GetSortSelection(columnKey) == "ASC");
        builder.AddContent(sequence++, "ASC");
        builder.CloseElement();
        builder.OpenElement(sequence++, "option");
        builder.AddAttribute(sequence++, "value", "DESC");
        builder.AddAttribute(sequence++, "selected", GetSortSelection(columnKey) == "DESC");
        builder.AddContent(sequence++, "DESC");
        builder.CloseElement();
        builder.CloseElement();
    };

    private RenderFragment RenderMultiSelect(IEnumerable<string> options, HashSet<string> selectedValues, Action<ChangeEventArgs> handler) => builder =>
    {
        var sequence = 0;
        builder.OpenElement(sequence++, "select");
        builder.AddAttribute(sequence++, "multiple", "multiple");
        builder.AddAttribute(sequence++, "class", "form-select form-select-sm filter-multiselect");
        builder.AddAttribute(sequence++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, handler));
        foreach (var option in options)
        {
            builder.OpenElement(sequence++, "option");
            builder.AddAttribute(sequence++, "value", option);
            builder.AddAttribute(sequence++, "selected", selectedValues.Contains(option));
            builder.AddContent(sequence++, option);
            builder.CloseElement();
        }
        builder.CloseElement();
    };

    private string GetSortSelection(string columnKey)
    {
        return _sortSelections.TryGetValue(columnKey, out var value) ? value : string.Empty;
    }

    private void OnSortSelectionChanged(ChangeEventArgs args, string columnKey)
    {
        var value = args.Value?.ToString();
        _sortSelections[columnKey] = value == "ASC" || value == "DESC" ? value : string.Empty;
        ApplyFiltersAndSorting();
    }

    private void NextPage()
    {
        if (_currentPage < _pageCount)
        {
            _currentPage++;
            UpdatePagination(resetPage: false);
        }
    }

    private void PreviousPage()
    {
        if (_currentPage > 1)
        {
            _currentPage--;
            UpdatePagination(resetPage: false);
        }
    }

    private IEnumerable<string> CounterpartyOptions => GetDistinctOptions(item => CounterpartySelector(item));

    private IEnumerable<string> FormaPagoOptions => GetDistinctOptions(item => item.FormaPago);

    private IEnumerable<string> TipoCfdiOptions => GetDistinctOptions(item => item.TipoDeComprobante);

    private IEnumerable<string> MetodoPagoOptions => GetDistinctOptions(item => item.MetodoPago);

    private IEnumerable<string> UsoCfdiOptions => GetDistinctOptions(item => item.UsoCFDI);

    private IEnumerable<string> GetDistinctOptions(Func<DeclaracionCfdiBase, string?> selector)
    {
        return _originalItems
            .Select(selector)
            .Select(Normalize)
            .Where(value => !string.IsNullOrEmpty(value))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(value => value);
    }

    private IEnumerable<DeclaracionCfdiBase> ApplySorting(IEnumerable<DeclaracionCfdiBase> source)
    {
        IOrderedEnumerable<DeclaracionCfdiBase>? ordered = null;

        foreach (var column in SortColumnOrder)
        {
            if (!_sortSelections.TryGetValue(column, out var direction) || string.IsNullOrEmpty(direction))
            {
                continue;
            }

            if (!SortSelectors.TryGetValue(column, out var selector))
            {
                continue;
            }

            ordered = ordered == null
                ? ApplyInitialSort(source, direction, selector)
                : ApplySubsequentSort(ordered, direction, selector);
        }

        return ordered ?? source;
    }

    private static IOrderedEnumerable<DeclaracionCfdiBase> ApplyInitialSort(IEnumerable<DeclaracionCfdiBase> source, string direction, Func<DeclaracionCfdiBase, IComparable?> selector)
    {
        return string.Equals(direction, "DESC", StringComparison.OrdinalIgnoreCase)
            ? source.OrderByDescending(selector)
            : source.OrderBy(selector);
    }

    private static IOrderedEnumerable<DeclaracionCfdiBase> ApplySubsequentSort(IOrderedEnumerable<DeclaracionCfdiBase> source, string direction, Func<DeclaracionCfdiBase, IComparable?> selector)
    {
        return string.Equals(direction, "DESC", StringComparison.OrdinalIgnoreCase)
            ? source.ThenByDescending(selector)
            : source.ThenBy(selector);
    }

    private DeclaracionTotales CalculateTotals(IEnumerable<DeclaracionCfdiBase> source) =>
        DeclaracionTotalesCalculator.Compute(source);

    private static class DeclaracionTotalesCalculator
    {
        public static DeclaracionTotales Compute(IEnumerable<DeclaracionCfdiBase> source)
        {
            var list = source.ToList();

            return new DeclaracionTotales
            {
                CountCFDIs = list.Count,
                SumSubTotal = list.Sum(item => item.SubTotal),
                SumDescuento = list.Sum(item => item.Descuento),
                SumSubTotalDesc = list.Sum(item => item.SubTotal_Desc),
                SumActos16 = list.Sum(item => item.Actos_16),
                SumActos0 = list.Sum(item => item.Actos_0),
                SumIVA = list.Sum(item => item.IVA),
                SumIEPS = list.Sum(item => item.IEPS),
                SumIVA_RETENIDO = list.Sum(item => item.IVA_RETENIDO),
                SumISR_RETENIDO = list.Sum(item => item.ISR_RETENIDO),
                SumIEPS_RETENIDO = list.Sum(item => item.IEPS_RETENIDO),
                SumTotal = list.Sum(item => item.Total)
            };
        }
    }
}
