  private void ToggleModifier(RestaurantModifierGroupDto group, RestaurantModifierOptionDto option, bool selected)
  {
    if (selected)
    {
      if (GroupSelectionCount(selectedModifierIds, group) >= group.MaxSelections) return;
      selectedModifierIds.Add(option.Id);
    }
    else selectedModifierIds.Remove(option.Id);
  }

  /// <summary>El máximo del grupo es un presupuesto de selecciones, así que una opción puede repetirse.</summary>
  private void StepModifier(List<long> selection, RestaurantModifierGroupDto group, RestaurantModifierOptionDto option, int delta)
  {
    if (delta < 0)
    {
      var last = selection.LastIndexOf(option.Id);
      if (last >= 0) selection.RemoveAt(last);
    }
    else if (GroupSelectionCount(selection, group) >= group.MaxSelections)
    {
      error = $"{group.Name}: solo puedes elegir {group.MaxSelections} en total.";
      return;
    }
    else selection.Add(option.Id);
    error = null;
  }

  private static int ModifierCount(IReadOnlyList<long> selection, long optionId) => selection.Count(item => item == optionId);
  private static int GroupSelectionCount(IReadOnlyList<long> selection, RestaurantModifierGroupDto group)
  {
    var groupOptionIds = group.Options.Select(item => item.Id).ToHashSet();
    return selection.Count(groupOptionIds.Contains);
  }
  private static string SupplementName(string name, int quantity) => quantity > 1 ? $"{quantity}× {name}" : name;
  private static string ModifierDisplayName(CartModifierDetail modifier) => SupplementName(modifier.OptionName, modifier.Quantity);

  private void ToggleComboOption(RestaurantComboSlotDto slot, RestaurantComboSlotOptionDto option, bool selected)
  {
    if (!selectedComboOptionIds.TryGetValue(slot.Id, out var selections)) selectedComboOptionIds[slot.Id] = selections = [];
    if (selected)
    {
      if (option.IsSoldOut) return;
      if (slot.MaxSelections == 1)
      {
        selections.Clear();
      }
      else if (selections.Count >= slot.MaxSelections)
      {
        error = $"{slot.Name}: solo puedes elegir {slot.MaxSelections}.";
        return;
      }
      selections.Add(option.Id);
      _ = GetComponentDraft(slot.Id, option.Id);
    }
    else selections.Remove(option.Id);
    error = null;
  }

  private void ToggleComponentModifier(ComponentSelectionDraft draft, RestaurantModifierGroupDto group, RestaurantModifierOptionDto option, bool selected)
  {
    if (selected)
    {
      var groupOptionIds = group.Options.Select(item => item.Id).ToHashSet();
      if (group.MaxSelections == 1) draft.ModifierIds.RemoveAll(groupOptionIds.Contains);
      else if (draft.ModifierIds.Count(groupOptionIds.Contains) >= group.MaxSelections) return;
      draft.ModifierIds.Add(option.Id);
    }
    else draft.ModifierIds.Remove(option.Id);
  }

  private async Task AddSelectedProductAsync()
  {
    if (selectedProduct is null) return;
    if (!CanSavePersonalization) { error = "Completa las elecciones obligatorias y revisa las notas antes de continuar."; return; }
    var modifierDetails = CreateModifierDetails(selectedProduct.ModifierGroups, selectedModifierIds);
    var components = CreateComboComponents(selectedProduct);
    var sectionId = selectedMenuSection?.Id;
    var normalizedNotes = NormalizeNotes(selectedProductNotes);
    var candidate = new CartLine
    {
      ProductId = selectedProduct.Id,
      ProductKind = selectedProduct.ProductKind,
      MenuSectionId = sectionId,
      MenuSectionName = selectedMenuSection?.Name,
      MenuSectionSortOrder = selectedMenuSection?.SortOrder,
      Name = ProductDisplayName(selectedProduct),
      Quantity = 1,
      BaseUnitPrice = selectedProduct.Price,
      UnitPrice = SelectedProductPrice,
      Notes = normalizedNotes,
      ModifierIds = modifierDetails.SelectMany(item => Enumerable.Repeat(item.OptionId, item.Quantity)).Order().ToList(),
      ModifierNames = modifierDetails.Select(ModifierDisplayName).ToList(),
      Modifiers = modifierDetails,
      ComboComponents = components
    };
    candidate.Key = BuildCartKey(candidate);

    if (editingLine is null)
    {
      AddOrMergeCartLine(candidate);
    }
    else
    {
      var source = editingLine;
      var allocatedDiscount = source.Quantity > 1
        ? decimal.Round(source.DiscountAmount / source.Quantity, 2, MidpointRounding.AwayFromZero)
        : source.DiscountAmount;
      candidate.DiscountAmount = allocatedDiscount;
      if (source.Quantity > 1)
      {
        source.Quantity--;
        source.DiscountAmount = Math.Max(0, source.DiscountAmount - allocatedDiscount);
      }
      else cart.Remove(source);
      AddOrMergeCartLine(candidate);
    }
    CloseProductModal(); isMenuOpen = false; error = null; await PersistCartAsync(); await RefreshPromotionQuoteAsync();
  }

  private bool IsComboOptionSelected(long slotId, long optionId)
    => selectedComboOptionIds.TryGetValue(slotId, out var selections) && selections.Contains(optionId);
  private int SelectedOptionCount(RestaurantComboSlotDto slot)
    => selectedComboOptionIds.TryGetValue(slot.Id, out var selections) ? selections.Count : 0;
  private bool ComboSlotIsValid(RestaurantComboSlotDto slot)
  {
    var count = SelectedOptionCount(slot);
    return count >= slot.MinSelections && count <= slot.MaxSelections;
  }
  private static bool ModifierSelectionIsValid(RestaurantModifierGroupDto group, IReadOnlyList<long> selectionIds)
  {
    var count = GroupSelectionCount(selectionIds, group);
    return count >= group.MinSelections && count <= group.MaxSelections;
  }
  private static string SelectionInstruction(RestaurantComboSlotDto slot)
    => slot.MinSelections == 0
      ? slot.MaxSelections == 1 ? "Opcional · elige hasta 1" : $"Opcional · elige hasta {slot.MaxSelections}"
      : slot.MinSelections == slot.MaxSelections ? $"Elige {slot.MinSelections}" : $"Elige {slot.MinSelections}–{slot.MaxSelections}";
  private static string ModifierInstruction(RestaurantModifierGroupDto group)
    => group.MaxSelections == 1
      ? group.MinSelections == 0 ? "Opcional" : "Elige 1"
      : group.MinSelections == 0 ? $"Opcional · hasta {group.MaxSelections} en total"
      : group.MinSelections == group.MaxSelections ? $"Elige {group.MinSelections} en total"
      : $"Elige {group.MinSelections}–{group.MaxSelections} en total";
  private static string ComponentDraftKey(long slotId,long optionId)=>$"{slotId}:{optionId}";
  private ComponentSelectionDraft GetComponentDraft(long slotId,long optionId)
  {
    var key=ComponentDraftKey(slotId,optionId);
    if(!selectedComponentDrafts.TryGetValue(key,out var draft)) selectedComponentDrafts[key]=draft=new(){SlotId=slotId,OptionId=optionId};
    return draft;
  }
  private ComponentSelectionDraft? GetComponentDraftForOption(RestaurantComboSlotOptionDto option)
  {
    if(selectedProduct is null) return null;
    var slot=selectedProduct.ComboSlots.FirstOrDefault(item=>item.Options.Any(candidate=>candidate.Id==option.Id));
    return slot is null?null:GetComponentDraft(slot.Id,option.Id);
  }
  private static string NoteCounter(string? value)=>$"{value?.Length??0}/500";
  private static string? NormalizeNotes(string? value)=>string.IsNullOrWhiteSpace(value)?null:value.Trim();
  private static string FormatComponentQuantity(decimal quantity)=>quantity==decimal.Truncate(quantity)?$"{quantity:0}×":$"{quantity:0.####}×";
  private static string EffectClass(string effectKind)=>effectKind==RestaurantModifierEffectKinds.RemoveIngredient?"is-removed":"is-added";
  private static string EffectLabel(CartModifierEffect effect)=>effect.EffectKind switch
  {
    RestaurantModifierEffectKinds.RemoveIngredient=>$"Sin {effect.MaterialName}",
    RestaurantModifierEffectKinds.AddQuantity=>$"Agregar {effect.MaterialName}",
    _=>$"Ajuste de {effect.MaterialName}"
  };

  private static List<CartModifierDetail> CreateModifierDetails(IEnumerable<RestaurantModifierGroupDto> groups,IReadOnlyList<long> selectedIds)
    => groups.SelectMany(group=>group.Options.Where(option=>selectedIds.Contains(option.Id)).Select(option=>new CartModifierDetail
    {
      GroupId=group.Id,GroupName=group.Name,OptionId=option.Id,OptionName=option.Name,PriceDelta=option.PriceDelta,
      Quantity=ModifierCount(selectedIds,option.Id),
      Effects=option.IngredientEffects.Select(effect=>new CartModifierEffect{EffectKind=effect.EffectKind,MaterialName=effect.MaterialName,Quantity=effect.Quantity,UnitName=effect.UnitName}).ToList()
    })).ToList();

  private List<CartComboComponent> CreateComboComponents(RestaurantProductDto product)
  {
    var result=new List<CartComboComponent>();
    foreach(var slot in product.ComboSlots.Where(item=>item.IsActive).OrderBy(item=>item.SortOrder))
    {
      foreach(var option in slot.Options.Where(item=>item.IsActive&&IsComboOptionSelected(slot.Id,item.Id)).OrderBy(item=>item.SortOrder))
      {
        var draft=GetComponentDraft(slot.Id,option.Id);
        var modifiers=CreateModifierDetails(option.ComponentModifierGroups,draft.ModifierIds);
        var route=ResolveComponentSection(option);
        result.Add(new()
        {
          SlotId=slot.Id,SlotName=slot.Name,OptionId=option.Id,ProductId=option.ComponentProductId,ProductName=option.ComponentProductName,
          ProductSku=option.ComponentSku,Quantity=option.Quantity,PriceDelta=option.PriceDelta,ModifierIds=draft.ModifierIds.Order().ToList(),
          ModifierNames=modifiers.Select(ModifierDisplayName).ToList(),Modifiers=modifiers,Notes=NormalizeNotes(draft.Notes),
          MenuSectionId=route?.Id,MenuSectionName=route?.Name,MenuSectionSortOrder=route?.SortOrder
        });
      }
    }
    return result;
  }
  private RestaurantMenuSectionDto? ResolveComponentSection(RestaurantComboSlotOptionDto option)
  {
    if(catalog is null) return null;
    var configured=option.Routes.FirstOrDefault(route=>string.Equals(route.MenuName,catalog.MenuName,StringComparison.OrdinalIgnoreCase))
      ?? option.Routes.FirstOrDefault();
    if(configured is not null)
    {
      var routed=catalog.Sections.FirstOrDefault(section=>section.Id==configured.MenuSectionId);
      if(routed is not null) return routed;
    }
    var matches=catalog.Sections.Where(section=>section.Products.Any(product=>product.Id==option.ComponentProductId)).ToList();
    return matches.Count==1?matches[0]:null;
  }

  private static string BuildCartKey(CartLine line)
  {
    var signature=new
    {
      line.ProductId,line.MenuSectionId,
      Modifiers=line.ModifierIds.Order().ToArray(),
      Notes=NormalizeNotes(line.Notes),
      Components=line.ComboComponents.OrderBy(item=>item.SlotId).ThenBy(item=>item.OptionId).Select(item=>new
      {
        item.SlotId,item.OptionId,Modifiers=item.ModifierIds.Order().ToArray(),Notes=NormalizeNotes(item.Notes)
      }).ToArray()
    };
    return $"product:{Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(JsonSerializer.Serialize(signature)))}";
  }
  private void AddOrMergeCartLine(CartLine candidate)
  {
    var existing=cart.FirstOrDefault(item=>item.Key==candidate.Key);
    if(existing is null){cart.Add(candidate);return;}
    existing.Quantity+=candidate.Quantity;
    existing.DiscountAmount+=candidate.DiscountAmount;
  }

