  private async Task CreatePairingAsync()=>await GeneratePairingAsync(null,pairing.SiteId,pairing.DeviceName);
  private async Task RegeneratePairingAsync(KioskDeviceDto item)
  {
    if(item.IsPaired&&!await Js.InvokeAsync<bool>("confirm",$"¿Revincular \"{item.Name}\"? El dispositivo actual dejará de registrar asistencia hasta capturar el nuevo código.")) return;
    await GeneratePairingAsync(item.Id,item.SiteId,item.Name);
  }
  private async Task GeneratePairingAsync(int? deviceId,int siteId,string deviceName)
  {
    busy=true;
    try
    {
      pairingResult=await ConfigurationService.CreateKioskPairingCodeAsync(new(){Rfc=Rfc,DeviceId=deviceId,SiteId=siteId,DeviceName=deviceName});
      Show("Código creado. Captúralo en el kiosco antes de que expire.",false);
      pairing=new(){Rfc=Rfc};
      await LoadAsync();
    }
    catch(Exception ex){Show(ex.Message,true);}
    finally{busy=false;}
  }
  private void EditKioskDevice(KioskDeviceDto item){kioskDevice=new(){Id=item.Id,Rfc=Rfc,SiteId=item.SiteId,Name=item.Name,IsActive=item.IsActive};pairingResult=null;message=null;}
  private void CancelKioskEdit()=>ResetKioskDevice();
  private void ResetKioskDevice()=>kioskDevice=new(){Rfc=Rfc};
  private async Task SaveKioskDeviceAsync()=>await RunAsync(()=>ConfigurationService.SaveKioskDeviceAsync(kioskDevice),ResetKioskDevice);
  private async Task ToggleKioskAsync(KioskDeviceDto item)
  {
