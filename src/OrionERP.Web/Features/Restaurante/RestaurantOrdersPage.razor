@page "/restaurante/ordenes"
@attribute [Authorize(Policy = "RestaurantPos")]
@implements IAsyncDisposable
@using Microsoft.AspNetCore.Components.Authorization
@using OrionERP.Application.Features.Logistica.Shared
@using OrionERP.Application.Features.Restaurante
@using OrionERP.Web.State
@inject IRestaurantCatalogService CatalogService
@inject IRestaurantOrderService OrderService
@inject IRestaurantReceiptPdfService ReceiptPdfService
@inject IRestaurantCashService CashService
@inject IRestaurantQuickPinService QuickPinService
@inject IRestaurantAccountingService AccountingService
@inject IUserRfcState RfcState
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime Js
@inject RestaurantRealtimeClient Realtime

<PageTitle>Restaurante · Órdenes y entregas</PageTitle>
<main class="orders-shell">
  <header class="orders-hero"><div><span>Barra y entrega</span><h1>Órdenes activas</h1><p>Despacha domicilio, entrega al comensal y completa órdenes pagadas.</p></div><div>@if(sites.Count>1){<select @onchange="ChangeSiteAsync">@foreach(var site in sites){<option value="@site.Id" selected="@(site.Id==selectedSiteId)">@site.Name</option>}</select>}<button type="button" @onclick="LoadAsync">Actualizar</button></div></header>
  @if(!string.IsNullOrWhiteSpace(message)){<div class="alert @(isError?"alert-danger":"alert-success")">@message</div>}
  <nav class="orders-filters">@foreach(var filter in new[]{"Active","Ready","Dispatched","Delivered","Completed","Cancelled"}){<button type="button" class="@(statusFilter==filter?"is-active":null)" @onclick="()=>statusFilter=filter">@FilterLabel(filter) <b>@Count(filter)</b></button>}</nav>
  <section class="orders-grid">
    @foreach(var order in FilteredOrders)
    {
      <article @key="order.Id" class="order-card @KitchenProgressClass(order)">
        <header>
          <div><span>@TypeLabel(order.OrderType)</span><strong>@order.Folio.ToString("000")</strong>@if(!string.IsNullOrWhiteSpace(order.CustomerName)){<em class="order-card__customer">@order.CustomerName</em>}</div>
          <b>@StatusLabel(order.Status)</b>
        </header>
        <div class="order-card__summary">
          @if(!string.IsNullOrWhiteSpace(order.TableName)){<span class="oi oi-map-marker"></span><strong>@order.TableName</strong>}
          <span>@order.Lines.Sum(x=>x.Quantity).ToString("0.##") producto(s)</span>
          <span>@order.Total.ToString("C")</span>
        </div>
        @if(!string.IsNullOrWhiteSpace(order.Notes))
        {
          <aside class="order-card__note" aria-label="Notas de la orden">
            <span class="oi oi-comment-square" aria-hidden="true"></span>
            <div><strong>Notas de la orden</strong><p>@order.Notes</p></div>
          </aside>
        }
        <ul>
          @foreach(var line in order.Lines.Where(x=>x.Status!="Cancelled"))
          {
            <li><b>@line.Quantity.ToString("0.##")×</b><span>@line.ProductName@if(line.IsCustom){<small>Cargo personalizado</small>}else if(line.Modifiers.Count>0){<small>@string.Join(" · ",line.Modifiers)</small>}</span><em>@StatusLabel(line.Status)</em></li>
          }
        </ul>
        <footer>
          <span class="payment payment--@order.PaymentStatus.ToLowerInvariant()">@PaymentLabel(order.PaymentStatus)</span>
          <div>
            <button type="button" class="order-reprint-button" disabled="@(reprintLoadingOrderId.HasValue)" @onclick="()=>OpenReprintAsync(order)">
              <span class="oi oi-print" aria-hidden="true"></span>
              @(reprintLoadingOrderId==order.Id ? "Preparando…" : "Reimprimir")
            </button>
            <button type="button" class="order-log-button" @onclick="()=>OpenOrderLogAsync(order)">
              <span class="oi oi-list-rich" aria-hidden="true"></span> Bitácora
            </button>
            @if(order.CashRegisterId.HasValue){<button type="button" class="order-correction-button" @onclick="()=>OpenCorrectionsAsync(order)">Correcciones / CFDI</button>}
            @if(order.Status=="Ready"&&order.OrderType=="Delivery"){<button type="button" @onclick='()=>SetStatusAsync(order,"Dispatched")'>Despachar</button>}
            else if(order.Status=="Ready"){<button type="button" @onclick='()=>SetStatusAsync(order,"Delivered")'>Entregar</button>}
            else if(order.Status=="Dispatched"){<button type="button" @onclick='()=>SetStatusAsync(order,"Delivered")'>Confirmar entrega</button>}
            else if(order.Status=="Delivered"&&order.PaymentStatus=="Paid"){<button type="button" @onclick='()=>SetStatusAsync(order,"Completed")'>Completar</button>}
          </div>
        </footer>
      </article>
    }
    @if(!FilteredOrders.Any()){<div class="orders-empty"><h2>No hay órdenes en este estado</h2></div>}
  </section>
  @if(reprintOrder is not null && reprintReceipt is not null)
  {
    <section class="order-reprint" role="dialog" aria-modal="true" aria-labelledby="order-reprint-title">
      <div class="order-reprint__card">
        <header>
          <div><span>Orden @reprintOrder.Folio.ToString("000")</span><h2 id="order-reprint-title">Reimprimir tickets</h2></div>
          <button type="button" @onclick="CloseReprint" disabled="@reprintBusy" aria-label="Cerrar">×</button>
        </header>
        <div class="order-reprint__summary">
          <span class="oi oi-print" aria-hidden="true"></span>
          <div>
            <strong>1 ticket de cliente@if(reprintReceipt.SectionTicketCount>0){<text> + @reprintReceipt.SectionTicketCount por sección</text>}</strong>
            <p>Las copias llevarán la leyenda <b>REIMPRESIÓN</b> para evitar confundirlas con una orden nueva.</p>
          </div>
        </div>
        @if(!string.IsNullOrWhiteSpace(reprintError))
        {
          <div class="order-reprint__error" role="alert">@reprintError</div>
        }
        <footer>
          <button type="button" class="btn btn-outline-secondary" @onclick="CloseReprint" disabled="@reprintBusy">Cerrar</button>
          <button type="button" class="btn btn-primary" @onclick="PrintReprintAsync" disabled="@reprintBusy">
            <span class="oi oi-print" aria-hidden="true"></span> @(reprintBusy ? "Preparando…" : "Imprimir tickets")
          </button>
        </footer>
      </div>
    </section>
  }
  @if(correctionOrder is not null)
  {
    <section class="order-correction" role="dialog" aria-modal="true" aria-label="Correcciones supervisadas">
      <div class="order-correction__card">
        <header><div><span>Orden @correctionOrder.Folio.ToString("000")@if(!string.IsNullOrWhiteSpace(correctionOrder.CustomerName)){<text> · @correctionOrder.CustomerName</text>}</span><h2>Corrección supervisada</h2></div><button type="button" @onclick="CloseCorrections" aria-label="Cerrar">×</button></header>
        <nav>@foreach(var mode in new[]{"Payment","Refund","Cancel","Cfdi"}){<button type="button" class="@(correctionMode==mode?"is-active":null)" @onclick="()=>correctionMode=mode">@CorrectionLabel(mode)</button>}</nav>
        @if(correctionMode=="Payment")
        {
          <div class="order-correction__fields"><label>Forma de pago<select @bind="correctionPaymentMethod"><option value="Cash">Efectivo</option><option value="ExternalCard">Tarjeta externa</option><option value="Transfer">Transferencia</option></select></label><label>Importe<input type="number" min="0.01" step="0.01" @bind="correctionAmount" /></label><label>Propina<input type="number" min="0" step="0.01" @bind="correctionTip" /></label></div>
        }
        else if(correctionMode=="Refund")
        {
          <div class="order-correction__fields"><label>Pago<select @bind="selectedPaymentId"><option value="">Seleccionar…</option>@foreach(var payment in correctionPayments.Where(x=>x.RefundableAmount>0)){<option value="@payment.Id">@PaymentMethodLabel(payment.PaymentMethod) · @payment.RefundableAmount.ToString("C")</option>}</select></label><label>Importe a reembolsar<input type="number" min="0.01" step="0.01" @bind="correctionAmount" /></label></div>
        }
        else if(correctionMode=="Cancel")
        {
          <p class="order-correction__warning">Se liberará la reserva si aún no se consume. Si la preparación inició, la salida debe tratarse como merma. Los cobros se reembolsan por separado.</p>
        }
        else
        {
          <div class="order-correction__fields"><label>ID del comprobante CFDI<input type="number" min="1" @bind="correctionCfdiId" /></label></div><p class="order-correction__warning">Si la venta ya entró en una póliza diaria, se generará una reversión supervisada de su porción y después la póliza individual ligada a <code>Transaccion_Comprobante</code>.</p>
        }
        <label>Motivo<textarea @bind="correctionReason" rows="2"></textarea></label>
        <div class="order-correction__supervisor"><label>Supervisor<input @bind="supervisorIdentity" autocomplete="username" placeholder="Correo o usuario" /></label><label>PIN<input type="password" inputmode="numeric" autocomplete="current-password" @bind="supervisorPin" /></label></div>
        <footer><button type="button" class="btn btn-outline-secondary" @onclick="CloseCorrections">Cerrar</button><button type="button" class="btn btn-danger" disabled="@correctionBusy" @onclick="ApplyCorrectionAsync">Autorizar y aplicar</button></footer>
      </div>
    </section>
  }
  @if(logOrder is not null)
  {
    <section class="order-log" role="dialog" aria-modal="true" aria-labelledby="order-log-title">
      <div class="order-log__panel">
        <header class="order-log__header">
          <div>
            <span>@TypeLabel(logOrder.OrderType) · Orden @logOrder.Folio.ToString("000")</span>
            <h2 id="order-log-title">Bitácora de la orden</h2>
            @if(!string.IsNullOrWhiteSpace(logOrder.CustomerName)){<p>@logOrder.CustomerName</p>}
          </div>
          <div class="order-log__header-actions">
            <button type="button" class="order-log__refresh" disabled="@logBusy" @onclick="RefreshOrderLogAsync">
              <span class="oi oi-reload" aria-hidden="true"></span><span>Actualizar</span>
            </button>
            <button type="button" class="order-log__close" @onclick="CloseOrderLog" aria-label="Cerrar bitácora">×</button>
          </div>
        </header>

        <div class="order-log__summary">
          <div><span>Estado actual</span><strong>@StatusLabel(logOrder.Status)</strong></div>
          <div><span>Eventos</span><strong>@logEvents.Count</strong></div>
          <div><span>Transcurrido</span><strong>@EventDurationLabel()</strong></div>
        </div>

        <div class="order-log__legend" aria-label="Tipos de evento">
          @foreach(var category in logEvents.Select(item=>item.Category).Distinct(StringComparer.OrdinalIgnoreCase))
          {
            <span class="order-log__legend-item order-log__legend-item--@CategoryClass(category)">@CategoryLabel(category)</span>
          }
        </div>

        <div class="order-log__body" aria-live="polite">
          @if(logBusy)
          {
            <div class="order-log__state"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span><strong>Cargando la historia completa…</strong></div>
          }
          else if(!string.IsNullOrWhiteSpace(logError))
          {
            <div class="order-log__state order-log__state--error"><strong>No se pudo cargar la bitácora</strong><p>@logError</p><button type="button" @onclick="RefreshOrderLogAsync">Reintentar</button></div>
          }
          else if(logEvents.Count==0)
          {
            <div class="order-log__state"><span class="oi oi-clock" aria-hidden="true"></span><strong>Aún no hay eventos registrados.</strong></div>
          }
          else
          {
            <ol class="order-log__timeline">
              @foreach(var eventInfo in logEvents)
              {
                <li @key="eventInfo.Id" class="order-log__event order-log__event--@CategoryClass(eventInfo.Category)">
                  <div class="order-log__marker"><span class="oi @CategoryIcon(eventInfo.Category)" aria-hidden="true"></span></div>
                  <article>
                    <header>
                      <div><span>@CategoryLabel(eventInfo.Category)</span><h3>@eventInfo.Title</h3></div>
                      <time datetime="@eventInfo.OccurredAt.ToString("O")">@FormatEventTime(eventInfo.OccurredAt)</time>
                    </header>
                    @if(!string.IsNullOrWhiteSpace(eventInfo.Description)){<p>@eventInfo.Description</p>}
                    @if(!string.IsNullOrWhiteSpace(eventInfo.Actor)){<footer><span class="oi oi-person" aria-hidden="true"></span>@eventInfo.Actor</footer>}
                  </article>
                </li>
              }
            </ol>
          }
        </div>

        <footer class="order-log__footer">
          <span>Los eventos se conservan como auditoría operativa.</span>
          <button type="button" @onclick="CloseOrderLog">Cerrar</button>
        </footer>
      </div>
    </section>
  }
</main>

@code {
  private readonly CancellationTokenSource disposeCts = new();
  private List<RestaurantSiteDto> sites = [];
  private List<RestaurantOrderDto> orders = [];
  private int selectedSiteId;
  private string statusFilter = "Active";
  private string? message;
  private bool isError;
  private RestaurantOrderDto? correctionOrder;
  private List<RestaurantPaymentDto> correctionPayments = [];
  private List<RestaurantCashShiftDto> correctionShifts = [];
  private string correctionMode = "Payment";
  private string correctionPaymentMethod = "Cash";
  private Guid? selectedPaymentId;
  private decimal correctionAmount;
  private decimal correctionTip;
  private int correctionCfdiId;
  private string correctionReason = string.Empty;
  private string supervisorIdentity = string.Empty;
  private string supervisorPin = string.Empty;
  private bool correctionBusy;
  private RestaurantOrderDto? logOrder;
  private List<RestaurantOrderEventDto> logEvents = [];
  private bool logBusy;
  private string? logError;
  private RestaurantOrderDto? reprintOrder;
  private RestaurantReceiptPdfDocumentModel? reprintReceipt;
  private Guid? reprintLoadingOrderId;
  private bool reprintBusy;
  private string? reprintError;

  private string CurrentRfc => LogisticsRfc.Require(RfcState.CurrentRfc);
  private IEnumerable<RestaurantOrderDto> FilteredOrders => (statusFilter == "Active"
      ? orders.Where(order => order.Status is not ("Completed" or "Cancelled"))
      : orders.Where(order => order.Status == statusFilter))
    .OrderBy(order => order.OperationalDate)
    .ThenBy(order => order.Folio)
    .ThenBy(order => order.CreatedAt)
    .ThenBy(order => order.Id);

  protected override async Task OnInitializedAsync()
  {
    RfcState.Changed += OnRfcChanged;
    Realtime.EventReceived += OnRealtimeEventAsync;
    await LoadSitesAsync();
    _ = RefreshLoopAsync(disposeCts.Token);
  }

  private async Task LoadSitesAsync()
  {
    sites = (await CatalogService.GetSitesAsync(CurrentRfc)).Where(site => site.IsEnabled).ToList();
    if (!sites.Any(site => site.Id == selectedSiteId)) selectedSiteId = sites.FirstOrDefault()?.Id ?? 0;
    await Realtime.SubscribeAsync(CurrentRfc, selectedSiteId);
    await LoadAsync();
  }

  private async Task LoadAsync()
  {
    try
    {
      orders = selectedSiteId > 0
        ? (await OrderService.GetOperationalOrdersAsync(CurrentRfc, selectedSiteId)).ToList()
        : [];
    }
    catch (Exception ex) { Show(ex.Message, true); }
  }

  private async Task SetStatusAsync(RestaurantOrderDto order, string status)
  {
    try
    {
      var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      var result = await OrderService.UpdateOrderStatusAsync(CurrentRfc, order.Id, status, auth.User.Identity?.Name ?? "entrega");
      Show(result.Message, !result.Success);
      await LoadAsync();
    }
    catch (Exception ex) { Show(ex.Message, true); }
  }

  private async Task OpenCorrectionsAsync(RestaurantOrderDto order)
  {
    CloseOrderLog();
    CloseReprint();
    correctionOrder = order;
    correctionPayments = (await OrderService.GetPaymentsAsync(CurrentRfc, order.Id)).ToList();
    correctionShifts = (await CashService.GetShiftsAsync(CurrentRfc, selectedSiteId)).Where(shift => shift.Status == "Open").ToList();
    correctionMode = order.BalanceDue > 0 ? "Payment" : "Refund";
    selectedPaymentId = correctionPayments.FirstOrDefault(payment => payment.RefundableAmount > 0)?.Id;
    correctionAmount = correctionMode == "Payment"
      ? order.BalanceDue
      : correctionPayments.FirstOrDefault(payment => payment.Id == selectedPaymentId)?.RefundableAmount ?? 0;
    correctionTip = 0;
    correctionCfdiId = 0;
    correctionReason = string.Empty;
    supervisorIdentity = string.Empty;
    supervisorPin = string.Empty;
  }

  private void CloseCorrections()
  {
    correctionOrder = null;
    correctionPayments = [];
    supervisorPin = string.Empty;
  }

  private async Task OpenOrderLogAsync(RestaurantOrderDto order)
  {
    CloseCorrections();
    CloseReprint();
    logOrder = order;
    logEvents = [];
    logError = null;
    await LoadOrderLogAsync();
  }

  private Task RefreshOrderLogAsync() => LoadOrderLogAsync();

  private async Task LoadOrderLogAsync(bool showLoading = true)
  {
    if (logOrder is null) return;
    if (showLoading) logBusy = true;
    logError = null;
    try
    {
      logEvents = (await OrderService.GetOrderEventsAsync(CurrentRfc, logOrder.Id)).ToList();
      logOrder = orders.FirstOrDefault(order => order.Id == logOrder.Id) ?? logOrder;
    }
    catch (Exception ex)
    {
      logError = ex.Message;
    }
    finally
    {
      logBusy = false;
    }
  }

  private void CloseOrderLog()
  {
    logOrder = null;
    logEvents = [];
    logError = null;
    logBusy = false;
  }

  private async Task OpenReprintAsync(RestaurantOrderDto order)
  {
    CloseCorrections();
    CloseOrderLog();
    CloseReprint();
    reprintLoadingOrderId = order.Id;
    try
    {
      var receipt = await OrderService.GetReceiptAsync(CurrentRfc, order.Id)
        ?? throw new InvalidOperationException("No se encontró la orden para reimprimir.");
      var createdAtUtc = new DateTimeOffset(DateTime.SpecifyKind(receipt.CreatedAt, DateTimeKind.Utc));
      var receiptCatalog = await CatalogService.GetPosCatalogAsync(CurrentRfc, receipt.SiteId, createdAtUtc);
      reprintReceipt = RestaurantReceiptReprintMapper.Create(receipt, receiptCatalog);
      reprintOrder = order;
      reprintError = null;
    }
    catch (Exception ex)
    {
      Show($"No se pudieron recuperar los tickets. {ex.Message}", true);
    }
    finally
    {
      reprintLoadingOrderId = null;
    }
  }

  private async Task PrintReprintAsync()
  {
    if (reprintOrder is null || reprintReceipt is null) return;
    reprintBusy = true;
    reprintError = null;
    try
    {
      var pdfBytes = ReceiptPdfService.Generate(reprintReceipt);
      await Js.InvokeVoidAsync(
        "restaurantUi.printPdf",
        Convert.ToBase64String(pdfBytes),
        $"orden-{reprintOrder.Folio:000}-reimpresion.pdf");
    }
    catch (Exception ex)
    {
      reprintError = $"No se pudieron preparar los tickets. {ex.Message}";
    }
    finally
    {
      reprintBusy = false;
    }
  }

  private void CloseReprint()
  {
    if (reprintBusy) return;
    reprintOrder = null;
    reprintReceipt = null;
    reprintError = null;
  }

  private async Task ApplyCorrectionAsync()
  {
    if (correctionOrder is null || !correctionOrder.CashRegisterId.HasValue) return;
    correctionBusy = true;
    try
    {
      var verification = await QuickPinService.VerifySupervisorPinAsync(new()
      {
        Rfc = CurrentRfc,
        CashRegisterId = correctionOrder.CashRegisterId.Value,
        UserNameOrEmail = supervisorIdentity,
        Pin = supervisorPin
      });
      if (!verification.Success)
      {
        Show(verification.Message, true);
        supervisorPin = string.Empty;
        return;
      }

      var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      var requestedBy = auth.User.Identity?.Name ?? "caja";
      RestaurantCommandResult result;
      if (correctionMode == "Payment")
      {
        var shift = correctionShifts.FirstOrDefault(item => item.CashRegisterId == correctionOrder.CashRegisterId);
        result = await OrderService.AddPaymentAsync(new()
        {
          Rfc = CurrentRfc,
          OrderId = correctionOrder.Id,
          CashShiftId = correctionPaymentMethod == "Cash" ? shift?.Id : null,
          PaymentMethod = correctionPaymentMethod,
          Amount = correctionAmount,
          TipAmount = correctionTip,
          IdempotencyKey = Guid.NewGuid().ToString("N"),
          Reason = correctionReason,
          SupervisorUserName = verification.UserName!
        }, requestedBy);
      }
      else if (correctionMode == "Refund")
      {
        if (!selectedPaymentId.HasValue)
        {
          Show("Seleccione el pago a reembolsar.", true);
          return;
        }
        result = await OrderService.RefundPaymentAsync(new()
        {
          Rfc = CurrentRfc,
          PaymentId = selectedPaymentId.Value,
          Amount = correctionAmount,
          IdempotencyKey = Guid.NewGuid().ToString("N"),
          Reason = correctionReason,
          SupervisorUserName = verification.UserName!
        }, requestedBy);
      }
      else if (correctionMode == "Cancel")
      {
        result = await OrderService.CancelOrderAsync(CurrentRfc, correctionOrder.Id, correctionReason, verification.UserName!);
      }
      else
      {
        result = await AccountingService.GenerateIndividualCfdiPolicyAsync(CurrentRfc, correctionOrder.Id, correctionCfdiId, verification.UserName!);
      }
      Show(result.Message, !result.Success);
      if (result.Success) CloseCorrections();
      await LoadAsync();
    }
    catch (Exception ex) { Show(ex.Message, true); }
    finally { correctionBusy = false; }
  }

  private async Task ChangeSiteAsync(ChangeEventArgs args)
  {
    if (int.TryParse(args.Value?.ToString(), out var id))
    {
      selectedSiteId = id;
      CloseCorrections();
      CloseOrderLog();
      CloseReprint();
      await Realtime.SubscribeAsync(CurrentRfc, selectedSiteId);
      await LoadAsync();
    }
  }

  private int Count(string filter) => filter == "Active"
    ? orders.Count(order => order.Status is not ("Completed" or "Cancelled"))
    : orders.Count(order => order.Status == filter);
  private static string FilterLabel(string value) => value switch { "Active" => "Activas", "Ready" => "Listas", "Dispatched" => "Despachadas", "Delivered" => "Entregadas", "Completed" => "Completadas", "Cancelled" => "Canceladas", _ => value };
  private static string TypeLabel(string value) => value switch { "Pickup" => "Recoger", "Table" => "Mesa", "Delivery" => "Domicilio", _ => value };
  private static string StatusLabel(string value) => value switch { "AwaitingPayment" => "Pendiente de pago", "Sent" => "Pendiente", "Preparing" => "Preparando", "Ready" => "Lista", "Dispatched" => "Despachada", "Delivered" => "Entregada", "Completed" => "Completada", "Cancelled" => "Cancelada", "Pending" => "Pendiente", _ => value };
  private static string KitchenProgressClass(RestaurantOrderDto order) => RestaurantKitchenProgressRules.Classify(order) switch
  {
    RestaurantKitchenProgress.Ready => "order-card--complete",
    RestaurantKitchenProgress.Preparing => "order-card--partial",
    _ => "order-card--not-started"
  };
  private static string PaymentLabel(string value) => value switch { "Paid" => "Pagada", "PendingSettlement" => "Por liquidar", "Partial" => "Pago parcial", "PartiallyRefunded" => "Reembolso parcial", "Refunded" => "Reembolsada", _ => value };
  private static string CorrectionLabel(string value) => value switch { "Payment" => "Cargo adicional", "Refund" => "Reembolso", "Cancel" => "Cancelar orden", "Cfdi" => "Ligar CFDI", _ => value };
  private static string PaymentMethodLabel(string value) => value switch { "Cash" => "Efectivo", "ExternalCard" => "Tarjeta", "Transfer" => "Transferencia", "Platform" => "Plataforma", _ => value };
  private static string CategoryLabel(string value) => value switch { "Order" => "Orden", "Kitchen" => "Cocina", "Payment" => "Pago", "Delivery" => "Entrega", "Inventory" => "Inventario", "Authorization" => "Autorización", "Accounting" => "Contabilidad", _ => value };
  private static string CategoryClass(string value) => value.Trim().ToLowerInvariant() switch { "order" => "order", "kitchen" => "kitchen", "payment" => "payment", "delivery" => "delivery", "inventory" => "inventory", "authorization" => "authorization", "accounting" => "accounting", _ => "other" };
  private static string CategoryIcon(string value) => value switch { "Kitchen" => "oi-fire", "Payment" => "oi-dollar", "Delivery" => "oi-map-marker", "Inventory" => "oi-box", "Authorization" => "oi-shield", "Accounting" => "oi-spreadsheet", _ => "oi-check" };
  private string FormatEventTime(DateTime utcDate)
  {
    var site = sites.FirstOrDefault(item => item.Id == selectedSiteId);
    var utc = DateTime.SpecifyKind(utcDate, DateTimeKind.Utc);
    if (site is null || string.IsNullOrWhiteSpace(site.TimeZoneId)) return utc.ToLocalTime().ToString("dd MMM yyyy · HH:mm:ss");
    try { return TimeZoneInfo.ConvertTimeFromUtc(utc, TimeZoneInfo.FindSystemTimeZoneById(site.TimeZoneId)).ToString("dd MMM yyyy · HH:mm:ss"); }
    catch (TimeZoneNotFoundException) { return utc.ToLocalTime().ToString("dd MMM yyyy · HH:mm:ss"); }
    catch (InvalidTimeZoneException) { return utc.ToLocalTime().ToString("dd MMM yyyy · HH:mm:ss"); }
  }
  private string EventDurationLabel()
  {
    if (logEvents.Count < 2) return "Recién creada";
    var duration = logEvents[^1].OccurredAt - logEvents[0].OccurredAt;
    if (duration.TotalDays >= 1) return $"{(int)duration.TotalDays} d {duration.Hours} h";
    if (duration.TotalHours >= 1) return $"{(int)duration.TotalHours} h {duration.Minutes} min";
    if (duration.TotalMinutes >= 1) return $"{(int)duration.TotalMinutes} min";
    return $"{Math.Max(0, (int)duration.TotalSeconds)} s";
  }
  private void Show(string value, bool error) { message = value; isError = error; }
  private Task OnRealtimeEventAsync(RestaurantRealtimeEvent eventInfo) => InvokeAsync(async () =>
  {
    await LoadAsync();
    if (logOrder is not null && Guid.TryParse(eventInfo.AggregateId, out var eventOrderId) && eventOrderId == logOrder.Id)
    {
      await LoadOrderLogAsync(showLoading: false);
    }
    StateHasChanged();
  });

  private async Task RefreshLoopAsync(CancellationToken ct)
  {
    using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
    try
    {
      while (await timer.WaitForNextTickAsync(ct))
      {
        await InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });
      }
    }
    catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
  }

  private void OnRfcChanged() => _ = InvokeAsync(async () =>
  {
    selectedSiteId = 0;
    CloseCorrections();
    CloseOrderLog();
    CloseReprint();
    await LoadSitesAsync();
    StateHasChanged();
  });

  public ValueTask DisposeAsync()
  {
    RfcState.Changed -= OnRfcChanged;
    Realtime.EventReceived -= OnRealtimeEventAsync;
    disposeCts.Cancel();
    disposeCts.Dispose();
    return ValueTask.CompletedTask;
  }
}
