@page "/cuenta/revisa-tu-correo"
@{
  ViewData["Title"] = "Revisa tu correo · Club Bruno";
}
<div class="account-shell">
  <div class="account-art" aria-hidden="true"></div>
  <section class="account-panel">
    <span>Club Bruno</span>
    <h1>Revisa tu correo</h1>
    <p class="account-success">Te enviamos un enlace para confirmar tu correo y activar tu membresía.</p>
    <p>Si no lo encuentras, revisa las carpetas de correo no deseado o promociones.</p>
    <div class="account-links"><a href="/cuenta/acceso">Ir a acceso</a><a href="/">Volver al sitio</a></div>
  </section>
</div>
