@page "/cfdi/registros-contables"
@using Microsoft.AspNetCore.Components
@using OrionERP.Application.Features.Cfdi.ContabilidadRegistros
@using OrionERP.Web.Shared
@using OrionERP.Web.State
@inject IContabilidadRegistrosService RegistrosService
@inject NavigationManager Navigation
@inject IUserRfcState RfcState
@attribute [Authorize(Roles = "Administrador,SatOperator")]

<h3>Contabilidad &mdash; Registros</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
  <div class="alert alert-danger" role="alert">
    @errorMessage
  </div>
}

<div class="card p-3 mb-3">
  <div class="row g-3 align-items-end">
    <div class="col-md-4">
      <label class="form-label">RFC (Razón Social)</label>
            <RfcPicker @bind-SelectedRfc="selectedRfc" @bind-SelectedRfc:after="OnRfcChangedAsync" />
    </div>
    <div class="col-md-3">
      <label class="form-label">Fecha inicio</label>
      <input class="form-control" type="date" @bind="startDate" />
    </div>
    <div class="col-md-3">
      <label class="form-label">Fecha fin</label>
      <input class="form-control" type="date" @bind="endDate" />
    </div>
  </div>

  <CuentaContablePicker
    @ref="accountPicker"
    @bind-SelectedRfc="selectedRfc"
    @bind-SelectedRfc:after="OnAccountPickerRfcChangedAsync"
    @bind-Selection="accountSelection"
    SearchRequested="OnAccountPickerSearchRequestedAsync"
    ErrorChanged="OnAccountPickerErrorChangedAsync" />

  <div class="mt-3 d-flex flex-wrap align-items-center gap-2">
    @if (HasAccountSelection)
    {
      <span class="badge text-bg-primary">Nivel1: @accountSelection!.Nivel1</span>
      <span class="badge text-bg-primary">Nivel2: @accountSelection!.Nivel2</span>
      @if (!string.IsNullOrWhiteSpace(accountSelection!.Nivel3))
      {
        <span class="badge text-bg-primary">Nivel3: @accountSelection!.Nivel3</span>
      }
      @if (!string.IsNullOrWhiteSpace(accountSelection!.Descripcion))
      {
        <span class="badge text-bg-info text-wrap">@accountSelection!.Descripcion</span>
      }
    }
        <a href="/contabilidad/transacciones/new" class="btn btn-success ms-auto">Nueva Transacción</a>
    <button class="btn btn-primary" @onclick="OnBuscarClickedAsync" disabled="@(!CanBuscar)">Buscar</button>
  </div>
</div>

<div class="card p-3">
  @if (isLoading)
  {
    <span class="orion-loading" role="status" aria-live="polite">
      <span class="orion-spinner" aria-hidden="true"></span>
      <span class="orion-strong">Trabajando…</span>
    </span>
  }
  else if (registros.Any())
  {
        <div class="table-responsive table-scroll">
            <table class="table table-sm table-bordered table-striped align-middle compact-table">
        <thead class="table-dark">
          <tr>
            <th>Id</th>
            <th>Poliza</th>
            <th>Fecha</th>
            <th>Concepto</th>
            <th>Debe</th>
            <th>Haber</th>
            <th>Balance</th>
            <th>Revisado</th>
            <th>Orden</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var row in registros)
          {
            <tr>
              <td>@row.Id</td>
              <td>
                <button class="btn btn-link btn-sm p-0" type="button" @onclick="() => GoToPoliza(row.Poliza)">@row.Poliza</button>
              </td>
              <td>@row.Fecha</td>
              <td>@row.Concepto</td>
              <td>@row.Debe</td>
              <td>@row.Haber</td>
              <td>@row.Balance</td>
              
              <td>@row.Revisado</td>
              <td>
                <div class="d-inline-flex flex-column gap-1">
                  <button class="btn btn-outline-secondary btn-sm py-0" type="button"
                          disabled="@(!CanMoveUp(row.Poliza) || isLoading)"
                          @onclick="() => MoveUpAsync(row)">
                    Up
                  </button>
                  <button class="btn btn-outline-secondary btn-sm py-0" type="button"
                          disabled="@(!CanMoveDown(row.Poliza) || isLoading)"
                          @onclick="() => MoveDownAsync(row)">
                    Down
                  </button>
                </div>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  }
  else if (hasSearched)
  {
    <div class="alert alert-info mb-0">Sin resultados</div>
  }
</div>

@code {
  private CuentaContablePicker? accountPicker;
  private CuentaContableSelection? accountSelection;
  private string? selectedRfc;
  private string? lastComponentRfc;
  private DateTime startDate = new DateTime(DateTime.Today.Year, 1, 1);
  private DateTime endDate = DateTime.Today;
  private readonly List<RegistrosContablesRow> registros = new();
  private readonly List<int> transaccionOrder = new();
  private bool hasSearched;
  private bool isLoading;
  private string? errorMessage;
  private bool suppressRfcChange;
  private string? lastQueryKey;

  [Parameter, SupplyParameterFromQuery(Name = "nivel1")]
  public string? QueryNivel1 { get; set; }

  [Parameter, SupplyParameterFromQuery(Name = "nivel2")]
  public string? QueryNivel2 { get; set; }

  [Parameter, SupplyParameterFromQuery(Name = "nivel3")]
  public string? QueryNivel3 { get; set; }

  [Parameter, SupplyParameterFromQuery(Name = "rfc")]
  public string? QueryRfc { get; set; }

  private bool HasAccountSelection => accountSelection?.HasNivel2 ?? false;
  private bool HasCompleteAccount => accountSelection?.HasNivel3 ?? false;
  private bool CanBuscar => HasAccountSelection && !string.IsNullOrWhiteSpace(selectedRfc);

  protected override Task OnInitializedAsync()
  {
    selectedRfc = RfcState.CurrentRfc;
    if (string.IsNullOrWhiteSpace(selectedRfc))
    {
      RfcState.ResetToDefault();
      selectedRfc = RfcState.CurrentRfc;
    }

    return Task.CompletedTask;
  }

  protected override async Task OnParametersSetAsync()
  {
    if (string.IsNullOrWhiteSpace(selectedRfc))
    {
      selectedRfc = RfcState.CurrentRfc;
    }

    if (string.IsNullOrWhiteSpace(selectedRfc) && !string.IsNullOrWhiteSpace(QueryRfc))
    {
      selectedRfc = QueryRfc;
    }

    if (!string.IsNullOrWhiteSpace(QueryRfc) && !string.Equals(QueryRfc, RfcState.CurrentRfc, StringComparison.OrdinalIgnoreCase))
    {
      if (RfcState.TrySet(QueryRfc))
      {
        selectedRfc = RfcState.CurrentRfc;
      }
    }

    var currentQueryKey = $"{QueryNivel1}|{QueryNivel2}|{QueryNivel3}|{QueryRfc}";

    if (!string.IsNullOrWhiteSpace(QueryNivel1) && !string.Equals(currentQueryKey, lastQueryKey, StringComparison.Ordinal))
    {
      accountSelection = new CuentaContableSelection
      {
        Nivel1 = QueryNivel1,
        Nivel2 = string.IsNullOrWhiteSpace(QueryNivel2) ? null : QueryNivel2,
        Nivel3 = string.IsNullOrWhiteSpace(QueryNivel3) ? null : QueryNivel3,
        Rfc = selectedRfc
      };

      lastQueryKey = currentQueryKey;

      if (CanBuscar)
      {
        await BuscarAsync();
      }
    }
  }

  private async Task OnRfcChangedAsync()
  {
    if (suppressRfcChange)
    {
      suppressRfcChange = false;
      return;
    }

    accountSelection = null;
    registros.Clear();
    transaccionOrder.Clear();
    hasSearched = false;
    errorMessage = null;

    await InvokeAsync(StateHasChanged);
  }

  private async Task OnAccountPickerRfcChangedAsync()
  {
    if (string.IsNullOrWhiteSpace(selectedRfc))
    {
      return;
    }

    if (string.Equals(lastComponentRfc, selectedRfc, StringComparison.OrdinalIgnoreCase))
    {
      return;
    }

    lastComponentRfc = selectedRfc;
    suppressRfcChange = true;
    if (!RfcState.TrySet(selectedRfc))
    {
      suppressRfcChange = false;
      await InvokeAsync(StateHasChanged);
    }
  }

  private Task OnAccountPickerErrorChangedAsync(string? message)
  {
    errorMessage = message;
    return Task.CompletedTask;
  }

  private async Task OnAccountPickerSearchRequestedAsync()
  {
    if (!CanBuscar)
    {
      return;
    }

    await BuscarAsync();
  }

  private async Task OnBuscarClickedAsync()
  {
    if (accountPicker?.RequiresDirectAccountResolution == true)
    {
      var resolved = await accountPicker.TryResolveDirectAccountAsync();
      if (!resolved)
      {
        return;
      }
    }

    if (!CanBuscar)
    {
      return;
    }

    await BuscarAsync();
  }

  private async Task BuscarAsync()
  {
    if (!CanBuscar || accountSelection is null)
    {
      return;
    }

    isLoading = true;
    errorMessage = null;
    hasSearched = true;

    try
    {
      var nivel3 = string.IsNullOrWhiteSpace(accountSelection.Nivel3) ? "00" : accountSelection.Nivel3!;
      var items = await RegistrosService.GetRegistrosAsync(startDate, endDate, selectedRfc!, accountSelection.Nivel1!, accountSelection.Nivel2!, nivel3);
      registros.Clear();
      registros.AddRange(items);
      UpdateTransaccionOrder();
    }
    catch (Exception ex)
    {
      registros.Clear();
      transaccionOrder.Clear();
      ReportError("No se pudo cargar información", ex);
    }
    finally
    {
      isLoading = false;
    }
  }

  private void GoToPoliza(int poliza)
    => Navigation.NavigateTo($"/contabilidad/transacciones/{poliza}");

  private void UpdateTransaccionOrder()
  {
    transaccionOrder.Clear();
    var seen = new HashSet<int>();
    foreach (var row in registros)
    {
      if (seen.Add(row.Poliza))
      {
        transaccionOrder.Add(row.Poliza);
      }
    }
  }

  private bool CanMoveUp(int transaccionId)
  {
    var index = transaccionOrder.IndexOf(transaccionId);
    return index > 0;
  }

  private bool CanMoveDown(int transaccionId)
  {
    var index = transaccionOrder.IndexOf(transaccionId);
    return index >= 0 && index < transaccionOrder.Count - 1;
  }

  private async Task MoveUpAsync(RegistrosContablesRow row)
  {
    await MoveAsync(row, -1);
  }

  private async Task MoveDownAsync(RegistrosContablesRow row)
  {
    await MoveAsync(row, 1);
  }

  private async Task MoveAsync(RegistrosContablesRow row, int direction)
  {
    if (transaccionOrder.Count == 0)
    {
      return;
    }

    var anchorId = row.Poliza;
    var anchorIndex = transaccionOrder.IndexOf(anchorId);
    var targetIndex = anchorIndex + direction;
    if (anchorIndex < 0 || targetIndex < 0 || targetIndex >= transaccionOrder.Count)
    {
      return;
    }

    var targetId = transaccionOrder[targetIndex];

    isLoading = true;
    errorMessage = null;

    try
    {
      await RegistrosService.ReorderTransaccionAsync(anchorId, targetId, transaccionOrder);
      await BuscarAsync();
    }
    catch (Exception ex)
    {
      ReportError("No se pudo reordenar la transacción", ex);
      isLoading = false;
    }
  }

  private void ReportError(string message, Exception exception)
  {
    errorMessage = message;
    Console.Error.WriteLine($"[ContabilidadRegistros] {message}: {exception}");
  }
}
