@page "/cfdi/LigarComplemento_Poliza/{DoctoRelacionado_Id:int}"
@using System.Linq
@using OrionERP.Application.Features.Cfdi.DeclaracionPrevia
@using OrionERP.Application.Features.Contabilidad.Transacciones
@attribute [Authorize(Roles = "Administrador,SatOperator")]

<PageTitle>Ligar Complemento @DoctoRelacionado_Id a Póliza</PageTitle>

@if (IsLoading)
{
  <div class="orion-loading" role="status" aria-live="polite">
    <span class="orion-spinner" aria-hidden="true"></span>
    <span class="orion-strong">Cargando información…</span>
  </div>
}
else
{
  @if (!string.IsNullOrEmpty(InlineError))
  {
    <div class="alert alert-danger" role="alert">@InlineError</div>
  }

  @if (DoctoRelacionado is null)
  {
    <div class="alert alert-warning">Complemento de pago no encontrado.</div>
  }
  else
  {
    <div class="card shadow-sm mb-3">
      <div class="card-header">
        <h5 class="mb-0">Complemento @DoctoRelacionado.DoctoRelacionado_Id</h5>
      </div>
      <div class="card-body">
        <div class="row g-3">
          <div class="col-md-4">
            <label class="form-label fw-bold">Emisor RFC</label>
            <div class="form-control-plaintext">@DoctoRelacionado.EmisorRfc</div>
          </div>
          <div class="col-md-4">
            <label class="form-label fw-bold">Receptor RFC</label>
            <div class="form-control-plaintext">@DoctoRelacionado.ReceptorRfc</div>
          </div>
          <div class="col-md-4">
            <label class="form-label fw-bold">UUID Docto Relacionado</label>
            <div class="form-control-plaintext">@DoctoRelacionado.UUID_DoctoRelacionado</div>
          </div>
          <div class="col-md-3">
            <label class="form-label fw-bold">Fecha Pago</label>
            <div class="form-control-plaintext">@DoctoRelacionado.FechaPago?.ToString("yyyy-MM-dd")</div>
          </div>
          <div class="col-md-3">
            <label class="form-label fw-bold">Forma de Pago</label>
            <div class="form-control-plaintext">@DoctoRelacionado.FormaDePagoP</div>
          </div>
          <div class="col-md-3">
            <label class="form-label fw-bold">Moneda</label>
            <div class="form-control-plaintext">@DoctoRelacionado.MonedaP</div>
          </div>
          <div class="col-md-3">
            <label class="form-label fw-bold">Monto Pago</label>
            <div class="form-control-plaintext">@DoctoRelacionado.MontoPago.ToString("C")</div>
          </div>
          <div class="col-md-3">
            <label class="form-label fw-bold">Folio</label>
            <div class="form-control-plaintext">@DoctoRelacionado.Folio</div>
          </div>
          <div class="col-md-3">
            <label class="form-label fw-bold">Parcialidad</label>
            <div class="form-control-plaintext">@DoctoRelacionado.NumParcialidad</div>
          </div>
          <div class="col-md-3">
            <label class="form-label fw-bold">Imp. Pagado</label>
            <div class="form-control-plaintext">@DoctoRelacionado.ImpPagado.ToString("C")</div>
          </div>
          <div class="col-md-3">
            <label class="form-label fw-bold">Imp. Saldo Insoluto</label>
            <div class="form-control-plaintext">@DoctoRelacionado.ImpSaldoInsoluto.ToString("C")</div>
          </div>
        </div>
      </div>
    </div>
  }

  <div class="card shadow-sm mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
      <h5 class="mb-0">Pólizas Ligadas</h5>
      <span class="text-muted small">@Polizas.Count póliza(s)</span>
    </div>
    <div class="card-body">
      @if (IsPolizasLoading)
      {
        <div class="orion-loading" role="status" aria-live="polite">
          <span class="orion-spinner" aria-hidden="true"></span>
          <span class="orion-strong">Cargando pólizas...</span>
        </div>
      }
      else if (Polizas.Count == 0)
      {
        <div class="alert alert-secondary mb-0">No hay pólizas vinculadas a este complemento.</div>
      }
      else
      {
        <table class="table table-striped mt-2">
          <thead>
            <tr>
              <th>ID</th>
              <th>Fecha</th>
              <th>Concepto</th>
              <th>Monto</th>
              <th>Monto Asignado</th>
              <th>Tipo de Póliza</th>
              <th>Forma de Pago</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            @foreach (var poliza in Polizas)
            {
              <tr>
                <td>@poliza.Id</td>
                <td>@poliza.Fecha.ToShortDateString()</td>
                <td>@poliza.Concepto</td>
                <td>@poliza.Monto</td>
                <td>@poliza.MontoAsignado</td>
                <td>@poliza.TipoPoliza</td>
                <td>@poliza.FormaPago</td>
                <td>
                  <a href="/contabilidad/transacciones/@poliza.Id" class="btn btn-sm btn-primary">Ver/Editar</a>
                </td>
              </tr>
            }
          </tbody>
          <tfoot>
            <tr>
              <td colspan="3"></td>
              <td><strong>Total:</strong></td>
              <td>@Polizas.Sum(p => p.MontoAsignado)</td>
              <td colspan="2"></td>
            </tr>
          </tfoot>
        </table>
      }
    </div>
  </div>

  <div class="d-flex justify-content-end align-items-center mb-3">
    <button class="btn btn-primary"
            disabled="@(!CanLigar || IsLinking)"
            @onclick="LigarAsync">
      @(IsLinking ? "Ligando..." : "Ligar")
    </button>
  </div>

  <div class="card shadow-sm">
    <div class="card-header">
      <h5 class="mb-0">Transacciones</h5>
    </div>
    <div class="card-body">
      <EditForm Model="Filter">
        <div class="row">
          <div class="col-md-3">
            <div class="form-group">
              <label for="year">Año</label>
              <select id="year" class="form-control" @bind="Filter.Year">
                <option value="">Todos</option>
                @for (var year = 2035; year >= 2000; year--)
                {
                  <option value="@year">@year</option>
                }
              </select>
            </div>
          </div>
          <div class="col-md-3">
            <div class="form-group">
              <label for="month">Mes</label>
              <select id="month" class="form-control" @bind="Filter.Month">
                <option value="">Todos</option>
                <option value="1">Enero</option>
                <option value="2">Febrero</option>
                <option value="3">Marzo</option>
                <option value="4">Abril</option>
                <option value="5">Mayo</option>
                <option value="6">Junio</option>
                <option value="7">Julio</option>
                <option value="8">Agosto</option>
                <option value="9">Septiembre</option>
                <option value="10">Octubre</option>
                <option value="11">Noviembre</option>
                <option value="12">Diciembre</option>
              </select>
            </div>
          </div>
        </div>

        <div class="row mt-3">
          <div class="col-md-12 text-right">
            <button type="button" class="btn btn-primary" @onclick="BuscarAsync" disabled="@IsTransaccionesLoading">Buscar</button>
            <button type="button" class="btn btn-secondary" @onclick="LimpiarFiltrosAsync" disabled="@IsTransaccionesLoading">Limpiar</button>
            <a href="/contabilidad/transacciones/new" class="btn btn-success">Nueva Transacción</a>
          </div>
        </div>

        @if (IsTransaccionesLoading)
        {
          <p><em>Cargando...</em></p>
        }
        else
        {
          <table class="table table-striped mt-4">
            <thead>
              <tr>
                <th>
                  <a href="#" @onclick='() => Ordenar("Id")'>ID</a>
                  @if (Filter.SortBy == "Id")
                  {
                    <span>@(Filter.SortAsc ? "▲" : "▼")</span>
                  }
                  <InputNumber class="form-control" @bind-Value="Filter.Id" />
                </th>
                <th>
                  <a href="#" @onclick='() => Ordenar("Fecha")'>Fecha</a>
                  @if (Filter.SortBy == "Fecha")
                  {
                    <span>@(Filter.SortAsc ? "▲" : "▼")</span>
                  }
                </th>
                <th>
                  <a href="#" @onclick='() => Ordenar("Concepto")'>Concepto</a>
                  @if (Filter.SortBy == "Concepto")
                  {
                    <span>@(Filter.SortAsc ? "▲" : "▼")</span>
                  }
                  <InputText class="form-control" @bind-Value="Filter.Concepto" />
                </th>
                <th>
                  <a href="#" @onclick='() => Ordenar("Monto")'>Monto</a>
                  @if (Filter.SortBy == "Monto")
                  {
                    <span>@(Filter.SortAsc ? "▲" : "▼")</span>
                  }
                  <InputNumber class="form-control" @bind-Value="Filter.Monto" />
                </th>
                <th>
                  <a href="#" @onclick='() => Ordenar("TipoPoliza")'>Tipo de Póliza</a>
                  @if (Filter.SortBy == "TipoPoliza")
                  {
                    <span>@(Filter.SortAsc ? "▲" : "▼")</span>
                  }
                  <InputText class="form-control" @bind-Value="Filter.TipoPoliza" />
                </th>
                <th>
                  <a href="#" @onclick='() => Ordenar("FormaPago")'>Forma de Pago</a>
                  @if (Filter.SortBy == "FormaPago")
                  {
                    <span>@(Filter.SortAsc ? "▲" : "▼")</span>
                  }
                  <InputText class="form-control" @bind-Value="Filter.FormaPago" />
                </th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              @foreach (var transaccion in Transacciones)
              {
                <tr class="@GetRowClass(transaccion)" @onclick="() => SeleccionarTransaccion(transaccion)">
                  <td>@transaccion.Id</td>
                  <td>@transaccion.Fecha.ToShortDateString()</td>
                  <td>@transaccion.Concepto</td>
                  <td>@transaccion.Monto</td>
                  <td>@transaccion.TipoPoliza</td>
                  <td>@transaccion.FormaPago</td>
                  <td>
                    <a href="/contabilidad/transacciones/@transaccion.Id" class="btn btn-sm btn-primary">Ver/Editar</a>
                  </td>
                </tr>
              }
            </tbody>
          </table>

          <div class="form-text">
            Selecciona una transacción para habilitar el botón “Ligar”.
          </div>
        }
      </EditForm>
    </div>
  </div>
}
