@page "/ReportesFinancieros/BalanzaComprobacion"
@page "/reportes-financieros/balanza-comprobacion"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Administrador")]
@using System.Globalization

<PageTitle>Balanza de Comprobación</PageTitle>

<div class="balanza-page">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="m-0">Balanza de Comprobación</h1>
    </div>

    <!-- FILTROS -->
    <div class="card mb-3 no-print">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                <div class="flex-grow-1">
                    <h6 class="mb-1">Filtros</h6>
                    <div class="text-muted small mb-3">
                        Configure el periodo y RFC para generar la balanza.
                    </div>

                    <div class="row g-3">
                        <div class="col-12 col-md-2">
                            <label class="form-label small text-muted">AÑO</label>
                            <select class="form-select"
                                    @bind="Anio">
                                @{
                                    var current = DateTime.Now.Year;
                                    for (int y = current - 5; y <= current + 1; y++)
                                    {
                                        <option value="@y">@y</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label small text-muted">MES</label>
                            <select class="form-select"
                                    value="@MesSelectValue"
                                    @onchange="OnMesChanged">
                                <option value="">Anual</option>
                                <option value="1">01 - enero</option>
                                <option value="2">02 - febrero</option>
                                <option value="3">03 - marzo</option>
                                <option value="4">04 - abril</option>
                                <option value="5">05 - mayo</option>
                                <option value="6">06 - junio</option>
                                <option value="7">07 - julio</option>
                                <option value="8">08 - agosto</option>
                                <option value="9">09 - septiembre</option>
                                <option value="10">10 - octubre</option>
                                <option value="11">11 - noviembre</option>
                                <option value="12">12 - diciembre</option>
                            </select>
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label small text-muted">RFC</label>

                            <!-- Si ya tienes un picker reutilizable, úsalo aquí -->
                            <!-- Ejemplo esperado por el code-behind -->
                            <!--
                            <RfcPicker SelectedRfc="CurrentRfc"
                                       SelectedRfcChanged="OnRfcChangedFromPicker" />
                            -->
                            <!-- Fallback simple -->
                            <input class="form-control"
                                   value="@CurrentRfc"
                                   @onchange="async e => await OnRfcChangedFromPicker(e.Value?.ToString())" />
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button class="btn btn-primary"
                            @onclick="BuscarAsync"
                            disabled="@IsLoading">
                        Buscar / Generar
                    </button>

                    <button class="btn btn-outline-secondary"
                            @onclick="PrintAsync"
                            disabled="@(!Resultados.Any())">
                        Imprimir
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- RESULTADOS -->
    <div id="balanza-comprobacion-print-root" class="card">
        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-2">
                <div>
                    <h6 class="mb-0">Resultados</h6>
                    @if (!string.IsNullOrWhiteSpace(CurrentRfc) && !string.IsNullOrWhiteSpace(PeriodoDescripcion))
                    {
                        <div class="small text-muted">
                            RFC: @CurrentRfc &nbsp;&nbsp; Periodo: @PeriodoDescripcion
                        </div>
                    }
                </div>

                
            </div>

            @if (IsLoading)
            {
                <div class="text-muted">Cargando...</div>
            }
            else if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="alert alert-danger">@ErrorMessage</div>
            }
            else if (!Resultados.Any())
            {
                <div class="text-muted">No hay datos para los filtros seleccionados.</div>
            }
            else
            {
                <!-- ESTA ES LA ZONA QUE VAMOS A IMPRIMIR -->
                <div id="balanza-print">

                    <div class="table-responsive">
                        <table id="balanza-comprobacion-table" class="table table-sm table-bordered align-middle balanza-table">
                            <thead class="table-light">
                                <tr>
                                    <th style="min-width: 340px;">CUENTA</th>
                                    <th class="text-end">DEBE ANT.</th>
                                    <th class="text-end">HABER ANT.</th>
                                    <th class="text-end">SALDO INICIAL</th>
                                    <th class="text-end">@DebeMesLabel.ToUpperInvariant()</th>
                                    <th class="text-end">@HaberMesLabel.ToUpperInvariant()</th>
                                    <th class="text-end">@SaldoMesLabel.ToUpperInvariant()</th>
                                    <th class="text-end">SALDO FINAL</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in OrderedRows)
                                {
                                    <tr class="@GetRowClass(row)" @onclick="() => GoToContabilidadRegistros(row)" style="cursor: pointer;">
                                        <td class="@GetIndentClass(row)">
                                            @GetCuentaDescripcion(row)
                                        </td>
                                        <td class="text-end">@FormatMonto(row.Debe_Ant)</td>
                                        <td class="text-end">@FormatMonto(row.Haber_Ant)</td>
                                        <td class="text-end">@FormatMonto(row.Saldo_Inicial)</td>
                                        <td class="text-end">@FormatMonto(row.Debe_Mes)</td>
                                        <td class="text-end">@FormatMonto(row.Haber_Mes)</td>
                                        <td class="text-end">@FormatMonto(row.Saldo_Mes)</td>
                                        <td class="text-end">@FormatMonto(row.Saldo_Final)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                </div>
            }
        </div>
    </div>
</div>



<style>
    /* Base cell padding, optional */
    .balanza-table td {
        padding-right: .5rem; /* keep nice right padding */
    }

        /* Stronger selectors than Bootstrap */
        .balanza-table td.balanza-indent-1 {
            padding-left: .25rem;
        }

        .balanza-table td.balanza-indent-2 {
            padding-left: 1.25rem;
        }

        .balanza-table td.balanza-indent-3 {
            padding-left: 2.25rem;
        }

    /* Peso visual por jerarquía */
    .level-1 td {
        font-weight: 700;
        background: #f8f9fa;
    }

    .level-2 td {
        font-weight: 600;
        background: #fcfcfd;
    }

    .level-3 td {
        font-weight: 400;
    }

    .balanza-table th, .balanza-table td {
        white-space: nowrap;
    }

    /* Impresión */
    @@media print {
        .no-print

    {
        display: none !important;
    }

    /* Oculta TODO excepto el contenedor de impresión */
    body * {
        visibility: hidden !important;
    }

    #balanza-print, #balanza-print * {
        visibility: visible !important;
    }

    #balanza-print {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
    }

    /* Evita recortes por responsive wrapper */
    .table-responsive {
        overflow: visible !important;
    }

    table {
        width: 100% !important;
    }

    th, td {
        font-size: 11px;
    }
    }
   </style>
