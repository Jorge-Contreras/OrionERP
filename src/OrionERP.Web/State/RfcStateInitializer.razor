@using Microsoft.AspNetCore.Components.Authorization
@using OrionERP.Infrastructure.Auth
@implements IDisposable

@ChildContent

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; } = default!;
    [Inject] private IUserRfcState RfcState { get; set; } = default!;
    [Inject] private IRfcContext RfcContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        AuthStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        await ApplyAsync(await AuthStateProvider.GetAuthenticationStateAsync());
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> stateTask)
    {
        try { await ApplyAsync(await stateTask); }
        catch { /* circuit teardown or logout */ }
    }

    private Task ApplyAsync(AuthenticationState state)
    {
        RfcState.InitializeFromClaims(state.User);
        RfcContext.CurrentRfc = RfcState.CurrentRfc;
        return InvokeAsync(StateHasChanged);
    }

    public void Dispose() => AuthStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
}
