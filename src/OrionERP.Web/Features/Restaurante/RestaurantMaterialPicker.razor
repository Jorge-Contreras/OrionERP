@using Microsoft.AspNetCore.Components.Web

<div class="restaurant-material-picker @(Compact ? "restaurant-material-picker--compact" : null)">
  @if (!string.IsNullOrWhiteSpace(Label))
  {
    <label for="@inputId">@Label</label>
  }
  <div class="restaurant-material-picker__control @(isOpen ? "is-open" : null)">
    <span class="oi oi-magnifying-glass" aria-hidden="true"></span>
    <input id="@inputId"
           type="search"
           value="@InputText"
           placeholder="@Placeholder"
           disabled="@Disabled"
           autocomplete="off"
           role="combobox"
           aria-autocomplete="list"
           aria-expanded="@isOpen.ToString().ToLowerInvariant()"
           aria-controls="@listboxId"
           aria-label="@(string.IsNullOrWhiteSpace(Label) ? Placeholder : Label)"
           @onfocus="Open"
           @oninput="Filter"
           @onkeydown="HandleKeyDown" />
    @if (Value > 0 && !Disabled)
    {
      <button type="button" class="restaurant-material-picker__clear" title="Quitar material" aria-label="Quitar material" @onclick="Clear">×</button>
    }
    <button type="button"
            class="restaurant-material-picker__toggle"
            disabled="@Disabled"
            aria-label="@(isOpen ? "Cerrar lista de materiales" : "Abrir lista de materiales")"
            @onclick="Toggle">
      <span class="oi @(isOpen ? "oi-chevron-top" : "oi-chevron-bottom")" aria-hidden="true"></span>
    </button>
  </div>

  @if (isOpen && !Disabled)
  {
    <div id="@listboxId" class="restaurant-material-picker__results" role="listbox" aria-label="Resultados de materiales">
      <div class="restaurant-material-picker__summary">
        <span>@ResultSummary</span>
        <button type="button" @onclick="Close">Cerrar</button>
      </div>
      @if (FilteredOptions.Count == 0)
      {
        <p class="restaurant-material-picker__empty">No hay materiales que coincidan con “@searchText”.</p>
      }
      else
      {
        @foreach (var option in FilteredOptions)
        {
          <button type="button"
                  class="restaurant-material-picker__option @(option.Id == Value ? "is-selected" : null)"
                  role="option"
                  aria-selected="@(option.Id == Value ? "true" : "false")"
                  @onclick="() => SelectAsync(option.Id)">
            <span><strong>@option.Description</strong><small>@option.Code</small></span>
            @if (!string.IsNullOrWhiteSpace(option.Detail))
            {
              <em>@option.Detail</em>
            }
          </button>
        }
      }
    </div>
  }
</div>

@code {
  private readonly string inputId = $"material-search-{Guid.NewGuid():N}";
  private readonly string listboxId = $"material-results-{Guid.NewGuid():N}";
  private string searchText = string.Empty;
  private bool isOpen;

  [Parameter] public IReadOnlyList<RestaurantMaterialOption> Options { get; set; } = [];
  [Parameter] public int Value { get; set; }
  [Parameter] public EventCallback<int> ValueChanged { get; set; }
  [Parameter] public EventCallback<int> Changed { get; set; }
  [Parameter] public string? Label { get; set; }
  [Parameter] public string Placeholder { get; set; } = "Buscar material por código o nombre…";
  [Parameter] public bool Disabled { get; set; }
  [Parameter] public bool Compact { get; set; }
  [Parameter] public int MaximumResults { get; set; } = 80;

  private RestaurantMaterialOption? SelectedOption => Options.FirstOrDefault(option => option.Id == Value);
  private string InputText => isOpen ? searchText : SelectedOption?.DisplayText ?? string.Empty;
  private int MatchCount => string.IsNullOrWhiteSpace(searchText)
    ? Options.Count
    : Options.Count(option => option.Matches(searchText));
  private IReadOnlyList<RestaurantMaterialOption> FilteredOptions => Options
    .Where(option => option.Matches(searchText))
    .Take(Math.Max(1, MaximumResults))
    .ToList();
  private string ResultSummary => MatchCount > MaximumResults
    ? $"Mostrando {MaximumResults} de {MatchCount}; escribe para afinar la búsqueda."
    : $"{MatchCount} material{(MatchCount == 1 ? string.Empty : "es")} disponible{(MatchCount == 1 ? string.Empty : "s")}";

  private void Open()
  {
    isOpen = true;
    searchText = string.Empty;
  }

  private void Toggle()
  {
    if (isOpen)
    {
      Close();
    }
    else
    {
      Open();
    }
  }

  private void Filter(ChangeEventArgs args)
  {
    searchText = args.Value?.ToString() ?? string.Empty;
    isOpen = true;
  }

  private void HandleKeyDown(KeyboardEventArgs args)
  {
    if (args.Key == "Escape")
    {
      Close();
    }
  }

  private async Task Clear()
    => await SelectAsync(0);

  private async Task SelectAsync(int materialId)
  {
    isOpen = false;
    searchText = string.Empty;
    if (ValueChanged.HasDelegate)
    {
      await ValueChanged.InvokeAsync(materialId);
    }
    if (Changed.HasDelegate)
    {
      await Changed.InvokeAsync(materialId);
    }
  }

  private void Close()
  {
    isOpen = false;
    searchText = string.Empty;
  }
}
