@page "/logistica/compras"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@attribute [Authorize(Roles = "Administrador,Logistica")]

<PageTitle>Logística · Compras</PageTitle>

<div class="container-fluid py-3 compras-page">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h1 class="h3 mb-1">Compras</h1>
            <p class="text-muted mb-0">Prepara la compra, recibe contra el ticket y termina con precios actualizados.</p>
        </div>

        <div class="compras-action-bar">
            <button type="button" class="btn btn-outline-secondary" @onclick="AlternarExploradorOrdenes" disabled="@IsMutating">
                @(ShowOrderBrowser ? "Ocultar compras" : "Buscar compra")
            </button>
            <button type="button" class="btn btn-outline-secondary" @onclick="NuevaOrden" disabled="@IsMutating">
                Nueva compra
            </button>
            @if (IsDraftMode)
            {
                <button type="button" class="btn btn-outline-success" @onclick="AbrirAutoPoModal" disabled="@IsMutating">
                    @(IsCreatingAutoPo ? "Preparando..." : "Sugerir compra")
                </button>
                <button type="button" class="btn btn-primary" @onclick="GuardarBorradorAsync" disabled="@IsMutating">
                    @(IsSavingDraft ? "Guardando..." : "Guardar")
                </button>
            }
            @if (CanIssue)
            {
                <button type="button" class="btn btn-primary" @onclick="EmitirOrdenAsync">
                    @(IsIssuing ? "Enviando..." : "Enviar al proveedor")
                </button>
            }
            @if (CanEnterReceipt)
            {
                <button type="button" class="btn btn-success" @onclick="RegistrarRecepcionAsync" disabled="@(!CanReceive)">
                    @(IsReceiving ? "Registrando..." : "Guardar recepción")
                </button>
            }
            @if (CanComplete)
            {
                <button type="button" class="btn btn-outline-warning" @onclick="CerrarPendienteAsync">
                    @(IsCompleting ? "Cerrando..." : "Cerrar sin recibir lo pendiente")
                </button>
            }
            @if (CanPrint)
            {
                <button type="button" class="btn btn-outline-info" @onclick="ImprimirOrdenAsync">
                    @(IsPrinting ? "Generando..." : "Descargar orden")
                </button>
            }
            @if (CanCancel)
            {
                <button type="button" class="btn btn-link text-danger compras-cancel-action" @onclick="CancelarOrdenAsync">
                    @(IsCancelling ? "Cancelando..." : "Cancelar")
                </button>
            }
        </div>
    </div>

    <section class="compras-process" aria-label="Proceso de compra">
        <ol class="compras-process-steps">
            <li class="@GetProcessStepClass(1)"><span>1</span><div><strong>Preparar</strong><small>Proveedor y materiales</small></div></li>
            <li class="@GetProcessStepClass(2)"><span>2</span><div><strong>Enviar</strong><small>Orden al proveedor</small></div></li>
            <li class="@GetProcessStepClass(3)"><span>3</span><div><strong>Recibir</strong><small>Cantidades y ticket</small></div></li>
            <li class="@GetProcessStepClass(4)"><span>4</span><div><strong>Terminar</strong><small>Actualizar precios</small></div></li>
        </ol>
        <p>@ProcessGuidance</p>
    </section>

    <div class="row g-3">
        <div class="col-12 col-xxl-4 compras-order-browser @(ShowOrderBrowser ? "is-open" : null)">
            <section class="card shadow-sm mb-3">
                <div class="card-body">
                    <h2 class="h5 mb-3">Filtros</h2>
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label">Buscar</label>
                            <input class="form-control" type="search" placeholder="PO, proveedor o nota" @bind="Filter.SearchText" @bind:event="oninput" @onkeyup="OnOrderSearchKeyUpAsync" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Proveedor</label>
                            <select class="form-select" @bind="Filter.VendorId">
                                <option value="">Todos</option>
                                @foreach (var vendor in VendorOptions)
                                {
                                    <option value="@vendor.Id">@vendor.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Estado</label>
                            <select class="form-select" @bind="Filter.Status">
                                <option value="">Todos</option>
                                @foreach (var status in StatusOptions)
                                {
                                    <option value="@status">@GetStatusLabel(status)</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-check d-flex align-items-center gap-2 mb-0">
                                <input class="form-check-input" type="checkbox" @bind="Filter.OpenOnly" />
                                <span class="form-check-label">Solo abiertas</span>
                            </label>
                        </div>
                    </div>

                    <button type="button" class="btn btn-primary mt-3" @onclick="BuscarOrdenesAsync" disabled="@IsLoadingOrders">
                        @(IsLoadingOrders ? "Buscando..." : "Buscar")
                    </button>
                </div>
            </section>

            <section class="card shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h2 class="h5 mb-0">Órdenes</h2>
                        <span class="text-muted small">@Orders.Count registros</span>
                    </div>

                    <div class="table-responsive compras-orders-scroll">
                        <table class="table table-sm table-hover align-middle compras-orders-table">
                            <thead class="table-light">
                                <tr>
                                    <th>Orden</th>
                                    <th>Proveedor</th>
                                    <th class="text-end">Materiales</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Orders.Count == 0)
                                {
                                    <tr>
                                        <td colspan="3" class="text-center text-muted py-3">No hay órdenes para el filtro actual.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var order in Orders)
                                    {
                                        <tr class="@GetOrderRowClass(order)" style="cursor: pointer;" @onclick="() => SeleccionarOrdenAsync(order.Id)">
                                            <td>
                                                <div class="fw-semibold">@order.PurchaseOrderCode</div>
                                                <div class="small text-muted">@order.OrderDate.ToShortDateString()</div>
                                                <span class="@GetStatusBadgeClass(order.Status)">@GetStatusLabel(order.Status)</span>
                                            </td>
                                            <td>
                                                <div>@order.VendorName</div>
                                                <small class="text-muted">@(order.ExpectedDate.HasValue ? $"Esp: {order.ExpectedDate.Value:dd/MM/yyyy}" : "Sin fecha esperada")</small>
                                            </td>
                                            <td class="text-end">
                                                <div>@order.LineCount.ToString("N0")</div>
                                                <small class="text-muted">@order.AllocationCount.ToString("N0") ubicaciones</small>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>
        </div>

        <div class="col-12 col-xxl-8">
            <EditForm Model="Editor">
                <DataAnnotationsValidator />

                <section class="card shadow-sm mb-3">
                    <div class="card-body">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                            <div>
                                <h2 class="h4 mb-1">@CurrentOrderCode</h2>
                                <div class="text-muted">Status actual</div>
                                <span class="@CurrentStatusBadgeClass">@CurrentStatusLabel</span>
                            </div>

                            <div class="compras-summary-grid">
                                <div class="compras-summary-card">
                                    <div class="compras-summary-label">Materiales</div>
                                    <div class="compras-summary-value">@CurrentMaterialCount.ToString("N0")</div>
                                </div>
                                <div class="compras-summary-card">
                                    <div class="compras-summary-label">Ubicaciones</div>
                                    <div class="compras-summary-value">@CurrentAllocationCount.ToString("N0")</div>
                                </div>
                                <div class="compras-summary-card">
                                    <div class="compras-summary-label">Pendientes</div>
                                    <div class="compras-summary-value">@CurrentPendingAllocationCount.ToString("N0")</div>
                                </div>
                            </div>
                        </div>

                        @if (SelectedPurchaseOrder is not null)
                        {
                            <div class="compras-room-scope-panel mb-3">
                                <div class="compras-summary-label">Suites Auto PO</div>
                                <div class="compras-room-chip-wrap">
                                    @if (SelectedPurchaseOrderRoomScope.Count == 0)
                                    {
                                        <span class="compras-room-chip compras-room-chip-all">Todas las suites</span>
                                    }
                                    else
                                    {
                                        @foreach (var room in SelectedPurchaseOrderRoomScope)
                                        {
                                            <span class="compras-room-chip">@room.Name</span>
                                        }
                                    }
                                </div>
                                <div class="small text-muted mt-2">
                                    Alcance guardado: @SelectedPurchaseOrderRoomScopeSummary
                                </div>
                            </div>
                        }

                        <ValidationSummary />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Proveedor</label>
                                <InputSelect class="form-select" @bind-Value="Editor.BusinessPartnerId" disabled="@(!CanEditVendor)">
                                    <option value="0">Selecciona un proveedor</option>
                                    @foreach (var vendor in VendorOptions)
                                    {
                                        <option value="@vendor.Id">@vendor.Name</option>
                                    }
                                </InputSelect>
                                @if (!CanEditVendor)
                                {
                                    <div class="form-text">El proveedor se bloquea cuando ya existen materiales en la orden.</div>
                                }
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Fecha orden</label>
                                <InputDate class="form-control" @bind-Value="Editor.OrderDate" disabled="@(!IsDraftMode)" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Fecha esperada</label>
                                <InputDate class="form-control" @bind-Value="Editor.ExpectedDate" disabled="@(!IsDraftMode)" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Notas</label>
                                <InputTextArea class="form-control" rows="3" @bind-Value="Editor.Notes" disabled="@(!IsDraftMode)" />
                            </div>
                        </div>
                    </div>
                </section>

                @if (IsDraftMode)
                {
                    <section class="card shadow-sm mb-3">
                        <div class="card-body">
                            <h3 class="h5 mb-3">Agregar materiales</h3>
                            <div class="row g-3 align-items-end">
                                <div class="col-md-8">
                                    <label class="form-label" for="compras-material-search">Buscar material</label>
                                    <input id="compras-material-search"
                                           class="form-control"
                                           type="search"
                                           @bind="MaterialSearchText"
                                           @bind:event="oninput"
                                           @onkeyup="OnMaterialSearchKeyUpAsync"
                                           placeholder="Código, descripción o barras"
                                           autocomplete="off" />
                                </div>
                                <div class="col-md-4">
                                    <button type="button" class="btn btn-outline-primary w-100" @onclick="BuscarMaterialesAsync" disabled="@IsSearchingMaterials">
                                        @(IsSearchingMaterials ? "Buscando..." : "Buscar materiales")
                                    </button>
                                </div>
                            </div>

                            @if (!CanSearchMaterials)
                            {
                                <div class="alert alert-light border mt-3 mb-0">
                                    Selecciona el proveedor primero para saber cuáles de estos materiales te surte de costumbre.
                                </div>
                            }
                            else if (HasExecutedMaterialSearch)
                            {
                                <div class="table-responsive mt-3 compras-material-search-scroll">
                                    <table class="table table-sm table-hover align-middle compras-material-search-table">
                                        <thead class="table-light">
                                            <tr>
                                                <th class="compras-thumb-col">Foto</th>
                                                <th>Material</th>
                                                <th>Unidad</th>
                                                <th class="text-end">Existencia</th>
                                                <th class="text-end"></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (MaterialSearchResults.Count == 0)
                                            {
                                                <tr>
                                                    <td colspan="5" class="text-center text-muted py-3">Ningún material coincide con esa búsqueda.</td>
                                                </tr>
                                            }
                                            else
                                            {
                                                @foreach (var item in MaterialSearchResults)
                                                {
                                                    var thumbnailDataUrl = GetMaterialThumbnailDataUrl(item.Id);
                                                    var materialTitle = string.IsNullOrWhiteSpace(item.Description) ? item.MaterialCode : item.Description;
                                                    <tr>
                                                        <td class="compras-thumb-col">
                                                            @if (thumbnailDataUrl is not null)
                                                            {
                                                                <img src="@thumbnailDataUrl" alt="Imagen de @materialTitle" class="compras-thumb" />
                                                            }
                                                            else
                                                            {
                                                                <div class="compras-thumb-placeholder">@GetMaterialFallbackText(item.MaterialCode, item.Description)</div>
                                                            }
                                                        </td>
                                                        <td>
                                                            <div class="fw-semibold">@materialTitle</div>
                                                            <small class="text-muted">@item.MaterialCode</small>
                                                            @if (item.IsHighlightedVendorMaterial)
                                                            {
                                                                <span class="badge compras-vendor-badge is-usual ms-2">Lo surte este proveedor</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge compras-vendor-badge is-new ms-2"
                                                                      title="@(string.IsNullOrWhiteSpace(item.VendorName) ? "El material no tiene proveedor registrado." : $"Lo surte {item.VendorName}.")">
                                                                    @(string.IsNullOrWhiteSpace(item.VendorName) ? "Sin proveedor registrado" : $"Habitual: {item.VendorName}")
                                                                </span>
                                                            }
                                                        </td>
                                                        <td>@(string.IsNullOrWhiteSpace(item.BaseUnitName) ? "Sin unidad" : item.BaseUnitName)</td>
                                                        <td class="text-end">@item.TotalQuantity.ToString("N2")</td>
                                                        <td class="text-end">
                                                            <button type="button" class="btn btn-sm btn-primary" @onclick="() => AgregarMaterialAsync(item)">
                                                                Agregar
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </section>
                }

                <section class="card shadow-sm mb-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <h3 class="h5 mb-0">Líneas de la orden</h3>
                                <p class="text-muted small mb-0">Las cantidades se muestran en presentación de compra; el precio se captura por unidad base para conservar el costo de inventario.</p>
                            </div>
                            <span class="text-muted small">@Lines.Count materiales</span>
                        </div>

                        @if (IsDraftMode && UnlinkedMaterialNames.Count > 0)
                        {
                            <div class="alert alert-warning compras-vendor-link-notice">
                                <div class="fw-semibold mb-1">
                                    <i class="bi bi-info-circle me-1" aria-hidden="true"></i>
                                    @(UnlinkedMaterialNames.Count == 1
                                        ? "Un material de esta orden no lo surte este proveedor de costumbre."
                                        : $"{UnlinkedMaterialNames.Count} materiales de esta orden no los surte este proveedor de costumbre.")
                                </div>
                                <div class="small mb-2">@string.Join(" · ", UnlinkedMaterialNames)</div>
                                <div class="form-check mb-0">
                                    <input class="form-check-input" type="checkbox" id="compras-link-vendor" @bind="LinkMaterialsToVendor" />
                                    <label class="form-check-label" for="compras-link-vendor">
                                        Registrar a <strong>@CurrentVendorName</strong> como proveedor alternativo de estos materiales al guardar.
                                    </label>
                                </div>
                            </div>
                        }

                        <div class="table-responsive compras-lines-scroll">
                            <table class="table table-sm table-hover align-middle compras-lines-table">
                                <thead class="table-light">
                                    <tr>
                                        <th class="compras-thumb-col">Foto</th>
                                        <th>Material</th>
                                        <th>Unidad compra</th>
                                        <th class="text-end">Precio por unidad base</th>
                                        <th class="text-end">Ordenado</th>
                                        <th class="text-end">Recibido</th>
                                        <th class="text-end">Pendiente</th>
                                        <th class="text-end"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Lines.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="8" class="text-center text-muted py-3">Agrega materiales para construir la orden de compra.</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var line in Lines)
                                        {
                                            var thumbnailDataUrl = GetMaterialThumbnailDataUrl(line.MaterialId);
                                            var materialTitle = string.IsNullOrWhiteSpace(line.MaterialDescription) ? line.MaterialCode : line.MaterialDescription;
                                            <tr class="@(SelectedLine?.MaterialId == line.MaterialId ? "table-primary" : null)" style="cursor: pointer;" @onclick="() => SeleccionarLinea(line)">
                                                <td class="compras-thumb-col">
                                                    @if (thumbnailDataUrl is not null)
                                                    {
                                                        <img src="@thumbnailDataUrl" alt="Imagen de @materialTitle" class="compras-thumb" />
                                                    }
                                                    else
                                                    {
                                                        <div class="compras-thumb-placeholder">@GetMaterialFallbackText(line.MaterialCode, line.MaterialDescription)</div>
                                                    }
                                                </td>
                                                <td>
                                                    <div class="fw-semibold">@materialTitle</div>
                                                    <div class="small text-muted">@line.MaterialCode</div>
                                                    <div class="small text-muted">@(string.IsNullOrWhiteSpace(line.VendorCode) ? "Sin código proveedor" : line.VendorCode)</div>
                                                </td>
                                                <td>
                                                    <div>@GetPurchaseUnitName(line)</div>
                                                    @if (GetPurchasePresentationSummary(line) is { } purchaseSummary)
                                                    {
                                                        <div class="small @(HasInvalidPurchasePackConfiguration(line) ? "text-danger" : "text-muted")">@purchaseSummary</div>
                                                    }
                                                </td>
                                                <td class="text-end">
                                                    @if (IsDraftMode)
                                                    {
                                                        <InputNumber class="form-control form-control-sm compras-inline-number"
                                                                     step="0.000001"
                                                                     aria-label="Precio por unidad base"
                                                                     @bind-Value="line.BaseUnitPrice" />
                                                        <div class="small text-muted">por @(string.IsNullOrWhiteSpace(line.BaseUnitName) ? "unidad base" : line.BaseUnitName)</div>
                                                    }
                                                    else
                                                    {
                                                        @FormatBaseUnitPrice(line)
                                                    }
                                                    @if (GetPurchasePresentationPriceEquivalent(line) is { } priceEquivalent)
                                                    {
                                                        <div class="small text-muted">@priceEquivalent</div>
                                                    }
                                                </td>
                                                <td class="text-end">@FormatPurchaseQuantity(line, line.OrderedQuantity)</td>
                                                <td class="text-end">@FormatPurchaseQuantity(line, line.ReceivedQuantity)</td>
                                                <td class="text-end">@FormatPurchaseQuantity(line, line.RemainingQuantity)</td>
                                                <td class="text-end">
                                                    @if (IsDraftMode)
                                                    {
                                                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => QuitarMaterialAsync(line)" @onclick:stopPropagation="true">
                                                            Quitar
                                                        </button>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>

                @if (SelectedLine is not null)
                {
                    <section class="card shadow-sm mb-3">
                        <div class="card-body">
                            <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
                                @{
                                    var selectedThumbnail = GetMaterialThumbnailDataUrl(SelectedLine.MaterialId);
                                    var selectedMaterialTitle = string.IsNullOrWhiteSpace(SelectedLine.MaterialDescription) ? SelectedLine.MaterialCode : SelectedLine.MaterialDescription;
                                }

                                @if (selectedThumbnail is not null)
                                {
                                    <img src="@selectedThumbnail" alt="Imagen de @selectedMaterialTitle" class="compras-selected-thumb" />
                                }
                                else
                                {
                                    <div class="compras-thumb-placeholder compras-selected-thumb-placeholder">@GetMaterialFallbackText(SelectedLine.MaterialCode, SelectedLine.MaterialDescription)</div>
                                }

                                <div>
                                    <h3 class="h5 mb-1">@selectedMaterialTitle</h3>
                                    <div class="text-muted">@SelectedLine.MaterialCode</div>
                                    <div class="small text-muted">@GetPurchaseUnitName(SelectedLine)</div>
                                    @if (GetPurchasePresentationSummary(SelectedLine) is { } selectedPurchaseSummary)
                                    {
                                        <div class="small @(HasInvalidPurchasePackConfiguration(SelectedLine) ? "text-danger" : "text-muted")">@selectedPurchaseSummary</div>
                                    }
                                </div>
                            </div>

                            @if (IsDraftMode)
                            {
                                @if (HasInvalidPurchaseAllocationMultiple(SelectedLine))
                                {
                                    <div class="alert alert-warning py-2">
                                        Cada ubicación planeada debe quedar en unidades completas de compra antes de guardar.
                                    </div>
                                }
                                else if (HasInvalidPurchaseMultiple(SelectedLine))
                                {
                                    <div class="alert alert-warning py-2">
                                        La cantidad total planeada debe quedar en unidades completas de compra antes de guardar.
                                    </div>
                                }

                                <div class="row g-3 align-items-end mb-3">
                                    <div class="col-md-7">
                                        <label class="form-label">Agregar ubicación</label>
                                        <select class="form-select" @bind="PendingAllocationLocationId">
                                            <option value="0">Selecciona una ubicación</option>
                                            @foreach (var location in LocationOptions.Where(location => SelectedLine.Allocations.All(allocation => allocation.LocationId != location.Id)))
                                            {
                                                <option value="@location.Id">@location.Name</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Cantidad (@GetPurchaseUnitName(SelectedLine))</label>
                                        <input type="number"
                                               step="any"
                                               min="0"
                                               class="form-control"
                                               value="@FormatNumberInput(GetPendingAllocationDisplayQuantity())"
                                               @onchange="UpdatePendingAllocationDisplayQuantity" />
                                        <div class="form-text">
                                            Captura cantidades en unidad de compra. El inventario se convierte internamente a unidad base.
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <button type="button" class="btn btn-outline-primary w-100" @onclick="AgregarAsignacion">
                                            Agregar
                                        </button>
                                    </div>
                                </div>
                            }

                            <div class="table-responsive">
                                <table class="table table-sm align-middle compras-allocations-table">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="compras-thumb-col">Foto</th>
                                            <th>Ubicación</th>
                                            <th class="text-end">Planeado</th>
                                            <th class="text-end">Recibido</th>
                                            <th class="text-end">Pendiente</th>
                                            <th class="text-end"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (SelectedLine.Allocations.Count == 0)
                                        {
                                            <tr>
                                                <td colspan="6" class="text-center text-muted py-3">Aún no hay ubicaciones planeadas para este material.</td>
                                            </tr>
                                        }
                                        else
                                        {
                                            @foreach (var allocation in SelectedLine.Allocations)
                                            {
                                                <tr>
                                                    <td class="compras-thumb-col">
                                                        @if (selectedThumbnail is not null)
                                                        {
                                                            <img src="@selectedThumbnail" alt="Imagen de @selectedMaterialTitle" class="compras-thumb" />
                                                        }
                                                        else
                                                        {
                                                            <div class="compras-thumb-placeholder">@GetMaterialFallbackText(SelectedLine.MaterialCode, SelectedLine.MaterialDescription)</div>
                                                        }
                                                    </td>
                                                    <td>
                                                        <div>@allocation.LocationName</div>
                                                        <small class="text-muted">@(string.IsNullOrWhiteSpace(allocation.LocationCode) ? "Sin código" : allocation.LocationCode)</small>
                                                    </td>
                                                    <td class="text-end">
                                                        @if (IsDraftMode)
                                                        {
                                                            <input type="number"
                                                                   step="any"
                                                                   min="0"
                                                                   class="form-control form-control-sm compras-inline-number"
                                                                   value="@FormatNumberInput(GetAllocationDisplayQuantity(SelectedLine, allocation))"
                                                                   @onchange="args => UpdateAllocationDisplayQuantity(SelectedLine, allocation, args)" />
                                                            @if (GetPurchaseAllocationValidationMessage(SelectedLine, allocation) is { } allocationValidationMessage)
                                                            {
                                                                <div class="small text-danger mt-1 text-start">@allocationValidationMessage</div>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            @FormatPurchaseQuantity(SelectedLine, allocation.PlannedQuantity)
                                                        }
                                                    </td>
                                                    <td class="text-end">@FormatPurchaseQuantity(SelectedLine, allocation.ReceivedQuantity)</td>
                                                    <td class="text-end">@FormatPurchaseQuantity(SelectedLine, allocation.RemainingQuantity)</td>
                                                    <td class="text-end">
                                                        @if (IsDraftMode)
                                                        {
                                                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => QuitarAsignacion(allocation)">
                                                                Quitar
                                                            </button>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </section>
                }

                @if (CanEnterReceipt)
                {
                    <section class="card shadow-sm mb-3 compras-receipt-section">
                        <div class="card-body">
                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                                <div>
                                    <span class="compras-section-kicker">Paso 3 · Compara con el ticket</span>
                                    <h3 class="h4 mb-1">¿Qué llegó y cuánto costó?</h3>
                                    <p class="text-muted mb-0">Captura el total impreso para la cantidad recibida de cada artículo.</p>
                                </div>
                                <button type="button" class="btn btn-outline-success" @onclick="RecibirTodo" disabled="@(!CanEnterReceipt)">
                                    Recibir todo lo pendiente
                                </button>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-4">
                                    <label class="form-label fw-semibold">Fecha del ticket</label>
                                    <InputDate class="form-control" @bind-Value="ReceiptDate" />
                                </div>
                                <div class="col-md-8">
                                    <label class="form-label fw-semibold">Nota opcional</label>
                                    <InputTextArea class="form-control" rows="2" @bind-Value="ReceiptNotes" placeholder="Ej. faltó una caja o hubo sustitución" />
                                </div>
                            </div>

                            <div class="row g-3 align-items-start">
                                <div class="col-12 col-xl-8">
                                    <div class="compras-receive-grid">
                                        @foreach (var item in ReceiveItems)
                                        {
                                            var thumbnailDataUrl = GetMaterialThumbnailDataUrl(item.MaterialId);
                                            var materialTitle = string.IsNullOrWhiteSpace(item.MaterialDescription) ? item.MaterialCode : item.MaterialDescription;
                                            var itemAmounts = GetReceiptItemAmounts(item);
                                            var suggestedTotal = GetSuggestedReceiptTotal(item);
                                            <article class="compras-receive-card @(item.ReceiveNowQuantity > 0m ? "is-selected" : null)">
                                                <header>
                                                    @if (thumbnailDataUrl is not null)
                                                    {
                                                        <img src="@thumbnailDataUrl" alt="Imagen de @materialTitle" class="compras-thumb" />
                                                    }
                                                    else
                                                    {
                                                        <div class="compras-thumb-placeholder">@GetMaterialFallbackText(item.MaterialCode, item.MaterialDescription)</div>
                                                    }
                                                    <div class="compras-receive-card-title">
                                                        <strong>@materialTitle</strong>
                                                        <small>@item.MaterialCode · @item.LocationName</small>
                                                    </div>
                                                    <div class="compras-pending-pill">
                                                        <span>Pendiente</span>
                                                        <strong>@FormatPurchaseQuantity(item, item.RemainingQuantity)</strong>
                                                    </div>
                                                </header>

                                                <div class="compras-receive-fields">
                                                    <label>
                                                        <span>Cantidad que llegó</span>
                                                        <small>En @GetPurchaseUnitName(item)</small>
                                                    <input type="number"
                                                           step="any"
                                                           min="0"
                                                               inputmode="decimal"
                                                           class="form-control compras-receive-number"
                                                           value="@FormatNumberInput(GetReceiveNowDisplayQuantity(item))"
                                                           @oninput="args => UpdateReceiveNowDisplayQuantity(item, args)" />
                                                    </label>
                                                    <label>
                                                        <span>Total en el ticket</span>
                                                        <small>Por esta cantidad</small>
                                                        <div class="input-group compras-money-input">
                                                            <span class="input-group-text">$</span>
                                                            <input type="number"
                                                                   class="form-control"
                                                                   min="0.01"
                                                                   step="0.01"
                                                                   inputmode="decimal"
                                                                   value="@(item.TotalAmount.HasValue ? FormatNumberInput(item.TotalAmount.Value) : null)"
                                                                   @oninput="args => UpdateReceiveTotalAmount(item, args)" />
                                                        </div>
                                                    </label>
                                                </div>

                                                <label class="compras-iva-toggle">
                                                    <input type="checkbox" @bind="item.IncludesIva" />
                                                    <span><strong>IVA incluido</strong><small>Márcalo solo si este artículo paga IVA de 16%.</small></span>
                                                </label>

                                                @if (item.TotalAmount.GetValueOrDefault() > 0m)
                                                {
                                                    <div class="compras-line-breakdown">
                                                        <span>Subtotal <strong>@FormatMoney(itemAmounts.SubtotalAmount)</strong></span>
                                                        <span>IVA <strong>@FormatMoney(itemAmounts.IvaAmount)</strong></span>
                                                        <span>Costo por @(string.IsNullOrWhiteSpace(item.BaseUnitName) ? "unidad" : item.BaseUnitName) <strong>@FormatMoney(GetReceiptItemBaseUnitCost(item))</strong></span>
                                                    </div>
                                                }
                                                else if (suggestedTotal.HasValue)
                                                {
                                                    <p class="compras-price-hint">Referencia de la orden: @FormatMoney(suggestedTotal). Confirma el importe real del ticket.</p>
                                                }

                                                @if (item.RequiresLot)
                                                {
                                                    <div class="compras-lot-fields">
                                                        <label><span>Lote <strong>obligatorio</strong></span><input class="form-control" value="@item.LotCode" @oninput="args => UpdateReceiveLotCode(item, args)" /></label>
                                                        <label><span>Caducidad <strong>obligatoria</strong></span><input type="date" class="form-control" value="@FormatDateInput(item.ExpiresAt)" @oninput="args => UpdateReceiveExpiration(item, args)" /></label>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <details class="compras-optional-fields">
                                                        <summary>Agregar lote o caducidad (opcional)</summary>
                                                        <div class="compras-lot-fields">
                                                            <label><span>Lote</span><input class="form-control" value="@item.LotCode" @oninput="args => UpdateReceiveLotCode(item, args)" /></label>
                                                            <label><span>Caducidad</span><input type="date" class="form-control" value="@FormatDateInput(item.ExpiresAt)" @oninput="args => UpdateReceiveExpiration(item, args)" /></label>
                                                        </div>
                                                    </details>
                                                }
                                            </article>
                                        }
                                    </div>
                                </div>

                                <div class="col-12 col-xl-4">
                                    <aside class="compras-ticket-summary">
                                        <div class="compras-ticket-brand">Resumen del ticket</div>
                                        <div class="compras-ticket-meta"><span>Artículos</span><strong>@ReceiptCapturedItemCount</strong></div>
                                        <div class="compras-ticket-rule"></div>
                                        <div><span>Subtotal</span><strong>@FormatMoney(CurrentReceiptAmounts.SubtotalAmount)</strong></div>
                                        <div><span>IVA 16%</span><strong>@FormatMoney(CurrentReceiptAmounts.IvaAmount)</strong></div>
                                        <div class="compras-ticket-total"><span>TOTAL</span><strong>@FormatMoney(CurrentReceiptAmounts.TotalAmount)</strong></div>
                                        @if (ReceiptMissingAmountCount > 0)
                                        {
                                            <p class="compras-ticket-warning">Falta el total de @ReceiptMissingAmountCount artículo(s).</p>
                                        }
                                        else if (ReceiptMissingLotCount > 0)
                                        {
                                            <p class="compras-ticket-warning">Falta lote o caducidad de @ReceiptMissingLotCount artículo(s).</p>
                                        }
                                        else if (ReceiptCapturedItemCount == 0)
                                        {
                                            <p class="compras-ticket-help">Captura una cantidad para comenzar.</p>
                                        }
                                        else
                                        {
                                            <p class="compras-ticket-help">Este total debe coincidir con el ticket.</p>
                                        }
                                        <button type="button" class="btn btn-success btn-lg w-100" @onclick="RegistrarRecepcionAsync" disabled="@(!CanReceive)">
                                            @(IsReceiving ? "Guardando recepción..." : "Guardar recepción")
                                        </button>
                                    </aside>
                                </div>
                            </div>
                        </div>
                    </section>
                }

                @if (ReceiptHistory.Count > 0)
                {
                    <section class="card shadow-sm">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h3 class="h5 mb-0">Historial de recepciones</h3>
                                <span class="text-muted small">@ReceiptHistory.Select(item => item.ReceiptId).Distinct().Count() recepciones</span>
                            </div>

                            <div class="compras-history-list">
                                @foreach (var receiptGroup in ReceiptHistory.GroupBy(item => new { item.ReceiptId, item.ReceiptCode, item.ReceiptDate }))
                                {
                                    var hasAmounts = receiptGroup.Any(item => item.TotalAmount.HasValue);
                                    var receiptSubtotal = receiptGroup.Sum(item => item.SubtotalAmount.GetValueOrDefault());
                                    var receiptIva = receiptGroup.Sum(item => item.IvaAmount.GetValueOrDefault());
                                    var receiptTotal = receiptGroup.Sum(item => item.TotalAmount.GetValueOrDefault());
                                    var receiptNotes = receiptGroup.First().Notes;
                                    <article class="compras-history-receipt">
                                        <header>
                                            <div><strong>@receiptGroup.Key.ReceiptCode</strong><small>@receiptGroup.Key.ReceiptDate.ToString("dd/MM/yyyy")</small></div>
                                            @if (hasAmounts)
                                            {
                                                <div class="compras-history-total"><span>Total</span><strong>@FormatMoney(receiptTotal)</strong></div>
                                            }
                                        </header>
                                        <div class="compras-history-lines">
                                        @foreach (var item in receiptGroup)
                                        {
                                            var thumbnailDataUrl = GetMaterialThumbnailDataUrl(item.MaterialId);
                                            var materialTitle = string.IsNullOrWhiteSpace(item.MaterialDescription) ? item.MaterialCode : item.MaterialDescription;
                                            <div class="compras-history-line">
                                                <div>
                                                    @if (thumbnailDataUrl is not null)
                                                    {
                                                        <img src="@thumbnailDataUrl" alt="Imagen de @materialTitle" class="compras-thumb" />
                                                    }
                                                    else
                                                    {
                                                        <div class="compras-thumb-placeholder">@GetMaterialFallbackText(item.MaterialCode, item.MaterialDescription)</div>
                                                    }
                                                    <span><strong>@materialTitle</strong><small>@FormatPurchaseQuantity(item, item.Quantity) · @item.LocationName</small></span>
                                                </div>
                                                <div class="text-end">
                                                    <strong>@FormatMoney(item.TotalAmount)</strong>
                                                    @if (item.IncludesIva)
                                                    {
                                                        <small>IVA: @FormatMoney(item.IvaAmount)</small>
                                                    }
                                                </div>
                                            </div>
                                        }
                                        </div>
                                        @if (hasAmounts)
                                        {
                                            <footer><span>Subtotal @FormatMoney(receiptSubtotal)</span><span>IVA @FormatMoney(receiptIva)</span><strong>Total @FormatMoney(receiptTotal)</strong></footer>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(receiptNotes))
                                        {
                                            <p class="compras-history-notes">@receiptNotes</p>
                                        }
                                    </article>
                                }
                            </div>
                        </div>
                    </section>
                }
            </EditForm>
        </div>
    </div>
</div>

@if (ShowAutoPoModal)
{
    <div class="modal fade show d-block compras-modal-backdrop" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable compras-auto-po-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Generar Auto PO</h5>
                    <button type="button" class="btn-close" aria-label="Cerrar" @onclick="CerrarAutoPoModal" disabled="@IsCreatingAutoPo"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted">
                        Genera un borrador con materiales del proveedor seleccionado usando mínimos y máximos por ubicación.
                        El sistema calcula internamente en unidad base y presenta la orden en unidad de compra.
                    </p>

                    <div class="mb-3">
                        <label class="form-label">Proveedor</label>
                        <select class="form-select" @bind="AutoPoRequest.BusinessPartnerId">
                            <option value="0">Selecciona un proveedor</option>
                            @foreach (var vendor in VendorOptions)
                            {
                                <option value="@vendor.Id">@vendor.Name</option>
                            }
                        </select>
                    </div>

                    <div class="compras-auto-po-room-panel">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                            <div>
                                <label class="form-label mb-1">Suites</label>
                                <div class="small text-muted">Selecciona una o varias suites para limitar el cálculo a las ubicaciones dentro de esos ROOM.</div>
                            </div>
                            <div class="d-flex flex-wrap gap-2">
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="LimpiarSeleccionSuitesAutoPo" disabled="@IsCreatingAutoPo">
                                    Todas las suites
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="SeleccionarTodasLasSuitesAutoPo" disabled="@(IsCreatingAutoPo || AutoPoRoomOptions.Count == 0)">
                                    Seleccionar todas
                                </button>
                            </div>
                        </div>

                        <div class="compras-auto-po-room-summary mb-2">
                            <span class="compras-room-chip compras-room-chip-summary">@AutoPoRoomSelectionSummary</span>
                        </div>

                        @if (AutoPoRoomOptions.Count == 0)
                        {
                            <div class="alert alert-light border mb-0">No se encontraron suites configuradas con <code>ROOM_TYPE = 'SUITE'</code>.</div>
                        }
                        else
                        {
                            <div class="table-responsive compras-auto-po-room-table-wrap">
                                <table class="table table-sm table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="compras-auto-po-room-check-col"></th>
                                            <th>Suite</th>
                                            <th>Tipo</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var room in AutoPoRoomOptions)
                                        {
                                            <tr>
                                                <td class="compras-auto-po-room-check-col">
                                                    <input type="checkbox"
                                                           class="form-check-input"
                                                           checked="@IsAutoPoRoomSelected(room.Id)"
                                                           @onchange="(e) => ToggleAutoPoRoomSelection(room.Id, e.Value is bool selected && selected)"
                                                           disabled="@IsCreatingAutoPo" />
                                                </td>
                                                <td>@room.Name</td>
                                                <td><span class="badge text-bg-light">@room.Code</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        <div class="form-text mt-2">
                            Si no seleccionas suites, Auto PO usará todas las ubicaciones activas habilitadas para inventario.
                        </div>
                    </div>

                    <div class="small text-muted">
                        Si el proveedor ya tiene un borrador abierto con el mismo alcance de suites, se abrirá ese documento en lugar de crear uno nuevo.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CerrarAutoPoModal" disabled="@IsCreatingAutoPo">
                        Cerrar
                    </button>
                    <button type="button" class="btn btn-success" @onclick="CrearAutoPoAsync" disabled="@IsCreatingAutoPo">
                        @(IsCreatingAutoPo ? "Generando..." : "Generar borrador")
                    </button>
                </div>
            </div>
        </div>
    </div>
}
