@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@using OrionERP.Infrastructure.Auth
@inject ICurrentCompanyContext CompanyContext

<AuthorizeView>
    <Authorized Context="context">
        <header class="@HeaderCssClass" role="banner">
            <div class="security-header__identity-wrap">
                <span class="security-header__identity">@context.User.Identity?.Name</span>
                <span class="security-header__date">@DateWeekLabel</span>
            </div>

            <div class="security-header__company" aria-label="Empresa activa">
                <span class="security-header__company-logo">
                    <span aria-hidden="true">@GetInitial(CompanyContext.DisplayName)</span>
                    <img src="@GetLogoUrl()" alt="" onerror="this.remove()" />
                </span>
                <span class="security-header__company-copy">
                    <strong>@(CompanyContext.DisplayName ?? "Empresa")</strong>
                    <small>@CompanyContext.CurrentRfc</small>
                </span>
            </div>

            <div class="security-header__actions">
                <button type="submit"
                        form="orionerp-logout-form"
                        class="btn btn-link btn-sm security-header__logout">Cerrar sesión</button>
            </div>
        </header>
    </Authorized>

    <NotAuthorized>
        <div class="security-header security-header--anonymous">
            <a class="btn btn-primary btn-sm" href="/Identity/Account/Login">Iniciar sesión</a>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private static readonly CultureInfo SpanishMexico = CultureInfo.GetCultureInfo("es-MX");

    [Parameter] public bool CompactMobile { get; set; }

    private string HeaderCssClass => CompactMobile
        ? "security-header security-header--compact-mobile"
        : "security-header";

    private static string DateWeekLabel
    {
        get
        {
            var today = DateTime.Today;
            var dateText = today.ToString("dddd d 'de' MMMM 'de' yyyy", SpanishMexico);
            var weekNumber = ISOWeek.GetWeekOfYear(today);

            return $"{dateText} - Semana {weekNumber}";
        }
    }

    private string GetLogoUrl()
      => $"/company-branding/{Uri.EscapeDataString(CompanyContext.RequireRfc())}/logo";

    private static string GetInitial(string? name)
      => string.IsNullOrWhiteSpace(name) ? "E" : name.Trim()[0].ToString().ToUpperInvariant();
}
