@inject PublicWebsitePresentationDefinition Presentation

<CascadingAuthenticationState>
  <Router AppAssembly="@typeof(Program).Assembly">
    <Found Context="routeData">
      <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(BrunoPublicLayout)">
        <NotAuthorized>
          <LayoutView Layout="@typeof(BrunoPublicLayout)">
            <section class="state-card"><h1>Inicia sesión</h1><p>Necesitas acceder a @MembershipName para ver esta página.</p><a class="button" href="/cuenta/acceso" target="_top">Ir a acceso</a></section>
          </LayoutView>
        </NotAuthorized>
      </AuthorizeRouteView>
      <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
      <LayoutView Layout="@typeof(BrunoPublicLayout)">
        <PageTitle>Página no encontrada · @Presentation.PublicName</PageTitle>
        <section class="state-card"><span>404</span><h1>No encontramos esta página</h1><p>Vuelve al inicio para consultar el menú, las promociones y @MembershipName.</p><a class="button" href="/">Volver al inicio</a></section>
      </LayoutView>
    </NotFound>
  </Router>
</CascadingAuthenticationState>

@code {
  private string MembershipName => Presentation.MembershipProgramName ?? "Membresía";
}
