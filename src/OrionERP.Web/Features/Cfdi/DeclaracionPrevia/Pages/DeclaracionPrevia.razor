<!-- UNIQUE_COMMENT_FOR_DEBUGGING -->
@page "/cfdi/declaracion-previa"
@using OrionERP.Web.Features.Cfdi.DeclaracionPrevia.Components
@inject IConfiguration Configuration
@inject IJSRuntime JS
@attribute [Authorize(Roles = "Administrador,SatOperator")]

<h3>CFDIs</h3>

@if (_filtering)
{
    <span class="orion-loading" role="status" aria-live="polite">
        <span class="orion-spinner" aria-hidden="true"></span>
        <span class="orion-strong">Cargando…</span>
    </span>
}
<div class="mb-3 filter-bar">
    <div class="filter-pair">
        <label class="fw-bold">RFC (Razón Social):</label>
        <RfcPicker 
          @bind-SelectedRfc="selectedRfc"
          @bind-SelectedRfc:after="OnFiltersChangedAsync"  />
    </div>

    <div class="filter-pair">
        <label class="fw-bold">Ejercicio:</label>
        <select @bind="selectedYear" @bind:after="OnFiltersChangedAsync"
                class="form-select inline-select">
            @if (disponibleYears != null)
            {
                foreach (var year in disponibleYears)
                {
                    <option value="@year">@year</option>
                }
            }
        </select>
    </div>

    <div class="filter-pair">
        <label class="fw-bold">Periodo:</label>
        <select @bind="selectedMonth" @bind:after="OnFiltersChangedAsync"
                class="form-select inline-select"
                style="@((isAnnual ? "opacity:0.5;" : ""))"
                disabled="@isAnnual">
            @if (disponibleMonths != null)
            {
                @foreach (var (num, name) in disponibleMonths)
                {
                    <option value="@num">@name</option>
                }
            }
        </select>
    </div>

    <div class="form-check form-check-inline ms-2">
        <input class="form-check-input" type="checkbox" id="chkAnual"
               @bind="isAnnual" @bind:after="OnFiltersChangedAsync" />
        <label class="form-check-label" for="chkAnual">Declaración Anual</label>
    </div>
    <button class="btn btn-sm btn-outline-dark ms-2" @onclick="OpenResumenTab">
        Resumen
    </button>
</div>



<ul class="nav nav-tabs" id="declaracionTab" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="emitidas-tab" data-bs-toggle="tab" data-bs-target="#emitidas" type="button" role="tab" aria-controls="emitidas" aria-selected="true">EMITIDAS</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="recibidas-tab" data-bs-toggle="tab" data-bs-target="#recibidas" type="button" role="tab" aria-controls="recibidas" aria-selected="false">RECIBIDAS</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="nomina-emitidas-tab" data-bs-toggle="tab" data-bs-target="#nomina-emitidas" type="button" role="tab" aria-controls="nomina-emitidas" aria-selected="false">NOMINA EMITIDAS</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="nomina-recibidas-tab" data-bs-toggle="tab" data-bs-target="#nomina-recibidas" type="button" role="tab" aria-controls="nomina-recibidas" aria-selected="false">NOMINA RECIBIDAS</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="otros-tab" data-bs-toggle="tab" data-bs-target="#otros" type="button" role="tab" aria-controls="otros" aria-selected="false">OTROS</button>
    </li>
</ul>
<div class="tab-content" id="declaracionTabContent">
    <div class="tab-pane fade show active" id="emitidas" role="tabpanel" aria-labelledby="emitidas-tab">
        <div class="mb-2 filter-bar">
            <div class="filter-pair">
                <label for="emitSortCol">Ordenar por:</label>
                <select id="emitSortCol"
                        @bind="emitidasSortColumn"
                        @bind:after="OnEmitidasSortsChangedAsync"
                        class="form-select inline-select">
                    @if (emitidasSortableFields != null)
                    {
                        @foreach (var field in emitidasSortableFields)
                        {
                            <option value="@field.Value">@field.Key</option>
                        }
                    }
                </select>
            </div>
            <select id="emitSortDir"
                    @bind="emitidasSortOrder"
                    @bind:after="OnEmitidasSortsChangedAsync"
                    class="form-select inline-select">
                <option value="ASC">ASC</option>
                <option value="DESC">DESC</option>
            </select>
            <button class="btn btn-sm btn-outline-primary" @onclick="ToggleEmitidaSelected">
                Excluir / Incluir
            </button>
            <button class="btn btn-sm btn-warning" @onclick="CancelSelectedEmitidaCfdi">
                Cancelar CFDI
            </button>
            <button class="btn btn-sm btn-secondary" @onclick="ExportExcelEmitidas">
                Exportar Emitidas a Excel
            </button>
        </div>
        <div class="table-responsive table-scroll">
            <table class="table table-sm table-bordered table-striped align-middle compact-table">
                <thead class="table-dark">
                    <tr>
                        <th>Acciones</th>
                        <th>Poliza</th>
                        <th>✔</th>
                        <th @onclick="@(() => SortEmitidasByColumn("Fecha"))">Fecha @GetSortIndicator("Fecha", emitidasSortColumn, emitidasSortOrder)</th>
                        <th>Mes</th>
                        <th>Año</th>
                        <th @onclick="@(() => SortEmitidasByColumn("RECEPTOR"))">Receptor @GetSortIndicator("RECEPTOR", emitidasSortColumn, emitidasSortOrder)</th>
                        <th class="num">SubTotal</th>
                        <th class="num">Descuento</th>
                        <th class="num">SubTotal_Desc</th>
                        <th class="num">Actos16%</th>
                        <th class="num">Actos0%</th>
                        <th class="num">IVA</th>
                        <th class="num">IEPS</th>
                        <th class="num">IVA Retenido</th>
                        <th class="num">ISR Retenido</th>
                        <th class="num">IEPS Retenido</th>
                        <th @onclick="@(() => SortEmitidasByColumn("Total"))" class="num">Total @GetSortIndicator("Total", emitidasSortColumn, emitidasSortOrder)</th>
                        <th @onclick="@(() => SortEmitidasByColumn("FOLIO_FISCAL"))">UUID @GetSortIndicator("FOLIO_FISCAL", emitidasSortColumn, emitidasSortOrder)</th>
                        <th>Forma Pago</th>
                        <th>Tipo CFDI</th>
                        <th>Método Pago</th>
                        <th>Uso CFDI</th>
                        <th>Fecha Cancel.</th>
                        <th>Estatus</th>
                        <th>Transacción Fechas</th>
                        <th class="num">Suma Polizas</th>
                        <th class="num">XML Attachment ID</th>

                    </tr>
                </thead>
                <tbody>
                    @if (emitidas != null)
                    {
                        @foreach (var item in emitidasPage)
                        {
                            <tr @onclick="async () => await SelectEmitidaAsync(item)"
                                class="@GetEmitidaRowClass(item)"
                                style="cursor:pointer;">
                                <ActionButtons Item="item"
                                               OnOpenDetails="@(obj => OpenEmitidaDetails((DeclaracionEmitida)obj))"
                                               OnHandlePolizaClick="HandlePolizaClick" />
                                <td>@item.D</td>
                                <td>@item.Fecha.ToString("yyyy-MM-dd")</td>
                                <td>@item.MES_GLOBAL</td>
                                <td>@item.ANIO_GLOBAL</td>
                                <td>@item.RECEPTOR</td>
                                <td class="num">@string.Format("{0:N2}", item.SubTotal)</td>
                                <td class="num">@string.Format("{0:N2}", item.Descuento)</td>
                                <td class="num">@string.Format("{0:N2}", item.SubTotal_Desc)</td>
                                <td class="num">@string.Format("{0:N2}", item.Actos_16)</td>
                                <td class="num">@string.Format("{0:N2}", item.Actos_0)</td>
                                <td class="num">@string.Format("{0:N2}", item.IVA)</td>
                                <td class="num">@string.Format("{0:N2}", item.IEPS)</td>
                                <td class="num">@string.Format("{0:N2}", item.IVA_RETENIDO)</td>
                                <td class="num">@string.Format("{0:N2}", item.ISR_RETENIDO)</td>
                                <td class="num">@string.Format("{0:N2}", item.IEPS_RETENIDO)</td>
                                <td class="num">@string.Format("{0:N2}", item.Total)</td>
                                <td>@item.FOLIO_FISCAL</td>
                                <td>@item.FormaPago</td>
                                <td>@item.TipoDeComprobante</td>
                                <td>@item.MetodoPago</td>
                                <td>@item.UsoCFDI</td>
                                <td>@(item.FechaCancelacion.HasValue ? item.FechaCancelacion.Value.ToString("yyyy-MM-dd") : "")</td>
                                <td>@item.Estatus</td>
                                <td>@item.fechastransacciones</td>
                                <td class="num">@item.SumaPolizas</td>
                                <td class="num">@item.XML_Attachment_ID</td>

                            </tr>
                            @if (selectedEmitida?.Comprobante_Id == item.Comprobante_Id && emitidasComplementos?.Count > 0)
                            {
                                <tr class="table-secondary">
                                    <td colspan="28">
                                        <div class="table-responsive table-scroll mb-2">
                                            <table class="table table-sm table-bordered table-striped align-middle compact-table mb-0">
                                                <thead class="table-dark">
                                                    <tr>
                                                        <th>Pago Id</th>
                                                        <th>Folio</th>
                                                        <th>Fecha Pago</th>
                                                        <th>Forma Pago</th>
                                                        <th>Moneda Pago</th>
                                                        <th class="num">Monto Pago</th>
                                                        <th class="num">Parcialidad</th>
                                                        <th>Moneda DR</th>
                                                        <th class="num">Saldo Anterior</th>
                                                        <th class="num">Importe Pagado</th>
                                                        <th class="num">Saldo Insoluto</th>
                                                        <th class="num">Tot P Traslados</th>
                                                        <th class="num">Tot P Retenciones</th>
                                                        <th class="num">Tot DR Traslados</th>
                                                        <th class="num">Tot DR Retenciones</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var complemento in emitidasComplementos)
                                                    {
                                                        <tr>
                                                            <td>@complemento.Pago_Id</td>
                                                            <td>@complemento.Folio</td>
                                                            <td>@complemento.FechaPago.ToString("yyyy-MM-dd")</td>
                                                            <td>@complemento.FormaDePagoP</td>
                                                            <td>@complemento.MonedaP</td>
                                                            <td class="num">@string.Format("{0:N6}", complemento.MontoPago)</td>
                                                            <td class="num">@complemento.NumParcialidad</td>
                                                            <td>@complemento.MonedaDR</td>
                                                            <td class="num">@string.Format("{0:N6}", complemento.ImpSaldoAnt)</td>
                                                            <td class="num">@string.Format("{0:N6}", complemento.ImpPagado)</td>
                                                            <td class="num">@string.Format("{0:N6}", complemento.ImpSaldoInsoluto)</td>
                                                            <td class="num">@string.Format("{0:N6}", complemento.Tot_P_Traslados)</td>
                                                            <td class="num">@string.Format("{0:N6}", complemento.Tot_P_Retenciones)</td>
                                                            <td class="num">@string.Format("{0:N6}", complemento.Tot_DR_Traslados)</td>
                                                            <td class="num">@string.Format("{0:N6}", complemento.Tot_DR_Retenciones)</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    }
                </tbody>
                @if (emitidasTotals != null)
                {
                    <tfoot class="table-light totals">
                        <tr>
                            <td colspan="4"><strong># CFDIs:</strong> @emitidasTotals.CountCFDIs</td>
                            <td><strong>Totales:</strong></td>
                            <td class="num">@emitidasTotals.SumSubTotal.ToString("N2")</td>
                            <td class="num">@emitidasTotals.SumDescuento.ToString("N2")</td>
                            <td class="num">@emitidasTotals.SumSubTotalDesc.ToString("N2")</td>
                            <td class="num">@emitidasTotals.SumActos16.ToString("N2")</td>
                            <td class="num">@emitidasTotals.SumActos0.ToString("N2")</td>
                            <td class="num">@emitidasTotals.SumIVA.ToString("N2")</td>
                            <td class="num">@emitidasTotals.SumIEPS.ToString("N2")</td>
                            <td class="num">@emitidasTotals.SumIVA_RETENIDO.ToString("N2")</td>
                            <td class="num">@emitidasTotals.SumISR_RETENIDO.ToString("N2")</td>
                            <td class="num">@emitidasTotals.SumIEPS_RETENIDO.ToString("N2")</td>
                            <td class="num">@emitidasTotals.SumTotal.ToString("N2")</td>
                            <td colspan="12"></td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
        <div class="d-flex justify-content-between align-items-center mb-3">
            <small>Mostrando página @emitidasCurrentPage de @emitidasPageCount</small>
            <div class="btn-group" role="group" aria-label="Paginación facturas emitidas">
                <button class="btn btn-sm btn-outline-secondary" @onclick="PreviousEmitidasPage" disabled="@(emitidasCurrentPage <= 1)">Anterior</button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="NextEmitidasPage" disabled="@(emitidasCurrentPage >= emitidasPageCount)">Siguiente</button>
            </div>
        </div>
    </div>
    <div class="tab-pane fade" id="recibidas" role="tabpanel" aria-labelledby="recibidas-tab">
        <div class="mb-2 filter-bar">
            <div class="filter-pair">
                <label for="recibSortCol">Ordenar por:</label>
                <select id="recibSortCol"
                        @bind="recibidasSortColumn"
                        @bind:after="OnRecibidasSortChangedAsync"
                        class="form-select inline-select">
                    @if (recibidasSortableFields != null)
                    {
                        @foreach (var field in recibidasSortableFields)
                        {
                            <option value="@field.Value">@field.Key</option>
                        }
                    }
                </select>
            </div>
            <select @bind="recibidasSortOrder" @bind:after="OnRecibidasSortChangedAsync" class="form-select inline-select">
                <option value="ASC">ASC</option>
                <option value="DESC">DESC</option>
            </select>
            <button class="btn btn-sm btn-outline-primary ms-3" @onclick="ToggleRecibidaSelected">Excluir / Incluir</button>
            <button class="btn btn-sm btn-outline-primary ms-1" @onclick="ExcludePagosYDevoluciones">Excluir Pagos/Dev</button>
            <button class="btn btn-sm btn-secondary ms-1" @onclick="ExportExcelRecibidas">Exportar Recibidas a Excel</button>
            <button class="btn btn-sm btn-info ms-1" @onclick="GenerateDIOT">Generar DIOT</button>
        </div>
        <div class="table-scroll">
            <table class="table table-sm table-bordered table-striped align-middle compact-table">
                <thead class="table-dark">
                    <tr>
                        <th>Acciones</th>
                        <th>Poliza</th>
                        <th>✔</th>
                        <th @onclick="@(() => SortRecibidasByColumn("Fecha"))">Fecha @GetSortIndicator("Fecha", recibidasSortColumn, recibidasSortOrder)</th>
                        <th>Mes</th>
                        <th>Año</th>
                        <th @onclick="@(() => SortRecibidasByColumn("EMISOR"))">Emisor @GetSortIndicator("EMISOR", recibidasSortColumn, recibidasSortOrder)</th>
                        <th class="num">SubTotal</th>
                        <th class="num">Descuento</th>
                        <th class="num">SubTotal_Desc</th>
                        <th class="num">Actos16%</th>
                        <th class="num">Actos0%</th>
                        <th class="num">IVA</th>
                        <th class="num">IEPS</th>
                        <th class="num">IVA Retenido</th>
                        <th class="num">ISR Retenido</th>
                        <th class="num">IEPS Retenido</th>
                        <th @onclick="@(() => SortRecibidasByColumn("Total"))" class="num">Total @GetSortIndicator("Total", recibidasSortColumn, recibidasSortOrder)</th>
                        <th @onclick="@(() => SortRecibidasByColumn("FOLIO_FISCAL"))">UUID @GetSortIndicator("FOLIO_FISCAL", recibidasSortColumn, recibidasSortOrder)</th>
                        <th>Forma Pago</th>
                        <th>Tipo CFDI</th>
                        <th>Método Pago</th>
                        <th>Uso CFDI</th>
                        <th>Fecha Cancel.</th>
                        <th>Estatus</th>
                        <th>Transacción Fechas</th>
                        <th>Póliza</th>
                        <th class="num">Suma Pólizas</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (recibidas != null)
                    {
                        @foreach (var item in recibidasPage)
                        {
                            <tr @onclick="async () => await SelectRecibidaAsync(item)"
                                class="@GetRecibidaRowClass(item)"
                                style="cursor:pointer;">
                                <ActionButtons Item="item"
                                               OnOpenDetails="@(obj => OpenEmitidaDetails((DeclaracionEmitida)obj))"
                                               OnHandlePolizaClick="HandlePolizaClick" />
                                <td>@item.D</td>
                                <td>@item.Fecha.ToString("yyyy-MM-dd")</td>
                                <td>@item.MES_GLOBAL</td>
                                <td>@item.ANIO_GLOBAL</td>
                                <td>@item.EMISOR</td>
                                <td class="num">@string.Format("{0:N2}", item.SubTotal)</td>
                                <td class="num">@string.Format("{0:N2}", item.Descuento)</td>
                                <td class="num">@string.Format("{0:N2}", item.SubTotal_Desc)</td>
                                <td class="num">@string.Format("{0:N2}", item.Actos_16)</td>
                                <td class="num">@string.Format("{0:N2}", item.Actos_0)</td>
                                <td class="num">@string.Format("{0:N2}", item.IVA)</td>
                                <td class="num">@string.Format("{0:N2}", item.IEPS)</td>
                                <td class="num">@string.Format("{0:N2}", item.IVA_RETENIDO)</td>
                                <td class="num">@string.Format("{0:N2}", item.ISR_RETENIDO)</td>
                                <td class="num">@string.Format("{0:N2}", item.IEPS_RETENIDO)</td>
                                <td class="num">@string.Format("{0:N2}", item.Total)</td>
                                <td>@item.FOLIO_FISCAL</td>
                                <td>@item.FormaPago</td>
                                <td>@item.TipoDeComprobante</td>
                                <td>@item.MetodoPago</td>
                                <td>@item.UsoCFDI</td>
                                <td>@(item.FechaCancelacion.HasValue ? item.FechaCancelacion.Value.ToString("yyyy-MM-dd") : "")</td>
                                <td>@item.Estatus</td>
                                <td>@item.fechastransacciones</td>
                                <td>@item.Poliza</td>
                                <td class="num">@((item.SumaPolizas.HasValue) ? item.SumaPolizas.Value.ToString("N0") : "")</td>
                                <td>
                                    <button class="btn btn-sm btn-outline-info"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => OpenRecibidaDetails(item)">
                                        Ver
                                    </button>
                                    <button class="btn btn-sm @(item.Poliza == _placeholderTransaccionId.ToString() ? "btn-outline-danger" : "btn-outline-success")"
                                            title="@(item.Poliza == _placeholderTransaccionId.ToString() ? "Crear Póliza" : "Ir a Transacción")"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => HandlePolizaClick(item)">
                                        @(item.Poliza == _placeholderTransaccionId.ToString() ? "Crear" : "Tx")
                                    </button>
                                </td>
                            </tr>
                            @if (selectedRecibida?.Comprobante_Id == item.Comprobante_Id && recibidasComplementos?.Count > 0)
                            {
                                <tr class="table-secondary">
                                    <td colspan="29">
                                        <div class="table-responsive table-scroll mb-2">
                                            <table class="table table-sm table-bordered table-striped align-middle compact-table mb-0">
                                                <thead class="table-dark">
                                                    <tr>
                                                        <th>Pago Id</th>
                                                        <th>Folio</th>
                                                        <th>Fecha Pago</th>
                                                        <th>Forma Pago</th>
                                                        <th>Moneda Pago</th>
                                                        <th class="num">Monto Pago</th>
                                                        <th class="num">Parcialidad</th>
                                                        <th>Moneda DR</th>
                                                        <th class="num">Saldo Anterior</th>
                                                        <th class="num">Importe Pagado</th>
                                                        <th class="num">Saldo Insoluto</th>
                                                        <th class="num">Tot P Traslados</th>
                                                        <th class="num">Tot P Retenciones</th>
                                                        <th class="num">Tot DR Traslados</th>
                                                        <th class="num">Tot DR Retenciones</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var complemento in recibidasComplementos)
                                                    {
                                                        <tr>
                                                            <td>@complemento.Pago_Id</td>
                                                            <td>@complemento.Folio</td>
                                                            <td>@complemento.FechaPago.ToString("yyyy-MM-dd")</td>
                                                            <td>@complemento.FormaDePagoP</td>
                                                            <td>@complemento.MonedaP</td>
                                                            <td class="num">@string.Format("{0:N6}", complemento.MontoPago)</td>
                                                            <td class="num">@complemento.NumParcialidad</td>
                                                            <td>@complemento.MonedaDR</td>
                                                            <td class="num">@string.Format("{0:N6}", complemento.ImpSaldoAnt)</td>
                                                            <td class="num">@string.Format("{0:N6}", complemento.ImpPagado)</td>
                                                            <td class="num">@string.Format("{0:N6}", complemento.ImpSaldoInsoluto)</td>
                                                            <td class="num">@string.Format("{0:N6}", complemento.Tot_P_Traslados)</td>
                                                            <td class="num">@string.Format("{0:N6}", complemento.Tot_P_Retenciones)</td>
                                                            <td class="num">@string.Format("{0:N6}", complemento.Tot_DR_Traslados)</td>
                                                            <td class="num">@string.Format("{0:N6}", complemento.Tot_DR_Retenciones)</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    }
                </tbody>
                @if (recibidasTotals != null)
                {
                    <tfoot class="table-light totals">
                        <tr>
                            <td colspan="4"><strong># CFDIs:</strong> @recibidasTotals.CountCFDIs</td>
                            <td><strong>Totales:</strong></td>
                            <td class="num">@recibidasTotals.SumSubTotal.ToString("N2")</td>
                            <td class="num">@recibidasTotals.SumDescuento.ToString("N2")</td>
                            <td class="num">@recibidasTotals.SumSubTotalDesc.ToString("N2")</td>
                            <td class="num">@recibidasTotals.SumActos16.ToString("N2")</td>
                            <td class="num">@recibidasTotals.SumActos0.ToString("N2")</td>
                            <td class="num">@recibidasTotals.SumIVA.ToString("N2")</td>
                            <td class="num">@recibidasTotals.SumIEPS.ToString("N2")</td>
                            <td class="num">@recibidasTotals.SumIVA_RETENIDO.ToString("N2")</td>
                            <td class="num">@recibidasTotals.SumISR_RETENIDO.ToString("N2")</td>
                            <td class="num">@recibidasTotals.SumIEPS_RETENIDO.ToString("N2")</td>
                            <td class="num">@recibidasTotals.SumTotal.ToString("N2")</td>
                            <td colspan="11"></td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
        <div class="d-flex justify-content-between align-items-center mb-3">
            <small>Mostrando página @recibidasCurrentPage de @recibidasPageCount</small>
            <div class="btn-group" role="group" aria-label="Paginación facturas recibidas">
                <button class="btn btn-sm btn-outline-secondary" @onclick="PreviousRecibidasPage" disabled="@(recibidasCurrentPage <= 1)">Anterior</button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="NextRecibidasPage" disabled="@(recibidasCurrentPage >= recibidasPageCount)">Siguiente</button>
            </div>
        </div>
    </div>
