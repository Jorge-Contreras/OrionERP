@page "/contabilidad/bancos"
@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms
@attribute [Authorize(Roles = "Administrador,SatOperator")]

<PageTitle>Bancos – Cuentas y Movimientos</PageTitle>

<h1 class="mb-4 bancos-page-title">Bancos – Cuentas y Movimientos</h1>

@if (!string.IsNullOrEmpty(ErrorMessage))
{
  <div class="alert alert-danger" role="alert">
    <strong>Error:</strong> @ErrorMessage
  </div>
}
else if (IsInitializing)
{
  <div class="orion-loading" role="status" aria-live="polite">
    <span class="orion-spinner" aria-hidden="true"></span>
    <span class="orion-strong">Cargando información…</span>
  </div>
}
else
{
  <div class="d-flex flex-column gap-4 bancos-layout">
    @if (IsAccountModalVisible && AccountDraft is not null && AccountEditContext is not null)
    {
      <div class="modal fade show d-block bancos-modal-backdrop" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-lg">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title">@AccountModalTitle</h5>
              <button type="button" class="btn-close" aria-label="Cerrar" @onclick="CloseAccountModal"></button>
            </div>
            <div class="modal-body">
              <EditForm EditContext="AccountEditContext" OnValidSubmit="HandleAccountValidSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="row g-3">
                  <div class="col-12">
                    <label class="form-label" for="bank-name">Banco</label>
                    <InputText id="bank-name" class="form-control" @bind-Value="AccountDraft!.NombreBanco" />
                    <ValidationMessage For="() => AccountDraft!.NombreBanco" />
                  </div>

                  <div class="col-md-6">
                    <label class="form-label" for="bank-account-number">Número de cuenta</label>
                    <InputText id="bank-account-number" class="form-control" @bind-Value="AccountDraft!.NumeroCuenta" />
                    <ValidationMessage For="() => AccountDraft!.NumeroCuenta" />
                  </div>

                  <div class="col-md-6">
                    <label class="form-label" for="bank-account-type">Tipo de cuenta</label>
                    <InputText id="bank-account-type" class="form-control" @bind-Value="AccountDraft!.TipoCuenta" />
                  </div>

                  <div class="col-12">
                    <label class="form-label" for="bank-holder">Nombre del titular</label>
                    <InputText id="bank-holder" class="form-control" @bind-Value="AccountDraft!.NombreTitular" />
                  </div>

                  <div class="col-md-6">
                    <label class="form-label" for="bank-clabe">CLABE</label>
                    <InputText id="bank-clabe" class="form-control" @bind-Value="AccountDraft!.ClabeCuenta" />
                  </div>

                  @if (AccountDraft!.FechaAlta.HasValue)
                  {
                    <div class="col-md-6">
                      <label class="form-label" for="bank-created-at">Fecha de alta</label>
                      <input id="bank-created-at" class="form-control" value='@AccountDraft!.FechaAlta.Value.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)' readonly />
                    </div>
                  }

                  <div class="col-12">
                    <div class="form-check form-switch">
                      <InputCheckbox class="form-check-input" @bind-Value="AccountDraft!.Activo" id="bank-active" />
                      <label class="form-check-label" for="bank-active">Cuenta activa</label>
                    </div>
                  </div>

                  <div class="col-md-4">
                    <label class="form-label" for="bank-account-general">Cuenta contable (general)</label>
                    <InputNumber TValue="int?" id="bank-account-general" class="form-control" @bind-Value="AccountDraft!.CuentaContableId" />
                  </div>

                  <div class="col-md-4">
                    <label class="form-label" for="bank-account-expense">Cuenta contable egreso</label>
                    <InputNumber TValue="int?" id="bank-account-expense" class="form-control" @bind-Value="AccountDraft!.CuentaContableEgreso" />
                  </div>

                  <div class="col-md-4">
                    <label class="form-label" for="bank-account-income">Cuenta contable ingreso</label>
                    <InputNumber TValue="int?" id="bank-account-income" class="form-control" @bind-Value="AccountDraft!.CuentaContableIngreso" />
                  </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                  <button class="btn btn-outline-secondary" type="button" @onclick="CloseAccountModal" disabled="@(IsSavingAccount)">Cancelar</button>
                  <button class="btn btn-primary" type="submit" disabled="@(IsSavingAccount)">
                    @(IsSavingAccount ? "Guardando…" : "Guardar cuenta")
                  </button>
                </div>
              </EditForm>
            </div>
          </div>
        </div>
      </div>
    }

    <section aria-labelledby="accounts-heading" class="card section-card accounts-section">
      <div class="card-body">
        <div class="d-flex flex-wrap align-items-center gap-2 mb-3 bancos-section-toolbar">
          <h2 id="accounts-heading" class="h5 mb-0">Cuentas bancarias</h2>
          <span class="text-muted small">Total: @Accounts.Count</span>
          <div class="ms-auto">
            <button type="button" class="btn btn-sm btn-primary" @onclick="ShowCreateAccountModal">Agregar cuenta</button>
          </div>
        </div>

        @if (IsLoadingAccounts)
        {
          <div class="orion-loading" role="status" aria-live="polite">
            <span class="orion-spinner" aria-hidden="true"></span>
            <span class="orion-strong">Cargando cuentas…</span>
          </div>
        }
        else if (Accounts.Count == 0)
        {
          <div class="alert alert-info mb-0">No se encontraron cuentas bancarias.</div>
        }
        else
        {
          <div class="table-responsive bancos-table-wrap bancos-table-wrap--accounts">
            <table class="table table-sm table-hover align-middle mb-0 bancos-table bancos-responsive-table bancos-responsive-table--accounts">
              <thead class="table-light">
                <tr>
                  <th scope="col">Banco</th>
                  <th scope="col">Cuenta</th>
                  <th scope="col">Titular</th>
                  <th scope="col">Tipo</th>
                  <th scope="col">CLABE</th>
                  <th scope="col">RFC</th>
                  <th scope="col">Activo</th>
                  <th scope="col">Fecha alta</th>
                  <th scope="col" class="text-end">Acciones</th>
                </tr>
              </thead>
              <tbody>
                @foreach (var account in Accounts)
                {
                  var isSelected = account.CuentaBancoId == SelectedAccountId;
                  var rowClass = isSelected ? "table-primary" : string.Empty;
                  <tr class="@($"bancos-clickable-row {rowClass}")" @onclick="() => OnAccountSelected(account.CuentaBancoId)">
                    <td data-label="Banco">@account.NombreBanco</td>
                    <td data-label="Cuenta">@account.NumeroCuenta</td>
                    <td data-label="Titular">@account.NombreTitular</td>
                    <td data-label="Tipo">@account.TipoCuenta</td>
                    <td data-label="CLABE">@(string.IsNullOrWhiteSpace(account.ClabeCuenta) ? "—" : account.ClabeCuenta)</td>
                    <td data-label="RFC">@account.Rfc</td>
                    <td data-label="Activo">@(account.Activo ? "Sí" : "No")</td>
                    <td data-label="Fecha alta">@account.FechaAlta.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</td>
                    <td data-label="Acciones" class="text-end bancos-table__actions">
                      <div class="btn-group btn-group-sm" role="group" aria-label="Acciones de cuenta">
                        <button type="button"
                                class="btn btn-outline-secondary"
                                title="Editar"
                                @onclick:stopPropagation="true"
                                @onclick="() => ShowEditAccountModal(account)">Editar</button>
                        <button type="button"
                                class="btn btn-outline-danger"
                                title="Eliminar"
                                disabled="@(IsDeletingAccount)"
                                @onclick:stopPropagation="true"
                                @onclick="() => DeleteAccountAsync(account)">Eliminar</button>
                      </div>
                    </td>
                  </tr>
                }
              </tbody>
            </table>
          </div>
        }
      </div>
    </section>

    <section aria-labelledby="process-heading" class="card section-card process-section">
      <div class="card-body d-flex flex-column gap-3">
        <div class="d-flex flex-wrap align-items-end gap-2 bancos-process-toolbar">
          <h2 id="process-heading" class="h5 mb-0 flex-grow-1">Procesar archivo de banco</h2>
          <div class="d-flex flex-column">
            <label class="form-label mb-1" for="initial-balance">Saldo Inicial</label>
            <InputNumber id="initial-balance"
                         class="form-control"
                         TValue="decimal?"
                         @bind-Value="InitialBalance"
                         step="0.01" />
          </div>
          <button type="button"
                  class="btn btn-primary mb-0"
                  @onclick="OpenBankFilePickerAsync"
                  disabled="@(IsProcessingFile)">
            @(IsProcessingFile ? "Procesando…" : "Procesar archivo de banco")
          </button>
        </div>

        @if (LastProcessResult is not null)
        {
          <div class="card bg-light bancos-process-summary">
            <div class="card-body">
              <h3 class="h6">Resumen del procesamiento</h3>
              @if (LastProcessResult.CambiosSaldoHistorico > 0)
              {
                <div class="alert alert-warning bancos-import-warning" role="alert">
                  <div>
                    <span class="badge text-bg-warning mb-2">Revisión requerida</span>
                    <h4 class="h6 mb-2">BBVA cambió saldos de movimientos históricos</h4>
                    <p class="mb-2">
                      OrionERP reconoció <strong>@LastProcessResult.CambiosSaldoHistorico</strong> movimiento(s) ya existentes
                      con un saldo distinto. No se duplicaron y se conservaron los saldos previamente guardados.
                    </p>
                    <p class="mb-0 small">
                      El archivo insertó <strong>@LastProcessResult.Insertados</strong> movimiento(s) nuevo(s).
                      Revisa el resultado antes de crear pólizas automáticas.
                    </p>
                  </div>
                  @if (RequiresBankImportWarningAcknowledgement)
                  {
                    <button type="button" class="btn btn-warning btn-sm" @onclick="AcknowledgeBankImportWarning">
                      Entiendo, habilitar pólizas auto
                    </button>
                  }
                  else
                  {
                    <span class="badge text-bg-success">Advertencia revisada</span>
                  }
                </div>
              }
              else if (LastProcessResult.CoincidenciasExistentes > 0)
              {
                <div class="alert alert-info py-2" role="status">
                  Se reconocieron @LastProcessResult.CoincidenciasExistentes movimiento(s) ya cargados; no se duplicaron.
                </div>
              }
              <dl class="row mb-0">
                <dt class="col-sm-4">Insertados</dt>
                <dd class="col-sm-8">@LastProcessResult.Insertados</dd>
                <dt class="col-sm-4">Ya existentes</dt>
                <dd class="col-sm-8">@LastProcessResult.CoincidenciasExistentes</dd>
                <dt class="col-sm-4">Actualizados</dt>
                <dd class="col-sm-8">@LastProcessResult.Actualizados</dd>
                <dt class="col-sm-4">Cuenta</dt>
                <dd class="col-sm-8">@LastProcessResult.NumeroCuenta (@LastProcessResult.NombreBanco)</dd>
                <dt class="col-sm-4">Hash del archivo</dt>
                <dd class="col-sm-8 text-break">@LastProcessResult.ArchivoHash</dd>
                <dt class="col-sm-4">Advertencias de balance</dt>
                <dd class="col-sm-8">@LastProcessResult.BalanceWarnings</dd>
              </dl>
            </div>
          </div>
        }
      </div>
    </section>

    <section aria-labelledby="filters-heading" class="card section-card filters-section">
      <div class="card-body">
        <div class="d-flex flex-column flex-lg-row align-items-lg-end gap-3 bancos-filters-toolbar">
          <div>
            <label class="form-label" for="month-select">Mes</label>
            <select id="month-select" class="form-select" @bind="SelectedMonth" @bind:after="OnMonthChangedAsync">
              @foreach (var month in MonthOptions)
              {
                <option value="@month.Key">@month.Value</option>
              }
            </select>
          </div>
          <div>
            <label class="form-label" for="year-select">Año</label>
            <select id="year-select" class="form-select" @bind="SelectedYear" @bind:after="OnYearChangedAsync">
              @foreach (var year in AvailableYears)
              {
                <option value="@year">@year</option>
              }
            </select>
          </div>
          <div class="flex-grow-1">
            <label class="form-label" for="text-filter">Buscar en concepto</label>
            <input id="text-filter" class="form-control" type="text" placeholder="Escribe para filtrar…" value="@TextFilter" @oninput="OnTextFilterChanged" />
          </div>
          <div class="ms-lg-auto">
            <button class="btn btn-outline-secondary" @onclick="ReloadMovementsAsync" disabled="@(IsLoadingMovements || IsLoadingPendingTransactions)">
              @(IsLoadingMovements ? "Cargando…" : "Recargar")
            </button>
          </div>
        </div>
      </div>
    </section>

    <section aria-labelledby="pending-heading" class="card section-card pending-section">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3 bancos-section-toolbar bancos-section-toolbar--between">
          <h2 id="pending-heading" class="h5 mb-0">Transacciones pendientes por ligar</h2>
          <span class="badge bg-secondary">@PendingTransactions.Count pendientes</span>
        </div>

        @if (IsLoadingPendingTransactions)
        {
          <div class="orion-loading" role="status" aria-live="polite">
            <span class="orion-spinner" aria-hidden="true"></span>
            <span class="orion-strong">Cargando transacciones pendientes…</span>
          </div>
        }
        else if (PendingTransactions.Count == 0)
        {
          <div class="alert alert-success mb-0">No hay transacciones pendientes por ligar.</div>
        }
        else
        {
          <div class="table-responsive bancos-table-wrap bancos-table-wrap--pending">
            <table class="table table-sm table-hover align-middle mb-0 bancos-table bancos-responsive-table bancos-responsive-table--pending">
              <thead class="table-light">
                <tr>
                  <th scope="col">ID</th>
                  <th scope="col">Fecha</th>
                  <th scope="col">Forma de pago</th>
                  <th scope="col">Concepto</th>
                  <th scope="col" class="text-end">Registro contable</th>
                </tr>
              </thead>
              <tbody>
                @foreach (var pending in PendingTransactions)
                {
                  var isSelected = pending.TransaccionId == SelectedPendingTransactionId;
                  var rowClass = isSelected ? "table-primary" : string.Empty;
                  <tr class="@($"bancos-clickable-row {rowClass}")" aria-selected="@(isSelected ? "true" : "false")" @onclick="@(() => OnPendingTransactionSelected(pending.TransaccionId))">
                    <td data-label="ID"><a href="/Contabilidad/Transacciones/@pending.TransaccionId" target="_blank" rel="noopener">@pending.TransaccionId</a></td>
                    <td data-label="Fecha">@pending.Fecha.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</td>
                    <td data-label="Forma de pago">@pending.FormaPago</td>
                    <td data-label="Concepto" class="text-wrap">@pending.Concepto</td>
                    <td data-label="Registro contable" class="text-end">
                      <div>@FormatPendingBankRegistro(pending)</div>
                      @if (pending.BankRegistroLineCount > 1)
                      {
                        <div class="small text-muted">@pending.BankRegistroLineCount línea(s)</div>
                      }
                    </td>
                  </tr>
                }
              </tbody>
            </table>
          </div>
        }
      </div>
    </section>

    <section aria-label="Acciones de conciliación" class="card section-card actions-section">
      <div class="card-body py-2">
        <div class="d-flex flex-wrap align-items-center gap-2 bancos-actions-toolbar">
          <div class="form-check mb-0">
            <InputCheckbox id="filter-unlinked-movements" class="form-check-input" @bind-Value="ShowOnlyUnlinkedMovements" />
            <label class="form-check-label" for="filter-unlinked-movements">Sin póliza</label>
          </div>
          <div class="form-check mb-0">
            <InputCheckbox id="filter-accounting-issues" class="form-check-input" @bind-Value="ShowOnlyAccountingIssues" />
            <label class="form-check-label" for="filter-accounting-issues">Problemas contables</label>
          </div>
          <div class="form-check mb-0">
            <InputCheckbox id="filter-balance-differences" class="form-check-input" @bind-Value="ShowOnlyBalanceDifferences" />
            <label class="form-check-label" for="filter-balance-differences">Diferencia banco-contable</label>
          </div>
          <button class="btn btn-outline-primary btn-sm" type="button" @onclick="OnUnlinkClicked" disabled="@(!CanUnlink)">Revisar vínculos</button>
          <div class="flex-grow-1"></div>
          <button class="btn btn-primary btn-sm" type="button" @onclick="OnLinkClicked" disabled="@(!CanLink)">Ligar / revisar</button>
          <button class="btn btn-outline-primary btn-sm"
                  type="button"
                  @onclick="OnAlignTransactionsToBankOrderClicked"
                  disabled="@(!CanAlignTransactionsToBankOrder)">
            @if (IsAligningTransactions)
            {
              <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
              <span>Alineando...</span>
            }
            else
            {
              <span>Alinear pólizas al banco</span>
            }
          </button>
          <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="OnAutoPolizasClicked" disabled="@AutoPolizasDisabled" title="@AutoPolizasTooltip">Crear pólizas auto</button>
          @if (HasPendingTransactions)
          {
            <span class="text-muted small" role="note">Disponible cuando no haya transacciones pendientes por ligar.</span>
          }
          else if (RequiresBankImportWarningAcknowledgement)
          {
            <span class="text-warning-emphasis small" role="note">Confirma primero la advertencia de saldos históricos.</span>
          }
        </div>
      </div>
    </section>

    <section aria-labelledby="movements-heading" class="card section-card movements-section">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3 bancos-section-toolbar bancos-section-toolbar--between">
          <h2 id="movements-heading" class="h5 mb-0">Movimientos</h2>
          <div class="d-flex flex-wrap align-items-center justify-content-end gap-2">
            <div class="btn-group btn-group-sm" role="group" aria-label="Orden de movimientos">
              <button type="button"
                      class="@GetBankNewestOrderButtonClass()"
                      aria-pressed="@IsBankNewestOrderSelected"
                      @onclick="SetBankNewestOrder">
                Banco reciente
              </button>
              <button type="button"
                      class="@GetAccountingOrderButtonClass()"
                      aria-pressed="@IsAccountingOrderSelected"
                      @onclick="SetAccountingOrder">
                Orden contable
              </button>
            </div>
            <div class="text-muted small">
              @if (SelectedAccountId.HasValue)
              {
                <span>Cuenta seleccionada: @SelectedAccountLabel</span>
                @if (!string.IsNullOrWhiteSpace(GetSelectedAccountDescription()))
                {
                  <span class="ms-2">Cuenta contable: @GetSelectedAccountDescription()</span>
                }
                @if (!string.IsNullOrWhiteSpace(SelectedAccountLedgerUrl))
                {
                  <a class="btn btn-sm btn-outline-primary ms-2"
                     href="@SelectedAccountLedgerUrl"
                     target="_blank"
                     rel="noopener">
                    Ver libro
                  </a>
                }
              }
              else
              {
                <span>Selecciona una cuenta para ver los movimientos.</span>
              }
            </div>
          </div>
        </div>

        @if (IsLoadingMovements)
        {
          <div class="orion-loading" role="status" aria-live="polite">
            <span class="orion-spinner" aria-hidden="true"></span>
            <span class="orion-strong">Cargando movimientos…</span>
          </div>
        }
        else if (!SelectedAccountId.HasValue)
        {
          <div class="alert alert-info mb-0">Selecciona una cuenta para ver los movimientos.</div>
        }
        else if (!VisibleMovements.Any())
        {
          <div class="alert alert-info mb-0">No hay movimientos para los filtros seleccionados.</div>
        }
        else
        {
          <div class="table-responsive bancos-table-wrap bancos-table-wrap--movements">
            <table class="table table-sm table-striped table-hover align-middle mb-0 bancos-table bancos-responsive-table bancos-responsive-table--movements">
              <thead class="table-light">
                <tr>
                  <th scope="col">Día</th>
                  <th scope="col">Contable #</th>
                  <th scope="col">Póliza</th>
                  <th scope="col">Concepto</th>
                  <th scope="col" class="text-end">Cargo</th>
                  <th scope="col" class="text-end">Abono</th>
                  <th scope="col" class="text-end bancos-movement-cell--saldo-banco">Saldo banco</th>
                  <th scope="col" class="bancos-movement-cell--registro-banco">Registro banco</th>
                  <th scope="col" class="text-end">Saldo contable</th>
                  <th scope="col" class="text-end">Diferencia</th>
                  <th scope="col">Estado</th>
                  <th scope="col">Orden</th>
                </tr>
              </thead>
              <tbody>
                @foreach (var movement in VisibleMovements)
                {
                  var isSelected = movement.MovimientoId == SelectedMovimientoId;
                  var rowClass = GetMovementRowClass(movement, isSelected);
                  var issueCodes = GetIssueCodes(movement);
                  var detailRows = GetAccountingDetailRows(movement);
                  <tr class="@($"bancos-clickable-row {rowClass}")" aria-selected="@(isSelected ? "true" : "false")" @onclick="@(() => OnMovementSelected(movement.MovimientoId))">
                    <td data-label="Día">@movement.Dia.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</td>
                    <td data-label="Contable #">
                      @if (movement.AccountingSequence.HasValue)
                      {
                        <span class="fw-semibold">@movement.AccountingSequence</span>
                      }
                      else
                      {
                        <span class="text-muted">-</span>
                      }
                    </td>
                    <td data-label="Póliza">
                      @if (movement.PolicyCount > 1)
                      {
                        <button type="button"
                                class="btn btn-link btn-sm p-0 fw-semibold"
                                title="@movement.LinkedPolicyIds"
                                @onclick:stopPropagation="true"
                                @onclick="() => OpenMovementLinkingWorkspace(movement.MovimientoId)">
                          @movement.PolicyCount pólizas
                        </button>
                        <div class="small text-muted">@movement.LinkedPolicySummary</div>
                      }
                      else if (movement.Policy.HasValue && movement.Policy.Value > 0)
                      {
                        <a href="/contabilidad/transacciones/@movement.Policy"
                           target="_blank"
                           rel="noopener"
                           @onclick:stopPropagation="true">@movement.Policy</a>
                        <div class="small text-muted">@FormatDateTime(movement.PolicyDate)</div>
                      }
                      else
                      {
                        <span class="text-muted">-</span>
                      }
                    </td>
                    <td data-label="Concepto" class="text-wrap">@movement.Concepto</td>
                    <td data-label="Cargo" class="text-end">@FormatCurrency(movement.Cargo)</td>
                    <td data-label="Abono" class="text-end">@FormatCurrency(movement.Abono)</td>
                    <td data-label="Saldo banco" class="text-end bancos-movement-cell--saldo-banco">
                      @FormatCurrency(movement.Saldo)
                      @if (movement.BalanceOk == false)
                      {
                        <div class="small text-warning">Saldo archivo</div>
                      }
                    </td>
                    <td data-label="Registro banco" class="bancos-movement-cell--registro-banco">
                      @if (movement.BankRegistroLineCount > 0)
                      {
                        <div>@FormatCurrency(movement.BankRegistroDebe) / @FormatCurrency(movement.BankRegistroHaber)</div>
                        <div class="small text-muted">@movement.BankRegistroLineCount línea(s) · @FormatAccountingLevels(movement)</div>
                      }
                      else
                      {
                        <span class="text-muted">-</span>
                      }
                    </td>
                    <td data-label="Saldo contable" class="text-end">@FormatCurrency(movement.AccountingRunningBalance)</td>
                    <td data-label="Diferencia" class="text-end @(HasMeaningfulBankAccountingDifference(movement) ? "movement-difference" : string.Empty)">
                      @FormatCurrency(movement.BankAccountingVariance)
                    </td>
                    <td data-label="Estado" class="text-wrap">
                      <span class="@($"badge {GetAuditBadgeClass(movement)}")">@GetAuditLabel(movement)</span>
                      @foreach (var issue in issueCodes)
                      {
                        <span class="badge text-bg-light border ms-1">@issue</span>
                      }
                      @if (HasMeaningfulBankAccountingDifference(movement))
                      {
                        <span class="badge text-bg-warning ms-1">SALDO_BANCO_DIFIERE</span>
                      }
                    </td>
                    <td data-label="Orden" class="bancos-table__actions">
                      <div class="btn-group btn-group-sm" role="group" aria-label="Acciones del movimiento">
                        <button class="btn btn-outline-primary"
                                type="button"
                                title="Ligar pólizas"
                                @onclick:stopPropagation="true"
                                @onclick="() => OpenMovementLinkingWorkspace(movement.MovimientoId)">
                          Ligar
                        </button>
                        @if (movement.Policy.HasValue && movement.Policy.Value > 0)
                        {
                          <button class="btn btn-outline-secondary"
                                  type="button"
                                  title="Ver registros contables"
                                  @onclick:stopPropagation="true"
                                  @onclick="() => ToggleAccountingDetailsAsync(movement)">
                            @if (IsPolicyDetailLoading(movement))
                            {
                              <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                            }
                            else
                            {
                              <i class="@GetDetailToggleIconClass(movement)"></i>
                            }
                          </button>
                          <button class="btn btn-outline-secondary"
                                  type="button"
                                  title="Mover antes en orden contable"
                                  disabled="@(!CanMoveAccountingEarlier(movement))"
                                  @onclick:stopPropagation="true"
                                  @onclick="() => MoveAccountingEarlierAsync(movement)">
                            <i class="bi bi-arrow-up"></i>
                          </button>
                          <button class="btn btn-outline-secondary"
                                  type="button"
                                  title="Mover después en orden contable"
                                  disabled="@(!CanMoveAccountingLater(movement))"
                                  @onclick:stopPropagation="true"
                                  @onclick="() => MoveAccountingLaterAsync(movement)">
                            <i class="bi bi-arrow-down"></i>
                          </button>
                        }
                        else
                        {
                          <span class="text-muted align-self-center">Sin póliza</span>
                        }
                      </div>
                    </td>
                  </tr>
                  @if (IsPolicyExpanded(movement))
                  {
                    <tr class="movement-detail-row">
                      <td colspan="12">
                        @if (IsPolicyDetailLoading(movement))
                        {
                          <div class="orion-loading py-2" role="status" aria-live="polite">
                            <span class="orion-spinner" aria-hidden="true"></span>
                            <span class="orion-strong">Cargando registro contable…</span>
                          </div>
                        }
                        else if (detailRows.Count == 0)
                        {
                          <div class="text-muted py-2">La póliza no tiene registros contables.</div>
                        }
                        else
                        {
                          <div class="bancos-movement-detail">
                            <table class="table table-sm mb-0 align-middle">
                              <thead>
                                <tr>
                                  <th scope="col">RC ID</th>
                                  <th scope="col">Cuenta</th>
                                  <th scope="col">Nombre</th>
                                  <th scope="col">Concepto</th>
                                  <th scope="col" class="text-end">Debe</th>
                                  <th scope="col" class="text-end">Haber</th>
                                </tr>
                              </thead>
                              <tbody>
                                @foreach (var detail in detailRows)
                                {
                                  <tr>
                                    <td>@detail.Id</td>
                                    <td>@($"{detail.Nivel1}.{detail.Nivel2}.{detail.Nivel3}")</td>
                                    <td>@detail.NombreCuenta</td>
                                    <td class="text-wrap">@detail.Concepto</td>
                                    <td class="text-end">@FormatCurrency(detail.Debe)</td>
                                    <td class="text-end">@FormatCurrency(detail.Haber)</td>
                                  </tr>
                                }
                              </tbody>
                            </table>
                          </div>
                        }
                      </td>
                    </tr>
                  }
                }
              </tbody>
            </table>
          </div>
        }
      </div>
    </section>
  </div>
}
