  private static decimal LineNetTotal(CartLine line)
  {
    var gross = line.UnitPrice * line.Quantity;
    return decimal.Round(gross - Math.Min(Math.Max(0, line.DiscountAmount), gross), 2, MidpointRounding.AwayFromZero);
  }

  protected override void OnInitialized() => Realtime.EventReceived += OnRealtimeEventAsync;

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (!firstRender) return;
    await LoadAsync();
    StateHasChanged();
    await RefreshSaleAlertsAsync();
    StateHasChanged();
  }

  private async Task LoadAsync()
  {
    isBusy = true; error = null;
    try
    {
      var loadAuth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
      currentUserName = loadAuth.User.Identity?.Name ?? "restaurante";
      sites = (await CatalogService.GetSitesAsync(CurrentRfc)).Where(site => site.IsEnabled).ToList();
      if (sites.Count == 0) { catalog = null; return; }
      if (!sites.Any(site => site.Id == selectedSiteId)) selectedSiteId = sites[0].Id;
      await Realtime.SubscribeAsync(CurrentRfc, selectedSiteId);
      catalog = await CatalogService.GetPosCatalogAsync(CurrentRfc, selectedSiteId, DateTimeOffset.UtcNow);
      if (!catalog.Sections.Any(section => section.Id == activeSectionId)) activeSectionId = catalog.Sections.FirstOrDefault()?.Id ?? 0;
      openShifts = (await CashService.GetShiftsAsync(CurrentRfc, selectedSiteId)).Where(shift => shift.Status == "Open").ToList();
      if (!openShifts.Any(shift => shift.Id == selectedShiftId)) selectedShiftId = openShifts.Count == 1 ? openShifts[0].Id : null;
      await RestoreCartAsync();
      if (!hasInitializedWorkspace)
      {
        isMenuOpen = cart.Count == 0;
        hasInitializedWorkspace = true;
      }
      await RefreshPromotionQuoteAsync();
    }
    catch (Exception ex) { error = ex.Message; }
    finally { isBusy = false; }
  }

  private async Task ChangeSiteAsync(ChangeEventArgs args)
  {
    if (!int.TryParse(args.Value?.ToString(), out var id)) return;
    selectedSiteId = id;
    cart = [];
    idempotencyKey = Guid.NewGuid().ToString("N");
    selectedMember = null;
    memberIdentifier = null;
    redemptionPreview = null;
    redemptionPoints = appliedRedemptionPoints = 0;
    promotionQuote = null;
    promotionCode = null;
    isMenuOpen = true;
    hasInitializedWorkspace = true;
    saleAlerts = null;
    saleAlertsError = null;
    await Realtime.SubscribeAsync(CurrentRfc, selectedSiteId);
    await LoadAsync();
    await RefreshSaleAlertsAsync();
  }

