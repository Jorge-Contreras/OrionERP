@page "/"
@inject IBrunoPublicCatalogService CatalogService
@inject IWebHostEnvironment Environment

<PageTitle>Bruno's Garden & Snacks · Calpulalpan</PageTitle>
<HeadContent>
  <meta name="description" content="@settings.SeoDescription" />
  <link rel="preload" as="image" type="image/webp" href="/Images/Brunos/brunos-food-hero.webp" fetchpriority="high" />
</HeadContent>

<section class="hero">
  <div class="hero__shade"></div>
  <div class="hero__brand-visual" aria-hidden="true">
    <img class="hero__logo-badge" src="/Images/Brunos/brunos-logo-512.webp" alt="" width="512" height="512" />
    <img class="hero__mascot" src="/Images/Brunos/bruno-hero-mascot.webp" alt="" width="880" height="1100" fetchpriority="high" />
  </div>
  <div class="hero__content">
    <span>@settings.HeroEyebrow</span>
    <h1>@settings.HeroTitle</h1>
    <p>@settings.HeroDescription</p>
    <a class="hero__hours" href="/visitanos">
      <i class="dot @(IsOpenNow ? "dot--open" : "dot--closed")" aria-hidden="true"></i>
      <strong>@OpenStateLabel</strong>
      <span>@TodayHours</span>
      <small>Cómo llegar</small>
    </a>
    <div class="hero__actions">
      @if (membershipEnabled)
      {
        <a class="button button--accent club-cta" href="/cuenta/registro" target="_top"><span>Únete gratis a Club Bruno</span><small>Crea tu cuenta</small></a>
      }
      <a class="button button--ghost" href="/menu">Ver menú</a>
      @if (!membershipEnabled)
      {
        <a class="button button--ghost" href="/membresia">Conocer Club Bruno</a>
      }
    </div>
    <ul class="hero__marks">
      <li>Chicken fingers</li>
      <li>Hamburguesas</li>
      <li>Pet friendly</li>
    </ul>
  </div>
</section>

<div class="ticker" aria-hidden="true">
  <div class="ticker__track">
    @for (var pass = 0; pass < 2; pass++)
    {
      @foreach (var word in TickerWords)
      {
        <span>@word</span>
      }
    }
  </div>
</div>

@if (membershipEnabled)
{
  <section class="club-spotlight" aria-labelledby="club-spotlight-title">
    <figure class="club-spotlight__visual">
      <img class="club-spotlight__photo" src="/Images/Brunos/brunos-real-club.webp" alt="Mesas y luces del jardín real de Bruno's Garden & Snacks" width="1086" height="1448" loading="lazy" />
      <img class="club-spotlight__logo" src="/Images/Brunos/brunos-logo-512.webp" alt="" aria-hidden="true" width="512" height="512" loading="lazy" />
      <img class="club-spotlight__mascot" src="/Images/Brunos/bruno-club-mascot.webp" alt="" aria-hidden="true" width="880" height="1100" loading="lazy" />
    </figure>
    <div class="club-spotlight__content">
      <span>Club Bruno</span>
      <h2 id="club-spotlight-title">Cada visita puede sumar</h2>
      <p>Crea tu cuenta gratis, confirma tu correo e identifícate antes de pagar para acumular puntos en tus compras elegibles.</p>
      <ul><li>Registro gratuito</li><li>Consulta tus puntos</li><li>QR temporal desde tu cuenta</li></ul>
      <div class="club-spotlight__actions"><a class="button button--accent club-cta" href="/cuenta/registro" target="_top"><span>Crear mi cuenta gratis</span><small>Quiero ser miembro</small></a><a href="/membresia">Ver cómo funciona →</a></div>
    </div>
  </section>
}

<section class="intro-grid">
  <article><span>01</span><h2>Antojo para todos</h2><p>Chicken fingers, hamburguesas, snacks, bebidas y opciones para compartir.</p><a href="/menu">Explorar el menú →</a></article>
  <article><span>02</span><h2>Un jardín para quedarte</h2><p>Ambiente familiar y pet friendly para comer, conversar y pasarla bien.</p><a href="/visitanos">Planea tu visita →</a></article>
  <article><span>03</span><h2>Tus visitas suman</h2><p>Regístrate en Club Bruno, identifícate antes de pagar y acumula puntos en compras elegibles.</p><a href="/membresia">Cómo funciona →</a></article>
</section>

<section class="featured">
  <div><span>Desde nuestra cocina</span><h2>Elige tu próximo favorito</h2><p>El menú se actualiza directamente desde nuestro catálogo. Precios y disponibilidad pueden cambiar durante el día.</p></div>
  <div class="featured__products">
    @foreach (var product in featuredProducts)
    {
      <article>
        @if (product.HasImage) { <img src="/media/productos/@product.Id?thumbnail=false" alt="@product.Name" loading="lazy" decoding="async" /> }
        <div><h3>@product.Name</h3><p>@product.Description</p><strong>@product.Price.ToString("C0")</strong></div>
      </article>
    }
  </div>
  <div class="featured__more"><a class="button button--ghost" href="/menu">Ver el menú completo</a></div>
</section>

<section class="order-preview">
  <div><span>Próximamente</span><h2>Ordena como te convenga</h2><p>Estamos preparando pedidos en línea para recolección y entrega. Mientras tanto, visítanos en el jardín para disfrutar el menú completo.</p></div>
  <div class="order-preview__steps"><span><b>1</b> Confirma ubicación</span><span><b>2</b> Elige recolección o entrega</span><span><b>3</b> Arma y paga tu orden</span></div>
</section>

@code {
  private static readonly string[] TickerWords =
  [
    "Chicken fingers", "Hamburguesas", "Snacks", "Bebidas",
    "Pet friendly", "Jardín al aire libre", "Martes a domingo 9–22"
  ];

  private BrunoPublicSiteSettingsDto settings = new()
  {
    HeroEyebrow = "Jardín pet friendly en Calpulalpan",
    HeroTitle = "Snacks, jardín y buenos momentos",
    HeroDescription = "Un espacio familiar para disfrutar, convivir y venir con tu mascota.",
    SeoDescription = "Bruno's Garden & Snacks en Calpulalpan."
  };
  private List<RestaurantProductDto> featuredProducts = [];
  private bool membershipEnabled;

  private static bool IsClosedToday => DateTime.Now.DayOfWeek == DayOfWeek.Monday;
  private string TodayHours => IsClosedToday ? "Hoy cerrado" : "Hoy 9:00–22:00";
  private bool IsOpenNow => !IsClosedToday && DateTime.Now.Hour >= 9 && DateTime.Now.Hour < 22;
  private string OpenStateLabel => IsOpenNow ? "Abierto ahora" : "Cerrado ahora";

  protected override async Task OnInitializedAsync()
  {
    membershipEnabled = Environment.IsDevelopment();
    try
    {
      var catalog = await CatalogService.GetCatalogAsync(BrunoSiteConstants.Rfc, BrunoSiteConstants.SiteCode, DateTimeOffset.Now);
      if (catalog is null) return;
      settings = catalog.Settings;
      membershipEnabled = catalog.Settings.IsMembershipEnabled || Environment.IsDevelopment();
      featuredProducts = catalog.Menu.Sections.SelectMany(section => section.Products).Where(product => !product.IsSoldOut).Take(3).ToList();
    }
    catch { }
  }
}
