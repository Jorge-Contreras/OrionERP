  private void OpenPersonalize(CartLine line)
  {
    if (!line.ProductId.HasValue || catalog is null) return;
    var product = catalog.Sections.SelectMany(section => section.Products).FirstOrDefault(item => item.Id == line.ProductId.Value);
    if (product is null) { error = "El producto ya no está disponible en el menú actual."; return; }
    var section = catalog.Sections.FirstOrDefault(item => item.Id == line.MenuSectionId)
      ?? catalog.Sections.FirstOrDefault(item => item.Products.Any(candidate => candidate.Id == product.Id));
    OpenProductModal(product, section, line);
  }
  private void OpenProductModal(RestaurantProductDto product, RestaurantMenuSectionDto? section, CartLine? line)
  {
    selectedProduct = product;
    selectedMenuSection = section;
    editingLine = line;
    selectedModifierIds = line?.ModifierIds.ToList() ?? [];
    selectedProductNotes = line?.Notes;
    selectedComboOptionIds = [];
    selectedComponentDrafts = [];
    if (product.ProductKind == RestaurantProductKinds.Combo)
    {
      foreach (var slot in product.ComboSlots.Where(item => item.IsActive))
      {
        var persisted = line?.ComboComponents.Where(item => item.SlotId == slot.Id).ToList() ?? [];
        var selectedIds = persisted.Count > 0
          ? persisted.Select(item => item.OptionId).ToHashSet()
          : slot.Options.Where(item => item.IsActive && item.IsDefault && !item.IsSoldOut).Select(item => item.Id).ToHashSet();
        selectedComboOptionIds[slot.Id] = selectedIds;
        foreach (var optionId in selectedIds)
        {
          var component = persisted.FirstOrDefault(item => item.OptionId == optionId);
          selectedComponentDrafts[ComponentDraftKey(slot.Id, optionId)] = new()
          {
            SlotId = slot.Id,
            OptionId = optionId,
            ModifierIds = component?.ModifierIds.ToList() ?? [],
            Notes = component?.Notes
          };
        }
      }
    }
    error = null;
  }
  private void CloseProductModal()
  {
    selectedProduct = null;
    selectedMenuSection = null;
    selectedModifierIds = [];
    selectedComboOptionIds = [];
    selectedComponentDrafts = [];
    selectedProductNotes = null;
    editingLine = null;
  }
