    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        try
        {
            var authState = await task;
            await ApplyAuthenticationStateAsync(authState);
            await InvokeAsync(async () =>
            {
                await LoadDashboardCoreAsync(resolveUser: false);
                StateHasChanged();
            });
        }
        catch
        {
            // The circuit may be tearing down during login/logout navigation.
        }
    }

    public void Dispose()
    {
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }

    private sealed record ReservationDayGroupVm(
        string TitleId,
        string Label,
        string DayName,
        IReadOnlyList<ListaReservacionItemDto> Items);
}
