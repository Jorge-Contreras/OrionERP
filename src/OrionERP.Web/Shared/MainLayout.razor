@inherits LayoutComponentBase
@implements IDisposable
@using OrionERP.Web.Services
@using OrionERP.Web.Features.TrainingSafety
@inject IUiMessageService MessageService
@inject ITrainingEnvironmentState TrainingEnvironment
@inject NavigationManager Navigation

<PageTitle>@(TrainingEnvironment.IsTraining ? "CAPACITACIÓN · OrionERP" : "OrionERP")</PageTitle>

<div id="orion-app-shell" class="@AppShellCssClass">
    <div id="layout-nav-sidebar" class="sidebar app-shell__sidebar">
        <NavMenu OnMenuItemSelected="HideDesktopNavMenu" />
    </div>

    <main class="app-shell__main">
        <div class="top-row app-shell__topbar">
            <button type="button"
                    class="app-shell__nav-toggle"
                    aria-controls="layout-nav-sidebar"
                    aria-expanded="@_isDesktopNavVisible"
                    aria-label="@(_isDesktopNavVisible ? "Ocultar menu de navegacion" : "Mostrar menu de navegacion")"
                    @onclick="ToggleDesktopNavMenu">
                <span class="oi @(_isDesktopNavVisible ? "oi-chevron-left" : "oi-menu")" aria-hidden="true"></span>
                <span>@(_isDesktopNavVisible ? "Ocultar menu" : "Mostrar menu")</span>
            </button>

            <CommandCenter />

            <div class="app-shell__topbar-header">
                <SecurityHeader CompactMobile="@IsWorkOrderFieldRoute" />
            </div>
        </div>

        <TrainingEnvironmentBanner />
        <NotificationBanner />
        <article class="app-shell__content">
            <ErrorBoundary>
                <ChildContent>
                    @Body
                </ChildContent>

                <ErrorContent Context="ex">
                    <div class="alert alert-danger">
                        <strong>Unexpected error:</strong> @ex.Message
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </article>
    </main>
</div>

<ConnectionStatus />

@code {
    [CascadingParameter] private ErrorBoundary? _errorBoundary { get; set; }
    private bool _isDesktopNavVisible;

    private string AppShellCssClass
        => $"page app-shell{(_isDesktopNavVisible ? string.Empty : " app-shell--nav-hidden")}{(IsWorkOrderFieldRoute ? " app-shell--field-operations" : string.Empty)}{(TrainingEnvironment.IsTraining ? " app-shell--training" : string.Empty)}";

    private bool IsWorkOrderFieldRoute
    {
        get
        {
            var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');
            if (string.Equals(path, "ordenes-trabajo", StringComparison.OrdinalIgnoreCase))
            {
                return true;
            }

            var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries);
            return segments.Length == 2
                && string.Equals(segments[0], "ordenes-trabajo", StringComparison.OrdinalIgnoreCase)
                && int.TryParse(segments[1], out _);
        }
    }

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += HandleLocationChanged;
    }

    private void HandleError(Exception exception)
    {
        MessageService.ShowError($"Ocurrió un error inesperado: {exception.Message}");
    }

    private void Recover()
    {
        MessageService.Clear();
        _errorBoundary?.Recover();
    }

    private void ToggleDesktopNavMenu()
    {
        _isDesktopNavVisible = !_isDesktopNavVisible;
    }

    private void HideDesktopNavMenu()
    {
        _isDesktopNavVisible = false;
    }

    private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        _isDesktopNavVisible = false;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}
