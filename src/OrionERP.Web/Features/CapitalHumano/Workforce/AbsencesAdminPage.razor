@page "/capital-humano/ausencias"
@attribute [Authorize(Policy = "CapitalHumanoAdmin")]
@using OrionERP.Application.Features.CapitalHumano.Workforce
@inject ILeaveManagementService Leave
@inject IWorkforceConfigurationService ConfigurationService
@inject IUserRfcState RfcState

<PageTitle>Ausencias</PageTitle>

<div class="workforce-page py-3">
  <header class="workforce-hero"><div><div class="workforce-eyebrow">Capital Humano</div><h1>Ausencias y saldos</h1><p>Solicitudes de día completo o parcial, acumulación legal y ajustes registrados en un libro mayor inmutable.</p></div><button class="btn btn-outline-primary" @onclick="LoadAsync">Actualizar</button></header>
  @if(!string.IsNullOrWhiteSpace(message)){<div class="alert @(error?"alert-danger":"alert-success") workforce-alert">@message</div>}
  <div class="workforce-grid">
    <section class="workforce-card workforce-span-8"><div class="workforce-card__header"><h2>Solicitudes</h2><span class="workforce-status @(requests.Count(x=>x.Status=="PENDING")>0?"workforce-status--warn":"")">@requests.Count(x=>x.Status=="PENDING") pendientes</span></div><div class="table-responsive"><table class="table table-hover workforce-table"><thead><tr><th>Empleado</th><th>Tipo</th><th>Periodo</th><th>Días</th><th>Estado</th><th></th></tr></thead><tbody>@if(requests.Count==0){<tr><td colspan="6" class="workforce-empty">No hay solicitudes.</td></tr>}@foreach(var item in requests){<tr><td><strong>@item.EmployeeName</strong><div class="workforce-label">@item.Reason</div></td><td>@item.LeaveTypeName</td><td>@item.StartDate.ToString("dd MMM") – @item.EndDate.ToString("dd MMM yyyy")</td><td>@item.RequestedDays.ToString("0.##")</td><td><span class="workforce-status @(item.Status=="PENDING"?"workforce-status--warn":"")">@item.Status</span></td><td>@if(item.Status=="PENDING"){<div class="workforce-actions"><button class="btn btn-sm btn-success" @onclick="()=>DecideAsync(item.Id,true)">Aprobar</button><button class="btn btn-sm btn-outline-danger" @onclick="()=>DecideAsync(item.Id,false)">Rechazar</button></div>}</td></tr>}</tbody></table></div></section>
    <section class="workforce-card workforce-span-4"><div class="workforce-card__header"><h2>Tipos activos</h2><span class="workforce-status">@types.Count</span></div><div class="workforce-card__body">@if(types.Count==0){<div class="workforce-empty-block">No hay tipos de ausencia configurados.</div>}@foreach(var type in types){<div class="d-flex justify-content-between gap-3 py-2 border-bottom"><span>@type.Name</span><span class="workforce-label text-end">@(type.IsPaid?"Pagada":"No pagada") · @(type.RequiresBalance?"Con saldo":"Sin saldo")</span></div>}</div></section>
    <section class="workforce-card workforce-span-6"><div class="workforce-card__header"><h2>Políticas efectivas</h2></div><div class="workforce-card__body"><div class="workforce-form"><Field Label="Tipo"><select class="form-select" @bind="policy.LeaveTypeId"><option value="0">Selecciona</option>@foreach(var t in types){<option value="@t.Id">@t.Name</option>}</select></Field><Field Label="Código"><input class="form-control" maxlength="30" @bind="policy.Code"/></Field><div class="span-2"><label class="form-label">Nombre</label><input class="form-control" maxlength="150" @bind="policy.Name"/></div><Field Label="Vigente desde"><input type="date" class="form-control" @bind="policy.EffectiveFrom"/></Field><Field Label="Acumulación"><select class="form-select" @bind="policy.AccrualMethod"><option value="NONE">Sin acumulación</option><option value="ANNUAL">Anual fija</option><option value="MEXICO_STATUTORY">México legal</option></select></Field><Field Label="Días anuales"><input type="number" min="0" step=".25" class="form-control" @bind="policy.AnnualDays"/></Field><div class="form-check align-self-end mb-2"><input id="leave-partial" type="checkbox" class="form-check-input" @bind="policy.AllowPartialDay"/><label for="leave-partial" class="form-check-label">Permite parcial</label></div><div class="span-2"><button class="btn btn-primary" @onclick="SavePolicyAsync">Guardar política</button></div></div><hr/>@foreach(var item in policies){<div class="d-flex justify-content-between border-bottom py-2"><div><strong>@item.Name</strong><div class="workforce-label">@item.LeaveTypeName · @item.AccrualMethod · desde @item.EffectiveFrom.ToString("dd MMM yyyy")</div></div><span class="workforce-status @(item.IsActive?"":"workforce-status--warn")">@(item.IsActive?"Activa":"Inactiva")</span></div>}</div></section>
    <section class="workforce-card workforce-span-6"><div class="workforce-card__header"><h2>Inscripciones</h2></div><div class="workforce-card__body"><div class="workforce-form"><div class="span-2"><label class="form-label">Empleado</label><select class="form-select" @bind="enrollment.EmployeeId"><option value="0">Selecciona</option>@foreach(var e in employees){<option value="@e.EmployeeId">@e.Name</option>}</select></div><div class="span-2"><label class="form-label">Política</label><select class="form-select" @bind="enrollment.LeavePolicyId"><option value="0">Selecciona</option>@foreach(var p in policies.Where(x=>x.IsActive)){<option value="@p.Id">@p.Name</option>}</select></div><Field Label="Vigente desde"><input type="date" class="form-control" @bind="enrollment.EffectiveFrom"/></Field><div class="span-2"><button class="btn btn-primary" @onclick="SaveEnrollmentAsync">Inscribir empleado</button></div></div><hr/>@foreach(var item in enrollments.Take(12)){<div class="border-bottom py-2"><strong>@item.EmployeeName</strong><div class="workforce-label">@item.PolicyName · desde @item.EffectiveFrom.ToString("dd MMM yyyy")</div></div>}</div></section>
    <section class="workforce-card workforce-span-6"><div class="workforce-card__header"><h2>Ajuste de saldo</h2></div><div class="workforce-card__body"><div class="workforce-form"><div class="span-2"><label class="form-label">Empleado</label><select class="form-select" @bind="adjustment.EmployeeId"><option value="0">Selecciona</option>@foreach(var e in employees){<option value="@e.EmployeeId">@e.Name</option>}</select></div><Field Label="Tipo"><select class="form-select" @bind="adjustment.LeaveTypeId"><option value="0">Selecciona</option>@foreach(var t in types){<option value="@t.Id">@t.Name</option>}</select></Field><Field Label="Días (+/−)"><input type="number" step=".25" class="form-control" @bind="adjustment.Days"/></Field><div class="span-2"><label class="form-label">Justificación</label><textarea class="form-control" maxlength="500" @bind="adjustment.Reason"></textarea></div><div class="span-2"><button class="btn btn-primary" @onclick="AdjustAsync">Registrar ajuste</button></div></div></div></section>
    <section class="workforce-card workforce-span-6"><div class="workforce-card__header"><h2>Acumulación de vacaciones</h2></div><div class="workforce-card__body"><p class="text-muted">Genera sólo aniversarios faltantes mediante claves idempotentes. La tabla legal se conserva en reglas versionables y debe validarse por RH.</p><label class="form-label">Procesar al día</label><input type="date" class="form-control mb-3" @bind="accrualDate"/><button class="btn btn-outline-primary" @onclick="AccrueAsync">Procesar acumulaciones</button></div></section>
  </div>
</div>

@code {
  private IReadOnlyList<LeaveRequestDto> requests=[]; private IReadOnlyList<LeaveTypeDto> types=[]; private IReadOnlyList<LeavePolicyDto> policies=[]; private IReadOnlyList<LeaveEnrollmentDto> enrollments=[]; private IReadOnlyList<EmployeeWorkforceOptionDto> employees=[]; private LeaveBalanceAdjustmentRequest adjustment=new(); private LeavePolicySaveRequest policy=new(); private LeaveEnrollmentSaveRequest enrollment=new(); private DateOnly accrualDate=DateOnly.FromDateTime(DateTime.Today); private string? message; private bool error;
  private string Rfc=>RfcState.CurrentRfc??RfcState.AllowedRfcs.FirstOrDefault()??string.Empty;
  protected override async Task OnInitializedAsync()=>await LoadAsync();
  private async Task LoadAsync(){try{requests=await Leave.GetTeamRequestsAsync(Rfc);types=await Leave.GetLeaveTypesAsync(Rfc);policies=await Leave.GetPoliciesAsync(Rfc);enrollments=await Leave.GetEnrollmentsAsync(Rfc);employees=(await ConfigurationService.GetSetupAsync(Rfc)).Employees;adjustment.Rfc=Rfc;policy.Rfc=Rfc;enrollment.Rfc=Rfc;}catch(Exception ex){Show(ex.Message,true);}}
  private async Task DecideAsync(long id,bool approve)=>await RunAsync(()=>Leave.DecideRequestAsync(id,Rfc,approve,approve?"Aprobada por Capital Humano":"Rechazada por Capital Humano"));
  private async Task AdjustAsync(){adjustment.Rfc=Rfc;await RunAsync(()=>Leave.AdjustBalanceAsync(adjustment));}
  private async Task SavePolicyAsync(){policy.Rfc=Rfc;await RunAsync(()=>Leave.SavePolicyAsync(policy));}
  private async Task SaveEnrollmentAsync(){enrollment.Rfc=Rfc;await RunAsync(()=>Leave.SaveEnrollmentAsync(enrollment));}
  private async Task AccrueAsync()=>await RunAsync(()=>Leave.ProcessVacationAccrualsAsync(Rfc,accrualDate));
  private async Task RunAsync(Func<Task<WorkforceCommandResult>> action){try{var result=await action();Show(result.Message,!result.Success);if(result.Success)await LoadAsync();}catch(Exception ex){Show(ex.Message,true);}}
  private void Show(string text,bool isError){message=text;error=isError;}
}
