                new("/ReportesFinancieros/BalanzaComprobacion", "Balanza de Comp", "Saldo y movimientos por cuenta para analisis contable.", "oi-clipboard", "Balanza de Comprobacion", NavLinkMatch.Prefix, true, "Balance", "balanza", "comprobacion", "saldos"),
                new("/ReportesFinancieros/EstadoPerdidasGanancias", "Perdidas y Ganancias", "Rentabilidad y desempeno financiero del negocio.", "oi-graph", "Estado de Perdidas y Ganancias", NavLinkMatch.Prefix, false, "P&L", "perdidas", "ganancias", "estado financiero")
            })
    };

    private bool collapseNavMenu = true;
    private string searchText = string.Empty;

    [Parameter] public EventCallback OnMenuItemSelected { get; set; }

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;
    private bool HasSearch => !string.IsNullOrWhiteSpace(searchText);

    private IReadOnlyList<VisibleNavSection> VisibleSections => BuildVisibleSections(Sections, searchText);

    private NavEntryDefinition? CurrentEntry
    {
        get
        {
            var currentPath = NormalizePath(Navigation.ToBaseRelativePath(Navigation.Uri));

            return Sections
                .SelectMany(section => section.Items)
                .OrderByDescending(item => NormalizePath(item.Href).Length)
                .FirstOrDefault(item => IsCurrentRoute(currentPath, item));
        }
    }

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += HandleLocationChanged;
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
    }

    private static IReadOnlyList<VisibleNavSection> BuildVisibleSections(IReadOnlyList<NavSectionDefinition> source, string filter)
    {
        var query = filter.Trim();
        var sections = new List<VisibleNavSection>();

        foreach (var section in source)
        {
            IReadOnlyList<NavEntryDefinition> items = string.IsNullOrWhiteSpace(query)
                ? section.Items
                : section.Items.Where(item => MatchesFilter(item, query)).ToList();

            if (items.Count > 0)
            {
                sections.Add(new VisibleNavSection(section, items));
            }
        }

        return sections;
    }

    private static bool MatchesFilter(NavEntryDefinition item, string filter)
    {
        return item.Label.Contains(filter, StringComparison.OrdinalIgnoreCase)
            || item.Description.Contains(filter, StringComparison.OrdinalIgnoreCase)
            || item.Title.Contains(filter, StringComparison.OrdinalIgnoreCase)
            || item.Badge?.Contains(filter, StringComparison.OrdinalIgnoreCase) == true
            || item.Keywords.Any(keyword => keyword.Contains(filter, StringComparison.OrdinalIgnoreCase));
    }

    private static NavEntryDefinition[] GetQuickAccessItems(IReadOnlyList<VisibleNavSection> sections)
    {
        return sections
            .SelectMany(section => section.Items)
            .Where(item => item.IsQuickAccess)
            .Take(8)
            .ToArray();
    }

    private static string NormalizePath(string path)
    {
        if (string.IsNullOrWhiteSpace(path))
        {
            return string.Empty;
        }

        return path.Trim().Trim('/').ToLowerInvariant();
    }

    private static bool IsCurrentRoute(string currentPath, NavEntryDefinition item)
    {
        var targetPath = NormalizePath(item.Href);

        if (item.Match == NavLinkMatch.All)
        {
            return currentPath == targetPath;
        }

        if (string.IsNullOrEmpty(targetPath))
        {
            return string.IsNullOrEmpty(currentPath);
        }

        return currentPath == targetPath || currentPath.StartsWith($"{targetPath}/", StringComparison.OrdinalIgnoreCase);
    }

    private string GetSectionCssClass(VisibleNavSection section)
    {
        var isActive = CurrentEntry is not null && section.Definition.Items.Contains(CurrentEntry);
        return isActive ? "nav-cluster nav-cluster--active" : "nav-cluster";
    }

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private void CloseNavMenu()
    {
        collapseNavMenu = true;
    }

    private async Task CloseNavMenuAfterSelection()
    {
        CloseNavMenu();
        await OnMenuItemSelected.InvokeAsync();
    }

    private void ClearSearch()
    {
        searchText = string.Empty;
    }

    private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        collapseNavMenu = true;
        _ = InvokeAsync(StateHasChanged);
    }

    private sealed class VisibleNavSection
    {
        public VisibleNavSection(NavSectionDefinition definition, IReadOnlyList<NavEntryDefinition> items)
        {
            Definition = definition;
            Items = items;
        }

        public NavSectionDefinition Definition { get; }
        public IReadOnlyList<NavEntryDefinition> Items { get; }
    }

    private sealed class NavSectionDefinition
    {
        public NavSectionDefinition(string title, string kicker, string description, string icon, IReadOnlyList<NavEntryDefinition> items)
        {
            Title = title;
            Kicker = kicker;
            Description = description;
            Icon = icon;
            Items = items;
        }

        public string Title { get; }
        public string Kicker { get; }
        public string Description { get; }
        public string Icon { get; }
        public IReadOnlyList<NavEntryDefinition> Items { get; }
    }

    private sealed class NavEntryDefinition
    {
        public NavEntryDefinition(
            string href,
            string label,
            string description,
            string icon,
            string title,
            NavLinkMatch match,
            bool isQuickAccess,
            string? badge,
            params string[] keywords)
        {
            Href = href;
            Label = label;
            Description = description;
            Icon = icon;
            Title = title;
            Match = match;
            IsQuickAccess = isQuickAccess;
            Badge = badge;
            Keywords = keywords ?? Array.Empty<string>();
        }

        public string Href { get; }
        public string Label { get; }
        public string Description { get; }
        public string Icon { get; }
        public string Title { get; }
        public NavLinkMatch Match { get; }
        public bool IsQuickAccess { get; }
        public string? Badge { get; }
        public IReadOnlyList<string> Keywords { get; }
    }
}
