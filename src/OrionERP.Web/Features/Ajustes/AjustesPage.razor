  private async Task SavePlantillaAsync()
  {
    if (isSaving)
    {
      return;
    }

    var validationMessage = ValidateEditor();
    if (validationMessage is not null)
    {
      UiMessages.ShowError(validationMessage);
      return;
    }

    isSaving = true;
    try
    {
      RenumberLines();
      var result = await AjustesService.SavePlantillaAsync(Editor.ToRequest());
      if (!result.Success)
      {
        UiMessages.ShowError(result.Message);
        return;
