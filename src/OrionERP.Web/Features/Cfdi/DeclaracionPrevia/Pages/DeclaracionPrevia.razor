                        <td>@item.UsoCFDI</td>
                        <td>@(item.FechaPago.HasValue? item.FechaPago.Value.ToString("yyyy-MM-dd") : "")</td>
                        <td>@item.Estatus</td>
                        <td>@item.TransaccionVinculada</td>
                        <td>
                            <button class="btn btn-sm btn-outline-info" @onclick="() => OpenRecibidaDetails(item)">Ver</button>
                            <button class="btn btn-sm btn-outline-success" title="Ir a Transacción" @onclick="() => OpenLinkedTransaction(item)">Tx</button>
                        </td>
                    </tr>
                }
            }
        </tbody>
        @if (recibidasTotals != null)
        {
            <tfoot class="table-light">
                <tr>
                    <td colspan="4"><strong># CFDIs:</strong> @recibidasTotals.CountCFDIs</td>
                    <td><strong>Totales:</strong></td>
                    <td>@recibidasTotals.SumSubTotal</td>
                    <td>@recibidasTotals.SumDescuento</td>
                    <td>@recibidasTotals.SumSubTotalDesc</td>
                    <td>@recibidasTotals.SumActos16</td>
                    <td>@recibidasTotals.SumActos0</td>
                    <td>@recibidasTotals.SumIVA</td>
                    <td>@recibidasTotals.SumIEPS</td>
                    <td>@recibidasTotals.SumIVA_RETENIDO</td>
                    <td>@recibidasTotals.SumISR_RETENIDO</td>
                    <td>@recibidasTotals.SumIEPS_RETENIDO</td>
                    <td>@recibidasTotals.SumTotal</td>
                    <td colspan="10"></td>
                </tr>
            </tfoot>
        }
    </table>
</div>
@if (!string.IsNullOrEmpty(impuestosSummary))
{
    <p><strong>Impuestos:</strong> @impuestosSummary</p>
}

@if (recibidasPageCount > 1)
{
    <div>
        Página: @recibidasCurrentPage / @recibidasPageCount
        <button class="btn btn-sm btn-outline-primary" @onclick="PrevRecibidasPage" disabled="@(@recibidasCurrentPage <= 1)">Anterior</button>
        <button class="btn btn-sm btn-outline-primary" @onclick="NextRecibidasPage" disabled="@(@recibidasCurrentPage >= recibidasPageCount)">Siguiente</button>
    </div>
}

<!-- Desfase Section -->
<h4 class="mt-5">Pólizas de este mes que pagan comprobantes de otros meses</h4>
<div class="table-responsive">
    <table class="table table-sm table-bordered">
        <thead class="table-dark">
            <tr>
                <th>ID Comprobante</th>
                <th>Transacción ID</th>
                <th>Fecha Comp.</th>
                <th>Mes Comp.</th>
                <th>Año Comp.</th>
                <th>RFC Emisor</th>
                <th>RFC Receptor</th>
                <th>Monto</th>
                <th>Cuenta Pago</th>
                <th>Fecha Pago (Transacción)</th>
                <th>... <!-- other columns if any --></th>
            </tr>
        </thead>
        <tbody>
            @if (desfase != null)
            {
                @foreach (var item in desfase)
                {
                    <tr>
                        <td>@item.Comprobante_Id</td>
                        <td>@item.Transaccion_Id</td>
                        <td>@item.FechaComprobante?.ToString("yyyy-MM-dd")</td>
                        <td>@item.MesComprobante</td>
                        <td>@item.AnioComprobante</td>
                        <td>@item.RFC_Emisor</td>
                        <td>@item.RFC_Receptor</td>
                        <td>@string.Format("{0:N2}", item.TotalComprobante)</td>
                        <td>@item.CuentaPago</td>
                        <td>@item.FechaTransaccion?.ToString("yyyy-MM-dd")</td>
                        <td>@item.Observaciones</td>
                    </tr>
                }
            }
        </tbody>
        @if (desfaseTotals != null)
        {
            <tfoot class="table-light">
                <tr>
                    <td colspan="3"><strong># CFDIs:</strong> @desfaseTotals.CountCFDIs</td>
                    <td colspan="2"><strong>Total Monto:</strong> @desfaseTotals.SumTotal</td>
                    <td colspan="7"></td>
                </tr>
            </tfoot>
        }
    </table>
</div>

<!-- Polizas No Consolidadas Section -->
<h4 class="mt-5">Pólizas No Consolidadas</h4>
<div class="table-responsive">
    <table class="table table-sm table-bordered">
        <thead class="table-dark">
            <tr>
                <th>ID Transacción</th>
                <th>Fecha</th>
                <th>Concepto</th>
                <th>Monto</th>
                <th>Cuenta</th>
                <th>Tipo Póliza</th>
                <th>Forma Pago</th>
                <th>RFC</th>
                <th>Observaciones</th>
            </tr>
        </thead>
        <tbody>
            @if (polizasNoConsolidadas != null)
            {
                @foreach (var p in polizasNoConsolidadas)
                {
                    <tr>
                        <td><a href="@($"/transacciones/{p.Transaccion_ID}")" target="_blank">@p.Transaccion_ID</a></td>
                        <td>@p.Fecha.ToString("yyyy-MM-dd")</td>
                        <td>@p.Concepto</td>
                        <td>@string.Format("{0:N2}", p.Monto)</td>
                        <td>@p.Cuenta</td>
                        <td>@p.Tipo_Poliza</td>
                        <td>@p.Forma_Pago</td>
                        <td>@p.RFC</td>
                        <td>@p.Observaciones</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<!-- Display messages -->
@if (!string.IsNullOrEmpty(statusMessage))
{
    <div class="alert alert-info">@statusMessage</div>
}
@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

