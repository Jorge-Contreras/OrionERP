  private async Task SaveExtraAsync()
  {
    if (isSavingExtra)
    {
      return;
    }

    var validationMessage = ValidateExtraEditor();
    if (validationMessage is not null)
    {
      UiMessages.ShowError(validationMessage);
      return;
    }

    isSavingExtra = true;
    try
    {
      var result = await AjustesService.SaveExtraCatalogItemAsync(ExtraEditor.ToRequest());
      if (!result.Success)
      {
        UiMessages.ShowError(result.Message);
        return;
      }

      UiMessages.ShowSuccess(result.Message);
      await LoadExtraCatalogAsync();

      if (result.EntityId.HasValue)
      {
        var saved = ExtraCatalogItems.FirstOrDefault(extra => extra.ExtraId == result.EntityId.Value);
        if (saved is not null)
        {
          SelectExtra(saved);
        }
      }
    }
    catch (Exception ex)
    {
      UiMessages.ShowError($"No se pudo guardar el extra. {ex.Message}");
    }
    finally
    {
      isSavingExtra = false;
    }
  }

  private async Task DeleteExtraAsync()
  {
