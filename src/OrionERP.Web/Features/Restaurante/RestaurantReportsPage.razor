@page "/restaurante/reportes"
@attribute [Authorize(Policy = "RestaurantAdmin")]
@using Microsoft.AspNetCore.Components.Authorization
@using OrionERP.Application.Features.Logistica.Shared
@using OrionERP.Application.Features.Restaurante
@using OrionERP.Web.Features.Restaurante.Reports
@using OrionERP.Web.State
@inject IRestaurantCatalogService CatalogService
@inject IRestaurantBackofficeService BackofficeService
@inject IRestaurantAccountingService AccountingService
@inject IRestaurantAnalyticsService AnalyticsService
@inject IRestaurantDiagnosticsService DiagnosticsService
@inject IRestaurantReportWorkbookService WorkbookService
@inject ICurrentCompanyContext RfcState
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime Js

<PageTitle>Restaurante · Reportes contables</PageTitle>

<main class="restaurant-reports">
  <header class="reports-hero">
    <div>
      <span>Operación y contabilidad</span>
      <h1>Reportes por agrupador SAT</h1>
      <p>Cada cifra declara qué códigos agrupadores nivel 1 del Anexo 24 la componen, para poder corregir el registro cuando no corresponda.</p>
    </div>
    <div class="reports-hero__actions">
      <button type="button" class="btn btn-light" disabled="@isBusy" @onclick="LoadAsync">Actualizar</button>
      <button type="button" class="btn btn-light" disabled="@(isBusy || report is null)" @onclick="ExportAsync">Exportar a Excel</button>
    </div>
  </header>

  @if (!string.IsNullOrWhiteSpace(message))
  {
    <div class="alert @(isError ? "alert-danger" : "alert-success")" role="status">@message</div>
  }

  @if (sites.Count == 0)
  {
    <p class="reports-empty">No hay sedes de restaurante configuradas para este RFC.</p>
  }
  else
  {
    <section class="reports-toolbar">
      <label>Sede
        <select @onchange="ChangeSiteAsync">
          @foreach (var site in sites)
          {
            <option value="@site.Id" selected="@(site.Id == selectedSiteId)">@site.Name</option>
          }
        </select>
      </label>
      <label>Desde<input type="date" @bind="from" /></label>
      <label>Hasta<input type="date" @bind="to" /></label>
      <button type="button" class="btn btn-primary" disabled="@isBusy" @onclick="LoadReportAsync">Aplicar</button>
      <div class="reports-toolbar__quick">
        <button type="button" @onclick="() => SetRangeAsync(RangePreset.ThisMonth)">Este mes</button>
        <button type="button" @onclick="() => SetRangeAsync(RangePreset.LastMonth)">Mes anterior</button>
        <button type="button" @onclick="() => SetRangeAsync(RangePreset.Last90)">90 días</button>
        <button type="button" @onclick="() => SetRangeAsync(RangePreset.Year)">Ejercicio</button>
      </div>
    </section>

    <nav class="reports-tabs" role="tablist" aria-label="Secciones del reporte">
      @foreach (var tab in Tabs)
      {
        <button type="button" role="tab" class="@(activeTab == tab.Key ? "is-active" : null)"
                aria-selected="@(activeTab == tab.Key ? "true" : "false")"
                @onclick="() => SelectTab(tab.Key)">
          @tab.Label
          @if (tab.Key == ReportTab.Diagnostico && diagnostic is { Criticos: > 0 })
          {
            <span class="reports-tabs__badge">@diagnostic.Criticos</span>
          }
        </button>
      }
    </nav>

    @if (report is null)
    {
      <p class="reports-empty">Cargando el periodo…</p>
    }
    else
    {
      @if (activeTab == ReportTab.Resumen)
      {
          <section class="report-kpis">
            <article>
              <span>Venta antes de impuesto</span>
              <strong>@report.Summary.VentaNetaPos.ToString("C")</strong>
              <small>@report.Summary.OrdenesPagadas orden(es) · ticket @report.Summary.TicketPromedio.ToString("C")</small>
              <em>Punto de venta</em>
            </article>
            <article class="@(report.Summary.IvaTrasladadoPos > 0 && IvaContable <= 0 ? "is-bad" : null)">
              <span>IVA trasladado</span>
              <strong>@report.Summary.IvaTrasladadoPos.ToString("C")</strong>
              <small>En libros: @IvaContable.ToString("C")</small>
              <ReportAgrupadorBadge Codes="report.Summary.AgrupadoresIva" Missing="IvaContable <= 0" Descriptions="descriptions" />
            </article>
            <article>
              <span>Ingreso registrado</span>
              <strong>@report.Summary.IngresoContable.ToString("C")</strong>
              <small>Diferencia con el POS: @((report.Summary.IngresoContable - report.Summary.VentaNetaPos).ToString("C"))</small>
              <ReportAgrupadorBadge Codes="report.Summary.AgrupadoresIngreso" Descriptions="descriptions" />
            </article>
            <article class="@(FoodCostFueraDeRango ? "is-bad" : null)">
              <span>Costo de alimentos</span>
              <strong>@report.Summary.FoodCostPorcentaje.ToString("0.0")%</strong>
              <small>@report.Summary.CostoRecalculado.ToString("C") recalculado desde receta</small>
              @if (FoodCostFueraDeRango)
              {
                <em>Cifra imposible: hay recetas mal costeadas. Revisa el diagnóstico.</em>
              }
              else
              {
                <em>Margen bruto @report.Summary.MargenBruto.ToString("C")</em>
              }
            </article>
            <article class="@(report.Summary.ResultadoContable < 0 ? "is-bad" : "is-ok")">
              <span>Resultado del periodo</span>
              <strong>@report.Summary.ResultadoContable.ToString("C")</strong>
              <small>Gasto y costo @report.Summary.GastoContable.ToString("C")</small>
              <ReportAgrupadorBadge Codes="report.Summary.AgrupadoresGasto" Descriptions="descriptions" />
            </article>
            <article class="@(report.Reconciliation.OrdenesSinLigar > 0 ? "is-warn" : "is-ok")">
              <span>Órdenes sin póliza</span>
              <strong>@report.Reconciliation.OrdenesSinLigar</strong>
              <small>@report.Reconciliation.OrdenesLigadas ligada(s) de @report.Reconciliation.OrdenesPagadas</small>
              <em>Trazabilidad contable</em>
            </article>
          </section>

          <ReportTrendChart Points="report.DailySeries" AgrupadoresIngreso="report.Summary.AgrupadoresIngreso" />

          <div class="report-grid">
            <ReportBarChart Title="Composición del resultado"
                            Caption="Cada renglón del estado de resultados con los agrupadores que lo suman"
                            Items="ResultBars" Diverging="true" />
            <ReportBarChart Title="Saldos por agrupador nivel 1"
                            Caption="Cargo a la derecha, abono a la izquierda"
                            Items="AgrupadorBars" Diverging="true" />
          </div>

          <ReportBarChart Title="Costo de alimentos por producto"
                          Caption="Costo recalculado sobre precio de lista · verde bajo 35%, ámbar hasta 50%, rojo arriba"
                          Items="FoodCostBars" />
      }
      else if (activeTab == ReportTab.Resultados)
      {
        <ReportPnlTable Pnl="report.Pnl" Descriptions="descriptions"
                        LoadBreakdown="LoadBreakdownAsync" LoadEntries="LoadEntriesAsync" />
      }
      else if (activeTab == ReportTab.Conciliacion)
      {
        <ReportReconciliationPanel Data="report.Reconciliation" Descriptions="descriptions" />
      }
      else if (activeTab == ReportTab.Diagnostico)
      {
        <ReportDiagnosticsPanel Run="diagnostic" History="history" MissingAccounts="missingAccounts"
                                  Backfill="backfill" Descriptions="descriptions" Busy="isBusy"
                                  CanExecuteActions="canExecuteActions"
                                  OnRun="RunDiagnosticAsync" OnCreateAccounts="CreateAccountsAsync"
                                OnBackfill="BackfillPoliciesAsync" OnAccept="AcceptFindingAsync" />
      }
      else if (activeTab == ReportTab.Agrupadores)
      {
        <ReportAgrupadorMappingPanel Map="report.Map" Available="availableAgrupadores" Busy="isBusy"
                                     OnSave="SaveMapRowAsync" OnDelete="DeleteMapRowAsync" OnReset="ResetMapAsync" />
      }
      else if (activeTab == ReportTab.Liquidaciones)
      {
        <section class="settlement-panel">
            <header>
              <div>
                <span>Plataformas y reparto</span>
                <h2>Liquidar contra entrega</h2>
              </div>
              <div>
                <input @bind="settlementCode" placeholder="Código de liquidación" aria-label="Código de liquidación" />
                <button type="button" class="btn btn-primary" disabled="@(selectedOrders.Count == 0 || isBusy)" @onclick="SettleAsync">Liquidar seleccionadas</button>
              </div>
            </header>
            <div class="settlement-candidates">
              @foreach (var candidate in candidates)
              {
                <label class="@(selectedOrders.Contains(candidate.OrderId) ? "is-selected" : null)">
                  <input type="checkbox" checked="@selectedOrders.Contains(candidate.OrderId)" @onchange="() => ToggleCandidate(candidate)" />
                  <span>
                    <strong>@candidate.ProviderName · #@candidate.Folio.ToString("000")</strong>
                    <small>@candidate.OperationalDate.ToString("d") · @candidate.ExternalReference</small>
                  </span>
                  <b>@candidate.GrossAmount.ToString("C")<small>-@candidate.CommissionAmount.ToString("C") comisión</small></b>
                </label>
              }
              @if (candidates.Count == 0)
              {
                <p>No hay órdenes entregadas pendientes de liquidación.</p>
              }
            </div>
            <footer>
              @foreach (var settlement in settlements.Take(12))
              {
                <div>
                  <span><strong>@settlement.SettlementCode</strong> · @settlement.ProviderName</span>
                  <span>@settlement.OrderCount orden(es)</span>
                  <b>@settlement.NetAmount.ToString("C")</b>
                </div>
              }
            </footer>
          </section>

          <section class="settlement-panel accounting-panel">
            <header>
              <div>
                <span>Contabilidad</span>
                <h2>Póliza diaria · @to.ToString("dd MMM yyyy")</h2>
              </div>
              <button type="button" class="btn btn-primary"
                      disabled="@(isBusy || accountingPreview.EligibleOrderCount == 0 || accountingPreview.ExistingTransactionId.HasValue)"
                      @onclick="GeneratePolicyAsync">Generar póliza balanceada</button>
            </header>
            <div class="accounting-preview">
              <div><span>Ventas elegibles</span><strong>@accountingPreview.EligibleOrderCount</strong></div>
              <div><span>Venta neta</span><strong>@accountingPreview.Sales.ToString("C")</strong></div>
              <div><span>IVA</span><strong>@accountingPreview.Tax.ToString("C")</strong></div>
              <div><span>Costo</span><strong>@accountingPreview.Cost.ToString("C")</strong></div>
            </div>
            @if (accountingPreview.ExistingTransactionId.HasValue)
            {
              <p class="accounting-status is-ready">Póliza @accountingPreview.ExistingTransactionId ya generada.</p>
            }
            else if (!accountingPreview.ConfigurationComplete)
            {
              <p class="accounting-status">Faltan cuentas o la generación diaria no está habilitada en Configuración operativa.</p>
            }
            else
            {
              <p class="accounting-status is-ready">Configuración completa. Se excluirán CFDI individuales, propinas, cancelaciones, reembolsos y saldos pendientes.</p>
            }
          </section>
      }
    }
  }
</main>
