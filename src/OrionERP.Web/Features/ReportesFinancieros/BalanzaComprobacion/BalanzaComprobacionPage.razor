@page "/ReportesFinancieros/BalanzaComprobacion"
@page "/reportes-financieros/balanza-comprobacion"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Administrador")]
@using System.Globalization

<PageTitle>Balanza de Comprobación</PageTitle>

<div class="report-page balanza-page">
    <div class="report-page__header">
        <h1 class="report-page__title">Balanza de Comprobación</h1>
    </div>

    <div class="card report-panel report-panel--filters no-print">
        <div class="card-body">
            <div class="report-toolbar">
                <div class="flex-grow-1">
                    <h2 class="report-panel__title">Filtros</h2>
                    <div class="report-panel__subtitle mb-3">
                        Configure el periodo y RFC para generar la balanza.
                    </div>

                    <div class="row g-3">
                        <div class="col-12 col-md-2">
                            <label class="form-label small text-muted">AÑO</label>
                            <select class="form-select"
                                    value="@Anio"
                                    @onchange="OnAnioChanged">
                                @{
                                    var current = DateTime.Now.Year;
                                    for (int y = current - 5; y <= current + 1; y++)
                                    {
                                        <option value="@y">@y</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label small text-muted">MES</label>
                            <select class="form-select"
                                    value="@MesSelectValue"
                                    @onchange="OnMesChanged">
                                <option value="">Anual</option>
                                <option value="1">01 - enero</option>
                                <option value="2">02 - febrero</option>
                                <option value="3">03 - marzo</option>
                                <option value="4">04 - abril</option>
                                <option value="5">05 - mayo</option>
                                <option value="6">06 - junio</option>
                                <option value="7">07 - julio</option>
                                <option value="8">08 - agosto</option>
                                <option value="9">09 - septiembre</option>
                                <option value="10">10 - octubre</option>
                                <option value="11">11 - noviembre</option>
                                <option value="12">12 - diciembre</option>
                            </select>
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label small text-muted">RFC</label>
                            <input class="form-control"
                                   value="@CurrentRfc"
                                   @onchange="async e => await OnRfcChangedFromPicker(e.Value?.ToString())" />
                        </div>
                    </div>
                </div>

                <div class="report-toolbar__actions">
                    <button class="btn btn-primary"
                            @onclick="RefreshAsync"
                            disabled="@IsLoading">
                        Refrescar
                    </button>

                    <button class="btn btn-outline-secondary"
                            @onclick="PrintAsync"
                            disabled="@(!Resultados.Any())">
                        Imprimir
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div id="balanza-comprobacion-print-root" class="card report-panel report-panel--results">
        <div class="card-body">
            <div class="report-toolbar">
                <div>
                    <h2 class="report-panel__title">Resultados</h2>
                    @if (!string.IsNullOrWhiteSpace(CurrentRfc) && !string.IsNullOrWhiteSpace(PeriodoDescripcion))
                    {
                        <div class="report-context">
                            RFC: @CurrentRfc &nbsp;&nbsp; Periodo: @PeriodoDescripcion
                        </div>
                    }
                </div>
            </div>

            @if (IsLoading)
            {
                <div class="text-muted">Cargando...</div>
            }
            else if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="alert alert-danger">@ErrorMessage</div>
            }
            else if (!Resultados.Any())
            {
                <div class="text-muted">No hay datos para los filtros seleccionados.</div>
            }
            else
            {
                var visibleRows = VisibleRows.ToList();

                <div id="balanza-print">
                    <div class="balanza-summary-grid" aria-label="Resumen de la balanza">
                        <div class="balanza-summary-card">
                            <span>Saldo inicial</span>
                            <strong>@FormatMonto(SummarySaldoInicial)</strong>
                        </div>
                        <div class="balanza-summary-card">
                            <span>@DebeMesLabel</span>
                            <strong>@FormatMonto(SummaryDebe)</strong>
                        </div>
                        <div class="balanza-summary-card">
                            <span>@HaberMesLabel</span>
                            <strong>@FormatMonto(SummaryHaber)</strong>
                        </div>
                        <div class="balanza-summary-card">
                            <span>Saldo final</span>
                            <strong>@FormatMonto(SummarySaldoFinal)</strong>
                        </div>
                    </div>

                    <div class="balanza-review-toolbar no-print">
                        <div class="balanza-search-field">
                            <label class="form-label" for="balanza-search">Buscar cuenta</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text" aria-hidden="true">
                                    <i class="bi bi-search"></i>
                                </span>
                                <input id="balanza-search"
                                       class="form-control"
                                       type="search"
                                       placeholder="Código, cuenta o descripción"
                                       @bind-value="SearchText"
                                       @bind-value:event="oninput" />
                                <button class="btn btn-outline-secondary"
                                        type="button"
                                        title="Limpiar búsqueda"
                                        aria-label="Limpiar búsqueda"
                                        disabled="@(!IsSearchActive)"
                                        @onclick="ClearSearch">
                                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                                </button>
                            </div>
                        </div>

                        <div class="balanza-view-controls" aria-label="Profundidad de cuenta">
                            <span class="balanza-view-controls__label">Vista</span>
                            <div class="btn-group btn-group-sm" role="group" aria-label="Seleccionar profundidad visible">
                                <button type="button"
                                        class="@GetHierarchyDepthButtonClass(1)"
                                        disabled="@IsSearchActive"
                                        @onclick="() => SetHierarchyDepth(1)">
                                    Nivel 1
                                </button>
                                <button type="button"
                                        class="@GetHierarchyDepthButtonClass(2)"
                                        disabled="@IsSearchActive"
                                        @onclick="() => SetHierarchyDepth(2)">
                                    Nivel 2
                                </button>
                                <button type="button"
                                        class="@GetHierarchyDepthButtonClass(3)"
                                        disabled="@IsSearchActive"
                                        @onclick="() => SetHierarchyDepth(3)">
                                    Todo
                                </button>
                            </div>
                        </div>

                        <div class="balanza-row-count" aria-live="polite">
                            @visibleRows.Count de @Resultados.Count filas
                        </div>
                    </div>

                    @if (!visibleRows.Any())
                    {
                        <div class="balanza-empty-state">
                            No encontramos cuentas con esa búsqueda.
                        </div>
                    }
                    else
                    {
                    <div class="table-responsive report-table-shell">
                        <table id="balanza-comprobacion-table" class="table table-sm table-bordered align-middle compact-table report-table balanza-table">
                            <thead class="table-light">
                                <tr>
                                    <th class="balanza-table__account-col">CUENTA</th>
                                    <th class="text-end">DEBE ANT.</th>
                                    <th class="text-end">HABER ANT.</th>
                                    <th class="text-end">SALDO INICIAL</th>
                                    <th class="text-end">@DebeMesLabel.ToUpperInvariant()</th>
                                    <th class="text-end">@HaberMesLabel.ToUpperInvariant()</th>
                                    <th class="text-end">@SaldoMesLabel.ToUpperInvariant()</th>
                                    <th class="text-end">SALDO FINAL</th>
                                    <th class="text-center no-print balanza-table__action-col">REG.</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in visibleRows)
                                {
                                    <tr class="@($"{GetRowClass(row)} report-table__row-clickable".Trim())"
                                        @onclick="() => SelectRow(row)"
                                        @ondblclick="() => GoToContabilidadRegistros(row)">
                                        <td class="@($"{GetIndentClass(row)} balanza-table__account-cell".Trim())">
                                            <div class="balanza-account-cell">
                                                @if (HasChildren(row))
                                                {
                                                    <button type="button"
                                                            class="balanza-tree-toggle"
                                                            title="@GetToggleLabel(row)"
                                                            aria-label="@GetToggleLabel(row)"
                                                            aria-expanded="@GetAriaExpanded(row)"
                                                            disabled="@IsSearchActive"
                                                            @onclick="() => ToggleRowExpansion(row)"
                                                            @onclick:stopPropagation="true"
                                                            @ondblclick:stopPropagation="true">
                                                        <i class="@GetToggleIconClass(row)" aria-hidden="true"></i>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <span class="balanza-tree-spacer" aria-hidden="true"></span>
                                                }

                                                <span class="balanza-level-badge">N@(row.NivelJerarquia)</span>
                                                <span class="balanza-account-label">@GetCuentaDisplayName(row)</span>
                                            </div>
                                        </td>
                                        <td class="text-end">@FormatMonto(row.Debe_Ant)</td>
                                        <td class="text-end">@FormatMonto(row.Haber_Ant)</td>
                                        <td class="text-end">@FormatMonto(row.Saldo_Inicial)</td>
                                        <td class="text-end">@FormatMonto(row.Debe_Mes)</td>
                                        <td class="text-end">@FormatMonto(row.Haber_Mes)</td>
                                        <td class="text-end">@FormatMonto(row.Saldo_Mes)</td>
                                        <td class="text-end">@FormatMonto(row.Saldo_Final)</td>
                                        <td class="text-center no-print">
                                            <button type="button"
                                                    class="balanza-open-button"
                                                    title="Abrir registros contables"
                                                    aria-label="@($"Abrir registros contables de {GetCuentaDisplayName(row)}")"
                                                    @onclick="() => GoToContabilidadRegistros(row)"
                                                    @onclick:stopPropagation="true"
                                                    @ondblclick:stopPropagation="true">
                                                <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
