  private static bool IsLocked(KioskCredentialDto item)=>item.LockedUntilUtc is not null&&item.LockedUntilUtc>DateTime.UtcNow;
  private static string CredentialLabel(KioskCredentialDto item)=>!item.IsActive?"Revocada":IsLocked(item)?"Bloqueada":"Activa";
  private static string CredentialCss(KioskCredentialDto item)=>!item.IsActive?"workforce-status--muted":IsLocked(item)?"workforce-status--danger":"";
