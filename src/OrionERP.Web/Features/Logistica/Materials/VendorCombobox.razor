@using Microsoft.AspNetCore.Components.Web
@using OrionERP.Application.Features.Logistica.Shared

<div class="vendor-combobox @(Disabled ? "is-disabled" : null)" @onfocusout="CloseAfterFocusOutAsync">
    <div class="vendor-combobox-input-wrap">
        <i class="bi bi-search" aria-hidden="true"></i>
        <input id="@InputId"
               class="vendor-combobox-input"
               type="search"
               role="combobox"
               autocomplete="off"
               placeholder="@Placeholder"
               value="@SearchText"
               disabled="@Disabled"
               aria-label="@AriaLabel"
               aria-autocomplete="list"
               aria-expanded="@IsOpen"
               aria-controls="@ListboxId"
               @onfocus="Open"
               @oninput="OnInputAsync"
               @onkeydown="OnKeyDownAsync" />
        @if (SelectedId.HasValue || !string.IsNullOrWhiteSpace(SearchText))
        {
            <button class="vendor-combobox-clear"
                    type="button"
                    title="Quitar proveedor"
                    aria-label="Quitar proveedor"
                    disabled="@Disabled"
                    @onclick="ClearAsync">
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
        }
        else
        {
            <i class="bi bi-chevron-down vendor-combobox-chevron" aria-hidden="true"></i>
        }
    </div>

    @if (IsOpen && !Disabled)
    {
        <div id="@ListboxId" class="vendor-combobox-menu" role="listbox" aria-label="Proveedores disponibles">
            @if (FilteredOptions.Count == 0)
            {
                <div class="vendor-combobox-empty">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <span>No encontramos un proveedor con ese nombre o RFC.</span>
                </div>
            }
            else
            {
                @for (var index = 0; index < FilteredOptions.Count; index++)
                {
                    var option = FilteredOptions[index];
                    var isSelected = option.Id == SelectedId;
                    var isHighlighted = index == HighlightedIndex;
                    <button type="button"
                            class="vendor-combobox-option @(isSelected ? "is-selected" : null) @(isHighlighted ? "is-highlighted" : null)"
                            role="option"
                            aria-selected="@isSelected"
                            @onmousedown:preventDefault="true"
                            @onclick="() => SelectAsync(option)">
                        <span class="vendor-combobox-option-icon">
                            <i class="bi bi-building" aria-hidden="true"></i>
                        </span>
                        <span class="vendor-combobox-option-copy">
                            <strong>@option.Name</strong>
                            <small>@(string.IsNullOrWhiteSpace(option.Code) ? "Sin RFC registrado" : option.Code)</small>
                        </span>
                        @if (isSelected)
                        {
                            <i class="bi bi-check2 vendor-combobox-check" aria-hidden="true"></i>
                        }
                    </button>
                }
            }
        </div>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<LookupOptionDto> Options { get; set; } = Array.Empty<LookupOptionDto>();
    [Parameter] public int? SelectedId { get; set; }
    [Parameter] public EventCallback<int?> SelectedIdChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Buscar por nombre o RFC";
    [Parameter] public string AriaLabel { get; set; } = "Buscar proveedor";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public int MaxResults { get; set; } = 10;

    private readonly string InputId = $"vendor-combobox-{Guid.NewGuid():N}";
    private string ListboxId => $"{InputId}-listbox";
    private string SearchText { get; set; } = string.Empty;
    private bool IsOpen { get; set; }
    private int HighlightedIndex { get; set; } = -1;
    private int? LastSynchronizedId { get; set; }

    private IReadOnlyList<LookupOptionDto> FilteredOptions
    {
        get
        {
            var query = SearchText.Trim();
            var selectedLabel = GetSelectedOption()?.Name;
            if (string.Equals(query, selectedLabel, StringComparison.OrdinalIgnoreCase))
            {
                query = string.Empty;
            }

            return Options
                .Where(option =>
                    string.IsNullOrWhiteSpace(query)
                    || option.Name.Contains(query, StringComparison.OrdinalIgnoreCase)
                    || (!string.IsNullOrWhiteSpace(option.Code) && option.Code.Contains(query, StringComparison.OrdinalIgnoreCase)))
                .OrderByDescending(option => option.Id == SelectedId)
                .ThenBy(option => option.Name)
                .Take(Math.Max(MaxResults, 1))
                .ToList();
        }
    }

    protected override void OnParametersSet()
    {
        if (LastSynchronizedId == SelectedId)
        {
            return;
        }

        LastSynchronizedId = SelectedId;
        SearchText = GetSelectedOption()?.Name ?? string.Empty;
    }

    private void Open()
    {
        IsOpen = true;
        HighlightedIndex = -1;
    }

    private Task OnInputAsync(ChangeEventArgs args)
    {
        SearchText = args.Value?.ToString() ?? string.Empty;
        IsOpen = true;
        HighlightedIndex = -1;
        return Task.CompletedTask;
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs args)
    {
        if (!IsOpen && args.Key is "ArrowDown" or "ArrowUp")
        {
            Open();
            return;
        }

        var options = FilteredOptions;
        if (args.Key == "ArrowDown" && options.Count > 0)
        {
            HighlightedIndex = Math.Min(HighlightedIndex + 1, options.Count - 1);
        }
        else if (args.Key == "ArrowUp" && options.Count > 0)
        {
            HighlightedIndex = HighlightedIndex <= 0 ? options.Count - 1 : HighlightedIndex - 1;
        }
        else if (args.Key == "Enter" && HighlightedIndex >= 0 && HighlightedIndex < options.Count)
        {
            await SelectAsync(options[HighlightedIndex]);
        }
        else if (args.Key == "Escape")
        {
            IsOpen = false;
            SearchText = GetSelectedOption()?.Name ?? string.Empty;
        }
    }

    private async Task SelectAsync(LookupOptionDto option)
    {
        LastSynchronizedId = option.Id;
        SearchText = option.Name;
        IsOpen = false;
        HighlightedIndex = -1;
        await SelectedIdChanged.InvokeAsync(option.Id);
    }

    private async Task ClearAsync()
    {
        LastSynchronizedId = null;
        SearchText = string.Empty;
        IsOpen = true;
        HighlightedIndex = -1;
        await SelectedIdChanged.InvokeAsync(null);
    }

    private async Task CloseAfterFocusOutAsync()
    {
        await Task.Delay(120);
        IsOpen = false;
        HighlightedIndex = -1;
        SearchText = GetSelectedOption()?.Name ?? string.Empty;
        await InvokeAsync(StateHasChanged);
    }

    private LookupOptionDto? GetSelectedOption()
        => SelectedId.HasValue
            ? Options.FirstOrDefault(option => option.Id == SelectedId.Value)
            : null;
}
