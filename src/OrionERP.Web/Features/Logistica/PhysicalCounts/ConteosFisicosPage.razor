@page "/logistica/conteos"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using OrionERP.Application.Features.Logistica.PhysicalCounts
@attribute [Authorize(Roles = "Administrador,Conteo")]

<PageTitle>Logística · Conteos físicos</PageTitle>

<div class="container-fluid py-3 conteos-page">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h1 class="h3 mb-1">Conteos físicos</h1>
            <p class="text-muted mb-0">Sesiones de conteo con captura por línea, adjuntos opcionales y contabilización aprobada.</p>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-12 col-xxl-4">
            <section class="card shadow-sm mb-3">
                <div class="card-body">
                    <h2 class="h5 mb-3">Nueva sesión</h2>
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label">Ubicación</label>
                            <select class="form-select" @bind="SessionCreateRequest.LocationId">
                                <option value="0">Selecciona una ubicación</option>
                                @foreach (var option in LocationOptions)
                                {
                                    <option value="@option.Id">@option.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Notas</label>
                            <InputTextArea class="form-control" rows="3" @bind-Value="SessionCreateRequest.Notes" />
                        </div>
                    </div>

                    <button class="btn btn-primary mt-3" type="button" @onclick="CrearSesionAsync" disabled="@IsCreatingSession">
                        @(IsCreatingSession ? "Creando..." : "Crear sesión")
                    </button>
                </div>
            </section>

            <section class="@GetSessionsSectionClass()">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h2 class="h5 mb-0">Sesiones</h2>
                        <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="CargarSesionesAsync" disabled="@IsLoadingSessions">
                            @(IsLoadingSessions ? "Actualizando..." : "Actualizar")
                        </button>
                    </div>

                    <div class="form-check mb-3">
                        <InputCheckbox id="conteos-mostrar-contabilizadas" class="form-check-input" @bind-Value="ShowPostedSessions" />
                        <label class="form-check-label" for="conteos-mostrar-contabilizadas">Mostrar contabilizadas/canceladas</label>
                    </div>

                    <div class="table-responsive conteos-sessions-scroll">
                        @{
                            var visibleSessions = VisibleSessions;
                        }
                        <table class="table table-sm table-hover align-middle conteos-sessions-table">
                            <thead class="table-light">
                                <tr>
                                    <th>Sesión</th>
                                    <th class="conteos-location-col">Ubicación</th>
                                    <th class="text-end conteos-count-col">Líneas</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (visibleSessions.Count == 0)
                                {
                                    <tr>
                                        <td colspan="3" class="text-center text-muted py-3">@(Sessions.Count == 0 ? "Aún no hay sesiones." : "No hay sesiones para el filtro actual.")</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var item in visibleSessions)
                                    {
                                        <tr class="@GetSessionRowClass(item)" style="cursor: pointer;" @onclick="() => SeleccionarSesionAsync(item.Id)">
                                            <td data-label="Sesión">
                                                <div class="fw-semibold">@item.SessionCode</div>
                                                <span class="@GetSessionStatusBadgeClass(item.Status)">@GetSessionStatusLabel(item.Status)</span>
                                            </td>
                                            <td data-label="Ubicación" class="conteos-location-col">
                                                <div class="conteos-cell-stack">
                                                    <div class="conteos-cell-primary">@item.LocationName</div>
                                                    <div class="conteos-cell-secondary">@(string.IsNullOrWhiteSpace(item.RoomName) ? "Sin room" : item.RoomName)</div>
                                                </div>
                                            </td>
                                            <td data-label="Líneas" class="text-end conteos-count-col">
                                                <div>@item.LineCount</div>
                                                <small class="text-muted">@item.VarianceLineCount variaciones</small>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>
        </div>

        <div class="col-12 col-xxl-8">
            @if (SelectedSession is null)
            {
                <section class="card shadow-sm">
                    <div class="card-body text-center text-muted py-5">
                        Selecciona una sesión para capturar líneas, adjuntar archivos opcionales y contabilizar.
                    </div>
                </section>
            }
            else
            {
                <section class="card shadow-sm mb-3 conteos-session-card">
                    <div class="card-body">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                            <div>
                                <h2 class="h4 mb-1">@SelectedSession.SessionCode</h2>
                                <div class="conteos-session-location">@SelectedSession.LocationName</div>
                                <div class="mt-2">
                                    <span class="@SelectedSessionStatusBadgeClass">@SelectedSessionStatusLabel</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(SelectedSession.RoomName))
                                {
                                    <div class="conteos-session-room text-muted">@SelectedSession.RoomName</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(SelectedSession.Notes))
                                {
                                    <div class="small text-muted mt-1">@SelectedSession.Notes</div>
                                }
                            </div>
                            <div class="d-flex flex-wrap gap-2 conteos-session-actions">
                                <button class="btn btn-outline-secondary conteos-session-action d-md-none" type="button" @onclick="MostrarSesionesAsync">
                                    Cambiar sesión
                                </button>
                                @if (CanCancel)
                                {
                                    <button class="btn btn-outline-danger conteos-session-action" type="button" @onclick="CancelarSesionAsync" disabled="@IsMutatingSession">
                                        @(IsCancelingSession ? "Cancelando..." : "Cancelar conteo")
                                    </button>
                                }
                                <button class="btn btn-outline-primary conteos-session-action" type="button" @onclick="EnviarSesionAsync" disabled="@(!CanSubmit || IsMutatingSession)">Enviar</button>
                                @if (IsAdministrator)
                                {
                                    <button class="btn btn-outline-warning conteos-session-action" type="button" @onclick="AbrirReconteo" disabled="@(!CanRequestRecount || IsMutatingSession)">Reconteo</button>
                                    <button class="btn btn-outline-success conteos-session-action" type="button" @onclick="AprobarSesionAsync" disabled="@(!CanApprove || IsMutatingSession)">Aprobar</button>
                                    <button class="btn btn-success conteos-session-action" type="button" @onclick="ContabilizarSesionAsync" disabled="@(!CanPost || IsMutatingSession)">Contabilizar</button>
                                }
                            </div>
                        </div>

                        <div class="conteos-lines-tip">
                            Revisa la unidad de conteo de cada material antes de capturar.
                        </div>

                        <div class="table-responsive conteos-lines-scroll">
                            <table class="table table-sm table-hover align-middle conteos-lines-table">
                                <thead class="table-light">
                                    <tr>
                                        <th class="conteos-line-image-col">Foto</th>
                                        <th class="conteos-material-col">Material</th>
                                        <th class="text-end conteos-quantity-col">Esperado</th>
                                        <th class="text-end conteos-quantity-col">Contado</th>
                                        <th class="text-end conteos-quantity-col">Varianza</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var line in SelectedSession.Lines)
                                    {
                                        var thumbnailDataUrl = GetMaterialThumbnailDataUrl(line.MaterialId);
                                        var materialTitle = string.IsNullOrWhiteSpace(line.MaterialDescription) ? line.MaterialCode : line.MaterialDescription;
                                        var showMaterialCode = !string.IsNullOrWhiteSpace(line.MaterialCode) && !string.Equals(line.MaterialCode, materialTitle, StringComparison.OrdinalIgnoreCase);
                                        var lineUnitLabel = GetCountUnitLabel(line.BaseUnitName);
                                        var capturedByCurrentUser = IsLineCapturedByCurrentUser(line);
                                        var isSelectedLine = IsSelectedLine(line);
                                        var showInlineCountEditor = isSelectedLine && CanCaptureLine;
                                        <tr class="@GetLineRowClass(line)" style="cursor: pointer;" @onclick="() => SeleccionarLinea(line)">
                                            <td data-label="Foto" class="conteos-line-image-col">
                                                @if (thumbnailDataUrl is not null)
                                                {
                                                    <button class="conteos-line-image-button" type="button" title="Ver imagen" aria-label="Ver imagen del material" @onclick="() => AbrirImagenMaterialAsync(line)" @onclick:stopPropagation="true">
                                                        <img src="@thumbnailDataUrl" alt="Imagen de @materialTitle" class="conteos-line-image" />
                                                    </button>
                                                }
                                                else
                                                {
                                                    <div class="conteos-line-image-placeholder">Sin foto</div>
                                                }
                                            </td>
                                            <td data-label="Material" class="conteos-material-col">
                                                <div class="conteos-cell-stack">
                                                    <div class="conteos-cell-primary">@materialTitle</div>
                                                    @if (showMaterialCode)
                                                    {
                                                        <div class="conteos-cell-secondary">@line.MaterialCode</div>
                                                    }
                                                    <div class="conteos-line-unit">
                                                        <span class="@GetCountUnitBadgeClass(line.BaseUnitName)">Contar en @lineUnitLabel</span>
                                                    </div>
                                                    @if (line.CapturedAt.HasValue)
                                                    {
                                                        <div class="conteos-line-captured-at">@FormatLineCapturedSummary(line)</div>
                                                    }
                                                    @if (capturedByCurrentUser)
                                                    {
                                                        <div class="conteos-line-user-indicator">
                                                            <span class="conteos-line-user-badge">Capturado por ti</span>
                                                        </div>
                                                    }
                                                    @if (HasRecountIssue(line))
                                                    {
                                                        <div class="conteos-line-recount-note">
                                                            <span class="conteos-line-recount-badge">@GetRecountIssueLabel(line.RecountIssueCode)</span>
                                                            @if (!string.IsNullOrWhiteSpace(line.RecountReason))
                                                            {
                                                                <span>@line.RecountReason</span>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            </td>
                                            <td data-label="@(GetQuantityFieldLabel("Esperado", line.BaseUnitName))" class="text-end conteos-quantity-col">@line.ExpectedQuantity.ToString("N2")</td>
                                            <td data-label="@(GetQuantityFieldLabel("Contado", line.BaseUnitName))" class="text-end conteos-quantity-col">
                                                @if (showInlineCountEditor)
                                                {
                                                    <div class="conteos-inline-count-editor d-md-none" @onclick:stopPropagation="true">
                                                        <input class="form-control conteos-counted-input conteos-inline-counted-input"
                                                               type="text"
                                                               inputmode="decimal"
                                                               enterkeyhint="done"
                                                               autocomplete="off"
                                                               spellcheck="false"
                                                               aria-label="@(GetQuantityFieldLabel("Contado", line.BaseUnitName))"
                                                               title="@($"Captura la cantidad en {lineUnitLabel}")"
                                                               value="@CountedQuantityInput"
                                                               @oninput="OnCountedQuantityInput"
                                                               @onblur="OnCountedQuantityBlur"
                                                               @onfocus="() => SelectCountedQuantityAsync()"
                                                               @onclick="() => SelectCountedQuantityAsync()"
                                                               @onkeydown="HandleMobileCountedQuantityKeyDownAsync"
                                                               @onclick:stopPropagation="true"
                                                               @ref="MobileCountedQuantityInputRef" />
                                                        <button class="btn btn-primary conteos-inline-save-button"
                                                                type="button"
                                                                @onclick="GuardarLineaMovilAsync"
                                                                @onclick:stopPropagation="true"
                                                                disabled="@(!CanCaptureLine || IsSavingLine)">
                                                            @(IsSavingLine ? "Guardando..." : "Guardar")
                                                        </button>
                                                    </div>
                                                    <div class="d-none d-md-block">@FormatOptionalQuantity(line.CountedQuantity)</div>
                                                }
                                                else
                                                {
                                                    @FormatOptionalQuantity(line.CountedQuantity)
                                                }
                                            </td>
                                            <td data-label="@(GetQuantityFieldLabel("Varianza", line.BaseUnitName))" class="text-end conteos-quantity-col">
                                                @if (line.VarianceQuantity.HasValue && line.VarianceQuantity.Value != 0)
                                                {
                                                    <span class="badge text-bg-warning">@line.VarianceQuantity.Value.ToString("N2")</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">0.00</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>

                @if (SelectedLine is not null)
                {
                    <section class="card shadow-sm conteos-capture-card">
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-12 col-xl-6">
                                    <h3 class="h5 mb-3">Captura de línea</h3>
                                    @{
                                        var selectedMaterialTitle = string.IsNullOrWhiteSpace(SelectedLine.MaterialDescription) ? SelectedLine.MaterialCode : SelectedLine.MaterialDescription;
                                        var showSelectedMaterialCode = !string.IsNullOrWhiteSpace(SelectedLine.MaterialCode) && !string.Equals(SelectedLine.MaterialCode, selectedMaterialTitle, StringComparison.OrdinalIgnoreCase);
                                        var selectedLineUnitLabel = GetCountUnitLabel(SelectedLine.BaseUnitName);
                                    }
                                    <div class="conteos-selected-line-summary mb-3">
                                        <div class="conteos-selected-line-title">@selectedMaterialTitle</div>
                                        @if (showSelectedMaterialCode)
                                        {
                                            <div class="conteos-selected-line-subtitle">@SelectedLine.MaterialCode</div>
                                        }
                                        <div class="conteos-selected-line-unit">
                                            <span class="@GetCountUnitBadgeClass(SelectedLine.BaseUnitName)">Contar en @selectedLineUnitLabel</span>
                                        </div>
                                        @if (SelectedLine.CapturedAt.HasValue)
                                        {
                                            <div class="conteos-selected-line-captured-at">@FormatLineCapturedSummary(SelectedLine)</div>
                                        }
                                        @if (HasRecountIssue(SelectedLine))
                                        {
                                            <div class="conteos-selected-line-recount mt-2">
                                                <span class="conteos-line-recount-badge">@GetRecountIssueLabel(SelectedLine.RecountIssueCode)</span>
                                                @if (!string.IsNullOrWhiteSpace(SelectedLine.RecountReason))
                                                {
                                                    <span>@SelectedLine.RecountReason</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                    <div class="row g-3 conteos-capture-form">
                                        <div class="col-6 col-md-4">
                                            <label class="form-label">@GetQuantityFieldLabel("Esperado", SelectedLine.BaseUnitName)</label>
                                            <input class="form-control" type="text" value="@SelectedLine.ExpectedQuantity.ToString("N2")" disabled />
                                        </div>
                                        <div class="d-none d-md-block col-md-4">
                                            <label class="form-label">@GetQuantityFieldLabel("Contado", SelectedLine.BaseUnitName)</label>
                                            <input class="form-control form-control-lg conteos-counted-input"
                                                   type="text"
                                                   inputmode="decimal"
                                                   enterkeyhint="done"
                                                   autocomplete="off"
                                                   spellcheck="false"
                                                   aria-label="@(GetQuantityFieldLabel("Contado", SelectedLine.BaseUnitName))"
                                                   title="@($"Captura la cantidad en {selectedLineUnitLabel}")"
                                                   value="@CountedQuantityInput"
                                                   @oninput="OnCountedQuantityInput"
                                                   @onblur="OnCountedQuantityBlur"
                                                   @onfocus="() => SelectCountedQuantityAsync()"
                                                   @onclick="() => SelectCountedQuantityAsync()"
                                                   @onkeydown="HandleCountedQuantityKeyDownAsync"
                                                   @ref="CountedQuantityInputRef" />
                                        </div>
                                         <div class="col-12 col-md-4">
                                            <label class="form-label">@GetQuantityFieldLabel("Varianza", SelectedLine.BaseUnitName)</label>
                                             <input class="form-control" type="text" value="@CurrentVarianceText" disabled />
                                         </div>
                                         @if (SelectedLine.Lots.Count > 0)
                                         {
                                             <div class="col-12">
                                                 <div class="alert alert-info py-2 mb-2">Este material se controla por lote. La suma de lotes debe coincidir con el total contado.</div>
                                                 <div class="row g-2">
                                                     @foreach (var lot in SelectedLine.Lots)
                                                     {
                                                         var captureLot = LineCapture.Lots.Single(item => item.MaterialLotId == lot.MaterialLotId);
                                                         <div class="col-12 col-md-6">
                                                             <label class="form-label">Lote @lot.LotCode · esperado @lot.ExpectedQuantity.ToString("N2")@if (lot.ExpiresAt.HasValue) { <span> · vence @lot.ExpiresAt.Value.ToString("d")</span> }</label>
                                                             <InputNumber class="form-control" min="0" step="0.0001" @bind-Value="captureLot.CountedQuantity" @bind-Value:after="UpdateTotalFromLots" />
                                                         </div>
                                                     }
                                                 </div>
                                             </div>
                                         }
                                         <div class="col-md-6">
                                            <div class="form-check mt-2 conteos-toggle-card">
                                                <InputCheckbox class="form-check-input" @bind-Value="LineCapture.IsMissing" />
                                                <label class="form-check-label">Faltante</label>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-check mt-2 conteos-toggle-card">
                                                <InputCheckbox class="form-check-input" @bind-Value="LineCapture.IsDamaged" />
                                                <label class="form-check-label">Dañado</label>
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label">Notas</label>
                                            <InputTextArea class="form-control" rows="3" @bind-Value="LineCapture.Notes" />
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label">Evidencia opcional</label>
                                            <InputFile class="form-control" OnChange="OnLineAttachmentSelectedAsync" />
                                            @if (!string.IsNullOrWhiteSpace(PendingLineAttachmentName))
                                            {
                                                <div class="form-text">@PendingLineAttachmentName</div>
                                            }
                                        </div>
                                    </div>
                                    <button class="btn btn-primary mt-3 conteos-save-button d-md-none" type="button" @onclick="GuardarLineaMovilAsync" disabled="@(!CanCaptureLine || IsSavingLine)">
                                        @(IsSavingLine ? "Guardando..." : "Guardar línea")
                                    </button>
                                    <button class="btn btn-primary mt-3 conteos-save-button d-none d-md-inline-block" type="button" @onclick="GuardarLineaAsync" disabled="@(!CanCaptureLine || IsSavingLine)">
                                        @(IsSavingLine ? "Guardando..." : "Guardar línea")
                                    </button>
                                </div>

                                <div class="col-12 col-xl-6">
                                    <h3 class="h5 mb-3">Evidencias capturadas</h3>
                                    <div class="table-responsive conteos-evidence-scroll">
                                        <table class="table table-sm">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Archivo</th>
                                                    <th>Descripción</th>
                                                    <th></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (SelectedLine.Attachments.Count == 0)
                                                {
                                                    <tr>
                                                        <td colspan="3" class="text-center text-muted py-3">Sin evidencia.</td>
                                                    </tr>
                                                }
                                                else
                                                {
                                                    @foreach (var attachment in SelectedLine.Attachments)
                                                    {
                                                        <tr>
                                                            <td>@attachment.FileName</td>
                                                            <td>@attachment.Description</td>
                                                            <td class="text-end">
                                                                <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="() => DescargarEvidenciaAsync(attachment.Id)">
                                                                    Descargar
                                                                </button>
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                }
            }
        </div>
    </div>
</div>

@if (ShowCancelModal && SelectedSession is not null)
{
    <div class="modal fade show d-block conteos-modal-backdrop" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Cancelar @SelectedSession.SessionCode</h5>
                    <button type="button" class="btn-close" aria-label="Cerrar" @onclick="CerrarCancelacion"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label">Razón</label>
                    <InputTextArea class="form-control" rows="4" @bind-Value="CancelReason" />
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" type="button" @onclick="CerrarCancelacion" disabled="@IsCancelingSession">Cerrar</button>
                    <button class="btn btn-danger" type="button" @onclick="ConfirmarCancelacionAsync" disabled="@IsCancelingSession">
                        @(IsCancelingSession ? "Cancelando..." : "Cancelar conteo")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (ShowRecountModal && SelectedSession is not null)
{
    <div class="modal fade show d-block conteos-modal-backdrop" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Plan de reconteo · @SelectedSession.SessionCode</h5>
                    <button type="button" class="btn-close" aria-label="Cerrar" @onclick="CerrarReconteo"></button>
                </div>
                <div class="modal-body">
                    <div class="table-responsive conteos-recount-scroll">
                        <table class="table table-sm align-middle conteos-recount-table">
                            <thead class="table-light">
                                <tr>
                                    <th class="conteos-recount-select-col">Recontar</th>
                                    <th>Material</th>
                                    <th class="text-end">Esperado</th>
                                    <th class="text-end">Contado</th>
                                    <th>Incidencia</th>
                                    <th>Razón</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var line in RecountPlanLines)
                                {
                                    <tr class="@(line.IsSelected ? "table-warning" : string.Empty)">
                                        <td data-label="Recontar" class="conteos-recount-select-col">
                                            <InputCheckbox class="form-check-input" @bind-Value="line.IsSelected" />
                                        </td>
                                        <td data-label="Material">
                                            <div class="conteos-cell-stack">
                                                <div class="conteos-cell-primary">@line.MaterialDescription</div>
                                                @if (!string.IsNullOrWhiteSpace(line.MaterialCode) && !string.Equals(line.MaterialCode, line.MaterialDescription, StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <div class="conteos-cell-secondary">@line.MaterialCode</div>
                                                }
                                            </div>
                                        </td>
                                        <td data-label="Esperado" class="text-end">@line.ExpectedQuantity.ToString("N2")</td>
                                        <td data-label="Contado" class="text-end">@FormatOptionalQuantity(line.CountedQuantity)</td>
                                        <td data-label="Incidencia">
                                            <select class="form-select form-select-sm" @bind="line.IssueCode" disabled="@(!line.IsSelected)">
                                                <option value="@PhysicalCountRecountIssueCodes.QuantityMismatch">@GetRecountIssueLabel(PhysicalCountRecountIssueCodes.QuantityMismatch)</option>
                                                <option value="@PhysicalCountRecountIssueCodes.UnitIssue">@GetRecountIssueLabel(PhysicalCountRecountIssueCodes.UnitIssue)</option>
                                                <option value="@PhysicalCountRecountIssueCodes.WrongMaterial">@GetRecountIssueLabel(PhysicalCountRecountIssueCodes.WrongMaterial)</option>
                                                <option value="@PhysicalCountRecountIssueCodes.EvidenceMissing">@GetRecountIssueLabel(PhysicalCountRecountIssueCodes.EvidenceMissing)</option>
                                                <option value="@PhysicalCountRecountIssueCodes.ConditionIssue">@GetRecountIssueLabel(PhysicalCountRecountIssueCodes.ConditionIssue)</option>
                                                <option value="@PhysicalCountRecountIssueCodes.Other">@GetRecountIssueLabel(PhysicalCountRecountIssueCodes.Other)</option>
                                            </select>
                                        </td>
                                        <td data-label="Razón">
                                            <InputTextArea class="form-control form-control-sm conteos-recount-reason"
                                                           rows="2"
                                                           disabled="@(!line.IsSelected)"
                                                           @bind-Value="line.Reason" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" type="button" @onclick="CerrarReconteo" disabled="@IsRequestingRecount">Cerrar</button>
                    <button class="btn btn-warning" type="button" @onclick="EnviarAReconteoAsync" disabled="@IsRequestingRecount">
                        @(IsRequestingRecount ? "Enviando..." : "Enviar a reconteo")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (ShowMaterialImageModal)
{
    <div class="modal fade show d-block conteos-image-modal-backdrop" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(string.IsNullOrWhiteSpace(MaterialImageModalTitle) ? "Imagen del material" : MaterialImageModalTitle)</h5>
                    <button type="button" class="btn-close" aria-label="Cerrar" @onclick="CloseMaterialImageModal"></button>
                </div>
                <div class="modal-body text-center">
                    @if (MaterialImageModalDataUrl is not null)
                    {
                        <img src="@MaterialImageModalDataUrl" alt="Vista ampliada del material" class="conteos-image-modal-preview" />
                    }
                    else if (IsLoadingMaterialImage)
                    {
                        <div class="py-5 text-muted">Cargando imagen...</div>
                    }
                    else
                    {
                        <div class="py-5 text-muted">Sin imagen disponible.</div>
                    }

                    @if (IsLoadingMaterialImage && MaterialImageModalDataUrl is not null)
                    {
                        <div class="small text-muted mt-3">Cargando la imagen completa...</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" type="button" @onclick="CloseMaterialImageModal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}
