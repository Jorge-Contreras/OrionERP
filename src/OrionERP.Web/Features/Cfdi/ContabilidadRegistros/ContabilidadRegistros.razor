@page "/cfdi/registros-contables"
@using OrionERP.Application.Features.Cfdi.ContabilidadRegistros
@using OrionERP.Web.State
@inject IContabilidadRegistrosService RegistrosService
@inject NavigationManager Navigation
@inject IUserRfcState RfcState
@attribute [Authorize(Roles = "Administrador,SatOperator")]

<h3>Contabilidad &mdash; Registros</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
  <div class="alert alert-danger" role="alert">
    @errorMessage
  </div>
}

<div class="card p-3 mb-3">
  <div class="row g-3 align-items-end">
    <div class="col-md-4">
      <label class="form-label">RFC (Razón Social)</label>
            <RfcPicker @bind-SelectedRfc="selectedRfc" @bind-SelectedRfc:after="OnRfcChangedAsync" />
    </div>
    <div class="col-md-3">
      <label class="form-label">Fecha inicio</label>
      <input class="form-control" type="date" @bind="startDate" />
    </div>
    <div class="col-md-3">
      <label class="form-label">Fecha fin</label>
      <input class="form-control" type="date" @bind="endDate" />
    </div>
    <div class="col-md-2">
      <label class="form-label">Cuenta #</label>
      <input class="form-control" type="number" min="1" @bind="directAccountId" @onkeyup="OnDirectAccountKeyDown" />
    </div>
  </div>

  <div class="mt-3">
    <CuentasContablesPicker @ref="cuentasPicker"
                            Rfc="selectedRfc"
                            RfcChanged="OnPickerRfcChangedAsync"
                            Selection="accountSelection"
                            SelectionChanged="OnAccountSelectionChangedAsync"
                            OnError="OnAccountPickerError" />
  </div>

  <div class="mt-3 d-flex flex-wrap align-items-center gap-2">
    @if (HasAccountSelection)
    {
      <span class="badge text-bg-primary">Nivel1: @accountSelection?.Nivel1</span>
      <span class="badge text-bg-primary">Nivel2: @accountSelection?.Nivel2</span>
      @if (!string.IsNullOrWhiteSpace(accountSelection?.Nivel3))
      {
        <span class="badge text-bg-primary">Nivel3: @accountSelection?.Nivel3</span>
      }
      @if (!string.IsNullOrWhiteSpace(accountSelection?.Descripcion))
      {
        <span class="badge text-bg-info text-wrap">@accountSelection?.Descripcion</span>
      }
    }
    <button class="btn btn-primary ms-auto" @onclick="OnBuscarClickedAsync" disabled="@(!CanBuscar)">Buscar</button>
  </div>
</div>

<div class="card p-3">
  @if (isLoading)
  {
    <span class="orion-loading" role="status" aria-live="polite">
      <span class="orion-spinner" aria-hidden="true"></span>
      <span class="orion-strong">Trabajando…</span>
    </span>
  }
  else if (registros.Any())
  {
        <div class="table-responsive table-scroll">
            <table class="table table-sm table-bordered table-striped align-middle compact-table">
        <thead class="table-dark">
          <tr>
            <th>Id</th>
            <th>Poliza</th>
                        <th>Ver Poliza</th>
            <th>Fecha</th>
            <th>Cuenta</th>
            <th>Nombre_Cuenta</th>
            <th>Concepto</th>
            <th>Debe</th>
            <th>Haber</th>
            <th>Balance</th>
            <th>Revisado</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          @foreach (var row in registros)
          {
            <tr>
              <td>@row.Id</td>
                            <td>@row.Poliza</td>
              <td>
              <button class="btn btn-link btn-sm" type="button" @onclick="() => GoToPoliza(row.Poliza)">Ver póliza</button>
              </td>
              <td>@row.Fecha</td>
              <td>@row.Cuenta</td>
              <td>@row.Nombre_Cuenta</td>
              <td>@row.Concepto</td>
              <td>@row.Debe</td>
              <td>@row.Haber</td>
              <td>@row.Balance</td>
              
              <td>@row.Revisado</td>
              
            </tr>
          }
        </tbody>
      </table>
    </div>
  }
  else if (hasSearched)
  {
    <div class="alert alert-info mb-0">Sin resultados</div>
  }
</div>

@code {
  private string? selectedRfc;
  private DateTime startDate = new DateTime(DateTime.Today.Year, 1, 1);
  private DateTime endDate = DateTime.Today;
  private int? directAccountId;
  private CuentasContablesPicker? cuentasPicker;
  private CuentasContablesSelection? accountSelection;
  private readonly List<RegistrosContablesRow> registros = new();
  private bool hasSearched;
  private bool isLoading;
  private string? errorMessage;
  private bool suppressRfcChange;

  private bool HasAccountSelection
    => accountSelection is { Nivel1: { Length: > 0 }, Nivel2: { Length: > 0 } };

  private bool HasCompleteAccount
    => HasAccountSelection && !string.IsNullOrWhiteSpace(accountSelection?.Nivel3);

  private bool CanBuscar
    => HasAccountSelection && !string.IsNullOrWhiteSpace(selectedRfc);

  protected override Task OnInitializedAsync()
  {
    selectedRfc = RfcState.CurrentRfc;
    if (string.IsNullOrWhiteSpace(selectedRfc))
    {
      RfcState.ResetToDefault();
      selectedRfc = RfcState.CurrentRfc;
    }

    // The picker will load the default cuentas when the RFC is available.
    return Task.CompletedTask;
  }

  private async Task OnRfcChangedAsync()
  {
    if (suppressRfcChange)
    {
      suppressRfcChange = false;
      return;
    }

    await ClearAccountSelectionAsync();
    registros.Clear();
    hasSearched = false;
  }

  private async Task OnDirectAccountKeyDown(KeyboardEventArgs args)
  {
    if (args.Key == "Enter")
    {
      var resolved = await ResolveDirectAccountAsync();
      if (resolved && CanBuscar)
      {
        await BuscarAsync();
      }
    }
  }

  private async Task OnBuscarClickedAsync()
  {
    if (!HasCompleteAccount && directAccountId.HasValue)
    {
      var resolved = await ResolveDirectAccountAsync();
      if (!resolved)
      {
        return;
      }
    }

    if (!CanBuscar)
    {
      return;
    }

    await BuscarAsync();
  }

  private async Task<bool> ResolveDirectAccountAsync()
  {
    if (directAccountId is null || cuentasPicker is null)
    {
      return false;
    }

    return await cuentasPicker.ResolveAccountByIdAsync(directAccountId.Value);
  }

  private async Task BuscarAsync()
  {
    if (!CanBuscar)
    {
      return;
    }

    isLoading = true;
    errorMessage = null;
    hasSearched = true;

    try
    {
      var nivel3 = string.IsNullOrWhiteSpace(accountSelection?.Nivel3) ? "00" : accountSelection!.Nivel3!;
      var items = await RegistrosService.GetRegistrosAsync(
        startDate,
        endDate,
        selectedRfc!,
        accountSelection!.Nivel1!,
        accountSelection!.Nivel2!,
        nivel3);
      registros.Clear();
      registros.AddRange(items);
    }
    catch (Exception ex)
    {
      registros.Clear();
      ReportError("No se pudo cargar información", ex);
    }
    finally
    {
      isLoading = false;
    }
  }

  private async Task SetRfcAsync(string razonSocial)
  {
    if (string.IsNullOrWhiteSpace(razonSocial))
    {
      return;
    }

    if (!string.Equals(selectedRfc, razonSocial, StringComparison.OrdinalIgnoreCase))
    {
      suppressRfcChange = true;
      selectedRfc = razonSocial;
      if (!RfcState.TrySet(razonSocial))
      {
        suppressRfcChange = false;
        await InvokeAsync(StateHasChanged);
      }
    }
  }

  private async Task ClearAccountSelectionAsync()
  {
    accountSelection = null;
    directAccountId = null;
    if (cuentasPicker is not null)
    {
      await cuentasPicker.ClearAsync();
    }
  }

  private void GoToPoliza(int poliza)
    => Navigation.NavigateTo($"/contabilidad/transacciones/{poliza}");

  private void ReportError(string message, Exception exception)
  {
    errorMessage = message;
    Console.Error.WriteLine($"[ContabilidadRegistros] {message}: {exception}");
  }

  private async Task OnAccountSelectionChangedAsync(CuentasContablesSelection? selection)
  {
    accountSelection = selection;
    directAccountId = selection?.Id;

    if (!string.IsNullOrWhiteSpace(selection?.Rfc))
    {
      await SetRfcAsync(selection!.Rfc!);
    }

    if (!string.IsNullOrEmpty(errorMessage))
    {
      errorMessage = null;
    }
  }

  private async Task OnPickerRfcChangedAsync(string? razonSocial)
  {
    if (string.IsNullOrWhiteSpace(razonSocial))
    {
      return;
    }

    await SetRfcAsync(razonSocial);
  }

  private void OnAccountPickerError(string message)
  {
    errorMessage = message;
  }
}

