@page "/logistica/conteos"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using OrionERP.Application.Features.Logistica.PhysicalCounts
@attribute [Authorize(Roles = "Administrador,Logistica,Conteo")]

<PageTitle>Logística · Conteos físicos</PageTitle>

<div class="conteos-page">
    <header class="conteos-hero">
        <div>
            <span class="conteos-eyebrow">Inventario físico</span>
            <h1>Conteos fáciles, paso a paso</h1>
            <p>Elige una ubicación, cuenta cada material y envía el resultado para revisión.</p>
        </div>
        <div class="conteos-hero-actions">
            <button class="btn btn-light" type="button" @onclick="CargarSesionesAsync" disabled="@IsLoadingSessions">
                <span class="oi oi-reload" aria-hidden="true"></span>
                @(IsLoadingSessions ? "Actualizando…" : "Actualizar")
            </button>
            @if (CanManageCounts)
            {
                <button class="btn btn-primary" type="button" @onclick="AbrirCreacion">
                    <span class="oi oi-plus" aria-hidden="true"></span>
                    Nuevo conteo
                </button>
            }
        </div>
    </header>

    @if (SelectedSession is null)
    {
        <main class="conteos-dashboard">
            <section class="conteos-process-card" aria-label="Proceso de un conteo físico">
                <div class="conteos-process-copy">
                    <span class="oi oi-info" aria-hidden="true"></span>
                    <div>
                        <strong>¿Cómo funciona?</strong>
                        <span>Cuenta los materiales, envía el resultado y espera la revisión antes de aplicar cambios al inventario.</span>
                    </div>
                </div>
                <div class="conteos-process-steps" aria-hidden="true">
                    <span>1. Contar</span><i></i><span>2. Revisar</span><i></i><span>3. Aprobar</span><i></i><span>4. Aplicar</span>
                </div>
            </section>

            <section class="conteos-session-group" aria-labelledby="conteos-active-title">
                <div class="conteos-section-heading">
                    <div>
                        <span class="conteos-section-kicker">Trabajo pendiente</span>
                        <h2 id="conteos-active-title">Por contar</h2>
                        <p>Abre un conteo para comenzar o continuar donde quedó el equipo.</p>
                    </div>
                    <span class="conteos-total-pill">@CountableSessions.Count</span>
                </div>

                @if (CountableSessions.Count == 0)
                {
                    <div class="conteos-empty-state">
                        <span class="oi oi-check" aria-hidden="true"></span>
                        <h3>No hay conteos pendientes</h3>
                        <p>@(CanManageCounts ? "Puedes crear un conteo nuevo cuando lo necesites." : "Cuando haya un conteo disponible aparecerá aquí.")</p>
                    </div>
                }
                else
                {
                    <div class="conteos-session-grid">
                        @foreach (var item in CountableSessions)
                        {
                            <button class="conteos-session-tile @GetSessionStatusClass(item.Status)" type="button" @onclick="() => SeleccionarSesionAsync(item.Id)">
                                <span class="conteos-session-tile-top">
                                    <span class="conteos-session-code">@item.SessionCode</span>
                                    <span class="@GetSessionStatusBadgeClass(item.Status)">@GetSessionStatusLabel(item.Status)</span>
                                </span>
                                <strong>@item.LocationName</strong>
                                @if (!string.IsNullOrWhiteSpace(item.RoomName))
                                {
                                    <small>@item.RoomName</small>
                                }
                                <span class="conteos-session-progress-copy">
                                    <span>@item.CountedLineCount de @GetSessionProgressTotal(item) contados</span>
                                    <b>@GetProgressPercentage(item.CountedLineCount, GetSessionProgressTotal(item))%</b>
                                </span>
                                <span class="conteos-progress-track"><span style="width: @GetProgressPercentage(item.CountedLineCount, GetSessionProgressTotal(item))%"></span></span>
                                <span class="conteos-session-tile-footer">
                                    @if (item.RecountLineCount > 0)
                                    {
                                        <span><span class="oi oi-loop" aria-hidden="true"></span> @item.RecountLineCount por recontar</span>
                                    }
                                    else
                                    {
                                        <span>@item.VarianceLineCount con diferencia</span>
                                    }
                                    <b>@(item.CountedLineCount == 0 ? "Comenzar" : "Continuar") <span aria-hidden="true">→</span></b>
                                </span>
                            </button>
                        }
                    </div>
                }
            </section>

            <section class="conteos-session-group" aria-labelledby="conteos-review-title">
                <div class="conteos-section-heading">
                    <div>
                        <span class="conteos-section-kicker">Siguiente etapa</span>
                        <h2 id="conteos-review-title">En revisión</h2>
                        <p>@(CanManageCounts ? "Revisa diferencias y decide el siguiente paso." : "Estos conteos ya fueron enviados al equipo de Logística.")</p>
                    </div>
                    <span class="conteos-total-pill">@ReviewSessions.Count</span>
                </div>

                @if (ReviewSessions.Count == 0)
                {
                    <div class="conteos-compact-empty">No hay conteos esperando revisión.</div>
                }
                else
                {
                    <div class="conteos-session-grid conteos-session-grid-review">
                        @foreach (var item in ReviewSessions)
                        {
                            <button class="conteos-session-tile @GetSessionStatusClass(item.Status)" type="button" @onclick="() => SeleccionarSesionAsync(item.Id)">
                                <span class="conteos-session-tile-top">
                                    <span class="conteos-session-code">@item.SessionCode</span>
                                    <span class="@GetSessionStatusBadgeClass(item.Status)">@GetSessionStatusLabel(item.Status)</span>
                                </span>
                                <strong>@item.LocationName</strong>
                                <span class="conteos-session-tile-footer">
                                    <span>@item.VarianceLineCount diferencias</span>
                                    <b>@(CanManageCounts ? "Revisar" : "Ver estado") <span aria-hidden="true">→</span></b>
                                </span>
                            </button>
                        }
                    </div>
                }
            </section>

            @if (CanManageCounts)
            {
                <details class="conteos-history">
                    <summary>
                        <span><span class="oi oi-folder" aria-hidden="true"></span> Finalizados</span>
                        <small>@HistoricalSessions.Count conteos</small>
                    </summary>
                    @if (HistoricalSessions.Count == 0)
                    {
                        <div class="conteos-compact-empty">Aún no hay conteos finalizados.</div>
                    }
                    else
                    {
                        <div class="conteos-history-list">
                            @foreach (var item in HistoricalSessions)
                            {
                                <button type="button" @onclick="() => SeleccionarSesionAsync(item.Id, includeHistorical: true)">
                                    <span><strong>@item.SessionCode</strong><small>@item.LocationName</small></span>
                                    <span class="@GetSessionStatusBadgeClass(item.Status)">@GetSessionStatusLabel(item.Status)</span>
                                </button>
                            }
                        </div>
                    }
                </details>
            }
        </main>
    }
    else
    {
        <main class="conteos-workspace">
            <section class="conteos-session-header">
                <div class="conteos-session-header-main">
                    <button class="conteos-back-button" type="button" @onclick="VolverASesionesAsync" aria-label="Volver a la lista de conteos">
                        <span class="oi oi-arrow-left" aria-hidden="true"></span>
                    </button>
                    <div>
                        <span class="conteos-section-kicker">@SelectedSession.SessionCode</span>
                        <h2>@SelectedSession.LocationName</h2>
                        @if (!string.IsNullOrWhiteSpace(SelectedSession.RoomName))
                        {
                            <p>@SelectedSession.RoomName</p>
                        }
                    </div>
                </div>
                <div class="conteos-session-header-actions">
                    <span class="@SelectedSessionStatusBadgeClass">@SelectedSessionStatusLabel</span>
                    <button class="btn btn-outline-secondary" type="button" @onclick="ActualizarSesionActualAsync" disabled="@IsLoadingSessions">
                        <span class="oi oi-reload" aria-hidden="true"></span>
                        Actualizar
                    </button>
                </div>
            </section>

            <section class="conteos-lifecycle" aria-label="Etapas del conteo">
                @for (var step = 1; step <= 4; step++)
                {
                    <div class="@GetLifecycleStepClass(step)">
                        <span>@step</span>
                        <strong>@GetLifecycleStepLabel(step)</strong>
                    </div>
                }
            </section>
            <p class="conteos-next-step">@GetCurrentStatusGuidance()</p>

            <section class="conteos-audit" aria-labelledby="conteos-audit-title">
                <header class="conteos-audit-heading">
                    <div>
                        <span class="conteos-section-kicker">Seguimiento completo</span>
                        <h2 id="conteos-audit-title">Bitácora del conteo</h2>
                        <p>Consulta cuándo comenzó, quién contó cada material y qué ocurrió después.</p>
                    </div>
                    <span class="conteos-total-pill">@AuditEvents.Count</span>
                </header>

                <div class="conteos-audit-summary">
                    <div>
                        <span>Inicio del conteo</span>
                        @if (FirstCaptureEvent is not null)
                        {
                            <strong>@FormatAuditMoment(FirstCaptureEvent.OccurredAt)</strong>
                            <small>@GetAuditActor(FirstCaptureEvent.PerformedBy)</small>
                        }
                        else
                        {
                            <strong>Aún no comienza</strong>
                            <small>Sin cantidades capturadas</small>
                        }
                    </div>
                    <div>
                        <span>Última actividad</span>
                        @if (LastAuditEvent is not null)
                        {
                            <strong>@FormatAuditMoment(LastAuditEvent.OccurredAt)</strong>
                            <small>@GetAuditActor(LastAuditEvent.PerformedBy)</small>
                        }
                        else
                        {
                            <strong>Sin actividad</strong>
                            <small>—</small>
                        }
                    </div>
                    <div>
                        <span>Personas que contaron</span>
                        <strong>@AuditCounterCount</strong>
                        <small>@AuditCaptureCount capturas registradas</small>
                    </div>
                </div>

                <div class="conteos-audit-list">
                    @foreach (var auditEvent in VisibleAuditEvents)
                    {
                        <article class="conteos-audit-event @GetAuditEventClass(auditEvent.EventType)">
                            <span class="conteos-audit-marker" aria-hidden="true"></span>
                            <time datetime="@FormatAuditMachineTime(auditEvent.OccurredAt)">
                                <strong>@FormatAuditDay(auditEvent.OccurredAt)</strong>
                                <small>@FormatAuditTime(auditEvent.OccurredAt)</small>
                            </time>
                            <div>
                                <strong>@GetAuditEventTitle(auditEvent)</strong>
                                <p>@GetAuditEventDescription(auditEvent)</p>
                                <span class="conteos-audit-actor"><span class="oi oi-person" aria-hidden="true"></span>@GetAuditActor(auditEvent.PerformedBy)</span>
                            </div>
                        </article>
                    }
                </div>

                @if (AuditEvents.Count > 12)
                {
                    <button class="conteos-audit-toggle" type="button" @onclick="() => ShowFullAuditLog = !ShowFullAuditLog">
                        @(ShowFullAuditLog ? "Mostrar solo lo más reciente" : $"Ver toda la bitácora ({AuditEvents.Count} eventos)")
                    </button>
                }
            </section>

            @if (CanSubmit)
            {
                @if (ShowCompletionReview || SelectedLine is null)
                {
                    <section class="conteos-completion-card">
                        <div class="conteos-completion-icon"><span class="oi @(PendingLineCount == 0 ? "oi-check" : "oi-clock")" aria-hidden="true"></span></div>
                        <span class="conteos-section-kicker">Revisión del operador</span>
                        <h2>@(PendingLineCount == 0 ? "Terminaste de contar" : "Aún faltan materiales")</h2>
                        <p>@(PendingLineCount == 0 ? "Revisa el resumen y envía el conteo al equipo de Logística." : "Completa las cantidades pendientes antes de enviar el conteo.")</p>

                        <div class="conteos-summary-grid">
                            <div><span>Total</span><strong>@CaptureTotalLineCount</strong></div>
                            <div><span>Contados</span><strong>@CountedLineCount</strong></div>
                            <div class="@(PendingLineCount > 0 ? "is-warning" : string.Empty)"><span>Pendientes</span><strong>@PendingLineCount</strong></div>
                            <div class="@(VarianceLineCount > 0 ? "is-warning" : string.Empty)"><span>Diferencias</span><strong>@VarianceLineCount</strong></div>
                        </div>

                        <div class="conteos-review-list">
                            @foreach (var line in GetOperatorReviewLines())
                            {
                                <button type="button" @onclick="() => EditarLinea(line)">
                                    <span>
                                        <strong>@GetMaterialTitle(line)</strong>
                                        <small>@(line.CountedQuantity.HasValue ? $"Contado {line.CountedQuantity.Value:N2} · Esperado {line.ExpectedQuantity:N2}" : "Pendiente de captura")</small>
                                    </span>
                                    @if (!line.CountedQuantity.HasValue)
                                    {
                                        <b class="conteos-pending-label">Pendiente</b>
                                    }
                                    else if (line.VarianceQuantity is not null and not 0m)
                                    {
                                        <b class="conteos-variance-label">@FormatSignedQuantity(line.VarianceQuantity)</b>
                                    }
                                    else
                                    {
                                        <b class="conteos-ok-label"><span class="oi oi-check" aria-hidden="true"></span></b>
                                    }
                                </button>
                            }
                        </div>

                        <div class="conteos-completion-actions">
                            @if (PendingLineCount > 0)
                            {
                                <button class="btn btn-primary btn-lg" type="button" @onclick="ContinuarPendientes">
                                    Continuar contando @PendingLineCount
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-primary btn-lg" type="button" @onclick="EnviarSesionAsync" disabled="@IsMutatingSession">
                                    @(IsMutatingSession ? "Enviando…" : "Enviar a revisión")
                                </button>
                            }
                        </div>
                    </section>
                }
                else
                {
                    <section class="conteos-progress-panel">
                        <div>
                            <span>@CountedLineCount de @CaptureTotalLineCount contados</span>
                            <strong>@SessionProgressPercentage%</strong>
                        </div>
                        <span class="conteos-progress-track"><span style="width: @SessionProgressPercentage%"></span></span>
                        <small>@(IsRecountStatus(SelectedSession.Status) ? $"{PendingLineCount} materiales pendientes de reconteo" : $"{PendingLineCount} materiales pendientes")</small>
                    </section>

                    <button class="conteos-mobile-materials-button" type="button" @onclick="AbrirListaMovil">
                        <span class="oi oi-list-rich" aria-hidden="true"></span>
                        Ver materiales
                        <span>@PendingLineCount pendientes</span>
                    </button>

                    <div class="conteos-count-layout">
                        <aside class="conteos-material-sidebar" aria-label="Materiales de la sesión">
                            <div class="conteos-sidebar-heading">
                                <div><strong>Materiales</strong><small>@FilteredSessionLines.Count visibles</small></div>
                                <button type="button" @onclick="MostrarRevisionFinal" title="Revisar conteo"><span class="oi oi-clipboard" aria-hidden="true"></span></button>
                            </div>
                            <div class="conteos-search-row">
                                <label>
                                    <span class="oi oi-magnifying-glass" aria-hidden="true"></span>
                                    <input type="search" placeholder="Nombre, código o barras" @bind="MaterialSearch" @bind:event="oninput" />
                                </label>
                                <button type="button" @onclick="AbrirEscanerAsync" disabled="@(!CameraScanningAllowed)" title="Escanear código de barras" aria-label="Escanear código de barras">
                                    <span class="oi oi-camera-slr" aria-hidden="true"></span>
                                </button>
                            </div>
                            <div class="conteos-filter-chips" role="group" aria-label="Filtrar materiales">
                                @foreach (var filter in CaptureFilters)
                                {
                                    <button class="@(CaptureFilter == filter.Value ? "is-active" : string.Empty)" type="button" @onclick="() => SetCaptureFilter(filter.Value)">@filter.Label</button>
                                }
                            </div>
                            <div class="conteos-material-list">
                                @foreach (var line in FilteredSessionLines)
                                {
                                    <button class="@GetMaterialListItemClass(line)" type="button" @onclick="() => SeleccionarLinea(line)">
                                        <span class="conteos-material-list-state">@GetLineStateIcon(line)</span>
                                        <span><strong>@GetMaterialTitle(line)</strong><small>@GetMaterialListSubtitle(line)</small></span>
                                        @if (line.CountedQuantity.HasValue)
                                        {
                                            <b>@line.CountedQuantity.Value.ToString("N2")</b>
                                        }
                                    </button>
                                }
                                @if (FilteredSessionLines.Count == 0)
                                {
                                    <div class="conteos-material-list-empty">No hay materiales con este filtro.</div>
                                }
                            </div>
                        </aside>

                        <section class="conteos-focus-card" aria-labelledby="conteos-material-title">
                            @{
                                var materialTitle = GetMaterialTitle(SelectedLine);
                                var unitLabel = GetCountUnitLabel(SelectedLine.BaseUnitName);
                                var thumbnailDataUrl = GetMaterialThumbnailDataUrl(SelectedLine.MaterialId);
                            }
                            <div class="conteos-focus-media">
                                @if (thumbnailDataUrl is not null)
                                {
                                    <button type="button" @onclick="() => AbrirImagenMaterialAsync(SelectedLine)" aria-label="Ampliar foto de @materialTitle">
                                        <img src="@thumbnailDataUrl" alt="Foto de @materialTitle" />
                                        <span><span class="oi oi-zoom-in" aria-hidden="true"></span> Ampliar</span>
                                    </button>
                                }
                                else
                                {
                                    <div><span class="oi oi-image" aria-hidden="true"></span><small>Sin foto</small></div>
                                }
                            </div>
                            <div class="conteos-focus-body">
                                <div class="conteos-focus-heading">
                                    <span class="conteos-section-kicker">Material @CurrentLinePosition de @CaptureTotalLineCount</span>
                                    <h2 id="conteos-material-title">@materialTitle</h2>
                                    @if (!string.IsNullOrWhiteSpace(SelectedLine.MaterialCode) && !string.Equals(SelectedLine.MaterialCode, materialTitle, StringComparison.OrdinalIgnoreCase))
                                    {
                                        <p>@SelectedLine.MaterialCode</p>
                                    }
                                    <span class="conteos-unit-badge">Cuenta en @unitLabel</span>
                                </div>

                                @if (HasRecountIssue(SelectedLine))
                                {
                                    <div class="conteos-recount-instruction">
                                        <span class="oi oi-loop" aria-hidden="true"></span>
                                        <div><strong>Reconteo solicitado: @GetRecountIssueLabel(SelectedLine.RecountIssueCode)</strong><p>@SelectedLine.RecountReason</p></div>
                                    </div>
                                }

                                <div class="conteos-quantity-grid">
                                    <div><span>Esperado</span><strong>@SelectedLine.ExpectedQuantity.ToString("N2")</strong><small>@unitLabel</small></div>
                                    <label class="conteos-count-input-wrap">
                                        <span>¿Cuánto contaste?</span>
                                        @if (SelectedLine.Lots.Count > 0)
                                        {
                                            <input class="conteos-count-input" type="text" value="@CountedQuantityInput" disabled />
                                        }
                                        else
                                        {
                                            <input class="conteos-count-input"
                                                   type="text"
                                                   inputmode="decimal"
                                                   enterkeyhint="done"
                                                   autocomplete="off"
                                                   spellcheck="false"
                                                   data-orion-prevent-keys="Enter"
                                                   aria-label="Cantidad contada en @unitLabel"
                                                   value="@CountedQuantityInput"
                                                   @oninput="OnCountedQuantityInput"
                                                   @onblur="OnCountedQuantityBlur"
                                                   @onfocus="() => SelectCountedQuantityAsync()"
                                                   @onclick="() => SelectCountedQuantityAsync()"
                                                   @onkeydown="HandleMobileCountedQuantityKeyDownAsync"
                                                   @ref="CountedQuantityInputRef" />
                                        }
                                        <small>@unitLabel</small>
                                    </label>
                                    <div class="@GetCurrentVarianceClass()"><span>Diferencia</span><strong>@CurrentVarianceText</strong><small>@unitLabel</small></div>
                                </div>

                                @if (SelectedLine.Lots.Count > 0)
                                {
                                    <div class="conteos-lots">
                                        <div><strong>Cuenta cada lote</strong><small>El total se calcula automáticamente.</small></div>
                                        @foreach (var lot in SelectedLine.Lots)
                                        {
                                            var captureLot = LineCapture.Lots.Single(item => item.MaterialLotId == lot.MaterialLotId);
                                            <label>
                                                <span><strong>@lot.LotCode</strong><small>Esperado @lot.ExpectedQuantity.ToString("N2")@if (lot.ExpiresAt.HasValue) { <text> · vence @lot.ExpiresAt.Value.ToString("d")</text> }</small></span>
                                                <InputNumber class="form-control" min="0" step="0.0001" @bind-Value="captureLot.CountedQuantity" @bind-Value:after="UpdateTotalFromLots" />
                                            </label>
                                        }
                                    </div>
                                }

                                <details class="conteos-extra-details" open="@ShouldOpenLineDetails">
                                    <summary><span class="oi oi-chevron-bottom" aria-hidden="true"></span> Agregar detalles <small>Opcional</small></summary>
                                    <div class="conteos-extra-content">
                                        <div class="conteos-condition-buttons">
                                            <label class="@(LineCapture.IsMissing ? "is-selected" : string.Empty)">
                                                <InputCheckbox @bind-Value="LineCapture.IsMissing" />
                                                <span class="oi oi-warning" aria-hidden="true"></span>
                                                <span><strong>Faltante</strong><small>No se encontró el material.</small></span>
                                            </label>
                                            <label class="@(LineCapture.IsDamaged ? "is-selected" : string.Empty)">
                                                <InputCheckbox @bind-Value="LineCapture.IsDamaged" />
                                                <span class="oi oi-wrench" aria-hidden="true"></span>
                                                <span><strong>Dañado</strong><small>El material no está en buen estado.</small></span>
                                            </label>
                                        </div>
                                        <label class="conteos-field">
                                            <span>Nota</span>
                                            <InputTextArea rows="3" placeholder="Describe algo importante para quien revisará" @bind-Value="LineCapture.Notes" />
                                        </label>
                                        <label class="conteos-field conteos-file-field">
                                            <span>Foto o evidencia</span>
                                            <InputFile accept="image/*,.pdf" OnChange="OnLineAttachmentSelectedAsync" />
                                            <small>@(string.IsNullOrWhiteSpace(PendingLineAttachmentName) ? "Puedes tomar una foto o elegir un archivo." : PendingLineAttachmentName)</small>
                                        </label>
                                        @if (SelectedLine.Attachments.Count > 0)
                                        {
                                            <div class="conteos-attachments">
                                                <strong>Evidencias guardadas</strong>
                                                @foreach (var attachment in SelectedLine.Attachments)
                                                {
                                                    <button type="button" @onclick="() => DescargarEvidenciaAsync(attachment.Id)"><span class="oi oi-paperclip" aria-hidden="true"></span>@attachment.FileName</button>
                                                }
                                            </div>
                                        }
                                    </div>
                                </details>
                            </div>

                            <footer class="conteos-focus-actions">
                                <button class="btn btn-outline-secondary" type="button" @onclick="SeleccionarLineaAnterior" disabled="@(!CanSelectPreviousLine)">
                                    <span aria-hidden="true">←</span> Anterior
                                </button>
                                <button class="btn btn-link" type="button" @onclick="OmitirLineaActual">Omitir por ahora</button>
                                <button class="btn btn-primary btn-lg" type="button" @onclick="GuardarLineaMovilAsync" disabled="@(!CanCaptureLine || IsSavingLine)">
                                    @(IsSavingLine ? "Guardando…" : "Guardar y siguiente") <span aria-hidden="true">→</span>
                                </button>
                            </footer>
                        </section>
                    </div>
                }
                @if (CanCancel)
                {
                    <details class="conteos-more-actions">
                        <summary>Más acciones</summary>
                        <button class="btn btn-outline-danger" type="button" @onclick="CancelarSesionAsync" disabled="@IsMutatingSession">Cancelar este conteo</button>
                    </details>
                }
            }
            else
            {
                <section class="conteos-supervisor-review">
                    <div class="conteos-review-heading">
                        <div>
                            <span class="conteos-section-kicker">@(IsPostedStatus(SelectedSession.Status) || IsCanceledStatus(SelectedSession.Status) ? "Consulta" : "Revisión del conteo")</span>
                            <h2>@GetReviewHeading()</h2>
                            <p>@GetReviewDescription()</p>
                        </div>
                        @if (CanManageCounts && (CanApprove || CanPost || CanRequestRecount))
                        {
                            <div class="conteos-review-primary-actions">
                                @if (CanRequestRecount)
                                {
                                    <button class="btn btn-outline-warning" type="button" @onclick="AbrirReconteo" disabled="@IsMutatingSession">Solicitar reconteo</button>
                                }
                                @if (CanApprove)
                                {
                                    <button class="btn btn-primary" type="button" @onclick="AprobarSesionAsync" disabled="@IsMutatingSession">Aprobar conteo</button>
                                }
                                @if (CanPost)
                                {
                                    <button class="btn btn-success" type="button" @onclick="ContabilizarSesionAsync" disabled="@IsMutatingSession">Aplicar al inventario</button>
                                }
                            </div>
                        }
                    </div>

                    <div class="conteos-summary-grid">
                        <div><span>Materiales</span><strong>@SelectedSession.Lines.Count</strong></div>
                        <div><span>Sin diferencia</span><strong>@MatchingLineCount</strong></div>
                        <div class="@(VarianceLineCount > 0 ? "is-warning" : string.Empty)"><span>Con diferencia</span><strong>@VarianceLineCount</strong></div>
                        <div class="@(FlaggedLineCount > 0 ? "is-warning" : string.Empty)"><span>Con incidencia</span><strong>@FlaggedLineCount</strong></div>
                    </div>

                    <div class="conteos-review-toolbar">
                        <label><span class="oi oi-magnifying-glass" aria-hidden="true"></span><input type="search" placeholder="Buscar material" @bind="MaterialSearch" @bind:event="oninput" /></label>
                        <div class="conteos-filter-chips" role="group" aria-label="Filtrar revisión">
                            @foreach (var filter in ReviewFilters)
                            {
                                <button class="@(ReviewFilter == filter.Value ? "is-active" : string.Empty)" type="button" @onclick="() => SetReviewFilter(filter.Value)">@filter.Label</button>
                            }
                        </div>
                    </div>

                    @if (ShowRecountPanel)
                    {
                        <div class="conteos-recount-banner">
                            <span class="oi oi-loop" aria-hidden="true"></span>
                            <div><strong>Selecciona lo que debe contarse otra vez</strong><p>Indica el problema y explica qué debe verificarse.</p></div>
                            <button type="button" @onclick="CerrarReconteo" aria-label="Cerrar plan de reconteo"><span class="oi oi-x" aria-hidden="true"></span></button>
                        </div>
                    }

                    <div class="conteos-review-cards">
                        @foreach (var line in FilteredReviewLines)
                        {
                            var recountEditor = GetRecountEditor(line.Id);
                            <article class="conteos-review-card @(line.VarianceQuantity is not null and not 0m ? "has-variance" : string.Empty) @(HasRecountIssue(line) ? "has-recount" : string.Empty)">
                                <header>
                                    @if (ShowRecountPanel && recountEditor is not null)
                                    {
                                        <label class="conteos-recount-check"><InputCheckbox @bind-Value="recountEditor.IsSelected" /><span>Recontar</span></label>
                                    }
                                    <div><strong>@GetMaterialTitle(line)</strong><small>@line.MaterialCode · @GetCountUnitLabel(line.BaseUnitName)</small></div>
                                    <span class="@(line.VarianceQuantity is not null and not 0m ? "conteos-variance-label" : "conteos-ok-label")">@(line.VarianceQuantity is not null and not 0m ? FormatSignedQuantity(line.VarianceQuantity) : "Sin diferencia")</span>
                                </header>
                                <div class="conteos-review-quantities">
                                    <span>Esperado <strong>@line.ExpectedQuantity.ToString("N2")</strong></span>
                                    <span>Contado <strong>@FormatOptionalQuantity(line.CountedQuantity)</strong></span>
                                    <span>Por <strong>@(string.IsNullOrWhiteSpace(line.CapturedBy) ? "Sin usuario" : line.CapturedBy)</strong></span>
                                </div>
                                @if (line.IsMissing || line.IsDamaged || !string.IsNullOrWhiteSpace(line.Notes) || line.AttachmentCount > 0)
                                {
                                    <div class="conteos-review-notes">
                                        @if (line.IsMissing) { <span>Faltante</span> }
                                        @if (line.IsDamaged) { <span>Dañado</span> }
                                        @if (line.AttachmentCount > 0) { <span>@line.AttachmentCount evidencia(s)</span> }
                                        @if (!string.IsNullOrWhiteSpace(line.Notes)) { <p>@line.Notes</p> }
                                    </div>
                                }
                                @if (ShowRecountPanel && recountEditor is not null && recountEditor.IsSelected)
                                {
                                    <div class="conteos-recount-fields">
                                        <label><span>Problema</span><select @bind="recountEditor.IssueCode">
                                            <option value="@PhysicalCountRecountIssueCodes.QuantityMismatch">Cantidad</option>
                                            <option value="@PhysicalCountRecountIssueCodes.UnitIssue">Unidad</option>
                                            <option value="@PhysicalCountRecountIssueCodes.WrongMaterial">Material</option>
                                            <option value="@PhysicalCountRecountIssueCodes.EvidenceMissing">Evidencia</option>
                                            <option value="@PhysicalCountRecountIssueCodes.ConditionIssue">Condición</option>
                                            <option value="@PhysicalCountRecountIssueCodes.Other">Otro</option>
                                        </select></label>
                                        <label><span>Qué debe verificarse</span><InputTextArea rows="2" placeholder="Ej. Confirmar las cajas de la repisa superior" @bind-Value="recountEditor.Reason" /></label>
                                    </div>
                                }
                            </article>
                        }
                    </div>

                    @if (ShowRecountPanel)
                    {
                        <div class="conteos-review-sticky-action">
                            <span>@SelectedRecountLineCount material(es) seleccionados</span>
                            <button class="btn btn-warning btn-lg" type="button" @onclick="EnviarAReconteoAsync" disabled="@IsRequestingRecount">
                                @(IsRequestingRecount ? "Enviando…" : "Enviar a reconteo")
                            </button>
                        </div>
                    }

                    @if (CanCancel)
                    {
                        <details class="conteos-more-actions">
                            <summary>Más acciones</summary>
                            <button class="btn btn-outline-danger" type="button" @onclick="CancelarSesionAsync" disabled="@IsMutatingSession">Cancelar este conteo</button>
                        </details>
                    }
                </section>
            }
        </main>
    }
</div>

@if (ShowCreateModal)
{
    <div class="conteos-overlay" role="dialog" aria-modal="true" aria-labelledby="conteos-create-title">
        <section class="conteos-dialog">
            <header><div><span class="conteos-section-kicker">Administración</span><h2 id="conteos-create-title">Nuevo conteo</h2></div><button type="button" @onclick="CerrarCreacion" aria-label="Cerrar"><span class="oi oi-x" aria-hidden="true"></span></button></header>
            <div class="conteos-dialog-info"><span class="oi oi-info" aria-hidden="true"></span><p>Se tomará una fotografía de la existencia actual. El inventario no cambiará hasta que el conteo sea revisado, aprobado y aplicado.</p></div>
            <label class="conteos-field"><span>Ubicación</span><select @bind="SessionCreateRequest.LocationId"><option value="0">Selecciona una ubicación</option>@foreach (var option in LocationOptions) { <option value="@option.Id">@option.Name</option> }</select></label>
            <label class="conteos-field"><span>Nota <small>Opcional</small></span><InputTextArea rows="3" placeholder="Instrucciones para el equipo de conteo" @bind-Value="SessionCreateRequest.Notes" /></label>
            <footer><button class="btn btn-outline-secondary" type="button" @onclick="CerrarCreacion">Cerrar</button><button class="btn btn-primary btn-lg" type="button" @onclick="CrearSesionAsync" disabled="@IsCreatingSession">@(IsCreatingSession ? "Creando…" : "Crear y abrir conteo")</button></footer>
        </section>
    </div>
}

@if (ShowMobileMaterialList && SelectedSession is not null)
{
    <div class="conteos-overlay conteos-drawer-overlay" role="dialog" aria-modal="true" aria-labelledby="conteos-mobile-list-title">
        <section class="conteos-mobile-drawer">
            <header><div><span class="conteos-section-kicker">@PendingLineCount pendientes</span><h2 id="conteos-mobile-list-title">Materiales</h2></div><button type="button" @onclick="CerrarListaMovil" aria-label="Cerrar lista"><span class="oi oi-x" aria-hidden="true"></span></button></header>
            <div class="conteos-search-row">
                <label><span class="oi oi-magnifying-glass" aria-hidden="true"></span><input type="search" placeholder="Nombre, código o barras" @bind="MaterialSearch" @bind:event="oninput" /></label>
                <button type="button" @onclick="AbrirEscanerDesdeListaAsync" disabled="@(!CameraScanningAllowed)" aria-label="Escanear código de barras"><span class="oi oi-camera-slr" aria-hidden="true"></span></button>
            </div>
            <div class="conteos-filter-chips" role="group" aria-label="Filtrar materiales">
                @foreach (var filter in CaptureFilters)
                {
                    <button class="@(CaptureFilter == filter.Value ? "is-active" : string.Empty)" type="button" @onclick="() => SetCaptureFilter(filter.Value)">@filter.Label</button>
                }
            </div>
            <div class="conteos-material-list">
                @foreach (var line in FilteredSessionLines)
                {
                    <button class="@GetMaterialListItemClass(line)" type="button" @onclick="() => SeleccionarLineaDesdeLista(line)">
                        <span class="conteos-material-list-state">@GetLineStateIcon(line)</span>
                        <span><strong>@GetMaterialTitle(line)</strong><small>@GetMaterialListSubtitle(line)</small></span>
                        @if (line.CountedQuantity.HasValue) { <b>@line.CountedQuantity.Value.ToString("N2")</b> }
                    </button>
                }
            </div>
            <footer><button class="btn btn-outline-secondary w-100" type="button" @onclick="MostrarRevisionDesdeLista">Revisar todo el conteo</button></footer>
        </section>
    </div>
}

@if (ShowBarcodeScanner)
{
    <div class="conteos-scanner-overlay" role="dialog" aria-modal="true" aria-labelledby="conteos-scanner-title">
        <section class="conteos-scanner-dialog">
            <header><div><span class="conteos-section-kicker">Búsqueda rápida</span><h2 id="conteos-scanner-title">Escanear código</h2></div><button type="button" @onclick="CerrarEscanerAsync" aria-label="Cerrar cámara"><span class="oi oi-x" aria-hidden="true"></span></button></header>
            <div class="conteos-scanner-stage">
                <video @ref="ScannerVideoElement" autoplay muted playsinline></video>
                <span class="conteos-scanner-frame" aria-hidden="true"></span>
                @if (IsStartingScanner) { <div class="conteos-scanner-status"><span class="spinner-border" aria-hidden="true"></span><strong>Abriendo cámara…</strong></div> }
            </div>
            <p>Coloca el código de barras dentro del recuadro. La cámara se cerrará al encontrar el material.</p>
            @if (!string.IsNullOrWhiteSpace(ScannerMessage)) { <div class="conteos-scanner-message" role="status">@ScannerMessage</div> }
            <footer><button class="btn btn-light w-100" type="button" @onclick="CerrarEscanerAsync">Cancelar y buscar manualmente</button></footer>
        </section>
    </div>
}

@if (ShowCancelModal && SelectedSession is not null)
{
    <div class="conteos-overlay" role="dialog" aria-modal="true" aria-labelledby="conteos-cancel-title">
        <section class="conteos-dialog conteos-dialog-small">
            <header><div><span class="conteos-section-kicker">Acción administrativa</span><h2 id="conteos-cancel-title">Cancelar @SelectedSession.SessionCode</h2></div><button type="button" @onclick="CerrarCancelacion" aria-label="Cerrar"><span class="oi oi-x" aria-hidden="true"></span></button></header>
            <div class="conteos-dialog-warning"><span class="oi oi-warning" aria-hidden="true"></span><p>El conteo quedará únicamente para consulta y ya no podrá continuarse ni aplicarse.</p></div>
            <label class="conteos-field"><span>Razón de cancelación</span><InputTextArea rows="4" placeholder="Explica por qué se cancela" @bind-Value="CancelReason" /></label>
            <footer><button class="btn btn-outline-secondary" type="button" @onclick="CerrarCancelacion" disabled="@IsCancelingSession">Volver</button><button class="btn btn-danger" type="button" @onclick="ConfirmarCancelacionAsync" disabled="@IsCancelingSession">@(IsCancelingSession ? "Cancelando…" : "Cancelar conteo")</button></footer>
        </section>
    </div>
}

@if (ShowMaterialImageModal)
{
    <div class="conteos-overlay conteos-image-overlay" role="dialog" aria-modal="true" aria-labelledby="conteos-image-title">
        <section class="conteos-image-dialog">
            <header><h2 id="conteos-image-title">@(string.IsNullOrWhiteSpace(MaterialImageModalTitle) ? "Imagen del material" : MaterialImageModalTitle)</h2><button type="button" @onclick="CloseMaterialImageModal" aria-label="Cerrar"><span class="oi oi-x" aria-hidden="true"></span></button></header>
            <div>@if (MaterialImageModalDataUrl is not null) { <img src="@MaterialImageModalDataUrl" alt="Vista ampliada del material" /> } else if (IsLoadingMaterialImage) { <span class="spinner-border" aria-hidden="true"></span> } else { <p>Sin imagen disponible.</p> }</div>
        </section>
    </div>
}
