@page "/restaurante/menus"
@attribute [Authorize(Policy = "RestaurantAdmin")]
@using OrionERP.Application.Features.Logistica.Materials
@using OrionERP.Application.Features.Logistica.Shared
@using OrionERP.Application.Features.Restaurante
@using OrionERP.Web.State
@inject IRestaurantCatalogService CatalogService
@inject IMaterialService MaterialService
@inject ICurrentCompanyContext RfcState

<PageTitle>Restaurante · Menús y modificadores</PageTitle>

<main class="menu-admin-shell">
  <header class="menu-admin-hero"><div><span>Catálogo comercial</span><h1>Menús y modificadores</h1><p>Publicación por horario, secciones táctiles, opciones y cambios exactos a ingredientes.</p></div><button type="button" class="btn btn-light" @onclick="LoadAsync">Actualizar</button></header>
  @if (!string.IsNullOrWhiteSpace(message)) { <div class="alert @(isError ? "alert-danger" : "alert-success")">@message</div> }
  <nav class="menu-admin-tabs"><button type="button" class="@(tab=="menus"?"is-active":null)" @onclick='()=>tab="menus"'>Menús</button><button type="button" class="@(tab=="modifiers"?"is-active":null)" @onclick='()=>tab="modifiers"'>Modificadores</button></nav>

  @if (tab == "menus")
  {
    <section class="menu-admin-layout">
      <aside class="menu-admin-list"><header><h2>Menús</h2><button type="button" class="btn btn-outline-primary btn-sm" @onclick="NewMenu">Nuevo</button></header>@foreach(var menu in menus){<button type="button" class="@(menuEditor.Id==menu.Id?"is-active":null)" @onclick="()=>EditMenu(menu)"><span><strong>@menu.Name</strong><small>@menu.MenuCode · @menu.Sections.Count sección(es)</small></span><b>@(menu.IsPublished?"Publicado":"Borrador")</b></button>}@if(menus.Count==0){<p>Sin menús configurados.</p>}</aside>
      <section class="menu-admin-editor">
        <div class="menu-admin-fields"><label>Código<input @bind="menuEditor.MenuCode" /></label><label>Nombre<input @bind="menuEditor.Name" /></label><label class="menu-admin-check"><input type="checkbox" @bind="menuEditor.IsActive" /> Activo</label><label class="menu-admin-check"><input type="checkbox" @bind="menuEditor.IsPublished" /> Publicado</label></div>
        <article class="menu-admin-card"><header><div><span>Disponibilidad</span><h2>Horarios por sede</h2></div><button type="button" @onclick="AddSchedule">Agregar horario</button></header>@foreach(var schedule in menuEditor.Schedules){<div class="menu-admin-schedule"><select @bind="schedule.SiteId"><option value="0">Sede…</option>@foreach(var site in sites){<option value="@site.Id">@site.Name</option>}</select><select @bind="schedule.DayOfWeek">@for(byte day=0;day<7;day++){<option value="@day">@DayName(day)</option>}</select><input type="time" value="@FormatTime(schedule.StartsAt)" @onchange="e=>SetStart(schedule,e.Value)" /><span>a</span><input type="time" value="@FormatTime(schedule.EndsAt)" @onchange="e=>SetEnd(schedule,e.Value)" /><button type="button" aria-label="Eliminar" @onclick="()=>menuEditor.Schedules.Remove(schedule)">×</button></div>}@if(menuEditor.Schedules.Count==0){<p class="menu-admin-hint">Sin horarios: el menú publicado funcionará como menú general.</p>}</article>
        @foreach(var section in menuEditor.Sections.OrderBy(item=>item.SortOrder))
        {
          <article class="menu-admin-card"><header><div class="menu-admin-section-title"><input @bind="section.Name" placeholder="Nombre de sección" /><input type="number" @bind="section.SortOrder" title="Orden" /></div><button type="button" @onclick="()=>menuEditor.Sections.Remove(section)">Eliminar sección</button></header><div class="menu-admin-product-grid">@foreach(var product in products){<label class="@(section.ProductIds.Contains(product.Id)?"is-selected":null)"><input type="checkbox" checked="@section.ProductIds.Contains(product.Id)" @onchange="()=>ToggleProduct(section.ProductIds,product.Id)" /><span><strong>@product.Name</strong><small>@product.Sku @(string.IsNullOrWhiteSpace(product.VariantName)?null:$"· {product.VariantName}")</small></span><b>@product.Price.ToString("C")</b></label>}</div>
          </article>
        }
        <footer class="menu-admin-actions"><button type="button" class="btn btn-outline-primary" @onclick="AddSection">Agregar sección</button><button type="button" class="btn btn-primary" disabled="@isBusy" @onclick="SaveMenuAsync">Guardar menú</button></footer>
      </section>
    </section>
  }
  else
  {
    <section class="menu-admin-layout">
      <aside class="menu-admin-list"><header><h2>Grupos</h2><button type="button" class="btn btn-outline-primary btn-sm" @onclick="NewModifier">Nuevo</button></header>@foreach(var group in modifiers){<button type="button" class="@(modifierEditor.Id==group.Id?"is-active":null)" @onclick="()=>EditModifier(group)"><span><strong>@group.Name</strong><small>@group.Options.Count opción(es)</small></span><b>@group.MinSelections–@group.MaxSelections</b></button>}@if(modifiers.Count==0){<p>Sin grupos configurados.</p>}</aside>
      <section class="menu-admin-editor">
        <div class="menu-admin-fields menu-admin-fields--modifier"><label>Nombre<input @bind="modifierEditor.Name" /></label><label>Mínimo<input type="number" min="0" @bind="modifierEditor.MinSelections" /></label><label>Máximo<input type="number" min="0" @bind="modifierEditor.MaxSelections" /></label><label class="menu-admin-check"><input type="checkbox" @bind="modifierEditor.IsActive" /> Activo</label></div>
        <article class="menu-admin-card"><header><div><span>Aplicación</span><h2>Productos que usan el grupo</h2></div></header><div class="menu-admin-product-grid">@foreach(var product in products){<label class="@(modifierEditor.ProductIds.Contains(product.Id)?"is-selected":null)"><input type="checkbox" checked="@modifierEditor.ProductIds.Contains(product.Id)" @onchange="()=>ToggleProduct(modifierEditor.ProductIds,product.Id)" /><span><strong>@product.Name</strong><small>@product.Sku</small></span></label>}</div></article>
        @foreach(var option in modifierEditor.Options.OrderBy(item=>item.SortOrder))
        {
          <article class="menu-admin-card menu-admin-option"><header><div class="menu-admin-option-fields"><input @bind="option.Name" placeholder="Nombre de opción" /><label>Precio<input type="number" step="0.01" @bind="option.PriceDelta" /></label><label>Orden<input type="number" @bind="option.SortOrder" /></label></div><button type="button" @onclick="()=>modifierEditor.Options.Remove(option)">Eliminar opción</button></header><div class="menu-admin-deltas"><strong>Cambios de ingredientes</strong>@foreach(var delta in option.IngredientDeltas){<div><RestaurantMaterialPicker Options="@materialOptions" @bind-Value="delta.MaterialId" Compact="true" Placeholder="Buscar material…" /><input type="number" step="0.0001" @bind="delta.QuantityDelta" title="Cantidad; negativa para quitar" /><select @bind="delta.UnitId"><option value="0">Unidad…</option>@foreach(var unit in materialCatalog.Units){<option value="@unit.Id">@unit.Code</option>}</select><button type="button" @onclick="()=>option.IngredientDeltas.Remove(delta)">×</button></div>}<button type="button" class="btn btn-sm btn-outline-secondary" @onclick="()=>AddDelta(option)">Agregar cambio</button></div></article>
        }
        <footer class="menu-admin-actions"><button type="button" class="btn btn-outline-primary" @onclick="AddOption">Agregar opción</button><button type="button" class="btn btn-primary" disabled="@isBusy" @onclick="SaveModifierAsync">Guardar modificador</button></footer>
      </section>
    </section>
  }
</main>

@code {
  private List<RestaurantSiteDto> sites=[]; private List<RestaurantProductDto> products=[]; private List<RestaurantMenuAdminDto> menus=[]; private List<RestaurantModifierAdminDto> modifiers=[]; private List<MaterialListItemDto> materials=[]; private IReadOnlyList<RestaurantMaterialOption> materialOptions=[]; private MaterialCatalogDto materialCatalog=new();
  private RestaurantMenuSaveRequest menuEditor=NewMenuEditor(); private RestaurantModifierSaveRequest modifierEditor=NewModifierEditor();
  private string tab="menus"; private string? message; private bool isError; private bool isBusy; private string CurrentRfc=>RfcState.RequireRfc();
  protected override async Task OnInitializedAsync(){await LoadAsync();}
  private async Task LoadAsync(){isBusy=true;try{var rfc=CurrentRfc;sites=(await CatalogService.GetSitesAsync(rfc)).ToList();products=(await CatalogService.GetProductsAsync(rfc)).ToList();menus=(await CatalogService.GetMenusAsync(rfc)).ToList();modifiers=(await CatalogService.GetModifierGroupsAsync(rfc)).ToList();materials=(await MaterialService.GetMaterialsAsync(new(){Rfc=rfc,Status="ACTIVO",Take=0})).ToList();materialOptions=RestaurantMaterialOption.FromMaterials(materials);materialCatalog=await MaterialService.GetCatalogAsync(rfc);}catch(Exception ex){Show(ex.Message,true);}finally{isBusy=false;}}
  private void NewMenu(){menuEditor=NewMenuEditor();menuEditor.Rfc=CurrentRfc;} private void AddSection()=>menuEditor.Sections.Add(new(){Name=$"Sección {menuEditor.Sections.Count+1}",SortOrder=menuEditor.Sections.Count}); private void AddSchedule()=>menuEditor.Schedules.Add(new(){SiteId=sites.FirstOrDefault()?.Id??0,StartsAt=new(6,0,0),EndsAt=new(23,0,0)});
  private void EditMenu(RestaurantMenuAdminDto menu)=>menuEditor=new(){Rfc=CurrentRfc,Id=menu.Id,MenuCode=menu.MenuCode,Name=menu.Name,IsPublished=menu.IsPublished,IsActive=menu.IsActive,Schedules=menu.Schedules.Select(row=>new RestaurantMenuScheduleSaveRequest{SiteId=row.SiteId,DayOfWeek=row.DayOfWeek,StartsAt=row.StartsAt,EndsAt=row.EndsAt}).ToList(),Sections=menu.Sections.Select(row=>new RestaurantMenuSectionSaveRequest{Name=row.Name,SortOrder=row.SortOrder,ProductIds=row.ProductIds.ToList()}).ToList()};
  private async Task SaveMenuAsync(){menuEditor.Rfc=CurrentRfc;await SaveAsync(()=>CatalogService.SaveMenuAsync(menuEditor),"menus");}
  private void NewModifier(){modifierEditor=NewModifierEditor();modifierEditor.Rfc=CurrentRfc;} private void AddOption()=>modifierEditor.Options.Add(new(){Name=$"Opción {modifierEditor.Options.Count+1}",SortOrder=modifierEditor.Options.Count}); private void AddDelta(RestaurantModifierOptionSaveRequest option)=>option.IngredientDeltas.Add(new(){UnitId=materialCatalog.Units.FirstOrDefault()?.Id??0,QuantityDelta=1});
  private void EditModifier(RestaurantModifierAdminDto group)=>modifierEditor=new(){Rfc=CurrentRfc,Id=group.Id,Name=group.Name,MinSelections=group.MinSelections,MaxSelections=group.MaxSelections,SortOrder=group.SortOrder,IsActive=group.IsActive,ProductIds=group.ProductIds.ToList(),Options=group.Options.Select(option=>new RestaurantModifierOptionSaveRequest{Id=option.Id,Name=option.Name,PriceDelta=option.PriceDelta,SortOrder=option.SortOrder,IngredientDeltas=option.IngredientDeltas.Select(delta=>new RestaurantModifierDeltaSaveRequest{MaterialId=delta.MaterialId,QuantityDelta=delta.QuantityDelta,UnitId=delta.UnitId}).ToList()}).ToList()};
  private async Task SaveModifierAsync(){modifierEditor.Rfc=CurrentRfc;await SaveAsync(()=>CatalogService.SaveModifierGroupAsync(modifierEditor),"modifiers");}
  private async Task SaveAsync(Func<Task<RestaurantCommandResult>> action,string selected){isBusy=true;try{var result=await action();Show(result.Message,!result.Success);if(result.Success){await LoadAsync();if(selected=="menus"&&result.EntityId.HasValue){var found=menus.FirstOrDefault(x=>x.Id==result.EntityId);if(found is not null)EditMenu(found);}if(selected=="modifiers"&&result.EntityId.HasValue){var found=modifiers.FirstOrDefault(x=>x.Id==result.EntityId);if(found is not null)EditModifier(found);}}}catch(Exception ex){Show(ex.Message,true);}finally{isBusy=false;}}
  private static void ToggleProduct(List<long> ids,long id){if(!ids.Remove(id))ids.Add(id);} private static string DayName(byte day)=>day switch{0=>"Domingo",1=>"Lunes",2=>"Martes",3=>"Miércoles",4=>"Jueves",5=>"Viernes",6=>"Sábado",_=>"Día"}; private static string FormatTime(TimeSpan value)=>value.ToString(@"hh\:mm"); private static void SetStart(RestaurantMenuScheduleSaveRequest row,object? value){if(TimeSpan.TryParse(value?.ToString(),out var time))row.StartsAt=time;} private static void SetEnd(RestaurantMenuScheduleSaveRequest row,object? value){if(TimeSpan.TryParse(value?.ToString(),out var time))row.EndsAt=time;}
  private void Show(string value,bool error){message=value;isError=error;} private static RestaurantMenuSaveRequest NewMenuEditor()=>new(){IsActive=true,Sections=[new(){Name="Principal"}]}; private static RestaurantModifierSaveRequest NewModifierEditor()=>new(){IsActive=true,MaxSelections=1,Options=[new(){Name="Opción 1"}]};
}
