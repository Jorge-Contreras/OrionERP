@page "/ajustes"
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using OrionERP.Application.Features.Ajustes
@using OrionERP.Application.Features.Reservaciones.Extras
@using OrionERP.Web.Shared
@using OrionERP.Web.State
@attribute [Authorize(Roles = "Administrador")]
@inject IAjustesService AjustesService
@inject IUiMessageService UiMessages
@inject IJSRuntime JsRuntime
@inject IUserRfcState RfcState

<PageTitle>Ajustes</PageTitle>

<div class="container-fluid py-3 ajustes-page">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
      <h1 class="h3 mb-1">Ajustes</h1>
      <p class="text-muted mb-0">Configuracion operativa para plantillas contables y automatizaciones.</p>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-2">
      <span class="badge text-bg-light border">RFC activo: @selectedRfc</span>
      <a class="btn btn-outline-secondary" href="/ajustes/catalogos">
        Catálogos
      </a>
      <button type="button" class="btn btn-outline-primary" @onclick="NewPlantilla">
        Nueva plantilla
      </button>
    </div>
  </div>

  <section class="ajustes-section mb-3">
    <div class="card shadow-sm">
      <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
          <div>
            <h2 class="h5 mb-1">Notificaciones CxCR</h2>
            <p class="text-muted mb-0">Define cuantos dias antes aparecen los vencimientos AP en el dashboard de inicio.</p>
          </div>
          <EditForm Model="GeneralSettingsEditor" OnValidSubmit="SaveGeneralSettingsAsync" class="ajustes-dashboard-settings">
            <DataAnnotationsValidator />
            <div class="d-flex flex-wrap align-items-end gap-2">
              <div>
                <label class="form-label">Dias de anticipacion</label>
                <InputNumber class="form-control ajustes-days-input" @bind-Value="GeneralSettingsEditor.ApOccurrenceNotificationDays" min="0" max="365" disabled="@isLoadingGeneralSettings" />
                <ValidationMessage For="@(() => GeneralSettingsEditor.ApOccurrenceNotificationDays)" />
              </div>
              <button type="submit" class="btn btn-primary" disabled="@(isLoadingGeneralSettings || isSavingGeneralSettings)">
                @(isSavingGeneralSettings ? "Guardando..." : "Guardar")
              </button>
            </div>
          </EditForm>
        </div>
      </div>
    </div>
  </section>

  <section class="ajustes-section mb-3">
    <div class="card shadow-sm">
      <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3">
          <div>
            <h2 class="h5 mb-1">Catálogo de extras</h2>
            <p class="text-muted mb-0">Servicios y productos disponibles para agregar a reservaciones.</p>
          </div>
          <button type="button" class="btn btn-outline-primary" @onclick="NewExtra">
            Nuevo extra
          </button>
        </div>

        <div class="row g-3">
          <div class="col-12 col-xl-5">
            <div class="d-flex flex-column gap-3">
              <div>
                <label class="form-label">Buscar</label>
                <input class="form-control"
                       type="search"
                       placeholder="Nombre o descripcion"
                       @bind="extraSearchText"
                       @bind:event="oninput"
                       @onkeydown="OnExtraSearchKeyDown" />
              </div>

              <div class="d-flex flex-wrap gap-2 align-items-center">
                <button type="button" class="btn btn-primary" @onclick="LoadExtraCatalogAsync" disabled="@isLoadingExtras">
                  @(isLoadingExtras ? "Buscando..." : "Buscar")
                </button>
                <label class="form-check d-flex align-items-center gap-2 mb-0">
                  <input class="form-check-input" type="checkbox" @bind="includeInactiveExtras" @bind:after="LoadExtraCatalogAsync" />
                  <span class="form-check-label">Incluir inactivos</span>
                </label>
              </div>

              <div class="table-responsive ajustes-extra-list">
                <table class="table table-sm table-hover align-middle mb-0">
                  <thead class="table-light">
                    <tr>
                      <th>Extra</th>
                      <th class="text-end">Precio</th>
                    </tr>
                  </thead>
                  <tbody>
                    @if (isLoadingExtras && ExtraCatalogItems.Count == 0)
                    {
                      <tr>
                        <td colspan="2" class="text-center text-muted py-4">Cargando extras...</td>
                      </tr>
                    }
                    else if (ExtraCatalogItems.Count == 0)
                    {
                      <tr>
                        <td colspan="2" class="text-center text-muted py-4">No hay extras para los filtros actuales.</td>
                      </tr>
                    }
                    else
                    {
                      @foreach (var extra in ExtraCatalogItems)
                      {
                        <tr class="@(extra.ExtraId == SelectedExtraId ? "table-primary" : null)"
                            role="button"
                            @onclick="() => SelectExtra(extra)">
                          <td>
                            <div class="fw-semibold">@extra.Name</div>
                            <div class="d-flex flex-wrap gap-1 mt-1">
                              @if (!extra.IsActive)
                              {
                                <span class="badge text-bg-secondary">Inactivo</span>
                              }
                              @if (extra.LegacyRoomId.HasValue)
                              {
                                <span class="badge text-bg-light">Migrado</span>
                              }
                            </div>
                          </td>
                          <td class="text-end">@FormatCurrency(extra.Price)</td>
                        </tr>
                      }
                    }
                  </tbody>
                </table>
              </div>
            </div>
          </div>

          <div class="col-12 col-xl-7">
            <section class="border rounded p-3 h-100">
              <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                <div>
                  <h3 class="h5 mb-1">@(ExtraEditor.ExtraId.HasValue ? "Editar extra" : "Nuevo extra")</h3>
                  @if (ExtraEditor.LegacyRoomId.HasValue)
                  {
                    <div class="text-muted small">Migrado desde Room ID @ExtraEditor.LegacyRoomId.Value.ToString(CultureInfo.InvariantCulture)</div>
                  }
                </div>
                <div class="d-flex flex-wrap gap-2">
                  @if (ExtraEditor.ExtraId.HasValue)
                  {
                    <button type="button" class="btn btn-outline-danger" @onclick="DeleteExtraAsync" disabled="@isSavingExtra">
                      Desactivar
                    </button>
                  }
                  <button type="button" class="btn btn-primary" @onclick="SaveExtraAsync" disabled="@isSavingExtra">
                    @(isSavingExtra ? "Guardando..." : "Guardar extra")
                  </button>
                </div>
              </div>

              <EditForm Model="ExtraEditor">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="row g-3">
                  <div class="col-md-8">
                    <label class="form-label">Nombre</label>
                    <InputText class="form-control" @bind-Value="ExtraEditor.Name" />
                  </div>
                  <div class="col-md-4">
                    <label class="form-label">Precio</label>
                    <InputNumber class="form-control" @bind-Value="ExtraEditor.Price" />
                  </div>
                  <div class="col-12">
                    <label class="form-label">Descripcion</label>
                    <InputTextArea class="form-control" rows="3" @bind-Value="ExtraEditor.Description" />
                  </div>
                  <div class="col-12">
                    <label class="form-check form-switch mb-0">
                      <InputCheckbox class="form-check-input" @bind-Value="ExtraEditor.IsActive" />
                      <span class="form-check-label">Activo</span>
                    </label>
                  </div>
                </div>
              </EditForm>
            </section>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="ajustes-section mb-3">
    <div class="card shadow-sm">
      <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
          <div>
            <h2 class="h5 mb-1">Cuentas contables CFDI</h2>
            <p class="text-muted mb-0">Define las cuentas por RFC para regenerar movimientos desde comprobantes CFDI.</p>
          </div>
          <button type="button"
                  class="btn btn-primary"
                  @onclick="SaveCfdiPolizaCuentaDefaultsAsync"
                  disabled="@(isLoadingCfdiDefaults || isSavingCfdiDefaults || string.IsNullOrWhiteSpace(selectedRfc))">
            @(isSavingCfdiDefaults ? "Guardando..." : "Guardar cuentas CFDI")
          </button>
        </div>

        @if (string.IsNullOrWhiteSpace(selectedRfc))
        {
          <div class="alert alert-warning mb-0" role="alert">Selecciona un RFC para configurar las cuentas CFDI.</div>
        }
        else if (isLoadingCfdiDefaults)
        {
          <div class="text-muted py-3">Cargando cuentas CFDI...</div>
        }
        else
        {
          <div class="row g-3">
            @foreach (var cuenta in CfdiDefaultsEditor.Cuentas)
            {
              <div class="col-12 col-xl-6" @key="cuenta.CuentaClave">
                <div class="border-top pt-3 h-100">
                  <label class="form-label mb-1">@cuenta.Nombre</label>
                  <div class="text-muted small mb-2">@cuenta.Descripcion</div>
                  <CuentaContablePicker
                    SelectedRfc="@selectedRfc"
                    Selection="cuenta.Selection"
                    SelectionChanged="@((CuentaContableSelection? selection) => OnCfdiDefaultSelectionChangedAsync(cuenta.CuentaClave, selection))"
                    ErrorChanged="@((string? message) => OnCfdiDefaultErrorChangedAsync(cuenta.CuentaClave, message))" />

                  @if (cuenta.Selection?.Id is not null)
                  {
                    <div class="ajustes-cfdi-selected-account mt-2">
                      <div class="d-flex flex-wrap align-items-center gap-2">
                        <span class="badge text-bg-primary">Seleccionada</span>
                        <span class="ajustes-cfdi-selected-code">@FormatCuentaCodigo(cuenta.Selection)</span>
                      </div>
                      <div class="ajustes-cfdi-selected-description">@cuenta.Selection.Descripcion</div>
                    </div>
                  }

                  @if (!string.IsNullOrWhiteSpace(cuenta.ErrorMessage))
                  {
                    <div class="text-danger small mt-2">@cuenta.ErrorMessage</div>
                  }
                </div>
              </div>
            }
          </div>
        }
      </div>
    </div>
  </section>

  <section class="ajustes-section">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3">
      <div>
        <h2 class="h5 mb-1">Plantillas contables</h2>
        <p class="text-muted mb-0">Define las lineas que se generan automaticamente en los movimientos contables.</p>
      </div>
    </div>

    <div class="row g-3">
      <div class="col-12 col-xl-4">
        <section class="card shadow-sm h-100">
          <div class="card-body">
            <div class="d-flex flex-column gap-3">
              <div>
                <label class="form-label">Buscar</label>
                <input class="form-control"
                       type="search"
                       placeholder="Nombre, descripcion o codigo"
                       @bind="searchText"
                       @bind:event="oninput"
                       @onkeydown="OnSearchKeyDown" />
              </div>

              <div class="d-flex flex-wrap gap-2 align-items-center">
                <button type="button" class="btn btn-primary" @onclick="LoadPlantillasAsync" disabled="@isLoadingList">
                  @(isLoadingList ? "Buscando..." : "Buscar")
                </button>
                <label class="form-check d-flex align-items-center gap-2 mb-0">
                  <input class="form-check-input" type="checkbox" @bind="includeInactive" @bind:after="LoadPlantillasAsync" />
                  <span class="form-check-label">Incluir inactivas</span>
                </label>
              </div>

              <div class="table-responsive ajustes-template-list">
                <table class="table table-sm table-hover align-middle mb-0">
                  <thead class="table-light">
                    <tr>
                      <th>Plantilla</th>
                      <th class="text-end">Lineas</th>
                    </tr>
                  </thead>
                  <tbody>
                    @if (isLoadingList && Plantillas.Count == 0)
                    {
                      <tr>
                        <td colspan="2" class="text-center text-muted py-4">Cargando plantillas...</td>
                      </tr>
                    }
                    else if (Plantillas.Count == 0)
                    {
                      <tr>
                        <td colspan="2" class="text-center text-muted py-4">No hay plantillas para los filtros actuales.</td>
                      </tr>
                    }
                    else
                    {
                      @foreach (var plantilla in Plantillas)
                      {
                        <tr class="@(plantilla.PlantillaContableId == SelectedPlantillaId ? "table-primary" : null)"
                            role="button"
                            @onclick="() => SelectPlantillaAsync(plantilla.PlantillaContableId)">
                          <td>
                            <div class="fw-semibold">@plantilla.Nombre</div>
                            <div class="d-flex flex-wrap gap-1 mt-1">
                              @if (!plantilla.Activa)
                              {
                                <span class="badge text-bg-secondary">Inactiva</span>
                              }
                              @if (!string.IsNullOrWhiteSpace(plantilla.TipoPoliza))
                              {
                                <span class="badge text-bg-info">@plantilla.TipoPoliza</span>
                              }
                              <span class="badge text-bg-light border">@GetContextoLabel(plantilla.Contexto)</span>
                            </div>
                          </td>
                          <td class="text-end">
                            <span class="badge text-bg-dark">@plantilla.LineCount</span>
                          </td>
                        </tr>
                      }
                    }
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </section>
      </div>

      <div class="col-12 col-xl-8">
        <section class="card shadow-sm">
          <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
              <div>
                <h3 class="h5 mb-1">@(Editor.PlantillaContableId.HasValue ? "Editar plantilla" : "Nueva plantilla")</h3>
              </div>
              <div class="d-flex flex-wrap gap-2">
                @if (Editor.PlantillaContableId.HasValue)
                {
                  <button type="button" class="btn btn-outline-danger" @onclick="DeletePlantillaAsync" disabled="@isSaving">
                    Eliminar
                  </button>
                }
                <button type="button" class="btn btn-primary" @onclick="SavePlantillaAsync" disabled="@isSaving">
                  @(isSaving ? "Guardando..." : "Guardar plantilla")
                </button>
              </div>
            </div>

            <EditForm Model="Editor">
              <DataAnnotationsValidator />
              <ValidationSummary />

              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label">Nombre</label>
                  <InputText class="form-control" @bind-Value="Editor.Nombre" />
                </div>
                <div class="col-md-3">
                  <label class="form-label">Contexto</label>
                  <InputSelect class="form-select" @bind-Value="Editor.Contexto">
                    <option value="TRANSACCION">Transacción regular</option>
                    <option value="PAGO20_RECIBIDO">Pago20 recibido</option>
                    <option value="PAGO20_EMITIDO">Pago20 emitido</option>
                  </InputSelect>
                </div>
                <div class="col-md-3">
                  <label class="form-label">Tipo de poliza</label>
                  <InputSelect class="form-select" @bind-Value="Editor.TipoPoliza">
                    <option value="">Sin tipo fijo</option>
                    @foreach (var tipo in TipoPolizaOptions)
                    {
                      <option value="@tipo">@tipo</option>
                    }
                  </InputSelect>
                </div>
                <div class="col-md-8">
                  <label class="form-label">Descripcion</label>
                  <InputText class="form-control" @bind-Value="Editor.Descripcion" />
                </div>
                <div class="col-md-4 d-flex align-items-end">
                  <label class="form-check form-switch mb-2">
                    <InputCheckbox class="form-check-input" @bind-Value="Editor.Activa" />
                    <span class="form-check-label">Activa</span>
                  </label>
                </div>
              </div>
            </EditForm>

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-4 mb-2">
              <div>
                <h4 class="h6 mb-0">Lineas de la plantilla</h4>
                <small class="text-muted">Usa Debe y Haber con monto total, subtotal o IVA calculado.</small>
              </div>
              <button type="button" class="btn btn-outline-primary btn-sm" @onclick="OpenNewLineModal">
                Agregar linea
              </button>
            </div>

            <div class="table-responsive">
              <table class="table table-sm table-hover align-middle">
                <thead class="table-light">
                  <tr>
                    <th class="text-center">#</th>
                    <th>Cuenta</th>
                    <th>Naturaleza</th>
                    <th>Monto</th>
                    <th class="text-end">Factor</th>
                    <th>Concepto</th>
                    <th class="text-end">Acciones</th>
                  </tr>
                </thead>
                <tbody>
                  @if (ActiveLines.Count == 0)
                  {
                    <tr>
                      <td colspan="7" class="text-center text-muted py-4">Agrega lineas para definir la plantilla.</td>
                    </tr>
                  }
                  else
                  {
                    @foreach (var line in ActiveLines)
                    {
                      <tr>
                        <td class="text-center">@line.Orden</td>
                        <td>
                          <div class="fw-semibold">@FormatCuentaCodigo(line)</div>
                          <small class="text-muted">@line.CuentaDescripcion</small>
                        </td>
                        <td>
                          <span class="badge @(line.Naturaleza == "DEBE" ? "text-bg-primary" : "text-bg-success")">@line.Naturaleza</span>
                        </td>
                        <td>@GetMontoTipoLabel(line.MontoTipo)</td>
                        <td class="text-end">@line.Factor.ToString("N4", CultureInfo.InvariantCulture)</td>
                        <td>@GetConceptoLabel(line)</td>
                        <td class="text-end">
                          <div class="d-inline-flex gap-1">
                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary"
                                    title="Subir"
                                    @onclick="() => MoveLine(line, -1)"
                                    disabled="@(line.Orden <= 1)">
                              <span class="oi oi-arrow-top" aria-hidden="true"></span>
                            </button>
                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary"
                                    title="Bajar"
                                    @onclick="() => MoveLine(line, 1)"
                                    disabled="@(line.Orden >= ActiveLines.Count)">
                              <span class="oi oi-arrow-bottom" aria-hidden="true"></span>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => OpenEditLineModal(line)">
                              Editar
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveLine(line)">
                              Eliminar
                            </button>
                          </div>
                        </td>
                      </tr>
                    }
                  }
                </tbody>
              </table>
            </div>
          </div>
        </section>
      </div>
    </div>
  </section>
</div>

@if (showLineModal)
{
  <div class="modal fade show d-block ajustes-modal-backdrop" tabindex="-1" role="dialog" aria-modal="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">@(LineEditor.PlantillaContableLineaId.HasValue ? "Editar linea" : "Nueva linea")</h5>
          <button type="button" class="btn-close" @onclick="CloseLineModal"></button>
        </div>
        <div class="modal-body">
          @if (!string.IsNullOrWhiteSpace(lineEditorError))
          {
            <div class="alert alert-danger" role="alert">@lineEditorError</div>
          }

          <div class="row g-3">
            <div class="col-12 col-xl-7">
              <label class="form-label">Cuenta contable</label>
              <CuentaContablePicker
                @bind-SelectedRfc="LinePickerRfc"
                Selection="LineAccountSelection"
                SelectionChanged="OnLineAccountSelectionChangedAsync"
                ErrorChanged="OnLineAccountErrorChangedAsync" />
            </div>

            <div class="col-12 col-xl-5">
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label">Naturaleza</label>
                  <InputSelect class="form-select" @bind-Value="LineEditor.Naturaleza">
                    <option value="DEBE">Debe</option>
                    <option value="HABER">Haber</option>
                  </InputSelect>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Monto</label>
                  <InputSelect class="form-select" @bind-Value="LineEditor.MontoTipo">
                    @foreach (var option in CurrentMontoTipoOptions)
                    {
                      <option value="@option.Value">@option.Label</option>
                    }
                  </InputSelect>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Factor</label>
                  <InputNumber class="form-control" @bind-Value="LineEditor.Factor" />
                </div>
                <div class="col-md-6">
                  <label class="form-label">Concepto</label>
                  <InputSelect class="form-select" @bind-Value="LineEditor.ConceptoTipo">
                    <option value="TRANSACCION">Concepto de poliza</option>
                    <option value="FIJO">Texto fijo</option>
                  </InputSelect>
                </div>
                @if (LineEditor.ConceptoTipo == "FIJO")
                {
                  <div class="col-12">
                    <label class="form-label">Concepto fijo</label>
                    <InputText class="form-control" @bind-Value="LineEditor.ConceptoFijo" />
                  </div>
                }
              </div>

              @if (LineAccountSelection?.Id is not null)
              {
                <div class="border rounded p-3 mt-3 bg-light">
                  <div class="fw-semibold">@LineAccountSelection.Descripcion</div>
                  <div class="text-muted small">@LineAccountSelection.Nivel1.@LineAccountSelection.Nivel2.@LineAccountSelection.Nivel3</div>
                </div>
              }
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" @onclick="CloseLineModal">Cancelar</button>
          <button type="button" class="btn btn-primary" @onclick="SaveLineFromModal">Guardar linea</button>
        </div>
      </div>
    </div>
  </div>
  <div class="modal-backdrop fade show"></div>
}

@code {
  private static readonly IReadOnlyList<string> TipoPolizaOptions = ["INGRESO", "EGRESO", "DIARIO"];
  private static readonly IReadOnlyList<SelectOption> TransaccionMontoTipoOptions =
  [
    new("MONTO_TOTAL", "Monto total"),
    new("SUBTOTAL_IVA_16", "Subtotal IVA 16%"),
    new("IVA_16", "IVA 16%")
  ];
  private static readonly IReadOnlyList<SelectOption> Pago20MontoTipoOptions =
  [
    new("PAGO20_TOTAL_ASIGNADO", "Pago20 total asignado"),
    new("PAGO20_SUBTOTAL", "Pago20 subtotal"),
    new("PAGO20_TRASLADO_ISR", "Pago20 traslado ISR"),
    new("PAGO20_TRASLADO_IVA", "Pago20 traslado IVA"),
    new("PAGO20_TRASLADO_IEPS", "Pago20 traslado IEPS"),
    new("PAGO20_RETENCION_ISR", "Pago20 retención ISR"),
    new("PAGO20_RETENCION_IVA", "Pago20 retención IVA"),
    new("PAGO20_RETENCION_IEPS", "Pago20 retención IEPS")
  ];

  private readonly List<ExtraCatalogItemDto> ExtraCatalogItems = [];
  private readonly List<PlantillaContableListItemDto> Plantillas = [];
  private GeneralSettingsEditorModel GeneralSettingsEditor { get; set; } = new();
  private ExtraCatalogEditorModel ExtraEditor { get; set; } = new();
  private CfdiPolizaCuentaDefaultsEditorModel CfdiDefaultsEditor { get; set; } = CfdiPolizaCuentaDefaultsEditorModel.CreateEmpty();
  private PlantillaEditorModel Editor { get; set; } = new();
  private PlantillaLineEditorModel LineEditor { get; set; } = new();
  private CuentaContableSelection? LineAccountSelection { get; set; }
  private string? LinePickerRfc { get; set; }
  private string? selectedRfc;
  private string extraSearchText = string.Empty;
  private string searchText = string.Empty;
  private bool includeInactiveExtras;
  private bool includeInactive;
  private bool isLoadingGeneralSettings;
  private bool isSavingGeneralSettings;
  private bool isLoadingExtras;
  private bool isSavingExtra;
  private bool isLoadingCfdiDefaults;
  private bool isSavingCfdiDefaults;
  private bool isLoadingList;
  private bool isSaving;
  private bool showLineModal;
  private string? lineEditorError;

  private int? SelectedExtraId => ExtraEditor.ExtraId;
