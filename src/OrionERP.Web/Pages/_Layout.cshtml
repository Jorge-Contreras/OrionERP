@using Microsoft.AspNetCore.Components.Web
@namespace OrionERP.Web.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - OrionERP</title>

    <!-- Bootstrap (elige solo UNA fuente; aquí CDN) -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <!-- CSS global del sitio -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- Si REALMENTE usas app.css, déjalo; si no, elimínalo -->
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />

    <!-- Bundle de CSS aislado (incluye Index.razor.css automáticamente) -->
    <link rel="stylesheet" href="~/OrionERP.Web.styles.css" asp-append-version="true" />

    @RenderSection("Styles", required: false)
    <component type="typeof(HeadOutlet)" render-mode="ServerPrerendered" />
</head>
<body>


    <div class="container-fluid p-0">
        @RenderBody()
    </div>

    <!-- Scripts al final (solo una vez) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/_framework/blazor.server.js"></script>
    @RenderSection("Scripts", required: false)
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
