@using System.Globalization
@using Microsoft.AspNetCore.Identity
@using OrionERP.Application.Features.Ajustes
@using OrionERP.Application.Features.CuentasPorPagar.Recurrentes
@using OrionERP.Application.Features.Logistica.PhysicalCounts
@using OrionERP.Application.Features.Reservaciones.ListaReservaciones
@using OrionERP.Infrastructure.Auth
@inject IAjustesService AjustesService
@inject IRecurrentApService RecurrentApService
@inject IOrdenTrabajoService OrdenTrabajoService
@inject IPhysicalCountService PhysicalCountService
@inject IListaReservacionesService ReservacionesService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ICurrentCompanyContext RfcState
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Inicio</PageTitle>

<div class="home-dashboard">
    <section class="home-dashboard__masthead" aria-labelledby="home-title">
        <div class="home-dashboard__masthead-copy">
            <p class="home-dashboard__eyebrow">Dashboard OrionERP</p>
            <h1 id="home-title">Centro de operacion</h1>
            <p class="home-dashboard__subtitle">@DashboardSubtitle</p>
        </div>

        <div class="home-dashboard__masthead-actions">
            <button class="btn btn-primary home-dashboard__refresh" type="button" @onclick="LoadDashboardAsync" disabled="@IsLoading">
                <span class="oi oi-reload" aria-hidden="true"></span>
                <span>@(IsLoading ? "Actualizando" : "Actualizar")</span>
            </button>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-danger">@ErrorMessage</div>
    }

    <div class="home-dashboard__layout">
        <div class="home-main">
            <section class="home-panel home-work-orders" aria-labelledby="active-orders-title">
                <div class="home-panel__header">
                    <div>
                        <p class="home-panel__kicker">Ordenes de trabajo</p>
                        <h2 id="active-orders-title">Activas para mi</h2>
                    </div>
                    <span class="home-count" aria-label="@($"{WorkOrders.Count} ordenes activas")">@WorkOrders.Count</span>
                </div>

                @if (IsLoading)
                {
                    <div class="home-empty">Cargando ordenes...</div>
                }
                else if (!IsAuthenticated)
                {
                    <div class="home-empty">Inicia sesion para ver tus ordenes activas.</div>
                }
                else if (WorkOrders.Count == 0)
                {
                    <div class="home-empty">@EmptyWorkOrdersMessage</div>
                }
                else
                {
                    <div class="home-order-list">
                        @foreach (var item in WorkOrders)
                        {
                            <a class="@GetOrderCardClass(item)" href="@($"/ordenes-trabajo/{item.Id}")">
                                <div class="home-order-card__main">
                                    <div class="home-order-card__topline">
                                        <span class="home-order-card__folio">@item.Folio</span>
                                        <span class="@GetPriorityClass(item.Prioridad)">@GetPriorityLabel(item.Prioridad)</span>
                                    </div>

                                    <h3>@item.Titulo</h3>

                                    <div class="home-order-card__meta">
                                        <span class="@GetStatusClass(item.Estado)">@GetStatusLabel(item.Estado)</span>
                                        @if (IsCreatedByMeOnly(item))
                                        {
                                            <span class="home-status home-status--authored">Creada por ti</span>
                                        }
                                        <span>@item.CategoriaNombre</span>
                                        <span>@FormatTarget(item)</span>
                                    </div>
                                </div>

                                <div class="home-order-card__schedule">
                                    <span>@FormatDate(item)</span>
                                    <small>@FormatWindow(item.HoraInicioProgramada, item.HoraFinProgramada)</small>
                                </div>

                                <div class="home-order-card__progress" aria-label="@($"{item.CompletedStepCount} de {item.StepCount} pasos completados")">
                                    <div class="home-order-card__progress-text">
                                        <span>Progreso</span>
                                        <strong>@item.CompletedStepCount / @item.StepCount</strong>
                                    </div>
                                    <div class="home-progress-track">
                                        <span style="@($"--progress:{GetProgressPercent(item)}%")"></span>
                                    </div>
                                </div>
                            </a>
                        }
                    </div>
                }

                <div class="home-panel__footer">
                    <button class="btn btn-outline-primary" type="button" @onclick="OpenOrdenesTrabajo">
                        <span class="oi oi-list" aria-hidden="true"></span>
                        <span>Abrir modulo</span>
                    </button>
                </div>
            </section>

            @if (HasCalendarioRole)
            {
                <section class="home-panel home-reservations" aria-labelledby="home-reservations-title">
                    <div class="home-panel__header">
                        <div>
                            <p class="home-panel__kicker">Reservaciones</p>
                            <h2 id="home-reservations-title">Reservaciones pagadas</h2>
                        </div>
                        <span class="home-count home-count--reservation" aria-label="@($"{UpcomingPaidReservations.Count} reservaciones pagadas")">@UpcomingPaidReservations.Count</span>
                    </div>

                    @if (IsLoading)
                    {
                        <div class="home-empty">Cargando reservaciones...</div>
                    }
                    else
                    {
                        <div class="home-reservation-days">
                            @foreach (var group in UpcomingReservationGroups)
                            {
                                <section class="home-reservation-day" aria-labelledby="@group.TitleId">
                                    <div class="home-reservation-day__header">
                                        <div>
                                            <p>@group.Label</p>
                                            <h3 id="@group.TitleId">@group.DayName</h3>
                                        </div>
                                        <span>@group.Items.Count</span>
                                    </div>

                                    @if (group.Items.Count == 0)
                                    {
                                        <div class="home-reservation-day__empty">Sin reservaciones.</div>
                                    }
                                    else
                                    {
                                        <div class="home-reservation-list">
                                            @foreach (var item in group.Items)
                                            {
                                                <a class="home-reservation-card" href="@($"/reservaciones/{item.Id}")">
                                                    <div class="home-order-card__topline">
                                                        <span class="home-order-card__folio">#@item.Id</span>
                                                        <span class="home-status home-status--paid">@item.Status</span>
                                                    </div>

                                                    <h4>@item.Cliente</h4>

                                                    <div class="home-order-card__meta">
                                                        @if (!string.IsNullOrWhiteSpace(item.Suite))
                                                        {
                                                            <span>@item.Suite</span>
                                                        }
                                                        <span>@FormatReservationStay(item)</span>
                                                        <span>@FormatReservationTotal(item)</span>
                                                    </div>
                                                </a>
                                            }
                                        </div>
                                    }
                                </section>
                            }
                        </div>
                    }

                    <div class="home-panel__footer">
                        <button class="btn btn-outline-primary" type="button" @onclick="OpenCalendario">
                            <span class="oi oi-calendar" aria-hidden="true"></span>
                            <span>Abrir calendario</span>
                        </button>
                    </div>
                </section>
            }

            @if (HasConteoRole)
            {
                <section class="home-panel home-recounts" aria-labelledby="pending-recounts-title">
                    <div class="home-panel__header">
                        <div>
                            <p class="home-panel__kicker">Conteos</p>
                            <h2 id="pending-recounts-title">Pendientes de reconteo</h2>
                        </div>
                        <span class="home-count home-count--recount" aria-label="@($"{PendingRecounts.Count} conteos pendientes de reconteo")">@PendingRecounts.Count</span>
                    </div>

                    @if (IsLoading)
                    {
                        <div class="home-empty">Cargando reconteos...</div>
                    }
                    else if (PendingRecounts.Count == 0)
                    {
                        <div class="home-empty">No hay conteos pendientes de reconteo.</div>
                    }
                    else
                    {
                        <div class="home-recount-list">
                            @foreach (var item in PendingRecounts)
                            {
                                <a class="home-order-card home-recount-card" href="@BuildPendingRecountUrl(item)">
                                    <div class="home-order-card__main">
                                        <div class="home-order-card__topline">
                                            <span class="home-order-card__folio">@item.SessionCode</span>
                                            <span class="home-status home-status--review">Reconteo</span>
                                        </div>

                                        <h3>@PhysicalCountScopeLabel.Format(item)</h3>

                                        <div class="home-order-card__meta">
                                            @if (!string.IsNullOrWhiteSpace(item.RoomName))
                                            {
                                                <span>@item.RoomName</span>
                                            }
                                            <span>@FormatRecountIssueSummary(item.IssueSummary)</span>
                                            @if (!string.IsNullOrWhiteSpace(item.RecountRequestedBy))
                                            {
                                                <span>@item.RecountRequestedBy</span>
                                            }
                                        </div>
                                    </div>

                                    <div class="home-order-card__schedule">
                                        <span>@FormatRecountRequestedAt(item)</span>
                                        <small>@($"{item.RecountLineCount} de {item.LineCount} líneas")</small>
                                    </div>
                                </a>
                            }
                        </div>
                    }

                    <div class="home-panel__footer">
                        <button class="btn btn-outline-primary" type="button" @onclick="OpenConteos">
                            <span class="oi oi-list" aria-hidden="true"></span>
                            <span>Abrir modulo</span>
                        </button>
                    </div>
                </section>
            }

            <section class="home-panel home-ap" aria-labelledby="recurrent-ap-title">
                <div class="home-panel__header">
                    <div>
                        <p class="home-panel__kicker">CxCR</p>
                        <h2 id="recurrent-ap-title">Vencidas o por vencer</h2>
                    </div>
                    <span class="home-count home-count--ap" aria-label="@($"{ApOccurrences.Count} cuentas recurrentes vencidas o por vencer")">@ApOccurrences.Count</span>
                </div>

                @if (IsLoading)
                {
                    <div class="home-empty">Cargando CxCR...</div>
                }
                else if (!IsAuthenticated)
                {
                    <div class="home-empty">Inicia sesion para ver tus cuentas recurrentes.</div>
                }
                else if (ApOccurrences.Count == 0)
                {
                    <div class="home-empty">@ApEmptyMessage</div>
                }
                else
                {
                    <div class="home-ap-list">
                        @foreach (var item in ApOccurrences)
                        {
                            <a class="@GetApCardClass(item)" href="@BuildApOccurrenceUrl(item)">
                                <div class="home-ap-card__main">
                                    <div class="home-order-card__topline">
                                        <span class="home-order-card__folio">@item.PayableName</span>
                                        <span class="@GetApStatusClass(item)">@GetApStatusLabel(item)</span>
                                    </div>

                                    <div class="home-order-card__meta">
                                        @if (!string.IsNullOrWhiteSpace(item.PayeeName))
                                        {
                                            <span>@item.PayeeName</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(item.Category))
                                        {
                                            <span>@item.Category</span>
                                        }
                                        @if (item.PaymentLinkCount > 0)
                                        {
                                            <span>@item.PaymentLinkCount poliza</span>
                                        }
                                    </div>
                                </div>

                                <div class="home-order-card__schedule">
                                    <span>@FormatApDueDate(item)</span>
                                    <small>@FormatApAmount(item)</small>
                                </div>
                            </a>
                        }
                    </div>
                }

                <div class="home-panel__footer">
                    <button class="btn btn-outline-primary" type="button" @onclick="OpenCxcr">
                        <span class="oi oi-clock" aria-hidden="true"></span>
                        <span>Abrir modulo</span>
                    </button>
                </div>
            </section>
        </div>

        <aside class="home-side" aria-label="Resumen">
            <section class="home-panel home-stats">
                <div class="home-stat">
                    <span>Vencidas</span>
                    <strong>@OverdueCount</strong>
                </div>
                <div class="home-stat">
                    <span>Revision</span>
                    <strong>@ReviewCount</strong>
                </div>
                <div class="home-stat">
                    <span>Hoy</span>
                    <strong>@TodayCount</strong>
                </div>
            </section>

            <section class="home-panel home-stats home-stats--ap">
                <div class="home-stat">
                    <span>CxCR vencidas</span>
                    <strong>@ApOverdueCount</strong>
                </div>
                <div class="home-stat">
                    <span>@ApNotificationWindowLabel</span>
                    <strong>@ApDueSoonCount</strong>
                </div>
                <div class="home-stat">
                    <span>Pendiente</span>
                    <strong>@FormatShortCurrency(ApPendingAmount)</strong>
                </div>
            </section>

            <section class="home-command-panel" aria-labelledby="home-command-title">
                <img src="Images/OrionERP_Logo.svg"
                     alt="OrionERP"
                     class="home-command-panel__logo" />

                <p class="home-command-panel__kicker">Pulso de trabajo</p>
                <h2 id="home-command-title">Lo importante, a la vista.</h2>
                <p class="home-command-panel__text">
                    Ordenes, cuentas recurrentes y reconteos quedan priorizados para avanzar sin perder contexto.
                </p>

                <div class="home-command-panel__metrics" aria-label="Resumen operativo">
                    <div>
                        <span>OT activas</span>
                        <strong>@WorkOrders.Count</strong>
                    </div>
                    <div>
                        <span>CxCR</span>
                        <strong>@ApOccurrences.Count</strong>
                    </div>
                    <div>
                        <span>Reconteos</span>
                        <strong>@PendingRecounts.Count</strong>
                    </div>
                </div>

                <div class="home-command-panel__actions" aria-label="Accesos directos">
                    <button type="button" @onclick="OpenOrdenesTrabajo" title="Abrir ordenes de trabajo">
                        <span class="oi oi-task" aria-hidden="true"></span>
                        <span>OT</span>
                    </button>
                    <button type="button" @onclick="OpenCxcr" title="Abrir CxCR">
                        <span class="oi oi-clock" aria-hidden="true"></span>
                        <span>CxCR</span>
                    </button>
                    @if (HasConteoRole)
                    {
                        <button type="button" @onclick="OpenConteos" title="Abrir conteos">
                            <span class="oi oi-list" aria-hidden="true"></span>
                            <span>Conteos</span>
                        </button>
                    }
                    @if (HasCalendarioRole)
                    {
                        <button type="button" @onclick="OpenCalendario" title="Abrir calendario de reservaciones">
                            <span class="oi oi-calendar" aria-hidden="true"></span>
                            <span>Calendario</span>
                        </button>
                    }
                </div>
            </section>
        </aside>
    </div>
</div>

@code {
    private static readonly HashSet<string> ActiveStatuses = new(StringComparer.OrdinalIgnoreCase)
    {
        OrdenTrabajoCodes.EstadoBorrador,
        OrdenTrabajoCodes.EstadoAsignada,
        OrdenTrabajoCodes.EstadoEnProceso,
        OrdenTrabajoCodes.EstadoEnRevision,
        OrdenTrabajoCodes.EstadoRechazada
    };

    private static readonly CultureInfo DateCulture = CultureInfo.GetCultureInfo("es-MX");
    private List<OrdenTrabajoListItemDto> WorkOrders { get; set; } = [];
    private List<RecurrentApOccurrenceListItemDto> ApOccurrences { get; set; } = [];
    private List<PhysicalCountPendingRecountDto> PendingRecounts { get; set; } = [];
    private List<ListaReservacionItemDto> UpcomingPaidReservations { get; set; } = [];
    private HashSet<int> CreatedByMeReviewIds { get; } = [];
    private string CurrentUserName { get; set; } = "OrionERP";
    private string? CurrentUserActor { get; set; }
    private int? CurrentEmployeeId { get; set; }
    private bool IsAuthenticated { get; set; }
    private bool HasConteoRole { get; set; }
    private bool HasCalendarioRole { get; set; }
    private bool IsLoading { get; set; }
    private string? ErrorMessage { get; set; }
    private int ApNotificationDays { get; set; } = AjustesGeneralSettingsDto.DefaultApOccurrenceNotificationDays;

    private string CurrentRfc => RfcState.RequireRfc();

    private string DashboardSubtitle => IsAuthenticated
        ? CurrentUserName
        : "Acceso personal";

    private string EmptyWorkOrdersMessage => CurrentEmployeeId.HasValue
        ? "No tienes ordenes activas asignadas ni ordenes tuyas esperando revision."
        : "Tu usuario no tiene un EmployeeId ligado en Capital Humano, asi que solo veras las ordenes que tu creaste y estan en revision.";

    private int OverdueCount => WorkOrders.Count(item => item.IsOverdue);
    private int ReviewCount => WorkOrders.Count(item => string.Equals(item.Estado, OrdenTrabajoCodes.EstadoEnRevision, StringComparison.OrdinalIgnoreCase));
    private int TodayCount => WorkOrders.Count(item => item.FechaProgramada.Date == DateTime.Today);
    private int ApOverdueCount => ApOccurrences.Count(item => item.IsOverdue);
    private int ApDueSoonCount => ApOccurrences.Count(item => item.IsDueSoon);
    private decimal ApPendingAmount => ApOccurrences.Sum(item => Math.Max((item.ExpectedAmount ?? 0m) - item.ActualPaidAmount, 0m));
    private string ApNotificationWindowLabel => ApNotificationDays == 1 ? "1 dia" : $"{ApNotificationDays} dias";
    private string ApEmptyMessage => $"No hay CxCR vencidas ni por vencer en los proximos {ApNotificationWindowLabel}.";
    private IReadOnlyList<ReservationDayGroupVm> UpcomingReservationGroups => BuildUpcomingReservationGroups();

    protected override async Task OnInitializedAsync()
    {
        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        await ResolveCurrentUserAsync();
        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
        => await LoadDashboardCoreAsync(resolveUser: true);

    private async Task LoadDashboardCoreAsync(bool resolveUser)
    {
        ErrorMessage = null;
        IsLoading = true;

        try
        {
            if (resolveUser)
            {
                await ResolveCurrentUserAsync();
            }

            if (IsAuthenticated)
            {
                await LoadApNotificationSettingsAsync();
            }
            await LoadWorkOrdersForCurrentUserAsync();
            await LoadUpcomingPaidReservationsAsync();
            await LoadPendingRecountsAsync();
            await LoadApOccurrencesAsync();
        }
        catch (Exception ex)
        {
            WorkOrders.Clear();
            ApOccurrences.Clear();
            PendingRecounts.Clear();
            UpcomingPaidReservations.Clear();
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task LoadWorkOrdersForCurrentUserAsync()
    {
        CreatedByMeReviewIds.Clear();

        if (!IsAuthenticated)
        {
            WorkOrders.Clear();
            return;
        }

        IReadOnlyList<OrdenTrabajoListItemDto> assigned = CurrentEmployeeId.HasValue
            ? await OrdenTrabajoService.SearchWorkOrdersAsync(new OrdenTrabajoSearchFilter
            {
                Rfc = CurrentRfc,
                ParticipantEmployeeId = CurrentEmployeeId,
                IncludeClosed = false,
                Take = 100
            })
            : Array.Empty<OrdenTrabajoListItemDto>();

        // Ordenes que este usuario creo y ya estan esperando revision: no las ejecuta el,
        // pero sigue siendo el responsable de que avancen.
        IReadOnlyList<OrdenTrabajoListItemDto> createdPendingReview = CurrentUserActor is null
            ? Array.Empty<OrdenTrabajoListItemDto>()
            : await OrdenTrabajoService.SearchWorkOrdersAsync(new OrdenTrabajoSearchFilter
            {
                Rfc = CurrentRfc,
                CreatedByActor = CurrentUserActor,
                Estado = OrdenTrabajoCodes.EstadoEnRevision,
                IncludeClosed = false,
                Take = 100
            });

        var merged = new Dictionary<int, OrdenTrabajoListItemDto>();
        foreach (var item in assigned.Where(item => ActiveStatuses.Contains(item.Estado)))
        {
            merged[item.Id] = item;
        }

        foreach (var item in createdPendingReview)
        {
            if (merged.TryAdd(item.Id, item))
            {
                CreatedByMeReviewIds.Add(item.Id);
            }
        }

        WorkOrders = merged.Values
            .OrderByDescending(item => item.IsOverdue)
            .ThenBy(item => item.FechaVencimiento ?? item.FechaProgramada)
            .ThenBy(item => GetPriorityRank(item.Prioridad))
            .ThenBy(item => item.Folio)
            .ToList();
    }

    private bool IsCreatedByMeOnly(OrdenTrabajoListItemDto item)
        => CreatedByMeReviewIds.Contains(item.Id);

    private async Task LoadApOccurrencesAsync()
    {
        if (!IsAuthenticated)
        {
            ApOccurrences.Clear();
            return;
        }

        var today = DateTime.Today;
        var notificationDays = Math.Clamp(
            ApNotificationDays,
            AjustesGeneralSettingsDto.MinApOccurrenceNotificationDays,
            AjustesGeneralSettingsDto.MaxApOccurrenceNotificationDays);
        var workspace = await RecurrentApService.GetWorkspaceAsync(new RecurrentApFilter
        {
            Rfc = CurrentRfc,
            ToDate = today.AddDays(notificationDays),
            DueSoonDays = notificationDays,
            OpenOnly = true,
            Take = 500
        });

        ApOccurrences = workspace.Occurrences
            .Where(item => string.Equals(item.Status, RecurrentApStatuses.Pending, StringComparison.OrdinalIgnoreCase)
                || string.Equals(item.Status, RecurrentApStatuses.PartiallyPaid, StringComparison.OrdinalIgnoreCase))
            .Where(item => item.IsOverdue || item.IsDueSoon)
            .OrderByDescending(item => item.IsOverdue)
            .ThenBy(item => item.DueDate)
            .ThenBy(item => item.PayableName)
            .ToList();
    }

    private async Task LoadPendingRecountsAsync()
    {
        if (!IsAuthenticated || !HasConteoRole)
        {
            PendingRecounts.Clear();
            return;
        }

        PendingRecounts = (await PhysicalCountService.GetPendingRecountsAsync())
            .OrderByDescending(item => item.RecountRequestedAt)
            .ThenBy(item => item.SessionCode)
            .ToList();
    }

    private async Task LoadUpcomingPaidReservationsAsync()
    {
        if (!IsAuthenticated || !HasCalendarioRole)
        {
            UpcomingPaidReservations.Clear();
            return;
        }

        var syncResult = await ReservacionesService.SyncPaidReservationStatusesAsync();
        if (!syncResult.Success)
        {
            ErrorMessage = syncResult.Message;
        }

        UpcomingPaidReservations = (await ReservacionesService.GetUpcomingPaidReservationsAsync(DateTime.Today, 3))
            .OrderBy(item => item.RoomDate ?? DateTime.MaxValue)
            .ThenBy(item => item.CheckIn ?? DateTime.MaxValue)
            .ThenBy(item => item.Id)
            .ToList();
    }

    private async Task LoadApNotificationSettingsAsync()
    {
        var settings = await AjustesService.GetGeneralSettingsAsync();
        ApNotificationDays = settings.ApOccurrenceNotificationDays;
    }

    private async Task ResolveCurrentUserAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        await ApplyAuthenticationStateAsync(authState);
    }

    private async Task ApplyAuthenticationStateAsync(AuthenticationState authState)
    {
        var principal = authState.User;
        IsAuthenticated = principal.Identity?.IsAuthenticated == true;
        HasConteoRole = IsAuthenticated
            && (principal.IsInRole("Administrador")
                || principal.IsInRole("Logistica")
                || principal.IsInRole("Conteo"));
        HasCalendarioRole = IsAuthenticated
            && (principal.IsInRole("Administrador")
                || principal.IsInRole("SatOperator")
                || principal.IsInRole("OrdenTrabajoOperador")
                || principal.IsInRole("Arrendadores"));
        CurrentUserActor = principal.Identity?.Name?.Trim() switch
        {
            { Length: > 0 } name => name,
            _ => null
        };
        CurrentUserName = CurrentUserActor ?? "OrionERP";

        if (!IsAuthenticated)
        {
            CurrentEmployeeId = null;
            CurrentUserActor = null;
            HasCalendarioRole = false;
            CreatedByMeReviewIds.Clear();
            WorkOrders.Clear();
            ApOccurrences.Clear();
            PendingRecounts.Clear();
            UpcomingPaidReservations.Clear();
            return;
        }

        CurrentEmployeeId = int.TryParse(principal.FindFirst("employee_id")?.Value, out var employeeId) ? employeeId : null;
    }

    private void OpenOrdenesTrabajo()
        => Navigation.NavigateTo("/ordenes-trabajo");

    private void OpenCxcr()
        => Navigation.NavigateTo("/cuentas-por-pagar/recurrentes");

    private void OpenConteos()
        => Navigation.NavigateTo("/logistica/conteos");

    private void OpenCalendario()
        => Navigation.NavigateTo("/reservaciones/calendario");

    private static string BuildApOccurrenceUrl(RecurrentApOccurrenceListItemDto item)
        => $"/cuentas-por-pagar/recurrentes?occurrenceId={item.Id}";

    private static string BuildPendingRecountUrl(PhysicalCountPendingRecountDto item)
        => $"/logistica/conteos?sessionId={item.Id}";

    private static string FormatDate(OrdenTrabajoListItemDto item)
    {
        var targetDate = item.FechaVencimiento ?? item.FechaProgramada;
        return targetDate.Date == DateTime.Today
            ? "Hoy"
            : targetDate.ToString("dd MMM", DateCulture);
    }

    private static string FormatApDueDate(RecurrentApOccurrenceListItemDto item)
        => item.DueDate.Date == DateTime.Today
            ? "Hoy"
            : item.DueDate.ToString("dd MMM", DateCulture);

    private IReadOnlyList<ReservationDayGroupVm> BuildUpcomingReservationGroups()
    {
        var today = DateTime.Today;
        return Enumerable.Range(0, 3)
            .Select(offset =>
            {
                var date = today.AddDays(offset);
                var items = UpcomingPaidReservations
                    .Where(item => item.RoomDate?.Date == date)
                    .OrderBy(item => item.RoomDate)
                    .ThenBy(item => item.CheckIn)
                    .ThenBy(item => item.Id)
                    .ToList();

                return new ReservationDayGroupVm(
                    $"reservation-day-{offset}",
                    GetReservationGroupLabel(offset),
                    date.ToString("dddd", DateCulture),
                    items);
            })
            .ToList();
    }

    private static string GetReservationGroupLabel(int offset)
        => offset switch
        {
            0 => "Hoy",
            1 => "Mañana",
            2 => "Pasado Mañana",
            _ => "Próxima"
        };

    private static string FormatReservationStay(ListaReservacionItemDto item)
    {
        if (!item.CheckIn.HasValue)
        {
            return "Sin fecha";
        }

        return item.CheckOut.HasValue
            ? $"{item.CheckIn.Value.ToString("dd MMM", DateCulture)} - {item.CheckOut.Value.ToString("dd MMM", DateCulture)}"
            : item.CheckIn.Value.ToString("dd MMM", DateCulture);
    }

    private static string FormatReservationTotal(ListaReservacionItemDto item)
        => item.TotalPrice.ToString("C2", DateCulture);

    private static string FormatRecountRequestedAt(PhysicalCountPendingRecountDto item)
        => item.RecountRequestedAt.ToLocalTime().Date == DateTime.Today
            ? "Hoy"
            : item.RecountRequestedAt.ToLocalTime().ToString("dd MMM", DateCulture);

    private static string FormatRecountIssueSummary(string? issueSummary)
    {
        var labels = (issueSummary ?? string.Empty)
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(GetRecountIssueLabel)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        return labels.Count == 0 ? "Sin incidencia" : string.Join(", ", labels);
    }

    private static string FormatApAmount(RecurrentApOccurrenceListItemDto item)
    {
        var pending = Math.Max((item.ExpectedAmount ?? 0m) - item.ActualPaidAmount, 0m);
        return pending > 0 ? pending.ToString("C2", DateCulture) : "Sin monto";
    }

    private static string FormatShortCurrency(decimal value)
        => value >= 1000000m
            ? (value / 1000000m).ToString("$0.#M", CultureInfo.InvariantCulture)
            : value >= 1000m
                ? (value / 1000m).ToString("$0.#K", CultureInfo.InvariantCulture)
                : value.ToString("$0", CultureInfo.InvariantCulture);

    private static string FormatWindow(TimeSpan? start, TimeSpan? end)
        => start.HasValue && end.HasValue
            ? $"{start.Value:hh\\:mm} - {end.Value:hh\\:mm}"
            : "Sin ventana";

    private static string FormatTarget(OrdenTrabajoListItemDto item)
    {
        if (!string.IsNullOrWhiteSpace(item.RoomName))
        {
            return item.RoomName;
        }

        return string.IsNullOrWhiteSpace(item.Ubicacion) ? "Sin ubicacion" : item.Ubicacion;
    }

    private static int GetProgressPercent(OrdenTrabajoListItemDto item)
    {
        if (item.StepCount <= 0)
        {
            return 0;
        }

        return Math.Clamp((int)Math.Round(item.CompletedStepCount * 100m / item.StepCount), 0, 100);
    }

    private static int GetPriorityRank(string? priority)
        => priority switch
        {
            OrdenTrabajoCodes.PrioridadUrgente => 0,
            OrdenTrabajoCodes.PrioridadAlta => 1,
            OrdenTrabajoCodes.PrioridadNormal => 2,
            OrdenTrabajoCodes.PrioridadBaja => 3,
            _ => 4
        };

