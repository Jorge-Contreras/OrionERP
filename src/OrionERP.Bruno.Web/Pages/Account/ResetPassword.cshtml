@page "/cuenta/nueva-contrasena"
@model OrionERP.Bruno.Web.Pages.Account.ResetPasswordModel
@{ ViewData["Title"] = "Nueva contraseña · Club Bruno"; }
<div class="account-shell"><div class="account-art"></div><section class="account-panel"><span>Club Bruno</span><h1>Nueva contraseña</h1>
@if (Model.Completed) { <p class="account-success">Tu contraseña quedó actualizada.</p><a class="button button--accent" href="/cuenta/acceso">Entrar</a> }
else { <form method="post" class="account-form"><input type="hidden" asp-for="Input.Code" /><div asp-validation-summary="ModelOnly"></div><label>Correo <input asp-for="Input.Email" autocomplete="email" /><span asp-validation-for="Input.Email"></span></label><label>Nueva contraseña <input asp-for="Input.Password" autocomplete="new-password" aria-describedby="password-help" /><small id="password-help">Usa 8 caracteres o más. No necesitas combinar mayúsculas, minúsculas ni números.</small><span asp-validation-for="Input.Password"></span></label><label>Confirmar contraseña <input asp-for="Input.ConfirmPassword" autocomplete="new-password" /><span asp-validation-for="Input.ConfirmPassword"></span></label><button class="button button--accent" type="submit">Guardar contraseña</button></form> }
</section></div><partial name="_ValidationScriptsPartial" />
