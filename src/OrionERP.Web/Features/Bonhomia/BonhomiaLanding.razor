    private DayState GetCalendarDayState(DateOnly day)
    {
        if (day < Today)
        {
            return DayState.Past;
        }

        var availability = SelectedRoom?.Days.FirstOrDefault(item => item.Date == day);
        if (availability?.IsAvailable == true)
        {
            return DayState.Available;
        }

        return DayState.Unavailable;
    }

    private string GetCalendarDayClass(DateOnly day, DayState state)
    {
        var classes = new List<string> { "bonhomia-day" };
        classes.Add(state switch
        {
            DayState.Available => "bonhomia-day--available",
            DayState.Unavailable => "bonhomia-day--unavailable",
            _ => "bonhomia-day--past"
