@page "/ordenes-trabajo/plantillas"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Administrador,OrdenTrabajoAdmin,OrdenTrabajoSupervisor")]

<PageTitle>Plantillas de ordenes</PageTitle>

<div class="container-fluid py-3 orden-template-page">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <a class="small" href="/ordenes-trabajo">Volver a ordenes</a>
            <h1 class="h3 mb-1">Plantillas de ordenes de trabajo</h1>
            <p class="text-muted mb-0">Versiones publicadas, pasos y mapeo de suites para limpieza.</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary" type="button" @onclick="SeedLegacyAsync" disabled="@IsMutating">Seed limpieza legacy</button>
            <button class="btn btn-outline-secondary" type="button" @onclick="SeedLegacyChecklistsAsync" disabled="@IsMutating">Importar checklists legacy</button>
            <button class="btn btn-primary" type="button" @onclick="NewTemplate">Nueva plantilla</button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-danger">@ErrorMessage</div>
    }

    @if (SelectedTemplate is not null)
    {
        <section class="card shadow-sm mb-3">
            <div class="card-body">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                    <div>
                        <h2 class="h5 mb-1">Crear orden desde plantilla</h2>
                        <div class="small text-muted">
                            Se usara la version publicada de @SelectedTemplate.Nombre.
                        </div>
                    </div>
                    @if (!CanCreateFromSelectedTemplate)
                    {
                        <span class="badge text-bg-warning">Requiere plantilla activa y publicada</span>
                    }
                </div>

                @if (!CanCreateFromSelectedTemplate)
                {
                    <div class="alert alert-info mb-0">
                        Publica la plantilla y mantenla activa para crear ordenes de trabajo reales desde ella.
                    </div>
                }
                else
                {
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label">Titulo</label>
                            <InputText class="form-control" @bind-Value="CreateRequest.Titulo" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Prioridad</label>
                            <select class="form-select" @bind="CreateRequest.Prioridad">
                                <option value="NORMAL">Normal</option>
                                <option value="BAJA">Baja</option>
                                <option value="ALTA">Alta</option>
                                <option value="URGENTE">Urgente</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Responsable</label>
                            <select class="form-select" @bind="CreateRequest.OwnerEmployeeId">
                                <option value="0">Selecciona responsable</option>
                                @foreach (var employee in Employees)
                                {
                                    <option value="@employee.Id">@employee.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Fecha</label>
                            <InputDate class="form-control" @bind-Value="CreateRequest.FechaProgramada" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Vence</label>
                            <InputDate class="form-control" @bind-Value="CreateRequest.FechaVencimiento" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Ayudantes</label>
                            <div class="d-flex flex-wrap gap-3">
                                @foreach (var employee in Employees)
                                {
                                    <label class="form-check mb-0">
                                        <input class="form-check-input" type="checkbox" checked="@CreateHelperIds.Contains(employee.Id)" @onchange="args => ToggleCreateHelper(employee.Id, args)" />
                                        <span class="form-check-label">@employee.Name</span>
                                    </label>
                                }
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Ubicacion</label>
                            <InputText class="form-control" @bind-Value="CreateRequest.Ubicacion" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Costo estimado</label>
                            <InputNumber class="form-control" @bind-Value="CreateRequest.EstimatedCost" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Descripcion</label>
                            <InputTextArea class="form-control" rows="2" @bind-Value="CreateRequest.Descripcion" />
                        </div>
                    </div>
                    <button class="btn btn-primary mt-3" type="button" @onclick="CreateFromTemplateAsync" disabled="@IsCreating">
                        @(IsCreating ? "Creando..." : "Crear orden")
                    </button>
                }
            </div>
        </section>
    }

    <div class="row g-3">
        <div class="col-12 col-xl-4">
            <section class="card shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h2 class="h5 mb-0">Catalogo</h2>
                        <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="LoadAsync" disabled="@IsLoading">Actualizar</button>
                    </div>
                    <div class="row g-2 align-items-end mb-3">
                        <div class="col-12">
                            <label class="form-label">Categoria</label>
                            <select class="form-select" @bind="SelectedCategoryCode">
                                <option value="">Todas</option>
                                @foreach (var category in Categories)
                                {
                                    <option value="@category.Codigo">@category.Nombre</option>
                                }
                            </select>
                        </div>
                        <div class="col-6 d-grid">
                            <button class="btn btn-outline-primary btn-sm" type="button" @onclick="ApplyCategoryFilterAsync" disabled="@IsLoading">Filtrar</button>
                        </div>
                        <div class="col-6 d-grid">
                            <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="ResetCategoryFilterAsync" disabled="@IsLoading">Todas</button>
                        </div>
                    </div>
                    <div class="list-group">
                        @if (Templates.Count == 0)
                        {
                            <div class="list-group-item text-center text-muted py-3">No hay plantillas para mostrar.</div>
                        }
                        else
                        {
                            @foreach (var template in Templates)
                            {
                                <button class="@GetTemplateListClass(template)" type="button" @onclick="() => SelectTemplateAsync(template.Id)">
                                    <div class="d-flex justify-content-between gap-2">
                                        <strong>@template.Nombre</strong>
                                        <span class="badge text-bg-light">@template.CategoriaNombre</span>
                                    </div>
                                    <div class="small text-muted">
                                        Publicada: @(template.PublishedVersionNumber?.ToString() ?? "-") · Pasos publicados: @template.StepCount
                                    </div>
                                    <div class="d-flex flex-wrap gap-1 mt-2">
                                        @if (template.PublishedVersionId.HasValue)
                                        {
                                            <span class="badge text-bg-success">Publicada v@(template.PublishedVersionNumber)</span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-warning">Sin publicar</span>
                                        }
                                        @if (template.DraftVersionCount > 0)
                                        {
                                            <span class="badge text-bg-info">@template.DraftVersionCount borrador(es)</span>
                                        }
                                        @if (!template.Activa)
                                        {
                                            <span class="badge text-bg-secondary">Inactiva</span>
                                        }
                                    </div>
                                </button>
                            }
                        }
                    </div>
                </div>
            </section>
        </div>

        <div class="col-12 col-xl-8">
            <section class="card shadow-sm mb-3">
                <div class="card-body">
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                        <div>
                            <h2 class="h5 mb-1">Editor</h2>
                            @if (SelectedTemplate is not null)
                            {
                                <div class="d-flex flex-wrap gap-1">
                                    <span class="badge text-bg-light">@SelectedTemplate.CategoriaNombre</span>
                                    @if (SelectedTemplate.PublishedVersionId.HasValue)
                                    {
                                        <span class="badge text-bg-success">Publicada v@(SelectedTemplate.PublishedVersionNumber)</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-warning">Sin version publicada</span>
                                    }
                                    @if (SelectedTemplate.DraftVersionId.HasValue)
                                    {
                                        <span class="badge text-bg-info">Borrador v@(SelectedTemplate.DraftVersionNumber)</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">Sin borrador</span>
                                    }
                                </div>
                            }
                        </div>
                        @if (SelectedTemplate is not null)
                        {
                            <button class="btn btn-outline-primary btn-sm" type="button" @onclick="PrepareCreateFromTemplate" disabled="@(!CanCreateFromSelectedTemplate || IsCreating)">
                                Usar para orden
                            </button>
                        }
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Nombre</label>
                            <InputText class="form-control" @bind-Value="Editor.Nombre" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Categoria</label>
                            <select class="form-select" @bind="Editor.CategoriaCodigo">
                                @foreach (var category in Categories)
                                {
                                    <option value="@category.Codigo">@category.Nombre</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Activa</label>
                            <div class="form-check mt-2">
                                <InputCheckbox class="form-check-input" @bind-Value="Editor.Activa" />
                                <span class="form-check-label">Disponible</span>
                            </div>
                        </div>
                    </div>

                    <hr />

                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                        <h3 class="h6 mb-0">Pasos del borrador actual</h3>
                        @if (SelectedTemplate is not null)
                        {
                            <span class="small text-muted">
                                @(SelectedTemplate.DraftVersionId.HasValue ? $"Borrador v{SelectedTemplate.DraftVersionNumber}" : "Editando nuevo borrador")
                            </span>
                        }
                    </div>
                    <div class="orden-template-steps mb-3">
                        @if (Editor.Steps.Count == 0)
                        {
                            <div class="text-center text-muted py-3">Agrega al menos un paso.</div>
                        }
                        else
                        {
                            @for (var index = 0; index < Editor.Steps.Count; index++)
                            {
                                var step = Editor.Steps[index];
                                <article class="orden-template-step">
                                    <div class="orden-template-step__meta">
                                        <div>
                                            <label class="form-label">Orden</label>
                                            <InputNumber class="form-control form-control-sm" @bind-Value="step.Secuencia" />
                                        </div>
                                        <div>
                                            <label class="form-label">Foto</label>
                                            <select class="form-select form-select-sm" @bind="step.PoliticaFoto">
                                                <option value="NO_PERMITIDA">No permitida</option>
                                                <option value="OPCIONAL">Opcional</option>
                                                <option value="REQUERIDA">Requerida</option>
                                            </select>
                                        </div>
                                        <button class="btn btn-sm btn-outline-danger" type="button" @onclick="() => RemoveStep(step)">Quitar</button>
                                    </div>
                                    <div class="orden-template-step__body">
                                        <div>
                                            <label class="form-label">Titulo</label>
                                            <InputTextArea class="form-control form-control-sm orden-template-step__title" rows="2" @bind-Value="step.Titulo" />
                                        </div>
                                        <div>
                                            <label class="form-label">Descripcion</label>
                                            <InputTextArea class="form-control form-control-sm orden-template-step__description" rows="4" @bind-Value="step.Descripcion" />
                                        </div>
                                    </div>
                                </article>
                            }
                        }
                    </div>

                    <div class="row g-2 align-items-end mb-3">
                        <div class="col-md-2">
                            <label class="form-label">Orden</label>
                            <InputNumber class="form-control" @bind-Value="NewStep.Secuencia" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Titulo</label>
                            <InputTextArea class="form-control orden-template-step__title" rows="2" @bind-Value="NewStep.Titulo" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Descripcion</label>
                            <InputTextArea class="form-control orden-template-step__description" rows="4" @bind-Value="NewStep.Descripcion" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Foto</label>
                            <select class="form-select" @bind="NewStep.PoliticaFoto">
                                <option value="NO_PERMITIDA">No</option>
                                <option value="OPCIONAL">Opcional</option>
                                <option value="REQUERIDA">Req.</option>
                            </select>
                        </div>
                        <div class="col-md-1 d-grid">
                            <button class="btn btn-outline-primary" type="button" @onclick="AddStep">+</button>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        <button class="btn btn-primary" type="button" @onclick="SaveDraftAsync" disabled="@IsMutating">Guardar borrador</button>
                        <button class="btn btn-success" type="button" @onclick="PublishAsync" disabled="@(!Editor.TemplateId.HasValue || IsMutating)">Publicar</button>
                    </div>
                </div>
            </section>

            @if (SelectedTemplate is not null)
            {
                <section class="card shadow-sm">
                    <div class="card-body">
                        <h2 class="h5 mb-3">Mapeo de suites para limpieza</h2>
                        @if (SelectedTemplate.CategoriaCodigo != "LIMPIEZA")
                        {
                            <div class="alert alert-info mb-0">Solo las plantillas de limpieza se pueden mapear a suites.</div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Suite</th>
                                            <th>Plantilla actual</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var room in SelectedTemplate.RoomMappings)
                                        {
                                            <tr>
                                                <td>@room.RoomName</td>
                                                <td>@(room.TemplateName ?? "Sin plantilla")</td>
                                                <td class="text-end">
                                                    <button class="btn btn-sm btn-outline-primary" type="button" @onclick="() => MapRoomAsync(room.RoomId)" disabled="@IsMutating">
                                                        Usar esta plantilla
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </section>
            }
        </div>
    </div>
</div>
