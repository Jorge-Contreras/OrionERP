@using Microsoft.JSInterop
@using OrionERP.Application.Features.Cfdi.DeclaracionPrevia
@using OrionERP.Web.Services
@using OrionERP.Web.State
@inject IConfiguration Configuration
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IDeclaracionPreviaService DeclaracionService
@inject IUserRfcState RfcState
@inject IUiMessageService UiMessages

<td>
    <button class="btn btn-sm btn-outline-info"
            @onclick:stopPropagation="true"
            @onclick="OpenDetails">
        CFDI-@Item.Comprobante_Id
    </button>
</td>
<td>
    <button class="btn btn-sm @(IsPlaceholderPoliza ? "btn-outline-danger" : "btn-outline-success")"
            title="@(IsPlaceholderPoliza ? "Buscar Póliza" : "Ir a Transacción")"
            @onclick:stopPropagation="true"
            @onclick="HandlePolizaClick">
        @(IsPlaceholderPoliza ? "Buscar" : ItemPoliza)
    </button>
</td>

@code {

    [Parameter]
    public IDeclaracionComprobanteItem Item { get; set; } = default!;

    private int? PlaceholderTransaccionId => _placeholderTransaccionId ??= ParsePlaceholder(Configuration["SatXml:PlaceholderTransaccionId"]);
    private int? _placeholderTransaccionId;

    private string? ItemPoliza => Item.Poliza;

    private bool IsPlaceholderPoliza => PlaceholderTransaccionId.HasValue && ItemPoliza == PlaceholderTransaccionId.Value.ToString();

    private async Task OpenDetails()
    {
        if (Item.XML_Attachment_ID is null)
        {
            return;
        }

        var url = $"/cfdi/html-cfdi/{Item.XML_Attachment_ID}";

        try
        {
            await JS.InvokeVoidAsync("open", url, "_blank", "noopener,noreferrer");
        }
        catch
        {
            Nav.NavigateTo(url);
        }
    }

    private async Task HandlePolizaClick()
    {
        if (IsPlaceholderPoliza)
        {
            var url = $"/cfdi/LigarCFDI_Poliza/{Item.Comprobante_Id}";

            try
            {
                await JS.InvokeVoidAsync("open", url, "_blank", "noopener,noreferrer");
            }
            catch
            {
                Nav.NavigateTo(url);
            }
        }
        else
        {
            await OpenLinkedTransaction();
        }
    }

    private async Task OpenLinkedTransaction()
    {
       

        var url = $"/Contabilidad/transacciones/{Item.Poliza}";

        try
        {
            await JS.InvokeVoidAsync("open", url, "_blank", "noopener,noreferrer");
        }
        catch
        {
            Nav.NavigateTo(url);
        }
    }

    private static int? ParsePlaceholder(string? placeholderSetting)
    {
        return int.TryParse(placeholderSetting, out var parsedPlaceholder) ? parsedPlaceholder : null;
    }
}
