@page "/logistica/materiales"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@attribute [Authorize(Roles = "Administrador,Logistica")]

<PageTitle>Materiales · Logística</PageTitle>

<div class="container-fluid py-3 py-lg-4 materiales-page">
    <header class="materiales-hero">
        <div class="materiales-hero-copy">
            <div class="materiales-eyebrow">
                <i class="bi bi-box-seam" aria-hidden="true"></i>
                Maestro de materiales
            </div>
            <h1>Materiales listos para operar</h1>
            <p>Busca, completa y da de alta materiales sin abandonar tu flujo. Categorías, unidades y proveedores se crean justo cuando los necesitas.</p>
        </div>
        <div class="materiales-hero-actions">
            <a class="btn btn-light materiales-hero-secondary" href="/logistica/proveedores">
                <i class="bi bi-buildings" aria-hidden="true"></i>
                Gestionar proveedores
            </a>
            <button type="button" class="btn btn-primary materiales-primary-action" @onclick="NuevoMaterial">
                <i class="bi bi-plus-lg" aria-hidden="true"></i>
                Nuevo material
            </button>
        </div>
        <div class="materiales-hero-metrics" aria-label="Resumen de la vista actual">
            <div class="materiales-hero-metric">
                <span>En esta vista</span>
                <strong>@Materials.Count</strong>
                <small>@(HasMoreMaterials ? "Hay más resultados" : "materiales cargados")</small>
            </div>
            <div class="materiales-hero-metric">
                <span>Con existencia</span>
                <strong>@LoadedWithStockCount</strong>
                <small>listos para surtir</small>
            </div>
            <div class="materiales-hero-metric @(LoadedMissingVendorCount > 0 ? "needs-attention" : null)">
                <span>Sin proveedor</span>
                <strong>@LoadedMissingVendorCount</strong>
                <small>requieren compra</small>
            </div>
            <div class="materiales-hero-metric @(LoadedMissingImageCount > 0 ? "needs-attention" : null)">
                <span>Sin imagen</span>
                <strong>@LoadedMissingImageCount</strong>
                <small>por completar</small>
            </div>
        </div>
    </header>

    <div class="row g-3 g-xxl-4 materiales-workspace">
        <div class="col-12 col-xl-5 col-xxl-4">
            <section class="materiales-panel materiales-catalog-panel">
                <div class="materiales-panel-heading">
                    <div>
                        <span class="materiales-step">1 · Encuentra</span>
                        <h2>Catálogo</h2>
                        <p>Escribe tu búsqueda y presiona Enter.</p>
                    </div>
                    <button type="button"
                            class="materiales-icon-button"
                            title="Actualizar catálogo"
                            aria-label="Actualizar catálogo"
                            disabled="@IsListBusy"
                            @onclick="BuscarAsync">
                        <i class="bi bi-arrow-clockwise @(IsBusy ? "spin" : null)" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="materiales-search-shell">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <input type="search"
                           autocomplete="off"
                           placeholder="Nombre, código, barras o código de proveedor"
                           value="@Filter.SearchText"
                           aria-label="Buscar materiales"
                           @oninput="OnSearchInput"
                           @onkeyup="OnSearchKeyUpAsync" />
                    @if (!string.IsNullOrWhiteSpace(Filter.SearchText))
                    {
                        <button type="button" title="Limpiar búsqueda" aria-label="Limpiar búsqueda" @onclick="ClearSearchAsync">
                            <i class="bi bi-x-lg" aria-hidden="true"></i>
                        </button>
                    }
                    @if (IsBusy)
                    {
                        <span class="materiales-search-progress" aria-label="Buscando"></span>
                    }
                </div>

                <div class="materiales-quick-filters" aria-label="Filtros rápidos">
                    <button type="button"
                            class="@GetFilterChipClass(string.Equals(Filter.Status, "ACTIVO", StringComparison.OrdinalIgnoreCase))"
                            @onclick='() => ToggleStatusFilterAsync("ACTIVO")'>
                        <i class="bi bi-check-circle" aria-hidden="true"></i>
                        Activos
                    </button>
                    <button type="button"
                            class="@GetFilterChipClass(Filter.HasStock == false)"
                            @onclick="() => SetStockFilterAsync(false)">
                        <i class="bi bi-0-circle" aria-hidden="true"></i>
                        Sin existencia
                    </button>
                    <button type="button"
                            class="@GetFilterChipClass(Filter.HasImage == false)"
                            @onclick="() => SetImageFilterAsync(false)">
                        <i class="bi bi-image" aria-hidden="true"></i>
                        Sin foto
                    </button>
                    <button type="button"
                            class="@GetFilterChipClass(Filter.NeedsAttention)"
                            @onclick="ToggleNeedsAttentionAsync">
                        <i class="bi bi-stars" aria-hidden="true"></i>
                        Por completar
                    </button>
                    @if (IsAdministrator)
                    {
                        <label class="materiales-inactive-filter">
                            <input type="checkbox"
                                   checked="@ShowInactiveMaterials"
                                   @onchange="async _ => await ToggleInactiveMaterialsAsync()" />
                            <span>Mostrar materiales desactivados</span>
                        </label>
                    }
                </div>

                <div class="materiales-filter-actions">
                    <button type="button"
                            class="materiales-filter-toggle"
                            aria-expanded="@ShowAdvancedFilters"
                            @onclick="ToggleAdvancedFilters">
                        <i class="bi bi-sliders" aria-hidden="true"></i>
                        Más filtros
                        @if (ActiveFilterCount > 0)
                        {
                            <span>@ActiveFilterCount</span>
                        }
                        <i class="bi @(ShowAdvancedFilters ? "bi-chevron-up" : "bi-chevron-down") ms-auto" aria-hidden="true"></i>
                    </button>
                    @if (ActiveFilterCount > 0)
                    {
                        <button type="button" class="materiales-clear-filters" @onclick="ResetFiltersAsync">Limpiar todo</button>
                    }
                </div>

                @if (ShowAdvancedFilters)
                {
                    <div class="materiales-advanced-filters">
                        <div class="row g-2">
                            <div class="col-12">
                                <label class="form-label">Proveedor</label>
                                <VendorCombobox Options="@Catalog.Vendors"
                                                SelectedId="@Filter.VendorId"
                                                SelectedIdChanged="OnVendorFilterChangedAsync"
                                                AriaLabel="Filtrar por proveedor"
                                                Placeholder="Nombre o RFC del proveedor" />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label" for="material-category-filter">Categoría</label>
                                <select id="material-category-filter" class="form-select" value="@Filter.CategoryId" @onchange="OnCategoryFilterChangedAsync">
                                    <option value="">Todas las categorías</option>
                                    @foreach (var option in Catalog.Categories)
                                    {
                                        <option value="@option.Id">@option.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label" for="material-class-filter">Clase</label>
                                <select id="material-class-filter" class="form-select" value="@Filter.MaterialClass" @onchange="OnMaterialClassFilterChangedAsync">
                                    <option value="">Todas las clases</option>
                                    @foreach (var option in Catalog.MaterialClasses)
                                    {
                                        <option value="@option">@GetMaterialClassLabel(option)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label" for="material-status-filter">Estado</label>
                                <select id="material-status-filter" class="form-select" value="@Filter.Status" @onchange="OnStatusFilterChangedAsync">
                                    <option value="">Todos los estados</option>
                                    @foreach (var option in Catalog.Statuses.Where(option => !string.Equals(option, "INACTIVO", StringComparison.OrdinalIgnoreCase) || (IsAdministrator && ShowInactiveMaterials)))
                                    {
                                        <option value="@option">@GetStatusLabel(option)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label">Disponibilidad</label>
                                <div class="materiales-segmented">
                                    <button type="button" class="@(Filter.HasStock is null ? "is-active" : null)" @onclick="() => SetStockFilterAsync(null)">Todos</button>
                                    <button type="button" class="@(Filter.HasStock == true ? "is-active" : null)" @onclick="() => SetStockFilterAsync(true)">Con stock</button>
                                    <button type="button" class="@(Filter.HasStock == false ? "is-active" : null)" @onclick="() => SetStockFilterAsync(false)">Sin stock</button>
                                </div>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Imagen</label>
                                <div class="materiales-segmented">
                                    <button type="button" class="@(Filter.HasImage is null ? "is-active" : null)" @onclick="() => SetImageFilterAsync(null)">Todas</button>
                                    <button type="button" class="@(Filter.HasImage == true ? "is-active" : null)" @onclick="() => SetImageFilterAsync(true)">Con foto</button>
                                    <button type="button" class="@(Filter.HasImage == false ? "is-active" : null)" @onclick="() => SetImageFilterAsync(false)">Sin foto</button>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <div class="materiales-results-heading">
                    <div>
                        <strong>@(IsBusy && Materials.Count == 0 ? "Buscando…" : $"{Materials.Count} materiales")</strong>
                        <span>@(HasMoreMaterials ? "Mostrando los primeros resultados" : "Resultado actual")</span>
                    </div>
                    @if (SelectedMaterialId.HasValue)
                    {
                        <button type="button" @onclick="NuevoMaterial">
                            <i class="bi bi-plus-lg" aria-hidden="true"></i>
                            Crear otro
                        </button>
                    }
                </div>

                <div class="materiales-results" aria-live="polite">
                    @if (!HasExecutedSearch || (IsBusy && Materials.Count == 0))
                    {
                        @for (var index = 0; index < 5; index++)
                        {
                            <div class="materiales-result-skeleton" aria-hidden="true">
                                <span></span>
                                <div><span></span><span></span><span></span></div>
                            </div>
                        }
                    }
                    else if (Materials.Count == 0)
                    {
                        <div class="materiales-empty-state">
                            <span class="materiales-empty-icon"><i class="bi bi-search" aria-hidden="true"></i></span>
                            <h3>No encontramos materiales</h3>
                            <p>Prueba otro término o limpia los filtros. También puedes crear el material ahora mismo.</p>
                            <div>
                                @if (ActiveFilterCount > 0)
                                {
                                    <button type="button" class="btn btn-outline-secondary" @onclick="ResetFiltersAsync">Limpiar filtros</button>
                                }
                                <button type="button" class="btn btn-primary" @onclick="NuevoMaterial">Nuevo material</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        @foreach (var item in Materials)
                        {
                            var thumbnailDataUrl = GetMaterialThumbnailDataUrl(item.Id);
                            var materialTitle = string.IsNullOrWhiteSpace(item.Description) ? item.MaterialCode : item.Description;
                            <article class="@GetMaterialRowClass(item)">
                                <button class="materiales-result-image"
                                        type="button"
                                        title="Ver imagen de @materialTitle"
                                        aria-label="Ver imagen de @materialTitle"
                                        disabled="@(!item.HasImage)"
                                        @onclick="() => AbrirImagenMaterialAsync(item)">
                                    @if (thumbnailDataUrl is not null)
                                    {
                                        <img src="@thumbnailDataUrl" alt="" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-box-seam" aria-hidden="true"></i>
                                    }
                                </button>
                                <button class="materiales-result-main"
                                        type="button"
                                        aria-label="@GetMaterialAriaLabel(item)"
                                        @onclick="() => SeleccionarMaterialAsync(item.Id)">
                                    <span class="materiales-result-topline">
                                        <strong>@materialTitle</strong>
                                        <span class="materiales-status @GetMaterialStatusBadgeClass(item)">@GetMaterialStatusLabel(item)</span>
                                    </span>
                                    <span class="materiales-result-code">@item.MaterialCode</span>
                                    <span class="materiales-result-meta">
                                        <span><i class="bi bi-tag" aria-hidden="true"></i>@(string.IsNullOrWhiteSpace(item.CategoryName) ? "Sin categoría" : item.CategoryName)</span>
                                        <span><i class="bi bi-building" aria-hidden="true"></i>@(string.IsNullOrWhiteSpace(item.VendorName) ? "Sin proveedor" : item.VendorName)</span>
                                    </span>
                                    <span class="materiales-result-bottom">
                                        <span class="materiales-stock @(item.TotalQuantity <= 0 ? "is-empty" : null)">
                                            @item.TotalQuantity.ToString("N2") @(string.IsNullOrWhiteSpace(item.BaseUnitName) ? "unid." : item.BaseUnitName)
                                        </span>
                                        <span>@item.LocationCount ubic.</span>
                                        @if (MaterialNeedsAttention(item))
                                        {
                                            <span class="materiales-attention"><i class="bi bi-stars" aria-hidden="true"></i> Completar</span>
                                        }
                                    </span>
                                </button>
                            </article>
                        }
                    }
                </div>

                @if (HasMoreMaterials)
                {
                    <button class="materiales-load-more" type="button" @onclick="CargarMasAsync" disabled="@IsListBusy">
                        @if (IsLoadingMore)
                        {
                            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                            <span>Cargando más…</span>
                        }
                        else
                        {
                            <i class="bi bi-arrow-down-circle" aria-hidden="true"></i>
                            <span>Cargar @PageSize más</span>
                        }
                    </button>
                }
            </section>
        </div>

        <div class="col-12 col-xl-7 col-xxl-8">
            <section id="material-editor" class="materiales-panel materiales-editor-panel">
                <div class="materiales-editor-heading">
                    <div class="materiales-editor-title">
                        <span class="materiales-step">2 · Completa</span>
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <h2>@(Editor.Id.HasValue ? "Editar material" : "Nuevo material")</h2>
                            @if (Editor.Id.HasValue)
                            {
                                <span class="materiales-code-pill">@CurrentMaterialCode</span>
                            }
                        </div>
                        <p>@(Editor.Id.HasValue ? "Los cambios conservan el código interno y el historial de inventario." : "El código interno se asignará automáticamente al guardar.")</p>
                    </div>
                    <div class="materiales-readiness" title="@MaterialReadinessLabel">
                        <div class="materiales-readiness-copy">
                            <span>Ficha @MaterialReadinessPercent%</span>
                            <strong>@MaterialReadinessLabel</strong>
                        </div>
                        <div class="materiales-readiness-track" aria-label="Ficha completa al @MaterialReadinessPercent por ciento">
                            <span style="width: @(MaterialReadinessPercent)%"></span>
                        </div>
                    </div>
                </div>

                @if (IsLoadingEditor)
                {
                    <div class="materiales-editor-loading">
                        <span class="spinner-border" aria-hidden="true"></span>
                        <span>Cargando ficha del material…</span>
                    </div>
                }

                <EditForm Model="Editor" OnValidSubmit="GuardarAsync" class="materiales-form">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="materiales-validation-summary" />

                    <section class="materiales-form-section">
                        <div class="materiales-section-heading">
                            <span class="materiales-section-icon"><i class="bi bi-card-text" aria-hidden="true"></i></span>
                            <div>
                                <h3>Identidad del material</h3>
                                <p>Lo mínimo para reconocerlo sin ambigüedad en compras e inventario.</p>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-lg-8">
                                <label class="form-label" for="material-description">Descripción <span class="materiales-required">Obligatorio</span></label>
                                <InputText id="material-description"
                                           class="form-control form-control-lg"
                                           placeholder="Ej. Toalla de baño blanca 70 × 140 cm"
                                           @bind-Value="Editor.Description" />
                                <ValidationMessage For="@(() => Editor.Description)" />
                            </div>
                            <div class="col-sm-6 col-lg-4">
                                <label class="form-label" for="material-class">Clase</label>
                                <InputSelect id="material-class" class="form-select form-select-lg" @bind-Value="Editor.MaterialClass">
                                    @foreach (var option in Catalog.MaterialClasses)
                                    {
                                        <option value="@option">@GetMaterialClassLabel(option)</option>
                                    }
                                </InputSelect>
                            </div>

                            <div class="col-md-6">
                                <div class="materiales-field-label-row">
                                    <label class="form-label" for="material-category">Categoría</label>
                                    <button type="button" class="materiales-inline-create" @onclick="OpenCategoryDialog">
                                        <i class="bi bi-plus-lg" aria-hidden="true"></i>
                                        Nueva categoría
                                    </button>
                                </div>
                                <InputSelect id="material-category" class="form-select" @bind-Value="Editor.CategoryId">
                                    <option value="">Selecciona una categoría</option>
                                    @foreach (var option in Catalog.Categories)
                                    {
                                        <option value="@option.Id">@option.Name</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-6">
                                <div class="materiales-field-label-row">
                                    <label class="form-label" for="material-base-unit">Unidad base <span class="materiales-required">Obligatorio</span></label>
                                    <button type="button" class="materiales-inline-create" @onclick="() => OpenUnitDialog(UnitSelectionTarget.Base)">
                                        <i class="bi bi-plus-lg" aria-hidden="true"></i>
                                        Nueva UoM
                                    </button>
                                </div>
                                <InputSelect id="material-base-unit" class="form-select" @bind-Value="Editor.BaseUnitId">
                                    @foreach (var option in Catalog.Units)
                                    {
                                        <option value="@option.Id">@GetUnitDisplay(option)</option>
                                    }
                                </InputSelect>
                                <div class="form-text">Unidad en la que se controla la existencia.</div>
                            </div>

                            <div class="col-12">
                                <label class="form-label">Imagen del material</label>
                                <div class="materiales-image-uploader @(ImagePreviewDataUrl is not null ? "has-image" : null)">
                                    @if (ImagePreviewDataUrl is not null)
                                    {
                                        <img src="@ImagePreviewDataUrl" alt="Vista previa del material" />
                                        <div class="materiales-image-copy">
                                            <strong>@(string.IsNullOrWhiteSpace(SelectedImageFileName) ? "Imagen actual" : SelectedImageFileName)</strong>
                                            <span>Selecciona otra imagen para reemplazarla.</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="materiales-upload-icon"><i class="bi bi-cloud-arrow-up" aria-hidden="true"></i></span>
                                        <div class="materiales-image-copy">
                                            <strong>Agrega una foto clara</strong>
                                            <span>JPG, PNG, WebP y otros formatos de imagen · máximo 8 MB</span>
                                        </div>
                                    }
                                    <InputFile class="materiales-file-input"
                                               OnChange="OnImageSelectedAsync"
                                               Accept=".jpg,.jpeg,.png,.gif,.webp,.bmp"
                                               aria-label="Seleccionar imagen del material" />
                                    @if (ImagePreviewDataUrl is not null)
                                    {
                                        <button type="button" class="materiales-remove-image" @onclick="RemoveImage">
                                            <i class="bi bi-trash3" aria-hidden="true"></i>
                                            Quitar
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="materiales-form-section">
                        <div class="materiales-section-heading">
                            <span class="materiales-section-icon is-purchase"><i class="bi bi-cart3" aria-hidden="true"></i></span>
                            <div>
                                <h3>Abastecimiento</h3>
                                <p>Proveedor, presentación y costo listos para una orden de compra.</p>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-12">
                                <div class="materiales-field-label-row">
                                    <label class="form-label">Proveedor preferido</label>
                                    <button type="button" class="materiales-inline-create" @onclick="OpenVendorDialog">
                                        <i class="bi bi-plus-lg" aria-hidden="true"></i>
                                        Nuevo proveedor
                                    </button>
                                </div>
                                <VendorCombobox Options="@Catalog.Vendors"
                                                SelectedId="@Editor.BusinessPartnerId"
                                                SelectedIdChanged="OnEditorVendorChangedAsync"
                                                AriaLabel="Proveedor preferido"
                                                Placeholder="Escribe nombre o RFC para encontrarlo" />
                                <div class="form-text">Busca entre todos los proveedores activos de la empresa de tu sesión.</div>
                            </div>

                            <div class="col-md-6 col-xxl-4">
                                <div class="materiales-field-label-row">
                                    <label class="form-label" for="material-purchase-unit">Presentación de compra</label>
                                    <button type="button" class="materiales-inline-create" @onclick="() => OpenUnitDialog(UnitSelectionTarget.Purchase)">
                                        <i class="bi bi-plus-lg" aria-hidden="true"></i>
                                        Nueva UoM
                                    </button>
                                </div>
                                <InputSelect TValue="int?"
                                             id="material-purchase-unit"
                                             class="form-select"
                                             Value="@Editor.PurchaseUnitId"
                                             ValueChanged="OnPurchaseUnitChanged"
                                             ValueExpression="@(() => Editor.PurchaseUnitId)">
                                    <option value="">Sin presentación</option>
                                    @foreach (var option in Catalog.Units)
                                    {
                                        <option value="@option.Id">@GetUnitDisplay(option)</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-3 col-xxl-2">
                                <label class="form-label" for="material-purchase-quantity">Contenido</label>
                                <input type="number"
                                       id="material-purchase-quantity"
                                       name="Editor.PurchaseQuantity"
                                       class="form-control"
                                       min="0.0001"
                                       step="0.0001"
                                       inputmode="decimal"
                                       value="@_purchaseQuantityInputText"
                                       @oninput="OnPurchaseQuantityChanged" />
                            </div>
                            <div class="col-md-6 col-xxl-3">
                                <label class="form-label" for="material-base-unit-price">@BaseUnitPriceLabel</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input type="number"
                                           id="material-base-unit-price"
                                           name="Editor.BaseUnitPrice"
                                           class="form-control"
                                           min="0"
                                           step="0.000001"
                                           inputmode="decimal"
                                           value="@_baseUnitPriceInputText"
                                           @oninput="OnBaseUnitPriceChanged" />
                                </div>
                                <ValidationMessage For="@(() => Editor.BaseUnitPrice)" />
                                <div class="form-text">Costo de referencia almacenado; el costo real de inventario proviene de recepciones y promedio ponderado.</div>
                            </div>
                            <div class="col-md-6 col-xxl-3">
                                <label class="form-label" for="material-presentation-price">@PurchasePresentationPriceLabel</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input type="number"
                                           id="material-presentation-price"
                                           name="PurchasePresentationPrice"
                                           class="form-control"
                                           min="0"
                                           step="0.01"
                                           inputmode="decimal"
                                           disabled="@(!CanCalculatePurchasePresentationPrice)"
                                           value="@_purchasePresentationPriceInputText"
                                           @oninput="OnPurchasePresentationPriceChanged" />
                                </div>
                                <div class="form-text">Calculado como precio base × contenido. También puedes capturarlo para recalcular el precio base.</div>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Conversión de compra</label>
                                <div class="materiales-conversion-preview">
                                    <i class="bi bi-arrow-left-right" aria-hidden="true"></i>
                                    <span>@PurchaseConversionSummary</span>
                                </div>
                            </div>

                            <div class="col-md-5">
                                <label class="form-label" for="material-vendor-code">Código del proveedor</label>
                                <InputText id="material-vendor-code" class="form-control" placeholder="SKU o referencia externa" @bind-Value="Editor.VendorCode" />
                            </div>
                            <div class="col-md-7">
                                <label class="form-label" for="material-purchase-link">Liga de compra</label>
                                <div class="materiales-input-with-icon">
                                    <i class="bi bi-link-45deg" aria-hidden="true"></i>
                                    <InputText id="material-purchase-link" class="form-control" placeholder="https://…" @bind-Value="Editor.PurchaseLink" />
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="materiales-form-section">
                        <div class="materiales-section-heading">
                            <span class="materiales-section-icon is-operation"><i class="bi bi-upc-scan" aria-hidden="true"></i></span>
                            <div>
                                <h3>Control operativo</h3>
                                <p>Datos para identificar, recibir y manejar correctamente el material.</p>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label" for="material-barcode">Código de barras</label>
                                <div class="materiales-input-with-icon">
                                    <i class="bi bi-upc" aria-hidden="true"></i>
                                    <InputText id="material-barcode" class="form-control" placeholder="Escanea o captura el código" @bind-Value="Editor.Barcode" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label" for="material-brand">Marca</label>
                                <InputText id="material-brand" class="form-control" @bind-Value="Editor.Brand" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label" for="material-model">Modelo</label>
                                <InputText id="material-model" class="form-control" @bind-Value="Editor.Model" />
                            </div>

                            <div class="col-md-6">
                                <label class="materiales-toggle-card">
                                    <InputCheckbox class="form-check-input" @bind-Value="Editor.IsPerishable" />
                                    <span class="materiales-toggle-icon"><i class="bi bi-calendar2-week" aria-hidden="true"></i></span>
                                    <span>
                                        <strong>Material perecedero</strong>
                                        <small>Controla caducidad y rotación.</small>
                                    </span>
                                </label>
                            </div>
                            <div class="col-md-6">
                                <label class="materiales-toggle-card">
                                    <InputCheckbox class="form-check-input" @bind-Value="Editor.RequiresRefrigeration" />
                                    <span class="materiales-toggle-icon is-cold"><i class="bi bi-snow" aria-hidden="true"></i></span>
                                    <span>
                                        <strong>Requiere refrigeración</strong>
                                        <small>Señala manejo con cadena fría.</small>
                                    </span>
                                </label>
                            </div>
                            @if (Editor.IsPerishable)
                            {
                                <div class="col-md-6">
                                    <label class="form-label" for="material-shelf-life">Vida útil en días</label>
                                    <InputNumber id="material-shelf-life" class="form-control" @bind-Value="Editor.ShelfLifeDays" />
                                </div>
                            }
                        </div>

                        <button type="button"
                                class="materiales-more-toggle"
                                aria-expanded="@ShowMoreFields"
                                @onclick="() => ShowMoreFields = !ShowMoreFields">
                            <i class="bi bi-three-dots" aria-hidden="true"></i>
                            @(ShowMoreFields ? "Ocultar configuración avanzada" : "Mostrar configuración avanzada")
                            <i class="bi @(ShowMoreFields ? "bi-chevron-up" : "bi-chevron-down") ms-auto" aria-hidden="true"></i>
                        </button>

                        @if (ShowMoreFields)
                        {
                            <div class="materiales-more-fields">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label" for="material-status">Estado logístico</label>
                                        <InputSelect id="material-status" class="form-select" @bind-Value="Editor.Status">
                                            @foreach (var option in EditableStatusOptions)
                                            {
                                                <option value="@option">@GetStatusLabel(option)</option>
                                            }
                                        </InputSelect>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="materiales-toggle-card is-compact @(SelectedMaterialIsActive ? null : "is-disabled")">
                                            <i class="bi @(SelectedMaterialIsActive ? "bi-check-circle-fill" : "bi-archive-fill")" aria-hidden="true"></i>
                                            <span>
                                                <strong>@(SelectedMaterialIsActive ? "Registro activo" : "Material desactivado")</strong>
                                                <small>@(SelectedMaterialIsActive ? "Disponible según su estado logístico." : "Solo un administrador puede reactivarlo desde la revisión de retiro.")</small>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </section>

                    <div class="materiales-save-bar">
                        <div class="materiales-save-context">
                            <span class="materiales-status @GetStatusBadgeClass(Editor.Status)">@(SelectedMaterialIsActive ? GetStatusLabel(Editor.Status) : "Desactivado")</span>
                            <span>@(Editor.Id.HasValue ? CurrentMaterialCode : "Código automático")</span>
                            @if (MaterialReadinessPercent < 65)
                            {
                                <span class="materiales-save-hint"><i class="bi bi-info-circle" aria-hidden="true"></i> Puedes guardar y completar después.</span>
                            }
                        </div>
                        <div class="materiales-save-actions @(Editor.Id.HasValue ? "has-delete" : null)">
                            @if (Editor.Id.HasValue)
                            {
                                <button type="button"
                                        class="btn btn-outline-danger materiales-delete-trigger"
                                        @onclick="OpenLifecycleReportAsync"
                                        disabled="@(IsSaving || IsProcessingLifecycle)">
                                    <i class="bi bi-shield-check" aria-hidden="true"></i>
                                    Revisar retiro
                                </button>
                                <button type="button" class="btn btn-outline-secondary" @onclick="NuevoMaterial" disabled="@IsSaving">Cancelar edición</button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-outline-secondary" @onclick="NuevoMaterial" disabled="@IsSaving">Limpiar</button>
                            }
                            <button type="submit" class="btn btn-primary" disabled="@IsSaving">
                                @if (IsSaving)
                                {
                                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                    <span>Guardando…</span>
                                }
                                else
                                {
                                    <i class="bi bi-check2" aria-hidden="true"></i>
                                    <span>@(Editor.Id.HasValue ? "Guardar cambios" : "Crear material")</span>
                                }
                            </button>
                        </div>
                    </div>
                </EditForm>
            </section>

            @if (HasInventoryContext)
            {
                <section id="material-inventory" class="materiales-panel materiales-inventory-panel">
                    <div class="materiales-panel-heading">
                        <div>
                            <span class="materiales-step">3 · Ubica</span>
                            <h2>Dónde está almacenado</h2>
                            <p>Existencia por ubicación con mínimos, máximos y control de conteo.</p>
                        </div>
                        <div class="materiales-panel-tools">
                            <a class="btn btn-sm btn-outline-secondary materiales-panel-link" href="/logistica/ubicaciones">
                                <i class="bi bi-geo-alt" aria-hidden="true"></i>
                                <span>Administrar ubicaciones</span>
                            </a>
                            <button type="button"
                                    class="materiales-icon-button"
                                    title="Actualizar inventario"
                                    aria-label="Actualizar inventario"
                                    @onclick="RefreshInventoryAsync"
                                    disabled="@IsLoadingInventory">
                                <i class="bi bi-arrow-clockwise @(IsLoadingInventory ? "spin" : null)" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>

                    @if (IsLoadingInventory)
                    {
                        <div class="materiales-inventory-loading">
                            <span class="spinner-border" aria-hidden="true"></span>
                            <span>Consultando existencias…</span>
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(InventoryError))
                    {
                        <div class="materiales-inventory-alert" role="alert">
                            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                            <span>@InventoryError</span>
                        </div>
                    }
                    else if (Inventory is null || !Inventory.HasLocations)
                    {
                        <div class="materiales-inventory-empty">
                            <i class="bi bi-inboxes" aria-hidden="true"></i>
                            <h3>Este material aún no vive en ninguna ubicación</h3>
                            <p>Asigna el material a un almacén, estante o área desde Ubicaciones para empezar a controlar mínimos, máximos y conteos.</p>
                            <a class="btn btn-outline-primary" href="/logistica/ubicaciones">
                                <i class="bi bi-plus-lg" aria-hidden="true"></i>
                                Asignar a una ubicación
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="materiales-inventory-metrics" aria-label="Resumen de existencias">
                            <div class="materiales-inventory-metric">
                                <span>Existencia total</span>
                                <strong>@FormatQuantityWithUnit(Inventory.TotalQuantity)</strong>
                                <small>@Inventory.StoredLocations.Count @(Inventory.StoredLocations.Count == 1 ? "ubicación activa" : "ubicaciones activas")</small>
                            </div>
                            <div class="materiales-inventory-metric">
                                <span>Disponible</span>
                                <strong>@FormatQuantityWithUnit(Inventory.TotalAvailableQuantity)</strong>
                                <small>@FormatQuantity(Inventory.TotalReservedQuantity) reservado</small>
                            </div>
                            <div class="materiales-inventory-metric @(Inventory.LowStockCount > 0 ? "needs-attention" : null)">
                                <span>Bajo mínimo</span>
                                <strong>@Inventory.LowStockCount</strong>
                                <small>mín. total @FormatQuantity(Inventory.TotalMinQuantity)</small>
                            </div>
                            <div class="materiales-inventory-metric @(Inventory.OverStockCount > 0 ? "needs-attention" : null)">
                                <span>Sobre máximo</span>
                                <strong>@Inventory.OverStockCount</strong>
                                <small>máx. total @FormatQuantity(Inventory.TotalMaxQuantity)</small>
                            </div>
                            <div class="materiales-inventory-metric @(Inventory.CountDueCount > 0 ? "needs-attention" : null)">
                                <span>Conteo vencido</span>
                                <strong>@Inventory.CountDueCount</strong>
                                <small>@Inventory.MissingThresholdCount sin parámetros</small>
                            </div>
                            <div class="materiales-inventory-metric">
                                <span>Valor estimado</span>
                                <strong>@FormatMoney(Inventory.TotalInventoryValue)</strong>
                                <small>a costo promedio</small>
                            </div>
                        </div>

                        @if (Inventory.RemovedLocations.Count > 0)
                        {
                            <button type="button"
                                    class="materiales-more-toggle"
                                    aria-expanded="@ShowRemovedStockLocations"
                                    @onclick="ToggleRemovedStockLocations">
                                <i class="bi bi-archive" aria-hidden="true"></i>
                                @(ShowRemovedStockLocations
                                    ? "Ocultar ubicaciones retiradas"
                                    : $"Mostrar {Inventory.RemovedLocations.Count} ubicación(es) retirada(s)")
                                <i class="bi @(ShowRemovedStockLocations ? "bi-chevron-up" : "bi-chevron-down") ms-auto" aria-hidden="true"></i>
                            </button>
                        }

                        <div class="materiales-stock-list">
                            @foreach (var location in VisibleStockLocations)
                            {
                                <article class="materiales-stock-card @GetCoverageCssClass(location) @(location.IsRemoved ? "is-removed" : null)">
                                    <header class="materiales-stock-header">
                                        <div class="materiales-stock-identity">
                                            <span class="materiales-stock-path">@GetStockLocationPath(location)</span>
                                            <h3>@GetStockLocationTitle(location)</h3>
                                            <div class="materiales-stock-tags">
                                                <span class="materiales-result-code">@location.LocationCode</span>
                                                <span class="materiales-chip">@GetLocationTypeLabel(location.LocationType)</span>
                                                @if (!location.IsLocationActive)
                                                {
                                                    <span class="materiales-chip is-warning">Ubicación inactiva</span>
                                                }
                                                @if (!location.IsInventoryEnabled)
                                                {
                                                    <span class="materiales-chip is-warning">Sin inventario</span>
                                                }
                                                @if (location.IsRemoved)
                                                {
                                                    <span class="materiales-chip is-danger">Asignación retirada</span>
                                                }
                                            </div>
                                        </div>
                                        <div class="materiales-stock-quantity">
                                            <strong>@FormatQuantity(location.Quantity)</strong>
                                            <span>@BaseUnitShortName</span>
                                            <span class="materiales-stock-state @GetCoverageCssClass(location)">@GetCoverageLabel(location)</span>
                                        </div>
                                    </header>

                                    <div class="materiales-stock-gauge">
                                        <div class="materiales-stock-gauge-track"
                                             role="img"
                                             aria-label="Existencia @FormatQuantity(location.Quantity) con mínimo @FormatOptionalQuantity(location.MinQuantity) y máximo @FormatOptionalQuantity(location.MaxQuantity)">
                                            <span class="materiales-stock-gauge-fill" style="width: @(GetStockFillPercent(location))%"></span>
                                            @if (location.MinQuantity.HasValue && location.MaxQuantity.HasValue)
                                            {
                                                <span class="materiales-stock-gauge-marker" style="left: @(GetStockMinimumMarkerPercent(location))%"></span>
                                            }
                                        </div>
                                        <div class="materiales-stock-gauge-legend">
                                            <span><i class="bi bi-arrow-down-short" aria-hidden="true"></i> Mín @FormatOptionalQuantity(location.MinQuantity)</span>
                                            <span>Máx @FormatOptionalQuantity(location.MaxQuantity) <i class="bi bi-arrow-up-short" aria-hidden="true"></i></span>
                                        </div>
                                    </div>

                                    <dl class="materiales-stock-facts">
                                        <div>
                                            <dt>Reservado</dt>
                                            <dd>@FormatQuantity(location.ReservedQuantity)</dd>
                                        </div>
                                        <div>
                                            <dt>Disponible</dt>
                                            <dd>@FormatQuantity(location.AvailableQuantity)</dd>
                                        </div>
                                        <div>
                                            <dt>Costo promedio</dt>
                                            <dd>@FormatMoney(location.AverageUnitCost)</dd>
                                        </div>
                                        <div>
                                            <dt>Valor en piso</dt>
                                            <dd>@FormatMoney(location.InventoryValue)</dd>
                                        </div>
                                        <div>
                                            <dt>Último conteo</dt>
                                            <dd>@FormatMoment(location.LastCountedAt)</dd>
                                        </div>
                                        <div>
                                            <dt>Frecuencia de conteo</dt>
                                            <dd>@(location.CountFrequencyDays.HasValue ? $"Cada {location.CountFrequencyDays.Value} días" : "Sin programa")</dd>
                                        </div>
                                        <div class="@(location.IsCountDue ? "is-flagged" : null)">
                                            <dt>Próximo conteo</dt>
                                            <dd>@FormatMoment(location.NextCountDueAt)</dd>
                                        </div>
                                        <div>
                                            <dt>Última compra</dt>
                                            <dd>@FormatDay(location.LastPurchaseDate)</dd>
                                        </div>
                                        <div>
                                            <dt>Último movimiento</dt>
                                            <dd>@FormatRelativeMoment(location.LastMovementAt)</dd>
                                        </div>
                                        <div>
                                            <dt>Movimientos</dt>
                                            <dd>@location.MovementCount</dd>
                                        </div>
                                        <div>
                                            <dt>Adjuntos</dt>
                                            <dd>@location.AttachmentCount</dd>
                                        </div>
                                    </dl>

                                    @if (location.IsLowStock && location.SuggestedRefillQuantity.HasValue)
                                    {
                                        <div class="materiales-stock-hint is-low">
                                            <i class="bi bi-cart-plus" aria-hidden="true"></i>
                                            <span>Resurte @FormatQuantityWithUnit(location.SuggestedRefillQuantity.Value) para volver al máximo configurado.</span>
                                        </div>
                                    }
                                    else if (location.ExcessQuantity.HasValue)
                                    {
                                        <div class="materiales-stock-hint is-over">
                                            <i class="bi bi-box-arrow-up" aria-hidden="true"></i>
                                            <span>Hay @FormatQuantityWithUnit(location.ExcessQuantity.Value) por encima del máximo. Considera un traspaso.</span>
                                        </div>
                                    }
                                    else if (!location.HasThresholds)
                                    {
                                        <div class="materiales-stock-hint is-unset">
                                            <i class="bi bi-sliders" aria-hidden="true"></i>
                                            <span>Sin mínimo ni máximo configurado. Defínelos en Ubicaciones para activar alertas de reorden.</span>
                                        </div>
                                    }

                                    @if (location.IsCountDue)
                                    {
                                        <div class="materiales-stock-hint is-count">
                                            <i class="bi bi-clipboard-check" aria-hidden="true"></i>
                                            <span>El conteo cíclico de esta ubicación está vencido.</span>
                                        </div>
                                    }

                                    @if (location.IsRemoved)
                                    {
                                        <div class="materiales-stock-hint is-removed">
                                            <i class="bi bi-archive" aria-hidden="true"></i>
                                            <span>Retirada el @FormatMoment(location.RemovedAt)@(string.IsNullOrWhiteSpace(location.RemovedBy) ? "." : $" por {location.RemovedBy}.") El historial se conserva.</span>
                                        </div>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(location.Notes))
                                    {
                                        <p class="materiales-stock-notes">@location.Notes</p>
                                    }

                                    <footer class="materiales-stock-footer">
                                        <button type="button"
                                                class="materiales-stock-action @(MovementLocationFilter == location.LocationId ? "is-active" : null)"
                                                @onclick="() => FilterMovementsByLocationAsync(location.LocationId)">
                                            <i class="bi bi-clock-history" aria-hidden="true"></i>
                                            @(MovementLocationFilter == location.LocationId ? "Quitar filtro del historial" : "Ver su historial")
                                        </button>
                                        <span class="materiales-stock-updated">Actualizado @FormatRelativeMoment(location.UpdatedAt)</span>
                                    </footer>
                                </article>
                            }
                        </div>
                    }
                </section>

                <section id="material-history" class="materiales-panel materiales-history-panel">
                    <div class="materiales-panel-heading">
                        <div>
                            <span class="materiales-step">4 · Audita</span>
                            <h2>Historial de inventario</h2>
                            <p>
                                Cada entrada, salida, traspaso, ajuste y conteo que ha tocado este material.
                                @if (Inventory is not null && Inventory.TotalMovementCount > 0)
                                {
                                    <span>@Inventory.TotalMovementCount movimiento(s) registrados · último @FormatRelativeMoment(Inventory.LastMovementAt).</span>
                                }
                            </p>
                        </div>
                        <div class="materiales-panel-tools">
                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary materiales-panel-link"
                                    aria-expanded="@ShowMovementFilters"
                                    @onclick="ToggleMovementFilters">
                                <i class="bi bi-funnel" aria-hidden="true"></i>
                                <span>Filtros</span>
                                @if (ActiveMovementFilterCount > 0)
                                {
                                    <span class="materiales-filter-count">@ActiveMovementFilterCount</span>
                                }
                            </button>
                        </div>
                    </div>

                    @if (ShowMovementFilters)
                    {
                        <div class="materiales-history-filters">
                            <div class="row g-2">
                                <div class="col-md-4">
                                    <label class="form-label" for="movement-location">Ubicación</label>
                                    <select id="movement-location" class="form-select" @bind="MovementLocationFilter" @bind:after="ApplyMovementFiltersAsync">
                                        <option value="">Todas las ubicaciones</option>
                                        @if (Inventory is not null)
                                        {
                                            @foreach (var location in Inventory.Locations)
                                            {
                                                <option value="@location.LocationId">@GetStockLocationTitle(location) (@location.LocationCode)</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="movement-type">Tipo de movimiento</label>
                                    <select id="movement-type" class="form-select" @bind="MovementTypeFilter" @bind:after="ApplyMovementFiltersAsync">
                                        <option value="">Todos los tipos</option>
                                        @if (Inventory is not null)
                                        {
                                            @foreach (var option in Inventory.MovementTypes)
                                            {
                                                <option value="@option.TransactionType">@GetMovementTypeLabel(option.TransactionType) (@option.MovementCount)</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label" for="movement-from">Desde</label>
                                    <input id="movement-from" class="form-control" type="date" @bind="MovementFromDate" @bind:format="yyyy-MM-dd" @bind:after="ApplyMovementFiltersAsync" />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label" for="movement-to">Hasta</label>
                                    <input id="movement-to" class="form-control" type="date" @bind="MovementToDate" @bind:format="yyyy-MM-dd" @bind:after="ApplyMovementFiltersAsync" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label" for="movement-search">Buscar</label>
                                    <div class="materiales-input-with-icon">
                                        <i class="bi bi-search" aria-hidden="true"></i>
                                        <input id="movement-search"
                                               class="form-control"
                                               type="search"
                                               placeholder="Notas, usuario, referencia o ubicación"
                                               @bind="MovementSearchText"
                                               @bind:event="oninput"
                                               @onkeyup="OnMovementSearchKeyUpAsync" />
                                    </div>
                                </div>
                                <div class="col-12 d-flex justify-content-end">
                                    <button type="button"
                                            class="btn btn-sm btn-primary me-2"
                                            @onclick="ApplyMovementFiltersAsync">
                                        Buscar
                                    </button>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-secondary"
                                            @onclick="ResetMovementFiltersAsync"
                                            disabled="@(ActiveMovementFilterCount == 0)">
                                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                                        Limpiar filtros
                                    </button>
                                </div>
                            </div>
                        </div>
                    }

                    @if (IsLoadingMovements)
                    {
                        <div class="materiales-inventory-loading">
                            <span class="spinner-border" aria-hidden="true"></span>
                            <span>Cargando movimientos…</span>
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(MovementsError))
                    {
                        <div class="materiales-inventory-alert" role="alert">
                            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                            <span>@MovementsError</span>
                        </div>
                    }
                    else if (Movements.Count == 0)
                    {
                        <div class="materiales-inventory-empty">
                            <i class="bi bi-clock-history" aria-hidden="true"></i>
                            <h3>@(ActiveMovementFilterCount > 0 ? "Ningún movimiento coincide con los filtros" : "Todavía no hay movimientos")</h3>
                            <p>
                                @(ActiveMovementFilterCount > 0
                                    ? "Ajusta el rango de fechas, la ubicación o el tipo para ampliar la búsqueda."
                                    : "Las recepciones de compra, traspasos, ajustes, mermas y conteos aparecerán aquí en cuanto ocurran.")
                            </p>
                            @if (ActiveMovementFilterCount > 0)
                            {
                                <button type="button" class="btn btn-outline-primary" @onclick="ResetMovementFiltersAsync">
                                    <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
                                    Limpiar filtros
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <ol class="materiales-movement-list">
                            @foreach (var movement in Movements)
                            {
                                var referenceLabel = GetMovementReferenceLabel(movement);
                                <li class="materiales-movement @GetMovementDirectionCssClass(movement)">
                                    <span class="materiales-movement-icon">
                                        <i class="bi @GetMovementTypeIcon(movement.TransactionType)" aria-hidden="true"></i>
                                    </span>
                                    <div class="materiales-movement-body">
                                        <div class="materiales-movement-headline">
                                            <strong>@GetMovementTypeLabel(movement.TransactionType)</strong>
                                            <span class="materiales-movement-delta">@FormatSignedQuantity(movement.QuantityDelta) @BaseUnitShortName</span>
                                        </div>
                                        <div class="materiales-movement-meta">
                                            <span><i class="bi bi-geo-alt" aria-hidden="true"></i> @GetMovementLocationLabel(movement)</span>
                                            <span><i class="bi bi-clock" aria-hidden="true"></i> @FormatMoment(movement.OccurredAt)</span>
                                            @if (!string.IsNullOrWhiteSpace(movement.PerformedBy))
                                            {
                                                <span><i class="bi bi-person" aria-hidden="true"></i> @movement.PerformedBy</span>
                                            }
                                            @if (referenceLabel is not null)
                                            {
                                                <span><i class="bi bi-link-45deg" aria-hidden="true"></i> @referenceLabel</span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(movement.Notes))
                                        {
                                            <p class="materiales-movement-notes">@movement.Notes</p>
                                        }
                                    </div>
                                    <div class="materiales-movement-balance">
                                        <span>Saldo</span>
                                        <strong>@FormatQuantity(movement.QuantityAfter)</strong>
                                        <small>antes @FormatQuantity(movement.QuantityBefore)</small>
                                    </div>
                                </li>
                            }
                        </ol>

                        <div class="materiales-history-footer">
                            <span>@Movements.Count movimiento(s) en pantalla</span>
                            @if (HasMoreMovements)
                            {
                                <button type="button"
                                        class="btn btn-outline-primary btn-sm"
                                        @onclick="LoadMoreMovementsAsync"
                                        disabled="@IsLoadingMoreMovements">
                                    @if (IsLoadingMoreMovements)
                                    {
                                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                        <span>Cargando…</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-arrow-down-circle" aria-hidden="true"></i>
                                        <span>Cargar más</span>
                                    }
                                </button>
                            }
                        </div>
                    }
                </section>
            }
        </div>
    </div>
</div>

