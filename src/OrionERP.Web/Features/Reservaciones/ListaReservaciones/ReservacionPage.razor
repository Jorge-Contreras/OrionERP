@page "/reservaciones/{ReservationId:int}"
@attribute [Authorize(Roles = "Administrador,SatOperator")]

<PageTitle>RESERVATION</PageTitle>

@if (IsLoading)
{
    <p><em>Cargando reservación...</em></p>
}
else if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="alert alert-danger">@ErrorMessage</div>
}
else if (Detail is null)
{
    <div class="alert alert-warning">No se encontró la reservación.</div>
}
else
{
    <div class="reservacion-page-shell">
        <div class="reservacion-page-header d-flex flex-wrap align-items-center gap-2 mb-3">
            <h3 class="mb-0 reservacion-page-title">RESERVACION #@ReservationId</h3>
            <button class="btn btn-primary btn-sm ms-auto" @onclick="GuardarAsync" disabled="@IsSaving">
                GUARDAR
            </button>
            <button class="btn btn-outline-secondary btn-sm" @onclick="CerrarAsync">CERRAR</button>
            <button class="btn btn-outline-success btn-sm" @onclick="AbrirPdfAsync" disabled="@(IsGeneratingPdf || IsLoading)">
                @(IsGeneratingPdf ? "Generando PDF..." : "PDF")
            </button>
            <button class="btn btn-outline-info btn-sm" @onclick="CrearPolizaAsync" disabled="@(IsSaving || IsWorking || IsCreatingPoliza)">Crear Póliza</button>
            <button class="btn btn-outline-primary btn-sm"
                    @onclick="ToggleCfdiPanelAsync"
                    disabled="@(IsSaving || IsWorking || IsLoadingCfdiContext || IsCreatingCfdi || HasExistingReservationCfdis)">
                @(IsLoadingCfdiContext ? "Preparando CFDI..." : HasExistingReservationCfdis ? "CFDI ligado" : ShowCfdiPanel ? "Cerrar CFDI" : "Crear CFDI")
            </button>
        </div>

    <div class="row g-3 mb-3">
        <div class="col-lg-8">
            <div class="card reservacion-section reservacion-section-datos">
                <div class="card-header reservacion-section-title">Datos de la Reservación</div>
                <div class="card-body">
                    <div class="row g-2">
                        <div class="col-md-4 reservacion-lookup">
                            <label class="form-label">CLIENTE</label>
                            <input class="form-control"
                                   placeholder="Cliente"
                                   value="@ClienteSearchText"
                                   @oninput="OnClienteInputChangedAsync"
                                   @onkeydown="OnClienteInputKeyDownAsync" />
                            @if (ShowClienteResults)
                            {
                                <div class="list-group position-absolute w-100 shadow-sm reservacion-lookup-results">
                                    @if (Clientes.Count == 0)
                                    {
                                        <div class="list-group-item text-muted small">Sin resultados.</div>
                                    }
                                    else
                                    {
                                        @foreach (var cliente in Clientes)
                                        {
                                            <button type="button"
                                                    class="list-group-item list-group-item-action"
                                                    @onclick="() => SelectClienteAsync(cliente)">
                                                @cliente.Nombre
                                            </button>
                                        }
                                    }
                                </div>
                            }
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">STATUS</label>
                            <select class="form-select" value="@Status" @onchange="OnStatusChangedAsync">
                                @foreach (var item in StatusOptions)
                                {
                                    <option value="@item">@item</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">CHECKIN</label>
                            <input class="form-control" type="date" value="@CheckInText" @onchange="OnCheckInChangedAsync" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">CHECKOUT</label>
                            <input class="form-control" type="date" value="@CheckOutText" @onchange="OnCheckOutChangedAsync" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">#Noches</label>
                            <input class="form-control text-center fw-bold" value="@NumNoches" readonly />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">RECOMENDACION</label>
                            <input class="form-control" @bind="RecommenedBy" />
                        </div>
                        <div class="col-md-3 d-flex align-items-end">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" checked="@Taxable" @onchange="ToggleTaxableAsync" id="taxableCheck" />
                                <label class="form-check-label" for="taxableCheck">FACTURABLE</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label">NOTAS</label>
                            <textarea class="form-control" rows="2" @bind="Notes"></textarea>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card reservacion-section reservacion-section-totales">
                <div class="card-header reservacion-section-title">Totales</div>
                <div class="card-body">
                    <div class="d-flex justify-content-between"><span>Total por Suites</span><strong>@FormatCurrency(TotalSuites)</strong></div>
                    <div class="d-flex justify-content-between"><span>Total por Extras</span><strong>@FormatCurrency(TotalExtras)</strong></div>
                    <div class="d-flex justify-content-between"><span>Subtotal</span><strong>@FormatCurrency(SubTotal)</strong></div>
                    <div class="d-flex justify-content-between"><span>IVA</span><strong>@FormatCurrency(Tax)</strong></div>
                    <div class="d-flex justify-content-between"><span>ISH</span><strong>@FormatCurrency(Ish)</strong></div>
                    <hr />
                    <div class="d-flex justify-content-between"><span>Total Reservación</span><strong>@FormatCurrency(TotalReservacion)</strong></div>
                    <div class="d-flex justify-content-between"><span>Total Pagado</span><strong>@FormatCurrency(TotalPagado)</strong></div>
                    <div class="d-flex justify-content-between"><span>Por Pagar</span><strong class="@(PorPagar > 0 ? "text-danger" : "text-success")">@FormatCurrency(PorPagar)</strong></div>
                </div>
            </div>
        </div>
    </div>

    @if (HasExistingReservationCfdis)
    {
        <div class="alert alert-info mb-3">
            Esta reservación ya tiene CFDIs ligados. Se muestran abajo para evitar timbrados duplicados.
        </div>

        <div class="card mb-3 reservacion-section reservacion-section-cfdi">
            <div class="card-header reservacion-section-title d-flex align-items-center gap-2">
                <span>CFDIs ligados</span>
                <span class="badge text-bg-secondary">@CfdiContext!.ExistingDocuments.Count</span>
            </div>
            <div class="card-body">
                <div class="table-responsive reservacion-table-wrap">
                    <table class="table table-sm table-bordered mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Póliza</th>
                                <th>Fecha</th>
                                <th>UUID</th>
                                <th>Receptor</th>
                                <th class="text-end">Total</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var document in CfdiContext.ExistingDocuments)
                            {
                                <tr>
                                    <td>@document.TransaccionId</td>
                                    <td>@document.Fecha.ToShortDateString()</td>
                                    <td class="text-wrap">@document.Uuid</td>
                                    <td class="text-wrap">@document.ReceptorNombre (@document.ReceptorRfc)</td>
                                    <td class="text-end">@FormatCurrency(document.Total)</td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-danger"
                                                @onclick="() => CancelarCfdiReservacionAsync(document)"
                                                disabled="@IsCancellingReservationCfdi(document)">
                                            @(IsCancellingReservationCfdi(document) ? "Cancelando..." : "Cancelar CFDI")
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    @if (ShouldShowCfdiCreationPanel)
    {
        <div class="card mb-3 reservacion-section reservacion-section-cfdi">
            <div class="card-header reservacion-section-title d-flex flex-wrap align-items-center gap-2">
                <span>CFDI</span>
                @if (CfdiContext is not null)
                {
                    <span class="badge text-bg-secondary">Total @FormatCurrency(CfdiContext.TotalReservacion)</span>
                    @if (CfdiContext.AutoSelectedTransaccionId.HasValue)
                    {
                        <span class="badge text-bg-success">Póliza sugerida @CfdiContext.AutoSelectedTransaccionId</span>
                    }
                }
                <button class="btn btn-sm btn-outline-secondary ms-auto"
                        @onclick="ReloadCfdiContextAsync"
                        disabled="@(IsLoadingCfdiContext || IsCreatingCfdi)">
                    Recargar
                </button>
            </div>
            <div class="card-body">
                @if (IsLoadingCfdiContext)
                {
                    <p class="mb-0 text-muted">Preparando contexto del CFDI…</p>
                }
                else if (CfdiContext is null)
                {
                    <div class="alert alert-warning mb-0">@CfdiErrorMessage</div>
                }
                else
                {
                    @if (!string.IsNullOrWhiteSpace(CfdiErrorMessage))
                    {
                        <div class="alert alert-danger">@CfdiErrorMessage</div>
                    }

                    @if (CfdiContext.HasUnsupportedIsh)
                    {
                        <div class="alert alert-warning">
                            Esta reservación incluye ISH. El flujo actual de CFDI no timbra automáticamente reservaciones con ese impuesto.
                        </div>
                    }

                    <div class="row g-3">
                        <div class="col-12 col-xl-4">
                            <div class="reservacion-cfdi-panel">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <h6 class="mb-0">Receptor</h6>
                                    @if (CfdiReceiver.BusinessPartnerId.HasValue)
                                    {
                                        <span class="badge text-bg-success">Cliente guardado</span>
                                    }
                                </div>

                                <div class="reservacion-lookup mb-3">
                                    <label class="form-label">Buscar RFC o razón social</label>
                                    <input class="form-control"
                                           placeholder="RFC, razón social o email"
                                           value="@CfdiCustomerSearchText"
                                           @oninput="OnCfdiCustomerInputChangedAsync"
                                           @onkeydown="OnCfdiCustomerInputKeyDownAsync" />
                                    @if (ShowCfdiCustomerResults)
                                    {
                                        <div class="list-group position-absolute w-100 shadow-sm reservacion-lookup-results">
                                            @if (IsSearchingCfdiCustomers)
                                            {
                                                <div class="list-group-item text-muted small">Buscando…</div>
                                            }
                                            else if (CfdiCustomerSuggestions.Count == 0)
                                            {
                                                <div class="list-group-item text-muted small">Sin resultados.</div>
                                            }
                                            else
                                            {
                                                @foreach (var suggestion in CfdiCustomerSuggestions)
                                                {
                                                    <button type="button"
                                                            class="list-group-item list-group-item-action"
                                                            @onclick="() => SelectCfdiCustomer(suggestion)">
                                                        <div class="fw-semibold">@suggestion.DisplayName</div>
                                                        <div class="small text-muted">
                                                            @suggestion.Rfc | @suggestion.FiscalRegime | @suggestion.CfdiUse
                                                        </div>
                                                    </button>
                                                }
                                            }
                                        </div>
                                    }
                                </div>

                                <div class="row g-2">
                                    <div class="col-12">
                                        <label class="form-label">Nombre corto</label>
                                        <input class="form-control" @bind="CfdiReceiver.DisplayName" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">RFC</label>
                                        <input class="form-control" @bind="CfdiReceiver.Rfc" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">CP Fiscal</label>
                                        <input class="form-control" @bind="CfdiReceiver.TaxZipCode" />
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label">Razón social</label>
                                        <input class="form-control" @bind="CfdiReceiver.FiscalName" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Régimen fiscal</label>
                                        <input class="form-control" @bind="CfdiReceiver.FiscalRegime" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Uso CFDI</label>
                                        <select class="form-select" @bind="CfdiReceiver.CfdiUse">
                                            <option value="">Selecciona un uso</option>
                                            @foreach (var uso in CfdiUsoCfdiOptions)
                                            {
                                                <option value="@uso.Id">@($"{uso.Id} - {uso.Display}")</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label">Email</label>
                                        <input class="form-control" @bind="CfdiReceiver.Email" />
                                    </div>
                                </div>

                                <div class="d-flex flex-wrap gap-2 align-items-center mt-3">
                                    <div class="form-check mb-0">
                                        <input class="form-check-input" type="checkbox" id="persistCfdiCustomerCheck" @bind="PersistCfdiCustomer" />
                                        <label class="form-check-label" for="persistCfdiCustomerCheck">Guardar cliente fiscal localmente</label>
                                    </div>
                                    <button class="btn btn-sm btn-outline-secondary ms-auto"
                                            @onclick="SaveCfdiCustomerAsync"
                                            disabled="@IsSavingCfdiCustomer">
                                        @(IsSavingCfdiCustomer ? "Guardando..." : (CfdiReceiver.BusinessPartnerId.HasValue ? "Actualizar cliente fiscal" : "Guardar cliente fiscal"))
                                    </button>
                                </div>
                            </div>

                            <div class="reservacion-cfdi-panel mt-3">
                                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                    <h6 class="mb-0">Validación Facturama</h6>
                                    <span class="badge @GetCfdiReceiverValidationStatusBadgeClass()">
                                        @GetCfdiReceiverValidationStatusLabel()
                                    </span>
                                    @if (CfdiReceiverValidation is not null)
                                    {
                                        <span class="badge text-bg-secondary">@CfdiReceiverValidation.EnvironmentLabel</span>
                                    }
                                    <button class="btn btn-sm btn-outline-primary ms-auto"
                                            @onclick="ValidateCfdiReceiverAsync"
                                            disabled="@(!CanValidateCfdiReceiver || IsValidatingCfdiReceiver || IsCreatingCfdi)">
                                        @(IsValidatingCfdiReceiver ? "Validando..." : "Validar receptor")
                                    </button>
                                </div>

                                @if (CfdiReceiverValidation is null)
                                {
                                    <div class="small text-muted">
                                        Valida RFC, razón social, CP fiscal y régimen antes de timbrar.
                                    </div>
                                }
                                else
                                {
                                    <div class="alert @GetCfdiReceiverValidationAlertClass() py-2 px-3 mb-2">
                                        <div>@CfdiReceiverValidation.Message</div>
                                        @if (IsCfdiReceiverValidationStale)
                                        {
                                            <div class="small mt-1">Hay cambios pendientes en el receptor. Vuelve a validar antes de timbrar.</div>
                                        }
                                        else if (CfdiReceiverValidation.IsSandbox && !CfdiReceiverValidation.IsValid)
                                        {
                                            <div class="small mt-1">En sandbox la validación es informativa y no bloquea el timbrado.</div>
                                        }
                                    </div>

                                    <div class="table-responsive">
                                        <table class="table table-sm table-borderless mb-0">
                                            <tbody>
                                                <tr>
                                                    <td>RFC localizado</td>
                                                    <td class="text-end">
                                                        <span class="badge @GetCfdiReceiverFlagBadgeClass(CfdiReceiverValidation.ExistRfc)">
                                                            @(CfdiReceiverValidation.ExistRfc ? "Sí" : "No")
                                                        </span>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td>Razón social</td>
                                                    <td class="text-end">
                                                        <span class="badge @GetCfdiReceiverFlagBadgeClass(CfdiReceiverValidation.MatchName)">
                                                            @(CfdiReceiverValidation.MatchName ? "Coincide" : "No coincide")
                                                        </span>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td>CP fiscal</td>
                                                    <td class="text-end">
                                                        <span class="badge @GetCfdiReceiverFlagBadgeClass(CfdiReceiverValidation.MatchZipCode)">
                                                            @(CfdiReceiverValidation.MatchZipCode ? "Coincide" : "No coincide")
                                                        </span>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td>Régimen fiscal</td>
                                                    <td class="text-end">
                                                        <span class="badge @GetCfdiReceiverFlagBadgeClass(CfdiReceiverValidation.MatchFiscalRegime)">
                                                            @(CfdiReceiverValidation.MatchFiscalRegime ? "Coincide" : "No coincide")
                                                        </span>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>

                            <div class="reservacion-cfdi-panel mt-3">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <h6 class="mb-0">Datos de pago</h6>
                                </div>

                                <div class="row g-2">
                                    <div class="col-md-6">
                                        <label class="form-label">Forma de pago</label>
                                        <select class="form-select"
                                                value="@SelectedCfdiFormaPago"
                                                @onchange="OnCfdiFormaPagoChanged"
                                                disabled="@IsCfdiPaymentFormLocked">
                                            <option value="">Selecciona una forma</option>
                                            @foreach (var forma in CfdiFormaPagoOptions)
                                            {
                                                <option value="@forma.Clave">@forma.Display</option>
                                            }
                                        </select>
                                        @if (IsCfdiPaymentFormLocked)
                                        {
                                            <div class="form-text">Con método PPD se usa 99 - Por definir.</div>
                                        }
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Método de pago</label>
                                        <select class="form-select"
                                                value="@SelectedCfdiMetodoPago"
                                                @onchange="OnCfdiMetodoPagoChanged">
                                            <option value="">Selecciona un método</option>
                                            @foreach (var metodo in CfdiMetodoPagoOptions)
                                            {
                                                <option value="@metodo.Id">@($"{metodo.Id} - {metodo.Display}")</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="reservacion-cfdi-panel mt-3">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <h6 class="mb-0">Póliza destino</h6>
                                    @if (CfdiContext.PolizaOptions.Count == 0)
                                    {
                                        <span class="badge text-bg-secondary">Se creará una nueva</span>
                                    }
                                </div>

                                <label class="form-label">Selecciona destino</label>
                                <select class="form-select" @bind="SelectedCfdiPolizaOption">
                                    <option value="@NewCfdiPolizaOption">Crear nueva póliza</option>
                                    @foreach (var option in CfdiContext.PolizaOptions)
                                    {
                                        <option value="@option.TransaccionId">@FormatCfdiPolizaLabel(option)</option>
                                    }
                                </select>

                                <div class="form-text mt-2">
                                    Se reutiliza automáticamente solo cuando existe una póliza ligada que coincide con el total y todavía no tiene CFDI.
                                </div>

                                @if (CfdiContext.PolizaOptions.Count > 0)
                                {
                                    <div class="table-responsive reservacion-table-wrap mt-3">
                                        <table class="table table-sm table-bordered mb-0">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>ID</th>
                                                    <th>Fecha</th>
                                                    <th class="text-end">Monto</th>
                                                    <th>Estatus</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var option in CfdiContext.PolizaOptions)
                                                {
                                                    <tr class="@(ResolveSelectedCfdiTransaccionId() == option.TransaccionId ? "table-primary" : string.Empty)">
                                                        <td>@option.TransaccionId</td>
                                                        <td>@option.Fecha.ToShortDateString()</td>
                                                        <td class="text-end">@FormatCurrency(option.Monto)</td>
                                                        <td>
                                                            <span class="badge @GetCfdiPolizaStatusClass(option)">
                                                                @(option.IsEligible ? "Elegible" : option.HasExistingCfdi ? "Con CFDI" : option.MatchesReservationTotal ? "RFC / tipo no coincide" : "Monto distinto")
                                                            </span>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="col-12 col-xl-8">
                            <div class="reservacion-cfdi-panel">
                                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                    <h6 class="mb-0">Conceptos del CFDI</h6>
                                    <span class="badge text-bg-secondary">@CfdiContext.Items.Count conceptos</span>
                                </div>

                                <div class="table-responsive reservacion-table-wrap">
                                    <table class="table table-sm table-bordered mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Fecha</th>
                                                <th>Tipo</th>
                                                <th>Descripción</th>
                                                <th>Clave SAT</th>
                                                <th class="text-end">Subtotal</th>
                                                @if (HasCfdiDiscounts)
                                                {
                                                    <th class="text-end">Descuento</th>
                                                }
                                                <th class="text-end">IVA</th>
                                                <th class="text-end">Total</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in CfdiContext.Items)
                                            {
                                                <tr>
                                                    <td>@(item.Fecha?.ToString("yyyy-MM-dd") ?? string.Empty)</td>
                                                    <td>@item.SourceType</td>
                                                    <td class="text-wrap">@item.Description</td>
                                                    <td>@item.ProductCode / @item.UnitCode</td>
                                                    <td class="text-end">@FormatCurrency(item.Subtotal)</td>
                                                    @if (HasCfdiDiscounts)
                                                    {
                                                        <td class="text-end">@FormatCurrency(item.Discount)</td>
                                                    }
                                                    <td class="text-end">@FormatCurrency(item.Tax)</td>
                                                    <td class="text-end">@FormatCurrency(item.Total)</td>
                                                </tr>
                                            }
                                        </tbody>
                                        <tfoot class="table-light">
                                            <tr>
                                                <th colspan="4" class="text-end">Subtotal reservación</th>
                                                <th class="text-end">@FormatCurrency(CfdiContext.SubTotal)</th>
                                                @if (HasCfdiDiscounts)
                                                {
                                                    <th class="text-end">@FormatCurrency(CfdiContext.Items.Sum(item => item.Discount))</th>
                                                }
                                                <th class="text-end">@FormatCurrency(CfdiContext.Tax)</th>
                                                <th class="text-end">@FormatCurrency(CfdiContext.TotalReservacion)</th>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </div>

                            <div class="d-flex flex-wrap gap-2 justify-content-end mt-3">
                                <button class="btn btn-outline-secondary"
                                        @onclick="ToggleCfdiPanelAsync"
                                        disabled="@IsCreatingCfdi">
                                    Cerrar
                                </button>
                                <button class="btn btn-primary"
                                        @onclick="CrearCfdiReservacionAsync"
                                        disabled="@(!CanCreateReservationCfdi || IsCreatingCfdi || IsValidatingCfdiReceiver)">
                                    @(IsCreatingCfdi ? "Timbrando CFDI..." : "Crear CFDI")
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <div class="card mb-3 reservacion-section reservacion-section-suites">
        <div class="card-header reservacion-section-title d-flex align-items-center gap-2">
            <span>SUITES</span>
            <button class="btn btn-sm btn-outline-primary ms-auto" @onclick="OpenSuitePickerAsync">+</button>
            <button class="btn btn-sm btn-outline-danger" @onclick="EliminarSuitesSeleccionadasAsync">Eliminar</button>
        </div>
        <div class="card-body">
            <div class="row g-2 mb-2">
                <div class="col-md-3"><input class="form-control form-control-sm" type="number" @bind="SuiteActionValueInput" placeholder="@SuiteActionPlaceholder" disabled="@(SelectedSuiteAction == SuiteActionCleaning)" /></div>
                <div class="col-md-3">
                    <select class="form-select form-select-sm" @bind="SelectedSuiteAction">
                        @foreach (var action in SuiteActionOptions)
                        {
                            <option value="@action.Value">@action.Label</option>
                        }
                    </select>
                </div>
                <div class="col-md-2"><button class="btn btn-sm btn-outline-secondary w-100" @onclick="ApplySuiteActionAsync">Aplicar</button></div>
                <div class="col-md-6 text-muted small d-flex align-items-center">Tecla P/I/D/L/T en Access replicada con acciones rápidas.</div>
            </div>

            @if (ShowSuitePicker)
            {
                <div class="reservacion-picker-panel mb-3">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                        <strong>Suites Disponibles</strong>
                        <button class="btn btn-sm btn-success ms-auto" @onclick="AddSuitesSeleccionadasAsync">Agregar Seleccionadas</button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="CancelSuitePicker">Cerrar</button>
                    </div>
                    <div class="table-responsive reservacion-table-wrap reservacion-table-wrap--available">
                        <table class="table table-sm table-bordered mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th></th>
                                    <th>Día</th>
                                    <th>Suite</th>
                                    <th>Fecha</th>
                                    <th>Disponible</th>
                                    <th>Bloqueado por</th>
                                    <th>Precio</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in SuitesDisponibles)
                                {
                                    <tr class="@(row.IsLocked ? "table-danger" : string.Empty)">
                                        <td>
                                            <input type="checkbox"
                                                   checked="@SelectedSuiteDisponibleIds.Contains(row.Id)"
                                                   @onchange="(e) => ToggleSuiteDisponibleSelection(row.Id, e.Value is bool v && v)" />
                                        </td>
                                        <td>@row.Dia</td>
                                        <td>@row.Suite</td>
                                        <td>@row.RoomDate.ToShortDateString()</td>
                                        <td>@(row.IsLocked ? "X" : "✔")</td>
                                        <td>@row.LockedBy</td>
                                        <td>@FormatCurrency(row.Precio)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            <div class="table-responsive reservacion-table-wrap">
                <table class="table table-sm table-striped table-bordered mb-0">
                    <thead class="table-light">
                        <tr>
                            <th></th>
                            <th>Fecha</th>
                            <th>Suite</th>
                            <th>Precio</th>
                            <th>Limpieza</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var suite in Suites)
                        {
                            <tr>
                                <td>
                                    <input type="checkbox"
                                           checked="@SelectedSuiteIds.Contains(suite.Id)"
                                           @onchange="(e) => ToggleSuiteSelection(suite.Id, e.Value is bool v && v)" />
                                </td>
                                <td>@suite.Fecha.ToShortDateString()</td>
                                <td>@suite.Suite</td>
                                <td>@FormatCurrency(suite.Precio)</td>
                                <td>@(suite.LimpiezaProfunda ? "X" : string.Empty)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card mb-3 reservacion-section reservacion-section-extras">
        <div class="card-header reservacion-section-title d-flex align-items-center">
            <span>EXTRAS</span>
            <button class="btn btn-sm btn-outline-primary ms-auto" @onclick="ToggleExtraForm">+</button>
        </div>
        <div class="card-body">
            @if (ShowExtraForm)
            {
                <div class="row g-2 mb-3">
                    <div class="col-md-3">
                        <select class="form-select form-select-sm" value="@ExtraRoomId" @onchange="OnExtraRoomChanged">
                            <option value="">Suite</option>
                            @foreach (var room in Rooms)
                            {
                                <option value="@room.Id">@room.RoomName</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2"><input class="form-control form-control-sm" type="number" @bind="ExtraPrice" placeholder="Precio" /></div>
                    <div class="col-md-2"><input class="form-control form-control-sm" type="number" @bind="ExtraDiscount" placeholder="% Desc." /></div>
                    <div class="col-md-2"><input class="form-control form-control-sm" value="@ExtraTotal" readonly /></div>
                    <div class="col-md-3"><input class="form-control form-control-sm" @bind="ExtraNotes" placeholder="Notas" /></div>
                    <div class="col-md-2 d-flex gap-2">
                        <button class="btn btn-sm btn-success flex-fill" @onclick="GuardarExtraAsync">@(IsEditingExtra ? "Guardar" : "Agregar")</button>
                        <button class="btn btn-sm btn-outline-secondary flex-fill" @onclick="CancelExtraEdit">Cancelar</button>
                    </div>
                </div>
            }

            <div class="table-responsive reservacion-table-wrap">
                <table class="table table-sm table-bordered mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Suite</th>
                            <th>Descripción</th>
                            <th>Precio</th>
                            <th>Desc %</th>
                            <th>Total</th>
                            <th>Notas</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var extra in Extras)
                        {
                            <tr>
                                <td>@extra.RoomName</td>
                                <td>@extra.RoomDescription</td>
                                <td>@FormatCurrency(extra.Price)</td>
                                <td>@extra.Discount</td>
                                <td>@FormatCurrency(extra.DiscountedPrice)</td>
                                <td>@extra.Notes</td>
                                <td>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <button class="btn btn-outline-primary" @onclick="() => EditExtra(extra)">Editar</button>
                                        <button class="btn btn-outline-danger" @onclick="() => EliminarExtraAsync(extra.Id)">Eliminar</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card mb-3 reservacion-section reservacion-section-pagos">
        <div class="card-header reservacion-section-title">PAGOS</div>
        <div class="card-body">
            <div class="table-responsive reservacion-table-wrap">
                <table class="table table-sm table-striped table-bordered mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Fecha</th>
                            <th>Monto</th>
                            <th>Concepto</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pago in Pagos)
                        {
                            <tr>
                                <td>@pago.TransaccionId</td>
                                <td>@pago.Fecha.ToShortDateString()</td>
                                <td>@FormatCurrency(pago.Monto)</td>
                                <td>@pago.Concepto</td>
                                <td><button class="btn btn-sm btn-outline-primary" @onclick="() => AbrirPagoAsync(pago.TransaccionId)">Abrir</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card reservacion-section reservacion-section-archivos">
        <div class="card-header reservacion-section-title">ARCHIVOS</div>
        <div class="card-body">
            <div class="row g-2 mb-3">
                <div class="col-md-4">
                    <input class="form-control form-control-sm" @bind="AttachmentDescription" placeholder="Descripción del archivo" />
                </div>
                <div class="col-md-4">
                    <InputFile @key="_attachmentInputKey" OnChange="OnAttachmentSelectedAsync" />
                </div>
                <div class="col-md-2">
                    <button class="btn btn-sm btn-outline-primary w-100" @onclick="CargarAttachmentAsync" disabled="@IsUploadingAttachment">Cargar</button>
                </div>
            </div>

            <div class="table-responsive reservacion-table-wrap">
                <table class="table table-sm table-bordered mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Nombre</th>
                            <th>Ext</th>
                            <th>Descripción</th>
                            <th>Tamaño</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var attachment in Attachments)
                        {
                            <tr>
                                <td>@attachment.AttachmentName</td>
                                <td>@attachment.AttachmentExtension</td>
                                <td>@attachment.AttachmentDescription</td>
                                <td>@attachment.Length</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => DescargarAttachmentAsync(attachment)" disabled="@IsAttachmentDownloading(attachment)">Descargar</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => EliminarAttachmentAsync(attachment)" disabled="@IsAttachmentDeleting(attachment)">Eliminar</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    </div>
}
