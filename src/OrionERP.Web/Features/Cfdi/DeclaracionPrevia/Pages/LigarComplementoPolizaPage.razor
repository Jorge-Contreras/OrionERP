@page "/cfdi/LigarComplemento_Poliza/{DoctoRelacionado_Id:int}"
@using System.Linq
@using OrionERP.Application.Features.Contabilidad.Transacciones
@attribute [Authorize(Roles = "Administrador,SatOperator")]

<PageTitle>Ligar Complemento @DoctoRelacionado_Id a Póliza</PageTitle>

@if (IsLoading)
{
  <div class="orion-loading" role="status" aria-live="polite">
    <span class="orion-spinner" aria-hidden="true"></span>
    <span class="orion-strong">Cargando información…</span>
  </div>
}
else
{
  @if (!string.IsNullOrEmpty(InlineError))
  {
    <div class="alert alert-danger" role="alert">@InlineError</div>
  }

  @if (Summary is null)
  {
    <div class="alert alert-warning">Complemento de pago no encontrado.</div>
  }
  else
  {
    <section class="linking-workspace">
      <div class="linking-header">
        <div>
          <div class="linking-kicker">Pago20 · Docto @Summary.DoctoRelacionadoId · @Summary.Direccion</div>
          <h1>@Summary.ComprobanteUuid</h1>
          <div class="linking-uuid">Documento relacionado: @Summary.UuidDoctoRelacionado</div>
        </div>
        <div class="linking-status-strip">
          <span class="badge @GetStatusBadgeClass(Summary.TotalComplementoStatus)">Asignación @FormatStatus(Summary.TotalComplementoStatus)</span>
          <span class="badge @GetStatusBadgeClass(Summary.IvaStatus)">Comp IVA @FormatStatus(Summary.IvaStatus)</span>
        </div>
      </div>

      <div class="linking-metrics">
        <div class="linking-metric">
          <span>Imp. pagado</span>
          <strong>@FormatCurrency(Summary.ImpPagado)</strong>
        </div>
        <div class="linking-metric">
          <span>Asignado</span>
          <strong>@FormatCurrency(Summary.AsignadoComplemento)</strong>
        </div>
        <div class="linking-metric @(Summary.Pendiente < 0 ? "is-danger" : string.Empty)">
          <span>Pendiente</span>
          <strong>@FormatCurrency(Summary.Pendiente)</strong>
        </div>
        <div class="linking-metric">
          <span>Comp IVA</span>
          <strong>@FormatCurrency(Summary.CompIva)</strong>
        </div>
        <div class="linking-metric">
          <span>Monto pago</span>
          <strong>@FormatCurrency(Summary.MontoPago)</strong>
        </div>
        <div class="linking-metric">
          <span>Documentos</span>
          <strong>@Summary.RelatedDocumentsCount</strong>
        </div>
      </div>

      <div class="linking-detail-grid">
        <div>
          <span>Emisor</span>
          <strong>@Summary.EmisorRfc</strong>
        </div>
        <div>
          <span>Receptor</span>
          <strong>@Summary.ReceptorRfc</strong>
        </div>
        <div>
          <span>Fecha pago</span>
          <strong>@Summary.FechaPago?.ToString("yyyy-MM-dd")</strong>
        </div>
        <div>
          <span>Forma / Moneda</span>
          <strong>@Summary.FormaDePagoP / @Summary.MonedaP</strong>
        </div>
      </div>
    </section>

    @if (Documentos.Count > 0)
    {
      <section class="linking-section">
        <div class="linking-section-header">
          <div>
            <h2>Documentos relacionados</h2>
            <p>Detalle Pago20 del complemento, separado de CFDI regular.</p>
          </div>
        </div>
        <div class="table-responsive">
          <table class="table table-sm align-middle linking-table">
            <thead>
              <tr>
                <th>Docto</th>
                <th>UUID</th>
                <th>Folio</th>
                <th>Parcialidad</th>
                <th>Moneda</th>
                <th class="text-end">Imp. pagado</th>
                <th class="text-end">Saldo insoluto</th>
                <th class="text-end">Comp IVA</th>
              </tr>
            </thead>
            <tbody>
              @foreach (var docto in Documentos)
              {
                <tr class="@(docto.DoctoRelacionadoId == Summary.DoctoRelacionadoId ? "table-active" : string.Empty)">
                  <td class="fw-semibold">@docto.DoctoRelacionadoId</td>
                  <td class="linking-uuid">@docto.UuidDoctoRelacionado</td>
                  <td>@docto.Folio</td>
                  <td>@docto.NumParcialidad</td>
                  <td>@docto.MonedaDr</td>
                  <td class="text-end">@FormatCurrency(docto.ImpPagado)</td>
                  <td class="text-end">@FormatCurrency(docto.ImpSaldoInsoluto)</td>
                  <td class="text-end">@FormatCurrency(docto.CompIva)</td>
                </tr>
              }
            </tbody>
          </table>
        </div>
      </section>
    }

    <section class="linking-section">
      <div class="linking-section-header">
        <div>
          <h2>Pólizas vinculadas</h2>
          <p>@Polizas.Count póliza(s), @FormatCurrency(Summary.AsignadoComplemento) asignado.</p>
        </div>
      </div>

      @if (Polizas.Count == 0)
      {
        <div class="linking-empty">No hay pólizas vinculadas a este complemento.</div>
      }
      else
      {
        <div class="table-responsive">
          <table class="table table-sm align-middle linking-table">
            <thead>
              <tr>
                <th>Póliza</th>
                <th>Fecha</th>
                <th>Concepto</th>
                <th class="text-end">Monto póliza</th>
                <th class="text-end">Asignado</th>
                <th>IVA</th>
                <th>Tipo</th>
                <th>Forma</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              @foreach (var poliza in Polizas)
              {
                var editor = GetLinkedMontoEditor(poliza);
                <tr class="@(HighlightedTransaccionId == poliza.TransaccionId ? "linking-row-highlight" : string.Empty)">
                  <td class="fw-semibold">@poliza.TransaccionId</td>
                  <td>@poliza.Fecha.ToString("yyyy-MM-dd")</td>
                  <td>@poliza.Concepto</td>
                  <td class="text-end">@FormatCurrency(poliza.TransaccionMonto)</td>
                  <td class="linking-amount-editor">
                    <InputNumber class="form-control form-control-sm text-end"
                                 TValue="decimal"
                                 min="0.01"
                                 step="0.01"
                                 @bind-Value="editor.Monto"
                                 disabled="@IsSavingLinkedMonto(poliza)" />
                    <button type="button"
                            class="btn btn-sm btn-outline-primary"
                            disabled="@IsSavingLinkedMonto(poliza)"
                            @onclick="() => GuardarMontoLigadoAsync(poliza)">
                      @(IsSavingLinkedMonto(poliza) ? "Guardando" : "Guardar")
                    </button>
                  </td>
                  <td>
                    <span class="badge @GetStatusBadgeClass(poliza.IvaStatus)">@FormatStatus(poliza.IvaStatus)</span>
                    <div class="linking-subtle">@FormatCurrency(poliza.IvaContable) contable</div>
                  </td>
                  <td>@poliza.TipoPoliza</td>
                  <td>@poliza.FormaPago</td>
                  <td class="text-end">
                    <div class="d-inline-flex gap-1">
                      <a href="/contabilidad/transacciones/@poliza.TransaccionId" class="btn btn-sm btn-primary">Ver/Editar</a>
                      <button type="button"
                              class="btn btn-sm btn-outline-warning"
                              disabled="@(IsUnlinking(poliza) || IsSavingLinkedMonto(poliza))"
                              @onclick="() => DesligarAsync(poliza)">
                        @(IsUnlinking(poliza) ? "Desligando..." : "Desligar")
                      </button>
                    </div>
                  </td>
                </tr>
              }
            </tbody>
          </table>
        </div>
      }
    </section>

    <section class="linking-section">
      <div class="linking-section-header">
        <div>
          <h2>Buscar y ligar póliza</h2>
          <p>Candidatas ordenadas por pago, fecha, forma de pago y disponibilidad.</p>
        </div>
        <a href="/contabilidad/transacciones/new" class="btn btn-success">Nueva transacción</a>
      </div>

      <EditForm Model="Filter" OnSubmit="HandleFilterSubmitAsync">
        <div class="linking-filter-grid">
          <div>
            <label class="form-label">Año</label>
            <InputNumber class="form-control" @bind-Value="Filter.Year" />
          </div>
          <div>
            <label class="form-label">Mes</label>
            <InputNumber class="form-control" @bind-Value="Filter.Month" />
          </div>
          <div>
            <label class="form-label">Póliza</label>
            <InputNumber class="form-control" @bind-Value="Filter.Id" />
          </div>
          <div>
            <label class="form-label">Monto objetivo</label>
            <InputNumber class="form-control" @bind-Value="Filter.Monto" />
          </div>
          <div>
            <label class="form-label">Concepto</label>
            <InputText class="form-control" @bind-Value="Filter.Concepto" />
          </div>
          <div>
            <label class="form-label">Tipo póliza</label>
            <InputText class="form-control" @bind-Value="Filter.TipoPoliza" />
          </div>
          <div>
            <label class="form-label">Forma pago</label>
            <InputText class="form-control" @bind-Value="Filter.FormaPago" />
          </div>
          <div class="linking-filter-actions">
            <button type="submit" class="btn btn-primary" disabled="@IsCandidatesLoading">Buscar</button>
            <button type="button" class="btn btn-outline-secondary" @onclick="LimpiarFiltrosAsync" disabled="@IsCandidatesLoading">Limpiar</button>
          </div>
        </div>
      </EditForm>

      @if (SelectedCandidate is not null)
      {
        <div class="linking-selection">
          <div>
            <div class="linking-kicker">Póliza seleccionada @SelectedCandidate.Id</div>
            <strong>@SelectedCandidate.Concepto</strong>
            <div class="linking-subtle">
              Disponible @FormatCurrency(SelectedCandidate.Disponible) · sugerido @FormatCurrency(GetSuggestedMonto(SelectedCandidate))
            </div>
          </div>
          <div class="linking-selection-controls">
            <InputNumber class="form-control text-end"
                         TValue="decimal"
                         min="0.01"
                         max="@GetMaxAllowedMonto(SelectedCandidate)"
                         step="0.01"
                         @bind-Value="LinkMonto"
                         disabled="@IsLinking" />
            <button class="btn btn-primary"
                    disabled="@(!CanLigar || IsLinking)"
                    @onclick="LigarAsync">
              @(IsLinking ? "Ligando..." : "Ligar Pago20")
            </button>
          </div>
        </div>
      }

      @if (IsCandidatesLoading)
      {
        <div class="orion-loading" role="status" aria-live="polite">
          <span class="orion-spinner" aria-hidden="true"></span>
          <span class="orion-strong">Buscando candidatas...</span>
        </div>
      }
      else if (Candidates.Count == 0)
      {
        <div class="linking-empty">No se encontraron pólizas candidatas con los filtros actuales.</div>
      }
      else
      {
        <div class="table-responsive">
          <table class="table table-sm align-middle linking-table linking-candidates">
            <thead>
              <tr>
                <th>Match</th>
                <th>Póliza</th>
                <th>Fecha</th>
                <th>Concepto</th>
                <th class="text-end">Monto</th>
                <th class="text-end">Asignado</th>
                <th class="text-end">Disponible</th>
                <th class="text-end">Sugerido</th>
                <th>IVA</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              @foreach (var candidate in Candidates)
              {
                <tr class="@GetCandidateRowClass(candidate)"
                    aria-disabled="@(!candidate.CanLink)"
                    title="@candidate.BlockReason"
                    @onclick="() => SeleccionarCandidate(candidate)">
                  <td>
                    <span class="badge @GetStatusBadgeClass(candidate.MatchStatus)">@FormatStatus(candidate.MatchStatus)</span>
                    <div class="linking-subtle">@candidate.MatchScore pts</div>
                  </td>
                  <td class="fw-semibold">@candidate.Id</td>
                  <td>@candidate.Fecha.ToString("yyyy-MM-dd")</td>
                  <td>@candidate.Concepto</td>
                  <td class="text-end">@FormatCurrency(candidate.Monto)</td>
                  <td class="text-end">@FormatCurrency(candidate.MontoAsignado)</td>
                  <td class="text-end">@FormatCurrency(candidate.Disponible)</td>
                  <td class="text-end">@FormatCurrency(candidate.MontoSugerido)</td>
                  <td>
                    <span class="badge @GetStatusBadgeClass(candidate.IvaStatus)">@FormatStatus(candidate.IvaStatus)</span>
                  </td>
                  <td class="text-end">
                    <a href="/contabilidad/transacciones/@candidate.Id"
                       class="btn btn-sm btn-outline-primary"
                       @onclick:stopPropagation="true">Ver</a>
                  </td>
                </tr>
              }
            </tbody>
          </table>
        </div>
      }
    </section>
  }
}
