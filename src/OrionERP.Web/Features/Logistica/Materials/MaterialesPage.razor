@if (ShowLifecycleDialog)
{
    <div class="modal fade show d-block materiales-modal-backdrop materiales-delete-backdrop"
         role="dialog"
         aria-modal="true"
         aria-labelledby="material-lifecycle-title">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content materiales-modal materiales-delete-modal">
                <div class="modal-header">
                    <div>
                        <span class="materiales-modal-icon is-delete"><i class="bi bi-shield-check" aria-hidden="true"></i></span>
                        <h2 id="material-lifecycle-title" class="modal-title h5">Revisión de retiro seguro</h2>
                        <p>
                            @if (LifecycleAssessment is { Exists: true })
                            {
                                <span><strong>@LifecycleAssessment.MaterialCode</strong> · @LifecycleAssessment.Description</span>
                            }
                            else
                            {
                                <span>Validando el material seleccionado y todas sus relaciones.</span>
                            }
                        </p>
                    </div>
                    <button type="button"
                            class="btn-close"
                            aria-label="Cerrar"
                            @onclick="CloseLifecycleReport"
                            disabled="@IsProcessingLifecycle"></button>
                </div>

                <div class="modal-body materiales-delete-body" aria-live="polite">
                    @if (IsLoadingLifecycleAssessment)
                    {
                        <div class="materiales-delete-loading">
                            <span class="spinner-border" aria-hidden="true"></span>
                            <div>
                                <strong>Revisando dependencias</strong>
                                <span>Inventario, compras, conteos, lotes, BOM, recetas y restaurante.</span>
                            </div>
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(LifecycleAssessmentError))
                    {
                        <div class="materiales-delete-state is-error">
                            <i class="bi bi-exclamation-octagon" aria-hidden="true"></i>
                            <div>
                                <strong>No se pudo completar la revisión</strong>
                                <p>@LifecycleAssessmentError</p>
                                <button type="button" class="btn btn-outline-danger btn-sm" @onclick="RefreshLifecycleAssessmentAsync">Intentar de nuevo</button>
                            </div>
                        </div>
                    }
                    else if (LifecycleAssessment is { Exists: false })
                    {
                        <div class="materiales-delete-state is-warning">
                            <i class="bi bi-box-seam" aria-hidden="true"></i>
                            <div>
                                <strong>El material ya no está disponible</strong>
                                <p>Pudo ser eliminado por otro usuario o pertenecer a otro RFC. Actualiza el catálogo antes de continuar.</p>
                            </div>
                        </div>
                    }
                    else if (LifecycleAssessment is { Exists: true } assessment)
                    {
                        @if (!assessment.IsActive)
                        {
                            <div class="materiales-delete-summary is-inactive">
                                <span class="materiales-delete-summary-icon"><i class="bi bi-archive-fill" aria-hidden="true"></i></span>
                                <div>
                                    <span>Material desactivado</span>
                                    <strong>@assessment.MaterialCode está fuera de los flujos operativos</strong>
                                    <p>Sus relaciones permanecen visibles para auditoría. Un administrador puede reactivarlo sin alterar el historial.</p>
                                </div>
                            </div>
                        }
                        else if (assessment.OperationalBlockers.Count > 0)
                        {
                            <div class="materiales-delete-summary is-blocked">
                                <span class="materiales-delete-summary-icon"><i class="bi bi-lock-fill" aria-hidden="true"></i></span>
                                <div>
                                    <span>Retiro bloqueado</span>
                                    <strong>@assessment.OperationalReferenceCount.ToString("N0") vínculo(s) operativo(s) deben resolverse</strong>
                                    <p>Termina, retira o desactiva estas relaciones en su módulo y vuelve a revisar. No se desvincula información automáticamente.</p>
                                </div>
                            </div>
                        }
                        else if (assessment.CanDeactivate)
                        {
                            <div class="materiales-delete-summary is-retire">
                                <span class="materiales-delete-summary-icon"><i class="bi bi-archive" aria-hidden="true"></i></span>
                                <div>
                                    <span>Desactivación recomendada</span>
                                    <strong>@assessment.HistoricalReferenceCount.ToString("N0") referencia(s) históricas impiden eliminar @assessment.MaterialCode</strong>
                                    <p>Los vínculos operativos ya están libres. Desactivar conserva conteos, movimientos y demás evidencia sin ofrecer el material en operaciones nuevas.</p>
                                </div>
                            </div>
                        }
                        else if (!assessment.CanDelete)
                        {
                            <div class="materiales-delete-summary is-blocked">
                                <span class="materiales-delete-summary-icon"><i class="bi bi-link-45deg" aria-hidden="true"></i></span>
                                <div>
                                    <span>Configuración pendiente</span>
                                    <strong>@assessment.TotalReferences.ToString("N0") referencia(s) deben desvincularse para eliminar</strong>
                                    <p>No existe historial que justifique una baja. Libera toda la configuración y vuelve a revisar.</p>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="materiales-delete-summary is-clear">
                                <span class="materiales-delete-summary-icon"><i class="bi bi-shield-check" aria-hidden="true"></i></span>
                                <div>
                                    <span>Todos los vínculos están libres</span>
                                    <strong>@assessment.MaterialCode puede eliminarse</strong>
                                    <p>La revisión no encontró inventario, historial, compras, recetas, productos ni configuración relacionada.</p>
                                </div>
                            </div>
                            <div class="materiales-delete-checks" aria-label="Áreas verificadas sin relaciones">
                                <span><i class="bi bi-check2-circle" aria-hidden="true"></i> Inventario y ubicaciones</span>
                                <span><i class="bi bi-check2-circle" aria-hidden="true"></i> Compras y conteos</span>
                                <span><i class="bi bi-check2-circle" aria-hidden="true"></i> BOM, recetas y producción</span>
                                <span><i class="bi bi-check2-circle" aria-hidden="true"></i> Restaurante y configuración</span>
                            </div>
                        }

                        @foreach (var section in GetDependencySections(assessment))
                        {
                            <section class="materiales-dependency-section is-@section.CssClass">
                                <header class="materiales-dependency-heading">
                                    <span><i class="bi @section.IconClass" aria-hidden="true"></i></span>
                                    <div><h3>@section.Title</h3><p>@section.Description</p></div>
                                </header>
                                <div class="materiales-delete-blockers">
                                    @foreach (var dependency in section.Dependencies)
                                    {
                                        <article class="materiales-delete-blocker">
                                            <header>
                                                <div>
                                                    <span class="materiales-delete-blocker-icon"><i class="bi bi-link-45deg" aria-hidden="true"></i></span>
                                                    <h4>@dependency.Title</h4>
                                                </div>
                                                <span class="materiales-delete-count">@dependency.ReferenceCount.ToString("N0")</span>
                                            </header>
                                            <p>@dependency.Explanation</p>
                                            @if (dependency.Examples.Count > 0)
                                            {
                                                <ul>@foreach (var example in dependency.Examples) { <li>@example</li> }</ul>
                                            }
                                            @if (dependency.ReferenceCount > dependency.Examples.Count)
                                            {
                                                <div class="materiales-delete-more">+@((dependency.ReferenceCount - dependency.Examples.Count).ToString("N0")) referencia(s) adicional(es)</div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(GetResolutionPermissionNote(dependency)))
                                            {
                                                <small class="materiales-resolution-permission"><i class="bi bi-person-lock" aria-hidden="true"></i>@GetResolutionPermissionNote(dependency)</small>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(dependency.ResolutionUrl))
                                            {
                                                <a class="materiales-delete-resolution" href="@dependency.ResolutionUrl">
                                                    @(dependency.ResolutionLabel ?? "Revisar relación")
                                                    <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
                                                </a>
                                            }
                                        </article>
                                    }
                                </div>
                            </section>
                        }

                        @if (assessment.CanDelete && IsAdministrator)
                        {
                            <div class="materiales-delete-confirmation">
                                <div class="materiales-delete-warning">
                                    <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                                    <div><strong>Esta acción es irreversible</strong><span>La ficha, imagen y datos propios del material se eliminarán permanentemente.</span></div>
                                </div>
                                <label for="material-delete-confirmation">Para confirmar, escribe <code>Delete</code> exactamente como aparece.</label>
                                <input id="material-delete-confirmation" class="form-control form-control-lg" autocomplete="off" spellcheck="false"
                                       value="@DeletionConfirmationText"
                                       @oninput="args => DeletionConfirmationText = args.Value?.ToString() ?? string.Empty"
                                       disabled="@IsProcessingLifecycle" />
                                @if (!string.IsNullOrEmpty(DeletionConfirmationText) && !DeletionConfirmationMatches)
                                {
                                    <small class="text-danger">La confirmación distingue mayúsculas y minúsculas.</small>
                                }
                            </div>
                        }
                        else if (!IsAdministrator && (assessment.CanDelete || assessment.CanDeactivate || assessment.CanReactivate))
                        {
                            <div class="materiales-delete-state is-admin">
                                <i class="bi bi-person-lock" aria-hidden="true"></i>
                                <div><strong>Se requiere un administrador</strong><p>La revisión está disponible para Logística, pero la acción final está reservada al rol Administrador.</p></div>
                            </div>
                        }
                    }
                </div>

                <div class="modal-footer materiales-delete-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseLifecycleReport" disabled="@IsProcessingLifecycle">Cerrar</button>
                    @if (!IsLoadingLifecycleAssessment && LifecycleAssessment is { Exists: true })
                    {
                        <button type="button"
                                class="btn btn-outline-primary"
                                @onclick="RefreshLifecycleAssessmentAsync"
                                disabled="@IsProcessingLifecycle">
                            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
                            Volver a revisar
                        </button>
                    }
                    @if (LifecycleAssessment is { CanReactivate: true } && IsAdministrator)
                    {
                        <button type="button" class="btn btn-success" @onclick="ReactivateMaterialAsync" disabled="@IsProcessingLifecycle">
                            @if (IsProcessingLifecycle) { <span class="spinner-border spinner-border-sm" aria-hidden="true"></span> }
                            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
                            Reactivar material
                        </button>
                    }
                    @if (LifecycleAssessment is { CanDeactivate: true } && IsAdministrator)
                    {
                        <button type="button" class="btn btn-warning" @onclick="DeactivateMaterialAsync" disabled="@IsProcessingLifecycle">
                            @if (IsProcessingLifecycle) { <span class="spinner-border spinner-border-sm" aria-hidden="true"></span> }
                            <i class="bi bi-archive-fill" aria-hidden="true"></i>
                            Desactivar material
                        </button>
                    }
                    @if (LifecycleAssessment is { CanDelete: true, IsActive: true } && IsAdministrator)
                    {
                        <button type="button"
                                class="btn btn-danger"
                                @onclick="DeleteMaterialAsync"
                                disabled="@(!DeletionConfirmationMatches || IsProcessingLifecycle)">
                            @if (IsProcessingLifecycle)
                            {
                                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                <span>Eliminando…</span>
                            }
                            else
                            {
                                <i class="bi bi-trash3-fill" aria-hidden="true"></i>
                                <span>Eliminar permanentemente</span>
                            }
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}
