@page "/cargar-xml-sat"

<h1 class="mb-3">Cargar Facturas XML (SAT)</h1>

<!-- Upload -->
<div class="card mb-3">
    <div class="card-body">
        <h5 class="card-title">Seleccionar archivos XML</h5>
        <p class="card-text">
            Elige uno o varios <strong>archivos .xml</strong> del SAT.<br />
            Límite: @MaxFiles archivos, @MaxFileSizeDisplay por archivo.
        </p>

        <InputFile OnChange="OnFilesSelected"
                   multiple
                   accept=".xml, text/xml, application/xml"
                   disabled="@IsProcessing" />

        @if (ValidationMessages.Count > 0)
        {
            <ul class="mt-3 text-danger">
                @foreach (var msg in ValidationMessages)
                {
                    <li>@msg</li>
                }
            </ul>
        }
    </div>
</div>

<!-- Actions + selected files (only when there ARE selected files) -->
@if (SelectedFiles.Count > 0)
{
    <div class="d-flex gap-2 mb-2">
        <button type="button" class="btn btn-outline-secondary btn-sm"
                @onclick="ClearSelection" disabled="@IsProcessing">
            Limpiar selección
        </button>

        <button type="button" class="btn btn-primary btn-sm"
                disabled="@(!CanContinue)" @onclick="ContinueToProcess">
            @(IsProcessing ? "Procesando..." : "Continuar")
        </button>
    </div>

    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th>Archivo</th>
                    <th>Tamaño</th>
                    <th>MIME</th>
                    <th>Estado</th>
                    <th style="width:1%;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in SelectedFiles)
                {
                    var rowClass = string.IsNullOrWhiteSpace(f.Error) ? "" : "table-danger";
                    <tr class="@rowClass">
                        <td>@f.Name</td>
                        <td>@f.SizeDisplay</td>
                        <td>@f.ContentType</td>
                        <td>@(string.IsNullOrWhiteSpace(f.Error) ? "OK" : f.Error)</td>
                        <td class="text-nowrap">
                            <button type="button" class="btn btn-link btn-sm text-danger"
                                    @onclick="() => RemoveFile(f.Id)">
                                Quitar
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- Resultado de carga (independent of SelectedFiles) -->
@if (ProcessResults.Count > 0)
{
    <div class="d-flex align-items-center justify-content-between mt-3">
        <h6 class="mb-0">Resultado de carga</h6>
        <button type="button" class="btn btn-outline-secondary btn-sm"
                @onclick="ClearResults" disabled="@IsProcessing">
            Limpiar resultados
        </button>
    </div>
    <ul class="mt-2">
        @foreach (var r in ProcessResults)
        {
            <li>@r.FileName — @(r.Success ? "OK" : $"Error: {r.Message}")</li>
        }
    </ul>
}

<!-- XML cargados (pendientes de conciliar) (independent of SelectedFiles) -->
<div class="d-flex align-items-center justify-content-between mt-4 mb-2">
    <h5 class="mb-0">XML cargados (pendientes de conciliar)</h5>
    <button type="button" class="btn btn-outline-secondary btn-sm"
            @onclick="RefreshInvoicesAsync">
        Actualizar
    </button>
</div>


<div class="d-flex gap-2 mt-2">
    <button class="btn btn-success btn-sm"
            disabled="@(!(SelectedTransaccionId.HasValue && SelectedComprobante is not null) || IsConciliando)"
            @onclick="ConciliarAsync">
        @(IsConciliando ? "Conciliando..." : "Conciliar")
    </button>

    @if (!string.IsNullOrWhiteSpace(ConciliarMessage))
    {
        <span class="text-@(ConciliarMessage.Contains("Error") ? "danger" : "success") ms-2">
            @ConciliarMessage
        </span>
    }

</div>
@if (Invoices.Count == 0)
{
    <div class="alert alert-secondary">No hay comprobantes pendientes (Transacción 5505).</div>
}
else if (Invoices.Count > 0)
{
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th style="width:1%"></th>
                    <th>ID</th>
                    <th>Concepto</th>
                    <th>Fecha</th>
                    <th class="text-end">Monto</th>
                    <th>Cuenta</th>
                    <th class="text-center">Adjuntos</th>
                    <th class="text-center">Vinculada</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in FilteredTransacciones)
                {
                    var chosen = SelectedTransaccionId == t.Id;
                    <tr class="@(chosen ? "table-active" : "")">
                        <td class="text-center">
                            <input type="radio" name="tranChoice" checked="@chosen" @onclick="() => OnSelectTransaccion(t)" />
                        </td>
                        <td>@t.Id</td>
                        <td>@t.Concepto</td>
                        <td>@t.Fecha.ToString("yyyy-MM-dd")</td>
                        <td class="text-end">@t.Monto1.ToString("N2")</td>
                        <td>@t.Cuenta</td>
                        <td class="text-center">@t.Adjuntos</td>
                        <td class="text-center">@(t.ComprobanteId.HasValue ? "Sí" : "No")</td>
                    </tr>
                }
            </tbody>

        </table>
    </div>
}

@if (SelectedComprobante is not null)
{
    <div class="d-flex align-items-center justify-content-between mt-4 mb-2">
        <h5 class="mb-0">
            Transacciones candidatas (monto = @SelectedComprobante.Total.ToString("N2"),
            fecha &gt; @SelectedComprobante.Fecha.AddDays(-60).ToString("yyyy-MM-dd"))
        </h5>
        <button class="btn btn-outline-secondary btn-sm" @onclick="RefreshCandidatesAsync">Actualizar</button>
    </div>

    @if (FilteredTransacciones.Count == 0)
    {
        <div class="alert alert-secondary">No se encontraron transacciones candidatas.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Concepto</th>
                        <th>Fecha</th>
                        <th class="text-end">Monto</th>
                        <th>Cuenta</th>
                        <th class="text-center">Adjuntos</th>
                        <th class="text-center">Vinculada</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in FilteredTransacciones)
                    {
                        <tr>
                            <td>@t.Id</td>
                            <td>@t.Concepto</td>
                            <td>@t.Fecha.ToString("yyyy-MM-dd")</td>
                            <td class="text-end">@t.Monto1.ToString("N2")</td>
                            <td>@t.Cuenta</td>
                            <td class="text-center">@t.Adjuntos</td>
                            <td class="text-center">@(t.ComprobanteId.HasValue ? "Sí" : "No")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
