@page "/capital-humano/configuracion-tiempo"
@attribute [Authorize(Policy = "CapitalHumanoAdmin")]
@using OrionERP.Application.Features.CapitalHumano.Workforce
@inject IWorkforceConfigurationService ConfigurationService
@inject ICurrentCompanyContext RfcState
@inject IJSRuntime Js

<PageTitle>Configuración de tiempo</PageTitle>

<div class="workforce-page py-3">
  <header class="workforce-hero"><div><div class="workforce-eyebrow">Capital Humano · Configuración</div><h1>Tiempo y asistencia</h1><p>Normaliza sitios, horarios, reglas y responsables sin reemplazar los campos heredados del expediente.</p></div><button class="btn btn-outline-primary" @onclick="LoadAsync" disabled="@busy"><span class="oi oi-reload me-1"></span>Actualizar</button></header>
  @if(!string.IsNullOrWhiteSpace(message)){<div class="alert @(messageIsError?"alert-danger":"alert-success") workforce-alert">@message</div>}
  <nav class="workforce-tabs" role="tablist" aria-label="Secciones de configuración de tiempo">
    @foreach (var item in tabs)
    {
      <button type="button"
              class="workforce-tab"
              role="tab"
              aria-selected="@(tab == item.Value ? "true" : "false")"
              @onclick="() => SelectTab(item.Value)">@item.Label</button>
    }
  </nav>
  @if(setup is null){<div class="workforce-card"><div class="workforce-card__body">Cargando configuración…</div></div>}
  else if(tab=="readiness")
  {
    <section class="workforce-card"><div class="workforce-card__header"><h2>Lista de preparación</h2><span class="workforce-status @(setup.Readiness.Any(x=>!x.IsReady)?"workforce-status--warn":"")">@setup.Readiness.Count(x=>x.IsReady) / @setup.Readiness.Count listos</span></div><div class="table-responsive"><table class="table workforce-table"><thead><tr><th>Empleado</th><th>Acceso</th><th>Asignación</th><th>Supervisor</th><th>Estado</th></tr></thead><tbody>@if(setup.Readiness.Count==0){<tr><td colspan="5" class="workforce-empty">No hay empleados activos en la empresa de tu sesión.</td></tr>}@foreach(var item in setup.Readiness){<tr><td class="fw-semibold">@item.EmployeeName <span class="workforce-label">#@item.EmployeeId</span></td><td>@Check(item.HasLogin)</td><td>@Check(item.HasWorkAssignment)</td><td>@Check(item.HasSupervisor)</td><td><span class="workforce-status @(item.IsReady?"":"workforce-status--warn")">@(item.IsReady?"Listo":"Requiere configuración")</span></td></tr>}</tbody></table></div></section>
  }
  else if(tab=="sites")
  {
    <div class="workforce-grid">
      <section class="workforce-card workforce-span-5"><div class="workforce-card__header"><h2>@(site.Id.HasValue?"Editar sitio":"Nuevo sitio y geocerca")</h2>@if(site.Id.HasValue){<button class="btn btn-sm btn-outline-secondary" disabled="@busy" @onclick="CancelSiteEdit">Cancelar</button>}</div><div class="workforce-card__body"><div class="workforce-form"><Field Label="Código"><input class="form-control" maxlength="30" @bind="site.Code" /></Field><Field Label="Nombre"><input class="form-control" maxlength="150" @bind="site.Name" /></Field><Field Label="Latitud"><input type="number" step=".000001" class="form-control" @bind="site.Latitude" /></Field><Field Label="Longitud"><input type="number" step=".000001" class="form-control" @bind="site.Longitude" /></Field><Field Label="Radio (m)"><input type="number" class="form-control" @bind="site.RadiusMeters" /></Field><Field Label="Precisión máxima (m)"><input type="number" class="form-control" @bind="site.MaxAccuracyMeters" /></Field><div class="span-2"><label class="form-label">Zona horaria</label><input class="form-control" @bind="site.TimeZoneId" /></div><div class="span-2 form-check"><input id="site-active" type="checkbox" class="form-check-input" @bind="site.IsActive" /><label for="site-active" class="form-check-label">Sitio activo</label></div><div class="span-2"><p class="workforce-label">El radio define la geocerca y la precisión máxima descarta lecturas GPS pobres. Solo los sitios activos pueden vincular kioscos o recibir asignaciones.</p><button class="btn btn-primary" disabled="@busy" @onclick="SaveSiteAsync">@(busy?"Guardando…":site.Id.HasValue?"Actualizar sitio":"Guardar sitio")</button></div></div></div></section>
      <section class="workforce-card workforce-span-7"><div class="workforce-card__header"><h2>Sitios configurados</h2><span class="workforce-status @(setup.Sites.Count(x=>x.IsActive)==0?"workforce-status--warn":"")">@setup.Sites.Count(x=>x.IsActive) activos / @setup.Sites.Count</span></div><div class="table-responsive"><table class="table workforce-table"><thead><tr><th>Código</th><th>Sitio</th><th>Geocerca</th><th>Zona</th><th>Estado</th><th></th></tr></thead><tbody>@if(setup.Sites.Count==0){<tr><td colspan="6" class="workforce-empty">Aún no hay sitios. Crea el primero con coordenadas validadas.</td></tr>}@foreach(var item in setup.Sites){<tr><td>@item.Code</td><td class="fw-semibold">@item.Name<div class="workforce-label">@item.Latitude.ToString("0.#####"), @item.Longitude.ToString("0.#####")</div></td><td>@item.RadiusMeters m · ±@item.MaxAccuracyMeters m</td><td>@item.TimeZoneId</td><td><span class="workforce-status @(item.IsActive?"":"workforce-status--muted")">@(item.IsActive?"Activo":"Inactivo")</span></td><td class="workforce-actions"><button class="btn btn-sm btn-outline-secondary" disabled="@busy" @onclick="()=>EditSite(item)">Editar</button><button class="btn btn-sm btn-outline-secondary" disabled="@busy" @onclick="()=>ToggleSiteAsync(item)">@(item.IsActive?"Desactivar":"Activar")</button><button class="btn btn-sm btn-outline-danger" disabled="@busy" @onclick="()=>DeleteSiteAsync(item)">Eliminar</button></td></tr>}</tbody></table></div></section>
    </div>
  }
  else if(tab=="schedules")
  {
    <div class="workforce-grid">
      <section class="workforce-card workforce-span-5"><div class="workforce-card__header"><h2>@(schedule.Id.HasValue?"Editar plantilla":"Nueva plantilla semanal")</h2>@if(schedule.Id.HasValue){<button class="btn btn-sm btn-outline-secondary" disabled="@busy" @onclick="CancelScheduleEdit">Cancelar</button>}</div><div class="workforce-card__body">
        <div class="workforce-form mb-3"><Field Label="Código"><input class="form-control" maxlength="30" @bind="schedule.Code" /></Field><Field Label="Nombre"><input class="form-control" maxlength="150" @bind="schedule.Name" /></Field></div>
        <div class="table-responsive"><table class="table workforce-table"><thead><tr><th>Día</th><th>Labora</th><th>Entrada</th><th>Salida</th></tr></thead><tbody>@foreach(var day in scheduleDays){<tr><td class="fw-semibold">@DayName(day.DayOfWeek)</td><td><input type="checkbox" class="form-check-input" @bind="day.IsWorkingDay" /></td><td><input type="time" class="form-control" disabled="@(!day.IsWorkingDay)" @bind="day.StartTime" /></td><td><input type="time" class="form-control" disabled="@(!day.IsWorkingDay)" @bind="day.EndTime" /></td></tr>}</tbody></table></div>
        <div class="workforce-form mt-3"><div class="span-2 form-check"><input id="schedule-has-break" type="checkbox" class="form-check-input" @bind="scheduleHasBreak" /><label for="schedule-has-break" class="form-check-label">La jornada incluye descanso</label></div>@if(scheduleHasBreak){<Field Label="Inicio descanso"><input type="time" class="form-control" @bind="scheduleBreakStart" /></Field><Field Label="Duración (min)"><input type="number" min="1" max="480" class="form-control" @bind="scheduleBreak" /></Field><div class="span-2 form-check"><input id="schedule-break-paid" type="checkbox" class="form-check-input" @bind="scheduleBreakPaid" /><label for="schedule-break-paid" class="form-check-label">El descanso es pagado</label></div>}<div class="span-2 form-check"><input id="schedule-active" type="checkbox" class="form-check-input" @bind="schedule.IsActive" /><label for="schedule-active" class="form-check-label">Plantilla activa</label></div><div class="span-2"><p class="workforce-label">Cada día laborable puede tener horario distinto y puede cruzar medianoche (salida menor que la entrada). Un descanso no pagado se descuenta de la jornada programada.</p><button class="btn btn-primary" disabled="@busy" @onclick="SaveScheduleAsync">@(busy?"Guardando…":schedule.Id.HasValue?"Actualizar plantilla":"Guardar plantilla")</button></div></div>
      </div></section>
      <section class="workforce-card workforce-span-7"><div class="workforce-card__header"><h2>Horarios</h2><span class="workforce-status @(setup.Schedules.Count(x=>x.IsActive)==0?"workforce-status--warn":"")">@setup.Schedules.Count(x=>x.IsActive) activos / @setup.Schedules.Count</span></div><div class="table-responsive"><table class="table workforce-table"><thead><tr><th>Código</th><th>Nombre</th><th>Días</th><th>Jornada</th><th>Descanso</th><th>Estado</th><th></th></tr></thead><tbody>@if(setup.Schedules.Count==0){<tr><td colspan="7" class="workforce-empty">Aún no hay plantillas de horario.</td></tr>}@foreach(var item in setup.Schedules){var firstBreak=item.Breaks.FirstOrDefault();<tr><td>@item.Code</td><td class="fw-semibold">@item.Name</td><td>@DayInitials(item)<div class="workforce-label">@item.Days.Count(x=>x.IsWorkingDay) días</div></td><td>@FormatScheduleSpan(item)</td><td>@(firstBreak is null?"Sin descanso":$"{firstBreak.DurationMinutes} min · {(firstBreak.IsPaid?"pagado":"no pagado")}")</td><td><span class="workforce-status @(item.IsActive?"":"workforce-status--muted")">@(item.IsActive?"Activa":"Inactiva")</span></td><td class="workforce-actions"><button class="btn btn-sm btn-outline-secondary" disabled="@busy" @onclick="()=>EditSchedule(item)">Editar</button><button class="btn btn-sm btn-outline-secondary" disabled="@busy" @onclick="()=>ToggleScheduleAsync(item)">@(item.IsActive?"Desactivar":"Activar")</button><button class="btn btn-sm btn-outline-danger" disabled="@busy" @onclick="()=>DeleteScheduleAsync(item)">Eliminar</button></td></tr>}</tbody></table></div></section>
    </div>
  }
  else if(tab=="assignments")
  {
    <div class="workforce-grid">
      <section class="workforce-card workforce-span-5"><div class="workforce-card__header"><h2>@(assignment.Id.HasValue?"Editar asignación":"Asignación normalizada")</h2>@if(assignment.Id.HasValue){<button class="btn btn-sm btn-outline-secondary" disabled="@busy" @onclick="CancelAssignmentEdit">Cancelar</button>}</div><div class="workforce-card__body"><div class="workforce-form"><div class="span-2"><label class="form-label">Empleado</label><select class="form-select" disabled="@assignment.Id.HasValue" @bind="assignment.EmployeeId"><option value="0">Selecciona</option>@foreach(var e in setup.Employees){<option value="@e.EmployeeId">@e.Name</option>}</select>@if(assignment.Id.HasValue){<div class="workforce-label mt-1">Para mover la asignación a otra persona, elimínala y crea una nueva.</div>}</div><Field Label="Sitio"><select class="form-select" @bind="assignment.SiteId"><option value="0">Selecciona</option>@foreach(var x in setup.Sites.Where(x=>x.IsActive||x.Id==assignment.SiteId)){<option value="@x.Id">@x.Name</option>}</select></Field><Field Label="Horario"><select class="form-select" @bind="assignment.ScheduleTemplateId"><option value="0">Selecciona</option>@foreach(var x in setup.Schedules.Where(x=>x.IsActive||x.Id==assignment.ScheduleTemplateId)){<option value="@x.Id">@x.Name</option>}</select></Field><Field Label="Política"><select class="form-select" @bind="assignment.AttendancePolicyId"><option value="0">Selecciona</option>@foreach(var x in setup.Policies.Where(x=>x.IsActive||x.Id==assignment.AttendancePolicyId)){<option value="@x.Id">@x.Name</option>}</select></Field><Field Label="Grupo de pago"><select class="form-select" @bind="assignment.PayGroupId"><option value="0">Selecciona</option>@foreach(var x in setup.PayGroups.Where(x=>x.IsActive||x.Id==assignment.PayGroupId)){<option value="@x.Id">@x.Name</option>}</select></Field><Field Label="Vigente desde"><input type="date" class="form-control" @bind="assignment.EffectiveFrom" /></Field><Field Label="Vigente hasta"><input type="date" class="form-control" @bind="assignment.EffectiveTo" /></Field><div class="span-2"><p class="workforce-label">Deja "Vigente hasta" vacío para una asignación abierta. Las vigencias de un mismo empleado no pueden traslaparse: cierra la anterior antes de abrir la siguiente.</p><button class="btn btn-primary" disabled="@busy" @onclick="SaveAssignmentAsync">@(busy?"Guardando…":assignment.Id.HasValue?"Actualizar asignación":"Guardar asignación")</button></div></div></div></section>
      <section class="workforce-card workforce-span-7"><div class="workforce-card__header"><h2>Asignaciones</h2><span class="workforce-status @(setup.WorkAssignments.Count(IsCurrent)==0?"workforce-status--warn":"")">@setup.WorkAssignments.Count(IsCurrent) vigentes / @setup.WorkAssignments.Count</span></div><div class="table-responsive"><table class="table workforce-table"><thead><tr><th>Empleado</th><th>Sitio y horario</th><th>Política y pago</th><th>Vigencia</th><th></th></tr></thead><tbody>@if(setup.WorkAssignments.Count==0){<tr><td colspan="5" class="workforce-empty">No hay asignaciones para este RFC.</td></tr>}@foreach(var item in setup.WorkAssignments){<tr><td class="fw-semibold">@item.EmployeeName</td><td>@item.SiteName<div class="workforce-label">@item.ScheduleName</div></td><td>@item.PolicyName<div class="workforce-label">@item.PayGroupName</div></td><td>@FormatRange(item.EffectiveFrom,item.EffectiveTo)<div class="mt-1"><span class="workforce-status @(RangeCss(item.EffectiveFrom,item.EffectiveTo))">@RangeLabel(item.EffectiveFrom,item.EffectiveTo)</span></div></td><td class="workforce-actions"><button class="btn btn-sm btn-outline-secondary" disabled="@busy" @onclick="()=>EditAssignment(item)">Editar</button>@if(item.EffectiveTo is null){<button class="btn btn-sm btn-outline-secondary" disabled="@busy" @onclick="()=>CloseAssignmentAsync(item)">Terminar hoy</button>}<button class="btn btn-sm btn-outline-danger" disabled="@busy" @onclick="()=>DeleteAssignmentAsync(item)">Eliminar</button></td></tr>}</tbody></table></div></section>
    </div>
  }
  else if(tab=="supervisors")
  {
    <div class="workforce-grid">
      <section class="workforce-card workforce-span-5"><div class="workforce-card__header"><h2>@(supervisor.Id.HasValue?"Editar responsable":"Responsable efectivo")</h2>@if(supervisor.Id.HasValue){<button class="btn btn-sm btn-outline-secondary" disabled="@busy" @onclick="CancelSupervisorEdit">Cancelar</button>}</div><div class="workforce-card__body"><div class="workforce-form"><div class="span-2"><label class="form-label">Empleado</label><select class="form-select" disabled="@supervisor.Id.HasValue" @bind="supervisor.EmployeeId"><option value="0">Selecciona</option>@foreach(var e in setup.Employees){<option value="@e.EmployeeId">@e.Name</option>}</select>@if(supervisor.Id.HasValue){<div class="workforce-label mt-1">Para cambiar de empleado, elimina la relación y crea una nueva.</div>}</div><div class="span-2"><label class="form-label">Supervisor</label><select class="form-select" @bind="supervisor.SupervisorEmployeeId"><option value="0">Selecciona</option>@foreach(var e in setup.Employees){<option value="@e.EmployeeId">@e.Name</option>}</select></div><Field Label="Vigente desde"><input type="date" class="form-control" @bind="supervisor.EffectiveFrom" /></Field><Field Label="Vigente hasta"><input type="date" class="form-control" @bind="supervisor.EffectiveTo" /></Field><div class="span-2"><p class="workforce-label">El supervisor vigente es quien aprueba incidencias, correcciones y tiempo extra. Las vigencias de un mismo empleado no pueden traslaparse.</p><button class="btn btn-primary" disabled="@busy" @onclick="SaveSupervisorAsync">@(busy?"Guardando…":supervisor.Id.HasValue?"Actualizar responsable":"Guardar responsable")</button></div></div></div></section>
      <section class="workforce-card workforce-span-7"><div class="workforce-card__header"><h2>Equipos</h2><span class="workforce-status @(setup.SupervisorAssignments.Count(IsCurrent)==0?"workforce-status--warn":"")">@setup.SupervisorAssignments.Count(IsCurrent) vigentes / @setup.SupervisorAssignments.Count</span></div><div class="table-responsive"><table class="table workforce-table"><thead><tr><th>Empleado</th><th>Supervisor</th><th>Vigencia</th><th></th></tr></thead><tbody>@if(setup.SupervisorAssignments.Count==0){<tr><td colspan="4" class="workforce-empty">Aún no hay relaciones de supervisión.</td></tr>}@foreach(var item in setup.SupervisorAssignments){<tr><td>@item.EmployeeName</td><td class="fw-semibold">@item.SupervisorName</td><td>@FormatRange(item.EffectiveFrom,item.EffectiveTo)<div class="mt-1"><span class="workforce-status @(RangeCss(item.EffectiveFrom,item.EffectiveTo))">@RangeLabel(item.EffectiveFrom,item.EffectiveTo)</span></div></td><td class="workforce-actions"><button class="btn btn-sm btn-outline-secondary" disabled="@busy" @onclick="()=>EditSupervisor(item)">Editar</button>@if(item.EffectiveTo is null){<button class="btn btn-sm btn-outline-secondary" disabled="@busy" @onclick="()=>CloseSupervisorAsync(item)">Terminar hoy</button>}<button class="btn btn-sm btn-outline-danger" disabled="@busy" @onclick="()=>DeleteSupervisorAsync(item)">Eliminar</button></td></tr>}</tbody></table></div></section>
    </div>
  }
  else if(tab=="policies")
  {
    <div class="workforce-grid">
      <section class="workforce-card workforce-span-5"><div class="workforce-card__header"><h2>@(policy.Id>0?"Editar política":"Nueva política")</h2>@if(policy.Id>0){<button class="btn btn-sm btn-outline-secondary" disabled="@busy" @onclick="CancelPolicyEdit">Cancelar</button>}</div><div class="workforce-card__body"><div class="workforce-form"><Field Label="Código"><input class="form-control" maxlength="30" @bind="policy.Code" /></Field><Field Label="Nombre"><input class="form-control" maxlength="150" @bind="policy.Name" /></Field><Field Label="Vigente desde"><input type="date" class="form-control" @bind="policy.EffectiveFrom" /></Field><Field Label="Vigente hasta"><input type="date" class="form-control" @bind="policy.EffectiveTo" /></Field><Field Label="Ordinaria (h/semana)"><input type="number" step=".25" min="1" max="168" class="form-control" @bind="policyOrdinaryHours" /></Field><Field Label="Doble (h/semana)"><input type="number" step=".25" min="0" max="168" class="form-control" @bind="policyDoubleHours" /></Field><Field Label="Triple (h/semana)"><input type="number" step=".25" min="0" max="168" class="form-control" @bind="policyTripleHours" /></Field><Field Label="Tolerancia (min)"><input type="number" min="0" max="120" class="form-control" @bind="policy.GraceMinutes" /></Field><Field Label="Redondeo (min)"><input type="number" min="1" max="60" class="form-control" @bind="policy.RoundingMinutes" /></Field><div class="span-2 form-check"><input id="policy-location" type="checkbox" class="form-check-input" @bind="policy.LocationRequired" /><label for="policy-location" class="form-check-label">Exigir ubicación al registrar asistencia</label></div><div class="span-2 form-check"><input id="policy-active" type="checkbox" class="form-check-input" @bind="policy.IsActive" /><label for="policy-active" class="form-check-label">Política activa</label></div><div class="span-2 form-check"><input id="policy-review" type="checkbox" class="form-check-input" @bind="policy.RequiresReview" /><label for="policy-review" class="form-check-label">Dejar pendiente de validación de Capital Humano</label></div><div class="span-2"><p class="workforce-label">Las horas se guardan en minutos. Toda versión editada debería revalidarse antes de usarse en pre-nómina.</p><button class="btn btn-primary" disabled="@busy" @onclick="SavePolicyAsync">@(busy?"Guardando…":policy.Id>0?"Actualizar política":"Guardar política")</button></div></div></div></section>
      <section class="workforce-card workforce-span-7"><div class="workforce-card__header"><h2>Políticas efectivas México 2026–2030</h2><span class="workforce-status @(PendingPolicies>0?"workforce-status--warn":"")">@(PendingPolicies>0?$"{PendingPolicies} por validar":"Todas validadas")</span></div><div class="table-responsive"><table class="table workforce-table"><thead><tr><th>Vigencia</th><th>Política</th><th>Horas semana</th><th>Estado</th><th></th></tr></thead><tbody>@if(setup.Policies.Count==0){<tr><td colspan="5" class="workforce-empty">No hay versiones de política configuradas.</td></tr>}@foreach(var item in setup.Policies){<tr><td>@item.EffectiveFrom.ToString("dd MMM yyyy")<div class="workforce-label">@(item.EffectiveTo is null?"Sin fecha final":$"al {item.EffectiveTo.Value:dd MMM yyyy}")</div></td><td class="fw-semibold">@item.Name<div class="workforce-label">@item.Code</div></td><td>@FormatHours(item.WeeklyOrdinaryMinutes) / @FormatHours(item.WeeklyDoubleOvertimeMinutes) / @FormatHours(item.WeeklyTripleOvertimeMinutes) h<div class="workforce-label">ordinaria / doble / triple</div></td><td><span class="workforce-status @(item.RequiresReview?"workforce-status--warn":"")">@(item.RequiresReview?"Pendiente de validar":"Validada")</span><div class="mt-1"><span class="workforce-status @(item.IsActive?"":"workforce-status--muted")">@(item.IsActive?"Activa":"Inactiva")</span></div></td><td class="workforce-actions">@if(item.RequiresReview){<button class="btn btn-sm btn-outline-primary" disabled="@busy" @onclick="()=>ApprovePolicyAsync(item)">Validar</button>}<button class="btn btn-sm btn-outline-secondary" disabled="@busy" @onclick="()=>EditPolicy(item)">Editar</button><button class="btn btn-sm btn-outline-secondary" disabled="@busy" @onclick="()=>TogglePolicyAsync(item)">@(item.IsActive?"Desactivar":"Activar")</button></td></tr>}</tbody></table></div></section>
      <section class="workforce-card workforce-span-5"><div class="workforce-card__header"><h2>@(payGroup.Id>0?"Editar grupo de pago":"Nuevo grupo de pago")</h2>@if(payGroup.Id>0){<button class="btn btn-sm btn-outline-secondary" disabled="@busy" @onclick="CancelPayGroupEdit">Cancelar</button>}</div><div class="workforce-card__body"><div class="workforce-form"><Field Label="Código"><input class="form-control" maxlength="30" @bind="payGroup.Code" /></Field><Field Label="Nombre"><input class="form-control" maxlength="150" @bind="payGroup.Name" /></Field><Field Label="Frecuencia"><select class="form-select" @bind="payGroup.Frequency"><option value="WEEKLY">Semanal</option><option value="BIWEEKLY">Quincenal</option><option value="MONTHLY">Mensual</option></select></Field><div class="span-2 form-check"><input id="paygroup-active" type="checkbox" class="form-check-input" @bind="payGroup.IsActive" /><label for="paygroup-active" class="form-check-label">Grupo activo</label></div><div class="span-2"><p class="workforce-label">Solo los grupos activos aparecen al asignar empleados y al abrir periodos de pre-nómina.</p><button class="btn btn-primary" disabled="@busy" @onclick="SavePayGroupAsync">@(busy?"Guardando…":payGroup.Id>0?"Actualizar grupo":"Guardar grupo")</button></div></div></div></section>
      <section class="workforce-card workforce-span-7"><div class="workforce-card__header"><h2>Grupos de pago</h2><span class="workforce-status">@setup.PayGroups.Count(x=>x.IsActive) activos / @setup.PayGroups.Count</span></div><div class="table-responsive"><table class="table workforce-table"><thead><tr><th>Código</th><th>Nombre</th><th>Frecuencia</th><th>Estado</th><th></th></tr></thead><tbody>@if(setup.PayGroups.Count==0){<tr><td colspan="5" class="workforce-empty">Aún no hay grupos de pago. Crea al menos uno para poder asignar empleados.</td></tr>}@foreach(var item in setup.PayGroups){<tr><td>@item.Code</td><td class="fw-semibold">@item.Name</td><td>@FrequencyLabel(item.Frequency)</td><td><span class="workforce-status @(item.IsActive?"":"workforce-status--muted")">@(item.IsActive?"Activo":"Inactivo")</span></td><td class="workforce-actions"><button class="btn btn-sm btn-outline-secondary" disabled="@busy" @onclick="()=>EditPayGroup(item)">Editar</button><button class="btn btn-sm btn-outline-secondary" disabled="@busy" @onclick="()=>TogglePayGroupAsync(item)">@(item.IsActive?"Desactivar":"Activar")</button><button class="btn btn-sm btn-outline-danger" disabled="@busy" @onclick="()=>DeletePayGroupAsync(item)">Eliminar</button></td></tr>}</tbody></table></div></section>
    </div>
  }
  else if(tab=="holidays")
  {
    <div class="workforce-grid">
      <section class="workforce-card workforce-span-5"><div class="workforce-card__header"><h2>@(holiday.Id.HasValue?"Editar día festivo":"Día festivo")</h2>@if(holiday.Id.HasValue){<button class="btn btn-sm btn-outline-secondary" disabled="@busy" @onclick="CancelHolidayEdit">Cancelar</button>}</div><div class="workforce-card__body"><div class="workforce-form"><div class="span-2"><label class="form-label">Nombre</label><input class="form-control" maxlength="150" @bind="holiday.Name"/></div><Field Label="Fecha"><input type="date" class="form-control" @bind="holiday.HolidayDate"/></Field><Field Label="Sitio opcional"><select class="form-select" @bind="holiday.SiteId"><option value="">Todos</option>@foreach(var x in setup.Sites){<option value="@x.Id">@x.Name</option>}</select></Field><div class="span-2 form-check"><input id="holiday-paid" type="checkbox" class="form-check-input" @bind="holiday.IsPaid"/><label for="holiday-paid" class="form-check-label">Día festivo pagado</label></div><div class="span-2"><p class="workforce-label">Solo puede existir un festivo por fecha y alcance. Deja el sitio vacío para aplicarlo a toda la empresa.</p><button class="btn btn-primary" disabled="@busy" @onclick="SaveHolidayAsync">@(busy?"Guardando…":holiday.Id.HasValue?"Actualizar festivo":"Guardar festivo")</button></div></div></div></section>
      <section class="workforce-card workforce-span-7"><div class="workforce-card__header"><h2>Calendario</h2><span class="workforce-status">@setup.Holidays.Count</span></div><div class="table-responsive"><table class="table workforce-table"><thead><tr><th>Fecha</th><th>Nombre</th><th>Alcance</th><th>Pagado</th><th></th></tr></thead><tbody>@if(setup.Holidays.Count==0){<tr><td colspan="5" class="workforce-empty">No hay días festivos configurados.</td></tr>}@foreach(var item in setup.Holidays){<tr><td>@item.HolidayDate.ToString("dd MMM yyyy")</td><td class="fw-semibold">@item.Name</td><td>@(item.SiteId.HasValue?setup.Sites.FirstOrDefault(x=>x.Id==item.SiteId)?.Name:"Todos los sitios")</td><td>@Check(item.IsPaid)</td><td class="workforce-actions"><button class="btn btn-sm btn-outline-secondary" disabled="@busy" @onclick="()=>EditHoliday(item)">Editar</button><button class="btn btn-sm btn-outline-danger" disabled="@busy" @onclick="()=>DeleteHolidayAsync(item)">Eliminar</button></td></tr>}</tbody></table></div></section>
    </div>
  }
  else if(tab=="kiosks")
  {
    <div class="workforce-grid">
      <section class="workforce-card workforce-span-4"><div class="workforce-card__header"><h2>@(kioskDevice.Id>0?"Editar kiosco":"Vincular kiosco")</h2>@if(kioskDevice.Id>0){<button class="btn btn-sm btn-outline-secondary" disabled="@busy" @onclick="CancelKioskEdit">Cancelar</button>}</div><div class="workforce-card__body">@if(kioskDevice.Id>0){<label class="form-label">Nombre del dispositivo</label><input class="form-control mb-2" maxlength="150" @bind="kioskDevice.Name"/><label class="form-label">Sitio</label><select class="form-select mb-2" @bind="kioskDevice.SiteId"><option value="0">Selecciona</option>@foreach(var x in setup.Sites){<option value="@x.Id">@x.Name</option>}</select><div class="form-check mb-3"><input id="kiosk-active" type="checkbox" class="form-check-input" @bind="kioskDevice.IsActive"/><label for="kiosk-active" class="form-check-label">Kiosco activo</label></div><button class="btn btn-primary" disabled="@busy" @onclick="SaveKioskDeviceAsync">@(busy?"Guardando…":"Guardar kiosco")</button>}else{<label class="form-label">Nombre del dispositivo</label><input class="form-control mb-2" maxlength="150" @bind="pairing.DeviceName"/><label class="form-label">Sitio</label><select class="form-select mb-3" @bind="pairing.SiteId"><option value="0">Selecciona</option>@foreach(var x in setup.Sites.Where(x=>x.IsActive)){<option value="@x.Id">@x.Name</option>}</select><button class="btn btn-primary" disabled="@busy" @onclick="CreatePairingAsync">@(busy?"Generando…":"Generar código")</button>}@if(pairingResult is not null){<div class="alert alert-warning mt-3 text-center"><div class="workforce-label">Código de un solo uso</div><div class="workforce-stat">@pairingResult.Code</div><small>Expira @pairingResult.ExpiresAtUtc.ToLocalTime().ToString("HH:mm")</small></div>}</div></section>
      <section class="workforce-card workforce-span-8"><div class="workforce-card__header"><h2>Dispositivos</h2><span class="workforce-status @(setup.Kiosks.Count(x=>x.IsPaired)==0?"workforce-status--warn":"")">@setup.Kiosks.Count(x=>x.IsPaired) vinculados / @setup.Kiosks.Count</span></div><div class="table-responsive"><table class="table workforce-table"><thead><tr><th>Dispositivo</th><th>Sitio</th><th>Estado</th><th>Última señal</th><th></th></tr></thead><tbody>@if(setup.Kiosks.Count==0){<tr><td colspan="5" class="workforce-empty">No hay kioscos registrados.</td></tr>}@foreach(var item in setup.Kiosks){<tr><td class="fw-semibold">@item.Name</td><td>@item.SiteName</td><td><span class="workforce-status @(item.IsPaired?"":"workforce-status--warn")">@(item.IsPaired?"Vinculado":"Pendiente de vincular")</span><div class="mt-1"><span class="workforce-status @(item.IsActive?"":"workforce-status--muted")">@(item.IsActive?"Activo":"Inactivo")</span></div></td><td>@(item.LastSeenAtUtc is null?"—":item.LastSeenAtUtc.Value.ToLocalTime().ToString("dd MMM HH:mm"))</td><td class="workforce-actions"><button class="btn btn-sm btn-outline-secondary" disabled="@busy" @onclick="()=>EditKioskDevice(item)">Editar</button><button class="btn btn-sm btn-outline-primary" disabled="@busy" @onclick="()=>RegeneratePairingAsync(item)">@(item.IsPaired?"Revincular":"Nuevo código")</button>@if(item.IsPaired){<button class="btn btn-sm btn-outline-secondary" disabled="@busy" @onclick="()=>ToggleKioskAsync(item)">@(item.IsActive?"Desactivar":"Activar")</button>}<button class="btn btn-sm btn-outline-danger" disabled="@busy" @onclick="()=>DeleteKioskDeviceAsync(item)">Eliminar</button></td></tr>}</tbody></table></div></section>
      <section class="workforce-card workforce-span-4"><div class="workforce-card__header"><h2>Credencial de empleado</h2></div><div class="workforce-card__body"><label class="form-label">Empleado</label><select class="form-select mb-2" @bind="credential.EmployeeId"><option value="0">Selecciona</option>@foreach(var e in setup.Employees){<option value="@e.EmployeeId">@e.Name</option>}</select><label class="form-label">PIN numérico</label><input type="password" inputmode="numeric" maxlength="12" autocomplete="new-password" class="form-control mb-1" @bind="credential.Pin"/><div class="workforce-label mb-3">Entre 4 y 12 dígitos, sin repetir el mismo número.</div><button class="btn btn-primary" disabled="@busy" @onclick="CreateCredentialAsync">@(busy?"Procesando…":"Crear / rotar")</button>@if(credentialResult?.BadgeToken is not null){<div class="alert alert-warning mt-3"><strong>Código de gafete (única vez)</strong><div class="text-break font-monospace mt-2">@credentialResult.BadgeToken</div></div>}</div></section>
      <section class="workforce-card workforce-span-8"><div class="workforce-card__header"><h2>Credenciales emitidas</h2><span class="workforce-status">@setup.KioskCredentials.Count(x=>x.IsActive) activas / @setup.KioskCredentials.Count</span></div><div class="table-responsive"><table class="table workforce-table"><thead><tr><th>Empleado</th><th>Emitida</th><th>Estado</th><th></th></tr></thead><tbody>@if(setup.KioskCredentials.Count==0){<tr><td colspan="4" class="workforce-empty">Ningún empleado tiene credencial de kiosco.</td></tr>}@foreach(var item in setup.KioskCredentials){<tr><td class="fw-semibold">@item.EmployeeName</td><td>@item.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy")</td><td><span class="workforce-status @(CredentialCss(item))">@CredentialLabel(item)</span>@if(item.FailedAttempts>0){<div class="workforce-label">@item.FailedAttempts intento(s) fallido(s)</div>}</td><td class="workforce-actions">@if(item.IsActive){<button class="btn btn-sm btn-outline-danger" disabled="@busy" @onclick="()=>RevokeCredentialAsync(item)">Revocar</button>}</td></tr>}</tbody></table></div></section>
    </div>
  }
  else if(tab=="privacy")
  {
    <div class="workforce-grid">
      <section class="workforce-card workforce-span-5"><div class="workforce-card__header"><h2>@(privacy.Id.HasValue?"Editar aviso":"Aviso de privacidad")</h2>@if(privacy.Id.HasValue){<button class="btn btn-sm btn-outline-secondary" disabled="@busy" @onclick="CancelPrivacyEdit">Cancelar</button>}</div><div class="workforce-card__body"><div class="workforce-form"><Field Label="Versión"><input class="form-control" maxlength="30" @bind="privacy.Version" /></Field><Field Label="Vigente desde"><input type="date" class="form-control" @bind="privacy.EffectiveFrom" /></Field><div class="span-2"><label class="form-label">Título</label><input class="form-control" maxlength="200" @bind="privacy.Title" /></div><div class="span-2"><label class="form-label">Texto aprobado</label><textarea class="form-control" rows="9" maxlength="8000" @bind="privacy.NoticeText"></textarea></div><div class="span-2 form-check"><input id="privacy-active" type="checkbox" class="form-check-input" @bind="privacy.IsActive" /><label for="privacy-active" class="form-check-label">Activar esta versión al guardar</label></div><div class="span-2"><p class="workforce-label">La activación deshabilita cualquier versión anterior. Publica únicamente el texto aprobado por Capital Humano y privacidad.</p><button class="btn btn-primary" disabled="@busy" @onclick="SavePrivacyAsync">@(busy?"Guardando…":privacy.Id.HasValue?"Actualizar aviso":"Guardar aviso")</button></div></div></div></section>
      <section class="workforce-card workforce-span-7"><div class="workforce-card__header"><h2>Versiones</h2><span class="workforce-status @(setup.PrivacyNotices.Any(x=>x.IsActive)?"":"workforce-status--warn")">@(setup.PrivacyNotices.Any(x=>x.IsActive)?"Aviso activo":"Sin aviso activo")</span></div><div class="table-responsive"><table class="table workforce-table"><thead><tr><th>Versión</th><th>Título</th><th>Vigencia</th><th>Estado</th><th></th></tr></thead><tbody>@if(setup.PrivacyNotices.Count==0){<tr><td colspan="5" class="workforce-empty">Aún no hay versiones. El registro de asistencia sigue disponible en desarrollo, pero producción debe permanecer desactivada hasta publicar el aviso aprobado.</td></tr>}@foreach(var item in setup.PrivacyNotices){<tr><td class="fw-semibold">@item.Version</td><td>@item.Title</td><td>@item.EffectiveFrom.ToString("dd MMM yyyy")</td><td><span class="workforce-status @(item.IsActive?"":"workforce-status--muted")">@(item.IsActive?"Activo":"Borrador")</span></td><td class="workforce-actions"><button class="btn btn-sm btn-outline-secondary" disabled="@busy" @onclick="()=>EditPrivacy(item)">Editar</button>@if(!item.IsActive){<button class="btn btn-sm btn-outline-primary" disabled="@busy" @onclick="()=>ActivatePrivacyAsync(item)">Activar</button>}</td></tr>}</tbody></table></div></section>
    </div>
  }
</div>

@code {
  private readonly (string Value,string Label)[] tabs=[("readiness","Preparación"),("sites","Sitios"),("schedules","Horarios"),("assignments","Asignaciones"),("supervisors","Supervisores"),("policies","Políticas y pago"),("holidays","Festivos"),("kiosks","Kioscos"),("privacy","Privacidad")];
  private WorkforceSetupSnapshotDto? setup; private string tab="readiness"; private bool busy; private string? message; private bool messageIsError;
  private WorkSiteSaveRequest site=new(){TimeZoneId="America/Mexico_City",RadiusMeters=150,MaxAccuracyMeters=100};
  private ScheduleTemplateSaveRequest schedule=new(); private TimeOnly scheduleBreakStart=new(14,0); private int scheduleBreak=60; private bool scheduleBreakPaid; private bool scheduleHasBreak=true;
  private List<DayEditor> scheduleDays=DayEditor.CreateDefault();
  private KioskDeviceSaveRequest kioskDevice=new();
  private EmployeeWorkAssignmentSaveRequest assignment=new(); private SupervisorAssignmentSaveRequest supervisor=new(); private PayGroupSaveRequest payGroup=new(); private HolidaySaveRequest holiday=new(); private KioskPairingCreateRequest pairing=new(); private KioskCredentialCreateRequest credential=new(); private PrivacyNoticeSaveRequest privacy=new(); private KioskPairingCodeDto? pairingResult; private KioskCredentialResult? credentialResult;
  private AttendancePolicySaveRequest policy=NewPolicy(); private decimal policyOrdinaryHours=48m; private decimal policyDoubleHours=9m; private decimal policyTripleHours=4m;
  private int PendingPolicies => setup?.Policies.Count(x=>x.RequiresReview) ?? 0;
  private string Rfc => RfcState.RequireRfc();
  protected override async Task OnInitializedAsync()=>await LoadAsync();
  private void SelectTab(string value){tab=value;message=null;}
  private async Task LoadAsync(){busy=true;try{setup=await ConfigurationService.GetSetupAsync(Rfc);SeedRfc();}catch(Exception ex){Show(ex.Message,true);}finally{busy=false;}}
  private void SeedRfc(){site.Rfc=Rfc;schedule.Rfc=Rfc;assignment.Rfc=Rfc;supervisor.Rfc=Rfc;payGroup.Rfc=Rfc;holiday.Rfc=Rfc;pairing.Rfc=Rfc;credential.Rfc=Rfc;privacy.Rfc=Rfc;policy.Rfc=Rfc;kioskDevice.Rfc=Rfc;}
  private async Task SaveSiteAsync()=>await RunAsync(()=>ConfigurationService.SaveSiteAsync(site),ResetSite);
  private void EditSite(WorkSiteDto item){site=ToRequest(item);message=null;}
  private void CancelSiteEdit()=>ResetSite();
  private void ResetSite()=>site=new(){Rfc=Rfc,TimeZoneId="America/Mexico_City",RadiusMeters=150,MaxAccuracyMeters=100};
  private async Task ToggleSiteAsync(WorkSiteDto item){var request=ToRequest(item);request.IsActive=!item.IsActive;await RunAsync(()=>ConfigurationService.SaveSiteAsync(request));}
  private async Task DeleteSiteAsync(WorkSiteDto item)
  {
    if(!await Js.InvokeAsync<bool>("confirm",$"¿Eliminar el sitio \"{item.Name}\"? Esta acción no se puede deshacer.")) return;
    await RunAsync(()=>ConfigurationService.DeleteSiteAsync(item.Id,Rfc),()=>{if(site.Id==item.Id) ResetSite();});
  }
  private WorkSiteSaveRequest ToRequest(WorkSiteDto item)=>new(){Id=item.Id,Rfc=Rfc,Code=item.Code,Name=item.Name,TimeZoneId=item.TimeZoneId,Latitude=item.Latitude,Longitude=item.Longitude,RadiusMeters=item.RadiusMeters,MaxAccuracyMeters=item.MaxAccuracyMeters,IsActive=item.IsActive};
  private async Task SaveScheduleAsync()
  {
    if(!scheduleDays.Any(x=>x.IsWorkingDay)){Show("La plantilla necesita al menos un día laborable.",true);return;}
    var unpaid=scheduleHasBreak&&!scheduleBreakPaid?scheduleBreak:0;
    schedule.Rfc=Rfc;
    schedule.Days=scheduleDays.Select(day=>new ScheduleDayDto{DayOfWeek=day.DayOfWeek,IsWorkingDay=day.IsWorkingDay,StartTime=day.IsWorkingDay?day.StartTime.ToTimeSpan():null,EndTime=day.IsWorkingDay?day.EndTime.ToTimeSpan():null,UnpaidBreakMinutes=day.IsWorkingDay?unpaid:0}).ToList();
    schedule.Breaks=scheduleHasBreak&&scheduleBreak>0?[new ScheduleBreakDto{Name="Descanso",StartTime=scheduleBreakStart.ToTimeSpan(),DurationMinutes=scheduleBreak,IsPaid=scheduleBreakPaid,IsRequired=true}]:[];
    await RunAsync(()=>ConfigurationService.SaveScheduleAsync(schedule),ResetSchedule);
  }
  private void EditSchedule(ScheduleTemplateDto item)
  {
    schedule=new(){Id=item.Id,Rfc=Rfc,Code=item.Code,Name=item.Name,IsActive=item.IsActive};
    scheduleDays=DayEditor.From(item.Days);
    var first=item.Breaks.FirstOrDefault();
    scheduleHasBreak=first is not null;
    scheduleBreak=first?.DurationMinutes??60;
    scheduleBreakPaid=first?.IsPaid??false;
    scheduleBreakStart=first?.StartTime is null?new(14,0):TimeOnly.FromTimeSpan(first.StartTime.Value);
    message=null;
  }
  private void CancelScheduleEdit()=>ResetSchedule();
  private void ResetSchedule(){schedule=new(){Rfc=Rfc};scheduleDays=DayEditor.CreateDefault();scheduleHasBreak=true;scheduleBreak=60;scheduleBreakPaid=false;scheduleBreakStart=new(14,0);}
  private async Task ToggleScheduleAsync(ScheduleTemplateDto item)
  {
    var request=new ScheduleTemplateSaveRequest{Id=item.Id,Rfc=Rfc,Code=item.Code,Name=item.Name,IsActive=!item.IsActive,Days=item.Days.Select(d=>new ScheduleDayDto{DayOfWeek=d.DayOfWeek,IsWorkingDay=d.IsWorkingDay,StartTime=d.StartTime,EndTime=d.EndTime,UnpaidBreakMinutes=d.UnpaidBreakMinutes}).ToList(),Breaks=item.Breaks.Select(b=>new ScheduleBreakDto{Name=b.Name,StartTime=b.StartTime,DurationMinutes=b.DurationMinutes,IsPaid=b.IsPaid,IsRequired=b.IsRequired}).ToList()};
    await RunAsync(()=>ConfigurationService.SaveScheduleAsync(request));
  }
  private async Task DeleteScheduleAsync(ScheduleTemplateDto item)
  {
    if(!await Js.InvokeAsync<bool>("confirm",$"¿Eliminar la plantilla \"{item.Name}\"? Esta acción no se puede deshacer.")) return;
    await RunAsync(()=>ConfigurationService.DeleteScheduleAsync(item.Id,Rfc),()=>{if(schedule.Id==item.Id) ResetSchedule();});
  }
  private static string DayName(int dayOfWeek)=>dayOfWeek switch{0=>"Domingo",1=>"Lunes",2=>"Martes",3=>"Miércoles",4=>"Jueves",5=>"Viernes",_=>"Sábado"};
  private static string DayInitials(ScheduleTemplateDto item)
  {
    var order=new[]{1,2,3,4,5,6,0};
    var letters=new[]{"D","L","M","X","J","V","S"};
    var working=item.Days.Where(x=>x.IsWorkingDay).Select(x=>x.DayOfWeek).ToHashSet();
    return string.Join(" ",order.Where(working.Contains).Select(day=>letters[day]));
  }
  private static string FormatScheduleSpan(ScheduleTemplateDto item)
  {
    var working=item.Days.Where(x=>x.IsWorkingDay&&x.StartTime.HasValue&&x.EndTime.HasValue).ToList();
    if(working.Count==0) return "Sin jornada";
    var spans=working.Select(x=>$"{FormatTime(x.StartTime)}–{FormatTime(x.EndTime)}").Distinct().ToList();
    return spans.Count==1?spans[0]:"Variable";
  }
  private async Task SaveAssignmentAsync()=>await RunAsync(()=>ConfigurationService.SaveWorkAssignmentAsync(assignment),ResetAssignment);
  private void EditAssignment(EmployeeWorkAssignmentDto item){assignment=new(){Id=item.Id,Rfc=Rfc,EmployeeId=item.EmployeeId,SiteId=item.SiteId,ScheduleTemplateId=item.ScheduleTemplateId,AttendancePolicyId=item.AttendancePolicyId,PayGroupId=item.PayGroupId,EffectiveFrom=item.EffectiveFrom,EffectiveTo=item.EffectiveTo};message=null;}
  private void CancelAssignmentEdit()=>ResetAssignment();
  private void ResetAssignment()=>assignment=new(){Rfc=Rfc};
  private async Task CloseAssignmentAsync(EmployeeWorkAssignmentDto item)
  {
    var today=DateOnly.FromDateTime(DateTime.Today);
    if(today<item.EffectiveFrom){Show("La asignación aún no inicia; edítala para ajustar su vigencia.",true);return;}
    var request=new EmployeeWorkAssignmentSaveRequest{Id=item.Id,Rfc=Rfc,EmployeeId=item.EmployeeId,SiteId=item.SiteId,ScheduleTemplateId=item.ScheduleTemplateId,AttendancePolicyId=item.AttendancePolicyId,PayGroupId=item.PayGroupId,EffectiveFrom=item.EffectiveFrom,EffectiveTo=today};
    await RunAsync(()=>ConfigurationService.SaveWorkAssignmentAsync(request));
  }
  private async Task DeleteAssignmentAsync(EmployeeWorkAssignmentDto item)
  {
    if(!await Js.InvokeAsync<bool>("confirm",$"¿Eliminar la asignación de {item.EmployeeName}? Esta acción no se puede deshacer.")) return;
    await RunAsync(()=>ConfigurationService.DeleteWorkAssignmentAsync(item.Id,Rfc),()=>{if(assignment.Id==item.Id) ResetAssignment();});
  }
  private async Task SaveSupervisorAsync()=>await RunAsync(()=>ConfigurationService.SaveSupervisorAssignmentAsync(supervisor),ResetSupervisor);
  private void EditSupervisor(SupervisorAssignmentDto item){supervisor=new(){Id=item.Id,Rfc=Rfc,EmployeeId=item.EmployeeId,SupervisorEmployeeId=item.SupervisorEmployeeId,EffectiveFrom=item.EffectiveFrom,EffectiveTo=item.EffectiveTo};message=null;}
  private void CancelSupervisorEdit()=>ResetSupervisor();
  private void ResetSupervisor()=>supervisor=new(){Rfc=Rfc};
  private async Task CloseSupervisorAsync(SupervisorAssignmentDto item)
  {
    var today=DateOnly.FromDateTime(DateTime.Today);
    if(today<item.EffectiveFrom){Show("La supervisión aún no inicia; edítala para ajustar su vigencia.",true);return;}
    var request=new SupervisorAssignmentSaveRequest{Id=item.Id,Rfc=Rfc,EmployeeId=item.EmployeeId,SupervisorEmployeeId=item.SupervisorEmployeeId,EffectiveFrom=item.EffectiveFrom,EffectiveTo=today};
    await RunAsync(()=>ConfigurationService.SaveSupervisorAssignmentAsync(request));
  }
  private async Task DeleteSupervisorAsync(SupervisorAssignmentDto item)
  {
    if(!await Js.InvokeAsync<bool>("confirm",$"¿Eliminar la supervisión de {item.SupervisorName} sobre {item.EmployeeName}?")) return;
    await RunAsync(()=>ConfigurationService.DeleteSupervisorAssignmentAsync(item.Id,Rfc),()=>{if(supervisor.Id==item.Id) ResetSupervisor();});
  }
  private static bool IsCurrent(EmployeeWorkAssignmentDto item)=>IsCurrentRange(item.EffectiveFrom,item.EffectiveTo);
  private static bool IsCurrent(SupervisorAssignmentDto item)=>IsCurrentRange(item.EffectiveFrom,item.EffectiveTo);
  private static bool IsCurrentRange(DateOnly from,DateOnly? to){var today=DateOnly.FromDateTime(DateTime.Today);return from<=today&&(to is null||to>=today);}
  private static string FormatRange(DateOnly from,DateOnly? to)=>$"{from:dd MMM yyyy} – {(to is null?"abierta":to.Value.ToString("dd MMM yyyy"))}";
  private static string RangeLabel(DateOnly from,DateOnly? to)=>IsCurrentRange(from,to)?"Vigente":(from>DateOnly.FromDateTime(DateTime.Today)?"Futura":"Terminada");
  private static string RangeCss(DateOnly from,DateOnly? to)=>IsCurrentRange(from,to)?"":"workforce-status--muted";
  private async Task SavePayGroupAsync()=>await RunAsync(()=>ConfigurationService.SavePayGroupAsync(payGroup),ResetPayGroup);
  private void EditPayGroup(PayGroupDto item){payGroup=ToRequest(item);message=null;}
  private void CancelPayGroupEdit()=>ResetPayGroup();
  private void ResetPayGroup()=>payGroup=new(){Rfc=Rfc};
  private async Task TogglePayGroupAsync(PayGroupDto item){var request=ToRequest(item);request.IsActive=!item.IsActive;await RunAsync(()=>ConfigurationService.SavePayGroupAsync(request));}
  private async Task DeletePayGroupAsync(PayGroupDto item)
  {
    if(!await Js.InvokeAsync<bool>("confirm",$"¿Eliminar el grupo de pago \"{item.Name}\"? Esta acción no se puede deshacer.")) return;
    await RunAsync(()=>ConfigurationService.DeletePayGroupAsync(item.Id,Rfc),()=>{if(payGroup.Id==item.Id) ResetPayGroup();});
  }
  private PayGroupSaveRequest ToRequest(PayGroupDto item)=>new(){Id=item.Id,Rfc=Rfc,Code=item.Code,Name=item.Name,Frequency=item.Frequency,IsActive=item.IsActive};
  private async Task SaveHolidayAsync()=>await RunAsync(()=>ConfigurationService.SaveHolidayAsync(holiday),ResetHoliday);
  private void EditHoliday(HolidayDto item){holiday=new(){Id=item.Id,Rfc=Rfc,SiteId=item.SiteId,HolidayDate=item.HolidayDate,Name=item.Name,IsPaid=item.IsPaid};message=null;}
  private void CancelHolidayEdit()=>ResetHoliday();
  private void ResetHoliday()=>holiday=new(){Rfc=Rfc};
  private async Task DeleteHolidayAsync(HolidayDto item)
  {
    if(!await Js.InvokeAsync<bool>("confirm",$"¿Eliminar el día festivo \"{item.Name}\"?")) return;
    await RunAsync(()=>ConfigurationService.DeleteHolidayAsync(item.Id,Rfc),()=>{if(holiday.Id==item.Id) ResetHoliday();});
  }
  private async Task SavePrivacyAsync()=>await RunAsync(()=>ConfigurationService.SavePrivacyNoticeAsync(privacy),ResetPrivacy);
  private void EditPrivacy(PrivacyNoticeDto item){privacy=new(){Id=item.Id,Rfc=Rfc,Version=item.Version,Title=item.Title,NoticeText=item.NoticeText,EffectiveFrom=item.EffectiveFrom,IsActive=item.IsActive};message=null;}
  private void CancelPrivacyEdit()=>ResetPrivacy();
  private void ResetPrivacy()=>privacy=new(){Rfc=Rfc};
  private async Task ActivatePrivacyAsync(PrivacyNoticeDto item)
  {
    if(!await Js.InvokeAsync<bool>("confirm",$"¿Activar la versión {item.Version}? Se desactivará cualquier aviso vigente.")) return;
    var request=new PrivacyNoticeSaveRequest{Id=item.Id,Rfc=Rfc,Version=item.Version,Title=item.Title,NoticeText=item.NoticeText,EffectiveFrom=item.EffectiveFrom,IsActive=true};
    await RunAsync(()=>ConfigurationService.SavePrivacyNoticeAsync(request));
  }
  private async Task SavePolicyAsync()
  {
    policy.Rfc=Rfc;
    policy.WeeklyOrdinaryMinutes=ToMinutes(policyOrdinaryHours);
    policy.WeeklyDoubleOvertimeMinutes=ToMinutes(policyDoubleHours);
    policy.WeeklyTripleOvertimeMinutes=ToMinutes(policyTripleHours);
    await RunAsync(()=>ConfigurationService.SavePolicyAsync(policy),ResetPolicy);
  }
  private async Task ApprovePolicyAsync(AttendancePolicyDto item)=>await RunAsync(()=>ConfigurationService.ApprovePolicyAsync(item.Id,Rfc));
  private async Task TogglePolicyAsync(AttendancePolicyDto item){var request=ToRequest(item);request.IsActive=!item.IsActive;await RunAsync(()=>ConfigurationService.SavePolicyAsync(request));}
  private void EditPolicy(AttendancePolicyDto item)
  {
    policy=ToRequest(item);
