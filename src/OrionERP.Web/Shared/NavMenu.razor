@using System.Linq
@implements IDisposable
@inject NavigationManager Navigation

@{
    var visibleSections = VisibleSections;
    var quickAccessItems = HasSearch ? Array.Empty<NavEntryDefinition>() : GetQuickAccessItems(visibleSections);
    var visibleItemCount = visibleSections.Sum(section => section.Items.Count);
}

<div class="navmenu-topbar navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand brand-logo" href="/">
            <img src="/Images/OrionERP_Logo.svg" alt="OrionERP logo">
            <span class="brand-logo__tag">Centro de operacion</span>
        </a>

        <button title="Navigation menu"
                class="navbar-toggler"
                type="button"
                aria-label="Toggle navigation"
                aria-controls="primary-nav"
                aria-expanded="@(!collapseNavMenu)"
                @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

@if (!collapseNavMenu)
{
    <button type="button" class="navmenu-backdrop" aria-label="Cerrar navegacion" @onclick="CloseNavMenu"></button>
}

<div id="primary-nav" class="@NavMenuCssClass navmenu-body">
    <nav class="nav-shell" aria-label="Primary">
        <section class="nav-search" aria-label="Buscar navegacion">
            <div class="nav-panel__heading">
                <div>
                    <div class="nav-panel__eyebrow">Buscar</div>
                    <h3>Encuentra una pagina rapido</h3>
                </div>

                <span class="nav-panel__meta">@visibleItemCount</span>
            </div>

            <label class="nav-search__label" for="nav-search-input">Buscar</label>

            <div class="nav-search__control">
                <span class="oi oi-magnifying-glass" aria-hidden="true"></span>
                <input id="nav-search-input"
                       type="search"
                       @bind="searchText"
                       @bind:event="oninput"
                       placeholder="Modulo, pagina o tarea"
                       autocomplete="off" />

                @if (HasSearch)
                {
                    <button type="button" class="nav-search__clear" @onclick="ClearSearch">Limpiar</button>
                }
            </div>

            @if (HasSearch)
            {
                <p class="nav-search__summary">@visibleItemCount resultado@(visibleItemCount == 1 ? string.Empty : "s")</p>
            }
        </section>

        @if (quickAccessItems.Length > 0)
        {
            <section class="nav-panel nav-quick" aria-label="Accesos rapidos">
                <div class="nav-panel__heading">
                    <div>
                        <div class="nav-panel__eyebrow">Accesos rapidos</div>
                        <h3>Lo mas usado</h3>
                    </div>

                    <span class="nav-panel__meta">ERP flow</span>
                </div>

                <div class="nav-quick__grid">
                    @foreach (var item in quickAccessItems)
                    {
                        <NavLink class="nav-quick__item"
                                 href="@item.Href"
                                 Match="@item.Match"
                                 title="@item.Title"
                                 @onclick="CloseNavMenuAfterSelection">
                            <span class="nav-quick__icon">
                                <span class="oi @item.Icon" aria-hidden="true"></span>
                            </span>

                            <span class="nav-quick__body">
                                <span class="nav-quick__label">@item.Label</span>
                                <span class="nav-quick__description">@item.Description</span>
                            </span>
                        </NavLink>
                    }
                </div>
            </section>
        }

        @if (visibleSections.Count == 0)
        {
            <section class="nav-empty" aria-live="polite">
                <span class="oi oi-magnifying-glass nav-empty__icon" aria-hidden="true"></span>
                <h3>Sin coincidencias</h3>
                <p>Prueba con SAT, polizas, bancos, reservaciones o seguridad.</p>
                <button type="button" class="btn btn-link btn-sm nav-empty__action" @onclick="ClearSearch">Limpiar busqueda</button>
            </section>
        }
        else
        {
            @for (var index = 0; index < visibleSections.Count; index++)
            {
                var module = visibleSections[index];

                <section class="@GetSectionCssClass(module)" style="--cluster-index:@index;">
                    <header class="nav-cluster__header">
                        <div class="nav-cluster__icon">
                            <span class="oi @module.Definition.Icon" aria-hidden="true"></span>
                        </div>

                        <div class="nav-cluster__copy">
                            <div class="nav-cluster__eyebrow">@module.Definition.Kicker</div>
                            <h3>@module.Definition.Title</h3>
                            <p>@module.Definition.Description</p>
                        </div>

                        <span class="nav-cluster__count">@module.Items.Count</span>
                    </header>

                    <ul class="nav-cluster__list">
                        @foreach (var item in module.Items)
                        {
                            <li class="nav-item">
                                <NavLink class="nav-link nav-link--rich"
                                         href="@item.Href"
                                         Match="@item.Match"
                                         title="@item.Title"
                                         @onclick="CloseNavMenuAfterSelection">
                                    <span class="nav-link__icon">
                                        <span class="oi @item.Icon" aria-hidden="true"></span>
                                    </span>

                                    <span class="nav-link__content">
                                        <span class="label">@item.Label</span>
                                        <span class="description">@item.Description</span>
                                    </span>

                                    @if (!string.IsNullOrWhiteSpace(item.Badge))
                                    {
                                        <span class="nav-link__badge">@item.Badge</span>
                                    }
                                </NavLink>
                            </li>
                        }
                    </ul>
                </section>
            }
        }

        <AuthorizeView Roles="Administrador">
            <section class="nav-cluster nav-cluster--admin">
                <header class="nav-cluster__header">
                    <div class="nav-cluster__icon">
                        <span class="oi oi-lock-locked" aria-hidden="true"></span>
                    </div>

                    <div class="nav-cluster__copy">
                        <div class="nav-cluster__eyebrow">Administracion</div>
                        <h3>Control y seguridad</h3>
                        <p>Gestiona accesos, roles y mantenimiento del portal.</p>
                    </div>
                </header>

                <ul class="nav-cluster__list">
                    <li class="nav-item">
                        <NavLink class="nav-link nav-link--rich"
                                 href="/admin/seguridad"
                                 title="Portal de seguridad"
                                 @onclick="CloseNavMenuAfterSelection">
                            <span class="nav-link__icon">
                                <span class="oi oi-lock-locked" aria-hidden="true"></span>
                            </span>

                            <span class="nav-link__content">
                                <span class="label">Portal de Seguridad</span>
                                <span class="description">Usuarios, permisos y configuracion administrativa.</span>
                            </span>

                            <span class="nav-link__badge">Admin</span>
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link nav-link--rich"
                                 href="/ajustes"
                                 title="Ajustes"
                                 @onclick="CloseNavMenuAfterSelection">
                            <span class="nav-link__icon">
                                <span class="oi oi-cog" aria-hidden="true"></span>
                            </span>

                            <span class="nav-link__content">
                                <span class="label">Ajustes</span>
                                <span class="description">Plantillas contables y configuracion operativa.</span>
                            </span>

                            <span class="nav-link__badge">Setup</span>
                        </NavLink>
                    </li>
                </ul>
            </section>
        </AuthorizeView>
    </nav>
</div>

@code {
    private static readonly IReadOnlyList<NavSectionDefinition> Sections = new List<NavSectionDefinition>
