  private void SaveLineFromModal()
  {
    var validationMessage = ValidateLine(LineEditor);
    if (validationMessage is not null)
    {
      lineEditorError = validationMessage;
      return;
    }

    var existingIndex = Editor.Lines.FindIndex(line => line.ClientId == LineEditor.ClientId);
    if (existingIndex >= 0)
    {
      Editor.Lines[existingIndex] = LineEditor.Clone();
    }
    else
    {
      Editor.Lines.Add(LineEditor.Clone());
    }

    RenumberLines();
    CloseLineModal();
  }

  private void RemoveLine(PlantillaLineEditorModel line)
  {
    Editor.Lines.RemoveAll(item => item.ClientId == line.ClientId);
    RenumberLines();
  }

  private void MoveLine(PlantillaLineEditorModel line, int direction)
  {
    var ordered = ActiveLines.ToList();
    var currentIndex = ordered.FindIndex(item => item.ClientId == line.ClientId);
    var nextIndex = currentIndex + direction;
    if (currentIndex < 0 || nextIndex < 0 || nextIndex >= ordered.Count)
    {
      return;
    }

    (ordered[currentIndex], ordered[nextIndex]) = (ordered[nextIndex], ordered[currentIndex]);
    for (var index = 0; index < ordered.Count; index++)
    {
      ordered[index].Orden = index + 1;
    }

    Editor.Lines = ordered;
  }

  private void RenumberLines()
  {
    var ordered = ActiveLines.ToList();
    for (var index = 0; index < ordered.Count; index++)
    {
      ordered[index].Orden = index + 1;
    }

    Editor.Lines = ordered;
  }

  private string? ValidateExtraEditor()
  {
    if (string.IsNullOrWhiteSpace(ExtraEditor.Name))
    {
      return "Captura el nombre del extra.";
    }

    if (ExtraEditor.Price < 0m)
    {
      return "El precio del extra no puede ser negativo.";
    }

    return null;
  }

  private string? ValidateEditor()
  {
    if (string.IsNullOrWhiteSpace(Editor.Nombre))
    {
      return "Captura el nombre de la plantilla.";
    }

    if (ActiveLines.Count == 0)
    {
      return "Agrega al menos una linea a la plantilla.";
    }

    if (!ActiveLines.Any(line => line.Naturaleza == "DEBE") || !ActiveLines.Any(line => line.Naturaleza == "HABER"))
    {
      return "La plantilla necesita al menos una linea de Debe y una de Haber.";
    }

    foreach (var line in ActiveLines)
    {
      var validation = ValidateLine(line);
      if (validation is not null)
      {
        return validation;
      }
    }

    return null;
  }

  private static string? ValidateLine(PlantillaLineEditorModel line)
  {
    if (!line.CuentaContableId.HasValue)
    {
      return "Selecciona una cuenta contable para la linea.";
    }

    if (line.Factor <= 0)
    {
      return "El factor debe ser mayor a cero.";
    }

    if (line.ConceptoTipo == "FIJO" && string.IsNullOrWhiteSpace(line.ConceptoFijo))
    {
      return "Captura el concepto fijo.";
    }

    return null;
  }

  private async Task<bool> ConfirmAsync(string message)
  {
    try
    {
      return await JsRuntime.InvokeAsync<bool>("confirm", message);
    }
    catch
    {
      return true;
    }
  }

  private static string FormatCuentaCodigo(PlantillaLineEditorModel line)
  {
    var parts = new[] { line.Nivel1, line.Nivel2, line.Nivel3 }
        .Where(value => !string.IsNullOrWhiteSpace(value));

    var code = string.Join('.', parts);
    return string.IsNullOrWhiteSpace(code)
        ? $"Cuenta {line.CuentaContableId?.ToString(CultureInfo.InvariantCulture) ?? "-"}"
        : code;
  }

  private static string FormatCuentaCodigo(CuentaContableSelection selection)
  {
    var parts = new[] { selection.Nivel1, selection.Nivel2, selection.Nivel3 }
        .Where(value => !string.IsNullOrWhiteSpace(value));

    var code = string.Join('.', parts);
    return string.IsNullOrWhiteSpace(code)
        ? $"Cuenta {selection.Id?.ToString(CultureInfo.InvariantCulture) ?? "-"}"
        : code;
  }

