@page "/contacto"
@inject PublicWebsitePresentationDefinition Presentation

<PageTitle>Contacto | @Presentation.PublicName</PageTitle>
<HeadContent>
    <meta name="description" content="@($"Contacta a {Presentation.PublicName} en {Presentation.LocationName} por WhatsApp, correo o direccion para resolver dudas antes de reservar.")" />
</HeadContent>

<main class="bonhomia-page">
    <section class="bonhomia-page__title">
        <p class="bonhomia-eyebrow">Contacto</p>
        <h1>Te esperamos en @Presentation.LocationName</h1>
        <p>Comparte fechas, numero de huespedes y motivo de viaje para orientarte antes de reservar.</p>
    </section>

    <section class="bonhomia-section bonhomia-section--last">
        <div class="bonhomia-document__grid">
            <div class="bonhomia-document-card">
                <h2>Datos de contacto</h2>
                <dl>
                    <div><dt>Direccion</dt><dd>@Presentation.OperatingAddress</dd></div>
                    <div><dt>WhatsApp</dt><dd>@Presentation.WhatsAppDisplay</dd></div>
                    <div><dt>Correo</dt><dd>@Presentation.PublicEmail</dd></div>
                </dl>
                <div class="bonhomia-actions">
                    <a class="bonhomia-button bonhomia-button--primary" href='@Presentation.WhatsAppUrl($"Hola {Presentation.PublicName}, quiero informacion para una estancia.")' target="_blank" rel="noopener noreferrer">
                        <i class="bi bi-whatsapp" aria-hidden="true"></i>
                        <span>WhatsApp</span>
                    </a>
                    <a class="bonhomia-button bonhomia-button--outline" href="mailto:@Presentation.PublicEmail">
                        <i class="bi bi-envelope" aria-hidden="true"></i>
                        <span>Correo</span>
                    </a>
                </div>
            </div>

            <div class="bonhomia-document-card">
                <h2>Cuando escribir</h2>
                <ul>
                    <li>Si viajas por trabajo y necesitas confirmar condiciones de llegada.</li>
                    <li>Si planeas una estancia familiar y quieres elegir la capacidad correcta.</li>
                    <li>Si participas en una conferencia o agenda publica con horarios definidos.</li>
                    <li>Si requieres factura, mascota, transporte, alimentos o lavanderia.</li>
                    <li>Si tienes dudas antes de completar el pago en linea.</li>
                </ul>
                <p>Para reservar por tu cuenta, usa la pagina de reserva directa con disponibilidad, cotizacion y pago seguro.</p>
                <a class="bonhomia-button bonhomia-button--dark" href="/reservar">Ir a reservar</a>
            </div>
        </div>
    </section>
</main>
