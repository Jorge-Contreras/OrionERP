@using OrionERP.Web.State
@using OrionERP.Web.Shared   @* For typeof(MainLayout) *@

<CompanyContextInitializer>
    <CascadingAuthenticationState>
        <Router AppAssembly="@typeof(Program).Assembly">
            <Found Context="routeData">
                <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                    <NotAuthorized>
                        @* NotAuthorized covers two different situations. The inner
                           AuthorizeView declares no roles, so it only tests whether
                           anyone is signed in: a signed-in visitor who simply lacks
                           the page's role must be told so, not sent to the login
                           page, which would bounce them straight back and loop. *@
                        @* Context is named explicitly: without it the inner child
                           content collides with the enclosing NotAuthorized's own
                           implicit 'context' parameter and Razor refuses to build. *@
                        <AuthorizeView Context="signedInState">
                            <Authorized>
                                <AccessDenied />
                            </Authorized>
                            <NotAuthorized>
                                <RedirectToLogin />
                            </NotAuthorized>
                        </AuthorizeView>
                    </NotAuthorized>
                </AuthorizeRouteView>

                <FocusOnNavigate RouteData="@routeData" Selector="h1" />
            </Found>

            <NotFound>
                <LayoutView Layout="@typeof(MainLayout)">
                    <p>Página no encontrada.</p>
                </LayoutView>
            </NotFound>
        </Router>
    </CascadingAuthenticationState>
</CompanyContextInitializer>
