@using System.Security.Claims
@using System.Threading
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using OrionERP.Web.State
@implements IDisposable

@* This component has no UI; it initializes and persists the RFC state. *@
@ChildContent

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; } = default!;
    [Inject] private IUserRfcState RfcState { get; set; } = default!;
    [Inject] private ProtectedLocalStorage Storage { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private bool _initialized;
    private readonly SemaphoreSlim _initLock = new(1, 1);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            AuthStateProvider.AuthenticationStateChanged += OnAuthStateChanged;
            Navigation.LocationChanged += OnLocationChanged;
        }

        if (firstRender || !_initialized || !RfcState.AllowedRfcs.Any())
        {
            await EnsureInitializedAsync();
        }
    }

    private async Task EnsureInitializedAsync(bool force = false, AuthenticationState? state = null)
    {
        await _initLock.WaitAsync();
        try
        {
            if (!force && _initialized && RfcState.AllowedRfcs.Any())
            {
                return;
            }

            state ??= await AuthStateProvider.GetAuthenticationStateAsync();
            await InitializeCoreAsync(state);
            _initialized = true;
        }
        finally
        {
            _initLock.Release();
        }
    }

    private async Task InitializeCoreAsync(AuthenticationState authState)
    {
        var user = authState.User;

        if (user.Identity?.IsAuthenticated != true)
        {
            RfcState.InitializeFromClaims(new ClaimsPrincipal());
            RfcState.Changed -= OnRfcChangedPersist;
            RfcState.Changed += OnRfcChangedPersist;
            await PersistCurrentAsync();
            await InvokeAsync(StateHasChanged);
            return;
        }

        RfcState.InitializeFromClaims(user);

        var saved = await Storage.GetAsync<string>("current_rfc");
        if (saved.Success && !string.IsNullOrWhiteSpace(saved.Value))
        {
            if (!RfcState.TrySet(saved.Value))
            {
                RfcState.ResetToDefault();
            }
        }
        else
        {
            RfcState.ResetToDefault();
        }

        RfcState.Changed -= OnRfcChangedPersist;
        RfcState.Changed += OnRfcChangedPersist;

        await PersistCurrentAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async void OnAuthStateChanged(Task<AuthenticationState> task)
    {
        try
        {
            var state = await task;
            await EnsureInitializedAsync(force: true, state);
        }
        catch { /* no-op */ }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = EnsureInitializedAsync();
    }

    private async void OnRfcChangedPersist()
    {
        try { await PersistCurrentAsync(); } catch { /* no-op */ }
    }

    private async Task PersistCurrentAsync()
    {
        await Storage.SetAsync("current_rfc", RfcState.CurrentRfc ?? string.Empty);
    }

    public void Dispose()
    {
        AuthStateProvider.AuthenticationStateChanged -= OnAuthStateChanged;
        RfcState.Changed -= OnRfcChangedPersist;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
