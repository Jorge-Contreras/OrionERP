@page "/ReportesFinancieros/HojaTrabajo"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Administrador")]

<PageTitle>Hoja de Trabajo IVA / ISR</PageTitle>

<div class="report-page hoja-trabajo-page">
    <div class="report-page__header">
        <h1 class="report-page__title">Hoja de Trabajo IVA / ISR</h1>
    </div>

    <section aria-labelledby="filtros-heading" class="card report-panel report-panel--filters">
        <div class="card-body">
            <div class="report-panel__header">
                <div>
                    <h2 id="filtros-heading" class="report-panel__title">Filtros</h2>
                    <p class="report-panel__subtitle">Selecciona el año de trabajo y confirma el RFC activo antes de exportar.</p>
                </div>
            </div>

            <div class="d-flex flex-row flex-wrap gap-3 report-filter-row">
                <div class="report-filter-field">
                    <label class="form-label" for="anio-selector">Año</label>
                    <select id="anio-selector" class="form-select report-filter-select--year" @bind="Anio">
                        @for (var year = 2040; year >= 1990; year--)
                        {
                            <option value="@year">@year</option>
                        }
                    </select>
                </div>

                <div class="report-filter-field hoja-trabajo-page__rfc-field">
                    <label class="form-label">RFC actual</label>
                    <input type="text" class="form-control report-field--readonly" value="@CurrentRfc" readOnly />
                </div>
            </div>
        </div>
    </section>

    <section aria-labelledby="hoja-trabajo-heading" class="card report-panel report-panel--results">
        <div class="card-body">
            <div class="report-toolbar">
                <div>
                    <h2 id="hoja-trabajo-heading" class="report-panel__title">Hoja de trabajo IVA / ISR</h2>
                    <p class="report-panel__subtitle">Cada pestaña conserva su propia selección para facilitar la revisión mensual.</p>
                </div>

                <div class="btn-group report-toolbar__actions" role="group" aria-label="Exportar a Excel">
                    <button class="btn btn-outline-primary btn-sm" @onclick='() => ExportToExcel(JS, HojaTrabajoCfdi, "CFDIs")' disabled="@(IsExporting || IsLoading || HojaTrabajoCfdi.Count == 0)">
                        <i class="bi bi-file-excel"></i> Exportar CFDIs
                    </button>
                    <button class="btn btn-outline-primary btn-sm" @onclick='() => ExportToExcel(JS, HojaTrabajoComplementos, "Complementos")' disabled="@(IsExporting || IsLoading || HojaTrabajoComplementos.Count == 0)">
                        <i class="bi bi-file-excel"></i> Exportar Complementos
                    </button>
                    <button class="btn btn-outline-primary btn-sm" @onclick='() => ExportToExcel(JS, HojaTrabajoTipoE, "CFDIs Tipo E")' disabled="@(IsExporting || IsLoading || HojaTrabajoTipoE.Count == 0)">
                        <i class="bi bi-file-excel"></i> Exportar CFDIs Tipo E
                    </button>
                    <button class="btn btn-outline-primary btn-sm" @onclick='() => ExportToExcel(JS, HojaTrabajoTipoN, "CFDIs Tipo N")' disabled="@(IsExporting || IsLoading || HojaTrabajoTipoN.Count == 0)">
                        <i class="bi bi-file-excel"></i> Exportar CFDIs Tipo N
                    </button>
                    <button class="btn btn-outline-primary btn-sm" @onclick='() => ExportToExcel(JS, HojaTrabajoContabilidad, "Contabilidad")' disabled="@(IsExporting || IsLoading || HojaTrabajoContabilidad.Count == 0)">
                        <i class="bi bi-file-excel"></i> Exportar Contabilidad
                    </button>
                    <button class="btn btn-outline-primary btn-sm" @onclick='() => ExportToExcel(JS, HojaTrabajoAcumulados, "ISR_Acumulados")' disabled="@(IsExporting || IsLoading || HojaTrabajoAcumulados.Count == 0)">
                        <i class="bi bi-file-excel"></i> Exportar ISR / Acumulados
                    </button>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="alert alert-danger">
                    <strong>Error al cargar la hoja de trabajo:</strong> @ErrorMessage
                </div>
            }

            @if (IsLoading)
            {
                <div class="text-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                </div>
            }
            else
            {
                <ul class="nav nav-tabs mb-3" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(ActiveTab == HojaTrabajoTab.Cfdi ? "active" : string.Empty)" type="button" role="tab" @onclick="() => SetActiveTab(HojaTrabajoTab.Cfdi)">CFDIs (IVA)</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(ActiveTab == HojaTrabajoTab.Complementos ? "active" : string.Empty)" type="button" role="tab" @onclick="() => SetActiveTab(HojaTrabajoTab.Complementos)">Complementos</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(ActiveTab == HojaTrabajoTab.TipoE ? "active" : string.Empty)" type="button" role="tab" @onclick="() => SetActiveTab(HojaTrabajoTab.TipoE)">CFDIs Tipo E</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(ActiveTab == HojaTrabajoTab.TipoN ? "active" : string.Empty)" type="button" role="tab" @onclick="() => SetActiveTab(HojaTrabajoTab.TipoN)">CFDIs Tipo N</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(ActiveTab == HojaTrabajoTab.Contabilidad ? "active" : string.Empty)" type="button" role="tab" @onclick="() => SetActiveTab(HojaTrabajoTab.Contabilidad)">Contabilidad</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(ActiveTab == HojaTrabajoTab.Acumulados ? "active" : string.Empty)" type="button" role="tab" @onclick="() => SetActiveTab(HojaTrabajoTab.Acumulados)">ISR / Acumulados</button>
                    </li>
                </ul>

                <div class="tab-content">
                    <div class="tab-pane fade @(ActiveTab == HojaTrabajoTab.Cfdi ? "show active" : string.Empty)">
                        @if (HojaTrabajoCfdi.Count == 0)
                        {
                            <p class="text-muted">No hay datos para mostrar.</p>
                        }
                        else
                        {
                            <div class="table-responsive report-table-shell">
                                <table class="table table-sm table-bordered compact-table report-table hoja-trabajo-table">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Descripción</th>
                                            <th>ENERO</th>
                                            <th>FEBRERO</th>
                                            <th>MARZO</th>
                                            <th>ABRIL</th>
                                            <th>MAYO</th>
                                            <th>JUNIO</th>
                                            <th>JULIO</th>
                                            <th>AGOSTO</th>
                                            <th>SEPTIEMBRE</th>
                                            <th>OCTUBRE</th>
                                            <th>NOVIEMBRE</th>
                                            <th>DICIEMBRE</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in HojaTrabajoCfdi)
                                        {
                                            <tr class="report-table__row-clickable @GetRowClass(row, HojaTrabajoCfdi, HojaTrabajoTab.Cfdi)" @onclick="() => SelectRow(row, HojaTrabajoTab.Cfdi)">
                                                <td>@row.Descripcion</td>
                                                @for (var i = 0; i < 12; i++)
                                                {
                                                    <td class="@GetCellClass(row, i)">@GetFormattedValue(row, i)</td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>

