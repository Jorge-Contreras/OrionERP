@page "/contabilidad/transacciones/list"
@attribute [Authorize(Roles = "Administrador,SatOperator")]

<PageTitle>Lista de Transacciones</PageTitle>

<h3>Lista de Transacciones</h3>

<div class="row">
    <div class="col-md-3">
        <div class="form-group">
            <label for="year">Año</label>
            <select id="year" class="form-control" @bind="Filter.Year">
                <option value="">Todos</option>
                @for (var year = 2035; year >= 2000; year--)
                {
                    <option value="@year">@year</option>
                }
            </select>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group">
            <label for="month">Mes</label>
            <select id="month" class="form-control" @bind="Filter.Month">
                <option value="">Todos</option>
                <option value="1">Enero</option>
                <option value="2">Febrero</option>
                <option value="3">Marzo</option>
                <option value="4">Abril</option>
                <option value="5">Mayo</option>
                <option value="6">Junio</option>
                <option value="7">Julio</option>
                <option value="8">Agosto</option>
                <option value="9">Septiembre</option>
                <option value="10">Octubre</option>
                <option value="11">Noviembre</option>
                <option value="12">Diciembre</option>
            </select>
        </div>
    </div>
</div>

<div class="row mt-3">
    <div class="col-md-6">
        <div class="form-group">
            <label for="sortBy">Ordenar por</label>
            <div class="input-group">
                <select id="sortBy" class="form-control" @bind="Filter.SortBy">
                    <option value="">Sin ordenar</option>
                    <option value="Id">ID</option>
                    <option value="Fecha">Fecha</option>
                    <option value="Concepto">Concepto</option>
                    <option value="Monto">Monto</option>
                    <option value="TipoPoliza">Tipo de Póliza</option>
                    <option value="FormaPago">Forma de Pago</option>
                </select>
                <div class="input-group-append">
                    <button class="btn btn-outline-secondary" type="button" @onclick="() => ApplySort(true)" disabled="@IsLoading">Asc</button>
                    <button class="btn btn-outline-secondary" type="button" @onclick="() => ApplySort(false)" disabled="@IsLoading">Desc</button>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 text-right">
        <button class="btn btn-primary" @onclick="Search" disabled="@IsLoading">Buscar</button>
        <button class="btn btn-secondary" @onclick="ClearFilters" disabled="@IsLoading">Limpiar</button>
        <a href="/contabilidad/transacciones/new" class="btn btn-success">Nueva Transacción</a>
    </div>
</div>

@if (IsLoading)
{
    <p><em>Cargando...</em></p>
}
else
{
    <table class="table table-striped mt-4">
        <thead>
            <tr>
                <th>
                    <a href="#" @onclick='() => Sort("Id")'>ID</a>
                    @if (Filter.SortBy == "Id")
                    {
                        <span>@(Filter.SortAsc ? "▲" : "▼")</span>
                    }
                    <input type="number" class="form-control" @bind-value="Filter.Id" @bind-value:event="oninput" @onkeyup="OnFilterKeyDown" />
                </th>
                <th>
                    <a href="#" @onclick='() => Sort("Fecha")'>Fecha</a>
                    @if (Filter.SortBy == "Fecha")
                    {
                        <span>@(Filter.SortAsc ? "▲" : "▼")</span>
                    }
                </th>
                <th>
                    <a href="#" @onclick='() => Sort("Concepto")'>Concepto</a>
                    @if (Filter.SortBy == "Concepto")
                    {
                        <span>@(Filter.SortAsc ? "▲" : "▼")</span>
                    }
                    <InputText class="form-control" @bind-Value="Filter.Concepto" @bind-Value:event="oninput" @onkeyup="OnFilterKeyDown" />
                </th>
                <th>
                    <a href="#" @onclick='() => Sort("Monto")'>Monto</a>
                    @if (Filter.SortBy == "Monto")
                    {
                        <span>@(Filter.SortAsc ? "▲" : "▼")</span>
                    }
                    <input type="number" class="form-control" @bind-value="Filter.Monto" @bind-value:event="oninput" @onkeyup="OnFilterKeyDown" />
                </th>
                <th>
                    <a href="#" @onclick='() => Sort("TipoPoliza")'>Tipo de Póliza</a>
                    @if (Filter.SortBy == "TipoPoliza")
                    {
                        <span>@(Filter.SortAsc ? "▲" : "▼")</span>
                    }
                    <InputText class="form-control" @bind-Value="Filter.TipoPoliza" @bind-Value:event="oninput" @onkeyup="OnFilterKeyDown" />
                </th>
                <th>
                    <a href="#" @onclick='() => Sort("FormaPago")'>Forma de Pago</a>
                    @if (Filter.SortBy == "FormaPago")
                    {
                        <span>@(Filter.SortAsc ? "▲" : "▼")</span>
                    }
                    <InputText class="form-control" @bind-Value="Filter.FormaPago" @bind-Value:event="oninput" @onkeyup="OnFilterKeyDown" />
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var transaccion in Transacciones)
            {
                <tr>
                    <td>@transaccion.Id</td>
                    <td>@transaccion.Fecha.ToShortDateString()</td>
                    <td>@transaccion.Concepto</td>
                    <td>@transaccion.Monto</td>
                    <td>@transaccion.TipoPoliza</td>
                    <td>@transaccion.FormaPago</td>
                    <td>
                        <a href="/contabilidad/transacciones/@transaccion.Id" class="btn btn-sm btn-primary">Ver/Editar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
