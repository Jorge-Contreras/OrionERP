@using OrionERP.Application.Features.Cfdi.ContabilidadRegistros

<div class="row g-3">
  <div class="col-md-4">
    <label class="form-label">Buscar Nivel 1</label>
    <input class="form-control"
           placeholder="Ej. 102 o BANCOS"
           @bind="nivel1Term"
           @bind:event="oninput"
           @onkeydown="OnNivel1KeyDown"
           disabled="@Disabled" />
    @if (nivel1Results.Any())
    {
      <div class="table-responsive mt-2" style="max-height: 320px; overflow-y: auto;">
        <table class="table table-sm table-hover mb-0">
          <thead>
            <tr>
              <th>Id</th>
              <th>RFC</th>
              <th>Nivel1</th>
              <th>Descripción</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var item in nivel1Results)
            {
              <tr role="button" @onclick="() => SelectNivel1Async(item)">
                <td>@item.Id</td>
                <td>@item.RazonSocial</td>
                <td>@item.Nivel1</td>
                <td>@item.Descripcion</td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    }
  </div>
  <div class="col-md-4">
    <label class="form-label">Buscar Nivel 2</label>
    <input class="form-control"
           placeholder="Ej. 01 o descripción"
           @bind="nivel2Term"
           @bind:event="oninput"
           @onkeydown="OnNivel2KeyDown"
           disabled="@(Disabled || !CanSearchNivel2)" />
    @if (nivel2Results.Any())
    {
      <div class="table-responsive mt-2">
        <table class="table table-sm table-hover mb-0">
          <thead>
            <tr>
              <th>Id</th>
              <th>Nivel2</th>
              <th>Descripción</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var item in nivel2Results)
            {
              <tr role="button" @onclick="() => SelectNivel2Async(item)">
                <td>@item.Id</td>
                <td>@item.Nivel2</td>
                <td>@item.Descripcion</td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    }
  </div>
  <div class="col-md-4">
    <label class="form-label">Buscar Nivel 3</label>
    <input class="form-control"
           placeholder="Ej. 02 o descripción"
           @bind="nivel3Term"
           @bind:event="oninput"
           @onkeydown="OnNivel3KeyDown"
           disabled="@(Disabled || !CanSearchNivel3)" />
    @if (nivel3Results.Any())
    {
      <div class="table-responsive mt-2">
        <table class="table table-sm table-hover mb-0">
          <thead>
            <tr>
              <th>Id</th>
              <th>Nivel3</th>
              <th>Descripción</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var item in nivel3Results)
            {
              <tr role="button" @onclick="() => SelectNivel3(item)">
                <td>@item.Id</td>
                <td>@item.Nivel3</td>
                <td>@item.Descripcion</td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    }
  </div>
</div>
