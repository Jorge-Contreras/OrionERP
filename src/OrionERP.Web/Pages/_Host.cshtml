@page "/"
@namespace OrionERP.Web.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    if (User.Identity?.IsAuthenticated != true)
    {
        var returnUrl = $"{Request.PathBase}{Request.Path}{Request.QueryString}";
        if (string.IsNullOrWhiteSpace(returnUrl))
        {
            returnUrl = "/";
        }

        Response.Redirect($"/Identity/Account/Login?returnUrl={Uri.EscapeDataString(returnUrl)}");
        return;
    }

    Layout = "_Layout";
}



<component type="typeof(App)" render-mode="ServerPrerendered" />
<script>
    window.triggerFileDownload = (fileName, dataUrl) => {
        const link = document.createElement('a');
        link.href = dataUrl;
        link.download = fileName;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    };

    const focusAndSelectTextInputCore = (element, scrollIntoViewOnMobile = false) => {
        const isMobileViewport = window.matchMedia("(max-width: 767.98px)").matches;
        const selectValue = () => {
            if (typeof element.select === "function") {
                element.select();
                return;
            }

            if (typeof element.setSelectionRange === "function") {
                const value = typeof element.value === "string" ? element.value : "";
                element.setSelectionRange(0, value.length);
            }
        };

        window.requestAnimationFrame(() => {
            if (scrollIntoViewOnMobile && isMobileViewport && typeof element.scrollIntoView === "function") {
                element.scrollIntoView({
                    behavior: "smooth",
                    block: "center",
                    inline: "nearest"
                });
            }

            if (typeof element.focus === "function") {
                try {
                    element.focus({ preventScroll: true });
                } catch {
                    element.focus();
                }
            }

            window.setTimeout(selectValue, isMobileViewport ? 120 : 0);
        });
    };

    const isVisibleFocusableElement = (element) => {
        if (!element || typeof element.getClientRects !== "function") {
            return false;
        }

        const style = window.getComputedStyle(element);
        return style.display !== "none" && style.visibility !== "hidden" && element.getClientRects().length > 0;
    };

    window.focusAndSelectTextInput = (element, scrollIntoViewOnMobile = false) => {
        if (!element) {
            return;
        }

        focusAndSelectTextInputCore(element, scrollIntoViewOnMobile);
    };

    window.focusAndSelectVisibleTextInput = (primaryElement, secondaryElement, scrollIntoViewOnMobile = false) => {
        const target = [primaryElement, secondaryElement].find(isVisibleFocusableElement);
        if (!target) {
            return false;
        }

        focusAndSelectTextInputCore(target, scrollIntoViewOnMobile);
        return true;
    };

    window.orionCalendar = window.orionCalendar || {};
    window.orionCalendar.scrollTodayIntoView = (container) => {
        if (!container || typeof container.querySelector !== "function") {
            return;
        }

        window.requestAnimationFrame(() => {
            const todayHeader = container.querySelector("thead th.calendar-day-today");
            if (!todayHeader) {
                return;
            }

            const stickyColumn = container.querySelector(".calendar-room-col");
            const stickyWidth = stickyColumn ? stickyColumn.getBoundingClientRect().width : 0;
            const targetLeft = todayHeader.offsetLeft - stickyWidth - 12;
            const maxLeft = Math.max(container.scrollWidth - container.clientWidth, 0);
            container.scrollLeft = Math.min(Math.max(targetLeft, 0), maxLeft);
        });
    };

    window.pickBankFile = async () => {
        const readFileAsText = (file) => new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.onload = () => resolve({
                name: file.name ?? "",
                size: file.size ?? 0,
                content: typeof reader.result === "string" ? reader.result : ""
            });
            reader.onerror = () => reject(reader.error ?? new Error("No se pudo leer el archivo."));
            reader.readAsText(file);
        });

        const pickerOptions = {
            multiple: false,
            excludeAcceptAllOption: false,
            types: [
                {
                    description: "Archivos de banco",
                    accept: {
                        "text/csv": [".csv"],
                        "application/xml": [".xml"],
                        "text/xml": [".xml"],
                        "text/txt": [".txt"],
                        "application/json": [".json"]
                    }
                }
            ]
        };

        if (window.showOpenFilePicker) {
            try {
                const [handle] = await window.showOpenFilePicker(pickerOptions);
                if (!handle) {
                    return null;
                }

                const file = await handle.getFile();
                return await readFileAsText(file);
            } catch (error) {
                if (error && error.name === "AbortError") {
                    return null;
                }

                throw error;
            }
        }

        return await new Promise((resolve, reject) => {
            const input = document.createElement("input");
            input.type = "file";
            input.accept = ".csv,.txt,.xml,.json,*/*";
            input.style.display = "none";
            let settled = false;

            const cleanup = () => {
                input.removeEventListener("change", onChange);
                window.removeEventListener("focus", onWindowFocus);
                if (document.body.contains(input)) {
                    document.body.removeChild(input);
                }
            };

            const finish = (callback) => {
                if (settled) {
                    return;
                }

                settled = true;
                callback();
                cleanup();
            };

            const onChange = async () => {
                try {
                    const file = input.files && input.files.length > 0 ? input.files[0] : null;
                    if (!file) {
                        finish(() => resolve(null));
                        return;
                    }

                    const result = await readFileAsText(file);
                    finish(() => resolve(result));
                } catch (error) {
                    finish(() => reject(error));
                }
            };

            const onWindowFocus = () => {
                window.setTimeout(() => {
                    const hasSelection = input.files && input.files.length > 0;
                    if (!settled && !hasSelection) {
                        finish(() => resolve(null));
                    }
                }, 300);
            };

            input.addEventListener("change", onChange, { once: true });
            window.addEventListener("focus", onWindowFocus, { once: true });
            document.body.appendChild(input);
            input.click();
        });
    };
</script>
