@using Microsoft.JSInterop
@using OrionERP.Application.Features.Cfdi.DeclaracionPrevia
@using OrionERP.Web.Services
@using OrionERP.Web.State
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IDeclaracionPreviaService DeclaracionService
@inject IUserRfcState RfcState
@inject IUiMessageService UiMessages

<td>
    <button class="btn btn-sm btn-outline-info"
            @onclick:stopPropagation="true"
            @onclick="OpenDetails">
        CFDI-@Item.Comprobante_Id
    </button>
    @if (CanCancelCfdi)
    {
        <button class="btn btn-sm btn-outline-danger ms-1"
                title="Cancelar CFDI en Facturama"
                @onclick:stopPropagation="true"
                @onclick="CancelCfdi">
            Cancelar
        </button>
    }
</td>
<td>
    <button class="btn btn-sm @(IsUnassignedPoliza ? "btn-outline-danger" : "btn-outline-success")"
            title="@(IsUnassignedPoliza ? "Buscar Póliza" : "Ir a Transacción")"
            @onclick:stopPropagation="true"
            @onclick="HandlePolizaClick">
        @(IsUnassignedPoliza ? "Buscar" : ItemPoliza)
    </button>
</td>

@code {

    [Parameter]
    public IDeclaracionComprobanteItem Item { get; set; } = default!;

    [Parameter]
    public bool CanCancelCfdi { get; set; }

    [Parameter]
    public EventCallback<IDeclaracionComprobanteItem> OnCancelCfdi { get; set; }

    private string? ItemPoliza => Item.Poliza;

    private bool IsUnassignedPoliza => string.IsNullOrWhiteSpace(ItemPoliza);

    private async Task OpenDetails()
    {
        if (Item.XML_Attachment_ID is null)
        {
            return;
        }

        var url = $"/cfdi/html-cfdi/{Item.XML_Attachment_ID}";

        try
        {
            await JS.InvokeVoidAsync("open", url, "_blank", "noopener,noreferrer");
        }
        catch
        {
            Nav.NavigateTo(url);
        }
    }

    private async Task CancelCfdi()
    {
        if (OnCancelCfdi.HasDelegate)
        {
            await OnCancelCfdi.InvokeAsync(Item);
        }
    }

    private async Task HandlePolizaClick()
    {
        if (IsUnassignedPoliza)
        {
            var url = Item is DeclaracionComplementoBase complemento && complemento.DoctoRelacionado_Id.HasValue
                ? $"/cfdi/LigarComplemento_Poliza/{complemento.DoctoRelacionado_Id.Value}"
                : $"/cfdi/LigarCFDI_Poliza/{Item.Comprobante_Id}";

            try
            {
                await JS.InvokeVoidAsync("open", url, "_blank", "noopener,noreferrer");
            }
            catch
            {
                Nav.NavigateTo(url);
            }
        }
        else
        {
            await OpenLinkedTransaction();
        }
    }

    private async Task OpenLinkedTransaction()
    {
        if (string.IsNullOrWhiteSpace(ItemPoliza))
        {
            return;
        }

        var url = $"/Contabilidad/transacciones/{Item.Poliza}";

        try
        {
            await JS.InvokeVoidAsync("open", url, "_blank", "noopener,noreferrer");
        }
        catch
        {
            Nav.NavigateTo(url);
        }
    }
}
