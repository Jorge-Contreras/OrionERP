@page "/cuenta/salir"
@model OrionERP.Bruno.Web.Pages.Account.LogoutModel
@{ var membershipName = Presentation.MembershipProgramName ?? "Membresía"; ViewData["Title"] = $"Salir · {membershipName}"; }
<div class="account-shell"><div class="account-art"></div><section class="account-panel"><span>@membershipName</span><h1>Cerrar sesión</h1><p>Tu membresía y puntos permanecerán seguros.</p><form method="post" class="account-form"><button class="button button--accent" type="submit">Cerrar sesión</button></form><div class="account-links"><a href="/cuenta">Cancelar</a></div></section></div>
