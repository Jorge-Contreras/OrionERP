@page "/contabilidad/transacciones/{id:int}"
@using System.Globalization
@using OrionERP.Web.Shared
@attribute [Authorize(Roles = "Administrador,SatOperator")]

<PageTitle>Transacción @Header?.DisplayFolio ?? Id.ToString(CultureInfo.InvariantCulture)</PageTitle>

@if (IsLoading)
{
  <div class="orion-loading" role="status" aria-live="polite">
    <span class="orion-spinner" aria-hidden="true"></span>
    <span class="orion-strong">Cargando transacción…</span>
  </div>
}
else if (!string.IsNullOrEmpty(ErrorMessage))
{
  <div class="alert alert-danger" role="alert">
    <strong>Error:</strong> @ErrorMessage
  </div>
}
else if (Header is null || HeaderEditContext is null)
{
  <div class="alert alert-warning" role="alert">No se encontró la transacción solicitada.</div>
}
else
{
  <div class="d-flex flex-column gap-3">
    <div class="card shadow-sm">
      <div class="card-header d-flex align-items-center gap-2">
        <h5 class="mb-0 flex-grow-1">Datos de la Poliza</h5>
        <span class="badge @HeaderStatusCss">@HeaderStatus</span>
      </div>
      <div class="card-body transaccion-header">
        <EditForm EditContext="HeaderEditContext" OnValidSubmit="SaveHeaderAsync">
          <DataAnnotationsValidator />
          <ValidationSummary />

          <div class="row gy-4">
            <div class="col-12">
              <div class="row g-3 align-items-end">
                <div class="col-6 col-md-3 col-lg-2">
                  <label class="form-label">ID</label>
                  <input class="form-control" value="@Header.Id" readonly />
                </div>
                <div class="col-6 col-md-3 col-lg-2">
                  <label class="form-label">Fecha</label>
                  <InputDate class="form-control" @bind-Value="Header.Fecha" />
                  <ValidationMessage For="() => Header.Fecha" />
                </div>
                <div class="col-12 col-md-6 col-lg-3">
                  <label class="form-label">Tipo de póliza</label>
                  <InputSelect class="form-select" @bind-Value="Header.TipoPoliza">
                    <option value="">Selecciona un tipo</option>
                    @foreach (var tipo in TipoPolizaOptions)
                    {
                      <option value="@tipo">@tipo</option>
                    }
                  </InputSelect>
                  <ValidationMessage For="() => Header.TipoPoliza" />
                </div>
                <div class="col-12 col-md-6 col-lg-3">
                  <label class="form-label">Forma de pago</label>
                  <InputSelect class="form-select" @bind-Value="Header.FormaPago">
                    <option value="">Selecciona una forma</option>
                    @foreach (var forma in FormaPagoOptions)
                    {
                      <option value="@forma.Clave">@forma.Display</option>
                    }
                  </InputSelect>
                  <ValidationMessage For="() => Header.FormaPago" />
                </div>
                <div class="col-12 col-lg-2">
                  <div class="form-check form-switch mt-2 mb-0">
                    <InputCheckbox class="form-check-input" id="facturadoCheck" @bind-Value="Header.Facturado" />
                    <label class="form-check-label" for="facturadoCheck">Facturado</label>
                  </div>
                </div>
              </div>
            </div>

            <div class="col-12">
              <label class="form-label">Concepto</label>
              <InputText class="form-control" @bind-Value="Header.Concepto" />
              <ValidationMessage For="() => Header.Concepto" />
            </div>

            <div class="col-12">
              <div class="row g-3 align-items-end">
                <div class="col-12 col-md-4 col-xl-3">
                  <label class="form-label">Monto</label>
                  <input class="form-control" inputmode="decimal" step="0.01" value="@MontoInput" @oninput="OnMontoInput" @onblur="OnMontoBlur" />
                  <ValidationMessage For="() => Header.Monto" />
                </div>
                <div class="col-12 col-md-4 col-xl-3">
                  <label class="form-label">Referencia</label>
                  <input class="form-control" value="@Header.ReferenciaPreview" readonly title="@Header.Referencia ?? string.Empty" />
                </div>
                <div class="col-12 col-md-4 col-xl-3">
                  <label class="form-label">RFC</label>
                  <input class="form-control-plaintext text-muted" value="@Header.Rfc" readonly />
                </div>
              </div>
            </div>

            <div class="col-12">
              <div class="row g-4">
                <div class="col-12 col-xl-6">
                  <label class="form-label">Proyecto</label>
                  <div class="position-relative">
                    <input class="form-control"
                           value="@ProyectoSearchTerm"
                           placeholder="Buscar por ID o descripción"
                           @oninput="OnProyectoSearchInputAsync"
                           @onkeydown="HandleProyectoSearchKeyDownAsync"
                           @onblur="OnProyectoSearchBlurAsync" />

                    @if (ShowProyectoResults)
                    {
                      <div class="list-group position-absolute w-100 shadow-sm transaccion-lookup-results">
                        @if (ProyectoOptions.Count == 0)
                        {
                          <div class="list-group-item text-muted small">Sin resultados.</div>
                        }
                        else
                        {
                          @foreach (var proyecto in ProyectoOptions)
                          {
                            <button type="button"
                                    class="list-group-item list-group-item-action"
                                    @onmousedown="() => SelectProyecto(proyecto)"
                                    @onmousedown:preventDefault="true">
                              @GetProyectoOptionDisplay(proyecto)
                            </button>
                          }
                        }
                      </div>
                    }
                  </div>
                </div>
                <div class="col-12 col-xl-6">
                  <label class="form-label">Compra</label>
                  <div class="input-group mb-2">
                    <InputText class="form-control"
                               @bind-Value="CompraSearchTerm"
                               @bind-Value:event="oninput"
                               placeholder="Buscar por ID o descripción"
                               @onkeydown="HandleCompraSearchKeyDown" />
                    <button class="btn btn-outline-secondary" type="button" @onclick="SearchCompraOptions">Buscar</button>
                  </div>
                  <InputSelect class="form-select" @bind-Value="Header.CompraId">
                    <option value="">Sin compra</option>
                    @foreach (var compra in CompraOptions)
                    {
                      <option value="@compra.Id">@compra.Display</option>
                    }
                  </InputSelect>
                </div>
                <div class="col-12 col-xl-6 col-xxl-4">
                  <label class="form-label">Servicio</label>
                  <InputSelect class="form-select" @bind-Value="Header.ServicioId">
                    <option value="">Sin servicio</option>
                    @foreach (var servicio in ServicioOptions)
                    {
                      <option value="@servicio.Id">@servicio.Display</option>
                    }
                  </InputSelect>
                </div>
                <div class="col-12 col-xl-6 col-xxl-4">
                  <label class="form-label">Nómina</label>
                  <InputSelect class="form-select" @bind-Value="Header.NominaId">
                    <option value="">Sin nómina</option>
                    @foreach (var nomina in NominaOptions)
                    {
                      <option value="@nomina.Id">@nomina.Display</option>
                    }
                  </InputSelect>
                </div>
              </div>
            </div>

            <div class="col-12">
              <label class="form-label">Memo</label>
              <InputTextArea class="form-control" rows="4" @bind-Value="Header.Memo" />
              <ValidationMessage For="() => Header.Memo" />
            </div>
          </div>

          <div class="d-flex flex-column flex-lg-row gap-3 align-items-stretch align-items-lg-end mt-4">
                        <div class="categoria-col">
                            <label class="form-label">Categoría (Plantilla)</label>
                            <div class="categoria-row">
                                <InputSelect class="form-select" @bind-Value="Header.CategoriaId">
                                    <option value="">Selecciona una categoría</option>
                                    @foreach (var categoria in CategoriaOptions)
                                    {
                                        <option value="@categoria.Id">@categoria.Display</option>
                                    }
                                </InputSelect>
                                <button type="button" class="btn btn-outline-secondary" @onclick="ApplyCategoriaPlantillaAsync" disabled="@IsApplyingPlantilla">
                                    @if (IsApplyingPlantilla)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                                    }
                                    Aplicar Plantilla
                                </button>
                            </div>
                            <ValidationMessage For="() => Header.CategoriaId" />
                        </div>


            <div class="d-flex flex-wrap gap-2 justify-content-end ms-lg-auto">
              <button type="button" class="btn btn-outline-secondary" @onclick="ResetHeaderAsync" disabled="@IsSavingHeader">
                Deshacer
              </button>
              <button type="submit" class="btn btn-primary" disabled="@IsSavingHeader">
                @if (IsSavingHeader)
                {
                  <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                }
                Guardar cambios
              </button>
              <button type="button" class="btn btn-danger" @onclick="DeleteTransaccionAsync" disabled="@IsSavingHeader">
                  <span class="oi oi-trash me-1" aria-hidden="true"></span>
                  Eliminar
              </button>
            </div>
          </div>
        </EditForm>
      </div>
    </div>

    <div class="card shadow-sm">
      <div class="card-header pb-0">
        <ul class="nav nav-tabs card-header-tabs flex-wrap">
          <li class="nav-item">
            <button type="button"
                    class="@GetTabButtonClass(SectionPanel.Movimientos)"
                    @onclick="() => ActivateSection(SectionPanel.Movimientos)">
              Movimientos
            </button>
          </li>
          <li class="nav-item">
            <button type="button"
                    class="@GetTabButtonClass(SectionPanel.Comprobantes)"
                    @onclick="() => ActivateSection(SectionPanel.Comprobantes)">
              Comprobantes vinculados
              <span class="badge text-bg-secondary ms-1">@Comprobantes.Count</span>
            </button>
          </li>
          <li class="nav-item">
            <button type="button"
                    class="@GetTabButtonClass(SectionPanel.Reservaciones)"
                    @onclick="() => ActivateSection(SectionPanel.Reservaciones)">
              Reservaciones
              <span class="badge text-bg-secondary ms-1">@ReservacionLinks.Count</span>
            </button>
          </li>
          <li class="nav-item">
            <button type="button"
                    class="@GetTabButtonClass(SectionPanel.Banco)"
                    @onclick="() => ActivateSection(SectionPanel.Banco)">
              Banco
              <span class="badge text-bg-secondary ms-1">@BancoMovimientos.Count</span>
            </button>
          </li>
          <li class="nav-item">
            <button type="button"
                    class="@GetTabButtonClass(SectionPanel.Attachments)"
                    @onclick="() => ActivateSection(SectionPanel.Attachments)">
              Archivos adjuntos
              <span class="badge text-bg-secondary ms-1">@Attachments.Count</span>
            </button>
          </li>
          <li class="nav-item">
            <button type="button"
                    class="@GetTabButtonClass(SectionPanel.Resumen)"
                    @onclick="() => ActivateSection(SectionPanel.Resumen)">
              Resumen
            </button>
          </li>
        </ul>
      </div>
      <div class="card-body">
        @if (IsActiveSection(SectionPanel.Movimientos))
        {
          <div class="d-flex align-items-center gap-2 flex-wrap mb-3">
            <h5 class="mb-0">Movimientos</h5>
            <span class="badge text-bg-dark">Debe: @Totals.Debe.ToString("N2")</span>
            <span class="badge text-bg-dark">Haber: @Totals.Haber.ToString("N2")</span>
            <span class="badge @(Totals.Balance == 0 ? "text-bg-success" : "text-bg-warning")">
              Balance: @Totals.Balance.ToString("N2")
            </span>
            <button class="btn btn-sm btn-outline-primary ms-auto" type="button" @onclick="() => OpenMovimientoModal(null)">
              <span class="oi oi-plus me-1" aria-hidden="true"></span>Agregar
            </button>
          </div>

          @if (Movimientos.Count == 0)
          {
            <p class="text-muted mb-0">No hay movimientos registrados.</p>
          }
          else
          {
            <div class="table-responsive">
              <table class="table table-sm table-hover align-middle">
                <thead>
                  <tr>
                    <th>#</th>
                    <th>Codigo</th>
                    <th>Cuenta</th>
                    <th>Concepto</th>
                    <th class="text-end">Debe</th>
                    <th class="text-end">Haber</th>
                    <th class="text-end">Acciones</th>
                  </tr>
                </thead>
                <tbody>
                  @foreach (var movimiento in Movimientos.Select((item, index) => (item, index)))
                  {
                    <tr class="@GetMovimientoRowClass(movimiento.item)" @onclick="() => OpenMovimientoModal(movimiento.item)">
                      <td>@(movimiento.index + 1)</td>
                      <td>@FormatCuentaCodigo(movimiento.item)</td>
                      <td>@movimiento.item.NombreCuenta</td>
                      <td>@movimiento.item.Concepto</td>
                      <td class="text-end">@movimiento.item.Debe.ToString("N2") </td>
                      <td class="text-end">@movimiento.item.Haber.ToString("N2")</td>
                      <td class="text-end">
                        <button type="button"
                                class="btn btn-sm btn-outline-danger"
                                title="Eliminar movimiento"
                                disabled="@IsMovimientoDeleting(movimiento.item)"
                                @onclick="async () => await DeleteMovimientoAsync(movimiento.item)"
                                @onclick:stopPropagation="true">
                          @if (IsMovimientoDeleting(movimiento.item))
                          {
                            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                            <span class="visually-hidden">Eliminando…</span>
                          }
                          else
                          {
                            <span class="oi oi-trash" aria-hidden="true"></span>
                            <span class="visually-hidden">Eliminar</span>
                          }
                        </button>
                      </td>
                    </tr>
                  }
                </tbody>
              </table>
            </div>
          }
        }
        else if (IsActiveSection(SectionPanel.Comprobantes))
        {
          <div class="d-flex align-items-center gap-2 flex-wrap mb-3">
            <h5 class="mb-0">Comprobantes vinculados</h5>
            <div class="ms-auto d-flex gap-2 flex-wrap">
              <button type="button"
                      class="btn btn-sm btn-outline-warning"
                      disabled="@(!CanRegenerarMovimientos())"
                      @onclick="RegenerarMovimientosDesdeComprobanteAsync">
                @if (IsRegeneratingMovimientos)
                {
                  <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                }
                Crear Movimientos con CFDI
              </button>
              <a class="btn btn-sm btn-outline-success"
                 href="/Contabilidad/LigarTransacciones/@Header.Id"
                 target="_blank" rel="noopener">
                Ligar Comprobante
              </a>
            </div>
          </div>

          <div class="border rounded p-3 mb-3 bg-light">
            <div class="d-flex flex-column flex-xl-row align-items-xl-end gap-3">
              <div class="flex-grow-1">
                <div class="fw-semibold">CFDI público en general</div>
                <div class="text-muted small">
                  Usa el monto actual de la póliza y genera el XML/PDF en Facturama para ligarlo automáticamente a esta transacción.
                </div>
              </div>

              <div class="row g-2 align-items-end m-0">
                <div class="col-12 col-sm-auto">
                  <label class="form-label form-label-sm mb-1">Mes global</label>
                  <InputSelect class="form-select form-select-sm" @bind-Value="SelectedPublicoMonthCode">
                    @foreach (var month in PublicoMonthOptions)
                    {
                      <option value="@month.Code">@month.Name</option>
                    }
                  </InputSelect>
                </div>
                <div class="col-12 col-sm-auto">
                  <label class="form-label form-label-sm mb-1">Año global</label>
                  <InputSelect class="form-select form-select-sm" @bind-Value="SelectedPublicoYear">
                    @foreach (var year in PublicoYearOptions)
                    {
                      <option value="@year">@year</option>
                    }
                  </InputSelect>
                </div>
                <div class="col-12 col-sm-auto">
                  <button type="button"
                          class="btn btn-sm btn-outline-primary"
                          disabled="@IsTimbrandoPublico"
                          @onclick="TimbrarCfdiPublicoAsync">
                    @if (IsTimbrandoPublico)
                    {
                      <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                    }
                    CFDI Público
                  </button>
                </div>
              </div>
            </div>
          </div>

          @if (Comprobantes.Count == 0)
          {
            <p class="text-muted mb-0">No hay comprobantes vinculados.</p>
          }
          else
          {
            <div class="table-responsive table-scroll" style="max-height: 320px;">
              <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-light">
                  <tr>
                    <th scope="col">Comprobante ID</th>
                    <th scope="col">CFDI</th>
                    <th scope="col">Fecha</th>
                    <th scope="col">Tipo</th>
                    <th scope="col">Serie</th>
                    <th scope="col">Folio</th>
                    <th scope="col">Emisor RFC</th>
                    <th scope="col">Receptor RFC</th>
                    <th scope="col">UUID</th>
                    <th scope="col">Forma Pago</th>
                    <th scope="col" class="text-end">Total</th>
                    <th scope="col">#Pólizas</th>
                    <th scope="col" class="text-end">Asignado</th>
                    <th scope="col">Método Pago</th>
                    <th scope="col">Uso CFDI</th>
                    <th scope="col">Conceptos</th>
                    <th scope="col">Acciones</th>
                  </tr>
                </thead>
                <tbody>
                  @foreach (var comprobante in Comprobantes)
                  {
                    <tr class="@(IsComprobanteSelected(comprobante) ? "table-active" : string.Empty)"
                        @onclick="() => SelectComprobante(comprobante)">
                      <td>@comprobante.ComprobanteId</td>
                      <td>
                        <button type="button"
                                class="btn btn-sm btn-outline-info"
                                disabled="@(!comprobante.XmlAttachmentId.HasValue)"
                                @onclick="() => OpenComprobanteCfdiAsync(comprobante)">
                          CFDI-@comprobante.ComprobanteId
                        </button>
                      </td>
                      <td>@comprobante.Fecha.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)</td>
                      <td>@comprobante.Tipo</td>
                      <td>@comprobante.Serie</td>
                      <td>@comprobante.Folio</td>
                      <td>@comprobante.EmisorRfc</td>
                      <td>@comprobante.ReceptorRfc</td>
                      <td>@comprobante.Uuid</td>
                      <td>@comprobante.FormaPago</td>
                      <td class="text-end">@FormatCurrency(comprobante.Total)</td>
                      <td>@comprobante.Polizas</td>
                      <td class="text-end">@FormatCurrency(comprobante.Asignado)</td>
                      <td>@comprobante.MetodoPago</td>
                      <td>@comprobante.UsoCfdi</td>
                      <td class="text-wrap">@comprobante.Conceptos</td>
                      <td>
                        <button type="button"
                                class="btn btn-sm btn-outline-warning"
                                disabled="@IsComprobanteUnlinking(comprobante)"
                                @onclick="() => UnlinkComprobanteAsync(comprobante)"
                                @onclick:stopPropagation="true">
                          @if (IsComprobanteUnlinking(comprobante))
                          {
                            <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                          }
                          Desligar
                        </button>
                      </td>
                    </tr>
                  }
                </tbody>
              </table>
            </div>
          }
        }
        else if (IsActiveSection(SectionPanel.Reservaciones))
        {
          <div class="d-flex align-items-center gap-2 flex-wrap mb-3">
            <h5 class="mb-0">Reservaciones vinculadas</h5>
            <span class="badge text-bg-dark">Monto póliza: @FormatCurrency(Header.Monto)</span>
            <span class="badge text-bg-dark">Asignado: @FormatCurrency(ReservacionesAsignadasTotal)</span>
            <span class="badge @ReservacionesBalanceCss">Por asignar: @FormatCurrency(ReservacionesPorAsignar)</span>
          </div>

          @if (HasReservacionesAsignadas && decimal.Abs(ReservacionesPorAsignar) > 0.01m)
          {
            <div class="alert alert-warning" role="alert">
              Hay reservaciones asignadas, pero el total todavía no cuadra con el monto de la póliza.
            </div>
          }

          <div class="row g-4">
            <div class="col-12 col-xl-5">
              <div class="border rounded p-3 h-100">
                <div class="d-flex flex-wrap gap-2 align-items-end mb-3">
                  <div class="flex-grow-1">
                    <label class="form-label">Buscar reservación</label>
                    <input class="form-control"
                           placeholder="ID, cliente o notas"
                           @bind="ReservacionSearchTerm"
                           @bind:event="oninput"
                           @onkeydown="HandleReservacionSearchKeyDown" />
                  </div>
                  <button type="button"
                          class="btn btn-outline-secondary"
                          @onclick="() => SearchReservacionesAsync()"
                          disabled="@IsSearchingReservaciones">
                    @if (IsSearchingReservaciones)
                    {
                      <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                    }
                    Buscar
                  </button>
                </div>

                <div class="form-text mb-3">
                  La lista usa `LISTA_DE_RESERVACIONES` y prioriza reservaciones con saldo pendiente. Si buscas por ID exacto, también trae esa reservación.
                </div>

                @if (IsSearchingReservaciones)
                {
                  <div class="orion-loading" role="status" aria-live="polite">
                    <span class="orion-spinner" aria-hidden="true"></span>
                    <span class="orion-strong">Buscando reservaciones…</span>
                  </div>
                }
                else if (ReservacionCandidates.Count == 0)
                {
                  <div class="alert alert-info mb-0">No se encontraron reservaciones candidatas.</div>
                }
                else
                {
                  <div class="table-responsive" style="max-height: 460px;">
                    <table class="table table-sm table-hover align-middle mb-0 reservacion-linking-table">
                      <thead class="table-light">
                        <tr>
                          <th>ID</th>
                          <th>Cliente</th>
                          <th>Status</th>
                          <th class="text-end">Total</th>
                          <th class="text-end">Pagado</th>
                          <th class="text-end">Por pagar</th>
                        </tr>
                      </thead>
                      <tbody>
                        @foreach (var reservacion in ReservacionCandidates)
                        {
                          <tr class="@(IsReservacionCandidateSelected(reservacion) ? "table-primary" : string.Empty)"
                              @onclick="() => SelectReservacionCandidate(reservacion)">
                            <td>@reservacion.ReservationId</td>
                            <td class="text-wrap">@reservacion.Cliente</td>
                            <td>@reservacion.Status</td>
                            <td class="text-end">@FormatCurrency(reservacion.TotalPrice)</td>
                            <td class="text-end">@FormatCurrency(reservacion.Pagado)</td>
                            <td class="text-end @(reservacion.PorPagar > 0 ? "text-danger" : "text-success")">@FormatCurrency(reservacion.PorPagar)</td>
                          </tr>
                        }
                      </tbody>
                    </table>
                  </div>
                }
              </div>
            </div>

            <div class="col-12 col-xl-7">
              <div class="border rounded p-3 mb-3">
                <div class="d-flex align-items-center flex-wrap gap-2 mb-3">
                  <h6 class="mb-0">Asignación</h6>
                  @if (HasReservacionSelection)
                  {
                    <span class="badge text-bg-secondary">Reservación #@SelectedReservacionId</span>
                  }
                </div>

                @if (!HasReservacionSelection)
                {
                  <p class="text-muted mb-0">Selecciona una reservación de la lista o una asignación existente para editarla.</p>
                }
                else
                {
                  <div class="row g-3">
                    <div class="col-12 col-md-6">
                      <label class="form-label">Cliente</label>
                      <input class="form-control" value="@SelectedReservacionCliente" readonly />
                    </div>
                    <div class="col-6 col-md-3">
                      <label class="form-label">Check In</label>
                      <input class="form-control" value="@SelectedReservacionCheckIn?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" readonly />
                    </div>
                    <div class="col-6 col-md-3">
                      <label class="form-label">Check Out</label>
                      <input class="form-control" value="@SelectedReservacionCheckOut?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" readonly />
                    </div>
                    <div class="col-6 col-md-3">
                      <label class="form-label">Status</label>
                      <input class="form-control" value="@SelectedReservacionStatus" readonly />
                    </div>
                    <div class="col-6 col-md-3">
                      <label class="form-label">Total</label>
                      <input class="form-control" value="@FormatCurrency(SelectedReservacionTotal)" readonly />
                    </div>
                    <div class="col-6 col-md-3">
                      <label class="form-label">Pagado</label>
                      <input class="form-control" value="@FormatCurrency(SelectedReservacionPagado)" readonly />
                    </div>
                    <div class="col-6 col-md-3">
                      <label class="form-label">Por pagar</label>
                      <input class="form-control" value="@FormatCurrency(SelectedReservacionPorPagar)" readonly />
                    </div>
                    <div class="col-12 col-lg-4">
                      <label class="form-label">Monto a asignar</label>
                      <InputNumber class="form-control" step="0.01" @bind-Value="ReservacionAmountInput" />
                    </div>
                    <div class="col-12 col-lg-8 d-flex flex-wrap gap-2 align-items-end">
                      <button type="button"
                              class="btn btn-outline-secondary"
                              @onclick="UsePendingReservacionAmount"
                              disabled="@IsSavingReservacionLink">
                        Usar saldo pendiente
                      </button>
                      <button type="button"
                              class="btn btn-primary"
                              @onclick="SaveReservacionLinkAsync"
                              disabled="@IsSavingReservacionLink">
                        @if (IsSavingReservacionLink)
                        {
                          <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                        }
                        @ReservacionActionLabel
                      </button>
                      <button type="button"
                              class="btn btn-outline-secondary"
                              @onclick="ClearReservacionSelection"
                              disabled="@IsSavingReservacionLink">
                        Limpiar seleccion
                      </button>
                      <a class="btn btn-outline-primary"
                         href="/reservaciones/@SelectedReservacionId"
                         target="_blank" rel="noopener">
                        Abrir reservacion
                      </a>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(SelectedReservacionNotes))
                    {
                      <div class="col-12">
                        <label class="form-label">Notas</label>
                        <textarea class="form-control" rows="2" readonly>@SelectedReservacionNotes</textarea>
                      </div>
                    }
                  </div>
                }
              </div>

              <div class="border rounded p-3">
                <div class="d-flex align-items-center gap-2 flex-wrap mb-3">
                  <h6 class="mb-0">Asignaciones actuales</h6>
                  <span class="badge text-bg-secondary">@ReservacionLinks.Count</span>
                </div>

                @if (IsLoadingReservacionLinks)
                {
                  <div class="orion-loading" role="status" aria-live="polite">
                    <span class="orion-spinner" aria-hidden="true"></span>
                    <span class="orion-strong">Cargando asignaciones…</span>
                  </div>
                }
                else if (ReservacionLinks.Count == 0)
                {
                  <p class="text-muted mb-0">No hay reservaciones ligadas a esta póliza.</p>
                }
                else
                {
                  <div class="table-responsive" style="max-height: 360px;">
                    <table class="table table-sm table-hover align-middle mb-0 reservacion-linking-table">
                      <thead class="table-light">
                        <tr>
                          <th>ID</th>
                          <th>Cliente</th>
                          <th>Status</th>
                          <th class="text-end">Asignado</th>
                          <th class="text-end">Pagado</th>
                          <th class="text-end">Por pagar</th>
                          <th class="text-end">Acciones</th>
                        </tr>
                      </thead>
                      <tbody>
                        @foreach (var reservacion in ReservacionLinks)
                        {
                          <tr class="@(IsReservacionLinkSelected(reservacion) ? "table-primary" : string.Empty)"
                              @onclick="() => EditReservacionLink(reservacion)">
                            <td>@reservacion.ReservationId</td>
                            <td class="text-wrap">@reservacion.Cliente</td>
                            <td>@reservacion.Status</td>
                            <td class="text-end">@FormatCurrency(reservacion.Amount)</td>
                            <td class="text-end">@FormatCurrency(reservacion.Pagado)</td>
                            <td class="text-end @(reservacion.PorPagar > 0 ? "text-danger" : "text-success")">@FormatCurrency(reservacion.PorPagar)</td>
                            <td class="text-end">
                              <div class="d-inline-flex gap-2">
                                <button type="button"
                                        class="btn btn-sm btn-outline-primary"
                                        @onclick="() => EditReservacionLink(reservacion)"
                                        @onclick:stopPropagation="true">
                                  Editar
                                </button>
                                <a class="btn btn-sm btn-outline-secondary"
                                   href="/reservaciones/@reservacion.ReservationId"
                                   target="_blank" rel="noopener"
                                   @onclick:stopPropagation="true">
                                  Abrir
                                </a>
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger"
                                        disabled="@IsReservacionLinkDeleting(reservacion)"
                                        @onclick="() => DeleteReservacionLinkAsync(reservacion)"
                                        @onclick:stopPropagation="true">
                                  @if (IsReservacionLinkDeleting(reservacion))
                                  {
                                    <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                                  }
                                  Eliminar
                                </button>
                              </div>
                            </td>
                          </tr>
                        }
                      </tbody>
                    </table>
                  </div>
                }
              </div>
            </div>
          </div>
        }
        else if (IsActiveSection(SectionPanel.Banco))
        {
          <div class="d-flex align-items-center gap-2 flex-wrap mb-3">
            <h5 class="mb-0">Movimientos bancarios</h5>
            <span class="badge text-bg-secondary">Total: @BancoMovimientos.Count</span>
          </div>

          @if (IsLoadingBancoMovimientos)
          {
            <div class="orion-loading" role="status" aria-live="polite">
              <span class="orion-spinner" aria-hidden="true"></span>
              <span class="orion-strong">Cargando movimientos bancarios…</span>
            </div>
          }
          else if (BancoMovimientos.Count == 0)
          {
            <p class="text-muted mb-0">No hay movimientos bancarios ligados a esta póliza.</p>
          }
          else
          {
            <div class="table-responsive">
              <table class="table table-sm table-hover align-middle">
                <thead class="table-light">
                  <tr>
                    <th scope="col">ID</th>
                    <th scope="col">Banco</th>
                    <th scope="col">Cuenta</th>
                    <th scope="col">Día</th>
                    <th scope="col">Concepto</th>
                    <th scope="col">Tipo</th>
                    <th scope="col" class="text-end">Cargo</th>
                    <th scope="col" class="text-end">Abono</th>
                    <th scope="col" class="text-end">Saldo</th>
                    <th scope="col">Fecha carga</th>
                    <th scope="col" class="text-end">Acciones</th>
                  </tr>
                </thead>
                <tbody>
                  @foreach (var movimiento in BancoMovimientos)
                  {
                    <tr>
                      <td>@movimiento.MovimientoId</td>
                      <td>@movimiento.NombreBanco</td>
                      <td>@movimiento.NumeroCuenta</td>
                      <td>@movimiento.Dia.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</td>
                      <td class="text-wrap">@movimiento.Concepto</td>
                      <td>@movimiento.Tipo</td>
                      <td class="text-end">@FormatCurrency(movimiento.Cargo)</td>
                      <td class="text-end">@FormatCurrency(movimiento.Abono)</td>
                      <td class="text-end">@FormatCurrency(movimiento.Saldo)</td>
                      <td>@movimiento.FechaCarga.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)</td>
                      <td class="text-end">
                        <button type="button"
                                class="btn btn-sm btn-outline-warning"
                                disabled="@IsBancoMovimientoUnlinking(movimiento)"
                                @onclick="() => UnlinkBancoMovimientoAsync(movimiento)">
                          @if (IsBancoMovimientoUnlinking(movimiento))
                          {
                            <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                          }
                          Desligar
                        </button>
                      </td>
                    </tr>
                  }
                </tbody>
              </table>
            </div>
          }
        }
        else if (IsActiveSection(SectionPanel.Attachments))
        {
          <div class="d-flex align-items-center flex-wrap gap-2 mb-3">
            <h5 class="mb-0">Archivos adjuntos</h5>
            <label class="btn btn-sm btn-outline-primary ms-auto mb-0 @(IsUploadingAttachment ? "disabled" : string.Empty)">
              @if (IsUploadingAttachment)
              {
                <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                <span>Cargando…</span>
              }
              else
              {
                <span class="oi oi-cloud-upload me-1" aria-hidden="true"></span>
                <span>Cargar archivo</span>
              }
              <InputFile @key="_attachmentInputKey"
                         class="d-none"
                         OnChange="OnAttachmentSelectedAsync"
                         disabled="@IsUploadingAttachment" />
            </label>
          </div>

          @if (Attachments.Count == 0)
          {
            <p class="text-muted mb-0">No hay archivos adjuntos.</p>
          }
          else
          {
            <div class="table-responsive">
              <table class="table table-sm align-middle">
                <thead>
                  <tr>
                    <th>Nombre</th>
                    <th>Extensión</th>
                    <th class="text-end">Tamaño</th>
                    <th class="text-end">Acciones</th>
                  </tr>
                </thead>
                <tbody>
                  @foreach (var attachment in Attachments)
                  {
                    <tr @ondblclick="async () => await DownloadAttachmentAsync(attachment)" style="cursor: pointer;">
                      <td>@attachment.Nombre</td>
                      <td>@attachment.Extension</td>
                      <td class="text-end">@attachment.TamanoHumano</td>
                      <td class="text-end">
                        <div class="d-inline-flex gap-2">
                          <button type="button"
                                  class="btn btn-sm btn-outline-primary"
                                  disabled="@(IsAttachmentDownloading(attachment) || IsAttachmentDeleting(attachment))"
                                  @onclick="async () => await DownloadAttachmentAsync(attachment)">
                            @if (IsAttachmentDownloading(attachment))
                            {
                              <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                              <span>Descargando&hellip;</span>
                            }
                            else
                            {
                              <span class="oi oi-cloud-download me-1" aria-hidden="true"></span>
                              <span>Descargar</span>
                            }
                          </button>
                          <button type="button"
                                  class="btn btn-sm btn-outline-danger"
                                  disabled="@(IsAttachmentDeleting(attachment) || IsAttachmentDownloading(attachment))"
                                  @onclick="async () => await DeleteAttachmentAsync(attachment)">
                            @if (IsAttachmentDeleting(attachment))
                            {
                              <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                              <span>Eliminando&hellip;</span>
                            }
                            else
                            {
                              <span class="oi oi-trash me-1" aria-hidden="true"></span>
                              <span>Eliminar</span>
                            }
                          </button>
                        </div>
                      </td>
                    </tr>
                  }
                </tbody>
              </table>
            </div>
          }
        }
        else if (IsActiveSection(SectionPanel.Resumen))
        {
          <h5 class="mb-3">Resumen</h5>
          <dl class="row mb-0">
            <dt class="col-6">Total movimientos</dt>
            <dd class="col-6 text-end">@Movimientos.Count</dd>
            <dt class="col-6">Suma Debe</dt>
            <dd class="col-6 text-end">@Totals.Debe.ToString("N2")</dd>
            <dt class="col-6">Suma Haber</dt>
            <dd class="col-6 text-end">@Totals.Haber.ToString("N2")</dd>
            <dt class="col-6">Balance</dt>
            <dd class="col-6 text-end">@Totals.Balance.ToString("N2")</dd>
            <dt class="col-6">Archivos</dt>
            <dd class="col-6 text-end">@Attachments.Count</dd>
            <dt class="col-6">Comprobantes</dt>
            <dd class="col-6 text-end">@Comprobantes.Count</dd>
          </dl>
        }
      </div>
    </div>
  </div>
}

@if (ShowMovimientoModal && MovimientoDraft is not null)
{
  <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.35);" role="dialog" aria-modal="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">@MovimientoModalTitle</h5>
          <button type="button" class="btn-close" @onclick="CloseMovimientoModal"></button>
        </div>
        <div class="modal-body">
          <EditForm EditContext="MovimientoEditContext"
                    OnSubmit="PreventMovimientoSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="d-flex flex-column gap-3">
              <div class="d-flex flex-wrap gap-2 align-items-center">
                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="ShowCuentaPicker">Buscar/Reemplazar Cuenta</button>
                @if (!string.IsNullOrWhiteSpace(MovimientoDraft?.Descripcion))
                {
                  <span class="badge text-bg-info text-wrap flex-grow-1">@MovimientoDraft!.Descripcion</span>
                }
              </div>
              <ValidationMessage For="() => MovimientoDraft!.NombreCuenta" />

              @if (IsCuentaPickerVisible)
              {
                <div class="border rounded p-3 bg-light-subtle">
                  <CuentaContablePicker
                    @ref="CuentaPicker"
                    SelectedRfc="@CuentaPickerRfc"
                    SelectedRfcChanged="@OnCuentaPickerRfcChangedAsync"
                    Selection="@MovimientoCuentaSelection"
                    SelectionChanged="@OnCuentaPickerSelectionChangedAsync"
                    SearchRequested="@OnCuentaPickerSearchRequestedAsync"
                    ErrorChanged="@OnCuentaPickerErrorChangedAsync" />

                  @if (!string.IsNullOrWhiteSpace(CuentaPickerError))
                  {
                    <div class="alert alert-danger mt-3 mb-0" role="alert">@CuentaPickerError</div>
                  }

                  <div class="d-flex justify-content-end mt-3">
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="HideCuentaPicker">Cerrar</button>
                  </div>
                </div>
              }

              <div class="d-flex flex-wrap gap-2">
                <span class="badge text-bg-secondary">Nivel 1: @FormatNivelValue(MovimientoDraft?.Nivel1)</span>
                <span class="badge text-bg-secondary">Nivel 2: @FormatNivelValue(MovimientoDraft?.Nivel2)</span>
                <span class="badge text-bg-secondary">Nivel 3: @FormatNivelValue(MovimientoDraft?.Nivel3)</span>
              </div>

              <div class="row g-3 align-items-end">
                <div class="col-lg-8">
                  <label class="form-label text-uppercase">Concepto</label>
                    <InputText class="form-control" @bind-Value="MovimientoDraft!.Concepto" />
                    <ValidationMessage For="() => MovimientoDraft!.Concepto" />
                </div>
                <div class="col-lg-4 d-flex align-items-end">
                  <button type="button" class="btn btn-outline-secondary w-100" @onclick="CopyConceptoFromHeader">Concepto póliza</button>
                </div>
              </div>

              <div class="row g-3 align-items-end">
                <div class="col-lg-4">
                  <label class="form-label text-uppercase">Debe</label>
                  <InputNumber class="form-control" step="0.01" @bind-Value="MovimientoDraft!.Debe" />
                  <ValidationMessage For="() => MovimientoDraft!.Debe" />
                </div>
                <div class="col-lg-8">
                  <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CopyMontoToDebe">Copiar monto a Debe</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ApplySubtotalToDebe">Subtotal</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ApplyIvaToDebe">IVA</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClearDebe">Cero</button>
                  </div>
                </div>
              </div>

              <div class="row g-3 align-items-end">
                <div class="col-lg-4">
                  <label class="form-label text-uppercase">Haber</label>
                  <InputNumber class="form-control" step="0.01" @bind-Value="MovimientoDraft!.Haber" />
                  <ValidationMessage For="() => MovimientoDraft!.Haber" />
                </div>
                <div class="col-lg-8">
                  <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CopyMontoToHaber">Copiar monto a Haber</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ApplySubtotalToHaber">Subtotal</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ApplyIvaToHaber">IVA</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClearHaber">Cero</button>
                  </div>
                </div>
              </div>

              <div class="d-flex justify-content-end gap-2">
                <button class="btn btn-outline-secondary" type="button" @onclick="CloseMovimientoModal">Cancelar</button>
                <button class="btn btn-primary" type="button" @onclick="SaveMovimientoAsync">Guardar movimiento</button>
              </div>
            </div>
          </EditForm>
        </div>
      </div>
    </div>
  </div>
} 
