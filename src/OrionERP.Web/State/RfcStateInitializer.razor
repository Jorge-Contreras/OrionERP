@using System.Security.Claims
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using OrionERP.Web.State
@implements IDisposable

@* This component has no UI; it initializes and persists the RFC state. *@
@ChildContent

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; } = default!;
    [Inject] private IUserRfcState RfcState { get; set; } = default!;
    [Inject] private ProtectedLocalStorage Storage { get; set; } = default!;

    private bool _initialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialized) return;

        // Re-run init if auth state changes (e.g., user logs in/out)
        AuthStateProvider.AuthenticationStateChanged += OnAuthStateChanged;

        await InitializeAsync();
        _initialized = true;
    }

    private async Task InitializeAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated != true)
        {
            // Clear allowed/selected when not authenticated
            RfcState.InitializeFromClaims(new ClaimsPrincipal());
            return;
        }

        // Build allowed set from claims
        RfcState.InitializeFromClaims(user);

        // Restore last selection if still valid
        var saved = await Storage.GetAsync<string>("current_rfc");
        if (saved.Success && !string.IsNullOrWhiteSpace(saved.Value))
        {
            if (!RfcState.TrySet(saved.Value))
                RfcState.ResetToDefault();
        }

        // Persist on every change
        RfcState.Changed -= OnRfcChangedPersist; // avoid dup subscription
        RfcState.Changed += OnRfcChangedPersist;

        StateHasChanged();
    }

    private async void OnAuthStateChanged(Task<AuthenticationState> task)
    {
        try
        {
            var state = await task;
            RfcState.InitializeFromClaims(state.User);
            await PersistCurrentAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch { /* no-op */ }
    }

    private async void OnRfcChangedPersist()
    {
        try { await PersistCurrentAsync(); } catch { /* no-op */ }
    }

    private async Task PersistCurrentAsync()
    {
        await Storage.SetAsync("current_rfc", RfcState.CurrentRfc ?? string.Empty);
    }

    public void Dispose()
    {
        AuthStateProvider.AuthenticationStateChanged -= OnAuthStateChanged;
        RfcState.Changed -= OnRfcChangedPersist;
    }
}
