{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orionerp.local/schemas/marketing/media-plan.schema.json",
  "title": "OrionERP Marketing Media Plan",
  "type": "object",
  "required": [
    "schemaVersion",
    "brandId",
    "week",
    "strategy",
    "assets",
    "reviewChecklist"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "brandId": {
      "type": "string"
    },
    "week": {
      "type": "object",
      "required": [
        "id",
        "startDate",
        "endDate"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "startDate": {
          "type": "string",
          "format": "date"
        },
        "endDate": {
          "type": "string",
          "format": "date"
        }
      },
      "additionalProperties": true
    },
    "requestedMedia": {
      "type": "string"
    },
    "strategy": {
      "type": "object",
      "required": [
        "objective",
        "occupancyTargetPct",
        "primaryAudience",
        "rationale"
      ],
      "properties": {
        "objective": {
          "type": "string"
        },
        "occupancyTargetPct": {
          "type": "number"
        },
        "occupancyGapPctPoints": {
          "type": [
            "number",
            "null"
          ]
        },
        "primaryAudience": {
          "type": "string"
        },
        "secondaryAudience": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "platforms",
          "size",
          "audience",
          "hook",
          "concept",
          "caption",
          "cta"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "facebook_image",
              "instagram_image",
              "tiktok_video",
              "reel_video",
              "story_image",
              "search_ad",
              "copy_only"
            ]
          },
          "platforms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "size": {
            "type": "string"
          },
          "durationSeconds": {
            "type": [
              "string",
              "number"
            ]
          },
          "audience": {
            "type": "string"
          },
          "hook": {
            "type": "string"
          },
          "concept": {
            "type": "string"
          },
          "visualDirection": {
            "type": "string"
          },
          "caption": {
            "type": "string"
          },
          "cta": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "planned",
              "generated",
              "unsupported_v1",
              "needs_review",
              "failed"
            ]
          },
          "assetDecision": {
            "type": "string",
            "enum": [
              "logo_only",
              "suite_card",
              "logo_and_suite_card",
              "business_brand_poster"
            ]
          },
          "sourceSuitePhoto": {
            "type": [
              "string",
              "null"
            ]
          },
          "sourceLogo": {
            "type": [
              "string",
              "null"
            ]
          },
          "outputPath": {
            "type": [
              "string",
              "null"
            ]
          },
          "factualPhotoPolicy": {
            "type": "string"
          },
          "openAiPrompt": {
            "type": "string"
          },
          "reviewNotes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "searchAds": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "reviewChecklist": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
