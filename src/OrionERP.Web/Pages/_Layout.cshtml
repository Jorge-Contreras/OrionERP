@using Microsoft.AspNetCore.Components.Web
@namespace OrionERP.Web.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@inject Microsoft.Extensions.Hosting.IHostEnvironment HostEnvironment
@{
    var isTraining = HostEnvironment.IsEnvironment("Training");
}
<!DOCTYPE html>
<html lang="es">
<head>
    
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    
    <title>@(isTraining ? "CAPACITACIÓN · " : "")@ViewData["Title"] - OrionERP</title>
    <base href="~/" />
    @if (isTraining)
    {
        <link rel="stylesheet" href="~/css/bootstrap.min.css" asp-append-version="true" />
    }
    else
    {
        <link rel="stylesheet"
              href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    }


    <!-- CSS global del sitio -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/workforce.css" asp-append-version="true" />
    <!-- Si REALMENTE usas app.css, déjalo; si no, elimínalo -->
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />

    <!-- Bundle de CSS aislado (incluye Index.razor.css automáticamente) -->
    <link rel="stylesheet" href="~/OrionERP.Web.styles.css" asp-append-version="true" />

    @RenderSection("Styles", required: false)
    <component type="typeof(HeadOutlet)" render-mode="ServerPrerendered" />
</head>
<body class="@(isTraining ? "orion-training-page" : null)">

    @if (isTraining)
    {
        <div class="training-page-banner" role="status" aria-live="polite">
            ⚠ ENTORNO DE PRÁCTICA · DATOS SIMULADOS · NO USES TU CONTRASEÑA DE PRODUCCIÓN
        </div>
    }

    <div class="container-fluid p-0">
        @RenderBody()
    </div>

    <!-- Scripts al final (solo una vez) -->
    @if (isTraining)
    {
        <script src="~/css/bootstrap.bundle.min.js" asp-append-version="true"></script>
    }
    else
    {
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    }

    <script src="~/_framework/blazor.server.js"></script>
    <script src="~/js/orion-print.js" asp-append-version="true"></script>
    <script src="~/js/orion-command-center.js" asp-append-version="true"></script>
    <script src="~/js/orion-work-order-reconnect.js" asp-append-version="true"></script>
    @if (isTraining)
    {
        <script type="module">
            import { installTrainingSafetyGuards } from "/js/training-safety.js";
            installTrainingSafetyGuards();
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
    
</body>
</html>
