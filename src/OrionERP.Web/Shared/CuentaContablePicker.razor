@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using OrionERP.Application.Features.Contabilidad.ContabilidadRegistros
@using OrionERP.Web.State

<div class="row g-3 align-items-end">
  <div class="col-md-2">
    <label class="form-label">Cuenta #</label>
    <input class="form-control" type="number" min="1" @bind="directAccountId" @bind:event="oninput"
           @onkeydown="OnDirectAccountKeyDown" />
  </div>
</div>

<div class="mt-3">
  <div class="row g-3">
    <div class="col-md-4">
      <label class="form-label">Buscar Nivel 1</label>
      <input class="form-control" placeholder="Ej. 102 o BANCOS" @bind="nivel1Term" @onkeyup="OnNivel1KeyDown" />
      @if (nivel1Results.Any())
      {
        <div class="table-responsive mt-2" style="max-height: 320px; overflow-y: auto;">
          <table class="table table-sm table-hover mb-0">
            <thead>
              <tr>
                <th>Id</th>
                <th>Nivel1</th>
                <th>Descripción</th>
              </tr>
            </thead>
            <tbody>
              @foreach (var item in nivel1Results)
              {
                <tr role="button" @onclick="() => SelectNivel1Async(item)">
                  <td>@item.Id</td>
                  @* <td>@item.Rfc</td> *@
                  <td>@item.Nivel1</td>
                  <td>@item.Descripcion</td>
                </tr>
              }
            </tbody>
          </table>
        </div>
      }
    </div>
    <div class="col-md-4">
      <label class="form-label">Buscar Nivel 2</label>
      <input class="form-control" placeholder="Ej. 01 o descripción" @bind="nivel2Term" @onkeyup="OnNivel2KeyDown" disabled="@(!CanSearchNivel2)" />
      @if (nivel2Results.Any())
      {
        <div class="table-responsive mt-2">
          <table class="table table-sm table-hover mb-0">
            <thead>
              <tr>
                <th>Id</th>
                <th>Nivel2</th>
                <th>Descripción</th>
              </tr>
            </thead>
            <tbody>
              @foreach (var item in nivel2Results)
              {
                <tr role="button" @onclick="() => SelectNivel2Async(item)">
                  <td>@item.Id</td>
                  <td>@item.Nivel2</td>
                  <td>@item.Descripcion</td>
                </tr>
              }
            </tbody>
          </table>
        </div>
      }
    </div>
        <div class="col-md-4">
            <label class="form-label">Buscar Nivel 3</label>

            <div class="input-group">
                <input class="form-control"
                       placeholder="Ej. 02 o descripción"
                       @bind-value="nivel3Term"
                       @bind-value:event="oninput"
                       @onkeydown="OnNivel3KeyDown"
                       disabled="@(!CanSearchNivel3)" />

                @if (CanSearchNivel3)
                {
                    <button class="btn btn-outline-primary"
                            type="button"
                            @onclick="ShowCreateNivel3Modal">
                        Crear Nuevo
                    </button>
                }
            </div>

            @if (nivel3Results.Any())
            {
                <div class="table-responsive mt-2" style="max-height: 320px; overflow-y: auto;">
                    <table class="table table-sm table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Nivel3</th>
                                <th>Descripción</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in nivel3Results)
                            {
                                <tr role="button" @onclick="() => SelectNivel3(item)">
                                    <td>@item.Id</td>
                                    <td>@item.Nivel3</td>
                                    <td>@item.Descripcion</td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-secondary"
                                                type="button"
                                                @onclick="() => ShowEditNivel3Modal(item)"
                                                @onclick:stopPropagation="true">
                                            <i class="oi oi-pencil"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

  </div>
</div>
@if (showNivel3Modal)
{
    <div class="modal fade show" tabindex="-1" style="display: block;" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(isEditingNivel3 ? "Editar" : "Crear") Nivel 3</h5>
                    <button type="button" class="btn-close" @onclick="CloseNivel3Modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Nivel 1</label>
                        <input class="form-control" disabled @bind="currentSelection.Nivel1" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Nivel 2</label>
                        <input class="form-control" disabled @bind="currentSelection.Nivel2" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Nivel 3</label>
                        <input class="form-control" @bind="nivel3Model.Nivel3" disabled="@isEditingNivel3" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Descripción</label>
                        <input class="form-control" @bind="nivel3Model.Descripcion" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseNivel3Modal">Cancelar</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveNivel3">Guardar</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
  [Inject] public ICuentasContablesRepository CuentasRepository { get; set; } = default!;
  [Inject] public IUserRfcState RfcState { get; set; } = default!;
  [Parameter] public string? SelectedRfc { get; set; }
  [Parameter] public EventCallback<string?> SelectedRfcChanged { get; set; }
  [Parameter] public CuentaContableSelection? Selection { get; set; }
  [Parameter] public EventCallback<CuentaContableSelection?> SelectionChanged { get; set; }
  [Parameter] public EventCallback SearchRequested { get; set; }
  [Parameter] public EventCallback<string?> ErrorChanged { get; set; }

  private string? currentRfc;
  private string? lastLoadedRfc;
    private CuentaContableSelection currentSelection = new();
  private int? directAccountId;
  private string nivel1Term = string.Empty;
  private string nivel2Term = string.Empty;
  private string nivel3Term = string.Empty;
  private readonly List<CuentasContablesDto> nivel1Results = new();
  private readonly List<CuentasContablesDto> nivel2Results = new();
  private readonly List<CuentasContablesDto> nivel3Results = new();
  private bool showNivel3Modal = false;
  private bool isEditingNivel3 = false;
  private CuentasContablesDto nivel3Model = new();
  private bool CanSearchNivel2 => currentSelection?.HasNivel1 == true && !string.IsNullOrWhiteSpace(currentRfc);
  private bool CanSearchNivel3 => currentSelection?.HasNivel2 == true && !string.IsNullOrWhiteSpace(currentRfc);
  private bool CanBuscar => currentSelection?.HasNivel2 == true && !string.IsNullOrWhiteSpace(currentRfc);

  public bool RequiresDirectAccountResolution => directAccountId.HasValue && !(currentSelection?.HasNivel3 ?? false);

  protected override async Task OnParametersSetAsync()
    {
      if (!EqualsReference(currentSelection, Selection))
      {
        currentSelection = Selection ?? new CuentaContableSelection();
        SyncSelectionState();
      }

    if (!string.Equals(currentRfc, SelectedRfc, StringComparison.OrdinalIgnoreCase))
    {
      currentRfc = SelectedRfc;
    }

    if (!string.Equals(lastLoadedRfc, currentRfc, StringComparison.OrdinalIgnoreCase))
    {
      lastLoadedRfc = currentRfc;
      nivel1Results.Clear();
      nivel2Results.Clear();
      nivel3Results.Clear();

      var shouldLoadDefaults = !(currentSelection?.HasNivel1 ?? false);

      if (shouldLoadDefaults && !string.IsNullOrWhiteSpace(currentRfc))
      {
        await SearchNivel1Async(loadDefaults: true);
      }
    }
  }

  public Task<bool> TryResolveDirectAccountAsync() => ResolveDirectAccountAsync();

  private static bool EqualsReference(CuentaContableSelection? left, CuentaContableSelection? right)
    => ReferenceEquals(left, right) || (left is null && right is null);

  private void SyncSelectionState()
  {
    nivel1Results.Clear();
    nivel2Results.Clear();
    nivel3Results.Clear();

    if (currentSelection is null)
    {
      nivel1Term = string.Empty;
      nivel2Term = string.Empty;
      nivel3Term = string.Empty;
      directAccountId = null;
      return;
    }

    nivel1Term = currentSelection.Nivel1 ?? string.Empty;
    nivel2Term = currentSelection.Nivel2 ?? string.Empty;
    nivel3Term = currentSelection.Nivel3 ?? string.Empty;
    directAccountId = currentSelection.Id;
  }

  private async Task OnDirectAccountKeyDown(KeyboardEventArgs args)
  {
    if (args.Key != "Enter")
    {
      return;
    }

    var resolved = await ResolveDirectAccountAsync();
    if (resolved && CanBuscar)
    {
      await SearchRequested.InvokeAsync();
    }
  }

  private async Task OnNivel1KeyDown(KeyboardEventArgs args)
  {
    if (args.Key != "Enter")
    {
      return;
    }

    if (CanBuscar && Nivel1TermMatchesSelection())
    {
      await SearchRequested.InvokeAsync();
    }
    else
    {
      await SearchNivel1Async(loadDefaults: string.IsNullOrWhiteSpace(nivel1Term));
    }
  }

  private async Task OnNivel2KeyDown(KeyboardEventArgs args)
  {
    if (args.Key != "Enter")
    {
      return;
    }

    if (!CanSearchNivel2)
    {
      await SearchNivel1Async(loadDefaults: string.IsNullOrWhiteSpace(nivel1Term));
      return;
    }

    if (CanBuscar && Nivel2TermMatchesSelection())
    {
      await SearchRequested.InvokeAsync();
    }
    else
    {
      await SearchNivel2Async(loadDefaults: string.IsNullOrWhiteSpace(nivel2Term));
    }
  }

    private async Task OnNivel3KeyDown(KeyboardEventArgs args)
    {
        // Some keyboards/browsers can report NumpadEnter via Code, so this is a safe add.
        var isEnter = args.Key == "Enter" || args.Code == "NumpadEnter";
        if (!isEnter)
            return;

        if (!CanSearchNivel3)
        {
            if (!CanSearchNivel2)
                await SearchNivel1Async(loadDefaults: string.IsNullOrWhiteSpace(nivel1Term));
            else
                await SearchNivel2Async(loadDefaults: string.IsNullOrWhiteSpace(nivel2Term));

            return;
        }

        if (CanBuscar && Nivel3TermMatchesSelection())
            await SearchRequested.InvokeAsync();
        else
            await SearchNivel3Async(loadDefaults: string.IsNullOrWhiteSpace(nivel3Term));
    }


  private async Task SearchNivel1Async(bool loadDefaults = false)
  {
    nivel1Results.Clear();
    nivel2Results.Clear();
    nivel3Results.Clear();

    if (string.IsNullOrWhiteSpace(currentRfc))
    {
      return;
    }

    var term = loadDefaults ? string.Empty : (nivel1Term?.Trim() ?? string.Empty);
    if (!loadDefaults && string.IsNullOrWhiteSpace(term))
    {
      return;
    }

    try
    {
      var results = await CuentasRepository.SearchNivel1Async(currentRfc, term, loadDefaults ? 25 : 200);
      nivel1Results.AddRange(results);
    }
    catch (Exception ex)
    {
      await NotifyErrorAsync("No se pudo buscar cuentas de nivel 1", ex);
    }
  }

  private async Task SearchNivel2Async(bool loadDefaults = false)
  {
    nivel2Results.Clear();
    nivel3Results.Clear();

    if (!CanSearchNivel2 || string.IsNullOrWhiteSpace(currentSelection?.Nivel1))
    {
      return;
    }

    var term = loadDefaults ? string.Empty : (nivel2Term?.Trim() ?? string.Empty);
    if (!loadDefaults && string.IsNullOrWhiteSpace(term))
    {
      return;
    }

    try
    {
      var results = await CuentasRepository.SearchNivel2Async(currentRfc!, currentSelection!.Nivel1!, term);
      nivel2Results.AddRange(results);
    }
    catch (Exception ex)
    {
      await NotifyErrorAsync("No se pudo buscar cuentas de nivel 2", ex);
    }
  }

  private async Task SearchNivel3Async(bool loadDefaults = false)
  {
    nivel3Results.Clear();

    if (!CanSearchNivel3 || string.IsNullOrWhiteSpace(currentSelection?.Nivel1) || string.IsNullOrWhiteSpace(currentSelection?.Nivel2))
    {
      return;
    }

    var term = loadDefaults ? string.Empty : (nivel3Term?.Trim() ?? string.Empty);
    if (!loadDefaults && string.IsNullOrWhiteSpace(term))
    {
      return;
    }

    try
    {
      var results = await CuentasRepository.SearchNivel3Async(currentRfc!, currentSelection!.Nivel1!, currentSelection!.Nivel2!, term);
      nivel3Results.AddRange(results);
    }
    catch (Exception ex)
    {
      await NotifyErrorAsync("No se pudo buscar cuentas de nivel 3", ex);
    }
  }

  private async Task SelectNivel1Async(CuentasContablesDto dto)
  {
    await SetRfcAsync(dto.Rfc);

    currentSelection = new CuentaContableSelection
    {
      Id = dto.Id,
      Rfc = dto.Rfc,
      Nivel1 = dto.Nivel1,
      Nivel2 = null,
      Nivel3 = null,
      Descripcion = dto.Descripcion
    };

    await SelectionChanged.InvokeAsync(currentSelection);

    directAccountId = dto.Id;
    nivel1Term = dto.Nivel1;
    nivel2Term = string.Empty;
    nivel3Term = string.Empty;
    nivel1Results.Clear();
    nivel2Results.Clear();
    nivel3Results.Clear();

    if (CanSearchNivel2)
    {
      await SearchNivel2Async(loadDefaults: true);
    }
  }

  private async Task SelectNivel2Async(CuentasContablesDto dto)
  {
    currentSelection = new CuentaContableSelection
    {
      Id = dto.Id,
      Rfc = dto.Rfc,
      Nivel1 = dto.Nivel1,
      Nivel2 = NormalizeTwoDigits(dto.Nivel2),
      Nivel3 = null,
      Descripcion = dto.Descripcion
    };

    await SelectionChanged.InvokeAsync(currentSelection);

    directAccountId = dto.Id;
    nivel2Term = currentSelection.Nivel2 ?? string.Empty;
    nivel3Term = string.Empty;
    nivel2Results.Clear();
    nivel3Results.Clear();

    if (CanSearchNivel3)
    {
      await SearchNivel3Async(loadDefaults: true);
    }
  }

  private async Task SelectNivel3(CuentasContablesDto dto)
  {
    currentSelection = new CuentaContableSelection
    {
      Id = dto.Id,
      Rfc = dto.Rfc,
      Nivel1 = dto.Nivel1,
      Nivel2 = NormalizeTwoDigits(dto.Nivel2),
      Nivel3 = NormalizeTwoDigits(dto.Nivel3),
      Descripcion = dto.Descripcion
    };

    await SelectionChanged.InvokeAsync(currentSelection);

    directAccountId = dto.Id;
    nivel3Term = currentSelection.Nivel3 ?? string.Empty;
    nivel3Results.Clear();
  }

  private async Task<bool> ResolveDirectAccountAsync()
  {
    if (directAccountId is null)
    {
      return false;
    }

    try
    {
      var account = await CuentasRepository.GetByIdAsync(directAccountId.Value);
      if (account is null)
      {
        await NotifyErrorAsync("No se encontró la cuenta contable.");
        return false;
      }

      await ApplyAccountAsync(account);
      return true;
    }
    catch (Exception ex)
    {
      await NotifyErrorAsync("No se pudo resolver la cuenta contable", ex);
      return false;
    }
  }

  private async Task ApplyAccountAsync(CuentasContablesDto account)
  {
    await SetRfcAsync(account.Rfc);

    currentSelection = new CuentaContableSelection
    {
      Id = account.Id,
      Rfc = account.Rfc,
      Nivel1 = account.Nivel1,
      Nivel2 = NormalizeTwoDigits(account.Nivel2),
      Nivel3 = NormalizeTwoDigits(account.Nivel3),
      Descripcion = account.Descripcion
    };

    await SelectionChanged.InvokeAsync(currentSelection);

    nivel1Term = currentSelection.Nivel1 ?? string.Empty;
    nivel2Term = currentSelection.Nivel2 ?? string.Empty;
    nivel3Term = currentSelection.Nivel3 ?? string.Empty;
    nivel1Results.Clear();
    nivel2Results.Clear();
    nivel3Results.Clear();
  }

  private async Task SetRfcAsync(string rfc)
  {
    if (string.IsNullOrWhiteSpace(rfc))
    {
      return;
    }

    if (!string.Equals(currentRfc, rfc, StringComparison.OrdinalIgnoreCase))
    {
      currentRfc = rfc;
      if (SelectedRfcChanged.HasDelegate)
      {
        await SelectedRfcChanged.InvokeAsync(rfc);
      }
    }
  }

  private bool Nivel1TermMatchesSelection()
    => !string.IsNullOrWhiteSpace(currentSelection?.Nivel1)
       && string.Equals((nivel1Term ?? string.Empty).Trim(), currentSelection!.Nivel1!.Trim(), StringComparison.OrdinalIgnoreCase);

  private bool Nivel2TermMatchesSelection()
    => !string.IsNullOrWhiteSpace(currentSelection?.Nivel2)
       && string.Equals(NormalizeTwoDigits(nivel2Term), currentSelection!.Nivel2!, StringComparison.OrdinalIgnoreCase);

  private bool Nivel3TermMatchesSelection()
    => !string.IsNullOrWhiteSpace(currentSelection?.Nivel3)
       && string.Equals(NormalizeTwoDigits(nivel3Term), currentSelection!.Nivel3!, StringComparison.OrdinalIgnoreCase);

  private async Task NotifyErrorAsync(string message, Exception? exception = null)
  {
    if (exception is not null)
    {
      Console.Error.WriteLine($"[CuentaContablePicker] {message}: {exception}");
    }
    else
    {
      Console.Error.WriteLine($"[CuentaContablePicker] {message}");
    }

    if (ErrorChanged.HasDelegate)
    {
      await ErrorChanged.InvokeAsync(message);
    }
  }

  private static string NormalizeTwoDigits(string value)
  {
    var trimmed = value?.Trim() ?? string.Empty;
    if (trimmed.Length == 1 && char.IsDigit(trimmed[0]))
    {
      return trimmed.PadLeft(2, '0');
    }

    return trimmed;
  }

    private void ShowCreateNivel3Modal()
    {
        isEditingNivel3 = false;
        nivel3Model = new CuentasContablesDto();
        showNivel3Modal = true;
    }

    private void ShowEditNivel3Modal(CuentasContablesDto item)
    {
        isEditingNivel3 = true;
        nivel3Model = item with { };
        showNivel3Modal = true;
    }

    private void CloseNivel3Modal()
    {
        showNivel3Modal = false;
    }

    private async Task SaveNivel3()
    {
        try
        {
            if (isEditingNivel3)
            {
                await CuentasRepository.UpdateNivel3DescripcionAsync(nivel3Model.Id, nivel3Model.Descripcion);
            }
            else
            {
              if (string.IsNullOrWhiteSpace(currentRfc)
                  || string.IsNullOrWhiteSpace(currentSelection.Nivel1)
                  || string.IsNullOrWhiteSpace(currentSelection.Nivel2))
              {
                  await NotifyErrorAsync("Selecciona una cuenta de nivel 1 y nivel 2 antes de crear un nivel 3.");
                  return;
              }

              var newId = await CuentasRepository.CreateNivel3Async(
                  currentRfc,
                  currentSelection.Nivel1!,
                  currentSelection.Nivel2!,
                  nivel3Model.Nivel3,
                  nivel3Model.Descripcion);

                if (newId == -1)
                {
                    await NotifyErrorAsync("El Nivel 3 ya existe.");
                    return;
                }
            }

            CloseNivel3Modal();
            await SearchNivel3Async(loadDefaults: true);
        }
        catch (Exception ex)
        {
            await NotifyErrorAsync("No se pudo guardar el nivel 3.", ex);
        }
    }
}
