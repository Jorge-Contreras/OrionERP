@page
@{
    ViewData["Title"] = "Correo enviado";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-7 col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h1 class="h3 mb-3">Revisa tu correo</h1>
                    <p class="text-muted mb-4">
                        Si existe una cuenta asociada al correo capturado, enviamos un enlace para restablecer la contrasena.
                    </p>

                    <div class="d-grid">
                        <a class="btn btn-primary" href="/Identity/Account/Login">Volver al inicio de sesión</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
