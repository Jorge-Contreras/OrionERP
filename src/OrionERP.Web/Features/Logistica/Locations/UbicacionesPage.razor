@page "/logistica/ubicaciones"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@attribute [Authorize(Roles = "Administrador,Logistica")]

<PageTitle>Logística · Ubicaciones e inventario</PageTitle>

<div class="ubicaciones-page">
    <header class="ubicaciones-hero">
        <div>
            <span class="ubicaciones-eyebrow">Logística</span>
            <h1>@(IsManagementMode ? "Administrar ubicaciones" : "Inventario por ubicación")</h1>
            <p>@(IsManagementMode
                ? "Crea y organiza los espacios donde se guarda o utiliza material."
                : "Elige dónde vas a trabajar y revisa los materiales de esa ubicación.")</p>
        </div>
        @if (IsInventoryMode)
        {
            <button class="btn btn-light ubicaciones-mode-button" type="button" @onclick="AbrirAdministracion">
                <span class="oi oi-cog" aria-hidden="true"></span>
                Administrar ubicaciones
            </button>
        }
        else
        {
            <button class="btn btn-light ubicaciones-mode-button" type="button" @onclick="VolverAInventarioAsync">
                <span class="oi oi-arrow-left" aria-hidden="true"></span>
                Volver al inventario
            </button>
        }
    </header>

    @if (IsRestoringSelection)
    {
        <div class="ubicaciones-restoring" role="status" aria-live="polite">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            Recuperando tu última ubicación…
        </div>
    }

    @if (IsInventoryMode)
    {
        <main class="ubicaciones-inventory-workspace">
            <section class="ubicaciones-context-card" aria-labelledby="ubicaciones-context-title">
                <div class="ubicaciones-section-heading">
                    <div>
                        <span class="ubicaciones-section-kicker">Primero</span>
                        <h2 id="ubicaciones-context-title">¿Dónde vas a trabajar?</h2>
                        <p>Selecciona la suite y después la ubicación que deseas consultar.</p>
                    </div>
                    @if (SelectedLocation is not null)
                    {
                        <span class="ubicaciones-ready-badge"><span class="oi oi-check" aria-hidden="true"></span> Ubicación lista</span>
                    }
                </div>

                <div class="ubicaciones-context-controls">
                    <label class="ubicaciones-step-field">
                        <span class="ubicaciones-step-number">1</span>
                        <span class="ubicaciones-step-copy"><strong>Suite</strong><small>Elige el espacio general.</small></span>
                        <select class="form-select" value="@SelectedRoomId" @onchange="OnRoomChangedAsync" disabled="@IsLoadingLocations">
                            <option value="">Selecciona una suite</option>
                            @foreach (var room in RoomOptions)
                            {
                                <option value="@room.Id">@room.Name</option>
                            }
                        </select>
                    </label>

                    <label class="ubicaciones-step-field">
                        <span class="ubicaciones-step-number">2</span>
                        <span class="ubicaciones-step-copy"><strong>Ubicación</strong><small>Elige el lugar exacto.</small></span>
                        <select class="form-select" value="@SelectedLocationId" @onchange="OnLocationChangedAsync" disabled="@(!SelectedRoomId.HasValue || IsLoadingLocations)">
                            <option value="">Selecciona una ubicación</option>
                            @if (OperationalLocations.Count > 0)
                            {
                                <optgroup label="Listas para inventario">
                                    @foreach (var location in OperationalLocations)
                                    {
                                        <option value="@location.Id">@GetLocationOptionLabel(location)</option>
                                    }
                                </optgroup>
                            }
                            @if (NonOperationalLocations.Count > 0)
                            {
                                <optgroup label="Inactivas o no habilitadas">
                                    @foreach (var location in NonOperationalLocations)
                                    {
                                        <option value="@location.Id">@GetLocationOptionLabel(location) · @GetLocationAvailabilityText(location)</option>
                                    }
                                </optgroup>
                            }
                        </select>
                    </label>
                </div>

                @if (IsLoadingLocations)
                {
                    <div class="ubicaciones-inline-status" role="status">Cargando ubicaciones…</div>
                }
                else if (SelectedRoomId.HasValue && Locations.Count == 0)
                {
                    <div class="ubicaciones-empty-state">
                        <span class="oi oi-map-marker" aria-hidden="true"></span>
                        <div><strong>Esta suite todavía no tiene ubicaciones</strong><p>Abre “Administrar ubicaciones” para crear la primera.</p></div>
                    </div>
                }
                else if (SelectedLocation is null)
                {
                    <div class="ubicaciones-context-help">
                        <span class="oi oi-info" aria-hidden="true"></span>
                        <span>@(SelectedRoomId.HasValue ? "Ahora elige una ubicación para cargar su inventario." : "Comienza seleccionando una suite.")</span>
                    </div>
                }
                else
                {
                    <div class="ubicaciones-active-context" aria-label="Ubicación seleccionada">
                        <div class="ubicaciones-active-icon"><span class="oi oi-map-marker" aria-hidden="true"></span></div>
                        <div class="ubicaciones-active-main">
                            <span>Estás trabajando en</span>
                            <strong>@SelectedLocation.LocationName</strong>
                            <small>@(string.IsNullOrWhiteSpace(SelectedLocation.LocationCode) ? $"LOC-{SelectedLocation.Id}" : SelectedLocation.LocationCode) · @SelectedRoomName</small>
                        </div>
                        <div class="ubicaciones-active-facts">
                            <span><small>Tipo</small><strong>@GetLocationTypeLabel(SelectedLocation.LocationType)</strong></span>
                            <span><small>Materiales</small><strong>@SelectedLocation.MaterialCount</strong></span>
                            <span class="@(CanAddMaterialToSelectedLocation ? "is-operational" : "is-warning")"><small>Estado</small><strong>@GetLocationAvailabilityText(SelectedLocation)</strong></span>
                        </div>
                    </div>
                }
            </section>

            <section class="ubicaciones-inventory-card" aria-labelledby="ubicaciones-inventory-title">
                <div class="ubicaciones-section-heading ubicaciones-inventory-heading">
                    <div>
                        <span class="ubicaciones-section-kicker">Después</span>
                        <h2 id="ubicaciones-inventory-title">Revisa el inventario</h2>
                        <p>@(SelectedLocation is null ? "Selecciona una ubicación para comenzar." : $"Materiales disponibles en {SelectedLocation.LocationName}.")</p>
                    </div>
                    <button class="btn btn-primary ubicaciones-primary-action" type="button" @onclick="AbrirAgregarMaterialDialogAsync" disabled="@(!CanAddMaterialToSelectedLocation)">
                        <span class="oi oi-plus" aria-hidden="true"></span>
                        Agregar material
                    </button>
                </div>

                @if (SelectedLocation is not null && !CanAddMaterialToSelectedLocation)
                {
                    <div class="ubicaciones-operation-warning" role="note">
                        <span class="oi oi-warning" aria-hidden="true"></span>
                        <div>
                            <strong>No se pueden agregar materiales aquí</strong>
                            <p>@(SelectedLocation.IsActive
                                ? "Esta ubicación no está habilitada para inventario. Puedes consultar sus registros existentes."
                                : "Esta ubicación está inactiva. Puedes consultar sus registros existentes.")</p>
                        </div>
                    </div>
                }

                @if (!SelectedLocationId.HasValue)
                {
                    <div class="ubicaciones-empty-state ubicaciones-empty-state-large">
                        <span class="oi oi-box" aria-hidden="true"></span>
                        <div><strong>Aquí aparecerá el inventario</strong><p>Completa los dos pasos de arriba para ver materiales, cantidades y alertas.</p></div>
                    </div>
                }
                else
                {
                    <div class="ubicaciones-stock-toolbar">
                        <label class="ubicaciones-search-box">
                            <span class="oi oi-magnifying-glass" aria-hidden="true"></span>
                            <span class="visually-hidden">Buscar material</span>
                            <input type="search" placeholder="Nombre, código o barras" @bind="StockFilter.SearchText" @bind:event="oninput" @onkeyup="OnStockSearchKeyUpAsync" />
                        </label>
                        <button class="btn btn-primary" type="button" @onclick="BuscarStockAsync" disabled="@IsStockBusy">Buscar</button>
                        <button class="btn btn-outline-secondary" type="button" @onclick="LimpiarFiltrosStockAsync" disabled="@IsStockBusy">Limpiar</button>
                        <button class="btn btn-outline-secondary ubicaciones-refresh-button" type="button" @onclick="BuscarStockAsync" disabled="@IsStockBusy" title="Actualizar inventario">
                            <span class="oi oi-reload" aria-hidden="true"></span><span>Actualizar</span>
                        </button>
                    </div>

                    <div class="ubicaciones-filter-row">
                        <span class="ubicaciones-filter-label">Mostrar:</span>
                        <button class="ubicaciones-filter-chip @(StockFilter.LowStockOnly ? "is-active" : null)" type="button" aria-pressed="@StockFilter.LowStockOnly" @onclick="ToggleLowStockFilterAsync" disabled="@IsStockBusy">
                            <span class="oi oi-warning" aria-hidden="true"></span> Bajo mínimo
                        </button>
                        <button class="ubicaciones-filter-chip @(StockFilter.CountDueOnly ? "is-active" : null)" type="button" aria-pressed="@StockFilter.CountDueOnly" @onclick="ToggleCountDueFilterAsync" disabled="@IsStockBusy">
                            <span class="oi oi-clock" aria-hidden="true"></span> Conteo vencido
                        </button>
                        <details class="ubicaciones-more-filters">
                            <summary>Más filtros</summary>
                            <div>
                                <label><input type="checkbox" checked="@StockFilter.IncludeZeroBalances" @onchange="OnIncludeZeroBalancesChangedAsync" disabled="@IsStockBusy" /> Incluir cantidades en cero</label>
                                <label><input type="checkbox" checked="@StockFilter.IncludeRemoved" @onchange="OnIncludeRemovedChangedAsync" disabled="@IsStockBusy" /> Mostrar materiales eliminados</label>
                            </div>
                        </details>
                    </div>

                    <div class="ubicaciones-results" aria-live="polite">
                        @if (IsLoadingStock && StockRows.Count == 0)
                        {
                            <div class="ubicaciones-loading-state"><span class="spinner-border" aria-hidden="true"></span><strong>Cargando inventario…</strong></div>
                        }
                        else if (HasExecutedStockSearch && StockRows.Count == 0)
                        {
                            <div class="ubicaciones-empty-state ubicaciones-empty-state-large">
                                <span class="oi oi-magnifying-glass" aria-hidden="true"></span>
                                <div><strong>No encontramos materiales</strong><p>Prueba otra búsqueda o limpia los filtros actuales.</p></div>
                            </div>
                        }
                        else if (StockRows.Count > 0)
                        {
                            <div class="ubicaciones-stock-table-wrap">
                                <table class="ubicaciones-stock-table">
                                    <thead>
                                        <tr><th>Material</th><th class="text-end">Cantidad</th><th class="text-end">Mínimo</th><th class="text-end">Máximo</th><th>Estado</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in StockRows)
                                        {
                                            var thumbnailDataUrl = GetMaterialThumbnailDataUrl(item.MaterialId);
                                            var materialTitle = string.IsNullOrWhiteSpace(item.MaterialDescription) ? item.MaterialCode : item.MaterialDescription;
                                            var showMaterialCode = !string.IsNullOrWhiteSpace(item.MaterialCode) && !string.Equals(item.MaterialCode, materialTitle, StringComparison.OrdinalIgnoreCase);
                                            <tr class="@GetStockRowClass(item)">
                                                <td>
                                                    <div class="ubicaciones-table-material">
                                                        @if (thumbnailDataUrl is not null)
                                                        {
                                                            <button class="ubicaciones-line-image-button" type="button" title="Ver imagen" aria-label="Ver imagen de @materialTitle" @onclick="() => AbrirImagenMaterialAsync(item)">
                                                                <img src="@thumbnailDataUrl" alt="" class="ubicaciones-line-image" />
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <div class="ubicaciones-line-image-placeholder">Sin foto</div>
                                                        }
                                                        <button class="ubicaciones-material-name-button" type="button" @onclick="() => SeleccionarStockAsync(item)">
                                                            <strong>@materialTitle</strong>
                                                            @if (showMaterialCode) { <small>@item.MaterialCode</small> }
                                                            <span>Ver detalle <span aria-hidden="true">→</span></span>
                                                        </button>
                                                    </div>
                                                </td>
                                                <td class="text-end"><strong>@item.Quantity.ToString("N2")</strong><small>@item.BaseUnitName</small></td>
                                                <td class="text-end">@FormatThresholdQuantity(item.MinQuantity)</td>
                                                <td class="text-end">@FormatThresholdQuantity(item.MaxQuantity)</td>
                                                <td>
                                                    <div class="ubicaciones-alert-stack">
                                                        @if (item.IsRemoved) { <span class="ubicaciones-status is-muted">Eliminado</span> }
                                                        @if (item.IsLowStock) { <span class="ubicaciones-status is-danger">Bajo mínimo</span> }
                                                        @if (item.IsCountDue) { <span class="ubicaciones-status is-warning">Conteo vencido</span> }
                                                        @if (!item.IsRemoved && !item.IsLowStock && !item.IsCountDue) { <span class="ubicaciones-status is-ok">En orden</span> }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <div class="ubicaciones-stock-cards">
                                @foreach (var item in StockRows)
                                {
                                    var thumbnailDataUrl = GetMaterialThumbnailDataUrl(item.MaterialId);
                                    var materialTitle = string.IsNullOrWhiteSpace(item.MaterialDescription) ? item.MaterialCode : item.MaterialDescription;
                                    var showMaterialCode = !string.IsNullOrWhiteSpace(item.MaterialCode) && !string.Equals(item.MaterialCode, materialTitle, StringComparison.OrdinalIgnoreCase);
                                    <article class="@GetStockCardClass(item)">
                                        <div class="ubicaciones-stock-card-heading">
                                            @if (thumbnailDataUrl is not null)
                                            {
                                                <button class="ubicaciones-line-image-button" type="button" title="Ver imagen" aria-label="Ver imagen de @materialTitle" @onclick="() => AbrirImagenMaterialAsync(item)">
                                                    <img src="@thumbnailDataUrl" alt="" class="ubicaciones-line-image" />
                                                </button>
                                            }
                                            else
                                            {
                                                <div class="ubicaciones-line-image-placeholder">Sin foto</div>
                                            }
                                            <div><strong>@materialTitle</strong>@if (showMaterialCode) { <small>@item.MaterialCode</small> }</div>
                                            <div class="ubicaciones-stock-card-quantity"><strong>@item.Quantity.ToString("N2")</strong><small>@item.BaseUnitName</small></div>
                                        </div>
                                        <div class="ubicaciones-stock-card-limits">
                                            <span><small>Mínimo</small><strong>@FormatThresholdQuantity(item.MinQuantity)</strong></span>
                                            <span><small>Máximo</small><strong>@FormatThresholdQuantity(item.MaxQuantity)</strong></span>
                                        </div>
                                        <div class="ubicaciones-stock-card-footer">
                                            <div class="ubicaciones-alert-stack">
                                                @if (item.IsRemoved) { <span class="ubicaciones-status is-muted">Eliminado</span> }
                                                @if (item.IsLowStock) { <span class="ubicaciones-status is-danger">Bajo mínimo</span> }
                                                @if (item.IsCountDue) { <span class="ubicaciones-status is-warning">Conteo</span> }
                                                @if (!item.IsRemoved && !item.IsLowStock && !item.IsCountDue) { <span class="ubicaciones-status is-ok">En orden</span> }
                                            </div>
                                            <button type="button" @onclick="() => SeleccionarStockAsync(item)">Ver detalle <span aria-hidden="true">→</span></button>
                                        </div>
                                    </article>
                                }
                            </div>
                        }
                    </div>

                    @if (HasExecutedStockSearch && StockRows.Count > 0)
                    {
                        <div class="ubicaciones-results-footer">
                            <span>Mostrando @StockRows.Count materiales.</span>
                            @if (HasMoreStockRows)
                            {
                                <button class="btn btn-outline-primary" type="button" @onclick="CargarMasStockAsync" disabled="@IsStockBusy">
                                    @(IsLoadingMoreStock ? "Cargando…" : $"Cargar {PageSize} más")
                                </button>
                            }
                        </div>
                    }
                }
            </section>
        </main>
    }
    else
    {
        <main class="ubicaciones-management-workspace">
            <section class="ubicaciones-management-toolbar">
                <label>
                    <span>Suite que deseas organizar</span>
                    <select class="form-select" value="@SelectedRoomId" @onchange="OnRoomChangedAsync" disabled="@IsLoadingLocations">
                        <option value="">Selecciona una suite</option>
                        @foreach (var room in RoomOptions)
                        {
                            <option value="@room.Id">@room.Name</option>
                        }
                    </select>
                </label>
                <button class="btn btn-primary" type="button" @onclick="NuevaUbicacionAsync" disabled="@(!SelectedRoomId.HasValue || IsLoadingLocations)">
                    <span class="oi oi-plus" aria-hidden="true"></span> Nueva ubicación
                </button>
            </section>

            @if (!SelectedRoomId.HasValue)
            {
                <div class="ubicaciones-empty-state ubicaciones-empty-state-large">
                    <span class="oi oi-map-marker" aria-hidden="true"></span>
                    <div><strong>Selecciona una suite</strong><p>Después podrás revisar, crear o modificar sus ubicaciones.</p></div>
                </div>
            }
            else
            {
                <div class="ubicaciones-management-grid">
                    <section class="ubicaciones-location-library" aria-labelledby="ubicaciones-location-library-title">
                        <div class="ubicaciones-section-heading">
                            <div><span class="ubicaciones-section-kicker">@SelectedRoomName</span><h2 id="ubicaciones-location-library-title">Ubicaciones</h2><p>@Locations.Count registradas · @OperationalLocations.Count listas para inventario</p></div>
                        </div>
                        @if (IsLoadingLocations)
                        {
                            <div class="ubicaciones-loading-state"><span class="spinner-border" aria-hidden="true"></span><strong>Cargando ubicaciones…</strong></div>
                        }
                        else if (Locations.Count == 0)
                        {
                            <div class="ubicaciones-empty-state"><span class="oi oi-plus" aria-hidden="true"></span><div><strong>Aún no hay ubicaciones</strong><p>Usa “Nueva ubicación” para crear la primera.</p></div></div>
                        }
                        else
                        {
                            <div class="ubicaciones-location-cards">
                                @foreach (var item in Locations.OrderBy(item => item.LocationName, StringComparer.OrdinalIgnoreCase))
                                {
                                    <article class="@GetLocationCardClass(item, ManagementLocationId)">
                                        <div class="ubicaciones-location-card-main">
                                            <span class="ubicaciones-location-card-icon"><span class="oi oi-map-marker" aria-hidden="true"></span></span>
                                            <div>
                                                <strong>@item.LocationName</strong>
                                                <small>@(string.IsNullOrWhiteSpace(item.LocationCode) ? $"LOC-{item.Id}" : item.LocationCode) · @GetLocationTypeLabel(item.LocationType)</small>
                                                @if (!string.IsNullOrWhiteSpace(item.ParentLocationName)) { <small>Dentro de @item.ParentLocationName</small> }
                                            </div>
                                            <span class="ubicaciones-status @(item.IsActive && item.IsInventoryEnabled ? "is-ok" : "is-muted")">@GetLocationAvailabilityText(item)</span>
                                        </div>
                                        <div class="ubicaciones-location-card-meta"><span><strong>@item.MaterialCount</strong> materiales</span><span><strong>@item.ChildCount</strong> dependientes</span></div>
                                        <div class="ubicaciones-location-card-actions">
                                            <button class="btn btn-outline-secondary" type="button" @onclick="() => EditarUbicacionAsync(item.Id)">Editar</button>
                                            <button class="btn btn-outline-primary" type="button" @onclick="() => VerInventarioDeUbicacionAsync(item.Id)">Ver inventario</button>
                                        </div>
                                    </article>
                                }
                            </div>
                        }
                    </section>

                    @if (ShowLocationEditor)
                    {
                        <section class="ubicaciones-location-editor" role="dialog" aria-modal="true" aria-labelledby="ubicaciones-editor-title">
                            <header>
                                <div><span class="ubicaciones-section-kicker">@(LocationEditor.Id.HasValue ? "Editar" : "Nueva")</span><h2 id="ubicaciones-editor-title">@(LocationEditor.Id.HasValue ? LocationEditor.LocationName : "Nueva ubicación")</h2><p>Suite: @SelectedRoomName</p></div>
                                <button type="button" @onclick="CerrarEditorUbicacionAsync" aria-label="Cerrar editor"><span class="oi oi-x" aria-hidden="true"></span></button>
                            </header>
                            <EditForm EditContext="LocationEditContext" OnValidSubmit="GuardarUbicacionAsync">
                                <DataAnnotationsValidator />
                                <ValidationSummary class="ubicaciones-validation" />
                                <div class="ubicaciones-editor-fields">
                                    <label><span>Nombre <b>*</b></span><InputText class="form-control" @bind-Value="LocationEditor.LocationName" placeholder="Ej. Clóset de blancos" /></label>
                                    <label><span>Código</span><InputText class="form-control" @bind-Value="LocationEditor.LocationCode" placeholder="Se genera si lo dejas vacío" /><small>Úsalo solo si tu equipo ya identifica esta ubicación por código.</small></label>
                                    <label><span>Tipo</span><InputSelect class="form-select" @bind-Value="LocationEditor.LocationType">@foreach (var type in LocationTypes) { <option value="@type">@GetLocationTypeLabel(type)</option> }</InputSelect></label>
                                    <label><span>Ubicación superior</span><InputSelect class="form-select" @bind-Value="LocationEditor.ParentLocationId"><option value="">Ninguna</option>@foreach (var option in ParentLocationOptions) { <option value="@option.Id">@option.LocationName</option> }</InputSelect><small>Selecciona otra ubicación solo cuando esta se encuentre dentro de ella.</small></label>
                                    <label class="ubicaciones-editor-description"><span>Descripción</span><InputTextArea class="form-control" rows="3" @bind-Value="LocationEditor.Description" placeholder="Indicaciones sencillas para encontrarla" /></label>
                                    <label class="ubicaciones-switch-card"><InputCheckbox @bind-Value="LocationEditor.IsInventoryEnabled" /><span><strong>Controlar inventario aquí</strong><small>Permite agregar materiales y controlar cantidades.</small></span></label>
                                    <label class="ubicaciones-switch-card"><InputCheckbox @bind-Value="LocationEditor.IsActive" /><span><strong>Ubicación activa</strong><small>Desactívala únicamente cuando ya no se utilice.</small></span></label>
                                </div>
                                <footer>
                                    <button class="btn btn-outline-secondary" type="button" @onclick="RestablecerUbicacionAsync" disabled="@IsSavingLocation">Restablecer</button>
                                    <button class="btn btn-primary" type="submit" disabled="@IsSavingLocation">@(IsSavingLocation ? "Guardando…" : "Guardar ubicación")</button>
                                </footer>
                            </EditForm>
                        </section>
                    }
                    else
                    {
                        <aside class="ubicaciones-editor-placeholder">
                            <span class="oi oi-pencil" aria-hidden="true"></span><h2>Selecciona una ubicación</h2><p>Usa “Editar” en una tarjeta o crea una ubicación nueva.</p>
                        </aside>
                    }
                </div>
            }
        </main>
    }
</div>

@if (SelectedStock is not null)
{
    <div class="ubicaciones-detail-backdrop" role="dialog" aria-modal="true" aria-labelledby="ubicaciones-detail-title">
        <aside class="ubicaciones-detail-panel">
            <header>
                <div><span class="ubicaciones-section-kicker">Ficha del material</span><h2 id="ubicaciones-detail-title">@(string.IsNullOrWhiteSpace(SelectedStock.MaterialDescription) ? SelectedStock.MaterialCode : SelectedStock.MaterialDescription)</h2><p>@SelectedStock.LocationName · @SelectedStock.MaterialCode</p></div>
                <button type="button" @onclick="CerrarDetalleMaterial" aria-label="Cerrar detalle"><span class="oi oi-x" aria-hidden="true"></span></button>
            </header>
            <div class="ubicaciones-detail-body">
                @if (SelectedStock.IsRemoved)
                {
                    <div class="ubicaciones-operation-warning"><span class="oi oi-warning" aria-hidden="true"></span><div><strong>Material eliminado</strong><p>@GetSelectedStockRemovalSummary()</p></div></div>
                }
                <section class="ubicaciones-detail-summary">
                    <div><span>Cantidad actual</span><strong>@SelectedStock.Quantity.ToString("N2")</strong><small>@SelectedStock.BaseUnitName</small></div>
                    <div><span>Estado</span><strong>@GetThresholdStatusText()</strong></div>
                </section>

                <section class="ubicaciones-detail-section">
                    <div class="ubicaciones-detail-section-heading"><div><h3>Mínimo y máximo</h3><p>Recibe alertas cuando la cantidad salga del rango esperado.</p></div></div>
                    <EditForm Model="ThresholdEditor" OnValidSubmit="GuardarThresholdsAsync">
                        <DataAnnotationsValidator /><ValidationSummary />
                        <div class="ubicaciones-threshold-grid">
                            <label><span>Mínimo</span><DecimalInput class="form-control" @bind-Value="ThresholdEditor.MinQuantity" disabled="@(!CanEditSelectedStock || IsSavingThresholds || IsMutatingStock)" /><small>Déjalo vacío si no necesitas límite.</small></label>
                            <label><span>Máximo</span><DecimalInput class="form-control" @bind-Value="ThresholdEditor.MaxQuantity" disabled="@(!CanEditSelectedStock || IsSavingThresholds || IsMutatingStock)" /><small>Déjalo vacío si no necesitas límite.</small></label>
                        </div>
                        <div class="ubicaciones-detail-form-actions"><button class="btn btn-outline-secondary" type="button" @onclick="RestablecerThresholdEditor" disabled="@(!CanEditSelectedStock || IsSavingThresholds || IsMutatingStock)">Restablecer</button><button class="btn btn-primary" type="submit" disabled="@(!CanEditSelectedStock || IsSavingThresholds || IsMutatingStock)">@(IsSavingThresholds ? "Guardando…" : "Guardar límites")</button></div>
                    </EditForm>
                </section>

                <details class="ubicaciones-detail-disclosure">
                    <summary><span><span class="oi oi-list-rich" aria-hidden="true"></span><strong>Movimientos</strong></span><small>@SelectedStockTransactions.Count registros</small></summary>
                    @if (SelectedStockTransactions.Count == 0)
                    {
                        <div class="ubicaciones-compact-empty">Este material todavía no tiene movimientos.</div>
                    }
                    else
                    {
                        <div class="ubicaciones-movement-list">
                            @foreach (var movement in SelectedStockTransactions)
                            {
                                <div><span><strong>@movement.TransactionType</strong><small>@movement.OccurredAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small></span><span><strong>@movement.QuantityDelta.ToString("N2")</strong><small>Final: @movement.QuantityAfter.ToString("N2")</small></span></div>
                            }
                        </div>
                    }
                </details>

                <details class="ubicaciones-detail-disclosure">
                    <summary><span><span class="oi oi-paperclip" aria-hidden="true"></span><strong>Archivos</strong></span><small>@SelectedStockAttachments.Count adjuntos</small></summary>
                    <div class="ubicaciones-attachment-form">
                        <InputFile OnChange="OnAttachmentSelectedAsync" disabled="@(!CanEditSelectedStock || IsSavingAttachment || IsMutatingStock)" />
                        <input class="form-control" type="text" placeholder="Descripción del archivo" @bind="PendingAttachmentDescription" disabled="@(!CanEditSelectedStock || IsSavingAttachment || IsMutatingStock)" />
                        <button class="btn btn-outline-primary" type="button" @onclick="GuardarAdjuntoAsync" disabled="@(!CanEditSelectedStock || !HasPendingAttachment || IsSavingAttachment || IsMutatingStock)">@(IsSavingAttachment ? "Guardando…" : "Guardar archivo")</button>
                    </div>
                    @if (SelectedStockAttachments.Count == 0)
                    {
                        <div class="ubicaciones-compact-empty">No hay archivos adjuntos.</div>
                    }
                    else
                    {
                        <div class="ubicaciones-attachment-list">
                            @foreach (var attachment in SelectedStockAttachments)
                            {
                                <div><span><strong>@attachment.FileName</strong><small>@(string.IsNullOrWhiteSpace(attachment.Description) ? "Sin descripción" : attachment.Description)</small>@if (attachment.IsDeleted) { <small>@GetAttachmentArchiveSummary(attachment)</small> }</span><button class="btn btn-sm btn-outline-secondary" type="button" @onclick="() => DescargarAdjuntoAsync(attachment)">Descargar</button></div>
                            }
                        </div>
                    }
                </details>
            </div>
            <footer class="ubicaciones-detail-footer">
                @if (SelectedStock.IsRemoved)
                {
                    <button class="btn btn-outline-success" type="button" @onclick="ReactivarMaterialAsync" disabled="@IsMutatingStock">@(IsMutatingStock ? "Reactivando…" : "Reactivar material")</button>
                }
                else
                {
                    <div>@if (SelectedStock.Quantity != 0) { <small>La cantidad debe estar en 0 para quitarlo.</small> }</div>
                    <button class="btn btn-outline-danger" type="button" @onclick="QuitarMaterialAsync" disabled="@(IsMutatingStock || SelectedStock.Quantity != 0)">@(IsMutatingStock ? "Quitando…" : "Quitar de la ubicación")</button>
                }
            </footer>
        </aside>
    </div>
}

@if (ShowAddMaterialDialog)
{
    <div class="ubicaciones-picker-backdrop" role="dialog" aria-modal="true" aria-labelledby="ubicaciones-picker-title">
        <section class="ubicaciones-picker-panel">
            <header>
                <div><span class="ubicaciones-section-kicker">@SelectedLocationSummary</span><h2 id="ubicaciones-picker-title">Agregar materiales</h2><p>Busca uno o varios materiales y agrégalos sin salir de esta pantalla.</p></div>
                <button type="button" @onclick="CerrarAgregarMaterialDialog" aria-label="Cerrar selector"><span class="oi oi-x" aria-hidden="true"></span></button>
            </header>
            <div class="ubicaciones-picker-search">
                <label class="ubicaciones-search-box"><span class="oi oi-magnifying-glass" aria-hidden="true"></span><span class="visually-hidden">Buscar material para agregar</span><input @ref="MaterialPickerSearchInput" type="search" placeholder="Nombre, código o barras" @bind="MaterialPickerFilter.SearchText" @bind:event="oninput" @onkeydown="HandleMaterialPickerSearchKeyDownAsync" /></label>
                <button class="btn btn-primary" type="button" @onclick="BuscarMaterialesParaAgregarAsync" disabled="@IsMaterialPickerBusy">Buscar</button>
            </div>
            <details class="ubicaciones-picker-filters">
                <summary>Filtros adicionales</summary>
                <div>
                    <label><span>Categoría</span><select class="form-select" @bind="MaterialPickerFilter.CategoryId"><option value="">Todas</option>@foreach (var option in MaterialCatalog.Categories) { <option value="@option.Id">@option.Name</option> }</select></label>
                    <label><span>Proveedor</span><select class="form-select" @bind="MaterialPickerFilter.VendorId"><option value="">Todos</option>@foreach (var option in MaterialCatalog.Vendors) { <option value="@option.Id">@option.Name</option> }</select></label>
                    <label><span>Clase</span><select class="form-select" @bind="MaterialPickerFilter.MaterialClass"><option value="">Todas</option>@foreach (var option in MaterialCatalog.MaterialClasses) { <option value="@option">@option</option> }</select></label>
                    <label><span>Estado</span><select class="form-select" @bind="MaterialPickerFilter.Status"><option value="">Todos</option>@foreach (var option in MaterialCatalog.Statuses) { <option value="@option">@option</option> }</select></label>
                    <label class="ubicaciones-picker-checkbox"><input type="checkbox" @bind="HasImageOnly" /> Solo con imagen</label>
                </div>
            </details>
            <div class="ubicaciones-picker-results" aria-live="polite">
                @if (IsLoadingMaterialPicker && MaterialPickerRows.Count == 0)
                {
                    <div class="ubicaciones-loading-state"><span class="spinner-border" aria-hidden="true"></span><strong>Buscando materiales…</strong></div>
                }
                else if (HasExecutedMaterialPickerSearch && MaterialPickerRows.Count == 0)
                {
                    <div class="ubicaciones-empty-state"><span class="oi oi-magnifying-glass" aria-hidden="true"></span><div><strong>No encontramos materiales</strong><p>Cambia la búsqueda o los filtros.</p></div></div>
                }
                else
                {
                    <div class="ubicaciones-picker-grid">
                        @foreach (var item in MaterialPickerRows)
                        {
                            var thumbnailDataUrl = GetMaterialPickerThumbnailDataUrl(item.Id);
                            var materialTitle = string.IsNullOrWhiteSpace(item.Description) ? item.MaterialCode : item.Description;
                            var showMaterialCode = !string.IsNullOrWhiteSpace(item.MaterialCode) && !string.Equals(item.MaterialCode, materialTitle, StringComparison.OrdinalIgnoreCase);
                            var alreadyVisible = IsMaterialAlreadyVisibleInSelectedLocation(item.Id);
                            var isAddingThis = AddingMaterialId == item.Id;
                            <article class="ubicaciones-picker-card @(alreadyVisible ? "is-added" : null)">
                                <div class="ubicaciones-picker-card-heading">
                                    @if (thumbnailDataUrl is not null)
                                    {
                                        <button class="ubicaciones-line-image-button" type="button" title="Ver imagen" aria-label="Ver imagen de @materialTitle" @onclick="() => AbrirImagenMaterialAsync(item)"><img src="@thumbnailDataUrl" alt="" class="ubicaciones-line-image" /></button>
                                    }
                                    else
                                    {
                                        <div class="ubicaciones-line-image-placeholder">Sin foto</div>
                                    }
                                    <div><strong>@materialTitle</strong>@if (showMaterialCode) { <small>@item.MaterialCode</small> }@if (!string.IsNullOrWhiteSpace(item.Barcode)) { <small>@item.Barcode</small> }</div>
                                </div>
                                <div class="ubicaciones-picker-card-meta"><span>@(string.IsNullOrWhiteSpace(item.CategoryName) ? "Sin categoría" : item.CategoryName)</span><span>@item.TotalQuantity.ToString("N2") disponibles</span></div>
                                <button class="btn @(alreadyVisible ? "btn-outline-secondary" : "btn-primary")" type="button" @onclick="() => AgregarMaterialAUbicacionAsync(item)" disabled="@(alreadyVisible || IsMaterialPickerBusy || !CanAddMaterialToSelectedLocation)">@(alreadyVisible ? "Ya agregado" : isAddingThis ? "Agregando…" : "Agregar")</button>
                            </article>
                        }
                    </div>
                }
            </div>
            <footer>
                <span>@MaterialPickerRows.Count materiales mostrados</span>
                <div>@if (HasMoreMaterialPickerRows) { <button class="btn btn-outline-primary" type="button" @onclick="CargarMasMaterialesParaAgregarAsync" disabled="@IsMaterialPickerBusy">@(IsLoadingMoreMaterialPicker ? "Cargando…" : $"Cargar {PageSize} más")</button> }<button class="btn btn-outline-secondary" type="button" @onclick="CerrarAgregarMaterialDialog">Cerrar</button></div>
            </footer>
        </section>
    </div>
}

@if (ShowMaterialImageModal)
{
    <div class="ubicaciones-image-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="ubicaciones-image-title">
        <section class="ubicaciones-image-modal">
            <header><h2 id="ubicaciones-image-title">@(string.IsNullOrWhiteSpace(MaterialImageModalTitle) ? "Imagen del material" : MaterialImageModalTitle)</h2><button type="button" @onclick="CloseMaterialImageModal" aria-label="Cerrar imagen"><span class="oi oi-x" aria-hidden="true"></span></button></header>
            <div>@if (MaterialImageModalDataUrl is not null) { <img src="@MaterialImageModalDataUrl" alt="Vista ampliada del material" /> } else if (IsLoadingMaterialImage) { <div class="ubicaciones-loading-state"><span class="spinner-border" aria-hidden="true"></span><strong>Cargando imagen…</strong></div> } else { <div class="ubicaciones-compact-empty">Sin imagen disponible.</div> }</div>
        </section>
    </div>
}
