# Preferred for production aggregate marketing intelligence.
# Do not commit real credentials.
ASPNETCORE_ConnectionStrings__OrionDb=<production-or-sandbox-oriondb-connection-string>

# Optional override if you do not want to use the ASPNETCORE variable name.
MARKETING_ORIONDB_CONNECTION_STRING=<production-or-sandbox-oriondb-connection-string>

# Future media-generation provider slots.
