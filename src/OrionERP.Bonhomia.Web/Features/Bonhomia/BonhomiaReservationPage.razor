    private DayState GetCalendarDayState(DateOnly day)
    {
        if (day < Today)
        {
            return DayState.Past;
        }

        if (BonhomiaBookingCalendarRules.IsAnySuiteAvailableOnDate(
          Availability?.Rooms ?? Array.Empty<BonhomiaRoomAvailabilityDto>(),
          day))
        {
            return DayState.Available;
        }

        return DayState.Unavailable;
    }

    private string GetCalendarDayClass(DateOnly day, DayState state)
    {
        var classes = new List<string> { "bonhomia-day" };
        classes.Add(state switch
        {
            DayState.Available => "bonhomia-day--available",
            DayState.Unavailable => "bonhomia-day--unavailable",
            _ => "bonhomia-day--past"
        });

        if (day == CheckIn)
        {
            classes.Add("bonhomia-day--start");
        }
        else if (day == CheckOut)
        {
            classes.Add("bonhomia-day--end");
        }
        else if (day > CheckIn && day < CheckOut)
        {
            classes.Add("bonhomia-day--range");
        }

        return string.Join(" ", classes);
    }

    private static string GetCalendarDayTitle(DateOnly day, DayState state)
      => state switch
      {
          DayState.Available => $"{day:yyyy-MM-dd} disponible",
          DayState.Unavailable => $"{day:yyyy-MM-dd} no disponible",
          _ => $"{day:yyyy-MM-dd} fecha pasada"
      };

