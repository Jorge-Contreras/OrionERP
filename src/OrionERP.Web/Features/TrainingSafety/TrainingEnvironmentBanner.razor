@implements IAsyncDisposable
@inject ITrainingEnvironmentState TrainingState
@inject IJSRuntime Js

@if (TrainingState.IsTraining)
{
  <div class="training-environment-banner" role="status" aria-live="polite">
    <span class="training-environment-banner__icon" aria-hidden="true">⚠</span>
    <strong>@TrainingState.BannerText</strong>
  </div>
}

@code {
  private IJSObjectReference? _module;

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (!firstRender || !TrainingState.IsTraining)
      return;

    _module = await Js.InvokeAsync<IJSObjectReference>("import", "./js/training-safety.js");
    await _module.InvokeVoidAsync("installTrainingSafetyGuards");
  }

  public async ValueTask DisposeAsync()
  {
    if (_module is not null)
      await _module.DisposeAsync();
  }
}
