@using OrionERP.Application.Features.Cfdi.HtmlCFDI

@if (Document is null)
{
    <div class="alert alert-warning">CFDI no disponible.</div>
    return;
}

<div class="cfdi-document">
    <section class="cfdi-document-header">
        <div>
            <div class="cfdi-document-kicker">Comprobante Fiscal Digital por Internet</div>
            <h4>Complemento de pago</h4>
            <div class="cfdi-document-subtitle">CFDI v@(CfdiDisplay.Safe(Document.Version)) | @CfdiDisplay.TypeLabel(Document.TipoDeComprobante)</div>
        </div>
        <div class="cfdi-total-panel">
            <div class="cfdi-total-label">Monto total pagos</div>
            <div class="cfdi-total-value">@CfdiDisplay.Amount(Document.Pago20?.Totales?.MontoTotalPagos, Document.Moneda)</div>
            <div class="cfdi-total-currency">@CfdiDisplay.Safe(Document.Moneda)</div>
        </div>
    </section>

    <section class="cfdi-summary-strip" aria-label="Resumen del comprobante">
        <div class="cfdi-summary-item">
            <div class="cfdi-summary-label">Folio fiscal</div>
            <div class="cfdi-summary-value cfdi-break">@CfdiDisplay.Safe(Document.Timbre?.Uuid)</div>
        </div>
        <div class="cfdi-summary-item">
            <div class="cfdi-summary-label">Fecha y hora</div>
            <div class="cfdi-summary-value">@CfdiDisplay.Safe(Document.Fecha)</div>
        </div>
        <div class="cfdi-summary-item">
            <div class="cfdi-summary-label">Lugar expedición</div>
            <div class="cfdi-summary-value">@CfdiDisplay.Safe(Document.LugarExpedicion)</div>
        </div>
        <div class="cfdi-summary-item">
            <div class="cfdi-summary-label">Serie / Folio</div>
            <div class="cfdi-summary-value">@CfdiDisplay.SerieFolio(Document)</div>
        </div>
    </section>

    <div class="cfdi-parties-grid">
        @PartySection("Emisor", Document.Emisor)
        @PartySection("Receptor", Document.Receptor)
    </div>

    <section class="cfdi-section">
        <div class="cfdi-section-header">
            <h5>Datos fiscales del comprobante</h5>
        </div>
        @FieldStrip(
            new FieldItem("Tipo de comprobante", CfdiDisplay.TypeLabel(Document.TipoDeComprobante)),
            new FieldItem("Moneda comprobante", Document.Moneda),
            new FieldItem("Subtotal", CfdiDisplay.Amount(Document.SubTotal, Document.Moneda)),
            new FieldItem("Total", CfdiDisplay.Amount(Document.Total, Document.Moneda)),
            new FieldItem("Exportación", Document.Exportacion),
            new FieldItem("Certificado emisor", Document.NoCertificado))
    </section>

    <section class="cfdi-section">
        <div class="cfdi-section-header">
            <h5>Totales del complemento</h5>
        </div>
        @if (Document.Pago20?.Totales is null)
        {
            <div class="cfdi-empty">Sin totales de pago.</div>
        }
        else
        {
            @FieldStrip(
                new FieldItem("Monto total pagos", CfdiDisplay.Amount(Document.Pago20.Totales.MontoTotalPagos, Document.Moneda)),
                new FieldItem("Base IVA 16%", CfdiDisplay.Amount(Document.Pago20.Totales.TotalTrasladosBaseIva16, Document.Moneda)),
                new FieldItem("Impuesto IVA 16%", CfdiDisplay.Amount(Document.Pago20.Totales.TotalTrasladosImpuestoIva16, Document.Moneda)))
        }
    </section>

    @if (Document.Conceptos.Count > 0)
    {
        <section class="cfdi-section">
            <div class="cfdi-section-header">
                <h5>Conceptos</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-sm cfdi-table mb-0">
                    <thead>
                        <tr>
                            <th>Clave P./S.</th>
                            <th>Descripción</th>
                            <th class="text-end">Cantidad</th>
                            <th>Unidad</th>
                            <th class="text-end">Importe</th>
                            <th>Objeto imp.</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Document.Conceptos)
                        {
                            <tr>
                                <td>@CfdiDisplay.Safe(c.ClaveProdServ)</td>
                                <td class="cfdi-description-cell">@CfdiDisplay.Safe(c.Descripcion)</td>
                                <td class="text-end">@CfdiDisplay.Safe(c.Cantidad)</td>
                                <td>@CfdiDisplay.FirstNonEmpty(c.ClaveUnidad, c.Unidad)</td>
                                <td class="text-end">@CfdiDisplay.Amount(c.Importe, Document.Moneda)</td>
                                <td>@CfdiDisplay.Safe(c.ObjetoImp)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    @if (Document.Pago20?.Pagos.Count > 0)
    {
        var pagoIndex = 1;
        foreach (var pago in Document.Pago20.Pagos)
        {
            <section class="cfdi-section cfdi-payment-section">
                <div class="cfdi-section-header">
                    <h5>Pago @pagoIndex</h5>
                </div>
                @FieldStrip(
                    new FieldItem("Fecha pago", pago.FechaPago),
                    new FieldItem("Forma de pago", pago.FormaDePagoP),
                    new FieldItem("Moneda pago", pago.MonedaP),
                    new FieldItem("Tipo cambio pago", pago.TipoCambioP),
                    new FieldItem("Monto", CfdiDisplay.Amount(pago.Monto, pago.MonedaP)))

                @if (pago.Documentos.Count > 0)
                {
                    <div class="cfdi-subsection-title">Documentos relacionados</div>
                    <div class="table-responsive">
                        <table class="table table-sm cfdi-table mb-0">
                            <thead>
                                <tr>
                                    <th>UUID</th>
                                    <th>Serie/Folio</th>
                                    <th>Moneda</th>
                                    <th>Parcialidad</th>
                                    <th class="text-end">Saldo anterior</th>
                                    <th class="text-end">Pagado</th>
                                    <th class="text-end">Saldo insoluto</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in pago.Documentos)
                                {
                                    <tr>
                                        <td class="cfdi-break">@CfdiDisplay.Safe(d.IdDocumento)</td>
                                        <td>@CfdiDisplay.FirstNonEmpty($"{d.Serie} {d.Folio}".Trim(), "-")</td>
                                        <td>@CfdiDisplay.Safe(d.MonedaDr)</td>
                                        <td>@CfdiDisplay.Safe(d.NumParcialidad)</td>
                                        <td class="text-end">@CfdiDisplay.Amount(d.ImpSaldoAnt, d.MonedaDr)</td>
                                        <td class="text-end">@CfdiDisplay.Amount(d.ImpPagado, d.MonedaDr)</td>
                                        <td class="text-end">@CfdiDisplay.Amount(d.ImpSaldoInsoluto, d.MonedaDr)</td>
                                    </tr>
                                    @if (d.Traslados.Count > 0)
                                    {
                                        <tr class="cfdi-concept-tax-row">
                                            <td colspan="7">
                                                @PaymentTaxList("Traslados DR", d.Traslados, d.MonedaDr)
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @PaymentTaxList("Traslados del pago", pago.Traslados, pago.MonedaP)
            </section>
            pagoIndex++;
        }
    }

    @TimbreSection(Document.Timbre)
</div>

@code {
    [Parameter]
    public CfdiReadableDocument? Document { get; set; }

    private RenderFragment PartySection(string title, CfdiParty? party) => @<section class="cfdi-section cfdi-party-card">
        <div class="cfdi-section-header">
            <h5>@title</h5>
        </div>
        @FieldStrip(
            new FieldItem("RFC", party?.Rfc),
            new FieldItem("Razón social", party?.Nombre),
            new FieldItem("Régimen fiscal", CfdiDisplay.PartyRegimen(party)),
            new FieldItem("Uso CFDI", party?.UsoCfdi),
            new FieldItem("Domicilio fiscal", party?.DomicilioFiscalReceptor))
    </section>;

    private static RenderFragment FieldStrip(params FieldItem[] fields) => @<div class="cfdi-field-strip">
        @foreach (var field in fields.Where(field => CfdiDisplay.HasRealValue(field.Value)))
        {
            <span class="cfdi-inline-field">
                <span class="cfdi-inline-label">@field.Label:</span>
                <span class="cfdi-inline-value">@CfdiDisplay.Safe(field.Value)</span>
            </span>
        }
    </div>;

    private RenderFragment PaymentTaxList(string title, IReadOnlyList<CfdiPago20Traslado> taxes, string? currency) => @<div>
        @if (taxes.Count > 0)
        {
            <div class="cfdi-tax-title">@title</div>
            <div class="cfdi-tax-list">
                @foreach (var tax in taxes)
                {
                    <span class="cfdi-tax-pill">@PaymentTaxText(tax, currency)</span>
                }
            </div>
        }
    </div>;

    private RenderFragment TimbreSection(CfdiTimbre? timbre) => @<section class="cfdi-section">
        <div class="cfdi-section-header">
            <h5>Timbre Fiscal Digital</h5>
        </div>
        @if (timbre is null)
        {
            <div class="cfdi-empty">Sin timbre fiscal.</div>
        }
        else
        {
            @FieldStrip(
                new FieldItem("UUID", timbre.Uuid),
                new FieldItem("Fecha timbrado", timbre.FechaTimbrado),
                new FieldItem("Certificado SAT", timbre.NoCertificadoSat),
                new FieldItem("RFC proveedor certificación", timbre.RfcProvCertif),
                new FieldItem("Leyenda", timbre.Leyenda))
            @LongValue("Sello digital emisor", timbre.SelloCfd)
            @LongValue("Sello digital SAT", timbre.SelloSat)
        }
    </section>;

    private static RenderFragment LongValue(string label, string? value) => @<div>
        @if (CfdiDisplay.HasRealValue(value))
        {
            <div class="cfdi-long-value">
                <div class="cfdi-long-label">@label</div>
                <div class="cfdi-long-text">@value</div>
            </div>
        }
    </div>;

    private static string PaymentTaxText(CfdiPago20Traslado tax, string? currency)
        => $"{CfdiDisplay.Safe(tax.Impuesto)} {CfdiDisplay.Safe(tax.TipoFactor)} {CfdiDisplay.Safe(tax.TasaOCuota)} | Base {CfdiDisplay.Amount(tax.Base, currency)} | Importe {CfdiDisplay.Amount(tax.Importe, currency)}";

    private sealed record FieldItem(string Label, string? Value);
}
