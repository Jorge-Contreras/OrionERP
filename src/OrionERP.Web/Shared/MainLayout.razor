@inherits LayoutComponentBase
@inject IUiMessageService MessageService

<PageTitle>OrionERP.Web</PageTitle>

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 align-items-center d-flex justify-content-between">
            <SecurityHeader />
        </div>

        <div class="px-4">
            <NotificationBanner />
        </div>

        <ErrorBoundary @ref="_errorBoundary" OnError="HandleError">
            <ErrorContent>
                <div class="alert alert-danger alert-dismissible fade show mx-4" role="alert">
                    <strong>Ocurrió un error inesperado.</strong>
                    <div class="mt-1">@context.Message</div>
                    <button type="button" class="btn-close" aria-label="Cerrar" @onclick="Recover"></button>
                </div>
            </ErrorContent>

            <article class="content px-0">
                @Body
            </article>
        </ErrorBoundary>
    </main>
</div>

@code {
    private ErrorBoundary? _errorBoundary;

    private void HandleError(Exception exception)
    {
        MessageService.ShowError($"Ocurrió un error inesperado: {exception.Message}");
    }

    private void Recover()
    {
        MessageService.Clear();
        _errorBoundary?.Recover();
    }
}
